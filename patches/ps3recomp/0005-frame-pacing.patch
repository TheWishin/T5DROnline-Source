+    RSX_PF_PUMP_TICKS,       /* guest GCM handlers run on the ticker        */
+    RSX_PF_VBLANKS,          /* vblank ticks fired                          */
+    RSX_PF_VBLANK_LATE_MAX,  /* worst tick lateness (QPC ticks), max-reset  */
+    RSX_PF_VBLANK_BURST_MAX, /* most ticks fired in one burst, max-reset    */
+    RSX_PF_FLIP_QPC,         /* QPC when the FIFO reached the last flip     */
+    RSX_PF_FLIPS,            /* guest flips reached by the FIFO walker      */
+    RSX_PF_FLIPDONE_QPC,     /* QPC when the flip-done event was delivered  */
+    RSX_PF_USERCMD_QPC,      /* QPC when the user-command handler last ran  */
+    RSX_PF_RESETFLIP_QPC,    /* QPC of the guest's last cellGcmResetFlipStatus */
+    RSX_PF_PUT_ADV,          /* drains that found `put` moved (since last flip) */
+    RSX_PF_PUT_FIRST_QPC,    /* first such drain since the last guest flip    */
+    RSX_PF_PUT_LAST_QPC,     /* latest such drain                              */
+    RSX_PF_SHOWN_CALL_QPC,   /* guest flip call of the frame the walker just
+                                reached (in-FIFO flips): input-to-present lag */
+    RSX_PF_COUNT

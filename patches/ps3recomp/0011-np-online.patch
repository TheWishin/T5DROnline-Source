diff --git a/libs/network/sceNpMatching.c b/libs/network/sceNpMatching.c
new file mode 100644
index 0000000..a798fd9
--- /dev/null
+++ b/libs/network/sceNpMatching.c
@@ -0,0 +1,1325 @@
+/*
+ * ps3recomp - sceNpMatching (first-generation NP matchmaking, "GUI" API)
+ * over a psnr server
+ *
+ * Titles from the 2006-2008 era (Tekken 5 DR Online among them) matchmake
+ * through sceNpMatching: rooms with attributes, searched by conditions, and
+ * the *GUI calls, which on a console open system dialogs (room browser,
+ * "searching for players...") and report through a GUI handler. Here there
+ * is no system UI: a GUI call does the room operation on psnr straight away
+ * and delivers COMMON_LOAD, the operation's event and COMMON_UNLOAD through
+ * the handler, exactly the sequence a title sees when the dialog closes.
+ * Results are fetched with GetResultGUI / GetResult as on a console.
+ *
+ * Rooms: a psnr room per NP room. The NP attribute list (the title's own
+ * game attributes plus the basic slot counts) is packed into psnr's opaque
+ * "external" room data, so searches filter client-side on what psnr lists.
+ * psnr room flags: bit 0 = stealth (ROOM_SEARCH_FLAG), bit 8 = made by a
+ * quick match (only quick matchers join those).
+ *
+ * Quick match: search for an open quick-match room that satisfies the
+ * conditions and join it; none -> create one and wait for the first player
+ * to join (QUICK_MATCH event then), or give up after the title's timeout
+ * (QUICK_MATCH_PLAYER_NOT_FOUND).
+ *
+ * Callbacks run on the title's polling thread: psnr replies are pumped from
+ * cellSysutilCheckCallback and the guest callbacks queued there are delivered
+ * by that same call. Result images contain pointers into themselves; they are
+ * built relocatable and patched when copied into the title's buffer.
+ *
+ * Layouts (SDK ABI, all big-endian in guest memory):
+ *   SceNpLobbyId / SceNpRoomId      36  opt[28] reserved[8]
+ *   SceNpMatchingAttr               20  next type id { num | ptr size }
+ *   SceNpMatchingSearchCondition    40  next target_type target_id comp_op comp_type compared(20)
+ *   SceNpMatchingRoomMember        224  next user_info(216: NpId 36, OnlineName 52, AvatarUrl 128) owner
+ *   SceNpMatchingRoomStatus         56  id(36) members num kick_actor opt opt_len
+ *   SceNpMatchingJoinedRoomInfo     92  lobbyid(36) room_status(56)
+ *   SceNpMatchingRoom               44  next id(36) attr
+ *   SceNpMatchingRoomList           52  lobbyid(36) range{start results total} head
+ *   SceNpMatchingSearchJoinRoomInfo 96  lobbyid(36) room_status(56) attr
+ */
+
+#include "sceNpMatching.h"
+#include "sceNp.h"
+#include "np_psnr.h"
+#include "../system/cellSysutil.h"
+#include "../../runtime/ppu/ppu_context.h"
+#include "../../runtime/ppu/ppu_memory.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* The guest call chain behind an NP call (PS3_NP_TRACE): which part of the
+ * title asked. The caller's saved LR sits at frame+16 of each back-chain link. */
+extern PPU_THREAD_LOCAL ppu_context* g_active_ctx;
+static void np_guest_backtrace(const char* what)
+{
+    ppu_context* ctx = g_active_ctx;
+    if (!ctx || !np_psnr_trace()) return;
+    char buf[256];
+    int p = snprintf(buf, sizeof buf, "lr=0x%x", (uint32_t)ctx->lr);
+    uint32_t sp = (uint32_t)ctx->gpr[1];
+    for (int i = 0; i < 8 && sp && sp < 0xF0000000u && p < (int)sizeof buf - 12; i++) {
+        uint32_t next = (uint32_t)vm_read64(sp);
+        if (!next || next < 0x10000u) break;
+        p += snprintf(buf + p, sizeof buf - p, " 0x%x", (uint32_t)vm_read64(next + 16));
+        sp = next;
+    }
+    printf("[sceNpMatching] %s from %s\n", what, buf);
+}
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _WIN32
+#  define WIN32_LEAN_AND_MEAN
+#  include <windows.h>
+static uint64_t now_ms(void) { return GetTickCount64(); }
+#else
+#  include <time.h>
+static uint64_t now_ms(void)
+{
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000u + (uint64_t)ts.tv_nsec / 1000000u;
+}
+#endif
+
+/* ---- SDK constants ---- */
+#define E_NOT_INITIALIZED      0x8002a701
+#define E_INVALID_ARG          0x8002a703
+#define E_TIMEOUT              0x8002a705
+#define E_CTXID_NOT_AVAIL      0x8002a707
+#define E_CTX_NOT_FOUND        0x8002a709
+#define E_ROOM_NOT_FOUND       0x8002a70b
+#define E_MEMBER_NOT_FOUND     0x8002a70c
+#define E_CTX_STILL_RUNNING    0x8002a713
+#define E_INSUFFICIENT_BUFFER  0x8002a714
+#define E_INVALID_REQ_ID       0x8002a717
+#define E_RESULT_NOT_FOUND     0x8002a718
+#define E_BUSY                 0x8002a719
+#define E_ALREADY_JOINED_ROOM  0x8002a71a
+#define E_ROOM_MAX             0x8002a71b
+#define E_QM_PLAYER_NOT_FOUND  0x8002a71c
+#define E_CANCELED             0x8002a723
+#define E_SEARCH_JOIN_NOT_FOUND 0x8002a724
+#define SERVER_E_NO_SUCH_ROOM  0x8002a746
+#define SERVER_E_NOT_ALLOWED   0x8002a748
+#define SERVER_E_ROOM_CLOSED   0x8002a74e
+#define SERVER_E_OUT_OF_SERVICE 0x8002a740
+
+enum {   /* handler events */
+    EV_ERROR = 1, EV_LEAVE_ROOM_DONE = 2, EV_ROOM_UPDATE_NEW_MEMBER = 5, EV_ROOM_UPDATE_MEMBER_LEAVE = 6,
+    EV_ROOM_DISAPPEARED = 7, EV_GET_ROOM_INFO_DONE = 9, EV_SET_ROOM_INFO_DONE = 10,
+    EV_ROOM_UPDATE_OWNER_CHANGE = 12, EV_KICK_MEMBER_DONE = 13, EV_ROOM_KICKED = 14,
+    EV_SET_ROOM_SEARCH_FLAG_DONE = 16
+};
+enum {   /* GUI handler events */
+    GUI_CREATE_ROOM = 1, GUI_JOIN_ROOM = 2, GUI_SEARCH_JOIN = 4, GUI_QUICK_MATCH = 5,
+    GUI_SEND_INVITATION = 6, GUI_ACCEPT_INVITATION = 7, GUI_COMMON_LOAD = 8, GUI_COMMON_UNLOAD = 9,
+    GUI_GET_ROOM_LIST = 10, GUI_GET_ROOM_LIST_LIMIT = 11
+};
+enum { ATTR_BASIC_BIN = 1, ATTR_BASIC_NUM = 2, ATTR_GAME_BIN = 3, ATTR_GAME_NUM = 4 };
+enum { ROOM_ATTR_TOTAL_SLOT = 1, ROOM_ATTR_PRIVATE_SLOT = 2, ROOM_ATTR_CUR_TOTAL_NUM = 3,
+       ROOM_ATTR_CUR_PUBLIC_NUM = 4, ROOM_ATTR_CUR_PRIVATE_NUM = 5, ROOM_ATTR_PRIVILEGE_TYPE = 6,
+       ROOM_ATTR_ROOM_SEARCH_FLAG = 7 };
+enum { COND_EQ = 0, COND_NE = 1, COND_LT = 2, COND_LE = 3, COND_GT = 4, COND_GE = 5 };
+
+#define FLAG_STEALTH   0x1u
+#define FLAG_QUICK     0x100u
+#define DEFAULT_SLOTS  2
+#define MAX_MEMBERS    16
+#define MAX_ATTRS      32
+#define ROOM_CACHE     64
+#define RESULT_RING    32
+#define SEARCH_MAX     100
+
+/* ---- relocatable images ---- */
+typedef struct { u8* b; u32 len, cap; u32* rel; u32 nrel, relcap; } rb_t;
+
+static u32 rb_alloc(rb_t* r, u32 size, u32 align)
+{
+    u32 off = (r->len + align - 1) & ~(align - 1);
+    if (off + size > r->cap) {
+        while (off + size > r->cap) r->cap = r->cap ? r->cap * 2 : 1024;
+        r->b = (u8*)realloc(r->b, r->cap);
+    }
+    memset(r->b + r->len, 0, off + size - r->len);
+    r->len = off + size;
+    return off;
+}
+static void rb_16(rb_t* r, u32 o, u16 v) { r->b[o] = (u8)(v >> 8); r->b[o + 1] = (u8)v; }
+static void rb_32(rb_t* r, u32 o, u32 v) { rb_16(r, o, (u16)(v >> 16)); rb_16(r, o + 2, (u16)v); }
+static void rb_ptr(rb_t* r, u32 o, u32 target)
+{
+    if (r->nrel == r->relcap) {
+        r->relcap = r->relcap ? r->relcap * 2 : 32;
+        r->rel = (u32*)realloc(r->rel, r->relcap * sizeof(u32));
+    }
+    r->rel[r->nrel++] = o;
+    rb_32(r, o, target);
+}
+static void rb_free(rb_t* r) { free(r->b); free(r->rel); memset(r, 0, sizeof(*r)); }
+/* Copy into the title's buffer at EA, relocating pointer fields. */
+static void rb_copy_out(const rb_t* r, u32 ea, u32 cap)
+{
+    u8* tmp = (u8*)malloc(r->len ? r->len : 1);
+    memcpy(tmp, r->b, r->len);
+    for (u32 i = 0; i < r->nrel; i++) {
+        u32 o = r->rel[i];
+        u32 v = ((u32)tmp[o] << 24) | ((u32)tmp[o + 1] << 16) | ((u32)tmp[o + 2] << 8) | tmp[o + 3];
+        if (v) v += ea;
+        tmp[o] = (u8)(v >> 24); tmp[o + 1] = (u8)(v >> 16); tmp[o + 2] = (u8)(v >> 8); tmp[o + 3] = (u8)v;
+    }
+    u32 n = r->len < cap ? r->len : cap;
+    memcpy(GUEST_PTR(ea, u8*), tmp, n);
+    free(tmp);
+}
+
+/* ---- attributes ---- */
+typedef struct {
+    u8  type, id;
+    u32 num;
+    u8  bin[256];
+    u16 size;
+} attr_t;
+
+static int attr_is_bin(u8 type) { return type == ATTR_BASIC_BIN || type == ATTR_GAME_BIN; }
+
+/* The NP attribute list at guest EA -> host array. */
+static int read_attrs(u32 ea, attr_t* out, int cap)
+{
+    int n = 0;
+    for (int guard = 0; ea && n < cap && guard < 64; guard++) {
+        attr_t* a = &out[n];
+        memset(a, 0, sizeof(*a));
+        a->type = (u8)vm_read32(ea + 4);
+        a->id = (u8)vm_read32(ea + 8);
+        if (attr_is_bin(a->type)) {
+            u32 p = vm_read32(ea + 12), sz = vm_read32(ea + 16);
+            if (sz > sizeof(a->bin)) sz = sizeof(a->bin);
+            a->size = (u16)sz;
+            if (p && sz) memcpy(a->bin, GUEST_PTR(p, const u8*), sz);
+        } else a->num = vm_read32(ea + 12);
+        n++;
+        ea = vm_read32(ea);
+    }
+    return n;
+}
+
+/* Pack: entries of type u8 | id u8 | kind u8 (0 num, 1 bin) | num u32 / len u16 + bytes */
+static u32 pack_attrs(const attr_t* a, int n, u8* out, u32 cap)
+{
+    u32 o = 0;
+    for (int i = 0; i < n; i++) {
+        u32 need = attr_is_bin(a[i].type) ? 5u + a[i].size : 7u;
+        if (o + need > cap) break;
+        out[o++] = a[i].type; out[o++] = a[i].id;
+        if (attr_is_bin(a[i].type)) {
+            out[o++] = 1; out[o++] = (u8)(a[i].size >> 8); out[o++] = (u8)a[i].size;
+            memcpy(out + o, a[i].bin, a[i].size); o += a[i].size;
+        } else {
+            out[o++] = 0;
+            out[o++] = (u8)(a[i].num >> 24); out[o++] = (u8)(a[i].num >> 16);
+            out[o++] = (u8)(a[i].num >> 8); out[o++] = (u8)a[i].num;
+        }
+    }
+    return o;
+}
+
+static int unpack_attrs(const u8* p, u32 len, attr_t* out, int cap)
+{
+    int n = 0;
+    u32 o = 0;
+    while (o + 3 <= len && n < cap) {
+        attr_t* a = &out[n];
+        memset(a, 0, sizeof(*a));
+        a->type = p[o]; a->id = p[o + 1];
+        u8 kind = p[o + 2]; o += 3;
+        if (kind) {
+            if (o + 2 > len) break;
+            u16 sz = np_get16(p + o); o += 2;
+            if (o + sz > len || sz > sizeof(a->bin)) break;
+            a->size = sz; memcpy(a->bin, p + o, sz); o += sz;
+        } else {
+            if (o + 4 > len) break;
+            a->num = np_get32(p + o); o += 4;
+        }
+        n++;
+    }
+    return n;
+}
+
+static attr_t* attr_find(attr_t* a, int n, u8 type, u8 id)
+{
+    for (int i = 0; i < n; i++) if (a[i].type == type && a[i].id == id) return &a[i];
+    return NULL;
+}
+
+/* Replace or append. */
+static int attr_merge(attr_t* a, int n, int cap, const attr_t* in, int nin)
+{
+    for (int i = 0; i < nin; i++) {
+        attr_t* e = attr_find(a, n, in[i].type, in[i].id);
+        if (e) *e = in[i];
+        else if (n < cap) a[n++] = in[i];
+    }
+    return n;
+}
+
+static void log_attrs(const char* what, const attr_t* a, int n)
+{
+    printf("[sceNpMatching] %s: %d attribute(s)\n", what, n);
+    for (int i = 0; i < n; i++) {
+        if (attr_is_bin(a[i].type)) {
+            printf("[sceNpMatching]   type %u id %u bin[%u]:", a[i].type, a[i].id, a[i].size);
+            for (int k = 0; k < a[i].size && k < 32; k++) printf(" %02x", a[i].bin[k]);
+            printf("%s\n", a[i].size > 32 ? " ..." : "");
+        } else
+            printf("[sceNpMatching]   type %u id %u num %u\n", a[i].type, a[i].id, a[i].num);
+    }
+}
+
+/* ---- conditions ---- */
+typedef struct { u8 target_type, target_id; s32 op; s32 comp_type; attr_t cmp; } cond_t;
+
+static int read_conds(u32 ea, cond_t* out, int cap)
+{
+    int n = 0;
+    for (int guard = 0; ea && n < cap && guard < 32; guard++) {
+        cond_t* c = &out[n];
+        memset(c, 0, sizeof(*c));
+        c->target_type = (u8)vm_read32(ea + 4);
+        c->target_id = (u8)vm_read32(ea + 8);
+        c->op = (s32)vm_read32(ea + 12);
+        c->comp_type = (s32)vm_read32(ea + 16);
+        c->cmp.type = (u8)vm_read32(ea + 24);
+        c->cmp.id = (u8)vm_read32(ea + 28);
+        if (attr_is_bin(c->cmp.type)) {
+            u32 p = vm_read32(ea + 32), sz = vm_read32(ea + 36);
+            if (sz > sizeof(c->cmp.bin)) sz = sizeof(c->cmp.bin);
+            c->cmp.size = (u16)sz;
+            if (p && sz) memcpy(c->cmp.bin, GUEST_PTR(p, const u8*), sz);
+        } else c->cmp.num = vm_read32(ea + 32);
+        n++;
+        ea = vm_read32(ea);
+    }
+    return n;
+}
+
+static void log_conds(const char* what, const cond_t* c, int n)
+{
+    printf("[sceNpMatching] %s: %d condition(s)\n", what, n);
+    for (int i = 0; i < n; i++)
+        printf("[sceNpMatching]   attr type %u id %u op %d comp_type %d vs %s%u\n", c[i].target_type, c[i].target_id,
+               c[i].op, c[i].comp_type, attr_is_bin(c[i].cmp.type) ? "bin " : "", attr_is_bin(c[i].cmp.type) ? c[i].cmp.size : c[i].cmp.num);
+}
+
+/* ---- state ---- */
+typedef struct {
+    u16  member_id;
+    u32  user;
+    char online_id[17];
+    u8   ip[4];
+    u16  port;
+    int  owner;
+} member_t;
+
+typedef struct {
+    int      in_room;
+    u64      room_id;
+    u16      my_member, owner;
+    u8       max;
+    u32      flags;
+    attr_t   attrs[MAX_ATTRS];
+    int      nattrs;
+    member_t members[MAX_MEMBERS];
+    int      nmembers;
+} room_t;
+
+typedef struct {   /* a room seen in a list, for GetRoomInfo on rooms we are not in */
+    u64    room_id;
+    u8     cur, max;
+    u32    flags;
+    char   owner[17];
+    u32    owner_user;      /* the owner's P2P endpoint (psnr_server.py extension), */
+    u8     owner_ip[4];     /* so the title can ping a host from the room browser */
+    u16    owner_port;
+    attr_t attrs[MAX_ATTRS];
+    int    nattrs;
+} room_cache_t;
+
+static int    s_init;
+static int    s_ctx_used;
+static u32    s_handler, s_handler_arg;     /* matching handler OPD + arg */
+static u32    s_gui_handler, s_gui_arg;
+static int    s_gui_busy;
+static char   s_comm_id[13] = "NPWR00045";
+static room_t s_room;
+static room_cache_t s_cache[ROOM_CACHE];
+static int    s_ncache;
+static u32    s_next_req = 0x1000;
+
+/* GetResult images, by request id */
+static struct { u32 req; s32 event; rb_t img; } s_results[RESULT_RING];
+static int s_result_next;
+/* GetResultGUI image */
+static struct { s32 event; rb_t img; int valid; } s_gui_result;
+
+/* an operation in flight */
+typedef struct {
+    int    kind;        /* GUI_* or EV_* (non-GUI) */
+    u32    req_id;      /* for non-GUI ops */
+    cond_t conds[9];
+    int    nconds;
+    attr_t attrs[MAX_ATTRS];
+    int    nattrs;
+    u32    start, max;  /* room list range */
+    u16    req_attr_type[16], req_attr_id[16]; int nreq_attr;   /* GetRoomInfo */
+    u64    room_id;
+    int    available_num;
+    u64    deadline;    /* quick match */
+    int    waiting;     /* quick match: our room is up, waiting for a player */
+    u32    kick_member;
+} op_t;
+static op_t s_op;
+
+static const u8 LOBBY_ID[36] = { 'T','5','D','R','-','L','O','B','B','Y' };
+
+static void room_id_encode(u64 id, u8 out[36])
+{
+    memset(out, 0, 36);
+    memcpy(out, "T5DR", 4);
+    for (int i = 0; i < 8; i++) out[4 + i] = (u8)(id >> (56 - 8 * i));
+}
+static u64 room_id_decode(u32 ea)
+{
+    u64 id = 0;
+    if (!ea) return 0;
+    const u8* p = GUEST_PTR(ea, const u8*);
+    if (memcmp(p, "T5DR", 4) != 0) return 0;
+    for (int i = 0; i < 8; i++) id = (id << 8) | p[4 + i];
+    return id;
+}
+
+/* ---- callbacks into the title ---- */
+static void queue_cb(u32 opd, u64 a0, u64 a1, u64 a2, u64 a3, u64 a4)
+{
+    const u64 args[8] = { a0, a1, a2, a3, a4, 0, 0, 0 };
+    if (opd) cellSysutilQueueGuestCallbackArgs(opd, args);
+}
+static void gui_event(s32 event, s32 error)
+{
+    if (np_psnr_trace() || error) printf("[sceNpMatching] GUI event %d error 0x%08X\n", event, (u32)error);
+    queue_cb(s_gui_handler, 1, (u64)(u32)event, (u64)(u32)error, s_gui_arg, 0);
+}
+static void gui_finish(s32 event, s32 error, rb_t* img)
+{
+    if (img) {
+        rb_free(&s_gui_result.img);
+        s_gui_result.img = *img;
+        memset(img, 0, sizeof(*img));
+        s_gui_result.event = event;
+        s_gui_result.valid = 1;
+    }
+    gui_event(event, error);
+    gui_event(GUI_COMMON_UNLOAD, 0);
+    s_gui_busy = 0;
+    s_op.kind = 0;
+}
+static void matching_event(u32 req, s32 event, s32 error, rb_t* img)
+{
+    if (img) {
+        int i = s_result_next++ % RESULT_RING;
+        rb_free(&s_results[i].img);
+        s_results[i].req = req;
+        s_results[i].event = event;
+        s_results[i].img = *img;
+        memset(img, 0, sizeof(*img));
+    }
+    if (np_psnr_trace() || error) printf("[sceNpMatching] event %d req %u error 0x%08X\n", event, req, (u32)error);
+    queue_cb(s_handler, 1, req, (u64)(u32)event, (u64)(u32)error, s_handler_arg);
+}
+
+/* ---- image builders ---- */
+static void put_user_info(rb_t* r, u32 o, const char* online_id)
+{
+    memset(r->b + o, 0, 216);
+    strncpy((char*)r->b + o, online_id, 16);          /* NpId.handle.data */
+    strncpy((char*)r->b + o + 36, online_id, 48);     /* OnlineName.data */
+}
+
+/* RoomStatus at offset o (56 bytes already allocated); members appended. */
+static void build_room_status(rb_t* r, u32 o)
+{
+    u8 rid[36];
+    room_id_encode(s_room.room_id, rid);
+    memcpy(r->b + o, rid, 36);
+    rb_32(r, o + 40, (u32)s_room.nmembers);
+    u32 prev = 0;
+    for (int i = 0; i < s_room.nmembers; i++) {
+        u32 m = rb_alloc(r, 224, 8);
+        put_user_info(r, m + 4, s_room.members[i].online_id);
+        rb_32(r, m + 220, s_room.members[i].owner ? 1 : 0);
+        if (prev) rb_ptr(r, prev, m); else rb_ptr(r, o + 36, m);
+        prev = m;
+    }
+}
+
+static void build_joined_room_info(rb_t* r)
+{
+    memset(r, 0, sizeof(*r));
+    u32 o = rb_alloc(r, 92, 8);
+    memcpy(r->b + o, LOBBY_ID, 36);
+    build_room_status(r, o + 36);
+}
+
+/* Attr chain for a room: `want` selects attributes (type,id); NULL = all stored + basic. */
+static u32 build_attr_chain(rb_t* r, const attr_t* stored, int nstored, u8 cur, u8 max, u32 flags,
+                            const u16* want_type, const u16* want_id, int nwant)
+{
+    attr_t basic[7];
+    memset(basic, 0, sizeof(basic));
+    for (int i = 0; i < 7; i++) { basic[i].type = ATTR_BASIC_NUM; basic[i].id = (u8)(i + 1); }
+    basic[0].num = max; basic[1].num = 0; basic[2].num = cur; basic[3].num = cur; basic[4].num = 0;
+    basic[5].num = 0; basic[6].num = (flags & FLAG_STEALTH) ? 1 : 0;
+
+    u32 head = 0, prev = 0;
+    int total = nwant ? nwant : nstored + 7;
+    for (int i = 0; i < total; i++) {
+        const attr_t* a;
+        if (nwant) {
+            a = NULL;
+            if (want_type[i] == ATTR_BASIC_NUM && want_id[i] >= 1 && want_id[i] <= 7) a = &basic[want_id[i] - 1];
+            else for (int k = 0; k < nstored; k++)
+                if (stored[k].type == want_type[i] && stored[k].id == want_id[i]) { a = &stored[k]; break; }
+            if (!a) {   /* unknown attribute: answer zero so the title's list stays intact */
+                static attr_t z; memset(&z, 0, sizeof(z)); z.type = (u8)want_type[i]; z.id = (u8)want_id[i]; a = &z;
+            }
+        } else a = i < nstored ? &stored[i] : &basic[i - nstored];
+        u32 e = rb_alloc(r, 20, 4);
+        rb_32(r, e + 4, a->type);
+        rb_32(r, e + 8, a->id);
+        if (attr_is_bin(a->type)) {
+            u32 d = rb_alloc(r, a->size ? a->size : 1, 4);
+            memcpy(r->b + d, a->bin, a->size);
+            rb_ptr(r, e + 12, d);
+            rb_32(r, e + 16, a->size);
+        } else rb_32(r, e + 12, a->num);
+        if (prev) rb_ptr(r, prev, e); else head = e;
+        prev = e;
+    }
+    return head;
+}
+
+/* ---- room list parsing (ROOM_LIST reply) ---- */
+typedef struct {
+    u64 id; char owner[17]; u8 cur, max; u32 flags; const u8* ext; u16 extlen;
+    u32 owner_user; u8 owner_ip[4]; u16 owner_port;
+} listed_t;
+
+static int parse_room_list(const u8* d, u32 len, listed_t* out, int cap, u16* total)
+{
+    int with_addr = (np_psnr_server_flags() & NP_PSNR_FLAG_LIST_ADDRESS) != 0;
+    if (len < 4) return 0;
+    *total = np_get16(d);
+    u16 count = np_get16(d + 2);
+    u32 o = 4;
+    int n = 0;
+    for (u16 i = 0; i < count && n < cap; i++) {
+        if (o + 8 + 16 + 1 + 1 + 4 + 2 > len) break;
+        listed_t* r = &out[n];
+        memset(r, 0, sizeof(*r));
+        r->id = np_get64(d + o); o += 8;
+        memcpy(r->owner, d + o, 16); r->owner[16] = 0; o += 16;
+        r->cur = d[o++]; r->max = d[o++];
+        r->flags = np_get32(d + o); o += 4;
+        r->extlen = np_get16(d + o); o += 2;
+        if (o + r->extlen > len) break;
+        r->ext = d + o; o += r->extlen;
+        if (with_addr) {
+            if (o + 10 > len) break;
+            r->owner_user = np_get32(d + o);
+            memcpy(r->owner_ip, d + o + 4, 4);
+            r->owner_port = np_get16(d + o + 8);
+            o += 10;
+        }
+        n++;
+    }
+    return n;
+}
+
+static int cond_matches(const cond_t* c, const attr_t* a, int n, u8 cur, u8 max, u32 flags)
+{
+    attr_t basic; memset(&basic, 0, sizeof(basic));
+    const attr_t* t = NULL;
+    if (c->target_type == ATTR_BASIC_NUM && c->target_id >= 1 && c->target_id <= 7) {
+        basic.type = ATTR_BASIC_NUM; basic.id = c->target_id;
+        switch (c->target_id) {
+            case ROOM_ATTR_TOTAL_SLOT: basic.num = max; break;
+            case ROOM_ATTR_CUR_TOTAL_NUM: case ROOM_ATTR_CUR_PUBLIC_NUM: basic.num = cur; break;
+            case ROOM_ATTR_ROOM_SEARCH_FLAG: basic.num = (flags & FLAG_STEALTH) ? 1 : 0; break;
+            default: basic.num = 0;
+        }
+        t = &basic;
+    } else
+        for (int i = 0; i < n; i++) if (a[i].type == c->target_type && a[i].id == c->target_id) { t = &a[i]; break; }
+    if (!t) return c->op == COND_NE;   /* no such attribute: only "not equal" holds */
+    if (attr_is_bin(t->type)) {
+        int eq = t->size == c->cmp.size && memcmp(t->bin, c->cmp.bin, t->size) == 0;
+        return c->op == COND_NE ? !eq : eq;
+    }
+    u32 v = t->num, w = c->cmp.num;
+    switch (c->op) {
+        case COND_EQ: return v == w;
+        case COND_NE: return v != w;
+        case COND_LT: return v < w;
+        case COND_LE: return v <= w;
+        case COND_GT: return v > w;
+        case COND_GE: return v >= w;
+    }
+    return 0;
+}
+
+/* Rooms are few on a private server: a quick match joins any open room that
+ * satisfies its conditions, including ones made with "create room", and the
+ * room browser lists quick-match rooms too. (PSN kept the two apart.) */
+static int room_matches(const listed_t* r, const cond_t* c, int nc, int quick_only)
+{
+    attr_t a[MAX_ATTRS];
+    int n = unpack_attrs(r->ext, r->extlen, a, MAX_ATTRS);
+    (void)quick_only;
+    if (r->flags & FLAG_STEALTH) return 0;
+    if (r->cur >= r->max) return 0;
+    for (int i = 0; i < nc; i++) if (!cond_matches(&c[i], a, n, r->cur, r->max, r->flags)) return 0;
+    return 1;
+}
+
+static void cache_room(const listed_t* r)
+{
+    room_cache_t* c = NULL;
+    for (int i = 0; i < s_ncache; i++) if (s_cache[i].room_id == r->id) { c = &s_cache[i]; break; }
+    if (!c) c = &s_cache[s_ncache < ROOM_CACHE ? s_ncache++ : (ROOM_CACHE - 1)];
+    memset(c, 0, sizeof(*c));
+    c->room_id = r->id; c->cur = r->cur; c->max = r->max; c->flags = r->flags;
+    memcpy(c->owner, r->owner, 17);
+    c->owner_user = r->owner_user; memcpy(c->owner_ip, r->owner_ip, 4); c->owner_port = r->owner_port;
+    c->nattrs = unpack_attrs(r->ext, r->extlen, c->attrs, MAX_ATTRS);
+}
+
+/* ---- ROOM_JOINED reply -> s_room ---- */
+static int parse_room_joined(const u8* d, u32 len)
+{
+    if (len < 8 + 2 + 2 + 1 + 4 + 2) return -1;
+    u32 o = 0;
+    room_t* r = &s_room;
+    memset(r, 0, sizeof(*r));
+    r->room_id = np_get64(d + o); o += 8;
+    r->my_member = np_get16(d + o); o += 2;
+    r->owner = np_get16(d + o); o += 2;
+    r->max = d[o++];
+    r->flags = np_get32(d + o); o += 4;
+    u16 extlen = np_get16(d + o); o += 2;
+    if (o + extlen + 2 > len) return -1;
+    r->nattrs = unpack_attrs(d + o, extlen, r->attrs, MAX_ATTRS); o += extlen;
+    u16 intlen = np_get16(d + o); o += 2 + intlen;
+    if (o + 1 > len) return -1;
+    u8 count = d[o++];
+    for (u8 i = 0; i < count && r->nmembers < MAX_MEMBERS; i++) {
+        if (o + 29 + 2 > len) return -1;
+        member_t* m = &r->members[r->nmembers];
+        m->member_id = np_get16(d + o); m->user = np_get32(d + o + 2);
+        memcpy(m->online_id, d + o + 6, 16); m->online_id[16] = 0;
+        memcpy(m->ip, d + o + 22, 4); m->port = np_get16(d + o + 26); m->owner = d[o + 28];
+        o += 29;
+        u16 dl = np_get16(d + o); o += 2 + dl;
+        r->nmembers++;
+    }
+    r->in_room = 1;
+    for (int i = 0; i < r->nmembers; i++)
+        np_psnr_peer_add(r->members[i].user, r->members[i].ip, r->members[i].port);
+    printf("[sceNpMatching] in room %llu as member %u (owner %u, %d/%u):", (unsigned long long)r->room_id,
+           r->my_member, r->owner, r->nmembers, r->max);
+    for (int i = 0; i < r->nmembers; i++)
+        printf(" %s@%u.%u.%u.%u:%u%s", r->members[i].online_id, r->members[i].ip[0], r->members[i].ip[1],
+               r->members[i].ip[2], r->members[i].ip[3], r->members[i].port, r->members[i].owner ? "(owner)" : "");
+    printf("\n");
+    return 0;
+}
+
+static void leave_room_locally(void)
+{
+    for (int i = 0; i < s_room.nmembers; i++) np_psnr_peer_remove(s_room.members[i].user);
+    memset(&s_room, 0, sizeof(s_room));
+}
+
+int np_matching_find_member(const char* online_id, uint32_t* user, u8 ip[4], u16* port)
+{
+    if (s_room.in_room)
+        for (int i = 0; i < s_room.nmembers; i++)
+            if (strncmp(s_room.members[i].online_id, online_id, 16) == 0) {
+                if (user) *user = s_room.members[i].user;
+                if (ip) memcpy(ip, s_room.members[i].ip, 4);
+                if (port) *port = s_room.members[i].port;
+                return 1;
+            }
+    /* Not a member: the host of a room in the last room list. The title pings
+     * every listed room's host from its room browser before joining. */
+    for (int i = 0; i < s_ncache; i++)
+        if (s_cache[i].owner_port && strncmp(s_cache[i].owner, online_id, 16) == 0) {
+            if (user) *user = s_cache[i].owner_user;
+            if (ip) memcpy(ip, s_cache[i].owner_ip, 4);
+            if (port) *port = s_cache[i].owner_port;
+            return 1;
+        }
+    return 0;
+}
+
+static s32 psnr_error_to_np(const np_psnr_msg* m, s32 fallback)
+{
+    if (m->type == 0) return (s32)SERVER_E_OUT_OF_SERVICE;
+    if (m->type != PSNR_ERROR || m->len < 4) return fallback;
+    switch (np_get32(m->data)) {
+        case PSNR_E_NOT_FOUND:   return (s32)SERVER_E_NO_SUCH_ROOM;
+        case PSNR_E_ROOM_FULL:   return (s32)SERVER_E_ROOM_CLOSED;
+        case PSNR_E_NOT_OWNER:   return (s32)SERVER_E_NOT_ALLOWED;
+        case PSNR_E_NOT_IN_ROOM: return (s32)SERVER_E_NO_SUCH_ROOM;
+        default:                 return fallback;
+    }
+}
+
+/* ---- requests ---- */
+static u32 send_create_room(const attr_t* a, int n, u8 max, u32 flags, np_psnr_reply_fn fn)
+{
+    u8 body[1 + 4 + 2 + 2048 + 2 + 2];
+    u32 o = 0;
+    body[o++] = max;
+    body[o++] = (u8)(flags >> 24); body[o++] = (u8)(flags >> 16); body[o++] = (u8)(flags >> 8); body[o++] = (u8)flags;
+    u32 el = pack_attrs(a, n, body + o + 2, 2048);
+    body[o] = (u8)(el >> 8); body[o + 1] = (u8)el; o += 2 + el;
+    body[o++] = 0; body[o++] = 0;   /* internal */
+    body[o++] = 0; body[o++] = 0;   /* member data */
+    return np_psnr_request(PSNR_CREATE_ROOM, body, o, fn, NULL);
+}
+static u32 send_search(np_psnr_reply_fn fn)
+{
+    u8 body[4] = { 0, 0, 0, SEARCH_MAX };
+    return np_psnr_request(PSNR_SEARCH_ROOMS, body, 4, fn, NULL);
+}
+static u32 send_join(u64 room_id, np_psnr_reply_fn fn)
+{
+    u8 body[10];
+    for (int i = 0; i < 8; i++) body[i] = (u8)(room_id >> (56 - 8 * i));
+    body[8] = body[9] = 0;
+    return np_psnr_request(PSNR_JOIN_ROOM, body, 10, fn, NULL);
+}
+static u32 send_leave(u64 room_id, np_psnr_reply_fn fn)
+{
+    u8 body[8];
+    for (int i = 0; i < 8; i++) body[i] = (u8)(room_id >> (56 - 8 * i));
+    return np_psnr_request(PSNR_LEAVE_ROOM, body, 8, fn, NULL);
+}
+static u32 send_set_data(u64 room_id, u8 which, const u8* data, u32 len, np_psnr_reply_fn fn)
+{
+    u8 body[8 + 1 + 2 + 2048];
+    if (len > 2048) len = 2048;
+    for (int i = 0; i < 8; i++) body[i] = (u8)(room_id >> (56 - 8 * i));
+    body[8] = which; body[9] = (u8)(len >> 8); body[10] = (u8)len;
+    memcpy(body + 11, data, len);
+    return np_psnr_request(PSNR_SET_ROOM_DATA, body, 11 + len, fn, NULL);
+}
+static u32 send_kick(u64 room_id, u16 member, np_psnr_reply_fn fn)
+{
+    u8 body[10];
+    for (int i = 0; i < 8; i++) body[i] = (u8)(room_id >> (56 - 8 * i));
+    body[8] = (u8)(member >> 8); body[9] = (u8)member;
+    return np_psnr_request(PSNR_KICK_MEMBER, body, 10, fn, NULL);
+}
+
+static int ensure_connected(void)
+{
+    if (np_psnr_connected()) return 1;
+    return np_psnr_connect(s_comm_id) == 0;
+}
+
+/* The non-GUI reply handlers take the NP request id as `user`. */
+static u32 send_with_req(u8 type, const u8* body, u32 len, np_psnr_reply_fn fn, u32 req)
+{
+    return np_psnr_request(type, body, len, fn, (void*)(uintptr_t)req);
+}
+
+/* ---- reply handlers: GUI operations ---- */
+
+static void on_create_room_reply(void* user, const np_psnr_msg* m)
+{
+    (void)user;
+    rb_t img;
+    if (m->type != PSNR_ROOM_JOINED || parse_room_joined(m->data, m->len)) {
+        gui_finish(GUI_CREATE_ROOM, psnr_error_to_np(m, (s32)E_ROOM_MAX), NULL);
+        return;
+    }
+    build_joined_room_info(&img);
+    gui_finish(GUI_CREATE_ROOM, 0, &img);
+}
+
+static void on_join_room_reply(void* user, const np_psnr_msg* m)
+{
+    (void)user;
+    rb_t img;
+    int ev = s_op.kind == GUI_SEARCH_JOIN ? GUI_SEARCH_JOIN : s_op.kind == GUI_QUICK_MATCH ? GUI_QUICK_MATCH : GUI_JOIN_ROOM;
+    if (m->type != PSNR_ROOM_JOINED || parse_room_joined(m->data, m->len)) {
+        if (s_op.kind == GUI_SEARCH_JOIN) { gui_finish(ev, (s32)E_SEARCH_JOIN_NOT_FOUND, NULL); return; }
+        if (s_op.kind == GUI_QUICK_MATCH) { gui_finish(ev, (s32)E_QM_PLAYER_NOT_FOUND, NULL); return; }
+        gui_finish(ev, psnr_error_to_np(m, (s32)SERVER_E_NO_SUCH_ROOM), NULL);
+        return;
+    }
+    if (ev == GUI_SEARCH_JOIN) {
+        memset(&img, 0, sizeof(img));
+        u32 o = rb_alloc(&img, 96, 8);
+        memcpy(img.b + o, LOBBY_ID, 36);
+        build_room_status(&img, o + 36);
+        u32 head = build_attr_chain(&img, s_room.attrs, s_room.nattrs, (u8)s_room.nmembers, s_room.max, s_room.flags, NULL, NULL, 0);
+        if (head) rb_ptr(&img, o + 92, head);
+    } else build_joined_room_info(&img);
+    gui_finish(ev, 0, &img);
+}
+
+static void on_quick_create_reply(void* user, const np_psnr_msg* m)
+{
+    (void)user;
+    if (m->type != PSNR_ROOM_JOINED || parse_room_joined(m->data, m->len)) {
+        gui_finish(GUI_QUICK_MATCH, psnr_error_to_np(m, (s32)E_QM_PLAYER_NOT_FOUND), NULL);
+        return;
+    }
+    s_op.waiting = 1;
+    printf("[sceNpMatching] quick match: waiting in room %llu for a player (%d s)\n",
+           (unsigned long long)s_room.room_id, (int)((s_op.deadline - now_ms()) / 1000));
+}
+
+static void on_search_reply(void* user, const np_psnr_msg* m)
+{
+    (void)user;
+    listed_t rooms[SEARCH_MAX];
+    u16 total = 0;
+    int n = m->type == PSNR_ROOM_LIST ? parse_room_list(m->data, m->len, rooms, SEARCH_MAX, &total) : 0;
+    for (int i = 0; i < n; i++) cache_room(&rooms[i]);
+
+    if (s_op.kind == GUI_GET_ROOM_LIST_LIMIT) {
+        rb_t img;
+        memset(&img, 0, sizeof(img));
+        u32 o = rb_alloc(&img, 52, 8);
+        memcpy(img.b + o, LOBBY_ID, 36);
+        u32 prev = 0, results = 0, skipped = 0;
+        u32 first = s_op.start ? s_op.start - 1 : 0;   /* SceNpMatchingReqRange.start is 1-based */
+        for (int i = 0; i < n; i++) {
+            if (!room_matches(&rooms[i], s_op.conds, s_op.nconds, 0)) continue;
+            if (skipped < first) { skipped++; continue; }
+            if (s_op.max && results >= s_op.max) break;
+            attr_t a[MAX_ATTRS];
+            int na = unpack_attrs(rooms[i].ext, rooms[i].extlen, a, MAX_ATTRS);
+            u32 e = rb_alloc(&img, 44, 8);
+            u8 rid[36]; room_id_encode(rooms[i].id, rid);
+            memcpy(img.b + e + 4, rid, 36);
+            /* Every stored attribute plus the basic ones, whatever the title asked
+             * for: Tekken 5 DR asks for 13 but validates a joined room against
+             * GAME_NUM id 5 (its data version, 81100) read off this very list;
+             * a list without it made the joiner drop the connection. */
+            u32 head = build_attr_chain(&img, a, na, rooms[i].cur, rooms[i].max, rooms[i].flags, NULL, NULL, 0);
+            if (head) rb_ptr(&img, e + 40, head);
+            if (prev) rb_ptr(&img, prev, e); else rb_ptr(&img, o + 48, e);
+            prev = e;
+            results++;
+        }
+        u32 matching = 0;
+        for (int i = 0; i < n; i++) if (room_matches(&rooms[i], s_op.conds, s_op.nconds, 0)) matching++;
+        rb_32(&img, o + 36, s_op.start);
+        rb_32(&img, o + 40, results);
+        rb_32(&img, o + 44, matching);
+        printf("[sceNpMatching] room list: %u of %d room(s) match, %u listed from %u\n", matching, n, results, s_op.start);
+        gui_finish(GUI_GET_ROOM_LIST_LIMIT, 0, &img);
+        return;
+    }
+
+    int quick = s_op.kind == GUI_QUICK_MATCH;
+    for (int i = 0; i < n; i++) {
+        if (!room_matches(&rooms[i], s_op.conds, s_op.nconds, quick)) continue;
+        printf("[sceNpMatching] %s: joining room %llu (%s, %u/%u)\n", quick ? "quick match" : "search join",
+               (unsigned long long)rooms[i].id, rooms[i].owner, rooms[i].cur, rooms[i].max);
+        if (!send_join(rooms[i].id, on_join_room_reply))
+            gui_finish(s_op.kind, quick ? (s32)E_QM_PLAYER_NOT_FOUND : (s32)E_SEARCH_JOIN_NOT_FOUND, NULL);
+        return;
+    }
+    if (!quick) {
+        printf("[sceNpMatching] search join: no room of %d matches\n", n);
+        gui_finish(GUI_SEARCH_JOIN, (s32)E_SEARCH_JOIN_NOT_FOUND, NULL);
+        return;
+    }
+    /* Nobody to join: open a quick-match room from the conditions and wait. */
+    attr_t a[MAX_ATTRS];
+    int na = 0;
+    for (int i = 0; i < s_op.nconds && na < MAX_ATTRS; i++) {
+        if (s_op.conds[i].op != COND_EQ) continue;
+        if (s_op.conds[i].target_type == ATTR_BASIC_NUM) continue;
+        a[na] = s_op.conds[i].cmp;
+        a[na].type = s_op.conds[i].target_type;
+        a[na].id = s_op.conds[i].target_id;
+        na++;
+    }
+    u8 max = (u8)(s_op.available_num > 0 && s_op.available_num < 16 ? s_op.available_num : DEFAULT_SLOTS);
+    if (!send_create_room(a, na, max, FLAG_QUICK, on_quick_create_reply))
+        gui_finish(GUI_QUICK_MATCH, (s32)E_QM_PLAYER_NOT_FOUND, NULL);
+}
+
+/* ---- reply handlers: non-GUI operations ---- */
+
+static void on_leave_reply(void* user, const np_psnr_msg* m)
+{
+    u32 req = (u32)(uintptr_t)user;
+    rb_t img;
+    memset(&img, 0, sizeof(img));
+    u32 o = rb_alloc(&img, 56, 8);
+    build_room_status(&img, o);
+    leave_room_locally();
+    matching_event(req, EV_LEAVE_ROOM_DONE, m->type == PSNR_OK ? 0 : psnr_error_to_np(m, 0), &img);
+}
+
+static void on_set_info_reply(void* user, const np_psnr_msg* m)
+{
+    u32 req = (u32)(uintptr_t)user;
+    matching_event(req, EV_SET_ROOM_INFO_DONE, m->type == PSNR_OK ? 0 : psnr_error_to_np(m, (s32)SERVER_E_NOT_ALLOWED), NULL);
+}
+
+static void on_set_flag_reply(void* user, const np_psnr_msg* m)
+{
+    u32 req = (u32)(uintptr_t)user;
+    matching_event(req, EV_SET_ROOM_SEARCH_FLAG_DONE, m->type == PSNR_OK ? 0 : psnr_error_to_np(m, (s32)SERVER_E_NOT_ALLOWED), NULL);
+}
+
+static void on_kick_reply(void* user, const np_psnr_msg* m)
+{
+    u32 req = (u32)(uintptr_t)user;
+    matching_event(req, EV_KICK_MEMBER_DONE, m->type == PSNR_OK ? 0 : psnr_error_to_np(m, (s32)SERVER_E_NOT_ALLOWED), NULL);
+}
+
+/* ---- pushes ---- */
+
+static void room_status_event(s32 event)
+{
+    rb_t img;
+    memset(&img, 0, sizeof(img));
+    u32 o = rb_alloc(&img, 56, 8);
+    build_room_status(&img, o);
+    matching_event(s_next_req++, event, 0, &img);
+}
+
+static void on_push(const np_psnr_msg* m)
+{
+    if (!s_room.in_room || m->len < 8 || np_get64(m->data) != s_room.room_id) return;
+    const u8* d = m->data + 8;
+    u32 len = m->len - 8;
+    switch (m->type) {
+    case PSNR_MEMBER_JOINED: {
+        if (len < 29 || s_room.nmembers >= MAX_MEMBERS) return;
+        member_t* mb = &s_room.members[s_room.nmembers++];
+        memset(mb, 0, sizeof(*mb));
+        mb->member_id = np_get16(d); mb->user = np_get32(d + 2);
+        memcpy(mb->online_id, d + 6, 16);
+        memcpy(mb->ip, d + 22, 4); mb->port = np_get16(d + 26); mb->owner = d[28];
+        np_psnr_peer_add(mb->user, mb->ip, mb->port);
+        printf("[sceNpMatching] %s joined the room (%d/%u) at %u.%u.%u.%u:%u\n", mb->online_id, s_room.nmembers,
+               s_room.max, mb->ip[0], mb->ip[1], mb->ip[2], mb->ip[3], mb->port);
+        if (s_op.kind == GUI_QUICK_MATCH && s_op.waiting) {
+            rb_t img;
+            build_joined_room_info(&img);
+            s_op.waiting = 0;
+            gui_finish(GUI_QUICK_MATCH, 0, &img);
+        } else room_status_event(EV_ROOM_UPDATE_NEW_MEMBER);
+        break;
+    }
+    case PSNR_MEMBER_LEFT: {
+        if (len < 4) return;
+        u16 mid = np_get16(d), owner = np_get16(d + 2);
+        for (int i = 0; i < s_room.nmembers; i++)
+            if (s_room.members[i].member_id == mid) {
+                printf("[sceNpMatching] %s left the room\n", s_room.members[i].online_id);
+                np_psnr_peer_remove(s_room.members[i].user);
+                memmove(&s_room.members[i], &s_room.members[i + 1], (size_t)(s_room.nmembers - i - 1) * sizeof(member_t));
+                s_room.nmembers--;
+                break;
+            }
+        int owner_changed = owner != s_room.owner;
+        s_room.owner = owner;
+        for (int i = 0; i < s_room.nmembers; i++) s_room.members[i].owner = s_room.members[i].member_id == owner;
+        room_status_event(EV_ROOM_UPDATE_MEMBER_LEAVE);
+        if (owner_changed) room_status_event(EV_ROOM_UPDATE_OWNER_CHANGE);
+        break;
+    }
+    case PSNR_KICKED: {
+        rb_t img;
+        memset(&img, 0, sizeof(img));
+        u32 o = rb_alloc(&img, 56, 8);
+        build_room_status(&img, o);
+        printf("[sceNpMatching] kicked from the room\n");
+        leave_room_locally();
+        matching_event(s_next_req++, EV_ROOM_KICKED, 0, &img);
+        break;
+    }
+    case PSNR_ROOM_DATA: {
+        if (len < 3) return;
+        u8 which = d[0];
+        u16 dl = np_get16(d + 1);
+        if (3u + dl > len) return;
+        if (which == 0) s_room.nattrs = unpack_attrs(d + 3, dl, s_room.attrs, MAX_ATTRS);
+        else if (which == 2 && dl == 4) s_room.flags = np_get32(d + 3);
+        break;
+    }
+    default: break;
+    }
+}
+
+static void on_tick(void)
+{
+    if (s_op.kind == GUI_QUICK_MATCH && s_op.waiting && now_ms() >= s_op.deadline) {
+        printf("[sceNpMatching] quick match: nobody came, giving up\n");
+        s_op.waiting = 0;
+        if (s_room.in_room) { send_leave(s_room.room_id, NULL); leave_room_locally(); }
+        gui_finish(GUI_QUICK_MATCH, (s32)E_QM_PLAYER_NOT_FOUND, NULL);
+    }
+}
+
+/* ---- API ---- */
+
+static void read_comm_id(u32 ea)
+{
+    if (!ea) return;
+    const char* p = GUEST_PTR(ea, const char*);
+    char id[13];
+    memset(id, 0, sizeof(id));
+    strncpy(id, p, 9);
+    if (id[0]) snprintf(s_comm_id, sizeof(s_comm_id), "%s_%02u", id, (unsigned)p[10]);
+}
+
+s32 sceNpMatchingCreateCtx(u32 npId, u32 handler, u32 arg, u32 ctxId)
+{
+    (void)npId;
+    printf("[sceNpMatching] CreateCtx(handler=0x%08X)\n", handler);
+    if (!ctxId) return (s32)E_INVALID_ARG;
+    if (s_ctx_used) return (s32)E_CTXID_NOT_AVAIL;
+    s_init = 1;
+    s_ctx_used = 1;
+    s_handler = handler;
+    s_handler_arg = arg;
+    np_psnr_on_push(on_push);
+    np_psnr_on_tick(on_tick);
+    vm_write32(ctxId, 1);
+    return CELL_OK;
+}
+
+s32 sceNpMatchingDestroyCtx(u32 ctxId)
+{
+    printf("[sceNpMatching] DestroyCtx(%u)\n", ctxId);
+    if (ctxId != 1 || !s_ctx_used) return (s32)E_CTX_NOT_FOUND;
+    if (s_room.in_room) { send_leave(s_room.room_id, NULL); leave_room_locally(); }
+    s_ctx_used = 0;
+    s_gui_busy = 0;
+    s_op.kind = 0;
+    return CELL_OK;
+}
+
+static s32 gui_begin(u32 ctxId, u32 handler, u32 arg, int kind)
+{
+    if (ctxId != 1 || !s_ctx_used) return (s32)E_CTX_NOT_FOUND;
+    if (s_gui_busy) return (s32)E_CTX_STILL_RUNNING;
+    if (!ensure_connected()) return (s32)SERVER_E_OUT_OF_SERVICE;
+    s_gui_busy = 1;
+    s_gui_handler = handler;
+    s_gui_arg = arg;
+    memset(&s_op, 0, sizeof(s_op));
+    s_op.kind = kind;
+    s_gui_result.valid = 0;
+    gui_event(GUI_COMMON_LOAD, 0);
+    return CELL_OK;
+}
+
+s32 sceNpMatchingCreateRoomGUI(u32 ctxId, u32 commId, u32 attr, u32 handler, u32 arg)
+{
+    read_comm_id(commId);
+    s32 r = gui_begin(ctxId, handler, arg, GUI_CREATE_ROOM);
+    if (r) { printf("[sceNpMatching] CreateRoomGUI -> 0x%08X\n", (u32)r); return r; }
+    s_op.nattrs = read_attrs(attr, s_op.attrs, MAX_ATTRS);
+    log_attrs("CreateRoomGUI", s_op.attrs, s_op.nattrs);
+    attr_t* slots = attr_find(s_op.attrs, s_op.nattrs, ATTR_BASIC_NUM, ROOM_ATTR_TOTAL_SLOT);
+    u8 max = (u8)(slots && slots->num > 0 && slots->num < 16 ? slots->num : DEFAULT_SLOTS);
+    attr_t* sf = attr_find(s_op.attrs, s_op.nattrs, ATTR_BASIC_NUM, ROOM_ATTR_ROOM_SEARCH_FLAG);
+    u32 flags = sf && sf->num ? FLAG_STEALTH : 0;
+    if (s_room.in_room) { send_leave(s_room.room_id, NULL); leave_room_locally(); }
+    if (!send_create_room(s_op.attrs, s_op.nattrs, max, flags, on_create_room_reply)) {
+        gui_finish(GUI_CREATE_ROOM, (s32)SERVER_E_OUT_OF_SERVICE, NULL);
+    }
+    return CELL_OK;
+}
+
+s32 sceNpMatchingJoinRoomGUI(u32 ctxId, u32 roomId, u32 handler, u32 arg)
+{
+    s32 r = gui_begin(ctxId, handler, arg, GUI_JOIN_ROOM);
+    if (r) return r;
+    u64 id = room_id_decode(roomId);
+    printf("[sceNpMatching] JoinRoomGUI(room %llu)\n", (unsigned long long)id);
+    if (s_room.in_room) { send_leave(s_room.room_id, NULL); leave_room_locally(); }
+    if (!id || !send_join(id, on_join_room_reply)) gui_finish(GUI_JOIN_ROOM, (s32)SERVER_E_NO_SUCH_ROOM, NULL);
+    return CELL_OK;
+}
+
+s32 sceNpMatchingSearchJoinRoomGUI(u32 ctxId, u32 commId, u32 cond, u32 attr, u32 handler, u32 arg)
+{
+    read_comm_id(commId);
+    s32 r = gui_begin(ctxId, handler, arg, GUI_SEARCH_JOIN);
+    if (r) return r;
+    s_op.nconds = read_conds(cond, s_op.conds, 9);
+    s_op.nattrs = read_attrs(attr, s_op.attrs, MAX_ATTRS);
+    log_conds("SearchJoinRoomGUI", s_op.conds, s_op.nconds);
+    if (s_room.in_room) { send_leave(s_room.room_id, NULL); leave_room_locally(); }
+    if (!send_search(on_search_reply)) gui_finish(GUI_SEARCH_JOIN, (s32)E_SEARCH_JOIN_NOT_FOUND, NULL);
+    return CELL_OK;
+}
+
+s32 sceNpMatchingQuickMatchGUI(u32 ctxId, u32 commId, u32 cond, s32 availableNum, s32 timeout, u32 handler, u32 arg)
+{
+    read_comm_id(commId);
+    s32 r = gui_begin(ctxId, handler, arg, GUI_QUICK_MATCH);
+    if (r) return r;
+    s_op.nconds = read_conds(cond, s_op.conds, 9);
+    s_op.available_num = availableNum;
+    s_op.deadline = now_ms() + (u64)(timeout > 0 ? timeout : 300) * 1000u;
+    printf("[sceNpMatching] QuickMatchGUI(available_num=%d, timeout=%d s)\n", availableNum, timeout);
+    log_conds("QuickMatchGUI", s_op.conds, s_op.nconds);
+    if (s_room.in_room) { send_leave(s_room.room_id, NULL); leave_room_locally(); }
+    if (!send_search(on_search_reply)) gui_finish(GUI_QUICK_MATCH, (s32)E_QM_PLAYER_NOT_FOUND, NULL);
+    return CELL_OK;
+}
+
+s32 sceNpMatchingGetRoomListLimitGUI(u32 ctxId, u32 commId, u32 range, u32 cond, u32 attr, u32 handler, u32 arg)
+{
+    read_comm_id(commId);
+    s32 r = gui_begin(ctxId, handler, arg, GUI_GET_ROOM_LIST_LIMIT);
+    if (r) return r;
+    s_op.start = range ? vm_read32(range) : 0;
+    s_op.max = range ? vm_read32(range + 4) : 0;
+    s_op.nconds = read_conds(cond, s_op.conds, 9);
+    attr_t want[16];
+    int nw = read_attrs(attr, want, 16);
+    s_op.nreq_attr = nw;
+    for (int i = 0; i < nw; i++) { s_op.req_attr_type[i] = want[i].type; s_op.req_attr_id[i] = want[i].id; }
+    printf("[sceNpMatching] GetRoomListLimitGUI(start=%u max=%u, %d attr(s) wanted:", s_op.start, s_op.max, nw);
+    for (int i = 0; i < nw; i++) printf(" %u/%u", want[i].type, want[i].id);
+    printf(")\n");
+    log_conds("GetRoomListLimitGUI", s_op.conds, s_op.nconds);
+    if (!send_search(on_search_reply)) gui_finish(GUI_GET_ROOM_LIST_LIMIT, (s32)SERVER_E_OUT_OF_SERVICE, NULL);
+    return CELL_OK;
+}
+
+s32 sceNpMatchingSendInvitationGUI(u32 ctxId, u32 roomId, u32 commId, u32 dsts, s32 num, s32 slotType, u32 subject, u32 body)
+{
+    (void)roomId; (void)commId; (void)dsts; (void)num; (void)slotType; (void)subject; (void)body;
+    printf("[sceNpMatching] SendInvitationGUI: no friends list here -> CANCELED\n");
+    if (ctxId != 1 || !s_ctx_used) return (s32)E_CTX_NOT_FOUND;
+    /* The handler/arg are the 10th/11th arguments, past r10: unreachable from
+     * this adapter. Report through the last GUI handler we were given. */
+    if (s_gui_busy) return (s32)E_CTX_STILL_RUNNING;
+    s_gui_busy = 1;
+    gui_event(GUI_COMMON_LOAD, 0);
+    gui_finish(GUI_SEND_INVITATION, (s32)E_CANCELED, NULL);
+    return CELL_OK;
+}
+
+s32 sceNpMatchingAcceptInvitationGUI(u32 ctxId, u32 commId, u32 container, u32 handler, u32 arg)
+{
+    (void)commId; (void)container;
+    printf("[sceNpMatching] AcceptInvitationGUI: no invitations here -> CANCELED\n");
+    s32 r = gui_begin(ctxId, handler, arg, GUI_ACCEPT_INVITATION);
+    if (r) return r;
+    gui_finish(GUI_ACCEPT_INVITATION, (s32)E_CANCELED, NULL);
+    return CELL_OK;
+}
+
+s32 sceNpMatchingGetResultGUI(u32 buf, u32 size, u32 event)
+{
+    if (!size) return (s32)E_INVALID_ARG;
+    if (!s_gui_result.valid) return (s32)E_RESULT_NOT_FOUND;
+    if (event) vm_write32(event, (u32)s_gui_result.event);
+    if (!buf) { vm_write32(size, s_gui_result.img.len); return CELL_OK; }
+    u32 cap = vm_read32(size);
+    if (cap < s_gui_result.img.len) return (s32)E_INSUFFICIENT_BUFFER;
+    rb_copy_out(&s_gui_result.img, buf, cap);
+    vm_write32(size, s_gui_result.img.len);
+    if (np_psnr_trace()) printf("[sceNpMatching] GetResultGUI -> event %d, %u bytes\n", s_gui_result.event, s_gui_result.img.len);
+    s_gui_result.valid = 0;
+    return CELL_OK;
+}
+
+s32 sceNpMatchingGetResult(u32 ctxId, u32 reqId, u32 buf, u32 size, u32 event)
+{
+    if (ctxId != 1 || !s_ctx_used) return (s32)E_CTX_NOT_FOUND;
+    if (!size) return (s32)E_INVALID_ARG;
+    for (int i = 0; i < RESULT_RING; i++) {
+        if (s_results[i].req != reqId || !s_results[i].img.b) continue;
+        if (event) vm_write32(event, (u32)s_results[i].event);
+        if (!buf) { vm_write32(size, s_results[i].img.len); return CELL_OK; }
+        u32 cap = vm_read32(size);
+        if (cap < s_results[i].img.len) return (s32)E_INSUFFICIENT_BUFFER;
+        rb_copy_out(&s_results[i].img, buf, cap);
+        vm_write32(size, s_results[i].img.len);
+        if (np_psnr_trace()) printf("[sceNpMatching] GetResult(req %u) -> event %d, %u bytes\n", reqId, s_results[i].event, s_results[i].img.len);
+        rb_free(&s_results[i].img);
+        s_results[i].req = 0;
+        return CELL_OK;
+    }
+    return (s32)E_RESULT_NOT_FOUND;
+}
+
+s32 sceNpMatchingGetRoomMemberListLocal(u32 ctxId, u32 roomId, u32 buflen, u32 buf)
+{
+    if (ctxId != 1 || !s_ctx_used) return (s32)E_CTX_NOT_FOUND;
+    if (!s_room.in_room || room_id_decode(roomId) != s_room.room_id) return (s32)E_ROOM_NOT_FOUND;
+    rb_t img;
+    memset(&img, 0, sizeof(img));
+    u32 o = rb_alloc(&img, 56, 8);
+    build_room_status(&img, o);
+    s32 r = CELL_OK;
+    if (!buf) vm_write32(buflen, img.len);
+    else {
+        u32 cap = vm_read32(buflen);
+        if (cap < img.len) r = (s32)E_INSUFFICIENT_BUFFER;
+        else rb_copy_out(&img, buf, cap);
+        if (np_psnr_trace()) printf("[sceNpMatching] GetRoomMemberListLocal -> %d member(s), %u bytes\n", s_room.nmembers, img.len);
+    }
+    rb_free(&img);
+    return r;
+}
+
+s32 sceNpMatchingLeaveRoom(u32 ctxId, u32 roomId, u32 reqId)
+{
+    if (ctxId != 1 || !s_ctx_used) return (s32)E_CTX_NOT_FOUND;
+    u64 id = room_id_decode(roomId);
+    printf("[sceNpMatching] LeaveRoom(%llu)\n", (unsigned long long)id);
+    np_guest_backtrace("LeaveRoom");
+    if (!s_room.in_room || id != s_room.room_id) return (s32)E_ROOM_NOT_FOUND;
+    u32 req = s_next_req++;
+    if (reqId) vm_write32(reqId, req);
+    if (s_op.kind == GUI_QUICK_MATCH && s_op.waiting) { s_op.waiting = 0; gui_finish(GUI_QUICK_MATCH, (s32)E_CANCELED, NULL); }
+    u8 body[8];
+    for (int i = 0; i < 8; i++) body[i] = (u8)(id >> (56 - 8 * i));
+    if (!send_with_req(PSNR_LEAVE_ROOM, body, 8, on_leave_reply, req)) {
+        rb_t img;
+        memset(&img, 0, sizeof(img));
+        u32 o = rb_alloc(&img, 56, 8);
+        build_room_status(&img, o);
+        leave_room_locally();
+        matching_event(req, EV_LEAVE_ROOM_DONE, 0, &img);
+    }
+    return CELL_OK;
+}
+
+s32 sceNpMatchingSetRoomInfoNoLimit(u32 ctxId, u32 lobbyId, u32 roomId, u32 attr, u32 reqId)
+{
+    (void)lobbyId;
+    if (ctxId != 1 || !s_ctx_used) return (s32)E_CTX_NOT_FOUND;
+    u64 id = room_id_decode(roomId);
+    if (!s_room.in_room || id != s_room.room_id) return (s32)E_ROOM_NOT_FOUND;
+    attr_t in[MAX_ATTRS];
+    int n = read_attrs(attr, in, MAX_ATTRS);
+    log_attrs("SetRoomInfoNoLimit", in, n);
+    s_room.nattrs = attr_merge(s_room.attrs, s_room.nattrs, MAX_ATTRS, in, n);
+    u32 req = s_next_req++;
+    if (reqId) vm_write32(reqId, req);
+    u8 packed[2048];
+    u32 pl = pack_attrs(s_room.attrs, s_room.nattrs, packed, sizeof(packed));
+    u8 body[8 + 1 + 2 + 2048];
+    for (int i = 0; i < 8; i++) body[i] = (u8)(id >> (56 - 8 * i));
+    body[8] = 0; body[9] = (u8)(pl >> 8); body[10] = (u8)pl;
+    memcpy(body + 11, packed, pl);
+    if (!send_with_req(PSNR_SET_ROOM_DATA, body, 11 + pl, on_set_info_reply, req))
+        matching_event(req, EV_SET_ROOM_INFO_DONE, (s32)SERVER_E_OUT_OF_SERVICE, NULL);
+    return CELL_OK;
+}
+
+s32 sceNpMatchingGetRoomInfoNoLimit(u32 ctxId, u32 lobbyId, u32 roomId, u32 attr, u32 reqId)
+{
+    (void)lobbyId;
+    if (ctxId != 1 || !s_ctx_used) return (s32)E_CTX_NOT_FOUND;
+    u64 id = room_id_decode(roomId);
+    attr_t want[16];
+    int nw = read_attrs(attr, want, 16);
+    u16 wt[16], wi[16];
+    for (int i = 0; i < nw; i++) { wt[i] = want[i].type; wi[i] = want[i].id; }
+    u32 req = s_next_req++;
+    if (reqId) vm_write32(reqId, req);
+    rb_t img;
+    memset(&img, 0, sizeof(img));
+    u32 e = rb_alloc(&img, 44, 8);
+    u8 rid[36]; room_id_encode(id, rid);
+    memcpy(img.b + e + 4, rid, 36);
+    u32 head = 0;
+    if (s_room.in_room && id == s_room.room_id)
+        head = build_attr_chain(&img, s_room.attrs, s_room.nattrs, (u8)s_room.nmembers, s_room.max, s_room.flags, NULL, NULL, 0);
+    else {
+        room_cache_t* c = NULL;
+        for (int i = 0; i < s_ncache; i++) if (s_cache[i].room_id == id) { c = &s_cache[i]; break; }
+        if (!c) {
+            rb_free(&img);
+            printf("[sceNpMatching] GetRoomInfoNoLimit(%llu): unknown room\n", (unsigned long long)id);
+            matching_event(req, EV_GET_ROOM_INFO_DONE, (s32)SERVER_E_NO_SUCH_ROOM, NULL);
+            return CELL_OK;
+        }
+        head = build_attr_chain(&img, c->attrs, c->nattrs, c->cur, c->max, c->flags, NULL, NULL, 0);
+    (void)wt; (void)wi;   /* answered with every attribute, like the room list */
+    }
+    if (head) rb_ptr(&img, e + 40, head);
+    if (np_psnr_trace()) printf("[sceNpMatching] GetRoomInfoNoLimit(%llu, %d attr(s)) -> req %u\n", (unsigned long long)id, nw, req);
+    matching_event(req, EV_GET_ROOM_INFO_DONE, 0, &img);
+    return CELL_OK;
+}
+
+s32 sceNpMatchingSetRoomSearchFlag(u32 ctxId, u32 lobbyId, u32 roomId, s32 flag, u32 reqId)
+{
+    (void)lobbyId;
+    if (ctxId != 1 || !s_ctx_used) return (s32)E_CTX_NOT_FOUND;
+    u64 id = room_id_decode(roomId);
+    if (!s_room.in_room || id != s_room.room_id) return (s32)E_ROOM_NOT_FOUND;
+    u32 req = s_next_req++;
+    if (reqId) vm_write32(reqId, req);
+    u32 flags = (s_room.flags & ~FLAG_STEALTH) | (flag ? FLAG_STEALTH : 0);
+    s_room.flags = flags;
+    printf("[sceNpMatching] SetRoomSearchFlag(%s)\n", flag ? "stealth" : "open");
+    u8 body[8 + 1 + 2 + 4];
+    for (int i = 0; i < 8; i++) body[i] = (u8)(id >> (56 - 8 * i));
+    body[8] = 2; body[9] = 0; body[10] = 4;
+    body[11] = (u8)(flags >> 24); body[12] = (u8)(flags >> 16); body[13] = (u8)(flags >> 8); body[14] = (u8)flags;
+    if (!send_with_req(PSNR_SET_ROOM_DATA, body, 15, on_set_flag_reply, req))
+        matching_event(req, EV_SET_ROOM_SEARCH_FLAG_DONE, (s32)SERVER_E_OUT_OF_SERVICE, NULL);
+    return CELL_OK;
+}
+
+s32 sceNpMatchingKickRoomMember(u32 ctxId, u32 roomId, u32 userId, u32 reqId)
+{
+    if (ctxId != 1 || !s_ctx_used) return (s32)E_CTX_NOT_FOUND;
+    u64 id = room_id_decode(roomId);
+    if (!s_room.in_room || id != s_room.room_id) return (s32)E_ROOM_NOT_FOUND;
+    char name[17];
+    memset(name, 0, sizeof(name));
+    if (userId) strncpy(name, GUEST_PTR(userId, const char*), 16);
+    u16 member = 0;
+    for (int i = 0; i < s_room.nmembers; i++)
+        if (strncmp(s_room.members[i].online_id, name, 16) == 0) member = s_room.members[i].member_id;
+    printf("[sceNpMatching] KickRoomMember(%s -> member %u)\n", name, member);
+    if (!member) return (s32)E_MEMBER_NOT_FOUND;
+    u32 req = s_next_req++;
+    if (reqId) vm_write32(reqId, req);
+    u8 body[10];
+    for (int i = 0; i < 8; i++) body[i] = (u8)(id >> (56 - 8 * i));
+    body[8] = (u8)(member >> 8); body[9] = (u8)member;
+    if (!send_with_req(PSNR_KICK_MEMBER, body, 10, on_kick_reply, req))
+        matching_event(req, EV_KICK_MEMBER_DONE, (s32)SERVER_E_OUT_OF_SERVICE, NULL);
+    return CELL_OK;
+}
diff --git a/libs/network/sceNpMatching.h b/libs/network/sceNpMatching.h
new file mode 100644
index 0000000..05a619b
--- /dev/null
+++ b/libs/network/sceNpMatching.h
@@ -0,0 +1,42 @@
+/*
+ * ps3recomp - sceNpMatching (the first-generation NP matchmaking API with its
+ * system GUI dialogs) over a psnr server. See sceNpMatching.c.
+ */
+#ifndef PS3RECOMP_SCE_NP_MATCHING_H
+#define PS3RECOMP_SCE_NP_MATCHING_H
+
+#include "ps3emu/ps3types.h"
+#include "ps3emu/error_codes.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Every pointer argument is a GUEST address (the HLE adapter passes r3..r10
+ * through), spelt u32 here so nobody dereferences one. */
+s32 sceNpMatchingCreateCtx(u32 npId, u32 handler, u32 arg, u32 ctxId);
+s32 sceNpMatchingDestroyCtx(u32 ctxId);
+s32 sceNpMatchingGetResult(u32 ctxId, u32 reqId, u32 buf, u32 size, u32 event);
+s32 sceNpMatchingGetResultGUI(u32 buf, u32 size, u32 event);
+s32 sceNpMatchingCreateRoomGUI(u32 ctxId, u32 commId, u32 attr, u32 handler, u32 arg);
+s32 sceNpMatchingJoinRoomGUI(u32 ctxId, u32 roomId, u32 handler, u32 arg);
+s32 sceNpMatchingSearchJoinRoomGUI(u32 ctxId, u32 commId, u32 cond, u32 attr, u32 handler, u32 arg);
+s32 sceNpMatchingQuickMatchGUI(u32 ctxId, u32 commId, u32 cond, s32 availableNum, s32 timeout, u32 handler, u32 arg);
+s32 sceNpMatchingGetRoomListLimitGUI(u32 ctxId, u32 commId, u32 range, u32 cond, u32 attr, u32 handler, u32 arg);
+s32 sceNpMatchingSendInvitationGUI(u32 ctxId, u32 roomId, u32 commId, u32 dsts, s32 num, s32 slotType, u32 subject, u32 body);
+s32 sceNpMatchingAcceptInvitationGUI(u32 ctxId, u32 commId, u32 container, u32 handler, u32 arg);
+s32 sceNpMatchingSetRoomInfoNoLimit(u32 ctxId, u32 lobbyId, u32 roomId, u32 attr, u32 reqId);
+s32 sceNpMatchingGetRoomInfoNoLimit(u32 ctxId, u32 lobbyId, u32 roomId, u32 attr, u32 reqId);
+s32 sceNpMatchingSetRoomSearchFlag(u32 ctxId, u32 lobbyId, u32 roomId, s32 flag, u32 reqId);
+s32 sceNpMatchingGetRoomMemberListLocal(u32 ctxId, u32 roomId, u32 buflen, u32 buf);
+s32 sceNpMatchingLeaveRoom(u32 ctxId, u32 roomId, u32 reqId);
+s32 sceNpMatchingKickRoomMember(u32 ctxId, u32 roomId, u32 userId, u32 reqId);
+
+/* For sceNpSignaling: the P2P endpoint of a member of the room we are in,
+ * by online ID. 1 if found. */
+int np_matching_find_member(const char* online_id, uint32_t* user, u8 ip[4], u16* port);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/libs/network/sceNpScore.c b/libs/network/sceNpScore.c
new file mode 100644
index 0000000..24690f7
--- /dev/null
+++ b/libs/network/sceNpScore.c
@@ -0,0 +1,366 @@
+/*
+ * ps3recomp - sceNpScore (NP leaderboards) over psnr
+ *
+ * Title contexts and transactions are local ids; record and ranking requests
+ * go to the psnr server's leaderboards (np_psnr.h). Offline, a transaction
+ * finishes with a community-server error and titles show "rankings
+ * unavailable". Ported from sp00nznet/ps3recomp's sceNpScore.c (MIT) onto
+ * this runtime's psnr client.
+ *
+ * The ranking calls take up to 15 arguments; everything past r10 comes from
+ * the caller's parameter save area (PPC64 ELFv1: arg n>8 at SP+112+8*(n-9)),
+ * so those are ctx handlers, registered the first time a title context is
+ * created (titles always do that before asking for rankings).
+ *
+ * Layouts (SDK ABI):
+ *   SceNpScoreRankData                                             128 bytes
+ *     0 npId (36) | 36 onlineName (48) | 84 pcId | 88 serialRank | 92 rank
+ *     96 highestRank | 104 scoreValue s64 | 112 hasGameData | 120 recordDate u64
+ *   SceNpScorePlayerRankData { s32 hasData; pad[4]; RankData }    136 bytes
+ *   SceNpScoreComment { char utf8Comment[64] }                     64 bytes
+ */
+#include "sceNp.h"
+#include "np_psnr.h"
+#include "../../runtime/ppu/ppu_context.h"
+#include "../../runtime/ppu/ppu_memory.h"
+#include "../../include/ps3emu/nid.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#ifdef _WIN32
+#  define WIN32_LEAN_AND_MEAN
+#  include <windows.h>
+static void sleep_10ms(void) { Sleep(10); }
+#else
+#  include <time.h>
+static void sleep_10ms(void) { struct timespec ts = { 0, 10000000L }; nanosleep(&ts, NULL); }
+#endif
+
+#define SCORE_ERROR_NO_SERVER      0x8002A1A1u   /* community server error: unavailable */
+#define SCORE_ERROR_INVALID_ID     0x8002A106u
+#define SCORE_ERROR_ABORTED        0x8002A10Au
+
+#define TITLE_MAX 8
+#define TRANS_MAX 32
+
+enum { T_FREE, T_IDLE, T_PENDING, T_DONE };
+
+typedef struct {
+    int state;
+    int title;
+    s32 result;
+    u32 tmp_rank_ea;
+    u32 rank_ea, comment_ea, total_ea, last_sort_ea;
+    u32 array_num;
+    int by_id;
+} score_trans;
+
+static int         s_titles[TITLE_MAX + 1];   /* 1-based ids */
+static score_trans s_trans[TRANS_MAX + 1];
+static int         s_ctx_registered;
+
+static u8* put16(u8* p, u16 v) { p[0] = (u8)(v >> 8); p[1] = (u8)v; return p + 2; }
+static u8* put32(u8* p, u32 v) { put16(p, (u16)(v >> 16)); put16(p + 2, (u16)v); return p + 4; }
+static u8* put64(u8* p, u64 v) { put32(p, (u32)(v >> 32)); put32(p + 4, (u32)v); return p + 8; }
+
+static void register_ctx_handlers(void);
+
+/* ---- contexts ---- */
+
+s32 sceNpScoreCreateTitleCtx(u32 commId, u32 passphrase, u32 selfNpId)
+{
+    (void)passphrase; (void)selfNpId;
+    register_ctx_handlers();
+    for (int i = 1; i <= TITLE_MAX; i++)
+        if (!s_titles[i]) {
+            s_titles[i] = 1;
+            /* psnr scopes boards by the title's communication ID; connect now
+             * in case matching has not. */
+            if (commId) {
+                char id[16] = {0}, data[10] = {0};
+                memcpy(data, GUEST_PTR(commId, const char*), 9);
+                snprintf(id, sizeof(id), "%s_%02u", data, vm_read8(commId + 10));
+                np_psnr_connect(id);
+            }
+            printf("[sceNpScore] CreateTitleCtx -> %d\n", i);
+            return i;
+        }
+    return (s32)SCE_NP_ERROR_OUT_OF_MEMORY;
+}
+
+s32 sceNpScoreDestroyTitleCtx(s32 titleCtxId)
+{
+    if (titleCtxId < 1 || titleCtxId > TITLE_MAX || !s_titles[titleCtxId])
+        return (s32)SCORE_ERROR_INVALID_ID;
+    s_titles[titleCtxId] = 0;
+    return CELL_OK;
+}
+
+s32 sceNpScoreCreateTransactionCtx(s32 titleCtxId)
+{
+    if (titleCtxId < 1 || titleCtxId > TITLE_MAX || !s_titles[titleCtxId])
+        return (s32)SCORE_ERROR_INVALID_ID;
+    for (int i = 1; i <= TRANS_MAX; i++)
+        if (s_trans[i].state == T_FREE) {
+            memset(&s_trans[i], 0, sizeof(s_trans[i]));
+            s_trans[i].state = T_IDLE;
+            s_trans[i].title = titleCtxId;
+            return i;
+        }
+    return (s32)SCE_NP_ERROR_OUT_OF_MEMORY;
+}
+
+static score_trans* trans_get(s32 id)
+{
+    return (id >= 1 && id <= TRANS_MAX && s_trans[id].state != T_FREE) ? &s_trans[id] : NULL;
+}
+
+s32 sceNpScoreDestroyTransactionCtx(s32 transId)
+{
+    score_trans* t = trans_get(transId);
+    if (!t) return (s32)SCORE_ERROR_INVALID_ID;
+    t->state = T_FREE;   /* a reply still in flight finds the slot free and is dropped */
+    return CELL_OK;
+}
+
+s32 sceNpScoreSetTimeout(s32 id, u32 timeout)  { (void)id; (void)timeout; return CELL_OK; }
+s32 sceNpScoreSetPlayerCharacterId(s32 id, s32 pcId) { (void)id; (void)pcId; return CELL_OK; }
+
+s32 sceNpScoreAbortTransaction(s32 transId)
+{
+    score_trans* t = trans_get(transId);
+    if (!t) return (s32)SCORE_ERROR_INVALID_ID;
+    if (t->state == T_PENDING) { t->state = T_DONE; t->result = (s32)SCORE_ERROR_ABORTED; }
+    return CELL_OK;
+}
+
+/* 0 = finished (result in *result), 1 = still running. */
+s32 sceNpScorePollAsync(s32 transId, u32 result)
+{
+    score_trans* t = trans_get(transId);
+    if (!t) return (s32)SCORE_ERROR_INVALID_ID;
+    if (t->state == T_PENDING) np_psnr_pump();
+    if (t->state == T_PENDING) return 1;
+    if (result) vm_write32(result, (u32)t->result);
+    return 0;
+}
+
+s32 sceNpScoreWaitAsync(s32 transId, u32 result)
+{
+    score_trans* t = trans_get(transId);
+    if (!t) return (s32)SCORE_ERROR_INVALID_ID;
+    for (int i = 0; i < 1000 && t->state == T_PENDING; i++) {   /* ~10 s */
+        np_psnr_pump();
+        if (t->state == T_PENDING) sleep_10ms();
+    }
+    if (t->state == T_PENDING) { t->state = T_DONE; t->result = (s32)SCORE_ERROR_NO_SERVER; }
+    if (result) vm_write32(result, (u32)t->result);
+    return t->result;
+}
+
+/* ---- requests ---- */
+
+static s32 fail_now(score_trans* t, s32 err)
+{
+    t->state = T_DONE;
+    t->result = err;
+    return CELL_OK;
+}
+
+static s32 trans_id_of(score_trans* t) { return (s32)(t - s_trans); }
+
+static void on_recorded(void* user, const np_psnr_msg* m)
+{
+    score_trans* t = trans_get((s32)(uintptr_t)user);
+    if (!t || t->state != T_PENDING) return;
+    t->state = T_DONE;
+    if (m->type != PSNR_SCORE_RECORDED || m->len < 4) { t->result = (s32)SCORE_ERROR_NO_SERVER; return; }
+    if (t->tmp_rank_ea) vm_write32(t->tmp_rank_ea, np_get32(m->data));
+    t->result = CELL_OK;
+}
+
+/* RECORD_SCORE: board u32 | order u8 | score s64 | comment blob */
+static s32 record(s32 transId, u32 boardId, s64 score, u32 comment, u32 tmpRank)
+{
+    score_trans* t = trans_get(transId);
+    u8 body[4 + 1 + 8 + 2 + 64];
+    if (!t) return (s32)SCORE_ERROR_INVALID_ID;
+    t->state = T_PENDING;
+    t->tmp_rank_ea = tmpRank;
+    if (!np_psnr_connected()) return fail_now(t, (s32)SCORE_ERROR_NO_SERVER);
+
+    u8* p = put32(body, boardId);
+    *p++ = 0;   /* every board ranks higher-is-better */
+    p = put64(p, (u64)score);
+    size_t cl = comment ? strnlen(GUEST_PTR(comment, const char*), 63) : 0;
+    p = put16(p, (u16)cl);
+    if (cl) { memcpy(p, GUEST_PTR(comment, const char*), cl); p += cl; }
+    printf("[sceNpScore] RecordScore(board %u, %lld)\n", boardId, (long long)score);
+    if (!np_psnr_request(PSNR_RECORD_SCORE, body, (u32)(p - body), on_recorded,
+                         (void*)(uintptr_t)trans_id_of(t)))
+        return fail_now(t, (s32)SCORE_ERROR_NO_SERVER);
+    return CELL_OK;
+}
+
+s32 sceNpScoreRecordScoreAsync(s32 transId, u32 boardId, s64 score, u32 comment,
+                               u32 gameInfo, u32 tmpRank, s32 prio, u32 option)
+{
+    (void)gameInfo; (void)prio; (void)option;
+    return record(transId, boardId, score, comment, tmpRank);
+}
+
+s32 sceNpScoreRecordScore(s32 transId, u32 boardId, s64 score, u32 comment,
+                          u32 gameInfo, u32 tmpRank, u32 option)
+{
+    (void)gameInfo; (void)option;
+    s32 r = record(transId, boardId, score, comment, tmpRank);
+    return r < 0 ? r : sceNpScoreWaitAsync(transId, 0);
+}
+
+/* Write one SceNpScoreRankData from a RANKING entry. */
+static const u8* put_rank(u32 at, const u8* e, const u8* end, u32 comment_at)
+{
+    if (e + 4 + 16 + 8 + 2 > end) return NULL;
+    u32 rank = np_get32(e);
+    char id[17] = {0};
+    memcpy(id, e + 4, 16);
+    u64 score = np_get64(e + 20);
+    u16 cl = np_get16(e + 28);
+    const u8* c = e + 30;
+    if (c + cl + 8 > end) return NULL;
+    u64 when = np_get64(c + cl);
+
+    memset(GUEST_PTR(at, u8*), 0, 128);
+    memcpy(GUEST_PTR(at, char*), id, strnlen(id, 16));           /* npId.handle */
+    memcpy(GUEST_PTR(at + 36, char*), id, strnlen(id, 16));      /* onlineName */
+    vm_write32(at + 88, rank);                          /* serialRank */
+    vm_write32(at + 92, rank);                          /* rank */
+    vm_write32(at + 96, rank);                          /* highestRank */
+    vm_write64(at + 104, score);
+    vm_write64(at + 120, when ? (when + 62135596800ull) * 1000000ull : 0);   /* CellRtcTick */
+    if (comment_at) {
+        memset(GUEST_PTR(comment_at, u8*), 0, 64);
+        memcpy(GUEST_PTR(comment_at, u8*), c, cl < 63 ? cl : 63);
+    }
+    return c + cl + 8;
+}
+
+static void on_ranking(void* user, const np_psnr_msg* m)
+{
+    score_trans* t = trans_get((s32)(uintptr_t)user);
+    if (!t || t->state != T_PENDING) return;
+    t->state = T_DONE;
+    if (m->type != PSNR_RANKING || m->len < 6) { t->result = (s32)SCORE_ERROR_NO_SERVER; return; }
+    u32 total = np_get32(m->data);
+    u16 n = np_get16(m->data + 4);
+    const u8 *e = m->data + 6, *end = m->data + m->len;
+    u32 filled = 0;
+    for (u16 i = 0; i < n && i < t->array_num && e; i++) {
+        u32 stride = t->by_id ? 136 : 128;
+        u32 at = t->rank_ea + i * stride;
+        if (t->by_id) vm_write32(at, np_get32(e) ? 1 : 0);   /* hasData */
+        e = put_rank(t->by_id ? at + 8 : at, e, end, t->comment_ea ? t->comment_ea + i * 64 : 0);
+        filled++;
+    }
+    if (t->total_ea) vm_write32(t->total_ea, total);
+    if (t->last_sort_ea) vm_write64(t->last_sort_ea, 0);
+    if (np_psnr_trace()) printf("[sceNpScore] ranking: %u of %u entries\n", filled, total);
+    /* The synchronous call returns 0 on success (RPCS3: set_result_and_wake(CELL_OK));
+     * Tekken 5 DR takes anything else for a failure. */
+    t->result = CELL_OK;
+}
+
+static u64 stack_arg(ppu_context* ctx, int n)   /* n >= 9 */
+{
+    return vm_read64((u32)ctx->gpr[1] + 112u + 8u * (u32)(n - 9));
+}
+
+/* GetRankingByRange[Async](transId, boardId, startSerialRank, rankArray*, rankArraySize,
+ *   commentArray*, commentArraySize, infoArray*, infoArraySize, arrayNum,
+ *   lastSortDate*, totalRecord*, [prio,] option) */
+static void ranking_by_range(ppu_context* ctx)
+{
+    score_trans* t = trans_get((s32)ctx->gpr[3]);
+    u8 body[10];
+    if (!t) { ctx->gpr[3] = (u64)(s64)(s32)SCORE_ERROR_INVALID_ID; return; }
+    t->state = T_PENDING;
+    t->by_id = 0;
+    t->rank_ea = (u32)ctx->gpr[6];
+    t->comment_ea = (u32)ctx->gpr[8];
+    t->array_num = (u32)stack_arg(ctx, 10);
+    t->last_sort_ea = (u32)stack_arg(ctx, 11);
+    t->total_ea = (u32)stack_arg(ctx, 12);
+    ctx->gpr[3] = 0;
+    if (np_psnr_trace()) printf("[sceNpScore] GetRankingByRange(board %u, from %u, %u)\n",
+                                 (u32)ctx->gpr[4], (u32)ctx->gpr[5], t->array_num);
+    if (!np_psnr_connected()) { fail_now(t, (s32)SCORE_ERROR_NO_SERVER); return; }
+    u8* p = put32(body, (u32)ctx->gpr[4]);
+    p = put32(p, (u32)ctx->gpr[5] ? (u32)ctx->gpr[5] : 1);
+    p = put16(p, (u16)(t->array_num > 100 ? 100 : t->array_num));
+    if (!np_psnr_request(PSNR_GET_RANKING, body, 10, on_ranking, (void*)(uintptr_t)trans_id_of(t)))
+        fail_now(t, (s32)SCORE_ERROR_NO_SERVER);
+}
+
+static void hle_ranking_by_range_async(ppu_context* ctx) { ranking_by_range(ctx); }
+static void hle_ranking_by_range(ppu_context* ctx)
+{
+    s32 id = (s32)ctx->gpr[3];
+    ranking_by_range(ctx);
+    if ((s32)ctx->gpr[3] == 0) ctx->gpr[3] = (u64)(s64)sceNpScoreWaitAsync(id, 0);
+}
+
+/* GetRankingByNpId[Async](transId, boardId, npIdArray*, npIdArraySize, rankArray*,
+ *   rankArraySize, commentArray*, commentArraySize, infoArray*, infoArraySize,
+ *   arrayNum, lastSortDate*, totalRecord*, [prio,] option) */
+static void ranking_by_npid(ppu_context* ctx)
+{
+    score_trans* t = trans_get((s32)ctx->gpr[3]);
+    if (!t) { ctx->gpr[3] = (u64)(s64)(s32)SCORE_ERROR_INVALID_ID; return; }
+    t->state = T_PENDING;
+    t->by_id = 1;
+    t->rank_ea = (u32)ctx->gpr[7];
+    t->comment_ea = (u32)ctx->gpr[9];
+    t->array_num = (u32)stack_arg(ctx, 11);
+    t->last_sort_ea = (u32)stack_arg(ctx, 12);
+    t->total_ea = (u32)stack_arg(ctx, 13);
+    ctx->gpr[3] = 0;
+    if (np_psnr_trace()) printf("[sceNpScore] GetRankingByNpId(board %u, %u ids)\n", (u32)ctx->gpr[4], t->array_num);
+    if (!np_psnr_connected()) { fail_now(t, (s32)SCORE_ERROR_NO_SERVER); return; }
+    u32 ids = (u32)ctx->gpr[5], n = t->array_num > 100 ? 100 : t->array_num;
+    u8* body = (u8*)malloc(6 + 16 * n);
+    u8* p = put32(body, (u32)ctx->gpr[4]);
+    p = put16(p, (u16)n);
+    for (u32 i = 0; i < n; i++, p += 16) {   /* SceNpId is 36 bytes; the handle leads */
+        memset(p, 0, 16);
+        memcpy(p, GUEST_PTR(ids + i * 36, const char*), strnlen(GUEST_PTR(ids + i * 36, const char*), 16));
+    }
+    if (!np_psnr_request(PSNR_GET_RANKING_BY_ID, body, (u32)(p - body), on_ranking,
+                         (void*)(uintptr_t)trans_id_of(t)))
+        fail_now(t, (s32)SCORE_ERROR_NO_SERVER);
+    free(body);
+}
+
+static void hle_ranking_by_npid_async(ppu_context* ctx) { ranking_by_npid(ctx); }
+static void hle_ranking_by_npid(ppu_context* ctx)
+{
+    s32 id = (s32)ctx->gpr[3];
+    ranking_by_npid(ctx);
+    if ((s32)ctx->gpr[3] == 0) ctx->gpr[3] = (u64)(s64)sceNpScoreWaitAsync(id, 0);
+}
+
+extern void ps3_hle_register_ctx(uint32_t nid, const char* name, void (*fn)(ppu_context*));
+
+static void register_ctx_handlers(void)
+{
+    if (s_ctx_registered) return;
+    s_ctx_registered = 1;
+    ps3_hle_register_ctx(ps3_compute_nid("sceNpScoreGetRankingByRangeAsync"),
+                         "sceNpScoreGetRankingByRangeAsync", hle_ranking_by_range_async);
+    ps3_hle_register_ctx(ps3_compute_nid("sceNpScoreGetRankingByRange"),
+                         "sceNpScoreGetRankingByRange", hle_ranking_by_range);
+    ps3_hle_register_ctx(ps3_compute_nid("sceNpScoreGetRankingByNpIdAsync"),
+                         "sceNpScoreGetRankingByNpIdAsync", hle_ranking_by_npid_async);
+    ps3_hle_register_ctx(ps3_compute_nid("sceNpScoreGetRankingByNpId"),
+                         "sceNpScoreGetRankingByNpId", hle_ranking_by_npid);
+}

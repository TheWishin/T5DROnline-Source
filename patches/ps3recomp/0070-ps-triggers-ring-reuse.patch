+/* RSX_RING_GUARD=1 (test hook, patch 0070): every range of the vertex, index, vertex-constant, pixel-constant
+ * and upload rings the walker hands out is checked against the list that used those bytes before (per
+ * 64 KB / 4 KB block: the fence value that list signals): a write while that list is not finished on the
+ * GPU -- or not even submitted, its calls still queued for the renderer thread -- is reused too early and
+ * counted ("[ring-guard]"). With RSX_XLAT_RENDER_DELAY_US it shows whether the overlap (patch 0067) can
+ * hand out memory a queued frame still reads (docs/RENDER_PERF.md "Ring reuse"). */
+enum { LDG_VB, LDG_IB, LDG_CB, LDG_PSCB, LDG_UPLOAD, LDG_N };
+static int g_ldg_on = -1;
+static u64* g_ldg_blk[LDG_N];
+static u64 g_ldg_checked, g_ldg_early;
+static void ld_ring_guard(int ring, u64 off, u64 len)
+{
+    static const char* const names[LDG_N] = { "vertex", "index", "vertex-constant", "pixel-constant", "upload" };
+    static const u32 shift[LDG_N] = { 16, 16, 12, 12, 16 };
+    if (g_ldg_on < 0) {
+        const char* e = getenv("RSX_RING_GUARD");
+        g_ldg_on = e && *e == '1';
+        if (g_ldg_on) {
+            const u64 cap[LDG_N] = { VERT_BUFFER_SIZE, INDEX_BUFFER_SIZE, CB_RING_BYTES, PS_CB_RING_BYTES, UPLOAD_SIZE };
+            for (int i = 0; i < LDG_N; i++) g_ldg_blk[i] = (u64*)calloc((size_t)(cap[i] >> shift[i]) + 2, sizeof(u64));
+            fprintf(stderr, "[ring-guard] on: ring memory reuse is checked against the GPU fence (test hook)\n");
+        }
+    }
+    if (!g_ldg_on || !len || !g_ldg_blk[ring]) return;
+    const u64 cur = g.fence_value + 1;           /* what the list being recorded will signal */
+    const u64 done = g.fence->lpVtbl->GetCompletedValue(g.fence);
+    g_ldg_checked++;
+    for (u64 b = off >> shift[ring]; b <= (off + len - 1) >> shift[ring]; b++) {
+        const u64 last = g_ldg_blk[ring][b];
+        if (last && last != cur && last > done) {
+            if (g_ldg_early++ < 12)
+                fprintf(stderr, "[ring-guard] %s ring bytes 0x%llX+%llu reused while list %llu still uses them "
+                                "(GPU done to %llu, recording %llu, renderer thread %lld bytes behind)\n",
+                        names[ring], (unsigned long long)off, (unsigned long long)len, (unsigned long long)last,
+                        (unsigned long long)done, (unsigned long long)cur,
+                        (long long)(g_rq_wl - __atomic_load_n(&g_rq_r, __ATOMIC_ACQUIRE)));
+            break;
+        }
+    }
+    for (u64 b = off >> shift[ring]; b <= (off + len - 1) >> shift[ring]; b++) g_ldg_blk[ring][b] = cur;
+}

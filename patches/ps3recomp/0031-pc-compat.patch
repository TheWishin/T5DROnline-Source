+/* ---------------------------------------------------------------------------
+ * PC compatibility (patch 0031): which GPU, a clear end when the GPU is lost,
+ * and present pacing that never changes the game's speed.
+ * -----------------------------------------------------------------------*/
+static HWND g_ld_main_hwnd = NULL;
+
+/* A dialog the player can read, then the end of the process (a frozen window
+ * with the game still running behind it helps nobody). Scripted runs
+ * (PS3_WINDOW_BACKGROUND, PS3_NO_DIALOGS) get only the log line and the exit
+ * code; the launcher explains the code. */
+static void ld_fatal(UINT code, const char* title, const char* text)
+{
+    static volatile LONG once = 0;
+    if (InterlockedExchange(&once, 1))       /* another thread is already ending it */
+        Sleep(INFINITE);
+    fprintf(stderr, "[gpu] FATAL (exit code %u): %s\n", code, text);
+    fflush(stderr);
+    fflush(stdout);
+    if (!getenv("PS3_WINDOW_BACKGROUND") && !getenv("PS3_NO_DIALOGS")) {
+        static wchar_t wt[256], wx[4096];
+        if (g_ld_main_hwnd) ShowWindowAsync(g_ld_main_hwnd, SW_MINIMIZE);   /* never behind a fullscreen game */
+        MultiByteToWideChar(CP_UTF8, 0, title, -1, wt, 256);
+        MultiByteToWideChar(CP_UTF8, 0, text, -1, wx, 4096);
+        MessageBoxW(NULL, wx, wt, MB_OK | MB_ICONERROR | MB_SETFOREGROUND | MB_TOPMOST);
+    }
+    ExitProcess(code);
+}
+
+static const char* ld_hr_text(HRESULT hr)
+{
+    switch ((unsigned long)hr) {
+    case 0x887A0006UL: return "DXGI_ERROR_DEVICE_HUNG: the graphics card stopped responding";
+    case 0x887A0005UL: return "DXGI_ERROR_DEVICE_REMOVED: the graphics card was removed, or its driver was updated or restarted";
+    case 0x887A0007UL: return "DXGI_ERROR_DEVICE_RESET: the graphics card was reset";
+    case 0x887A0020UL: return "DXGI_ERROR_DRIVER_INTERNAL_ERROR: the graphics driver failed";
+    case 0x8007000EUL: return "E_OUTOFMEMORY: out of video memory";
+    default:           return "graphics device error";
+    }
+}
+
+static int ld_hr_device_lost(HRESULT hr)
+{
+    return hr == DXGI_ERROR_DEVICE_REMOVED || hr == DXGI_ERROR_DEVICE_RESET ||
+           hr == DXGI_ERROR_DEVICE_HUNG || hr == DXGI_ERROR_DRIVER_INTERNAL_ERROR;
+}
+
+/* The GPU is gone (TDR, driver update or crash, eGPU unplugged). Windows does
+ * not give the device back; the game would only freeze. */
+static void ld_device_lost(const char* where, HRESULT hr)
+{
+    HRESULT reason = g.dev ? g.dev->lpVtbl->GetDeviceRemovedReason(g.dev) : S_OK;
+    if (reason == S_OK) reason = hr;
+    fprintf(stderr, "[gpu] device lost at %s: hr=0x%08lX reason=0x%08lX (%s)\n",
+            where, (unsigned long)hr, (unsigned long)reason, ld_hr_text(reason));
+    ld_dump_dred(where, hr);
+    char text[1024];
+    snprintf(text, sizeof text,
+             "The graphics card stopped working for the game (%s, code 0x%08lX).\n\n"
+             "The game has to close. Start it again.\n\n"
+             "If this happens again: update the graphics driver, close other programs "
+             "that use the graphics card, and make sure the PC does not overheat.",
+             ld_hr_text(reason), (unsigned long)reason);
+    ld_fatal(12, "T5DR Online - graphics error", text);
+}
+
+/* Waits for the fence with a bounded wait: a removed device signals its
+ * fences with UINT64_MAX, a hung one only after the TDR -- either way the
+ * renderer ends with the message above instead of sleeping forever. */
+static void ld_wait_fence(u64 v, const char* where)
+{
+    for (;;) {
+        const u64 done = g.fence->lpVtbl->GetCompletedValue(g.fence);
+        if (done == UINT64_MAX) {
+            const HRESULT r = g.dev->lpVtbl->GetDeviceRemovedReason(g.dev);
+            if (r != S_OK) ld_device_lost(where, r);
+            return;
+        }
+        if (done >= v) return;
+        const HRESULT hr = g.fence->lpVtbl->SetEventOnCompletion(g.fence, v, g.fence_event);
+        if (FAILED(hr)) {
+            const HRESULT r = g.dev->lpVtbl->GetDeviceRemovedReason(g.dev);
+            ld_device_lost(where, r != S_OK ? r : hr);
+        }
+        if (WaitForSingleObject(g.fence_event, 2000) == WAIT_TIMEOUT) {
+            const HRESULT r = g.dev->lpVtbl->GetDeviceRemovedReason(g.dev);
+            if (r != S_OK) ld_device_lost(where, r);
+            /* still alive: a very slow frame (software adapter); keep waiting */
+        }
+    }
+}
+
+/* RSX_TEST_DEVICE_REMOVED=<n>: remove the device after n presents
+ * (ID3D12Device5::RemoveDevice, Windows 10 1809+) -- tests the path above. */
+static void ld_test_device_removed(void)
+{
+    static int at = -2;
+    static int n = 0;
+    if (at == -2) { const char* e = getenv("RSX_TEST_DEVICE_REMOVED"); at = e && *e ? atoi(e) : -1; }
+    if (at < 0 || ++n != at) return;
+    ID3D12Device5* d5 = NULL;
+    if (SUCCEEDED(g.dev->lpVtbl->QueryInterface(g.dev, &IID_ID3D12Device5, (void**)&d5)) && d5) {
+        fprintf(stderr, "[gpu] RSX_TEST_DEVICE_REMOVED: removing the device after %d presents\n", n);
+        d5->lpVtbl->RemoveDevice(d5);
+        d5->lpVtbl->Release(d5);
+    }
+}
+
+/* Which GPU. RSX_ADAPTER = "warp" (Direct3D's software renderer: slow, for
+ * tests), a number (n-th adapter in high-performance order) or part of the
+ * adapter's name. Default: the per-app choice in Windows' Graphics settings
+ * when there is one, else the high-performance GPU (IDXGIFactory6,
+ * Windows 10 1803+) -- on a laptop with two GPUs that is the discrete one.
+ * Never a software adapter by itself: a PC whose GPU cannot run Direct3D 12
+ * (feature level 11_0) gets the message below, not 5-10 fps from WARP
+ * (RSX_TEST_SOFTWARE_FALLBACK=1 brings the old fallback back). */
+static int ld_user_gpu_preference(void)
+{
+    wchar_t exe[1024];
+    const DWORD n = GetModuleFileNameW(NULL, exe, 1024);
+    if (!n || n >= 1024) return 0;
+    wchar_t val[128];
+    DWORD sz = sizeof val;
+    if (RegGetValueW(HKEY_CURRENT_USER, L"Software\\Microsoft\\DirectX\\UserGpuPreferences", exe,
+                     RRF_RT_REG_SZ, NULL, val, &sz) != ERROR_SUCCESS)
+        return 0;
+    const wchar_t* p = wcsstr(val, L"GpuPreference=");
+    return p ? 1 + _wtoi(p + 14) : 0;   /* 1 = let Windows decide, 2 = power saving, 3 = high performance */
+}
+
+static void ld_utf8(const wchar_t* w, char* out, int n)
+{
+    if (!WideCharToMultiByte(CP_UTF8, 0, w, -1, out, n, NULL, NULL)) out[0] = 0;
+}
+
+static void ld_lower(const char* s, char* out, size_t n)
+{
+    size_t k = 0;
+    for (; s[k] && k + 1 < n; k++) out[k] = (char)tolower((unsigned char)s[k]);
+    out[k] = 0;
+}
+
+static int ld_create_device(IDXGIFactory4* factory)
+{
+    if (getenv("RSX_TEST_NO_D3D12")) return -1;   /* tests: behave like a PC without a D3D12 GPU */
+    const char* want = getenv("RSX_ADAPTER");
+    if (want && !*want) want = NULL;
+    IDXGIFactory6* f6 = NULL;
+    factory->lpVtbl->QueryInterface(factory, &IID_IDXGIFactory6, (void**)&f6);
+    const int user_pref = ld_user_gpu_preference();
+    const DXGI_GPU_PREFERENCE pref =
+        user_pref == 2 ? DXGI_GPU_PREFERENCE_MINIMUM_POWER :
+        user_pref == 1 ? DXGI_GPU_PREFERENCE_UNSPECIFIED : DXGI_GPU_PREFERENCE_HIGH_PERFORMANCE;
+    const char* why = user_pref ? "the choice in Windows' Graphics settings"
+                    : f6 ? "the high-performance GPU" : "the first adapter";
+    IDXGIAdapter1* chosen = NULL;
+    char name[256] = "";
+    int tried_want = 0;
+    if (want && _stricmp(want, "warp") == 0) {
+        tried_want = 1;
+        if (SUCCEEDED(factory->lpVtbl->EnumWarpAdapter(factory, &IID_IDXGIAdapter1, (void**)&chosen)) && chosen &&
+            SUCCEEDED(D3D12CreateDevice((IUnknown*)chosen, D3D_FEATURE_LEVEL_11_0, &IID_ID3D12Device, (void**)&g.dev)))
+            why = "RSX_ADAPTER=warp (software renderer, slow)";
+        else if (chosen) { chosen->lpVtbl->Release(chosen); chosen = NULL; }
+    } else if (want) {
+        tried_want = 1;
+        const int want_index = want[0] >= '0' && want[0] <= '9' ? atoi(want) : -1;
+        char lw[64];
+        ld_lower(want, lw, sizeof lw);
+        for (UINT i = 0; i < 16 && !g.dev; i++) {
+            IDXGIAdapter1* ad = NULL;
+            const HRESULT hr = f6
+                ? f6->lpVtbl->EnumAdapterByGpuPreference(f6, i, DXGI_GPU_PREFERENCE_HIGH_PERFORMANCE,
+                                                         &IID_IDXGIAdapter1, (void**)&ad)
+                : factory->lpVtbl->EnumAdapters1(factory, i, &ad);
+            if (hr == DXGI_ERROR_NOT_FOUND) break;
+            if (FAILED(hr) || !ad) continue;
+            DXGI_ADAPTER_DESC1 d;
+            char nm[256] = "", ln[256];
+            if (SUCCEEDED(ad->lpVtbl->GetDesc1(ad, &d))) ld_utf8(d.Description, nm, sizeof nm);
+            ld_lower(nm, ln, sizeof ln);
+            const int take = want_index >= 0 ? (int)i == want_index : strstr(ln, lw) != NULL;
+            if (take && SUCCEEDED(D3D12CreateDevice((IUnknown*)ad, D3D_FEATURE_LEVEL_11_0,
+                                                    &IID_ID3D12Device, (void**)&g.dev))) {
+                chosen = ad;
+                why = "RSX_ADAPTER";
+                break;
+            }
+            ad->lpVtbl->Release(ad);
+        }
+    }
+    if (!g.dev && tried_want)
+        fprintf(stderr, "[gpu] RSX_ADAPTER=%s: that adapter cannot run Direct3D 12 here -- using the default\n", want);
+    /* default: hardware adapters in preference order */
+    const int passes = getenv("RSX_TEST_SOFTWARE_FALLBACK") ? 2 : 1;
+    for (int pass = 0; pass < passes && !g.dev; pass++) {
+        for (UINT i = 0; i < 16 && !g.dev; i++) {
+            IDXGIAdapter1* ad = NULL;
+            const HRESULT hr = f6
+                ? f6->lpVtbl->EnumAdapterByGpuPreference(f6, i, pref, &IID_IDXGIAdapter1, (void**)&ad)
+                : factory->lpVtbl->EnumAdapters1(factory, i, &ad);
+            if (hr == DXGI_ERROR_NOT_FOUND) break;
+            if (FAILED(hr) || !ad) continue;
+            DXGI_ADAPTER_DESC1 d;
+            memset(&d, 0, sizeof d);
+            ad->lpVtbl->GetDesc1(ad, &d);
+            const int soft = (d.Flags & DXGI_ADAPTER_FLAG_SOFTWARE) != 0;
+            if (soft == pass && SUCCEEDED(D3D12CreateDevice((IUnknown*)ad, D3D_FEATURE_LEVEL_11_0,
+                                                            &IID_ID3D12Device, (void**)&g.dev))) {
+                chosen = ad;
+                if (soft) why = "no graphics card with Direct3D 12 found -- software renderer, very slow";
+                break;
+            }
+            ad->lpVtbl->Release(ad);
+        }
+    }
+    if (f6) f6->lpVtbl->Release(f6);
+    if (!g.dev) return -1;
+    DXGI_ADAPTER_DESC1 d;
+    memset(&d, 0, sizeof d);
+    if (chosen) {
+        if (SUCCEEDED(chosen->lpVtbl->GetDesc1(chosen, &d))) ld_utf8(d.Description, name, sizeof name);
+        chosen->lpVtbl->Release(chosen);
+    }
+    static const D3D_FEATURE_LEVEL levels[] = { D3D_FEATURE_LEVEL_12_2, D3D_FEATURE_LEVEL_12_1, D3D_FEATURE_LEVEL_12_0,
+                                                D3D_FEATURE_LEVEL_11_1, D3D_FEATURE_LEVEL_11_0 };
+    D3D12_FEATURE_DATA_FEATURE_LEVELS fl;
+    fl.NumFeatureLevels = (UINT)(sizeof levels / sizeof levels[0]);
+    fl.pFeatureLevelsRequested = levels;
+    fl.MaxSupportedFeatureLevel = D3D_FEATURE_LEVEL_11_0;
+    if (FAILED(g.dev->lpVtbl->CheckFeatureSupport(g.dev, D3D12_FEATURE_FEATURE_LEVELS, &fl, sizeof fl))) {
+        fl.NumFeatureLevels = 4;              /* runtimes before 12_2 reject the whole list */
+        fl.pFeatureLevelsRequested = levels + 1;
+        if (FAILED(g.dev->lpVtbl->CheckFeatureSupport(g.dev, D3D12_FEATURE_FEATURE_LEVELS, &fl, sizeof fl)))
+            fl.MaxSupportedFeatureLevel = D3D_FEATURE_LEVEL_11_0;
+    }
+    D3D12_FEATURE_DATA_D3D12_OPTIONS o;
+    memset(&o, 0, sizeof o);
+    g.dev->lpVtbl->CheckFeatureSupport(g.dev, D3D12_FEATURE_D3D12_OPTIONS, &o, sizeof o);
+    const unsigned flv = (unsigned)fl.MaxSupportedFeatureLevel;
+    fprintf(stderr, "[gpu] adapter: %s (vendor %04X, %llu MB, feature level %u_%u, resource binding tier %u, "
+                    "heap tier %u) -- %s\n",
+            name, (unsigned)d.VendorId, (unsigned long long)(d.DedicatedVideoMemory >> 20),
+            flv >> 12, (flv >> 8) & 0xF, (unsigned)o.ResourceBindingTier, (unsigned)o.ResourceHeapTier, why);
+    return 0;
+}

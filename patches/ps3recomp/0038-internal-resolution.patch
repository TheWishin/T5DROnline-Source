+static int ld_copy_pipeline(void)
+{
+    if (g_ld_copy.tried) return g_ld_copy.pso_rgba8 != NULL;
+    g_ld_copy.tried = 1;
+    /* uv over the viewport, which ld_surface_copy places so that it covers
+     * the whole source texture mapped into destination pixels; the scissor
+     * keeps the destination rect. */
+    static const char vs_src[] =
+        "void main(uint id : SV_VertexID, out float4 pos : SV_Position,\n"
+        "          out float2 uv : TEXCOORD0) {\n"
+        "    uv = float2((id << 1) & 2, id & 2);\n"
+        "    pos = float4(uv * float2(2, -2) + float2(-1, 1), 0, 1);\n"
+        "}\n";
+    static const char ps_src[] =
+        "Texture2D src : register(t0);\n"
+        "SamplerState smp : register(s0);\n"
+        "float4 main(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {\n"
+        "    return src.SampleLevel(smp, uv, 0);\n"
+        "}\n";
+    ID3DBlob *vs = NULL, *ps = NULL, *err = NULL, *sig = NULL;
+    HRESULT hr = D3DCompile(vs_src, sizeof(vs_src) - 1, "copy_vs", NULL, NULL, "main",
+                            "vs_5_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &vs, &err);
+    if (SUCCEEDED(hr))
+        hr = D3DCompile(ps_src, sizeof(ps_src) - 1, "copy_ps", NULL, NULL, "main",
+                        "ps_5_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &ps, &err);
+    if (SUCCEEDED(hr)) {
+        D3D12_DESCRIPTOR_RANGE range = {0};
+        range.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+        range.NumDescriptors = 1;
+        D3D12_ROOT_PARAMETER param = {0};
+        param.ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+        param.DescriptorTable.NumDescriptorRanges = 1;
+        param.DescriptorTable.pDescriptorRanges = &range;
+        param.ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+        D3D12_STATIC_SAMPLER_DESC smp = {0};
+        smp.Filter = D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+        smp.AddressU = smp.AddressV = smp.AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+        smp.MaxLOD = D3D12_FLOAT32_MAX;
+        smp.ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+        D3D12_ROOT_SIGNATURE_DESC rsd = {0};
+        rsd.NumParameters = 1; rsd.pParameters = &param;
+        rsd.NumStaticSamplers = 1; rsd.pStaticSamplers = &smp;
+        hr = D3D12SerializeRootSignature(&rsd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err);
+        if (SUCCEEDED(hr))
+            hr = g.dev->lpVtbl->CreateRootSignature(g.dev, 0, sig->lpVtbl->GetBufferPointer(sig),
+                                                    sig->lpVtbl->GetBufferSize(sig),
+                                                    &IID_ID3D12RootSignature, (void**)&g_ld_copy.rootsig);
+    }
+    for (int f = 0; f < 2 && SUCCEEDED(hr); f++) {
+        D3D12_GRAPHICS_PIPELINE_STATE_DESC pd = {0};
+        pd.pRootSignature = g_ld_copy.rootsig;
+        pd.VS.pShaderBytecode = vs->lpVtbl->GetBufferPointer(vs);
+        pd.VS.BytecodeLength = vs->lpVtbl->GetBufferSize(vs);
+        pd.PS.pShaderBytecode = ps->lpVtbl->GetBufferPointer(ps);
+        pd.PS.BytecodeLength = ps->lpVtbl->GetBufferSize(ps);
+        pd.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+        pd.SampleMask = 0xFFFFFFFFu;
+        pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+        pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+        pd.RasterizerState.DepthClipEnable = TRUE;
+        pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+        pd.NumRenderTargets = 1;
+        pd.RTVFormats[0] = f ? DXGI_FORMAT_R16G16B16A16_FLOAT : DXGI_FORMAT_R8G8B8A8_UNORM;
+        pd.SampleDesc.Count = 1;
+        hr = g.dev->lpVtbl->CreateGraphicsPipelineState(
+            g.dev, &pd, &IID_ID3D12PipelineState,
+            (void**)(f ? &g_ld_copy.pso_rgba16f : &g_ld_copy.pso_rgba8));
+    }
+    if (FAILED(hr))
+        fprintf(stderr, "[res] scaled-copy pipeline failed hr=0x%08lX %s\n", (unsigned long)hr,
+                err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "");
+    if (vs) vs->lpVtbl->Release(vs);
+    if (ps) ps->lpVtbl->Release(ps);
+    if (sig) sig->lpVtbl->Release(sig);
+    if (err) err->lpVtbl->Release(err);
+    if (FAILED(hr) && g_ld_copy.pso_rgba8) {
+        g_ld_copy.pso_rgba8->lpVtbl->Release(g_ld_copy.pso_rgba8);
+        g_ld_copy.pso_rgba8 = NULL;
+    }
+    return g_ld_copy.pso_rgba8 != NULL;
+}

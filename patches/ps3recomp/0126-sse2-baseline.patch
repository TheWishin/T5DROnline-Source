+    uint8_t T[32]; memcpy(T, &a, 16); memcpy(T + 16, &b, 16);
+    const __m128i idx = _mm_xor_si128(_mm_and_si128(C, _mm_set1_epi8(0x1F)), _mm_set1_epi8(3));
+    const uint64_t i0 = (uint64_t)_mm_cvtsi128_si64(idx), i1 = (uint64_t)_mm_cvtsi128_si64(_mm_srli_si128(idx, 8));
+    uint64_t r0 = 0, r1 = 0;

+/* ---------------------------------------------------------------------------
+ * Patch 0086 (T5DR "Always left", a 1.1.8 test): the player the game made P2 sees the fight as P1 would --
+ * the 3D picture mirrored, the HUD's two halves swapped with every element readable (rsx_always_left.h has
+ * the rules). The game asks for it per frame (rsx_live_draw_set_always_left, T5DR src/netplay/
+ * always_left.cpp: only in a fight, only for the P2 side); the walker takes it at the next 3D copy. Host pixels
+ * only: the draws are moved or mirrored through their viewport transform (xf) and scissor, nothing
+ * guest-visible changes, so the two PCs of a match may show it differently.
+ *
+ *   the 3D picture   a proven full-screen quad sampling an oversized render target in unit 0, confirmed by
+ *                    the current fragment program's sampled-unit mask: mirrored. A bound texture alone
+ *                    is insufficient: HUD draws can retain the scene's bindings as the camera changes.
+ *   the HUD          every later draw into the display buffer in that frame: its vertices run through its
+ *                    vertex program on the CPU (al_vp_eval), then its side moves by half the target width.
+ *                    Batched independent elements still need primitive-aware splitting; never split an
+ *                    individual triangle or glyph at an arbitrary x (docs/ALWAYS_LEFT_FIX.md).
+ * -----------------------------------------------------------------------*/
+#include "rsx_always_left.h"
+static volatile LONG g_al_req;               /* the game's request (any thread) */
+static struct {
+    int active, copy_seen;
+    al_hud hud;
+    u64 frames, copies, moved, mirrored, left_alone;
+} g_al;
+
+/* Text only, no pixels, guest bytes or shader programs. A selected renderer frame range also traces
+ * mirror-off draws, so a maintainer can compare the same HUD before enabling the option. */
+static struct {
+    int enabled, raw_known;
+    u32 frame, draw, target, n, start, n_surfaces, surfaces[SRV_TABLE_SIZE];
+    const char* outcome;
+    al_quad raw;
+} g_al_trace;
+
+static int ld_al_trace_enabled(void)
+{
+    static int init;
+    static unsigned first, count;
+    if (!init) {
+        init = 1;
+        const char* e = getenv("RSX_ALWAYS_LEFT_TRACE");
+        if (e) {
+            const int fields = sscanf(e, "%u:%u", &first, &count);
+            if (fields == 1) count = 1;
+            else if (fields != 2) count = 0;
+        }
+    }
+    return count && g_ld_frames >= first && g_ld_frames - first < count;
+}
+
+/* Called with the renderer's actual effective guest-pixel scissor before the mirror/move is applied.
+ * Clipping a COPY diagnoses a possible classification gap; it does not alter this draw or its layout. */
+static void ld_al_trace_scissor(const D3D12_RECT* before, const D3D12_RECT* after, float W, float H,
+                                int mirror, float dx_px)
+{
+    if (!g_al_trace.enabled) return;
+    fprintf(stderr, "[always-left-trace] frame %u draw %u outcome %s request %ld active %d copy_seen %d "
+                    "target %u:%u:%x %.0fx%.0f vp %u vertices %u ranges %u/%u "
+                    "scissor %ld,%ld..%ld,%ld -> %ld,%ld..%ld,%ld applied mirror %d dx %.3f",
+            g_al_trace.frame, g_al_trace.draw, g_al_trace.outcome,
+            (long)InterlockedCompareExchange(&g_al_req, 0, 0), g_al.active, g_al.copy_seen,
+            g_al_trace.target, g.surfaces[g_al_trace.target].location, g.surfaces[g_al_trace.target].offset,
+            W, H, g_al_trace.start, g_al_trace.n, dc.n_arr, dc.n_idx,
+            before->left, before->top, before->right, before->bottom,
+            after->left, after->top, after->right, after->bottom, mirror, dx_px);
+    if (g_al_trace.raw_known) {
+        static al_hud h;
+        h.px_w = W * 0.5f; h.px_h = H * 0.5f;
+        al_quad q = g_al_trace.raw;
+        const int visible = al_hud_clip(&h, &q, (float)before->left, (float)before->top,
+                                         (float)before->right, (float)before->bottom);
+        fprintf(stderr, " raw %.3f,%.3f..%.3f,%.3f tex %llx u %.4f..%.4f uflip %d visible %d",
+                (g_al_trace.raw.x0 + 1) * h.px_w, (1 - g_al_trace.raw.y1) * h.px_h,
+                (g_al_trace.raw.x1 + 1) * h.px_w, (1 - g_al_trace.raw.y0) * h.px_h,
+                (unsigned long long)q.tex, q.u0, q.u1, q.uflip, visible);
+        if (visible) {
+            fprintf(stderr, " box %.3f,%.3f..%.3f,%.3f side_clipped_center=%d",
+                    (q.x0 + 1) * h.px_w, (1 - q.y1) * h.px_h,
+                    (q.x1 + 1) * h.px_w, (1 - q.y0) * h.px_h,
+                    al_hud_side_clipped_center(&g_al_trace.raw, &q));
+        }
+    }
+    for (u32 i = 0; i < g_al_trace.n_surfaces; i++) {
+        const surface_t* s = &g.surfaces[g_al_trace.surfaces[i]];
+        fprintf(stderr, " source=%u:%u:%x:%ux%u", g_al_trace.surfaces[i], s->location, s->offset, s->w, s->h);
+    }
+    for (u32 u = 0; u < 16; u++) {
+        rsx_dsp_texture t; rsx_dsp_get_texture(&g.rsx, u, &t);
+        if (t.enabled) fprintf(stderr, " t%u=%u:%x:%ux%u", u, t.location, t.offset, t.width, t.height);
+    }
+    for (u32 r = 0; r < dc.n_arr; r++)
+        fprintf(stderr, " arr=%u:%u", dc.arr[r].first, dc.arr[r].count);
+    for (u32 r = 0; r < dc.n_idx; r++)
+        fprintf(stderr, " idx=%u:%u", dc.idx[r].first, dc.idx[r].count);
+    fprintf(stderr, "\n");
+}
+
+void rsx_live_draw_set_always_left(int on) { InterlockedExchange(&g_al_req, on ? 1 : 0); }
+
+/* The frame boundary, on the walker thread that records the draws: the 3D picture's copy (once per frame,
+ * before the HUD). The last frame's HUD becomes this frame's layout, and the game's request is taken -- on
+ * only here, off at once (any draw). */
+static void ld_al_state(int want, int at_copy)
+{
+    if (at_copy && g_al.active) {
+        g_al.frames++;
+        if (g_al.frames % 600 == 0)
+            fprintf(stderr, "[always-left] %llu frames mirrored: %llu pictures, HUD quads %llu moved / %llu mirrored / "
+                            "%llu left as they were, %u elements last frame (frame %u)\n", (unsigned long long)g_al.frames,
+                    (unsigned long long)g_al.copies, (unsigned long long)g_al.moved, (unsigned long long)g_al.mirrored,
+                    (unsigned long long)g_al.left_alone, g_al.hud.n_el, g_ld_frames);
+        /* RSX_ALWAYS_LEFT_DUMP=<n> (diagnostics): the HUD quads of the frame at renderer frame n, then its elements */
+        { static long dump = -2;
+          if (dump == -2) { const char* e = getenv("RSX_ALWAYS_LEFT_DUMP"); dump = e ? atol(e) : -1; }
+          if (dump >= 0 && (long)g_ld_frames >= dump) { dump = -1;
+              const al_hud* h = &g_al.hud;
+              for (u32 i = 0; i < h->n_cur; i++)
+                  fprintf(stderr, "[always-left] quad %u tex %llx x %.1f..%.1f y %.1f..%.1f u %.3f..%.3f uflip %d\n", i,
+                          (unsigned long long)h->cur[i].tex, (h->cur[i].x0 + 1) * h->px_w, (h->cur[i].x1 + 1) * h->px_w,
+                          (1 - h->cur[i].y1) * h->px_h, (1 - h->cur[i].y0) * h->px_h, h->cur[i].u0, h->cur[i].u1, h->cur[i].uflip);
+          } }
+        al_hud_frame_end(&g_al.hud);
+        { static long dump2 = -2;
+          if (dump2 == -2) { const char* e = getenv("RSX_ALWAYS_LEFT_DUMP"); dump2 = e ? atol(e) : -1; }
+          if (dump2 >= 0 && (long)g_ld_frames >= dump2) { dump2 = -1;
+              const al_hud* h = &g_al.hud;
+              for (u32 i = 0; i < h->n_el; i++)
+                  fprintf(stderr, "[always-left] element %u tex %llx x %.1f..%.1f y %.1f..%.1f quads %d%s\n", i,
+                          (unsigned long long)h->el[i].tex, (h->el[i].x0 + 1) * h->px_w, (h->el[i].x1 + 1) * h->px_w,
+                          (1 - h->el[i].y1) * h->px_h, (1 - h->el[i].y0) * h->px_h, h->el[i].n,
+                          h->el[i].mirror ? " (flipped pair: mirrored)" : "");
+          } }
+    }
+    if (want != g_al.active) {
+        fprintf(stderr, "[always-left] %s at frame %u (so far: %llu frames, %llu pictures mirrored, HUD quads "
+                        "%llu moved / %llu mirrored / %llu left as they were)\n", want ? "on" : "off", g_ld_frames,
+                (unsigned long long)g_al.frames, (unsigned long long)g_al.copies, (unsigned long long)g_al.moved,
+                (unsigned long long)g_al.mirrored, (unsigned long long)g_al.left_alone);
+        g_al.hud.n_cur = g_al.hud.n_el = 0;
+        g_al.active = want;
+    }
+    g_al.copy_seen = at_copy && want;
+}
+
+static int ld_al_is_display(u32 target)
+{
+    for (u32 b = 0; b < 8; b++) {
+        const display_buffer_t* d = &g.display_buffers[b];
+        if (d->valid && d->location == g.surfaces[target].location && d->offset == g.surfaces[target].offset)
+            return 1;
+    }
+    return 0;
+}
+/* A draw onto the whole picture: a display buffer drawn at its own size (the game also draws 512 x 512
+ * pictures into the display buffer's memory between frames -- not the screen). */
+static int ld_al_is_screen(u32 target, float W, float H)
+{
+    for (u32 b = 0; b < 8; b++) {
+        const display_buffer_t* d = &g.display_buffers[b];
+        if (d->valid && d->location == g.surfaces[target].location && d->offset == g.surfaces[target].offset)
+            return (float)d->width == W && (float)d->height == H;
+    }
+    return 0;
+}
+
+/* This draw's vertices (at most 64), with every attribute as the vertex shader gets it. -> count, 0 = no. */
+static u32 ld_al_vertices(float (*v)[16][4])
+{
+    u32 ids[64], bidx[64], n = 0;
+    for (u32 r = 0; r < dc.n_arr; r++)
+        for (u32 i = 0; i < dc.arr[r].count; i++) {
+            if (n >= 64) { g_al_trace.outcome = "vertices-over-64"; return 0; }
+            ids[n] = dc.arr[r].first + i; bidx[n] = 0; n++;
+        }
+    if (dc.n_idx) {
+        const u32 base_index = rsx_dsp_vertex_data_base_index(&g.rsx);
+        rsx_dsp_index_array ia; rsx_dsp_get_index_array(&g.rsx, &ia);
+        const u32 esz = ia.is_u32 ? 4 : 2;
+        const int restart_en = rsx_dsp_restart_index_enabled(&g.rsx, ia.is_u32);
+        const u32 restart_val = rsx_dsp_restart_index(&g.rsx);
+        for (u32 r = 0; r < dc.n_idx; r++)
+            for (u32 i = 0; i < dc.idx[r].count; i++) {
+                const u8* ip = guest_ptr(ia.location, ia.offset + (dc.idx[r].first + i) * esz, esz);
+                if (!ip) { g_al_trace.outcome = "index-unavailable"; return 0; }
+                const u32 index = ia.is_u32 ? (((u32)ip[0] << 24) | ((u32)ip[1] << 16) | ((u32)ip[2] << 8) | ip[3])
+                                            : (u32)((ip[0] << 8) | ip[1]);
+                if (restart_en && index == restart_val) continue;
+                if (n >= 64) { g_al_trace.outcome = "vertices-over-64"; return 0; }
+                ids[n] = index; bidx[n] = base_index; n++;
+            }
+    }
+    const u32 base = rsx_dsp_vertex_data_base_offset(&g.rsx);
+    for (u32 k = 0; k < n; k++)
+        for (u32 i = 0; i < 16; i++) {
+            rsx_dsp_vertex_attr a;
+            rsx_dsp_get_vertex_attr(&g.rsx, i, &a);
+            if (a.type && a.size && fetch_attr(i, base, ids[k], bidx[k], v[k][i])) continue;
+            if (i == 0) { g_al_trace.outcome = "position-unavailable"; return 0; }
+            rsx_dsp_vertex_default(&g.rsx, i, v[k][i]);
+        }
+    return n;
+}
+
+/* One draw while the fight is shown mirrored: changes xf (the viewport transform the vertex shader applies:
+ * clip x = o0.x * xf[0] + o0.w * xf[4]) and says how the scissor follows -- *mirror, or a move by *dx_px
+ * guest pixels. */
+static void ld_al_draw(u32 target, const u32* surf_used, u32 n_surf_used, float W, float H, float xf[8],
+                       int* mirror, float* dx_px)
+{
+    *mirror = 0; *dx_px = 0.0f;
+    g_al_trace.enabled = ld_al_trace_enabled();
+    if (g_al_trace.enabled) {
+        if (g_al_trace.frame != g_ld_frames) g_al_trace.draw = 0;
+        g_al_trace.frame = g_ld_frames; g_al_trace.draw++;
+        g_al_trace.target = target; g_al_trace.n = 0;
+        g_al_trace.n_surfaces = n_surf_used < SRV_TABLE_SIZE ? n_surf_used : SRV_TABLE_SIZE;
+        memcpy(g_al_trace.surfaces, surf_used, g_al_trace.n_surfaces * sizeof(surf_used[0]));
+        g_al_trace.start = rsx_dsp_vp_start(&g.rsx);
+        g_al_trace.raw_known = 0; g_al_trace.outcome = "not-screen";
+    }
+    const int want = InterlockedCompareExchange(&g_al_req, 0, 0) != 0;
+    if (!want) {
+        if (g_al.active) ld_al_state(0, 0);
+        if (!g_al_trace.enabled) return;
+    }
+    if (!ld_al_is_screen(target, W, H)) return;
+    static float v[64][16][4];
+    g_al_trace.outcome = "no-vertices";
+    const u32 n = ld_al_vertices(v);
+    g_al_trace.n = n;
+    const u32 start = rsx_dsp_vp_start(&g.rsx);
+    if (!n) { if (want) g_al.left_alone++; return; }
+    if (start >= RSX_DSP_VP_INSTR) {
+        g_al_trace.outcome = "vp-start-unavailable";
+        if (want) g_al.left_alone++;
+        return;
+    }
+    const u8* uc = (const u8*)(g.rsx.vp + start * 4);
+    al_quad q = { 0, 1e30f, -1e30f, 1e30f, -1e30f, 0, 0.0f, 0.0f };
+    /* the texture coordinate at the left and right edge, from the first of TEX0..TEX7 that changes across the
+     * quad (the HUD's program puts a constant in TEX0 and the coordinate in TEX1) */
+    float ul[8] = { 0 }, ur[8] = { 0 };
+    float xy[64][2];
+    for (u32 k = 0; k < n; k++) {
+        float o[16][4];
+        if (!al_vp_eval(uc, (RSX_DSP_VP_INSTR - start) * 16, (const float (*)[4])v[k],
+                        (const uint32_t (*)[4])g.rsx.constants, o)) {
+            g_al_trace.outcome = "vp-unsupported";
+            if (want) g_al.left_alone++;
+            return;
+        }
+        if (!(o[0][3] > 0.0f)) {
+            g_al_trace.outcome = "position-w-nonpositive";
+            if (want) g_al.left_alone++;
+            return;
+        }
+        const float x = (o[0][0] * xf[0] + o[0][3] * xf[4]) / o[0][3];
+        const float y = (o[0][1] * xf[1] + o[0][3] * xf[5]) / o[0][3];
+        if (!isfinite(x) || !isfinite(y)) {
+            g_al_trace.outcome = "position-nonfinite"; if (want) g_al.left_alone++; return;
+        }
+        xy[k][0] = x; xy[k][1] = y;
+        if (x < q.x0) { q.x0 = x; for (u32 t = 0; t < 8; t++) ul[t] = o[7 + t][0]; }
+        if (x > q.x1) { q.x1 = x; for (u32 t = 0; t < 8; t++) ur[t] = o[7 + t][0]; }
+        if (y < q.y0) q.y0 = y;
+        if (y > q.y1) q.y1 = y;
+    }
+    for (u32 t = 0; t < 8; t++)
+        if (fabsf(ur[t] - ul[t]) > 1e-6f) { q.u0 = ul[t]; q.u1 = ur[t]; break; }
+    q.uflip = q.u1 < q.u0;
+    /* Read the actual current program on every renderer tier. Patch 0081's cached mask is 0xFFFF on
+     * tier 2, which means unknown/all for descriptor binding, not proof that a texture is sampled. */
+    if (!g_ld_current_pso.valid || !g_ld_current_pso.fp_size) {
+        g_al_trace.outcome = "fp-unavailable"; if (want) g_al.left_alone++; return;
+    }
+    const u8* fp = guest_ptr(g_ld_current_pso.fp_location, g_ld_current_pso.fp_offset,
+                             g_ld_current_pso.fp_size);
+    if (!fp) { g_al_trace.outcome = "fp-unavailable"; if (want) g_al.left_alone++; return; }
+    const u32 reads = rsx_fp_texture_mask(fp, g_ld_current_pso.fp_size);
+    rsx_dsp_texture t0;
+    rsx_dsp_get_texture(&g.rsx, 0, &t0);
+    if ((reads & 1u) && t0.enabled && al_picture_quad((const float (*)[2])xy, n, W * 0.5f, H * 0.5f))
+        for (u32 i = 0; i < n_surf_used; i++) {
+            const surface_t* s = &g.surfaces[surf_used[i]];
+            if (s->location != t0.location || s->offset != t0.offset || ld_al_is_display(surf_used[i]) ||
+                !((float)s->w > W || (float)s->h > H)) continue;
+            g_al_trace.outcome = want ? "copy-mirrored" : "copy-off";
+            if (!want) return;
+            if (!g_al.active || !g_al.copy_seen || g_al.hud.n_cur > 0) ld_al_state(1, 1);
+            xf[0] = -xf[0]; xf[4] = -xf[4];
+            *mirror = 1;
+            g_al.copies++;
+            return;
+        }
+    const int hud = want && g_al.active && g_al.copy_seen;
+    /* One bbox cannot place several independent elements on opposite sides. Leave that batch intact;
+     * do not let its giant bbox teach the next frame that both player names are one centre overlay. */
+    if (hud && n > 6 && q.x0 < 0.0f && q.x1 > 0.0f) {
+        g_al_trace.outcome = "mixed-side-batch"; g_al.left_alone++; return;
+    }
+    /* Identify HUD art by sampled textures, never by the stale unit-0 binding. */
+    q.tex = 1469598103934665603ull;
+    for (u32 t = 0; t < SRV_TABLE_SIZE; t++) {
+        if (!((reads >> t) & 1u)) continue;
+        rsx_dsp_texture tex;
+        rsx_dsp_get_texture(&g.rsx, t, &tex);
+        if (!tex.enabled) continue;
+        q.tex = (q.tex ^ (((u64)tex.location << 32) | tex.offset)) * 1099511628211ull;
+    }
+    g_al_trace.raw = q; g_al_trace.raw_known = 1;
+    if (!hud) { g_al_trace.outcome = want ? "before-copy" : "hud-off"; return; }
+    g_al.hud.px_w = W * 0.5f; g_al.hud.px_h = H * 0.5f;
+    int m = 0;
+    const float dx = al_hud_place(&g_al.hud, &q, &m);

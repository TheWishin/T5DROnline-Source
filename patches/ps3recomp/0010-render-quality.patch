 }
+
+/* Depth-compare sampling for depth-format texture units.
+ *
+ * Tekken 5 DR renders a 512x512 shadow depth map from the light (zeta at
+ * 0xAF0000, DEPTH24_D8 | LN) and its character/stage materials sample it with
+ * TXP into r2, then light with diffuse * (1 - r2). On RSX a depth texture whose
+ * TEX_ADDRESS zfunc is between NEVER and ALWAYS is a shadow sampler: the result
+ * is the comparison `texel ZFUNC ref` (ref = z/w of the coordinate), 2x2
+ * bilinear-weighted (PCF) when the unit filters linearly. Returning the raw
+ * depth instead (what a plain Sample of the snapshot gives) multiplied every
+ * lit texel by (1 - depth) ~= 0, so faces and anything else inside the light
+ * frustum dropped to ambient-only: dark, muddy skin with hard-edged lit patches
+ * where the map ended. Note the operand order: RSX compares texel-vs-ref, the
+ * reverse of D3D's SampleCmp (RPCS3 likewise reverses the compare op for
+ * shadow samplers).
+ *
+ * Same post-pass approach as rsx_fp_apply_unnorm_scale: only the Sample call
+ * sites of the selected units change, so every other program stays
+ * byte-identical. Gather + manual compare keeps it independent of the sampler
+ * table (no comparison sampler descriptors needed).
+ */
+int rsx_fp_apply_shadow_compare(char* hlsl, u32 hlsl_size, u32 shadow_mask,
+                                const u32 zfunc[16], u32 linear_mask,
+                                u32 cube_mask)
+{
+    if (!hlsl || !shadow_mask) return 0;
+    static const char helper[] =
+        "float rsx_zcmp(float d, float r, int f) {\n"
+        "    return f == 1 ? (float)(d < r) : f == 2 ? (float)(d == r) :\n"
+        "           f == 3 ? (float)(d <= r) : f == 4 ? (float)(d > r) :\n"
+        "           f == 5 ? (float)(d != r) : f == 6 ? (float)(d >= r) :\n"
+        "           f == 7 ? 1.0 : 0.0;\n"
+        "}\n"
+        "float4 rsx_shadow2d(Texture2D t, SamplerState s, float4 c, int proj, int f, int lin) {\n"
+        "    float2 uv = proj ? c.xy / c.w : c.xy;\n"
+        "    float r = proj ? c.z / c.w : c.z;\n"
+        "    if (f & 8) r = saturate(r);\n"   /* fixed-point depth: ref clamps to [0,1] */
+        "    f &= 7;\n"
+        "    uint w, h; t.GetDimensions(w, h);\n"
+        "    float2 sz = float2(w, h);\n"
+        "    float v;\n"
+        "    if (lin) {\n"
+        "        float2 st = uv * sz - 0.5;\n"
+        "        float2 fr = frac(st);\n"
+        "        float4 d = t.GatherRed(s, (floor(st) + 1.0) / sz);\n"
+        "        float top = lerp(rsx_zcmp(d.w, r, f), rsx_zcmp(d.z, r, f), fr.x);\n"
+        "        float bot = lerp(rsx_zcmp(d.x, r, f), rsx_zcmp(d.y, r, f), fr.x);\n"
+        "        v = lerp(top, bot, fr.y);\n"
+        "    } else {\n"
+        "        v = rsx_zcmp(t.SampleLevel(s, uv, 0).r, r, f);\n"
+        "    }\n"
+        "    return (float4)v;\n"
+        "}\n";
+    int patched = 0;
+    for (u32 u = 0; u < 16; u++) {
+        if (!((shadow_mask >> u) & 1u) || ((cube_mask >> u) & 1u)) continue;
+        char needles[2][48];
+        snprintf(needles[0], sizeof needles[0], "rsx_tex[%u].Sample(rsx_samp[%u], ", u, u);
+        snprintf(needles[1], sizeof needles[1], "rsx_tex%u.Sample(rsx_samp[%u], ", u, u);
+        for (int nidx = 0; nidx < 2; nidx++) {
+            const char* needle = needles[nidx];
+            const u32 nlen = (u32)strlen(needle);
+            for (;;) {
+                char* at = strstr(hlsl, needle);
+                if (!at) break;
+                /* Call extent: from the '(' after Sample to its matching ')'. */
+                char* open = at + nlen - 1;
+                while (open > at && *open != '(') open--;
+                int depth = 0;
+                char* end = open;
+                for (; *end; end++) {
+                    if (*end == '(') depth++;
+                    else if (*end == ')') { depth--; if (!depth) break; }
+                }
+                if (*end != ')') return -1;
+                /* Argument text after "rsx_samp[u], ": "(A).xy" or
+                 * "(A).xy / (A).w" (TEX / TXP, see the emitter). */
+                const char* arg = at + nlen;
+                if (*arg != '(') return -1;
+                const char* ap = arg;
+                depth = 0;
+                for (; ap < end; ap++) {
+                    if (*ap == '(') depth++;
+                    else if (*ap == ')') { depth--; if (!depth) break; }
+                }
+                if (ap >= end || strncmp(ap, ").xy", 4) != 0) return -1;
+                const int proj = strncmp(ap + 4, " / ", 3) == 0;
+                const u32 alen = (u32)(ap + 1 - arg);   /* "(A)" */
+                char call[160];
+                const int n0 = snprintf(call, sizeof call, "rsx_shadow2d(%.*s, rsx_samp[%u], ",
+                                        (int)(open - at - (int)strlen(".Sample")), at, u);
+                if (n0 < 0 || (u32)n0 >= sizeof call) return -1;
+                char tail[64];
+                const int n1 = snprintf(tail, sizeof tail, ", %d, %u, %u)", proj,
+                                        zfunc[u] & 15u, (linear_mask >> u) & 1u);
+                if (n1 < 0 || (u32)n1 >= sizeof tail) return -1;
+                const u32 new_len = (u32)n0 + alen + (u32)n1;
+                const u32 old_len = (u32)(end + 1 - at);
+                const u32 used = (u32)strlen(hlsl);
+                if (used - old_len + new_len + 1 > hlsl_size) return -1;
+                char* repl = (char*)malloc(new_len + 1);
+                if (!repl) return -1;
+                memcpy(repl, call, (size_t)n0);
+                memcpy(repl + n0, arg, alen);
+                memcpy(repl + n0 + alen, tail, (size_t)n1 + 1);
+                memmove(at + new_len, end + 1, used - (u32)(end + 1 - hlsl) + 1);
+                memcpy(at, repl, new_len);
+                free(repl);
+                patched++;
+            }
+        }
+    }
+    if (!patched) return 0;
+    /* Helper goes in front of main (after the resource declarations). */
+    char* main_at = strstr(hlsl, "float4 main(PSInput");
+    char* s2 = strstr(hlsl, "struct PSOutput");
+    if (s2 && (!main_at || s2 < main_at)) main_at = s2;
+    if (!main_at) main_at = strstr(hlsl, "PSOutput main(PSInput");
+    if (!main_at) return -1;
+    const u32 hl = (u32)strlen(helper);
+    const u32 used = (u32)strlen(hlsl);
+    if (used + hl + 1 > hlsl_size) return -1;
+    memmove(main_at + hl, main_at, used - (u32)(main_at - hlsl) + 1);
+    memcpy(main_at, helper, hl);
+    return patched;
+}

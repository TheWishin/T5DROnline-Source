+/* ---- block dispatch ---------------------------------------------------- */
+
+/* Per register index: what rsx_dispatch_method does beyond storing the word.
+ * 0 = nothing (plain state), 1 = transform program window, 2 = transform
+ * constant window, 3 = anything else (immediate data, exec methods). */
+static u8 s_blk_kind[RSX_DSP_NUM_REGS];
+static int s_blk_ready = -1;   /* -1 unknown, 0 = per-word only, 1 = on */
+
+static void blk_mark(u32 method, u32 n, u8 kind)
+{
+    for (u32 i = 0; i < n; i++) s_blk_kind[(method >> 2) + i] = kind;
+}
+
+static void blk_init(void)
+{
+    const char* e = getenv("RSX_DISPATCH_BLOCK");
+    if (s_ed_on < 0) { const char* d = getenv("RSX_EMPTY_DRAW_LOG"); s_ed_on = d ? 1 : 0; s_ed_from = d ? (u32)atoi(d) : 0; }
+    /* Probes that watch every word keep the per-word path. */
+    if ((e && *e == '0') || s_ed_on || getenv("RSX_CONST_LOG")) { s_blk_ready = 0; return; }
+    memset(s_blk_kind, 0, sizeof(s_blk_kind));
+    blk_mark(M_VP_UPLOAD_INST, 32, 1);
+    blk_mark(M_VP_UPLOAD_CONST, 32, 2);
+    /* immediate vertex data (imm_method ranges) */
+    blk_mark(0x1C00, 0x40, 3);   /* DATA4F_M        */
+    blk_mark(0x1880, 0x20, 3);   /* DATA2F_M        */
+    blk_mark(0x1500, 0x30, 3);   /* DATA3F_M        */
+    blk_mark(0x1E40, 0x10, 3);   /* DATA1F_M        */
+    blk_mark(0x1940, 0x10, 3);   /* DATA4UB_M       */
+    blk_mark(0x1900, 0x10, 3);   /* DATA2S_M        */
+    blk_mark(0x1980, 0x20, 3);   /* DATA4S_M        */
+    blk_mark(0x0A80, 0x20, 3);   /* DATA_SCALED4S_M */
+    /* the switch */
+    blk_mark(M_CLEAR_BUFFERS, 1, 3);
+    blk_mark(M_VERTEX_BEGIN_END, 1, 3);
+    blk_mark(M_INLINE_ARRAY, 1, 3);
+    blk_mark(M_VB_VERTEX_BATCH, 1, 3);
+    blk_mark(M_VB_INDEX_BATCH, 1, 3);
+    blk_mark(M_GCM_FLIP_HEAD_0, 1, 3);
+    blk_mark(M_GCM_FLIP_HEAD_1, 1, 3);
+    blk_mark(M_GCM_DRIVER_FLIP, 1, 3);
+    s_blk_ready = 1;
+}
+
+void rsx_dispatch_method_block(rsx_dispatch* rsx, u32 method, int incrementing,
+                               const u32* be_words, u32 count)
+{
+    if (s_blk_ready < 0) blk_init();
+    if (!s_blk_ready) {
+        for (u32 i = 0; i < count; i++)
+            rsx_dispatch_method(rsx, incrementing ? method + i * 4 : method,
+                                __builtin_bswap32(be_words[i]));
+        return;
+    }
+    for (u32 i = 0; i < count; i++) {
+        const u32 m = (incrementing ? method + i * 4 : method) & 0xFFFFC;
+        const u32 v = __builtin_bswap32(be_words[i]);
+        const u32 idx = m >> 2;
+        if (idx >= RSX_DSP_NUM_REGS) { rsx_dispatch_method(rsx, m, v); continue; }
+        const u8 kind = s_blk_kind[idx];
+        rsx->seen[idx]++;
+        rsx->regs[idx] = v;
+        if (!kind) continue;
+        if (kind == 1) {                  /* transform program window */
+            const u32 lane = (idx - (M_VP_UPLOAD_INST >> 2)) & 3;
+            u32* load = &rsx->regs[M_VP_UPLOAD_FROM_ID >> 2];
+            const u32 pos = *load * 4 + lane;
+            if (pos < RSX_DSP_VP_WORDS && rsx->vp[pos] != v) {
+                rsx->vp[pos] = v;
+                rsx->vp_gen++;
+            }
+            if (lane == 3) (*load)++;
+        } else if (kind == 2) {           /* transform constant window */
+            const u32 word = idx - (M_VP_UPLOAD_CONST >> 2);
+            const u32 slot = rsx->regs[M_VP_UPLOAD_CONST_ID >> 2] + (word >> 2);
+            if (slot < RSX_DSP_NUM_CONSTANTS)
+                rsx->constants[slot][word & 3] = v;
+            rsx->constants_gen++;
+        } else {
+            /* undo the store/count the full dispatch is about to repeat */
+            rsx->seen[idx]--;
+            rsx_dispatch_method(rsx, m, v);
+        }
+    }
+}

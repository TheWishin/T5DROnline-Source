     return spu__sx_st(r);
 }
+#if !defined(SPU_NEAR_FLOAT)
+SPU__SX_INLINE u128 spu_fm(u128 a, u128 b) { return spu__sx_fm(a, b); }
 SPU__SX_INLINE u128 spu_fma(u128 a, u128 b, u128 c)  { return spu__sx_fma(a, b, c, 0, 0); }            /* a*b + c */
 SPU__SX_INLINE u128 spu_fms(u128 a, u128 b, u128 c)  { return spu__sx_fma(a, b, c, 0, 0x80000000u); }  /* a*b - c */
 SPU__SX_INLINE u128 spu_fnms(u128 a, u128 b, u128 c) { return spu__sx_fma(a, b, c, 0x80000000u, 0); }  /* c - a*b */
 #else
+/* SPU_NEAR_FLOAT (a compile definition, set per lifted image; t5dr offline soak,
+ * patch 0041): the SPU's float semantics in host IEEE single precision except
+ * for the rounding of the last bit -- to nearest instead of toward zero.
+ *   - an operand whose biased exponent is 0 is zero (the SPU has no denormals);
+ *   - a result that comes out denormal or zero is +0 (the SPU flushes, and never
+ *     makes -0);
+ *   - an operand or a result with biased exponent 255 (the SPU's extended range,
+ *     IEEE's Inf/NaN; also every overflow) sends the whole vector to the exact
+ *     path above, so saturation and extended-range values stay exactly as on
+ *     the SPU;
+ *   - fma/fms/fnms round twice (product, then sum), so the result does not
+ *     depend on whether the host has FMA instructions: the same bits on every
+ *     x86 CPU and for both build targets (no contraction: -ffp-contract=off).
+ * Ordinary values differ from the exact path by at most 1 unit in the last place
+ * (the multiply-adds by 2): -138 dB for audio. Unlike SPU_FAST_FLOAT nothing is
+ * ever denormal, so an IIR filter or reverb decaying in silence reaches zero as
+ * on the SPU instead of settling on the smallest denormal -- where every
+ * operation would take a microcode assist on many Intel CPUs. For Tekken 5 DR's
+ * sound core (FFT butterflies, mixing), which only makes audio samples: with
+ * the exact path it needs 4-7 ms of its 5.33 ms audio tick on a fast desktop
+ * core, so slower CPUs miss the tick and the sound breaks up. */
+SPU__SX_INLINE __m128i spu__nf_be(__m128i x) { return _mm_and_si128(_mm_srli_epi32(x, 23), _mm_set1_epi32(0xFF)); }
+SPU__SX_INLINE __m128 spu__nf_daz(__m128i x) {          /* biased exponent 0 -> +0 */
+    return _mm_castsi128_ps(_mm_andnot_si128(_mm_cmpeq_epi32(spu__nf_be(x), _mm_setzero_si128()), x));
+}
+SPU__SX_INLINE __m128i spu__nf_ext(__m128i x) { return _mm_cmpeq_epi32(spu__nf_be(x), _mm_set1_epi32(255)); }
+/* The SPU form of an IEEE result: denormal or zero -> +0. *bad is nonzero when a lane
+ * overflowed (Inf) or is NaN: that vector is redone on the exact path. */
+SPU__SX_INLINE __m128i spu__nf_out(__m128 r, int* bad) {
+    const __m128i ri = _mm_castps_si128(r), be = spu__nf_be(ri);
+    const __m128i ext = _mm_cmpeq_epi32(be, _mm_set1_epi32(255));
+    *bad = !_mm_testz_si128(ext, ext);
+    return _mm_andnot_si128(_mm_cmpeq_epi32(be, _mm_setzero_si128()), ri);
+}
+SPU__SX_INLINE u128 spu__nf_fa(u128 a, u128 b, uint32_t negb) {
+    const __m128i x = spu__sx_ld(a), y = _mm_xor_si128(spu__sx_ld(b), _mm_set1_epi32((int)negb));
+    const __m128i e = _mm_or_si128(spu__nf_ext(x), spu__nf_ext(y));
+    if (_mm_testz_si128(e, e)) {
+        int bad;
+        const __m128i r = spu__nf_out(_mm_add_ps(spu__nf_daz(x), spu__nf_daz(y)), &bad);
+        if (!bad) return spu__sx_st(r);
+    }
+    return spu__sx_fa(a, b, negb);
+}
+SPU__SX_INLINE u128 spu_fa(u128 a, u128 b) { return spu__nf_fa(a, b, 0); }
+SPU__SX_INLINE u128 spu_fs(u128 a, u128 b) { return spu__nf_fa(a, b, 0x80000000u); }
+SPU__SX_INLINE u128 spu_fm(u128 a, u128 b) {
+    const __m128i x = spu__sx_ld(a), y = spu__sx_ld(b);
+    const __m128i e = _mm_or_si128(spu__nf_ext(x), spu__nf_ext(y));
+    if (_mm_testz_si128(e, e)) {
+        int bad;
+        const __m128i r = spu__nf_out(_mm_mul_ps(spu__nf_daz(x), spu__nf_daz(y)), &bad);
+        if (!bad) return spu__sx_st(r);
+    }
+    return spu__sx_fm(a, b);
+}
+SPU__SX_INLINE u128 spu__nf_fma(u128 a, u128 b, u128 c, uint32_t negp, uint32_t negc) {
+    const __m128i x = _mm_xor_si128(spu__sx_ld(a), _mm_set1_epi32((int)negp)), y = spu__sx_ld(b);
+    const __m128i z = _mm_xor_si128(spu__sx_ld(c), _mm_set1_epi32((int)negc));
+    const __m128i e = _mm_or_si128(_mm_or_si128(spu__nf_ext(x), spu__nf_ext(y)), spu__nf_ext(z));
+    if (_mm_testz_si128(e, e)) {
+        int bad;
+        const __m128 p = _mm_mul_ps(spu__nf_daz(x), spu__nf_daz(y));
+        const __m128i r = spu__nf_out(_mm_add_ps(p, spu__nf_daz(z)), &bad);
+        if (!bad) return spu__sx_st(r);
+    }
+    return spu__sx_fma(a, b, c, negp, negc);
+}
+SPU__SX_INLINE u128 spu_fma(u128 a, u128 b, u128 c)  { return spu__nf_fma(a, b, c, 0, 0); }            /* a*b + c */
+SPU__SX_INLINE u128 spu_fms(u128 a, u128 b, u128 c)  { return spu__nf_fma(a, b, c, 0, 0x80000000u); }  /* a*b - c */
+SPU__SX_INLINE u128 spu_fnms(u128 a, u128 b, u128 c) { return spu__nf_fma(a, b, c, 0x80000000u, 0); }  /* c - a*b */
+#endif
+#else
 static inline u128 spu_fa(u128 a, u128 b) { return spu__fa_s(a, b); }
 static inline u128 spu_fs(u128 a, u128 b) { return spu__fs_s(a, b); }
 static inline u128 spu_fm(u128 a, u128 b) { return spu__fm_s(a, b); }
diff --git a/runtime/spu/tests/test_spu_near_float.c b/runtime/spu/tests/test_spu_near_float.c
new file mode 100644
index 0000000..bf0ef2c
--- /dev/null
+++ b/runtime/spu/tests/test_spu_near_float.c
@@ -0,0 +1,150 @@
+/*
+ * SPU_NEAR_FLOAT (spu_helpers.h, t5dr patch 0041): the SPU's float semantics in
+ * host IEEE single precision except for the last bit's rounding (to nearest
+ * instead of toward zero). Checked against the exact emulation (spu_*_ref):
+ *   - ordinary operands: within 1 ulp (fa/fs/fm), 3 ulp (the multiply-adds,
+ *     outside cancellation), random values over a wide exponent range;
+ *   - SPU zero rules: an exponent-0 operand (denormal pattern) is zero, an
+ *     underflowing result is +0, never -0 -- bit-identical to the exact path;
+ *   - extended range (exponent 255) operands and overflowing results take the
+ *     exact path: bit-identical;
+ *   - a value decaying by 0.5 per step reaches +0 (it would settle on a
+ *     denormal with plain IEEE floats);
+ *   - the same bits whatever the host: the multiply-add rounds twice, so this
+ *     test's results do not depend on FMA instructions (compare a /arch:AVX2
+ *     build's printed checksum with a baseline one).
+ *
+ * Build: clang-cl /O2 /DSPU_NEAR_FLOAT -msse4.1 /I.. test_spu_near_float.c
+ *        (and once more with -march=x86-64-v3: the checksum line must match)
+ * Exit code 0 if all passed.
+ */
+#include "../spu_helpers.h"
+#include <stdio.h>
+#include <string.h>
+
+static int g_pass, g_fail;
+
+static uint32_t rnd(uint64_t* s)
+{
+    *s = *s * 6364136223846793005ull + 1442695040888963407ull;
+    return (uint32_t)(*s >> 32);
+}
+/* A random ordinary single: exponent within +-2^40, either sign. */
+static uint32_t rnd_float(uint64_t* s)
+{
+    const uint32_t r = rnd(s);
+    const uint32_t e = 127u - 40u + (r >> 8) % 81u;
+    return (r & 0x80000000u) | (e << 23) | (rnd(s) & 0x7FFFFFu);
+}
+static float f_of(uint32_t u) { float f; memcpy(&f, &u, 4); return f; }
+
+static double ulps(uint32_t a, uint32_t b)
+{
+    const float fa = f_of(a), fb = f_of(b);
+    if (fa == fb) return 0.0;
+    int e = (int)((b >> 23) & 0xFFu) - 127 - 23;
+    double ulp = 1.0;
+    while (e > 0) { ulp *= 2.0; e--; }
+    while (e < 0) { ulp /= 2.0; e++; }
+    const double d = (double)fa - (double)fb;
+    return (d < 0 ? -d : d) / ulp;
+}
+
+static void near(const char* what, u128 got, u128 ref, double limit, double* worst)
+{
+    for (int i = 0; i < 4; i++) {
+        const uint32_t r = ref._u32[i];
+        const uint32_t be = (r >> 23) & 0xFFu;
+        if (be == 0 || be == 0xFFu) {                  /* zero / extended: must be bit-identical */
+            if (got._u32[i] == r) g_pass++;
+            else { if (g_fail < 10) printf("  FAIL %s: %08X, exact %08X\n", what, got._u32[i], r); g_fail++; }
+            continue;
+        }
+        const double u = ulps(got._u32[i], r);
+        if (u > *worst) *worst = u;
+        if (u > limit) { if (g_fail < 10) printf("  FAIL %s: %08X, exact %08X (%.1f ulp)\n", what, got._u32[i], r, u); g_fail++; }
+        else g_pass++;
+    }
+}
+
+static void same(const char* what, u128 got, u128 ref)
+{
+    for (int i = 0; i < 4; i++) {
+        if (got._u32[i] == ref._u32[i]) g_pass++;
+        else { if (g_fail < 20) printf("  FAIL %s lane %d: %08X, exact %08X\n", what, i, got._u32[i], ref._u32[i]); g_fail++; }
+    }
+}
+
+static u128 v4(uint32_t a, uint32_t b, uint32_t c, uint32_t d) { u128 r; r._u32[0] = a; r._u32[1] = b; r._u32[2] = c; r._u32[3] = d; return r; }
+
+int main(void)
+{
+    printf("SPU near float (SPU_NEAR_FLOAT)\n");
+#ifndef SPU_NEAR_FLOAT
+    printf("  built without SPU_NEAR_FLOAT: nothing to compare\n");
+    return 1;
+#else
+    uint64_t s = 20261019, sum = 1469598103934665603ull;
+    double w_fa = 0, w_fs = 0, w_fm = 0, w_fma = 0, w_fms = 0, w_fnms = 0;
+    for (int n = 0; n < 300000; n++) {
+        u128 a, b, c;
+        for (int i = 0; i < 4; i++) { a._u32[i] = rnd_float(&s); b._u32[i] = rnd_float(&s); c._u32[i] = rnd_float(&s); }
+        const u128 ra = spu_fa(a, b), rs = spu_fs(a, b), rm = spu_fm(a, b), rf = spu_fma(a, b, c);
+        for (int i = 0; i < 4; i++) {
+            sum = (sum ^ ra._u32[i]) * 1099511628211ull; sum = (sum ^ rs._u32[i]) * 1099511628211ull;
+            sum = (sum ^ rm._u32[i]) * 1099511628211ull; sum = (sum ^ rf._u32[i]) * 1099511628211ull;
+        }
+        near("fa", ra, spu_fa_ref(a, b), 1.0, &w_fa);
+        near("fs", rs, spu_fs_ref(a, b), 1.0, &w_fs);
+        near("fm", rm, spu_fm_ref(a, b), 1.0, &w_fm);
+        const double p = (double)f_of(a._u32[0]) * (double)f_of(b._u32[0]);
+        const double z = (double)f_of(c._u32[0]);
+        const double ap = p < 0 ? -p : p, az = z < 0 ? -z : z;
+        if (az < ap / 4 || az > ap * 4) {
+            u128 a1 = a, b1 = b, c1 = c;
+            for (int i = 1; i < 4; i++) { a1._u32[i] = a._u32[0]; b1._u32[i] = b._u32[0]; c1._u32[i] = c._u32[0]; }
+            near("fma",  spu_fma(a1, b1, c1),  spu_fma_ref(a1, b1, c1),  3.0, &w_fma);
+            near("fms",  spu_fms(a1, b1, c1),  spu_fms_ref(a1, b1, c1),  3.0, &w_fms);
+            near("fnms", spu_fnms(a1, b1, c1), spu_fnms_ref(a1, b1, c1), 3.0, &w_fnms);
+        }
+    }
+    /* SPU zero rules, bit-identical to the exact path: denormal patterns are zero, -0 never comes out */
+    {
+        const u128 den = v4(0x00000001u, 0x807FFFFFu, 0x00400000u, 0x80000000u);
+        const u128 one = v4(0x3F800000u, 0xBF800000u, 0x3F800000u, 0x3F800000u);
+        same("den+1", spu_fa(den, one), spu_fa_ref(den, one));
+        same("den*1", spu_fm(den, one), spu_fm_ref(den, one));
+        same("1-1", spu_fs(one, one), spu_fs_ref(one, one));
+        same("den*1+den", spu_fma(den, one, den), spu_fma_ref(den, one, den));
+        /* underflow: 2^-100 * 2^-100 */
+        const u128 tiny = v4(0x0D800000u, 0x8D800000u, 0x0D800000u, 0x00800000u);
+        same("tiny*tiny", spu_fm(tiny, tiny), spu_fm_ref(tiny, tiny));
+        same("tiny*tiny+0", spu_fma(tiny, tiny, v4(0, 0, 0x80000000u, 0)), spu_fma_ref(tiny, tiny, v4(0, 0, 0x80000000u, 0)));
+    }
+    /* extended range and overflow go the exact way */
+    {
+        const u128 big = v4(0x7F7FFFFFu, 0xFF000000u, 0x7F800000u, 0x7FFFFFFFu);   /* max, -2^127, ext, ext max */
+        const u128 two = v4(0x40000000u, 0x40000000u, 0x3F800000u, 0x3F800000u);
+        same("big*2", spu_fm(big, two), spu_fm_ref(big, two));
+        same("big+big", spu_fa(big, big), spu_fa_ref(big, big));
+        same("big*2+big", spu_fma(big, two, big), spu_fma_ref(big, two, big));
+        const u128 m = v4(0x7F7FFFFFu, 0x3F800000u, 0x3F800000u, 0x3F800000u);   /* one overflowing lane */
+        same("max+max (one lane)", spu_fa(m, m), spu_fa_ref(m, m));
+    }
+    /* a decaying value reaches +0 */
+    {
+        u128 x = v4(0x3F800000u, 0xBF800000u, 0x00800000u, 0x3F000000u), h;
+        for (int i = 0; i < 4; i++) h._u32[i] = 0x3F000000u;              /* 0.5 */
+        for (int k = 0; k < 400; k++) x = spu_fm(x, h);
+        for (int i = 0; i < 4; i++) { if (x._u32[i] == 0) g_pass++; else { g_fail++; printf("  FAIL decay lane %d: %08X\n", i, x._u32[i]); } }
+        u128 y = v4(0x3F800000u, 0x3F800000u, 0x3F800000u, 0x3F800000u), k9;
+        for (int i = 0; i < 4; i++) k9._u32[i] = 0x3F666666u;              /* 0.9 */
+        for (int k = 0; k < 2000; k++) y = spu_fma(y, k9, v4(0, 0, 0, 0)); /* IIR with no input */
+        for (int i = 0; i < 4; i++) { if (y._u32[i] == 0) g_pass++; else { g_fail++; printf("  FAIL iir lane %d: %08X\n", i, y._u32[i]); } }
+    }
+    printf("  worst ulp: fa %.1f fs %.1f fm %.1f fma %.1f fms %.1f fnms %.1f\n", w_fa, w_fs, w_fm, w_fma, w_fms, w_fnms);
+    printf("  checksum %016llX (the same for every build target and CPU)\n", (unsigned long long)sum);
+    printf("SPU near float: %d passed, %d failed\n", g_pass, g_fail);
+    return g_fail ? 1 : 0;
+#endif
+}

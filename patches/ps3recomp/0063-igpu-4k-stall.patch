+        HANDLE th = CreateThread(NULL, 0, hs_clock_setup, NULL, 0, NULL);
+        if (th) CloseHandle(th);
+        return 0;
+    }
+    if (InterlockedCompareExchange(&s_clk_state, 1, 1) != 1) return 0;
+    if (s_clk_collect(s_clk_q) != 0) return 0;
+    hs_pdh_value vp, vf;
+    if (s_clk_value(s_clk_perf, 0x200 /* PDH_FMT_DOUBLE */, NULL, &vp) != 0 || vp.CStatus > 1 ||

+/* Patch 0106 (Moonlit Wilderness' black line): the edge a filter kernel's view of
+ * surface `slot` is clamped to, x << 16 | y in guest texels (the last texel this
+ * frame's draws could reach), or 0 when they reached the whole surface. The 3D
+ * pass of most stages draws into part of the 2048x1440 target (Moonlit: 1536 x
+ * 1280; scissor = viewport) and the game's clear is held to that scissor too, so
+ * the rest stays black; the soft-focus taps 2 guest texels around the centre
+ * then read that black below the last row and right of the last column, and the
+ * picture got a dark bottom row (about a third as bright) and right column. The
+ * view repeats the last drawn row / column there instead: what the scene's
+ * continuation would be. Every texel inside stays the same. RSX_KERNEL_EDGE=0:
+ * off (the kernels read the surface as before). */
+static int g_ld_kernel_edge = -1;
+static u32 ld_kernel_edge(u32 slot)
+{
+    if (g_ld_kernel_edge < 0) { const char* e = getenv("RSX_KERNEL_EDGE"); g_ld_kernel_edge = !(e && *e == '0'); }
+    const surface_t* s = &g.surfaces[slot];
+    if (!g_ld_kernel_edge || s->ext_frame != g_ld_frames + 1u || !s->ext_r || !s->ext_b) return 0;
+    if (s->ext_r >= s->w && s->ext_b >= s->h) return 0;
+    const u32 lx = (s->ext_r < s->w ? s->ext_r : s->w) - 1u, ly = (s->ext_b < s->h ? s->ext_b : s->h) - 1u;
+    return (lx << 16) | ly | 0x80000000u;    /* never 0 */
+}

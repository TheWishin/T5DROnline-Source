+static void pov_set(u32* bits, int h, DWORD pov)
+{
+    if (LOWORD(pov) == 0xFFFF) return;                /* centred */
+    pov %= 36000;
+    unsigned id = CID_HAT + (unsigned)h * 4;
+    if (pov >= 31500 || pov <= 4500)  bits[(id + 0) >> 5] |= 1u << ((id + 0) & 31);
+    if (pov >= 4500  && pov <= 13500) bits[(id + 1) >> 5] |= 1u << ((id + 1) & 31);
+    if (pov >= 13500 && pov <= 22500) bits[(id + 2) >> 5] |= 1u << ((id + 2) & 31);
+    if (pov >= 22500 && pov <= 31500) bits[(id + 3) >> 5] |= 1u << ((id + 3) & 31);

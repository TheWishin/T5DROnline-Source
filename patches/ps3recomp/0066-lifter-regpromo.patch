--- a/tools/ppu_lifter.py
+++ b/tools/ppu_lifter.py
@@ -825,6 +825,402 @@ def _fuse_cr(body_lines: list[str]) -> list[str]:
     return out
 
 
+# ---------------------------------------------------------------------------
+# Register promotion (--regpromo; post-pass over one function's final body)
+#
+# The lifted code keeps every guest register in the context struct, and
+# `ctx` points at memory the compiler must assume any guest store, fence or
+# call can change. So a value written to ctx->gpr[n] is stored, and read back
+# from memory after every guest store in between: the hot copy loops reload
+# their pointers and counter from ctx after each byte they move.
+#
+# This pass keeps the guest GPRs, FPRs, CR, XER and CTR a function uses in C
+# locals instead, which the compiler can hold in host registers. ctx is the
+# only place anything outside the function reads them, and nothing outside
+# runs except at an ESCAPE: a call (direct, indirect, HLE, syscall, any line
+# that hands `ctx` to a function), a return or trampoline hand-off, or the
+# end of the body. So:
+#   - entry: every promoted local is loaded from ctx;
+#   - before an escape: every local that may differ from ctx (written on some
+#     path since ctx was last brought up to date: a may-"dirty" dataflow over
+#     the body's labels and gotos) is stored back -- ctx then holds exactly
+#     what the unpromoted code would have left in it;
+#   - after a call-like escape: every local is loaded again (the callee may
+#     have changed anything); the compiler drops the loads nobody uses.
+# Lines that pass `ctx` along are kept VERBATIM (they read and write ctx
+# itself, which is up to date around them). The fields nothing promotes (LR,
+# VRs, VSCR, FPSCR, the reservation) stay in ctx everywhere; other threads
+# write a thread's reserve_addr, and nothing else reads or writes the promoted
+# fields of a running thread's context (diagnostic dumps aside).
+#
+# Guest memory accesses, their order and their values are unchanged; only
+# where the register values live between two escapes changes. The pass is a
+# strict recognizer of the lifter's own line shapes: a function with any line
+# it does not understand is emitted unchanged (counted in the lift summary).
+# ---------------------------------------------------------------------------
+REGPROMO_DEFAULT = True    # --regpromo off lifts the old way (the same results, slower)
+
+# Types as in ppu_context (HEADER_PREAMBLE): a local must have its field's type
+# exactly, so every expression that reads or writes it computes the same.
+_RP_TYPE = {"g": "uint64_t", "f": "double", "cr": "uint32_t", "xer": "uint32_t", "ctr": "uint64_t"}
+# ctx fields that stay in memory (read and written in place).
+_RP_KEEP = frozenset(("lr", "vr", "vscr", "fpscr", "reserve_addr", "reserve_value",
+                      "reserve_valid", "cia", "vrsave", "thread_id"))
+_RP_CTX_RE = re.compile(r"\bctx\b(?:(?P<arrow>->)(?P<field>[A-Za-z_]\w*)(?:\[(?P<idx>[^\]]*)\])?)?")
+_RP_LABEL_RE = re.compile(r"^(loc_[0-9A-F]{8}):(?:\s*;)?$")
+_RP_GOTO_RE = re.compile(r"\bgoto\s+(loc_[0-9A-F]{8})\s*;")
+_RP_TRAMP = r"\{ g_trampoline_fn = \(void\(\*\)\(void\*\)\)(?P<fn>[A-Za-z_]\w*); return; \}"
+_RP_KIND_RES = (
+    ("goto", re.compile(r"^goto (?P<lab>loc_[0-9A-F]{8});$")),
+    ("cgoto", re.compile(r"^if \((?P<cond>.*)\) goto (?P<lab>loc_[0-9A-F]{8});$")),
+    ("ret", re.compile(r"^return;$")),
+    ("tramp", re.compile(r"^" + _RP_TRAMP + r"$")),
+    ("cret", re.compile(r"^if \((?P<cond>.*)\) return;$")),
+    ("ctramp", re.compile(r"^if \((?P<cond>.*)\) " + _RP_TRAMP + r"$")),
+)
+_RP_SWITCH_RE = re.compile(
+    r"^switch \(\(uint32_t\)ctx->ctr\) \{ (?:case 0x[0-9A-F]{8}u: (?:goto loc_[0-9A-F]{8};|"
+    + _RP_TRAMP + r"))+ default: ps3_indirect_call\(ctx\); return; \} return;$")
+# Anything that transfers control or could leave the line some other way than
+# falling through, outside the shapes above: such a line makes the function
+# keep its unpromoted body.
+_RP_BAD_RE = re.compile(r"\b(?:goto|return|switch|case|default|break|continue|while|do|"
+                        r"asm|__asm__|__asm|__try|__except|__finally|__leave|throw|try|catch|"
+                        r"setjmp|longjmp|_setjmp|g_trampoline_fn)\b")
+# Functions a line without `ctx` may call: none of them can reach the context
+# of the thread running the lifted code except through g_active_ctx, which
+# the runtime uses for the reservation (not promoted) and for diagnostics.
+_RP_CALL_OK_RE = re.compile(r"^(?:vm_\w+|VM_\w+|ppc_\w+|ppu_\w+|vmx_\w+|memcpy|memset|memmove|fabs|"
+                            r"fabsf|sqrt|__builtin_\w+|__atomic_\w+|PPU_FENCE|for|if|sizeof|void|"
+                            r"u?int(?:8|16|32|64)_t|float|double|int|unsigned|char|long|short|"
+                            r"_byteswap_\w+|_mm_\w+|_rotl\w*|_rotr\w*)$")
+_RP_STATS = Counter()
+
+
+def _rp_split_comments(line: str):
+    """[(is_comment, text)] pieces of a line; None when a comment is left open
+    or a // or string literal makes the split unsafe."""
+    if "/*" not in line:
+        if "//" in line or '"' in line or "'" in line or "*/" in line:
+            return None
+        return [(False, line)]
+    parts, pos = [], 0
+    while True:
+        k = line.find("/*", pos)
+        if k < 0:
+            parts.append((False, line[pos:]))
+            break
+        e = line.find("*/", k + 2)
+        if e < 0:
+            return None
+        parts.append((False, line[pos:k]))
+        parts.append((True, line[k:e + 2]))
+        pos = e + 2
+    code = "".join(t for c, t in parts if not c)
+    if "//" in code or '"' in code or "'" in code:
+        return None
+    return parts
+
+
+_RP_BRACKETS_RE = re.compile(r"[()\[\]{}]")
+_RP_ASSIGN_RE = re.compile(r"(?:[-+*/%&|^]|<<|>>)?=(?!=)")
+_RP_LOC_DEF_RE = re.compile(r"\bloc_[0-9A-F]{8}\s*:(?!:)")
+_RP_CALL_RE = re.compile(r"\b([A-Za-z_]\w*)\s*\(")
+_RP_OPAQUE_BAD_RE = re.compile(r"\b(?:case|default|break|continue|while|do|asm|__asm__|__asm|__try|__except|"
+                               r"__finally|__leave|throw|try|catch|setjmp|longjmp|_setjmp)\b")
+_RP_CALL_OK = {}
+
+
+def _rp_call_ok(name: str) -> bool:
+    ok = _RP_CALL_OK.get(name)
+    if ok is None:
+        ok = _RP_CALL_OK[name] = bool(_RP_CALL_OK_RE.match(name))
+    return ok
+
+
+def _rp_balanced(code: str) -> bool:
+    depth = {"(": 0, "[": 0, "{": 0}
+    close = {")": "(", "]": "[", "}": "{"}
+    for ch in _RP_BRACKETS_RE.findall(code):
+        if ch in depth:
+            depth[ch] += 1
+        elif ch in close:
+            depth[close[ch]] -= 1
+            if depth[close[ch]] < 0:
+                return False
+    return all(v == 0 for v in depth.values())
+
+
+def _rp_scan(code: str):
+    """Promotable occurrences in one code fragment: (refs, writes, bare, ok).
+    refs/writes are sets of keys 'gN', 'fN', 'cr', 'xer', 'ctr'; a write is
+    an occurrence that is assigned, incremented/decremented or has its
+    address taken (over-approximate: a key counted as written when it is not
+    only costs a store)."""
+    refs, writes, bare = set(), set(), False
+    for m in _RP_CTX_RE.finditer(code):
+        if not m.group("arrow"):
+            bare = True
+            continue
+        fld, idx = m.group("field"), m.group("idx")
+        if fld in ("gpr", "fpr"):
+            if idx is None or not idx.isdigit() or int(idx) > 31:
+                return None
+            key = ("g" if fld == "gpr" else "f") + str(int(idx))
+        elif fld in ("cr", "xer", "ctr"):
+            if idx is not None:
+                return None
+            key = fld
+        elif fld in _RP_KEEP:
+            continue
+        else:
+            return None
+        refs.add(key)
+        st, en = m.start(), m.end()
+        before = code[max(0, st - 64):st].rstrip() or code[:st].rstrip()
+        after = code[en:en + 64].lstrip() or code[en:].lstrip()
+        # `&` right before the field takes its address -- unless what precedes the
+        # `&` ends an operand, which makes it a binary AND (`a & ctx->gpr[n]`).
+        amp = before.endswith("&") and not before.endswith("&&")
+        if amp:
+            prev = before[:-1].rstrip()
+            amp = not (prev and (prev[-1].isalnum() or prev[-1] in "_)]"))
+        if amp or before.endswith(("++", "--")):
+            writes.add(key)
+        elif after.startswith(("++", "--")):
+            writes.add(key)
+        elif _RP_ASSIGN_RE.match(after):
+            writes.add(key)
+    return refs, writes, bare
+
+
+def _rp_local(key: str) -> str:
+    return f"_pr_{key}"
+
+
+def _rp_field(key: str) -> str:
+    if key[0] in "gf" and key[1:].isdigit():
+        return f"ctx->{'gpr' if key[0] == 'g' else 'fpr'}[{key[1:]}]"
+    return f"ctx->{key}"
+
+
+def _rp_rewrite(code: str) -> str:
+    def sub(m):
+        if not m.group("arrow"):
+            return m.group(0)
+        fld, idx = m.group("field"), m.group("idx")
+        if fld in ("gpr", "fpr"):
+            return _rp_local(("g" if fld == "gpr" else "f") + str(int(idx)))
+        if fld in ("cr", "xer", "ctr"):
+            return _rp_local(fld)
+        return m.group(0)
+    return _RP_CTX_RE.sub(sub, code)
+
+
+def _rp_rewrite_line(parts) -> str:
+    return "".join(t if c else _rp_rewrite(t) for c, t in parts)
+
+
+def _rp_key_order(key: str):
+    kind = 0 if key[0] == "g" and key[1:].isdigit() else 1 if key[0] == "f" and key[1:].isdigit() else 2
+    return (kind, int(key[1:]) if kind < 2 else ("cr", "xer", "ctr").index(key))
+
+
+def _regpromo(body: list[str]):
+    """Register promotion of one function body (lines without the signature
+    and closing brace). Returns the new body, or None when the function keeps
+    its unpromoted form (_RP_STATS says why)."""
+    if any("_pr_" in ln for ln in body):
+        _RP_STATS["kept: _pr_ name in body"] += 1
+        return None
+    n = len(body)
+    info = []            # per line: (kind, parts, refs, writes, extra)
+    labels = {}
+    promoted = set()
+    for i, raw in enumerate(body):
+        s = raw.strip()
+        lm = s.startswith("loc_") and (_RP_LABEL_RE.match(s) or
+                                       _RP_LABEL_RE.match(re.sub(r"\s*/\*.*?\*/\s*$", "", s)))
+        if lm:
+            if lm.group(1) in labels:
+                _RP_STATS["kept: duplicate label"] += 1
+                return None
+            labels[lm.group(1)] = i
+            info.append(("label", None, set(), set(), None))
+            continue
+        parts = _rp_split_comments(raw)
+        if parts is None:
+            _RP_STATS["kept: comment/literal"] += 1
+            return None
+        code = "".join(t for c, t in parts if not c).strip()
+        if not _rp_balanced(code):
+            _RP_STATS["kept: unbalanced line"] += 1
+            return None
+        if "loc_" in code and _RP_LOC_DEF_RE.search(code):
+            _RP_STATS["kept: label inside a line"] += 1
+            return None
+        if code in ("", ";"):
+            info.append(("nop", parts, set(), set(), None))
+            continue
+        sc = _rp_scan(code)
+        if sc is None:
+            _RP_STATS["kept: unknown ctx field"] += 1
+            return None
+        refs, writes, bare = sc
+        if "goto" in code:
+            gotos = _RP_GOTO_RE.findall(code)
+            if len(re.findall(r"\bgoto\b", code)) != len(gotos):
+                _RP_STATS["kept: goto shape"] += 1
+                return None
+        else:
+            gotos = []
+        if bare:
+            if "switch" in code and re.search(r"\bswitch\b", code):
+                if not _RP_SWITCH_RE.match(code):
+                    _RP_STATS["kept: switch shape"] += 1
+                    return None
+                info.append(("switch", parts, set(), set(), gotos))
+                continue
+            if gotos or _RP_OPAQUE_BAD_RE.search(code):
+                _RP_STATS["kept: control flow in a call line"] += 1
+                return None
+            # A line that hands ctx to a function is kept verbatim around a
+            # full write-back; it falls through unless it ends in a plain return.
+            ends = bool(re.search(r"(?:^|;)\s*return;$", code)) and "{" not in code and "if" not in code
+            info.append(("opaque", parts, set(), set(), not ends))
+            continue
+        kind = None
+        for kname, kre in _RP_KIND_RES:
+            km = kre.match(code)
+            if km:
+                kind = kname
+                break
+        if kind is None:
+            if _RP_BAD_RE.search(code):
+                _RP_STATS["kept: control flow shape"] += 1
+                return None
+            for cm in _RP_CALL_RE.finditer(code):
+                if not _rp_call_ok(cm.group(1)):
+                    _RP_STATS[f"kept: call to {cm.group(1)}"] += 1
+                    return None
+            info.append(("pure", parts, refs, writes, None))
+            promoted |= refs
+            continue
+        cond = km.groupdict().get("cond")
+        if cond is not None:
+            if not _rp_balanced(cond) or _RP_BAD_RE.search(cond):
+                _RP_STATS["kept: condition shape"] += 1
+                return None
+            for cm in _RP_CALL_RE.finditer(cond):
+                if not _rp_call_ok(cm.group(1)):
+                    _RP_STATS[f"kept: call to {cm.group(1)}"] += 1
+                    return None
+        elif refs:
+            _RP_STATS["kept: registers in a jump"] += 1
+            return None
+        info.append((kind, parts, refs, writes, km))
+        promoted |= refs
+    for k in info:
+        if k[0] in ("goto", "cgoto") and k[4].group("lab") not in labels:
+            _RP_STATS["kept: goto to a missing label"] += 1
+            return None
+        if k[0] == "switch" and any(g not in labels for g in k[4]):
+            _RP_STATS["kept: goto to a missing label"] += 1
+            return None
+    if not promoted:
+        _RP_STATS["unchanged: no register use to promote"] += 1
+        return None
+
+    keys = sorted(promoted, key=_rp_key_order)
+    bit = {k: 1 << j for j, k in enumerate(keys)}
+    allmask = (1 << len(keys)) - 1
+
+    def mask(ks):
+        m = 0
+        for k in ks:
+            m |= bit.get(k, 0)
+        return m
+
+    # May-dirty dataflow: din[i] = keys that may differ from ctx when line i starts.
+    din = [None] * (n + 1)
+    din[0] = 0
+    work = [0]
+    while work:
+        i = work.pop()
+        d = din[i]
+        if i == n:
+            continue
+        kind, parts, refs, writes, extra = info[i]
+        outs = []
+        if kind in ("label", "nop"):
+            outs.append((i + 1, d))
+        elif kind == "pure":
+            outs.append((i + 1, d | mask(writes)))
+        elif kind == "goto":
+            outs.append((labels[extra.group("lab")], d))
+        elif kind == "cgoto":
+            dw = d | mask(writes)
+            outs += [(labels[extra.group("lab")], dw), (i + 1, dw)]
+        elif kind in ("cret", "ctramp"):
+            outs.append((i + 1, d | mask(writes)))
+        elif kind == "opaque":
+            if extra:
+                outs.append((i + 1, 0))
+        elif kind == "switch":
+            outs += [(labels[g], 0) for g in extra]
+        # ret / tramp: no successor
+        for j, dj in outs:
+            if din[j] is None or (din[j] | dj) != din[j]:
+                din[j] = dj if din[j] is None else (din[j] | dj)
+                work.append(j)
+
+    def flush(m):
+        return " ".join(f"{_rp_field(k)} = {_rp_local(k)};" for k in keys if m & bit[k])
+
+    reload_all = " ".join(f"{_rp_local(k)} = {_rp_field(k)};" for k in keys)
+    out = []
+    for t in ("g", "f", "cr", "xer", "ctr"):
+        ks = [k for k in keys if (k[0] == t and k[1:].isdigit()) or k == t]
+        if ks:
+            ty = _RP_TYPE[t]
+            out.append(f"    {ty} " + ", ".join(f"{_rp_local(k)} = {_rp_field(k)}" for k in ks) + ";")
+    for i, raw in enumerate(body):
+        kind, parts, refs, writes, extra = info[i]
+        ind = raw[:len(raw) - len(raw.lstrip())]
+        d = din[i]
+        if d is None:        # unreachable from the entry: no write-back can be needed
+            d = 0
+        if kind in ("label", "nop", "goto"):
+            out.append(raw)
+        elif kind in ("pure", "cgoto"):
+            out.append(_rp_rewrite_line(parts))
+        elif kind in ("ret", "tramp", "cret", "ctramp"):
+            comments = " ".join(t for c, t in parts if c)
+            fl = flush(d | mask(writes))
+            fl = (fl + " ") if fl else ""
+            if kind == "ret":
+                txt = f"{{ {fl}return; }}" if fl else "return;"
+            elif kind == "tramp":
+                txt = f"{{ {fl}g_trampoline_fn = (void(*)(void*)){extra.group('fn')}; return; }}"
+            elif kind == "cret":
+                txt = f"if ({_rp_rewrite(extra.group('cond'))}) {{ {fl}return; }}"
+            else:
+                txt = (f"if ({_rp_rewrite(extra.group('cond'))}) {{ {fl}g_trampoline_fn = "
+                       f"(void(*)(void*)){extra.group('fn')}; return; }}")
+            out.append(ind + txt + (("  " + comments) if comments else ""))
+        elif kind in ("opaque", "switch"):
+            fl = flush(d)
+            if fl:
+                out.append(ind + fl)
+            out.append(raw)
+            if kind == "opaque" and extra:
+                out.append(ind + reload_all)
+    if din[n]:
+        out.append("    " + flush(din[n]))
+    _RP_STATS["promoted"] += 1
+    return out
+
+

+/* ps3_icall_hook: an interposer on every indirect call (bctrl/bctr through a
+ * vtable or function pointer), consulted with the RESOLVED guest target just
+ * before the dispatch. It returns nonzero when it handled the call -- stubbed
+ * it (set r3, nothing else) or dispatched it itself through
+ * ps3_indirect_call_direct (to time it, say) -- and 0 to let the normal
+ * dispatch run. NULL by default: the cost is one load and a predictable
+ * branch per indirect call. A rollback netcode uses it to route the engine's
+ * draw-packet submission to stubs while it re-simulates frames whose picture
+ * is never shown; direct (bl) calls are compiled in and cannot be redirected
+ * this way, so the hook is only a complete cut for targets reached through
+ * vtables. Set it from one thread before the others start calling. */
+typedef int (*ps3_icall_hook_fn)(ppu_context* ctx, uint32_t target);
+extern "C" ps3_icall_hook_fn ps3_icall_hook = NULL;
+static PPU_THREAD_LOCAL int g_icall_nohook;   /* the next dispatch skips the hook */
+extern "C" void ps3_indirect_call_direct(ppu_context* ctx, uint32_t target)
+{
+    g_icall_nohook = 1;
+    ps3_indirect_call_to(ctx, target);
+}

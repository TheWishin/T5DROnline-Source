+/* Patch 0082: the ring space a queued job writes into belongs to its draw
+ * even when the draw then returns without being recorded -- with PS3_STAGE_BLUR=0
+ * the glow composite of Tekken 5's City at Sunset (stage 4) does that every
+ * frame (sink_end_impl skips it after the vertex fetch), and a dropped PSO or a
+ * debug skip can too. The cursors only advance when a draw is recorded, so the
+ * next draw used to reserve the same bytes: two jobs wrote one place, and when
+ * the skipped one finished last (one vertex worker: below 24 logical
+ * processors, or power saving) the next draw -- there, the full-screen copy of the 3D picture
+ * into the display buffer -- got its vertices and indices: a black picture with
+ * the HUD on it, sometimes a sliver of the scene, for one frame (7-17 in 6 s).
+ * sink_end now keeps such space: the cursors move past it as if the draw had
+ * been recorded. */
+static struct { int armed; u8* map; u32 vb_off, ib_off; u64 vb, ib; } g_vj_res;
+static u64 g_vj_res_kept;
+static void ld_vjob_reserve_keep(void)
+{
+    if (!g_vj_res.armed) return;
+    g_vj_res.armed = 0;
+    static int on = -1;   /* RSX_VERTEX_KEEP_SKIPPED=0: as before patch 0082 (tests) */
+    if (on < 0) { const char* e = getenv("RSX_VERTEX_KEEP_SKIPPED"); on = !(e && e[0] == '0'); }
+    if (!on) return;
+    /* the same ring, cursors where the job's space starts (nothing reset them) */
+    if (g.vb_mapped != g_vj_res.map || g.vb_used != g_vj_res.vb_off || g.ib_used != g_vj_res.ib_off) return;
+    g.vb_used += (u32)g_vj_res.vb;
+    g.ib_used += (u32)g_vj_res.ib;
+    if (g_vj_res_kept++ == 0)
+        fprintf(stderr, "[rsx-vertex] a draw ended after its vertex job was queued (frame %u): its ring space "
+                        "is kept, the next draw gets its own (patch 0082)\n", g_ld_frames);
+}

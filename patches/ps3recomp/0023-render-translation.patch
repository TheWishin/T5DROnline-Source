+            D3D12_GRAPHICS_PIPELINE_STATE_DESC pd;
+            ld_prewarm_build_desc(&r, buf, buf + r.vs_len, il, &pd);
+            ID3D12PipelineState* pso = NULL;
+            if (SUCCEEDED(ld_pso_create(&pd, r.name_hi, r.name_lo, &pso)) && pso) {
+                InterlockedExchangePointer((PVOID volatile*)&s->pso, pso);
+                InterlockedIncrement64(&g_prewarm_created);
+                n++;
+            } else failed++;
+        }
+        free(buf);
+    } else if (f) {
+        fclose(f); f = NULL;
+        DeleteFileA(g_prewarm_path);   /* another build's pipelines */
+    }
+    if (f) fclose(f);

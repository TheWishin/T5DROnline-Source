+/* ---- GPU time per pass (patch 0051, RSX_GPU_PASSES=1) ---------------------
+ * A timestamp at every boundary of GPU work in a command list -- a draw pass
+ * (render target + zeta bound), a clear, a copy, the depth snapshot compute,
+ * the stage filter's guest-size view, the present -- labelled with what
+ * starts there. Each interval (one timestamp to the next in the same list) is
+ * charged to its label: GPU time, measured where the GPU finished the work
+ * before (a timestamp waits for everything before it). Every 600 frames:
+ *   [gpu-pass] 600 frames, 1.23 ms GPU per frame in 2.0 lists; per frame:
+ *   pass 0x017F0000 3072x2160 fp16 z 0x02330000: 0.80 ms (1.0x, 412 draws) ...
+ * No CPU wait: results are read once their fence passed. Off by default (a
+ * few hundred timestamps a frame). */
+enum { GP_LIST = 0, GP_PASS, GP_CLEAR, GP_ZCLEAR, GP_UPLOAD, GP_FEEDBACK, GP_SURFCOPY, GP_GUESTVIEW,
+       GP_DEPTHSNAP, GP_PRESENT, GP_MOVIE, GP_OTHER, GP_KINDS };
+static const char* const k_gp_kind[GP_KINDS] = {
+    "list start", "pass", "clear", "zclear", "upload", "feedback copy", "surface copy", "guest view",
+    "depth snapshot", "present", "movie", "other" };
+#define GP_CAP 16384u
+#define GP_LISTS 64u
+typedef struct { u8 kind, fp16, mrt; u32 a, b; u32 w, h; } gp_label;
+typedef struct { u8 kind, fp16, mrt; u32 a, b, w, h; u64 ticks, n, draws; } gp_acc;
+static struct {
+    int on;                          /* -1 unknown, 0 off, 1 on */
+    ID3D12QueryHeap* heap;
+    ID3D12Resource* rb;
+    const u64* rbp;
+    double ms_per_tick;
+    u64 head;                        /* next timestamp index (monotonic) */
+    gp_label lab[GP_CAP];
+    u32 draws[GP_CAP];               /* draws recorded under each mark */
+    u64 cur;                         /* index of the open mark (for draw counts) */
+    int open;
+    u64 list_start;
+    u64 pend_start[GP_LISTS], pend_n[GP_LISTS], pend_fence[GP_LISTS];
+    u32 pend_head, pend_tail;
+    u32 last_key;                    /* the pass now bound (target | zslot | mrt) */
+    gp_acc acc[256];
+    u32 n_acc;
+    u64 total_ticks, lists, frames0;
+} g_gp = { -1 };
+
+static void ld_gp_init(void)
+{
+    if (g_gp.on >= 0) return;
+    g_gp.on = 0;
+    const char* e = getenv("RSX_GPU_PASSES");
+    if (!(e && *e && *e != '0')) return;
+    UINT64 freq = 0;
+    if (!g.queue || FAILED(g.queue->lpVtbl->GetTimestampFrequency(g.queue, &freq)) || !freq) return;
+    D3D12_QUERY_HEAP_DESC qd = {0};
+    qd.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+    qd.Count = GP_CAP;
+    if (FAILED(g.dev->lpVtbl->CreateQueryHeap(g.dev, &qd, &IID_ID3D12QueryHeap, (void**)&g_gp.heap))) return;
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC rd = {0};
+    rd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    rd.Width = 8ull * GP_CAP; rd.Height = 1; rd.DepthOrArraySize = 1; rd.MipLevels = 1;
+    rd.SampleDesc.Count = 1; rd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    void* p = NULL;
+    if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+                   D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&g_gp.rb)) ||
+        FAILED(g_gp.rb->lpVtbl->Map(g_gp.rb, 0, NULL, &p)) || !p) {
+        g_gp.heap->lpVtbl->Release(g_gp.heap); g_gp.heap = NULL;
+        return;
+    }
+    g_gp.rbp = (const u64*)p;
+    g_gp.ms_per_tick = 1000.0 / (double)freq;
+    g_gp.last_key = ~0u;
+    g_gp.on = 1;
+    fprintf(stderr, "[gpu-pass] per-pass timestamps on (RSX_GPU_PASSES)\n");
+}
+static void ld_gp_harvest(void);
+static void ld_gp_mark(u32 kind, u32 a, u32 b, u32 w, u32 h, int fp16, u32 mrt)
+{
+    if (g_gp.on <= 0 || !g_gp.open) return;
+    if (g_gp.head - g_gp.list_start >= GP_CAP / 4) return;          /* a runaway list: stop marking it */
+    if (g_gp.pend_head - g_gp.pend_tail >= GP_LISTS) return;
+    if (g_gp.pend_head != g_gp.pend_tail &&                          /* never over results not read yet */
+        g_gp.head - g_gp.pend_start[g_gp.pend_tail % GP_LISTS] >= GP_CAP - 2) return;
+    const u32 i = (u32)(g_gp.head % GP_CAP);
+    g.list->lpVtbl->EndQuery(g.list, g_gp.heap, D3D12_QUERY_TYPE_TIMESTAMP, i);
+    gp_label* L = &g_gp.lab[i];
+    L->kind = (u8)kind; L->a = a; L->b = b; L->w = w; L->h = h; L->fp16 = (u8)fp16; L->mrt = (u8)mrt;
+    g_gp.draws[i] = 0;
+    g_gp.cur = g_gp.head;
+    g_gp.head++;
+    if (kind != GP_PASS) g_gp.last_key = ~0u;
+}
+static void ld_gp_list_begin(void)
+{
+    if (g_gp.on < 0) ld_gp_init();
+    g_gp.open = 0;
+    if (g_gp.on <= 0) return;
+    ld_gp_harvest();
+    if (g_gp.pend_head - g_gp.pend_tail >= GP_LISTS) return;
+    g_gp.open = 1;
+    g_gp.list_start = g_gp.head;
+    ld_gp_mark(GP_LIST, 0, 0, 0, 0, 0, 0);
+}
+/* Before Close: the closing stamp, then resolve this list's range. */
+static int ld_gp_list_end(void)
+{
+    if (g_gp.on <= 0 || !g_gp.open) return -1;
+    ld_gp_mark(GP_OTHER, 0, 0, 0, 0, 0, 0);
+    g_gp.open = 0;
+    const u64 s = g_gp.list_start, n = g_gp.head - s;
+    const u32 i0 = (u32)(s % GP_CAP);
+    if (i0 + n <= GP_CAP) {
+        g.list->lpVtbl->ResolveQueryData(g.list, g_gp.heap, D3D12_QUERY_TYPE_TIMESTAMP, i0, (UINT)n, g_gp.rb, 8ull * i0);
+    } else {
+        const u32 n1 = GP_CAP - i0;
+        g.list->lpVtbl->ResolveQueryData(g.list, g_gp.heap, D3D12_QUERY_TYPE_TIMESTAMP, i0, n1, g_gp.rb, 8ull * i0);
+        g.list->lpVtbl->ResolveQueryData(g.list, g_gp.heap, D3D12_QUERY_TYPE_TIMESTAMP, 0, (UINT)(n - n1), g_gp.rb, 0);
+    }
+    const u32 k = g_gp.pend_head % GP_LISTS;
+    g_gp.pend_start[k] = s; g_gp.pend_n[k] = n; g_gp.pend_fence[k] = 0;
+    g_gp.pend_head++;
+    return (int)k;
+}
+static void ld_gp_submitted(int k, u64 fence_value)
+{
+    if (k >= 0) g_gp.pend_fence[k] = fence_value;
+}
+static void ld_gp_note_draw(void)
+{
+    if (g_gp.on > 0 && g_gp.open) g_gp.draws[g_gp.cur % GP_CAP]++;
+}
+/* a draw pass begins when the bound target, zeta or MRT count changes */
+static void ld_gp_pass(u32 target, u32 zslot, u32 n_mrt)
+{
+    if (g_gp.on <= 0 || !g_gp.open) return;
+    const u32 key = (target & 0xFFFu) | (zslot & 0xFFFu) << 12 | (n_mrt & 0xFu) << 24;
+    if (key == g_gp.last_key) return;
+    const surface_t* s = &g.surfaces[target];
+    const u32 zoff = zslot ? g.zdepths[zslot - 1].offset : 0;
+    ld_gp_mark(GP_PASS, s->offset, zslot ? zoff : 0xFFFFFFFFu, s->pw, s->ph,
+               s->fmt == DXGI_FORMAT_R16G16B16A16_FLOAT, n_mrt);
+    g_gp.last_key = key;
+}
+static void ld_gp_harvest(void)
+{
+    if (g_gp.on <= 0) return;
+    const u64 done = g.fence->lpVtbl->GetCompletedValue(g.fence);
+    while (g_gp.pend_tail != g_gp.pend_head) {
+        const u32 k = g_gp.pend_tail % GP_LISTS;
+        if (!g_gp.pend_fence[k] || g_gp.pend_fence[k] > done) break;
+        const u64 s = g_gp.pend_start[k], n = g_gp.pend_n[k];
+        for (u64 j = 0; j + 1 < n; j++) {
+            const u32 i = (u32)((s + j) % GP_CAP), i1 = (u32)((s + j + 1) % GP_CAP);
+            const u64 t0 = g_gp.rbp[i], t1 = g_gp.rbp[i1];
+            if (t1 <= t0) continue;
+            const gp_label* L = &g_gp.lab[i];
+            u32 a = 0;
+            for (; a < g_gp.n_acc; a++) {
+                const gp_acc* A = &g_gp.acc[a];
+                if (A->kind == L->kind && A->a == L->a && A->b == L->b && A->w == L->w && A->h == L->h &&
+                    A->fp16 == L->fp16 && A->mrt == L->mrt) break;
+            }
+            if (a == g_gp.n_acc) {
+                if (g_gp.n_acc >= 256) a = 255;        /* the last slot collects the rest */
+                else {
+                    gp_acc* A = &g_gp.acc[g_gp.n_acc++];
+                    memset(A, 0, sizeof *A);
+                    A->kind = L->kind; A->a = L->a; A->b = L->b; A->w = L->w; A->h = L->h;
+                    A->fp16 = L->fp16; A->mrt = L->mrt;
+                }
+            }
+            g_gp.acc[a].ticks += t1 - t0;
+            g_gp.acc[a].n++;
+            g_gp.acc[a].draws += g_gp.draws[i];
+            g_gp.total_ticks += t1 - t0;
+        }
+        g_gp.lists++;
+        g_gp.pend_tail++;
+    }
+}
+static int gp_cmp(const void* x, const void* y)
+{
+    const gp_acc* a = (const gp_acc*)x; const gp_acc* b = (const gp_acc*)y;
+    return a->ticks < b->ticks ? 1 : a->ticks > b->ticks ? -1 : 0;
+}
+static void ld_gp_report(u32 frames_now)
+{
+    if (g_gp.on <= 0) return;
+    ld_gp_harvest();
+    const u32 frames = frames_now - (u32)g_gp.frames0;
+    if (!frames || !g_gp.lists) return;
+    qsort(g_gp.acc, g_gp.n_acc, sizeof(gp_acc), gp_cmp);
+    fprintf(stderr, "[gpu-pass] %u frames, %.3f ms GPU per frame in %.1f lists; per frame:", frames,
+            (double)g_gp.total_ticks * g_gp.ms_per_tick / frames, (double)g_gp.lists / frames);
+    for (u32 a = 0; a < g_gp.n_acc && a < 14; a++) {
+        const gp_acc* A = &g_gp.acc[a];
+        const double ms = (double)A->ticks * g_gp.ms_per_tick / frames;
+        if (ms < 0.005) break;
+        fprintf(stderr, " | %s", k_gp_kind[A->kind]);
+        if (A->kind == GP_PASS || A->kind == GP_CLEAR || A->kind == GP_FEEDBACK || A->kind == GP_SURFCOPY ||
+            A->kind == GP_GUESTVIEW)
+            fprintf(stderr, " 0x%08X %ux%u %s", A->a, A->w, A->h, A->fp16 ? "fp16" : "rgba8");
+        if (A->kind == GP_PASS && A->b != 0xFFFFFFFFu) fprintf(stderr, " z 0x%08X", A->b);
+        if (A->kind == GP_PASS && A->mrt > 1) fprintf(stderr, " mrt %u", A->mrt);
+        if (A->kind == GP_PRESENT || A->kind == GP_DEPTHSNAP || A->kind == GP_ZCLEAR) fprintf(stderr, " %ux%u", A->w, A->h);
+        fprintf(stderr, ": %.3f ms (%.1fx", ms, (double)A->n / frames);
+        if (A->draws) fprintf(stderr, ", %.0f draws", (double)A->draws / frames);
+        fprintf(stderr, ")");
+    }
+    fprintf(stderr, "\n");
+    g_gp.n_acc = 0; g_gp.total_ticks = 0; g_gp.lists = 0; g_gp.frames0 = frames_now;
+}

+    }
+    printf("int conversions: %ld differ from nearbyint/trunc\n", bad);
+    fails += bad != 0;
+    bad = 0;
+    for (long i = 0; i < n / 10; i++) {
+        double v;
+        switch (i % 4) {
+        case 0: v = gd(0, 0, 0); break;
+        case 1: v = gd(1, 1023 + 31, 2); break;                                   /* around 2^31 */
+        case 2: v = gd(1, 1023 + 63, 2); break;                                   /* around 2^63 */
+        default: { static const double e[] = { 2147483647.0, 2147483647.5, 2147483646.5, 2147483646.7, 2147483648.0,
+                   -2147483648.0, -2147483648.5, -2147483647.5, -2147483648.4, -2147483649.0, 9223372036854775807.0,
+                   -9223372036854775808.0, 0.5, -0.5, 1.5, -1.5, 2.5, INFINITY, -INFINITY, NAN };
+                   v = e[(i / 4) % (sizeof e / sizeof e[0])]; if (rnd() & 1) v = d_of(u_of(v) + (rnd() % 3) - 1); }
+        }
+        for (int rn = 0; rn < 2; rn++)
+            if (old_f2i32(v, rn) != new_f2i32(v, rn) || old_f2i64(v, rn) != new_f2i64(v, rn)) {
+                if (bad++ < 3) printf("  f2i(%a, rn=%d): old %08X/%016llX new %08X/%016llX\n", v, rn, old_f2i32(v, rn),
+                                      (unsigned long long)old_f2i64(v, rn), new_f2i32(v, rn), (unsigned long long)new_f2i64(v, rn));
+            }
+    }
+    printf("lifter fctiw/fctid helpers: %ld differ between the C library version and the new one\n", bad);
+    fails += bad != 0;
+
+    /* 5. sqrt */
+    bad = 0;
+    for (long i = 0; i < n / 10; i++) {
+        double v = gd(0, 0, 0);
+        double a = sqrt(v), b = ppu_sqrt_det(v);
+        if (u_of(a) != u_of(b) && !(isnan64(u_of(a)) && isnan64(u_of(b)))) bad++;
+    }
+    printf("sqrt: %ld differ from the C library (NaN payloads aside)\n", bad);
+    fails += bad != 0;
+
+    /* 6. the VMX estimates: exp2f/log2f, error against the C library, all floats */
+    double maxe = 0, maxl = 0; long ne = 0, nl = 0;
+    uint32_t u = 0;
+    do {
+        float x; memcpy(&x, &u, 4);
+        float a = exp2f(x), b = ppu_exp2f_det(x);
+        uint32_t ua, ub; memcpy(&ua, &a, 4); memcpy(&ub, &b, 4);
+        if (ua != ub && !(isnan32(ua) && isnan32(ub))) {
+            ne++;
+            double d = fabs((double)(int32_t)ua - (double)(int32_t)ub);
+            if (d > maxe) maxe = d;
+        }
+        a = log2f(x); b = ppu_log2f_det(x);
+        memcpy(&ua, &a, 4); memcpy(&ub, &b, 4);
+        if (ua != ub && !(isnan32(ua) && isnan32(ub))) {
+            nl++;
+            double d = fabs((double)(int32_t)ua - (double)(int32_t)ub);
+            if (d > maxl) maxl = d;
+        }
+    } while (++u);
+    printf("exp2f: %ld of 2^32 differ from the C library, at most %.0f ulp; log2f: %ld differ, at most %.0f ulp\n",
+           ne, maxe, nl, maxl);
+    fails += maxe > 1 || maxl > 1;
+    printf(fails ? "FAIL\n" : "PASS\n");
+    return fails != 0;
+}

+    D3D12_RANGE rr = {0, (SIZE_T)pitch * height};
+    if (SUCCEEDED(rb->lpVtbl->Map(rb, 0, &rr, (void**)&px))) {
+        FILE* o = fopen(outp, "wb");
+        if (o) {
+            fprintf(o, "P6\n%u %u\n255\n", width, height);
+            for (u32 y = 0; y < height; y++)

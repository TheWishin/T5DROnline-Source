+        const u32 base_index = rsx_dsp_vertex_data_base_index(&g.rsx);
+        rsx_dsp_index_array ia; rsx_dsp_get_index_array(&g.rsx, &ia);
+        const u32 esz = ia.is_u32 ? 4 : 2;
+        const int restart_en = rsx_dsp_restart_index_enabled(&g.rsx, ia.is_u32);
+        const u32 restart_val = rsx_dsp_restart_index(&g.rsx);
+        for (u32 r = 0; r < dc.n_idx; r++)
+            for (u32 i = 0; i < dc.idx[r].count; i++) {
+                const u8* ip = guest_ptr(ia.location, ia.offset + (dc.idx[r].first + i) * esz, esz);
+                if (!ip) return 0;
+                const u32 index = ia.is_u32 ? (((u32)ip[0] << 24) | ((u32)ip[1] << 16) | ((u32)ip[2] << 8) | ip[3])
+                                            : (u32)((ip[0] << 8) | ip[1]);
+                if (restart_en && index == restart_val) continue;
+                if (n >= 64) return 0;
+                ids[n] = index; bidx[n] = base_index; n++;
+            }
+    }
+    const u32 base = rsx_dsp_vertex_data_base_offset(&g.rsx);
+    for (u32 k = 0; k < n; k++)

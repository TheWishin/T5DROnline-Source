+/* Windows "N" editions ship without Media Foundation until the Media Feature
+ * Pack is installed. The port links mfplat.dll delay-loaded (/DELAYLOAD, the
+ * port's CMakeLists.txt), so t5dr.exe still starts there; this check keeps
+ * the first MF call from faulting -- the decoder reports itself unavailable
+ * and the movies stay black, with sound and timing as usual (patch 0031).
+ * PS3_TEST_NO_MEDIA_FOUNDATION=1 tests that path on a PC that has it. */
+static bool mf_present(void)
+{
+    static int present = -1;
+    if (present < 0) {
+        present = !getenv("PS3_TEST_NO_MEDIA_FOUNDATION") &&
+                  LoadLibraryExW(L"mfplat.dll", NULL, LOAD_LIBRARY_SEARCH_SYSTEM32) != NULL;
+        if (!present)
+            fprintf(stderr, "[mf_h264] Windows Media Foundation (mfplat.dll) is not installed -- "
+                            "movies stay black (Windows N edition: install the Media Feature Pack)\n");
+    }
+    return present != 0;
+}

+/* DirectInput devices on probation: read here (they are on no port, nothing else reads them); one that read
+ * well and was found DI_PROBATION_MS ago gets a port at the next assign_ports. 1 = some are still on it. */
+static void di_probation_reads(void)
+{
+    const LONGLONG now = qpc_now();
+    AcquireSRWLockShared(&g_dev_lock);
+    for (int i = 0; i < MAX_DEVS; i++) {
+        PadDev* d = &g_dev[i];
+        if (d->kind != DEV_DINPUT || !d->probation || d->lost) continue;
+        RawState r;
+        if (!dev_read(d, &r)) continue;                   /* lost: dropped and counted by assign_ports */
+        if (now - d->found_t >= qpc_from_us((u64)DI_PROBATION_MS * 1000u)) d->probation = 0;
+    }
+    ReleaseSRWLockShared(&g_dev_lock);
+}
+
+/* One pass of the hot-plug thread; the milliseconds to wait before the next. */
+static DWORD hotplug_tick(UINT* last_raw)
+{
+    xi_scan();
+    di_probation_reads();
+    /* DInput enumeration is slow (milliseconds); only when the system's
+     * input device list changed, or when a device was lost. */
+    UINT raw = raw_device_count();
+    int lost = 0;
+    for (int i = 0; i < MAX_DEVS; i++)
+        if ((g_dev[i].kind == DEV_DINPUT && g_dev[i].lost) || (g_dev[i].kind == DEV_HID && (g_dev[i].lost || g_dev[i].hid->dead)))
+            lost = 1;
+    /* Lost DirectInput devices go before the scan, so one that just made its last flap is not created again
+     * (HID ones stay for hid_scan, which counts a dead reader of a pad still there). */
+    AcquireSRWLockExclusive(&g_dev_lock);
+    drop_lost(1);
+    ReleaseSRWLockExclusive(&g_dev_lock);
+    /* HID first: DirectInput then leaves the PlayStation pads it reads alone */
+    if ((g_cfg.dinput || g_cfg.hid) && (raw != *last_raw || lost)) { *last_raw = raw; hid_scan(); di_scan(); }
+    else if (g_cfg.hid && g_cfg.hid_fake[0]) hid_scan();       /* the fake pad's file may (re)appear */
+    AcquireSRWLockExclusive(&g_dev_lock);
+    assign_ports();
+    int probation = 0;
+    for (int i = 0; i < MAX_DEVS; i++) if (g_dev[i].kind == DEV_DINPUT && g_dev[i].probation) probation = 1;
+    ReleaseSRWLockExclusive(&g_dev_lock);
+    return probation ? 100 : 500;                              /* a found pad gets its port ~DI_PROBATION_MS later */
+}

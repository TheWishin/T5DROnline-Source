+/* Patch 0123 test hook: RSX_TEST_GPU_HOLD_MS=<ms> -- every list waits in the queue (a GPU-side Wait on
+ * a fence a helper thread signals <ms> after the submit) before the GPU may start it: a graphics card
+ * or driver that starts frames late while it has nothing else to do, on a fast GPU. [slow-frames]
+ * then shows the hold and its verdict (with RSX_TEST_DISPLAY_HZ=75, the vsync fallback). Test only. */
+static int g_ld_th_ms = -1;
+static ID3D12Fence* g_ld_th_fence;
+static HANDLE g_ld_th_event;
+static volatile LONG64 g_ld_th_req[64];       /* due QPC of hold value n at [n % 64] */
+static volatile LONG64 g_ld_th_next = 0, g_ld_th_signalled = 0;
+static DWORD WINAPI ld_th_thread(LPVOID p)
+{
+    (void)p;
+    for (;;) {
+        WaitForSingleObject(g_ld_th_event, 5);
+        for (;;) {

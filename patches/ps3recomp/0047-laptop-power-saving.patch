+/* A mobile processor by its marketing name: a model number with a mobile
+ * suffix (7840U, 6800H, 8845HS, 7945HX, 7700HQ, 1165G7, 1260P, 8100Y, Core
+ * Ultra 155H/258V), Ryzen Z1/Z2 (handhelds) and Ryzen AI, Intel N100-style
+ * parts. Desktop suffixes (K, F, X, X3D, G, T, none) are not. */
+static int hs_mobile_cpu_name(const char* s)
+{
+    char tok[32];
+    int ryzen = strstr(s, "Ryzen") != NULL;
+    if (ryzen && (strstr(s, "Ryzen Z") || strstr(s, "Ryzen AI"))) return 1;
+    for (const char* p = s; *p; ) {
+        while (*p == ' ' || *p == '-' || *p == '(' || *p == ')') p++;
+        int k = 0;
+        while (*p && *p != ' ' && *p != '-' && *p != '(' && *p != ')' && k < 31) tok[k++] = *p++;
+        tok[k] = 0;
+        while (*p && *p != ' ' && *p != '-') p++;
+        if (!k) continue;
+        int d = 0;
+        while (tok[d] >= '0' && tok[d] <= '9') d++;
+        if (tok[0] == 'N' && k >= 4 && k <= 5) {            /* N100, N200, N4020, N5105 */
+            int nd = 1;
+            while (tok[nd] >= '0' && tok[nd] <= '9') nd++;
+            if (nd == k) return 1;
+        }
+        if (d < 3 || d > 5) continue;
+        const char* suf = tok + d;
+        static const char* const mob[] = { "U", "H", "HS", "HX", "HQ", "HK", "HL", "Y", "P", "V",
+                                           "G1", "G4", "G7" };
+        for (unsigned i = 0; i < sizeof mob / sizeof mob[0]; i++)
+            if (!strcmp(suf, mob[i])) return 1;
+    }
+    return 0;
+}

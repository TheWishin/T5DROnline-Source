+ * cellSpurs_queue_wait_done after the wait. */
+long long cellSpurs_queue_wait_help(uint32_t queue_id)
+{
+    if (!s_spurs_event_queue_n || !jl_spurs_queue(queue_id)) return 0;
+    const long long t0 = jp_on() ? jp_now() : 0;
+    if (jl_help_on() && __atomic_load_n(&s_jl.open, __ATOMIC_ACQUIRE)) {
+        AcquireSRWLockExclusive(&s_jl.lock);
+        if (s_jl.open) {
+            jc_walk* w = s_jl.w;
+            const jc_bins* bins = s_jl.bins;
+            const u32 base = s_jl.base, sz = s_jl.sz, n = s_jl.n;
+            s_jl.busy++;                       /* the walker's close waits for us */
+            ReleaseSRWLockExclusive(&s_jl.lock);
+            extern void spurs_job_keep_ls(int keep);
+            extern int  spurs_job_keeps_ls(void);
+            const int keep = spurs_job_keeps_ls();
+            spurs_job_keep_ls(0);              /* list jobs keep no store */
+            const long ran = jl_drain(w, bins, base, sz, n);
+            spurs_job_keep_ls(keep);
+            AcquireSRWLockExclusive(&s_jl.lock);
+            if (--s_jl.busy == 0) WakeAllConditionVariable(&s_jl.idle);
+            ReleaseSRWLockExclusive(&s_jl.lock);
+            if (t0) {
+                __atomic_fetch_add(&s_jp_help_jobs, ran, __ATOMIC_RELAXED);
+                __atomic_fetch_add(&s_jp_help_t, jp_now() - t0, __ATOMIC_RELAXED);
+            }
+        } else {
+            ReleaseSRWLockExclusive(&s_jl.lock);
+        }
+    }
+    return t0 ? jp_now() : 0;
+}

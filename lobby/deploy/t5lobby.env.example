# T5DR lobby server settings for a PUBLIC instance (systemd: /etc/t5lobby/t5lobby.env,
# Docker: lobby/t5lobby.env). Every variable is optional; the comments give the built-in default.
# Full list: docs/ONLINE.md ("Running your own server") and docs/HOSTING.md.
# Plain KEY=value lines only (systemd EnvironmentFile and docker env_file both read this).

# --- shown to players --------------------------------------------------------------------
T5L_MOTD=Welcome to T5DR Online. Be nice; report cheaters to the server owner.

# --- who may play ------------------------------------------------------------------------
# Accounts (ranked, ratings kept) need TLS on a public server, or passwords cross the net readable.
T5L_ACCOUNTS=1
T5L_GUESTS=1
T5L_GUEST_RANKED=0
# Only pair builds from this list (comma-separated build ids); empty = any build, equal builds pair.
T5L_BUILDS=

# --- TLS (strongly recommended) -------------------------------------------------------------
# systemd + certbot:  /etc/t5lobby/tls/fullchain.pem and privkey.pem (the deploy hook copies them)
# Docker:            /tls/cert.pem and /tls/key.pem (./tls next to compose.yaml)
# The server reloads the files when they change (renewals need no restart).
#T5L_TLS_CERT=/etc/t5lobby/tls/fullchain.pem
#T5L_TLS_KEY=/etc/t5lobby/tls/privkey.pem

# --- privacy: relay every match (players never learn each other's IP address) ---------------
# Costs ~170 kbit/s of server bandwidth per match in each direction and the detour via the server.
T5L_FORCE_RELAY=0

# --- regional relays (docs/HOSTING.md "Adding a relay server") ------------------------------
# Central server: relay-only nodes in other regions; a match that needs a relay takes the one with the
# smallest sum of both players' round trips (this server's own relay included). Edits of the file are
# picked up within seconds, no restart. T5L_RELAY=0 keeps this server's own relay out of the choice.
#T5L_RELAYS=/etc/t5lobby/relays.json
# Health check of every node this often; a node that has not answered this long gets no new matches.
#T5L_RELAY_CHECK_SECONDS=5
#T5L_RELAY_DEAD_SECONDS=20
# Relay node (install.sh --relay-only sets these): the secret it shares with the central server, its id in
# the central's relays.json, and optionally the central server's address (control packets from anywhere
# else are dropped; the secret is checked either way).
#T5L_RELAY_SECRET_FILE=/etc/t5lobby/relay.secret
#T5L_RELAY_ID=usw
#T5L_RELAY_CENTRAL=
# Relay node: seconds a session's bind tokens work after the central server opened it.
#T5L_RELAY_BIND_SECONDS=60

# --- capacity and abuse limits (reviewed for a public server) -------------------------------
# A small VPS (2 vCPU, 2-4 GB) carries this comfortably; see the estimate in docs/HOSTING.md.
T5L_MAX_CLIENTS=500
# Concurrent connections per address. Mobile carriers put many players behind one address
# (carrier-grade NAT); 8 is a compromise. Raise for LAN events.
T5L_MAX_PER_IP=8
# New connections per address: one per 2 s after a burst of 10.
T5L_CONN_RATE=0.5
T5L_CONN_BURST=10
# Relay caps per player (the game sends ~60 packets/s, ~85 kbit/s): 3x headroom, not a traffic cannon.
T5L_RELAY_KBPS=256
T5L_RELAY_PPS=240
# Concurrent relayed matches (each ~2 x 85 kbit/s per direction, ~0.3% of a fast core).
T5L_MAX_RELAYS=100
# Server-addressed UDP packets per second from everybody together (pings, registrations).
T5L_UDP_CTL_PPS=5000
# A client that stops reading is dropped once this much output is queued for it.
T5L_MAX_PENDING_KB=1024
# File with extra words refused in names (one per line, matched case-insensitively inside names).
#T5L_NAME_BLOCKLIST=/etc/t5lobby/name-blocklist.txt
# Launch hardening (docs/HOSTING.md "Abuse protection"); the built-in defaults are meant for a public server.
# Connections that have not logged in yet, all addresses together; seconds for a TLS handshake.
#T5L_MAX_PRELOGIN=100
#T5L_TLS_HANDSHAKE_TIMEOUT=10
# Leaderboard/profile/history/full-list requests, and lobby-list-changing requests, per connection.
#T5L_HEAVY_RATE=1
#T5L_HEAVY_BURST=10
#T5L_STATE_RATE=2
#T5L_STATE_BURST=20
# Chat lines per second for the whole lobby (every line goes to every player).
#T5L_CHAT_TOTAL_RATE=20
# Password hashes (scrypt, ~16 MB each) at once, and waiting; more -> "server busy, try again".
#T5L_PW_CONCURRENCY=2
#T5L_PW_QUEUE=64
# Relay: largest packet (netplay's own maximum), longest match it serves, sessions per address.
#T5L_RELAY_MAX_BYTES=2048
#T5L_RELAY_MAX_SECONDS=1200
#T5L_MAX_RELAYS_PER_IP=3
# Ranked between two accounts on one internet address counts (1 for a LAN event; 0 stops alt farming).
#T5L_RANKED_SAME_IP=0
# A lone result does not count against an opponent who is online before this many seconds of match.
#T5L_MAX_MATCH_SECONDS=420
# Disputed ranked results per account in 24 h; from then on that account loses disputes (0 = off).
#T5L_DISPUTE_LIMIT=3

# --- matchmaking extras (docs/RANKED.md, "Tekken 6 style options") ------------------------------
# A queue match shows only the ping until both players accepted; they have this many seconds to answer.
#T5L_BLIND_READY=1
#T5L_READY_TIMEOUT=15
# Strict matchmaking is an option players switch on: ranked pairs stay within this many rating points.
#T5L_STRICT_RANGE=150
# Region first: a queue pair's estimated ping (the best relay path) must fit a window that starts here (ms), grows
# while both wait (ms per second; quick faster), and is gone after so many seconds (any opponent then; 0 = never).
#T5L_PING_START=80
#T5L_PING_WIDEN=10
#T5L_PING_ANY_SECONDS=60
#T5L_QUICK_PING_WIDEN=20
#T5L_QUICK_PING_ANY_SECONDS=30
# Seconds before the ranked queue matches the same two players again (0 = off).
#T5L_PAIR_COOLDOWN=30
# 1 = the stage drawn for a match may also be one of the 15 Tekken 5 stages (t5s01..t5s15) when both launchers know
# them (1.1.2 or newer, cap "old_stages"); older launchers always get the stage select's own stages (docs/RANKED.md
# "Characters and stages").
#T5L_OLD_STAGES=0
# Blocked players per account or guest session.
#T5L_MAX_BLOCKS=200
# Friends (accounts only, docs/ONLINE.md "Friends and invites"): friends per account, requests sent per 24 h, requests
# waiting at once (per sender and per receiver), days before an unanswered request runs out, days before a declined
# one may be sent again, seconds an invite waits for its answer; friend requests per 24 h from one internet address
# (all its accounts; 0 = no limit); seconds before the same player may invite or challenge the same player again after
# a no or a take-back (0 = off).
#T5L_MAX_FRIENDS=100
#T5L_FRIEND_REQUESTS_DAY=20
#T5L_FRIEND_PENDING=30
#T5L_FRIEND_REQUEST_DAYS=14
#T5L_FRIEND_RETRY_DAYS=7
#T5L_INVITE_SECONDS=60
#T5L_FRIEND_REQUESTS_ADDRESS=60
#T5L_INVITE_RETRY_SECONDS=30
# Post-game lag check: extra frames of waiting before it says "more than the ping explains",
# and seconds it waits for the second player's report.
#T5L_LAG_TOLERANCE=1
#T5L_LAG_WAIT=6
# Server notices: `t5lobby-admin notice "server restart in 20 min"` (picked up within T5L_ADMIN_POLL seconds).
# After a release is PUBLISHED: `t5lobby-admin release 1.1.2` tells launchers of an older release to update.

# --- operations ---------------------------------------------------------------------------
T5L_LOG_LEVEL=INFO
# Status/health/metrics endpoint: keep it on loopback (docs/HOSTING.md "Monitoring").
T5L_STATUS_HOST=127.0.0.1
T5L_STATUS_PORT=7780
T5L_STATUS_LOG_MINUTES=15
# Built-in online backups (systemd: /var/lib/t5lobby/backups, Docker: /data/backups).
T5L_BACKUP_HOURS=24
T5L_BACKUP_KEEP=14

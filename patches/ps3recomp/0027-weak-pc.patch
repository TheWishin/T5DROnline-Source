diff --git a/runtime/spu/tests/test_spu_fast_float.c b/runtime/spu/tests/test_spu_fast_float.c
new file mode 100644
index 0000000..894794c
--- /dev/null
+++ b/runtime/spu/tests/test_spu_fast_float.c
@@ -0,0 +1,103 @@
+/*
+ * SPU_FAST_FLOAT (spu_helpers.h): the host IEEE single-precision path used for
+ * render-only images (Tekken 5 DR's vertex skinning jobs). For ordinary
+ * operands it must stay within two units in the last place of the exact SPU
+ * emulation (spu_*_ref), whose rounding is truncation; fma rounds twice.
+ *
+ * Build: clang-cl /O2 /DSPU_FAST_FLOAT -msse4.1 /I.. test_spu_fast_float.c
+ * Exit code 0 if all passed.
+ */
+#include "../spu_helpers.h"
+#include <stdio.h>
+#include <string.h>
+
+static int g_pass, g_fail;
+
+static uint32_t rnd(uint64_t* s)
+{
+    *s = *s * 6364136223846793005ull + 1442695040888963407ull;
+    return (uint32_t)(*s >> 32);
+}
+/* A random ordinary single: exponent within +-2^20, either sign. */
+static uint32_t rnd_float(uint64_t* s)
+{
+    const uint32_t r = rnd(s);
+    const uint32_t e = 127u - 20u + (r >> 8) % 41u;
+    return (r & 0x80000000u) | (e << 23) | (rnd(s) & 0x7FFFFFu);
+}
+static float f_of(uint32_t u) { float f; memcpy(&f, &u, 4); return f; }
+
+/* |a - b| in units of b's last place (both ordinary or zero). */
+static double ulps(uint32_t a, uint32_t b)
+{
+    const float fa = f_of(a), fb = f_of(b);
+    if (fa == fb) return 0.0;
+    int e = (int)((b >> 23) & 0xFFu) - 127 - 23;
+    double ulp = 1.0;
+    while (e > 0) { ulp *= 2.0; e--; }
+    while (e < 0) { ulp /= 2.0; e++; }
+    const double d = (double)fa - (double)fb;
+    return (d < 0 ? -d : d) / ulp;
+}
+
+static void check(const char* what, u128 fast, u128 ref, double limit, double* worst)
+{
+    for (int i = 0; i < 4; i++) {
+        const uint32_t r = ref._u32[i];
+        if (((r >> 23) & 0xFFu) == 0 || ((r >> 23) & 0xFFu) == 0xFFu) continue;  /* only ordinary results */
+        const double u = ulps(fast._u32[i], r);
+        if (u > *worst) *worst = u;
+        if (u > limit) {
+            if (g_fail < 10)
+                printf("  FAIL %s: fast %08X ref %08X (%.1f ulp)\n", what, fast._u32[i], r, u);
+            g_fail++;
+        } else {
+            g_pass++;
+        }
+    }
+}
+
+int main(void)
+{
+    printf("SPU fast float (SPU_FAST_FLOAT)\n");
+#ifndef SPU_FAST_FLOAT
+    printf("  built without SPU_FAST_FLOAT: nothing to compare\n");
+    return 1;
+#else
+    uint64_t s = 12345;
+    double w_fa = 0, w_fs = 0, w_fm = 0, w_fma = 0, w_fms = 0, w_fnms = 0;
+    for (int n = 0; n < 200000; n++) {
+        u128 a, b, c;
+        for (int i = 0; i < 4; i++) { a._u32[i] = rnd_float(&s); b._u32[i] = rnd_float(&s); c._u32[i] = rnd_float(&s); }
+        check("fa", spu_fa(a, b), spu_fa_ref(a, b), 2.0, &w_fa);
+        check("fs", spu_fs(a, b), spu_fs_ref(a, b), 2.0, &w_fs);
+        check("fm", spu_fm(a, b), spu_fm_ref(a, b), 2.0, &w_fm);
+        /* fma: compare where the sum does not cancel (|c| below |a*b| / 4 or
+         * above 4 |a*b|) -- under cancellation two roundings and one differ
+         * by more than a few ulp of the small result, as any two-rounding
+         * multiply-add would. */
+        const double p = (double)f_of(a._u32[0]) * (double)f_of(b._u32[0]);
+        const double z = (double)f_of(c._u32[0]);
+        const double ap = p < 0 ? -p : p, az = z < 0 ? -z : z;
+        if (az < ap / 4 || az > ap * 4) {
+            u128 a1 = a, b1 = b, c1 = c;
+            for (int i = 1; i < 4; i++) { a1._u32[i] = a._u32[0]; b1._u32[i] = b._u32[0]; c1._u32[i] = c._u32[0]; }
+            check("fma",  spu_fma(a1, b1, c1),  spu_fma_ref(a1, b1, c1),  3.0, &w_fma);
+            check("fms",  spu_fms(a1, b1, c1),  spu_fms_ref(a1, b1, c1),  3.0, &w_fms);
+            check("fnms", spu_fnms(a1, b1, c1), spu_fnms_ref(a1, b1, c1), 3.0, &w_fnms);
+        }
+    }
+    /* Zero stays zero, signs stay. */
+    {
+        u128 z = { 0 }, one; for (int i = 0; i < 4; i++) one._u32[i] = 0x3F800000u;
+        u128 r = spu_fm(z, one);
+        for (int i = 0; i < 4; i++) { if ((r._u32[i] & 0x7FFFFFFFu) == 0) g_pass++; else { g_fail++; printf("  FAIL 0*1\n"); } }
+        r = spu_fa(one, z);
+        for (int i = 0; i < 4; i++) { if (r._u32[i] == 0x3F800000u) g_pass++; else { g_fail++; printf("  FAIL 1+0\n"); } }
+    }
+    printf("  worst ulp: fa %.1f fs %.1f fm %.1f fma %.1f fms %.1f fnms %.1f\n",
+           w_fa, w_fs, w_fm, w_fma, w_fms, w_fnms);
+    printf("SPU fast float: %d passed, %d failed\n", g_pass, g_fail);
+    return g_fail ? 1 : 0;
+#endif
+}

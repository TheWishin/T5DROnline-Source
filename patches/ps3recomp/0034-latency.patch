+    }
+    /* once a second: is the display at the game's rate? (the DWM clock and
+     * the window's monitor must agree) */
+    void check(ULONGLONG now_ms)
+    {
+        if (!cfg || now_ms - last_check < 1000) return;
+        last_check = now_ms;
+        long long v = 0, p = 0;
+        const int dwm = rsx_live_draw_dwm_vblank(&v, &p);
+        const double hz = dwm && p > 0 ? qpf / (double)p : 0.0;
+        const int want = dwm && rsx_live_draw_display_lockable() && hz > 59.3 && hz < 60.7;
+        if (want != on) {
+            on = want;

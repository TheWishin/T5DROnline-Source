+#define LD_PREWARM_MAGIC   0x31525750u   /* "PWR1" */
+#define LD_PREWARM_SLOTS   8192u
+typedef struct {
+    u32 magic, total_bytes;
+    u64 key, name_hi, name_lo;
+    u32 vs_len, ps_len;
+    u32 n_il;
+    u32 il_index[16], il_offset[16];
+    D3D12_BLEND_DESC blend;
+    D3D12_RASTERIZER_DESC rast;

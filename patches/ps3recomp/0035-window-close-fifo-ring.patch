+/* ---- Patch 0035: file handles under a rollback netcode ----------------------
+ * An open file is host state: a restore of guest memory does not take back an
+ * open, a close or a file position. The title opens and closes its archive in
+ * many frames (stage streaming, the result screen, the select screen); a
+ * rollback that re-ran such a frame opened the file a second time while the
+ * first fd stayed open for good (the restored game had never heard of it), or
+ * closed it twice. In a T5DR rollback session the archive fds climbed one by
+ * one (3/4 -> 5 -> 6 -> 7) and the title's file request manager aborted at a
+ * match end or a fight's loading (NU::File::RequestManager, 0x374150 ->
+ * abort; after 8 matches without any stutter, 2 in 6 with a choppy opponent).
+ *
+ * The rollback layer reports its frame boundaries, how far frames are final
+ * and its restores (ppu_fs_rb_*); while that runs:
+ *   - every open and close is tagged with the frame that does it;
+ *   - a close is held back (the FILE* stays, the fd is not reused) until its
+ *     frame is final;
+ *   - a restore to boundary r closes every file opened in a frame >= r, revives
+ *     every file closed in one, and puts each open file back to its position at
+ *     boundary r -- so the re-run frames get the same fds and positions.
+ * Off by default; nothing changes without a rollback session. */
+#define FS_RB_NONE 0xFFFFFFFFu
+#define FS_RB_HIST 128            /* boundaries whose file positions are kept */
+#define FS_RB_POS  16             /* open files per boundary */
+static std::mutex s_fs_lock;
+static int      s_rb_on = 0;
+static uint32_t s_rb_frame = 0;                 /* the frame running now */
+static uint32_t s_open_frame[FS_MAX];           /* opened in this frame (FS_RB_NONE: before the journal) */
+static uint32_t s_close_frame[FS_MAX];          /* the guest closed it in this frame (FS_RB_NONE: open) */
+struct FsRbPos { uint32_t tag; uint8_t n; uint8_t fd[FS_RB_POS]; long pos[FS_RB_POS]; };
+static FsRbPos  s_rb_pos[FS_RB_HIST];
+static unsigned s_rb_reopened = 0, s_rb_revived = 0;
+
+extern "C" void ppu_fs_rb_enable(int on)
+{
+    std::lock_guard<std::mutex> lk(s_fs_lock);
+    for (int i = 0; i < FS_MAX; i++) {
+        if (!on && s_rb_on && g_files[i] && s_close_frame[i] != FS_RB_NONE) {   /* held-back closes: now */
+            fclose(g_files[i]); g_files[i] = nullptr; g_fd_usm[i] = 0;
+        }
+        s_open_frame[i] = FS_RB_NONE; s_close_frame[i] = FS_RB_NONE;
+    }
+    memset(s_rb_pos, 0, sizeof s_rb_pos);
+    s_rb_on = on;
+}
+
+/* boundary f: frame f runs next; the open files' positions as of now */
+extern "C" void ppu_fs_rb_boundary(uint32_t f)
+{
+    if (!s_rb_on) return;
+    std::lock_guard<std::mutex> lk(s_fs_lock);
+    s_rb_frame = f;
+    FsRbPos& p = s_rb_pos[f % FS_RB_HIST];
+    p.tag = f + 1; p.n = 0;
+    for (int i = 3; i < FS_MAX && p.n < FS_RB_POS; i++)
+        if (g_files[i] && s_close_frame[i] == FS_RB_NONE) { p.fd[p.n] = (uint8_t)i; p.pos[p.n] = ftell(g_files[i]); p.n++; }
+}
+
+/* frames < f are final: the closes held back for them happen now */
+extern "C" void ppu_fs_rb_confirm(uint32_t f)
+{
+    if (!s_rb_on) return;
+    std::lock_guard<std::mutex> lk(s_fs_lock);
+    for (int i = 3; i < FS_MAX; i++) {
+        if (!g_files[i]) continue;
+        if (s_close_frame[i] != FS_RB_NONE && s_close_frame[i] < f) {
+            fclose(g_files[i]); g_files[i] = nullptr; g_fd_usm[i] = 0;
+            s_open_frame[i] = s_close_frame[i] = FS_RB_NONE;
+        } else if (s_open_frame[i] != FS_RB_NONE && s_open_frame[i] < f) {
+            s_open_frame[i] = FS_RB_NONE;
+        }
+    }
+}
+
+/* back to boundary r (the rollback layer restored guest memory to it) */
+extern "C" void ppu_fs_rb_restore(uint32_t r)
+{
+    if (!s_rb_on) return;
+    std::lock_guard<std::mutex> lk(s_fs_lock);
+    for (int i = 3; i < FS_MAX; i++) {
+        if (!g_files[i]) continue;
+        if (s_open_frame[i] != FS_RB_NONE && s_open_frame[i] >= r) {   /* opened in a frame that runs again */
+            fclose(g_files[i]); g_files[i] = nullptr; g_fd_usm[i] = 0;
+            s_open_frame[i] = s_close_frame[i] = FS_RB_NONE;
+            s_rb_reopened++;
+        } else if (s_close_frame[i] != FS_RB_NONE && s_close_frame[i] >= r) {   /* closed in one: open again */
+            s_close_frame[i] = FS_RB_NONE;

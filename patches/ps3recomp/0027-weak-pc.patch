+/* Ranges already found committed. Guest memory is never decommitted or
+ * protected again once committed (vm.h), so a yes stays true. Tekken 5 DR
+ * checks the same skinning job list (384 descriptors) twice a frame on the
+ * walker's path from the kick to the first job, and the VirtualQuery walk
+ * over its pages was ~0.3 ms each time. Entry = start << 32 | last byte. */
+#define JC_COMMITTED_CACHE 16
+static u64 s_jc_committed[JC_COMMITTED_CACHE];
+static u32 s_jc_committed_w;
+
 /* Is [ea, ea+size) committed guest memory? A pure query: unlike the DMA
  * path's mfc_ea_range_committed() it never demand-commits, so a garbage job
  * descriptor cannot conjure zero-filled pages into the guest address space. */
@@ -2208,6 +2217,10 @@ static int jc_guest_range_committed(u32 ea, u32 size)
 {
     if (!size || (u64)ea + size > 0x100000000ull) return 0;
     const u64 end = (u64)ea + size;
+    for (int i = 0; i < JC_COMMITTED_CACHE; i++) {
+        const u64 c = __atomic_load_n(&s_jc_committed[i], __ATOMIC_ACQUIRE);
+        if (c && ea >= (u32)(c >> 32) && end - 1 <= (u32)c) return 1;
+    }
     u64 cur = ea;
     while (cur < end) {
         MEMORY_BASIC_INFORMATION mbi;
@@ -2218,6 +2231,8 @@ static int jc_guest_range_committed(u32 ea, u32 size)
         if (next <= cur) return 0;
         cur = next;
     }
+    const u32 w = __atomic_fetch_add(&s_jc_committed_w, 1u, __ATOMIC_RELAXED) % JC_COMMITTED_CACHE;
+    __atomic_store_n(&s_jc_committed[w], (u64)ea << 32 | (u32)(end - 1), __ATOMIC_RELEASE);
     return 1;
 }
 

diff --git a/libs/video/rsx_always_left.h b/libs/video/rsx_always_left.h
new file mode 100644
index 0000000..6079f35
--- /dev/null
+++ b/libs/video/rsx_always_left.h
@@ -0,0 +1,250 @@
+/*
+ * ps3recomp patch 0086 (T5DR Online "Always left" / "Always right"): the pure part of showing the fight to one
+ * player as if they stood on the other side -- the 3D picture mirrored, the HUD's two halves swapped with every
+ * element readable. Presentation only: nothing here reads or writes guest memory or changes what the game
+ * simulates; the live renderer (rsx_live_draw.c) calls it with the draw's own vertex program, constants and
+ * vertices, and moves or mirrors that draw on the host.
+ *
+ *   al_vp_eval      runs a vertex program (NV40 microcode, the layout rsx_vp_decompiler.c documents) on the CPU
+ *                   for one vertex, with the decompiler's semantics (the legacy 0 * x = 0 multiply, the vector
+ *                   unit's store before the scalar unit reads): the HUD quad's position (o0) and texture
+ *                   coordinate (o7). Straight-line programs only: flow control, an indexed constant or a
+ *                   conditional write -> 0 (the caller leaves that draw alone).
+ *   al_hud_place    where one HUD draw goes. Stateless: decided from this draw's own evaluated box alone, the
+ *                   same way on every frame (no layout of an earlier frame, so nothing can change from one
+ *                   frame to the next or on the first mirrored frame). Tekken 5 DR draws its fight HUD as one
+ *                   draw per quad (measured, T5DR docs/ALWAYS_LEFT_FIX.md): per side a bar frame, two fill
+ *                   layers (life, drain), the name plate, the rank plate, one draw per name glyph; the timer is
+ *                   one quad per digit across the middle. Rule: a draw in the top HUD band (its bottom edge
+ *                   above AL_HUD_BAND of the height) that lies wholly on one side moves by exactly half the
+ *                   width to the other side -- frame, fills, plates and every glyph of a side by the same
+ *                   amount, so each side's HUD arrives whole and in order. Anything across the middle (the
+ *                   timer) and anything below the band (ROUND / FIGHT / K.O. / PERFECT titles, intro text,
+ *                   REPLAY, the winner's name) stays where the game put it: centred or not tied to a player.
+ *                   A draw of more than six vertices across the middle inside the band (independent elements of
+ *                   both sides in one batch; never seen in Tekken 5 DR) is left as it is, never cut.
+ *
+ * T5DR's tests/c/always_left_render_test.c includes this header and checks it with programs and HUDs made for
+ * the test (the shapes of the game's HUD as measured).
+ */
+#ifndef PS3RECOMP_RSX_ALWAYS_LEFT_H
+#define PS3RECOMP_RSX_ALWAYS_LEFT_H
+
+#include <math.h>
+#include <stdint.h>
+#include <string.h>
+
+/* ---- the vertex program on the CPU ------------------------------------------------------------------- */
+
+static uint32_t al_rd_le(const uint8_t* p)
+{
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static float al_mul1(float a, float b) { return (a == 0.0f || b == 0.0f) ? 0.0f : a * b; }
+static float al_u2f(uint32_t u) { float f; memcpy(&f, &u, 4); return f; }
+
+/* one 17-bit source field, read (swizzle, abs, negate) */
+static void al_src(uint32_t src, int is_abs, uint32_t input_src, uint32_t const_src,
+                   const float r[32][4], const float in[16][4], const uint32_t (*c)[4], float out[4])
+{
+    const uint32_t type = src & 3u, tmp = (src >> 2) & 0x3Fu;
+    float base[4];
+    if (type == 2) memcpy(base, in[input_src & 15u], sizeof base);
+    else if (type == 3) for (int k = 0; k < 4; k++) base[k] = al_u2f(c[const_src & 511u][k]);
+    else memcpy(base, r[tmp & 31u], sizeof base);
+    const uint32_t sw[4] = { (src >> 14) & 3u, (src >> 12) & 3u, (src >> 10) & 3u, (src >> 8) & 3u };
+    const int neg = (int)((src >> 16) & 1u);
+    for (int k = 0; k < 4; k++) {
+        float v = base[sw[k]];
+        if (is_abs) v = fabsf(v);
+        out[k] = neg ? -v : v;
+    }
+}
+
+static float al_sat(float v) { return v < 0.0f ? 0.0f : v > 1.0f ? 1.0f : v; }
+
+/* Runs the program at `uc` for one vertex: in[16] = its attributes (float4 each, as the shader gets them),
+ * c = the 512 vec4 constants (bit patterns). out[16][4] = the output registers (o0 = position, o7 = TEX0).
+ * -> 1, or 0 for a program this does not model (the draw is left as it is). */
+static int al_vp_eval(const uint8_t* uc, uint32_t max_bytes, const float in[16][4], const uint32_t (*c)[4],
+                      float out[16][4])
+{
+    float r[32][4];
+    memset(r, 0, sizeof r);
+    for (int i = 0; i < 16; i++) { out[i][0] = out[i][1] = out[i][2] = 0.0f; out[i][3] = 1.0f; }
+    for (uint32_t off = 0, n = 0; off + 16 <= max_bytes && n < 512; off += 16, n++) {
+        const uint32_t d0 = al_rd_le(uc + off), d1 = al_rd_le(uc + off + 4);
+        const uint32_t d2 = al_rd_le(uc + off + 8), d3 = al_rd_le(uc + off + 12);
+        const uint32_t vec_op = (d1 >> 22) & 0x1Fu, sca_op = (d1 >> 27) & 0x1Fu;
+        const uint32_t input_src = (d1 >> 8) & 0xFu, const_src = (d1 >> 12) & 0x3FFu;
+        if ((d3 >> 1) & 1u) return 0;                                   /* indexed constant (ARL) */
+        if (((d0 >> 13) & 1u) && ((d0 >> 10) & 7u) != 7u) return 0;    /* conditional write */
+        if (sca_op == 0x08 || sca_op == 0x09 || sca_op == 0x0A || sca_op == 0x0B || sca_op == 0x0C ||
+            sca_op == 0x11 || sca_op == 0x12 || sca_op > 0x12)
+            return 0;                                                   /* flow control / unknown */
+        const uint32_t src0 = ((d2 >> 23) & 0x1FFu) | ((d1 & 0xFFu) << 9);
+        const uint32_t src1 = (d2 >> 6) & 0x1FFFFu;
+        const uint32_t src2 = ((d3 >> 21) & 0x7FFu) | ((d2 & 0x3Fu) << 11);
+        const int saturate = (int)((d0 >> 26) & 1u), vec_result = (int)((d0 >> 30) & 1u);
+        const uint32_t dst_tmp = (d0 >> 15) & 0x3Fu, dst_out = (d3 >> 2) & 0x1Fu, sca_tmp = (d3 >> 7) & 0x3Fu;
+        const int vm[4] = { (int)((d3 >> 16) & 1u), (int)((d3 >> 15) & 1u), (int)((d3 >> 14) & 1u),
+                            (int)((d3 >> 13) & 1u) };
+        const int sm[4] = { (int)((d3 >> 20) & 1u), (int)((d3 >> 19) & 1u), (int)((d3 >> 18) & 1u),
+                            (int)((d3 >> 17) & 1u) };
+        float A[4], B[4], C[4], v[4];
+        al_src(src0, (int)((d0 >> 21) & 1u), input_src, const_src, r, in, c, A);
+        al_src(src1, (int)((d0 >> 22) & 1u), input_src, const_src, r, in, c, B);
+        al_src(src2, (int)((d0 >> 23) & 1u), input_src, const_src, r, in, c, C);
+        if ((vm[0] | vm[1] | vm[2] | vm[3]) && vec_op) {
+            float d;
+            switch (vec_op) {
+            case 0x01: memcpy(v, A, sizeof v); break;                                          /* MOV */
+            case 0x02: for (int k = 0; k < 4; k++) v[k] = al_mul1(A[k], B[k]); break;           /* MUL */
+            case 0x03: for (int k = 0; k < 4; k++) v[k] = A[k] + C[k]; break;                   /* ADD */
+            case 0x04: for (int k = 0; k < 4; k++) v[k] = al_mul1(A[k], B[k]) + C[k]; break;    /* MAD */
+            case 0x05: d = al_mul1(A[0], B[0]) + al_mul1(A[1], B[1]) + al_mul1(A[2], B[2]);     /* DP3 */
+                       v[0] = v[1] = v[2] = v[3] = d; break;
+            case 0x06: d = al_mul1(A[0], B[0]) + al_mul1(A[1], B[1]) + al_mul1(A[2], B[2]) + B[3]; /* DPH */
+                       v[0] = v[1] = v[2] = v[3] = d; break;
+            case 0x07: d = al_mul1(A[0], B[0]) + al_mul1(A[1], B[1]) + al_mul1(A[2], B[2]) +      /* DP4 */
+                           al_mul1(A[3], B[3]);
+                       v[0] = v[1] = v[2] = v[3] = d; break;
+            case 0x08: v[0] = 1.0f; v[1] = A[1] * B[1]; v[2] = A[2]; v[3] = B[3]; break;         /* DST */
+            case 0x09: for (int k = 0; k < 4; k++) v[k] = A[k] < B[k] ? A[k] : B[k]; break;     /* MIN */
+            case 0x0A: for (int k = 0; k < 4; k++) v[k] = A[k] > B[k] ? A[k] : B[k]; break;     /* MAX */
+            case 0x0B: for (int k = 0; k < 4; k++) v[k] = A[k] < B[k] ? 1.0f : 0.0f; break;     /* SLT */
+            case 0x0C: for (int k = 0; k < 4; k++) v[k] = A[k] >= B[k] ? 1.0f : 0.0f; break;    /* SGE */
+            case 0x0E: for (int k = 0; k < 4; k++) v[k] = A[k] - floorf(A[k]); break;           /* FRC */
+            case 0x0F: for (int k = 0; k < 4; k++) v[k] = floorf(A[k]); break;                  /* FLR */
+            case 0x10: for (int k = 0; k < 4; k++) v[k] = A[k] == B[k] ? 1.0f : 0.0f; break;    /* SEQ */
+            case 0x11: v[0] = v[1] = v[2] = v[3] = 0.0f; break;                                 /* SFL */
+            case 0x12: for (int k = 0; k < 4; k++) v[k] = A[k] > B[k] ? 1.0f : 0.0f; break;     /* SGT */
+            case 0x13: for (int k = 0; k < 4; k++) v[k] = A[k] <= B[k] ? 1.0f : 0.0f; break;    /* SLE */
+            case 0x14: for (int k = 0; k < 4; k++) v[k] = A[k] != B[k] ? 1.0f : 0.0f; break;    /* SNE */
+            case 0x15: v[0] = v[1] = v[2] = v[3] = 1.0f; break;                                 /* STR */
+            case 0x16: for (int k = 0; k < 4; k++) v[k] = A[k] > 0 ? 1.0f : A[k] < 0 ? -1.0f : 0.0f; break;
+            default: return 0;                                                                  /* ARL, TXL */
+            }
+            if (saturate) for (int k = 0; k < 4; k++) v[k] = al_sat(v[k]);
+            for (int k = 0; k < 4; k++) {
+                if (!vm[k]) continue;
+                if (vec_result && dst_out != 0x1Fu) out[dst_out & 15u][k] = v[k];
+                if (dst_tmp != 0x3Fu) r[dst_tmp & 31u][k] = v[k];
+            }
+            /* the HLSL reads the scalar unit's source after this store (the decompiler's order) */
+            al_src(src2, (int)((d0 >> 23) & 1u), input_src, const_src, r, in, c, C);
+        }
+        if ((sm[0] | sm[1] | sm[2] | sm[3]) && sca_op) {
+            const float x = C[0];
+            float s;
+            switch (sca_op) {
+            case 0x01: memcpy(v, C, sizeof v); s = 0; break;                                    /* MOV */
+            case 0x02: s = 1.0f / x; break;                                                     /* RCP */
+            case 0x03: s = 1.0f / x; if (s < 5.42101e-20f) s = 5.42101e-20f;                    /* RCC */
+                       if (s > 1.884467e19f) s = 1.884467e19f; break;
+            case 0x04: s = 1.0f / sqrtf(fmaxf(fabsf(x), 1e-10f)); break;                        /* RSQ */
+            case 0x05: case 0x0E: s = exp2f(x); break;                                          /* EXP EX2 */
+            case 0x06: case 0x0D: s = log2f(fmaxf(fabsf(x), 1e-10f)); break;                    /* LOG LG2 */
+            case 0x0F: s = sinf(x); break;
+            case 0x10: s = cosf(x); break;
+            case 0x07: s = 0;                                                                   /* LIT */
+                       v[0] = 1.0f; v[1] = fmaxf(C[0], 0.0f);
+                       v[2] = C[0] > 0.0f ? exp2f(fminf(fmaxf(C[3], -127.996f), 127.996f) *
+                                                  log2f(fmaxf(C[1], 1e-10f))) : 0.0f;
+                       v[3] = 1.0f; break;
+            default: return 0;
+            }
+            if (sca_op != 0x01 && sca_op != 0x07) v[0] = v[1] = v[2] = v[3] = s;
+            if (saturate) for (int k = 0; k < 4; k++) v[k] = al_sat(v[k]);
+            for (int k = 0; k < 4; k++) {
+                if (!sm[k]) continue;
+                if (!vec_result && dst_out != 0x1Fu) out[dst_out & 15u][k] = v[k];
+                if (sca_tmp != 0x3Fu) r[sca_tmp & 31u][k] = v[k];
+            }
+        }
+        if (d3 & 1u) return 1;                                          /* end */
+    }
+    return 0;                                                           /* no end bit */
+}
+
+/* ---- the HUD ----------------------------------------------------------------------------------------- */
+
+/* One HUD draw after the 3D picture, in clip space after the viewport transform (x right, -1..1 across the
+ * target; y up, -1..1). uflip: its texture runs right to left; u0 / u1: the texture coordinate at its left /
+ * right edge (diagnostics). tex: a hash of the textures it samples (diagnostics). */
+typedef struct { uint64_t tex; float x0, x1, y0, y1; int uflip; float u0, u1; } al_quad;
+/* pixels per clip unit (target width / 2, height / 2) */
+typedef struct { float px_w, px_h; } al_hud;
+
+/* The players' HUD sits at the top: bars, names, rank plates end above 180 of 720 guest pixels; the first
+ * centre title starts below 245. */
+#define AL_HUD_BAND 0.30f
+
+static float al_minf(float a, float b) { return a < b ? a : b; }
+static float al_maxf(float a, float b) { return a > b ? a : b; }
+
+/* Diagnostic only: find pixels the effective guest scissor can show. Pixel coordinates are relative to
+ * the target, y down; q is in clip space, y up. Keep texture coordinates and orientation. */
+static int al_hud_clip(const al_hud* h, al_quad* q, float left, float top, float right, float bottom)
+{
+    if (!(h->px_w > 0.0f && h->px_h > 0.0f)) return 0;
+    left = al_maxf(left, 0.0f); top = al_maxf(top, 0.0f);
+    right = al_minf(right, 2.0f * h->px_w); bottom = al_minf(bottom, 2.0f * h->px_h);
+    if (!(right > left && bottom > top)) return 0;
+    q->x0 = al_maxf(q->x0, left / h->px_w - 1.0f);
+    q->x1 = al_minf(q->x1, right / h->px_w - 1.0f);
+    q->y0 = al_maxf(q->y0, 1.0f - bottom / h->px_h);
+    q->y1 = al_minf(q->y1, 1.0f - top / h->px_h);
+    return q->x1 > q->x0 && q->y1 > q->y0;
+}
+
+static int al_hud_side_clipped_center(const al_quad* raw, const al_quad* visible)
+{
+    return raw->x0 < 0.0f && raw->x1 > 0.0f && visible->x1 > visible->x0 && visible->y1 > visible->y0 &&
+           (visible->x1 <= 0.0f || visible->x0 >= 0.0f);
+}
+
+enum { AL_STAY_BELOW_BAND = 1, AL_STAY_ACROSS = 2, AL_STAY_BATCH = 3, AL_MOVE = 4 };
+
+/* Where the HUD draw q (n vertices) goes: -> the clip-space x translation (+1 = half the width to the right,
+ * -1 to the left, 0 = stays); *why = one of the AL_* reasons above. */
+static float al_hud_place(const al_quad* q, uint32_t n, int* why)
+{
+    if (q->y0 < 1.0f - 2.0f * AL_HUD_BAND) { *why = AL_STAY_BELOW_BAND; return 0.0f; }
+    if (q->x0 < 0.0f && q->x1 > 0.0f) { *why = n > 6 ? AL_STAY_BATCH : AL_STAY_ACROSS; return 0.0f; }
+    *why = AL_MOVE;
+    return (q->x0 + q->x1) < 0.0f ? 1.0f : -1.0f;
+}
+
+/* The scene copy must be a full-screen quad in evaluated screen coordinates. Stale render-target
+ * bindings and camera constants are not proof: all four corners must actually be drawn. */
+static int al_picture_quad(const float xy[][2], uint32_t n, float px_w, float px_h)
+{
+    if ((n != 4 && n != 6) || px_w <= 0.0f || px_h <= 0.0f) return 0;
+    unsigned corners = 0;
+    for (uint32_t i = 0; i < n; i++) {
+        const float x = xy[i][0], y = xy[i][1];
+        if (!isfinite(x) || !isfinite(y) || fabsf(fabsf(x) - 1.0f) * px_w > 2.0f ||
+            fabsf(fabsf(y) - 1.0f) * px_h > 2.0f) return 0;
+        corners |= 1u << ((x > 0.0f ? 1u : 0u) | (y > 0.0f ? 2u : 0u));
+    }
+    return corners == 15u;
+}
+
+/* Guest-pixel horizontal scissor; clamp both ends before any unsigned host-scale conversion. */
+static void al_clip_scissor(float width, float dx, int mirror, int* left, int* right)
+{
+    const int w = (int)width;
+    int l = *left, r = *right;
+    if (mirror) { l = w - *right; r = w - *left; }
+    else { const int d = (int)floorf(dx + 0.5f); l += d; r += d; }
+    if (l < 0) l = 0;
+    if (l > w) l = w;
+    if (r < 0) r = 0;
+    if (r > w) r = w;
+    if (r < l) r = l;
+    *left = l; *right = r;
+}
+
+#endif

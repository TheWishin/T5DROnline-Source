+int padh_read(u32 port, int reader, PadHostPort* out, u32 min_interval_us)
+{
+    padh_init();
+    if (!g_cfg.tap_latch || reader < 0 || reader >= PADH_READERS) return padh_sample(port, out, min_interval_us);
+    memset(out, 0, sizeof *out);
+    out->lx = out->ly = out->rx = out->ry = 128;
+    if (port >= PADH_MAX_PORTS) return 0;
+    PortState* ps = &g_port[port];
+    AcquireSRWLockExclusive(&ps->lock);
+    LONGLONG t0 = qpc_now();
+    int fresh = 0;
+    if (!ps->have || !min_interval_us || t0 - ps->t_end >= qpc_from_us(min_interval_us)) {
+        sample_locked(port, ps, t0);
+        fresh = 1;
+    }
+    if (ps->rhave[reader] && ps->rout[reader].seq == ps->last.seq)
+        *out = ps->rout[reader];          /* nothing new since this reader's last read */
+    else
+        deliver_locked(port, ps, reader, t0, out);
+    ReleaseSRWLockExclusive(&ps->lock);
+    return fresh;
+}

+/* Patch 0059 test hooks: a slower PC on this one (docs/WEAK_PC.md). A busy
+ * wait of N microseconds on the thread that does the work, so the frame's
+ * critical path grows as it would on a processor with slower cores:
+ *   PS3_TEST_SLOW_GAME_US=N  the game's main thread, right before it asks for
+ *                            its flip (Tekken 5 DR resets the flip status
+ *                            there, ~2 ms before its one flush per frame)
+ *   PS3_TEST_SLOW_XLAT_US=N  the FIFO walker, when it reaches the flip (the
+ *                            render translation of the frame)
+ * Off (unset or 0) each is one load of a cached value. Never for players. */
+static int gcm_test_slow_us(int which)
+{
+    static int v[2] = { -1, -1 };
+    if (v[which] < 0) {
+        const char* e = getenv(which ? "PS3_TEST_SLOW_XLAT_US" : "PS3_TEST_SLOW_GAME_US");
+        const int n = e ? atoi(e) : 0;
+        v[which] = n > 0 && n <= 100000 ? n : 0;
+        if (v[which])
+            fprintf(stderr, "[test] %s: +%d us per frame (a slower PC)%c",
+                    which ? "PS3_TEST_SLOW_XLAT_US" : "PS3_TEST_SLOW_GAME_US", v[which], 10);
+    }
+    return v[which];
+}
+static void gcm_test_spin(int which)
+{
+    const int us = gcm_test_slow_us(which);
+    if (!us) return;
+    LARGE_INTEGER f, t0, t;
+    QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&t0);
+    const LONGLONG end = t0.QuadPart + f.QuadPart * us / 1000000;
+    do { YieldProcessor(); QueryPerformanceCounter(&t); } while (t.QuadPart < end);
+}

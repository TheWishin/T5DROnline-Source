+/* ---------------------------------------------------------------------------
+ * Surface-to-surface copies at each surface's own internal-resolution factor
+ * (patch 0038). Same factor: an exact CopyTextureRegion, as before. Different
+ * factors (below native a 3D target is smaller than the display buffers):
+ * a draw that samples the source rect bilinearly into the destination rect.
+ * -----------------------------------------------------------------------*/
+static struct {
+    int tried;
+    ID3D12RootSignature* rootsig;
+    ID3D12PipelineState* pso_rgba8;
+    ID3D12PipelineState* pso_rgba16f;
+} g_ld_copy;

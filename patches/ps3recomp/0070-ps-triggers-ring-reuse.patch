+/* RX- / RY- on a PlayStation pad: where L2 / R2 rest. They never come on (ps_trig); a binding to one is
+ * dropped, and a line that bound nothing else is left out as if it were not there, so the button keeps
+ * its preset binding. Controls windows up to 1.1.4 could capture them (the trigger let go). */
+static int ps_rest_source(const BindTable* t, int cls, int id)
+{
+    return t->ps_trig && cls == CLS_DINPUT && (id == CID_AXIS + 3 * 2 + 1 || id == CID_AXIS + 4 * 2 + 1);

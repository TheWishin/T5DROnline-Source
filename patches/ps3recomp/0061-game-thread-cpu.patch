index 0000000..8ec1462
--- /dev/null
+++ b/runtime/ppu/ppu_lwm_fast.h
@@ -0,0 +1,84 @@
+/*
+ * ps3recomp - the host side of a guest lwmutex without a system call while it
+ * is free (patch 0061, used by ppu_sysprx.cpp).
+ *
+ * The lwmutex was a binary semaphore: two kernel calls for every lock/unlock
+ * pair (a zero-timeout wait and a release) even when nobody else wanted the
+ * lock -- about a third of a Tekken 5 DR fight frame's work on the game's main
+ * thread. Now one atomic word per lwmutex:
+ *
+ *   st 0 = free, 1 = locked, 2 = locked and maybe waited for
+ *
+ * lock:   0 -> 1 with a compare-exchange. Taken: register as a waiter on the
+ *         contended path (one mutex and condition variable for every lwmutex:
+ *         contention is rare) and sleep until an unlock hands the lock over.
+ * unlock: 1 -> 0 with a compare-exchange. Waiters (st 2): hand the lock to one
+ *         of them -- it stays locked, the waiter returns owning it, as the
+ *         semaphore's release to a waiting thread did and as the PS3's kernel
+ *         hands a contended lwmutex to the next waiter. Nobody waiting: free.
+ *
+ * Kept from the semaphore: any thread may unlock (guest code hands lwmutex
+ * ownership between threads), a timed-out lock takes nothing (ETIMEDOUT for
+ * the caller), and unlocking a free lock leaves it free. Recursion and the
+ * guest-visible owner fields stay with the caller. tests/c/lwm_fast_test.cpp
+ * tests this header alone.
+ */
+#ifndef PS3RECOMP_PPU_LWM_FAST_H
+#define PS3RECOMP_PPU_LWM_FAST_H
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <mutex>
+#include <stdint.h>
+
+struct LwmFast {
+    std::atomic<int> st{ 0 };   /* 0 free, 1 locked, 2 locked + maybe waiters */
+    int nwait = 0, tokens = 0;  /* under lwm_fast_q().mu: waiters, hand-overs not yet taken */
+};
+
+struct LwmFastQueue { std::mutex mu; std::condition_variable cv; };
+static inline LwmFastQueue& lwm_fast_q() { static LwmFastQueue q; return q; }
+
+#define LWM_FAST_FOREVER 0xFFFFFFFFu
+
+static inline int lwm_fast_try(LwmFast* l)
+{
+    int z = 0;
+    return l->st.compare_exchange_strong(z, 1, std::memory_order_acquire) ? 1 : 0;
+}
+
+/* 1 = acquired, 0 = timed out after `ms` milliseconds (LWM_FAST_FOREVER: no timeout) */
+static inline int lwm_fast_acquire(LwmFast* l, uint32_t ms)
+{
+    if (lwm_fast_try(l)) return 1;
+    LwmFastQueue& q = lwm_fast_q();
+    std::unique_lock<std::mutex> lk(q.mu);
+    if (l->st.exchange(2, std::memory_order_acquire) == 0) return 1;   /* freed meanwhile: ours (the unlock takes the slow path once) */
+    l->nwait++;
+    auto handed = [&] { return l->tokens > 0; };
+    bool got = true;
+    if (ms == LWM_FAST_FOREVER) q.cv.wait(lk, handed);
+    else got = q.cv.wait_for(lk, std::chrono::milliseconds(ms), handed);
+    l->nwait--;
+    if (!got) return 0;                       /* withdrawn: the owner's unlock sees one waiter less */
+    l->tokens--;                              /* handed over: still locked, now ours */
+    if (l->nwait == 0 && l->tokens == 0) l->st.store(1, std::memory_order_relaxed);
+    return 1;
+}
+
+static inline void lwm_fast_release(LwmFast* l)
+{
+    int one = 1;
+    if (l->st.compare_exchange_strong(one, 0, std::memory_order_release)) return;
+    LwmFastQueue& q = lwm_fast_q();
+    std::lock_guard<std::mutex> lk(q.mu);
+    if (l->nwait > l->tokens) {               /* hand the lock to a waiter: it stays locked */
+        l->tokens++;
+        q.cv.notify_all();
+    } else {
+        l->st.store(0, std::memory_order_release);   /* nobody waits (or a free lock released again: harmless) */
+    }
+}
+
+#endif

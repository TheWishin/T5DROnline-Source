+/* PS3_HOST_PROF=<file>: sample every thread's host RIP each ~1 ms between
+ * PS3_HOST_PROF_AT=<start>,<end> seconds (default 40,60) and write a
+ * histogram: one line per (thread, location) with the sample count. A RIP in
+ * this module is printed as an RVA (symbolize with t5dr.map); one elsewhere
+ * as the module name plus the first return address into this module found
+ * on the stack, which says which runtime call is waiting there. */
+static DWORD WINAPI host_prof_thread(LPVOID arg)
+{
+    const char* out_path = (const char*)arg;
+    HMODULE self = NULL;
+    GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                       GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                       (LPCSTR)&host_prof_thread, &self);
+    const uintptr_t lo = (uintptr_t)self;
+    uintptr_t hi = lo;
+    { const IMAGE_DOS_HEADER* dos = (const IMAGE_DOS_HEADER*)self;
+      const IMAGE_NT_HEADERS* nt = (const IMAGE_NT_HEADERS*)((const char*)self + dos->e_lfanew);
+      hi = lo + nt->OptionalHeader.SizeOfImage; }
+    uintptr_t text_lo = lo, text_hi = hi;   /* return addresses live in .text */
+    { const IMAGE_DOS_HEADER* dos = (const IMAGE_DOS_HEADER*)self;
+      const IMAGE_NT_HEADERS* nt = (const IMAGE_NT_HEADERS*)((const char*)self + dos->e_lfanew);
+      const IMAGE_SECTION_HEADER* sec = IMAGE_FIRST_SECTION(nt);
+      for (unsigned s = 0; s < nt->FileHeader.NumberOfSections; s++)
+          if (memcmp(sec[s].Name, ".text", 6) == 0) {
+              text_lo = lo + sec[s].VirtualAddress;
+              text_hi = text_lo + sec[s].Misc.VirtualSize;
+          } }
+    int t_start = 40, t_end = 60;
+    { const char* e = getenv("PS3_HOST_PROF_AT"); int a = 0, b = 0;
+      if (e && sscanf(e, "%d,%d", &a, &b) == 2 && b > a) { t_start = a; t_end = b; } }
+    Sleep((DWORD)t_start * 1000);
+    struct Bin { DWORD tid; uint64_t key; uint64_t caller; unsigned n; };
+    const unsigned NB = 1u << 16;
+    Bin* bins = (Bin*)calloc(NB, sizeof(Bin));
+    if (!bins) return 0;
+    struct Th { DWORD tid; HANDLE h; };
+    Th ths[256]; int nth = 0;
+    const DWORD me = GetCurrentThreadId(), pid = GetCurrentProcessId();
+    ULONGLONG t0 = GetTickCount64(), last_enum = 0;
+    unsigned long long total = 0, dropped = 0;
+    timeBeginPeriod(1);
+    while (GetTickCount64() - t0 < (ULONGLONG)(t_end - t_start) * 1000ull) {
+        if (GetTickCount64() - last_enum > 1000) {
+            last_enum = GetTickCount64();
+            for (int i = 0; i < nth; i++) CloseHandle(ths[i].h);
+            nth = 0;
+            HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+            THREADENTRY32 te; te.dwSize = sizeof te;
+            if (snap != INVALID_HANDLE_VALUE && Thread32First(snap, &te)) {
+                do {
+                    if (te.th32OwnerProcessID != pid || te.th32ThreadID == me || nth >= 256) continue;
+                    { static int who = -1; if (who < 0) { const char* w = getenv("PS3_HOST_PROF_WHO"); who = (w && !strcmp(w, "ticker")) ? 1 : 0; }
+                      if (who == 1 && te.th32ThreadID != g_ticker_tid) continue; }
+                    HANDLE th = OpenThread(THREAD_GET_CONTEXT | THREAD_SUSPEND_RESUME |
+                                           THREAD_QUERY_INFORMATION, FALSE, te.th32ThreadID);
+                    if (th) { ths[nth].tid = te.th32ThreadID; ths[nth].h = th; nth++; }
+                } while (Thread32Next(snap, &te));
+            }
+            if (snap != INVALID_HANDLE_VALUE) CloseHandle(snap);
+        }
+        for (int i = 0; i < nth; i++) {
+            if (SuspendThread(ths[i].h) == (DWORD)-1) continue;
+            CONTEXT ctx; ctx.ContextFlags = CONTEXT_FULL;
+            uint64_t key = 0, caller = 0;
+            if (GetThreadContext(ths[i].h, &ctx)) {
+                const uintptr_t rip = (uintptr_t)ctx.Rip;
+                if (rip >= lo && rip < hi) {
+                    key = (uint64_t)(rip - lo);
+                } else {
+                    HMODULE m = NULL;
+                    GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                                       GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                                       (LPCSTR)rip, &m);
+                    key = 0x8000000000000000ull | (uint64_t)(uintptr_t)m;
+                }
+                {
+                    /* Unwind (x64 unwind tables) to the first two caller
+                     * frames in this module: which runtime call is waiting
+                     * there, or which function a hot leaf is working for. */
+                    CONTEXT uc = ctx;
+                    int got = 0;
+                    for (int depth = 0; depth < 48 && got < 2 && uc.Rip; depth++) {
+                        DWORD64 image = 0;
+                        PRUNTIME_FUNCTION fe = RtlLookupFunctionEntry(uc.Rip, &image, NULL);
+                        if (!fe) {   /* leaf: return address on top of stack */
+                            MEMORY_BASIC_INFORMATION mbi;
+                            if (!VirtualQuery((LPCVOID)uc.Rsp, &mbi, sizeof mbi) ||
+                                mbi.State != MEM_COMMIT) break;
+                            uc.Rip = *(DWORD64*)uc.Rsp;
+                            uc.Rsp += 8;
+                        } else {
+                            PVOID hd = NULL; DWORD64 est = 0;
+                            RtlVirtualUnwind(UNW_FLAG_NHANDLER, image, uc.Rip, fe, &uc, &hd, &est, NULL);
+                        }
+                        if (uc.Rip >= text_lo && uc.Rip < text_hi)
+                            caller |= (uint64_t)(uc.Rip - lo) << (32 * got++);
+                    }
+                }
+            }
+            ResumeThread(ths[i].h);
+            uint64_t hsh = (key * 0x9E3779B97F4A7C15ull) ^ (caller * 0xC2B2AE3D27D4EB4Full) ^ ths[i].tid;
+            unsigned slot = (unsigned)(hsh >> 40) & (NB - 1);
+            unsigned probes = 0;
+            while (bins[slot].n && !(bins[slot].tid == ths[i].tid && bins[slot].key == key &&
+                                     bins[slot].caller == caller) && probes < NB) {
+                slot = (slot + 1) & (NB - 1); probes++;
+            }
+            if (probes >= NB) { dropped++; continue; }
+            bins[slot].tid = ths[i].tid; bins[slot].key = key; bins[slot].caller = caller;
+            bins[slot].n++;
+            total++;
+        }
+        Sleep(1);
+    }
+    FILE* f = fopen(out_path, "w");
+    if (f) {
+        fprintf(f, "# samples=%llu dropped=%llu window=%d..%ds image_base=0x%llX\n",
+                total, dropped, t_start, t_end, (unsigned long long)lo);
+        for (unsigned i = 0; i < NB; i++) {
+            if (!bins[i].n) continue;
+            if (bins[i].key & 0x8000000000000000ull) {
+                char path[MAX_PATH] = "?";
+                HMODULE m = (HMODULE)(uintptr_t)(bins[i].key & 0x7FFFFFFFFFFFFFFFull);
+                if (m) GetModuleFileNameA(m, path, sizeof path);
+                const char* b = strrchr(path, '\\');
+                fprintf(f, "%lu %u mod %s 0x%llX\n", (unsigned long)bins[i].tid, bins[i].n,
+                        b ? b + 1 : path, (unsigned long long)bins[i].caller);
+            } else {
+                fprintf(f, "%lu %u rva 0x%llX 0x%llX\n", (unsigned long)bins[i].tid, bins[i].n,
+                        (unsigned long long)bins[i].key, (unsigned long long)bins[i].caller);
+            }
+        }
+        fclose(f);
+        fprintf(stderr, "[host-prof] %llu samples -> %s\n", total, out_path);
+    }
+    for (int i = 0; i < nth; i++) CloseHandle(ths[i].h);
+    free(bins);
+    return 0;
+}
 #endif
 

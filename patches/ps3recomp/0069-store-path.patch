diff --git a/runtime/ppu/tests/test_storepath_race.c b/runtime/ppu/tests/test_storepath_race.c
new file mode 100644
index 0000000..4b39292
--- /dev/null
+++ b/runtime/ppu/tests/test_storepath_race.c
@@ -0,0 +1,336 @@
+/*
+ * The lifted code's inline guest store (ppu_recomp.h VM_ST_INL) against the SPU
+ * lock-line reservation protocol, with threads (patch 0069).
+ *
+ * Built and run by tools/test_ppu_storepath.py, which writes the generated
+ * ppu_recomp.h next to this file's copy -- with HARN_DELAY() between the
+ * store's pre-check and the store, a random spin that widens the one window
+ * the protocol has to get right -- and compiles it once per variant:
+ *
+ *   new  : PPU_COH_LOCAL, the 1 KB block byte through vm_coh_bm_k (0069)
+ *   old  : PPU_NO_COH_LOCAL, the 1.1.4 check (vm_coh_bitmap, NULL test, bit)
+ *   break_post : new without the re-check after the store   (must FAIL B)
+ *   break_pre  : new without the check before the store     (must FAIL A)
+ *
+ * Under test with them: the real runtime/spu/spu_coherency.c (included below),
+ * an SPU played by a thread that does what spu_channels.c's GETLLAR / PUTLLC do,
+ * and an out-of-line vm_write* with the runtime's exact protocol
+ * (ppu_loader.cpp VM_WRITE_COH_FAST) for the stores the inline check sends
+ * there.
+ *
+ * A  steady state: lines already reserved, the SPU looping GETLLAR .. PUTLLC
+ *    on them, two PPU threads storing rising values into the same lines (and
+ *    their neighbours). A PPU store must never be undone by a PUTLLC commit
+ *    (each thread checks its words never go back), and a PUTLLC must never
+ *    find its line changed while it still holds the reservation.
+ * B  first reservations, in lockstep: per turn the SPU reserves a line no one
+ *    reserved before (the bitmap's first mark and the process-wide barrier)
+ *    while one PPU thread stores into it. After the turn, either the SPU's
+ *    snapshot holds the store or the SPU lost its reservation (the store's
+ *    re-check found the mark and notified). Turns alternate a fresh 1 KB block
+ *    and the next line of the block marked a turn before.
+ * C  neighbours: stores to the seven other lines of a reserved line's block
+ *    leave the SPU's reservation, its events and a PPU lwarx reservation alone;
+ *    one store into the line itself takes both.
+ *
+ * Windows only (FlushProcessWriteBuffers, the barrier the runtime uses there).
+ * Exit 0 = every invariant held; the summary line counts the paths taken.
+ */
+#include <intrin.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* ---- the window between the store's check and the store, widened at random */
+static volatile int g_delay_max = 0;
+static __declspec(thread) uint32_t t_rng = 0x9E3779B9u;
+static uint32_t rnd32(void) { uint32_t x = t_rng; x ^= x << 13; x ^= x >> 17; x ^= x << 5; return t_rng = x; }
+static void harn_delay(void)
+{
+    const int m = g_delay_max;
+    if (m > 0) { uint32_t n = rnd32() % (uint32_t)m; while (n--) _mm_pause(); }
+}
+#define HARN_DELAY() harn_delay()
+
+#define PPU_INLINE_STORES 1
+#include "ppu_recomp.h"
+#undef vm_write8
+#undef vm_write16
+#undef vm_write32
+#undef vm_write64
+#undef vm_read8
+#undef vm_read16
+#undef vm_read32
+#undef vm_read64
+
+#include "spu_coherency.c"
+#include <windows.h>
+
+void spu_ch_wake(spu_context* ctx) { (void)ctx; }
+
+/* ---- guest memory and the gates (the runtime publishes these, vm_gates_publish) */
+#define GMEM (16u << 20)
+static uint8_t g_mem[GMEM + 256];
+uint8_t* vm_base = g_mem;
+uint8_t* const vm_base_k = g_mem;
+const uint32_t vm_ld_lim_k = GMEM - 0x10000u - 8u, vm_st_lim_k = GMEM - 0x10000u - 8u, vm_refpoll_k = 0xFFFFFFFFu;
+const unsigned char* const vm_coh_bm_k = s_coh_bitmap;
+int vm_inline_ok = 1, vm_store_inline_ok = 1;
+uint32_t ppu_vm_size = 0, ppu_hle_inject_base = 0;
+
+/* ---- the runtime's out-of-line store: the exact protocol (ppu_loader.cpp VM_WRITE_COH_FAST) */
+static __declspec(thread) long t_n_slow, t_n_post;
+static int exact_reserved(uint32_t a)
+{
+    const unsigned char* bm = __atomic_load_n(&vm_coh_bitmap, __ATOMIC_ACQUIRE);
+    if (!bm) return 0;
+    const uint32_t line = a >> 7;
+    return (__atomic_load_n(&bm[line >> 3], __ATOMIC_RELAXED) >> (line & 7)) & 1u;
+}
+static void st_raw(uint32_t a, const void* p, int n)
+{
+    if (n == 4 && !(a & 3)) __atomic_store_n((uint32_t*)(g_mem + a), *(const uint32_t*)p, __ATOMIC_RELAXED);
+    else if (n == 8 && !(a & 7)) __atomic_store_n((uint64_t*)(g_mem + a), *(const uint64_t*)p, __ATOMIC_RELAXED);
+    else memcpy(g_mem + a, p, (size_t)n);
+}
+static void ool_store(uint32_t a, const void* p, int n)
+{
+    t_n_slow++;
+    if (exact_reserved(a)) {
+        spu_lockline_lock();
+        st_raw(a, p, n);
+        spu_coh_notify_write_from_ppu(a);
+        spu_lockline_unlock();
+    } else {
+        st_raw(a, p, n);
+        __atomic_signal_fence(__ATOMIC_SEQ_CST);
+        if (exact_reserved(a)) {
+            spu_lockline_lock();
+            spu_coh_notify_write_from_ppu(a);
+            spu_lockline_unlock();
+        }
+    }
+}
+void vm_write8(uint64_t a, uint8_t v)   { ool_store((uint32_t)a, &v, 1); }
+void vm_write16(uint64_t a, uint16_t v) { v = __builtin_bswap16(v); ool_store((uint32_t)a, &v, 2); }
+void vm_write32(uint64_t a, uint32_t v) { v = __builtin_bswap32(v); ool_store((uint32_t)a, &v, 4); }
+void vm_write64(uint64_t a, uint64_t v) { v = __builtin_bswap64(v); ool_store((uint32_t)a, &v, 8); }
+uint8_t vm_read8(uint64_t a)   { return g_mem[(uint32_t)a]; }
+uint16_t vm_read16(uint64_t a) { uint16_t v; memcpy(&v, g_mem + (uint32_t)a, 2); return __builtin_bswap16(v); }
+uint32_t vm_read32(uint64_t a) { uint32_t v; memcpy(&v, g_mem + (uint32_t)a, 4); return __builtin_bswap32(v); }
+uint64_t vm_read64(uint64_t a) { uint64_t v; memcpy(&v, g_mem + (uint32_t)a, 8); return __builtin_bswap64(v); }
+void vm_store_coh_notify(uint32_t ea)
+{
+    t_n_post++;
+    spu_lockline_lock();
+    spu_coh_notify_write_from_ppu(ea);
+    spu_lockline_unlock();
+}
+static uint32_t ld32(uint32_t a) { return __builtin_bswap32(__atomic_load_n((uint32_t*)(g_mem + a), __ATOMIC_RELAXED)); }
+
+/* ---- the SPU: GETLLAR and PUTLLC as spu_channels.c does them */
+static spu_context* g_spu;
+static uint8_t g_ls[128];
+static void getllar(uint32_t ea)
+{
+    spu_lockline_lock();
+    spu_coh_reserve(g_spu, ea);                      /* mark the line (first time: the process-wide barrier) */
+    memcpy(g_ls, g_mem + ea, 128);                   /* one read of the line ... */
+    memcpy(g_spu->resv_line, g_ls, 128);             /* ... and the snapshot from that copy */
+    g_spu->resv_ea = ea;
+    g_spu->resv_valid = 1;
+    spu_lockline_unlock();
+}
+static long g_missed;                                /* a line changed under a live reservation */
+static int putllc(uint32_t ea)
+{
+    int ok;
+    spu_lockline_lock();
+    const int same = memcmp(g_mem + ea, g_spu->resv_line, 128) == 0;
+    if (g_spu->resv_valid && g_spu->resv_ea == ea && !same) g_missed++;
+    if (g_spu->resv_valid && g_spu->resv_ea == ea && same) {
+        memcpy(g_mem + ea, g_ls, 128);
+        g_spu->resv_valid = 0;
+        spu_coh_notify_write(ea);
+        ok = 1;
+    } else {
+        ok = 0;
+    }
+    spu_lockline_unlock();
+    return ok;
+}
+
+static int g_fail;
+#define CHECK(c, ...) do { if (!(c)) { g_fail++; printf("FAIL: " __VA_ARGS__); printf("\n"); } } while (0)
+
+/* ---- A: steady state */
+#define A_LINES 4
+static const uint32_t A_BASE = 0x00200000u;        /* line k at A_BASE + k * 1024 + 256: its own block */
+static uint32_t a_line(int k) { return A_BASE + (uint32_t)k * 1024u + 256u; }
+static volatile LONG g_a_stop;
+static long g_a_lost[2], g_a_stores[2], g_a_slow[2], g_a_post[2];
+static uint32_t g_a_last[2][A_LINES][32];
+static DWORD WINAPI a_ppu(LPVOID arg)
+{
+    const int t = (int)(intptr_t)arg;
+    t_rng = 0x1234567u + 77u * (uint32_t)t;
+    uint32_t v = 0;
+    while (!g_a_stop) {
+        const int k = (int)(rnd32() % A_LINES);
+        const int w = 1 + t + 2 * (int)(rnd32() % 15);          /* words 1..30: thread 0 odd, thread 1 even */
+        const uint32_t ea = a_line(k) + 4u * (uint32_t)w;
+        const uint32_t cur = ld32(ea);
+        if (cur < g_a_last[t][k][w]) g_a_lost[t]++;            /* a store of ours was undone */
+        vm_write32_inl(ea, ++v);
+        g_a_last[t][k][w] = v;
+        g_a_stores[t]++;
+        if ((v & 3) == 0)                                       /* traffic on the neighbours too */
+            vm_write32_inl(a_line(k) - 256u + 128u * (rnd32() % 8) + 124u, v);
+    }
+    g_a_slow[t] = t_n_slow; g_a_post[t] = t_n_post;
+    return 0;
+}
+static void phase_a(DWORD ms, long* commits, long* fails)
+{
+    for (int k = 0; k < A_LINES; k++) { getllar(a_line(k)); g_spu->resv_valid = 0; }   /* reserved before */
+    g_a_stop = 0;
+    HANDLE th[2];
+    for (int t = 0; t < 2; t++) th[t] = CreateThread(0, 0, a_ppu, (LPVOID)(intptr_t)t, 0, 0);
+    const DWORD t0 = GetTickCount();
+    uint32_t i = 0;
+    while (GetTickCount() - t0 < ms) {
+        const uint32_t ea = a_line((int)(i++ % A_LINES));
+        getllar(ea);
+        uint32_t c; memcpy(&c, g_ls, 4); c = __builtin_bswap32(__builtin_bswap32(c) + 1); memcpy(g_ls, &c, 4);
+        for (uint32_t n = rnd32() % 64; n; n--) _mm_pause();
+        if (putllc(ea)) (*commits)++; else (*fails)++;
+    }
+    g_a_stop = 1;
+    WaitForMultipleObjects(2, th, TRUE, INFINITE);
+    for (int t = 0; t < 2; t++) {
+        CloseHandle(th[t]);
+        for (int k = 0; k < A_LINES; k++)
+            for (int w = 1 + t; w < 31; w += 2)
+                if (g_a_last[t][k][w] && ld32(a_line(k) + 4u * (uint32_t)w) != g_a_last[t][k][w]) g_a_lost[t]++;
+    }
+}
+
+/* ---- B: first reservations, in lockstep */
+static const uint32_t B_BASE = 0x00400000u;        /* 2 turns per 1 KB block: its line 0, then its line 1 */
+static volatile LONG g_b_turn = -1, g_b_done = -1, g_b_stop;
+static long g_b_slow, g_b_post;
+static uint32_t b_line(long j) { return B_BASE + (uint32_t)(j / 2) * 1024u + (uint32_t)(j % 2) * 128u; }
+static DWORD WINAPI b_ppu(LPVOID arg)
+{
+    (void)arg;
+    t_rng = 0xBADC0DEu;
+    for (long j = 0;; j++) {
+        while (g_b_turn < j) { if (g_b_stop) goto out; _mm_pause(); }
+        vm_write32_inl(b_line(j) + 4u, (uint32_t)j + 1u);
+        InterlockedExchange(&g_b_done, j);
+    }
+out:
+    g_b_slow = t_n_slow; g_b_post = t_n_post;
+    return 0;
+}
+static void phase_b(long turns, long* in_snapshot, long* notified, long* violations)
+{
+    HANDLE th = CreateThread(0, 0, b_ppu, 0, 0, 0);
+    for (long j = 0; j < turns; j++) {
+        const uint32_t ea = b_line(j);
+        InterlockedExchange(&g_b_turn, j);
+        for (uint32_t n = rnd32() % (uint32_t)(g_delay_max + 1); n; n--) _mm_pause();
+        getllar(ea);
+        while (g_b_done < j) _mm_pause();
+        spu_lockline_lock();
+        uint32_t snap; memcpy(&snap, g_spu->resv_line + 4, 4); snap = __builtin_bswap32(snap);
+        const int seen = snap == (uint32_t)j + 1u;
+        const int lost = !g_spu->resv_valid;
+        if (seen) (*in_snapshot)++;
+        else if (lost) (*notified)++;
+        else (*violations)++;
+        if (ld32(ea + 4u) != (uint32_t)j + 1u) (*violations)++;
+        g_spu->resv_valid = 0;
+        spu_lockline_unlock();
+    }
+    g_b_stop = 1;
+    WaitForSingleObject(th, INFINITE);
+    CloseHandle(th);
+}
+
+/* ---- C: the neighbours of a reserved line */
+static const uint32_t C_LINE = 0x00800000u + 3u * 128u;   /* line 3 of its block */
+static volatile LONG g_c_go, g_c_done;
+static DWORD WINAPI c_ppu(LPVOID arg)
+{
+    (void)arg;
+    while (!g_c_go) _mm_pause();
+    for (int r = 0; r < 20000; r++) {
+        const uint32_t blk = C_LINE & ~1023u;
+        uint32_t l = rnd32() % 8; if (blk + 128u * l == C_LINE) l = (l + 1) % 8;
+        const uint32_t ea = blk + 128u * l + 4u * (rnd32() % 32);
+        switch (r % 4) {
+        case 0: vm_write8_inl(ea, (uint8_t)r); break;
+        case 1: vm_write16_inl(ea & ~1u, (uint16_t)r); break;
+        case 2: vm_write32_inl(ea & ~3u, (uint32_t)r); break;
+        default: vm_write64_inl(ea & ~7u, (uint64_t)r * 0x10001ull); break;
+        }
+    }
+    InterlockedExchange(&g_c_done, 1);
+    return 0;
+}
+static void phase_c(void)
+{
+    getllar(C_LINE);
+    spu_lockline_lock(); spu_coh_ppu_reserve(C_LINE); spu_lockline_unlock();    /* this thread's lwarx too */
+    __atomic_store_n(&g_spu->event_status, 0, __ATOMIC_SEQ_CST);
+    HANDLE th = CreateThread(0, 0, c_ppu, 0, 0, 0);
+    InterlockedExchange(&g_c_go, 1);
+    WaitForSingleObject(th, INFINITE);
+    CloseHandle(th);
+    spu_lockline_lock();
+    const int held = g_spu->resv_valid, ppu_held = spu_coh_ppu_holds(C_LINE);
+    spu_lockline_unlock();
+    CHECK(held, "C: a store to a neighbour line took the SPU's reservation");
+    CHECK(!(g_spu->event_status & SPU_EVENT_LR), "C: a store to a neighbour line raised SPU_EVENT_LR");
+    CHECK(ppu_held, "C: a store to a neighbour line took the PPU's lwarx reservation");
+    CHECK(memcmp(g_mem + C_LINE, g_spu->resv_line, 128) == 0, "C: the reserved line changed");
+    vm_write32_inl(C_LINE + 8u, 0x12345678u);       /* into the line itself (this thread holds the lwarx: */
+    spu_lockline_lock();                            /* its own store keeps that one, as on the PPU) */
+    const int held2 = g_spu->resv_valid;
+    spu_lockline_unlock();
+    CHECK(!held2, "C: a store into the reserved line left the SPU's reservation");
+    CHECK(g_spu->event_status & SPU_EVENT_LR, "C: a store into the reserved line raised no SPU_EVENT_LR");
+    CHECK(ld32(C_LINE + 8u) == 0x12345678u, "C: the store into the reserved line did not land");
+    spu_coh_ppu_thread_exit();
+}
+
+int main(int argc, char** argv)
+{
+    const long turns = argc > 1 ? atol(argv[1]) : 20000;
+    const DWORD a_ms = argc > 2 ? (DWORD)atol(argv[2]) : 2000;
+    g_delay_max = argc > 3 ? atoi(argv[3]) : 256;
+    g_spu = (spu_context*)calloc(1, sizeof(spu_context));
+    if (!g_spu) return 2;
+    g_spu->spu_id = 1;
+
+    long b_snap = 0, b_notified = 0, b_viol = 0;
+    phase_b(turns, &b_snap, &b_notified, &b_viol);
+    CHECK(b_viol == 0, "B: %ld turns where the store was neither in the SPU's snapshot nor took its reservation", b_viol);
+
+    long commits = 0, fails = 0;
+    phase_a(a_ms, &commits, &fails);
+    CHECK(g_a_lost[0] + g_a_lost[1] == 0, "A: %ld PPU stores undone by a PUTLLC", g_a_lost[0] + g_a_lost[1]);
+    CHECK(g_missed == 0, "A: %ld PUTLLCs found their line changed under a live reservation", g_missed);
+    CHECK(commits > 0, "A: no PUTLLC ever succeeded");
+
+    phase_c();
+
+    printf("B: %ld turns: store in the snapshot %ld, reservation taken by the store %ld (re-checks after the store "
+           "that notified: %ld; stores sent out of line %ld)\n", turns, b_snap, b_notified, g_b_post, g_b_slow);
+    printf("A: %ld PPU stores (%ld out of line, %ld re-check notifies), %ld PUTLLC commits, %ld failed\n",
+           g_a_stores[0] + g_a_stores[1], g_a_slow[0] + g_a_slow[1], g_a_post[0] + g_a_post[1], commits, fails);
+    printf("%s (%d failed checks)\n", g_fail ? "FAILED" : "PASSED", g_fail);
+    return g_fail ? 1 : 0;
+}

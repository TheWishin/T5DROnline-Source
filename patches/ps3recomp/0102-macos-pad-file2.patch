  * while a script drove the pad. */
-static void pad_poll_file(u16* out_btns, int* out_lx, int* out_ly, int* out_rx, int* out_ry)
+/* Patch 0102: PS3_PAD_FILE2=<path> scripts port 1 (player 2) the same way, as the Windows pad host
+ * has it (the smoke suite drives both players). `which` 0 = PS3_PAD_FILE, 1 = PS3_PAD_FILE2. */
+static void pad_poll_file_n(int which, u16* out_btns, int* out_lx, int* out_ly, int* out_rx, int* out_ry)
 {
-    static const char* path = (const char*)-1;

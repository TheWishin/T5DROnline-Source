+        if (ua != ub && !(isnan32(ua) && isnan32(ub)) && bad++ < 3) printf("  scalef(%a, %d) = %a, ldexpf %a\n", x, e, b, a);
+    }
+    printf("scalef: %ld cases, %ld differ from ldexpf\n", n / 10, bad);
+    fails += bad != 0;
+    bad = 0;
+    for (long i = 0; i < n / 10; i++) {
+        double v = gd(1, 1023, 34);
+        if (fabs(v) >= 2147483647.0) continue;
+        if (ppu_cvt_i32(v, 1) != (int32_t)nearbyint(v) || ppu_cvt_i32(v, 0) != (int32_t)trunc(v)) bad++;

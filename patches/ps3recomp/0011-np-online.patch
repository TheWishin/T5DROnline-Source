+/* Parental-control flags: nothing restricted. Guest out-params. */
+s32 sceNpManagerGetContentRatingFlag(u32 isRestricted, u32 age)
+{
+    if (!s_np_initialized) return SCE_NP_ERROR_NOT_INITIALIZED;
+    if (isRestricted) vm_write32(isRestricted, 0);
+    if (age) vm_write32(age, 20);
+    return CELL_OK;
+}
+
+s32 sceNpManagerGetChatRestrictionFlag(u32 isRestricted)
+{
+    if (!s_np_initialized) return SCE_NP_ERROR_NOT_INITIALIZED;
+    if (isRestricted) vm_write32(isRestricted, 0);
+    return CELL_OK;
+}
+
+/* Network time as a CellRtcTick: microseconds since 0001-01-01. */
+s32 sceNpManagerGetNetworkTime(u32 pTick)
+{
+    if (!s_np_initialized) return SCE_NP_ERROR_NOT_INITIALIZED;
+    if (!pTick) return SCE_NP_ERROR_INVALID_ARGUMENT;
+    if (!np_psnr_enabled()) return SCE_NP_ERROR_OFFLINE;
+    /* The same clock as sys_time / cellRtc (runtime/syscalls/sys_timer.c), so
+     * PS3_FIXED_TIME pins it too. */
+    extern uint64_t ps3_wallclock_unix_nsec(void);
+    uint64_t t = ps3_wallclock_unix_nsec() / 1000ull + 62135596800ull * 1000000ull;
+    vm_write32(pTick, (uint32_t)(t >> 32));
+    vm_write32(pTick + 4, (uint32_t)t);
     return CELL_OK;
 }
 

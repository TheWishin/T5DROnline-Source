+
+/* The walker: a pipeline the prewarm thread already made for this key. */
+static ID3D12PipelineState* ld_prewarm_take(u64 key)
+{
+    if (g_prewarm_on != 1) return NULL;
+    ld_prewarm_slot* s = ld_prewarm_slot_for(key, 0);
+    ID3D12PipelineState* pso = s ? s->pso : NULL;
+    if (pso) InterlockedIncrement64(&g_prewarm_taken);
+    return pso;
+}
+
+/* The walker, after creating a pipeline for `key`: append its record. */
+static void ld_prewarm_record(u64 key, const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd,
+                              const D3D12_INPUT_ELEMENT_DESC* il, u32 n_il,
+                              u64 name_hi, u64 name_lo)
+{
+    if (g_prewarm_on != 1 || !g_prewarm_done) return;   /* file still being read */
+    ld_prewarm_slot* s = ld_prewarm_slot_for(key, 1);
+    if (!s || s->pso) return;
+    ld_prewarm_rec r;
+    memset(&r, 0, sizeof(r));
+    r.magic = LD_PREWARM_MAGIC;
+    r.key = key; r.name_hi = name_hi; r.name_lo = name_lo;
+    r.vs_len = (u32)pd->VS.BytecodeLength; r.ps_len = (u32)pd->PS.BytecodeLength;
+    r.total_bytes = (u32)sizeof(r) + r.vs_len + r.ps_len;
+    r.n_il = n_il > 16 ? 16 : n_il;

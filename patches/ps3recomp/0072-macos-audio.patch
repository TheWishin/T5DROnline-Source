diff --git a/runtime/platform/host_sched.c b/runtime/platform/host_sched.c
index 0ecbe28..f49fd6e 100644
--- a/runtime/platform/host_sched.c
+++ b/runtime/platform/host_sched.c
@@ -182,8 +182,38 @@ int     host_sched_power_text(char* out, unsigned n, int* throttled)
         { if (n) out[0] = 0; if (throttled) *throttled = 0; return 0; }
 int     host_sched_load_text(char* buf, int len) { if (len > 0) buf[0] = 0; return 0; }
 void    host_sched_process_init(void) {}
+#ifdef __APPLE__
+#include <pthread.h>
+#include <pthread/qos.h>
+/* The Windows build raises priorities by role. macOS has no numeric priorities worth setting, but
+ * a thread without a QoS class may be run on an efficiency core of an Apple-silicon Mac, and the
+ * frame loop, the sound core and the mixer lose their deadlines (a fight wrote ~60% of the audio
+ * blocks in time). So: the threads the frame and the sound depend on run at the top class, the
+ * guest and decoder threads one below it, helpers lowest. */
+static qos_class_t host_sched_qos(int role)
+{
+    switch (role) {
+    case HS_ROLE_MAIN: case HS_ROLE_TICKER: case HS_ROLE_SPU: case HS_ROLE_AUDIO:
+        return QOS_CLASS_USER_INTERACTIVE;
+    case HS_ROLE_BACKGROUND:
+        return QOS_CLASS_UTILITY;
+    default:
+        return QOS_CLASS_USER_INITIATED;
+    }
+}
+#endif
+
 void    host_sched_thread_start(int role, int guest_prio, const char* name)
-        { (void)role; (void)guest_prio; ppu_fp_thread_init(name); }
+{
+    (void)guest_prio;
+#ifdef __APPLE__
+    const char* e = getenv("PS3_SCHED_QOS");
+    if (!(e && *e == '0')) pthread_set_qos_class_self_np(host_sched_qos(role), 0);
+#else
+    (void)role;
+#endif
+    ppu_fp_thread_init(name);
+}
 int     host_sched_enabled(void) { return 0; }
 int     host_sched_sleep_us(uint64_t usec) { (void)usec; return 0; }
 int     host_sched_sleep_subms(uint64_t usec) { (void)usec; return 0; }

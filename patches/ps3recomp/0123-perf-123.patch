+/* ---- Patch 0123: how long a list waits in the queue before the GPU starts it ------------------
+ * A player's GT 730 (Fermi, resource binding tier 1, 2018 driver, 75 Hz screen): menus at 37.5 fps
+ * and fights at 25 -- 75 Hz / 2 and / 3 -- with "GPU wait 23 ms" a frame while the GPU's own
+ * timestamps added up to 4 ms (busy 17 %). The GPU did not work for those 23 ms; something held
+ * the frame's list before it started. The list's start timestamp, mapped to QPC with the queue's
+ * clock calibration, says how long: hold = start - max(submit, the previous list's end) -- the
+ * queue had the list and the GPU had finished everything before it, yet it did not start. Holds
+ * that end right after a display refresh (the DWM vblank grid) point at the display path. [slow-
+ * frames] reports them and its verdict names them; RSX_GPU_TIME=0 turns them off with the
+ * timestamps. */
+static struct {
+    SRWLOCK lock;                  /* harvest runs on the walker, the renderer thread and the ticker */
+    double cal_gpu, cal_qpc;       /* the queue's clock calibration (GPU ticks, QPC) */
+    double qpc_per_tick;
+    ULONGLONG cal_ms, vb_ms;       /* when calibration / the vblank grid were last read */
+    LONGLONG vb, vb_per;           /* the DWM vblank grid */
+    double prev_end;               /* the previous retired list's end (QPC) */
+    u64 lists, held, at_vblank;    /* retired lists, held >= 1 ms, of those starting <= 1.5 ms after a vblank */
+    double hold_ticks;             /* QPC ticks held, all lists */
+    float recent[256];             /* the last holds (ms) */
+    u32 nrecent;
+} g_gh = { SRWLOCK_INIT };
+static void ld_gh_list(LONGLONG submit, u64 b, u64 e2)
+{
+    if (!g_gh.qpc_per_tick || !submit) return;
+    const double start = g_gh.cal_qpc + ((double)b - g_gh.cal_gpu) * g_gh.qpc_per_tick;
+    const double end = g_gh.cal_qpc + ((double)e2 - g_gh.cal_gpu) * g_gh.qpc_per_tick;
+    const double avail = g_gh.prev_end > (double)submit ? g_gh.prev_end : (double)submit;
+    double hold = start - avail;
+    g_gh.prev_end = end;
+    /* PS3_LATENCY_LOG: G submit start end (QPC) -- when the GPU really ran each list (tools/latency_test.py:
+     * a frame reaches the display at the first refresh after its present and its list's end) */
+    lat_log('G', "%lld %lld %lld", (long long)submit, (long long)start, (long long)end);
+    const double qpf = (double)g_ld_qpc_frequency;
+    if (qpf <= 0 || hold < 0) hold = 0;
+    if (hold > qpf) return;                  /* over a second: a stall, a lost device -- not this */
+    g_gh.lists++;
+    g_gh.hold_ticks += hold;
+    g_gh.recent[g_gh.nrecent++ % 256u] = (float)(hold * 1000.0 / qpf);
+    if (hold * 1000.0 >= qpf) {              /* held 1 ms or more */
+        g_gh.held++;
+        if (g_gh.vb_per > 0) {
+            double ph = fmod(start - (double)g_gh.vb, (double)g_gh.vb_per);
+            if (ph < 0) ph += (double)g_gh.vb_per;
+            if (ph <= 1.5e-3 * qpf) g_gh.at_vblank++;
+        }
+    }
+}

  * until the walker wakes it. Returns once g_rq_stop is set
  * and the ring is empty (tests; the renderer thread never stops). */
 static volatile LONG g_rq_stop;
+/* RSX_XLAT_RENDER_DELAY_US=<us>[,<ms>] (test hook, patch 0070): the renderer thread spins <us> after every
+ * call it makes and sleeps <ms> after every present -- a renderer thread as slow as vkd3d-proton's can be
+ * (Linux / Steam Proton), to check that nothing the walker writes for the GPU is reused before the GPU and
+ * this thread are done with it (RSX_RING_GUARD, docs/RENDER_PERF.md "Ring reuse"). */
+static double g_rq_delay_us = -1.0;
+static DWORD g_rq_delay_present_ms;
+static void ld_rq_delay(int present)
+{
+    if (g_rq_delay_us < 0) {
+        const char* e = getenv("RSX_XLAT_RENDER_DELAY_US");
+        g_rq_delay_us = e && *e ? atof(e) : 0.0;
+        const char* c = e ? strchr(e, ',') : NULL;
+        g_rq_delay_present_ms = c ? (DWORD)atoi(c + 1) : 0;
+        if (g_rq_delay_us > 0 || g_rq_delay_present_ms)
+            fprintf(stderr, "[xlat-overlap] RSX_XLAT_RENDER_DELAY_US: the renderer thread waits %.1f us a call, "
+                            "%lu ms a present (test hook)\n", g_rq_delay_us, (unsigned long)g_rq_delay_present_ms);
+    }
+    if (present && g_rq_delay_present_ms) Sleep(g_rq_delay_present_ms);
+    if (g_rq_delay_us > 0) {
+        const LONGLONG end = rq_qpc() + (LONGLONG)(g_rq_delay_us * (double)rq_qpf() / 1e6);
+        while (rq_qpc() < end) _mm_pause();
+    }
+}

+
+int main(int argc, char** argv)
+{
+    static BootArgs args;
+    args.argc = argc;
+    args.argv = argv;
+    /* Every guest call is a host call, so recompiled call chains nest deeply (the Windows
+     * build links with a 256 MB main stack). */
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    if (pthread_attr_setstacksize(&attr, 256u * 1024 * 1024) != 0) {   /* a smaller stack would crash much later */
+        fprintf(stderr, "[boot] could not size the guest thread's stack\n");
+        return 1;
+    }
+    pthread_t tid;
+    const int started = pthread_create(&tid, &attr, boot_thread, &args);
+    pthread_attr_destroy(&attr);
+    if (started != 0) {

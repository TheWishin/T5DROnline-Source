     r->lt = l2; r->rt = r2;
     axis_dirs(r);
 }
@@ -1446,6 +1479,10 @@ static int dev_read(PadDev* d, RawState* r)
     r->axis[0] = js.lX;  r->axis[1] = js.lY;  r->axis[2] = js.lZ;

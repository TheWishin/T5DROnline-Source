+        const char* e = getenv("PS3_DISPLAY_LOCK");
+        cfg = !(e && *e == '0');
+        const char* m = getenv("PS3_DISPLAY_MARGIN_MS");
+        margin = (m && atof(m) >= 0.0 ? atof(m) : 1.5) * qpf / 1000.0;
+        const char* l = getenv("PS3_DISPLAY_LEAD_MS");

+        for (int k = 0; k < nf; k++) if (!_wcsicmp(found[k].path, g_hid_fail[i].path)) present = 1;
+        if (!present) g_hid_fail[i].n = 0;
+    }
+    for (int k = 0; k < nf; k++) {
+        const Found* o = &found[k];
+        int held = 0;
+        AcquireSRWLockShared(&g_dev_lock);
+        for (int i = 0; i < MAX_DEVS; i++)
+            if ((g_dev[i].kind == DEV_HID || g_dev[i].kind == DEV_DINPUT) && !g_dev[i].lost && !_wcsicmp(g_dev[i].path, o->path))
+                held = 1;

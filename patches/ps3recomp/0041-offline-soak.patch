+static std::mutex s_tls_pool_mtx;
+static uint32_t   s_tls_window_bump;            /* under s_tls_pool_mtx */
+static std::atomic<uint32_t> s_tls_shared_n{0}; /* shared fallbacks so far */
+static PPU_THREAD_LOCAL uint32_t t_tls_base;    /* this host thread's block */

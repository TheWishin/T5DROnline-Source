+static volatile LONG s_fifo_flips_queued = 0;  /* in-FIFO flips not shown yet */
+/* Guest flip-call QPCs of queued in-FIFO flips, consumed as the walker reaches
+ * each one (PS3_FRAMELOG's shown_call_to_present_us). */
+static long long s_flip_call_ring[16];
+static unsigned  s_flip_call_head, s_flip_call_tail;
+static volatile int  s_flip_hold = 0;          /* walker parked on a flip     */
+int cellGcm_flip_held(void) { return s_flip_hold; }
+/* The ticker presented the flip the walker is parked on: release it. */
+void cellGcm_flip_presented(void)
+{
+    if (!s_flip_hold) return;
+    s_flip_hold = 0;
+    if (InterlockedDecrement(&s_fifo_flips_queued) < 0)
+        InterlockedExchange(&s_fifo_flips_queued, 0);
+}

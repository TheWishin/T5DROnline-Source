+def _free_memory_bytes():
+    """Memory this process could still use without paging, or None when unknown."""
+    if os.name == "nt":
+        try:
+            import ctypes
+
+            class MEMORYSTATUSEX(ctypes.Structure):
+                _fields_ = [("dwLength", ctypes.c_ulong), ("dwMemoryLoad", ctypes.c_ulong),
+                            ("ullTotalPhys", ctypes.c_ulonglong), ("ullAvailPhys", ctypes.c_ulonglong),
+                            ("ullTotalPageFile", ctypes.c_ulonglong), ("ullAvailPageFile", ctypes.c_ulonglong),
+                            ("ullTotalVirtual", ctypes.c_ulonglong), ("ullAvailVirtual", ctypes.c_ulonglong),
+                            ("ullAvailExtendedVirtual", ctypes.c_ulonglong)]
+
+            st = MEMORYSTATUSEX()
+            st.dwLength = ctypes.sizeof(st)
+            if not ctypes.WinDLL("kernel32").GlobalMemoryStatusEx(ctypes.byref(st)):
+                return None
+            # free physical memory, and what the commit limit (RAM + page file) still allows
+            return min(st.ullAvailPhys, st.ullAvailPageFile)
+        except (OSError, AttributeError, ValueError):
+            return None
+    try:                                  # Linux: free + reclaimable cache
+        with open("/proc/meminfo") as f:
+            for line in f:
+                if line.startswith("MemAvailable:"):
+                    return int(line.split()[1]) * 1024
+    except (OSError, ValueError, IndexError):
+        pass
+    try:
+        return os.sysconf("SC_AVPHYS_PAGES") * os.sysconf("SC_PAGE_SIZE")
+    except (ValueError, OSError, AttributeError):
+        return None
+
+
+def _peak_memory_bytes():
+    """Peak working set (Windows) / maximum resident size (POSIX) of this process, 0 when unknown."""
+    if os.name == "nt":
+        try:
+            import ctypes
+            from ctypes import wintypes
+
+            class PMC(ctypes.Structure):
+                _fields_ = [("cb", wintypes.DWORD), ("PageFaultCount", wintypes.DWORD),
+                            ("PeakWorkingSetSize", ctypes.c_size_t), ("WorkingSetSize", ctypes.c_size_t),
+                            ("QuotaPeakPagedPoolUsage", ctypes.c_size_t), ("QuotaPagedPoolUsage", ctypes.c_size_t),
+                            ("QuotaPeakNonPagedPoolUsage", ctypes.c_size_t),
+                            ("QuotaNonPagedPoolUsage", ctypes.c_size_t),
+                            ("PagefileUsage", ctypes.c_size_t), ("PeakPagefileUsage", ctypes.c_size_t)]
+
+            get = ctypes.WinDLL("psapi").GetProcessMemoryInfo
+            get.argtypes = [wintypes.HANDLE, ctypes.POINTER(PMC), wintypes.DWORD]
+            pmc = PMC()
+            pmc.cb = ctypes.sizeof(pmc)
+            if get(wintypes.HANDLE(-1), ctypes.byref(pmc), pmc.cb):    # -1 = this process
+                return int(pmc.PeakWorkingSetSize)
+        except (OSError, AttributeError, ValueError):
+            pass
+        return 0
+    try:
+        import resource
+        rss = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
+        return int(rss) if sys.platform == "darwin" else int(rss) * 1024
+    except (ImportError, OSError, ValueError):
+        return 0
+
+
+def _auto_jobs(cpus, free_bytes, worker_mb=LIFT_WORKER_MB, main_mb=LIFT_MAIN_MB,
+               max_jobs=LIFT_MAX_AUTO_JOBS):
+    """The default worker count and why, as (jobs, reason). One per processor, at
+    most max_jobs, and only as many as fit in the free memory next to this
+    process, which ends up holding every lifted body. 1 = the serial lift."""
+    cpus = max(1, int(cpus or 1))
+    jobs = min(cpus, max(1, int(max_jobs)))
+    why = [f"{cpus} processor" + ("s" if cpus != 1 else "")]
+    if cpus > jobs:
+        why.append(f"at most {jobs} by default")
+    if free_bytes is None:
+        why.append("free memory unknown")
+        return jobs, ", ".join(why)
+    free_mb = max(0, int(free_bytes)) >> 20
+    fit = max(0, (free_mb - main_mb) // worker_mb)
+    if fit < jobs:
+        jobs = max(1, fit)
+        why.append(f"only {free_mb / 1024:.1f} GB free memory: room for {fit} worker(s) of "
+                   f"~{worker_mb} MB next to ~{main_mb} MB for the lifter itself")
+    else:
+        why.append(f"{free_mb / 1024:.1f} GB free memory")
+    return jobs, ", ".join(why)
+
+
+def _stall_limit(slowest_chunk_s):
+    """Seconds without any finished chunk before the pool is given up."""
+    env = os.environ.get("T5DR_LIFT_STALL_SECONDS")       # tests
+    if env:
+        try:
+            return max(1.0, float(env))
+        except ValueError:
+            pass
+    if slowest_chunk_s is None:
+        return LIFT_STALL_MAX_S
+    return min(LIFT_STALL_MAX_S, max(LIFT_STALL_MIN_S, LIFT_STALL_FACTOR * slowest_chunk_s))
+
+
+def _duration(s):
+    return f"{s:.0f} seconds" if s < 120 else f"{s / 60:.1f} minutes"
+
+
+def _heartbeat_s():
+    try:
+        return max(0.5, float(os.environ.get("T5DR_LIFT_HEARTBEAT_SECONDS") or LIFT_HEARTBEAT_S))
+    except ValueError:
+        return LIFT_HEARTBEAT_S
+

     host_sched_process_init();
     if (role < 0 || role >= HS_ROLE_COUNT) role = HS_ROLE_BACKGROUND;
     t_tag = (role == HS_ROLE_PPU || role == HS_ROLE_MAIN) ? 0 : (uint16_t)(0x100 + role);
diff --git a/runtime/ppu/ppu_fp_det.h b/runtime/ppu/ppu_fp_det.h
new file mode 100644
index 0000000..0e3e7c2
--- /dev/null
+++ b/runtime/ppu/ppu_fp_det.h
@@ -0,0 +1,325 @@
+/* ppu_fp_det.h -- floating point that gives the same bits on every x64 PC.
+ *
+ * Two PCs running one game in lockstep or rollback netplay must compute
+ * bit-identical guest state, whichever x64 CPU they have and however the
+ * lifted code was compiled (-march=x86-64-v3 with AVX2/FMA, or the x86-64
+ * baseline). IEEE-754 already fixes + - * / sqrt and the conversions, given the
+ * same SSE control register (MXCSR). What it does not fix, and what this header
+ * replaces for the lifted PPU and SPU code:
+ *
+ *  - The C runtime's math. ucrtbase.dll picks its code path by CPU: fma/fmaf
+ *    are one vfmadd instruction on a CPU with FMA3 and a software routine
+ *    without it (same values in our tests, other NaN payloads), sin/exp/pow
+ *    have an FMA3 and an SSE2 implementation that disagree in the last bit,
+ *    and the DLL itself comes with Windows, so its version differs between
+ *    PCs. A baseline build of the lifted code called fma/fmaf/trunc/ldexp from
+ *    it; every build called sqrt/sqrtf there for a negative argument (math
+ *    errno). Everything below is plain SSE2 (or the matching SSE4.1/FMA
+ *    instruction when the build has it): no library call.
+ *  - Fused multiply-add on a build without FMA instructions: exact software
+ *    versions (ppu_fma_soft, ppu_fmaf_soft) that give the bits vfmadd gives,
+ *    tested against it (runtime/ppu/tests/test_fp_det.c).
+ *  - MXCSR: the runtime sets PPU_MXCSR_CANON on every thread that runs guest
+ *    code (ppu_fp_thread_init) and checks it after every HLE call and lv2
+ *    syscall (ppu_fp_env_check), in case OS or driver code changed it.
+ *
+ * Never use rcpps/rsqrtps (or the rcp14/rsqrt14 forms) for guest results:
+ * Intel and AMD return different bits for them. The PPU estimate instructions
+ * are 1/x and 1/sqrt(x), correctly rounded, which every x64 CPU agrees on.
+ */
+#ifndef PPU_FP_DET_H
+#define PPU_FP_DET_H
+
+#include <stdint.h>
+#include <string.h>
+#if defined(__x86_64__) || defined(_M_X64)
+#define PPU_FP_X64 1
+#include <stdlib.h>   /* getenv: PS3_FP_SOFT_FMA */
+#include <emmintrin.h>
+#if defined(__SSE4_1__)
+#include <smmintrin.h>
+#endif
+#if defined(__FMA__)
+#include <immintrin.h>
+#endif
+#if defined(_MSC_VER)
+#include <intrin.h>
+#endif
+#else
+#include <math.h>   /* other hosts (arm64 builds of ps3recomp): the plain C functions */
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#ifdef __clang__
+#define PPU_FP_NOCONTRACT _Pragma("clang fp contract(off)")
+#else
+#define PPU_FP_NOCONTRACT
+#endif
+#define PPU_FP_INL static inline
+
+/* ---- the SSE environment of every guest thread ---- */
+#define PPU_MXCSR_CANON 0x1F80u   /* all exceptions masked, round to nearest, no FTZ, no DAZ */
+#define PPU_MXCSR_CTRL  0xFFC0u   /* control bits; the low six are sticky status flags */
+
+/* Runtime side (runtime/platform/fp_env.c): set the canonical MXCSR on this thread (thread
+ * entries), and restore + count + log a changed one (the check below). */
+void ppu_fp_thread_init(const char* who);
+void ppu_fp_env_fix(uint32_t seen, const char* where);
+uint32_t ppu_fp_env_violations(void);
+PPU_FP_INL void ppu_fp_env_check(const char* where)
+{
+#ifdef PPU_FP_X64
+    const uint32_t m = _mm_getcsr();
+    if (__builtin_expect((m & PPU_MXCSR_CTRL) != PPU_MXCSR_CANON, 0)) ppu_fp_env_fix(m, where);
+#else
+    (void)where;
+#endif
+}
+
+/* ---- bit access ---- */
+PPU_FP_INL uint64_t ppu_fp_u64(double d) { uint64_t u; memcpy(&u, &d, 8); return u; }
+PPU_FP_INL double   ppu_fp_f64(uint64_t u) { double d; memcpy(&d, &u, 8); return d; }
+PPU_FP_INL uint32_t ppu_fp_u32(float f) { uint32_t u; memcpy(&u, &f, 4); return u; }
+PPU_FP_INL float    ppu_fp_f32(uint32_t u) { float f; memcpy(&f, &u, 4); return f; }
+
+#ifdef PPU_FP_X64
+/* ---- square root: sqrtsd/sqrtss, never the library (no errno path) ---- */
+PPU_FP_INL double ppu_sqrt_det(double x) { return _mm_cvtsd_f64(_mm_sqrt_sd(_mm_set_sd(x), _mm_set_sd(x))); }
+PPU_FP_INL float  ppu_sqrtf_det(float x) { return _mm_cvtss_f32(_mm_sqrt_ss(_mm_set_ss(x))); }
+
+/* ---- conversions to integer: cvtsd2si (MXCSR rounding = nearest) / cvttsd2si ---- */
+PPU_FP_INL int32_t ppu_cvt_i32(double v, int rn)   /* v already in int32 range */
+{ return rn ? _mm_cvtsd_si32(_mm_set_sd(v)) : _mm_cvttsd_si32(_mm_set_sd(v)); }
+PPU_FP_INL int64_t ppu_cvt_i64(double v, int rn)   /* v already in int64 range */
+{ return rn ? _mm_cvtsd_si64(_mm_set_sd(v)) : _mm_cvttsd_si64(_mm_set_sd(v)); }
+#else
+PPU_FP_INL double ppu_sqrt_det(double x) { return __builtin_sqrt(x); }
+PPU_FP_INL float  ppu_sqrtf_det(float x) { return __builtin_sqrtf(x); }
+PPU_FP_INL int32_t ppu_cvt_i32(double v, int rn) { return rn ? (int32_t)nearbyint(v) : (int32_t)v; }
+PPU_FP_INL int64_t ppu_cvt_i64(double v, int rn) { return rn ? (int64_t)nearbyint(v) : (int64_t)v; }
+#endif
+
+/* ---- round a float to an integral float: the SSE4.1 roundss result, SSE2 only ---- */
+/* mode: 0 nearest (even), 1 toward -inf, 2 toward +inf, 3 toward zero */
+PPU_FP_INL float ppu_roundf_det(float x, int mode)
+{
+#if !defined(PPU_FP_X64)
+    return mode == 0 ? nearbyintf(x) : mode == 1 ? floorf(x) : mode == 2 ? ceilf(x) : truncf(x);
+#elif defined(__SSE4_1__)
+    const __m128 v = _mm_set_ss(x);
+    switch (mode) {
+    case 0:  return _mm_cvtss_f32(_mm_round_ss(v, v, _MM_FROUND_TO_NEAREST_INT | _MM_FROUND_NO_EXC));
+    case 1:  return _mm_cvtss_f32(_mm_round_ss(v, v, _MM_FROUND_TO_NEG_INF | _MM_FROUND_NO_EXC));
+    case 2:  return _mm_cvtss_f32(_mm_round_ss(v, v, _MM_FROUND_TO_POS_INF | _MM_FROUND_NO_EXC));
+    default: return _mm_cvtss_f32(_mm_round_ss(v, v, _MM_FROUND_TO_ZERO | _MM_FROUND_NO_EXC));
+    }
+#else
+    const uint32_t u = ppu_fp_u32(x);
+    if ((u & 0x7FFFFFFFu) >= 0x4B000000u) return (u & 0x7FFFFFFFu) > 0x7F800000u ? x + x : x;  /* |x| >= 2^23, inf, NaN (quieted) */
+    const __m128 v = _mm_set_ss(x);
+    float t = (float)(mode == 0 ? _mm_cvtss_si32(v) : _mm_cvttss_si32(v));   /* exact: |x| < 2^23 */
+    if (mode == 1 && t > x) t -= 1.0f;
+    if (mode == 2 && t < x) t += 1.0f;
+    return ppu_fp_f32((ppu_fp_u32(t) & 0x7FFFFFFFu) | (u & 0x80000000u));   /* the sign of x, also for a zero */
+#endif
+}
+
+/* ---- exact power-of-two scaling, |e| <= 126: one multiply by 2^e, which is
+ * exactly what ldexpf returns (rounding only for a subnormal result) ---- */
+PPU_FP_INL float ppu_scalef_det(float x, int e) { return x * ppu_fp_f32((uint32_t)(127 + e) << 23); }
+
+/* ---- fused multiply-add, double: x*y + z rounded once ---- */
+#if defined(__SIZEOF_INT128__)
+typedef unsigned __int128 ppu_fp_u128;
+PPU_FP_INL int ppu_fp_clz128(ppu_fp_u128 v)   /* v != 0 */
+{
+    const uint64_t hi = (uint64_t)(v >> 64);
+    return hi ? __builtin_clzll(hi) : 64 + __builtin_clzll((uint64_t)v);
+}
+/* Exact integer implementation (what a CPU without FMA3 runs). The product of
+ * the two 53-bit significands is formed exactly in 128 bits; both terms are
+ * placed with their top bit at bit 124, the smaller one shifted right with the
+ * bits it loses folded into its bit 0 (that makes the sum the round-to-odd
+ * value at bit 0, which keeps the final rounding exact), added, and rounded
+ * once to nearest-even -- subnormal results and overflow included. */
+static inline __attribute__((noinline)) double ppu_fma_soft(double x, double y, double z)
+{
+    PPU_FP_NOCONTRACT
+    const uint64_t ux = ppu_fp_u64(x), uy = ppu_fp_u64(y), uz = ppu_fp_u64(z), F = 0x000FFFFFFFFFFFFFull;
+    const int bx = (int)(ux >> 52 & 0x7FF), by = (int)(uy >> 52 & 0x7FF), bz = (int)(uz >> 52 & 0x7FF);
+    if (bx == 0x7FF || by == 0x7FF || bz == 0x7FF) {
+        /* inf/NaN: no rounding question. A finite x*y could overflow in a separate
+         * multiply, so an infinite (or NaN) z with finite x, y is the result itself. */
+        if (bx != 0x7FF && by != 0x7FF) return z + z;
+        const double p = x * y;
+        return p + z;
+    }
+    uint64_t mx = ux & F, my = uy & F, mz = uz & F;
+    if (bx) mx |= 1ull << 52;
+    if (by) my |= 1ull << 52;
+    if (bz) mz |= 1ull << 52;
+    if (!mx || !my) { const double p = x * y; return p + z; }   /* exact zero product */
+    if (!mz) return x * y;    /* z = +-0 never changes a nonzero exact product: one rounding */
+    const int sp = (int)((ux ^ uy) >> 63), sz = (int)(uz >> 63);
+    /* value = m * 2^(b - 1075), a subnormal's b counted as 1 */
+    ppu_fp_u128 P = (ppu_fp_u128)mx * my, Z = mz;
+    int pe = (bx ? bx : 1) + (by ? by : 1) - 2 * 1075, ze = (bz ? bz : 1) - 1075;
+    const int shp = ppu_fp_clz128(P) - 3, shz = ppu_fp_clz128(Z) - 3;   /* top bit -> bit 124 */
+    P <<= shp; pe -= shp;
+    Z <<= shz; ze -= shz;
+    ppu_fp_u128 A, B; int sa, sb, e, d;
+    if (pe >= ze) { A = P; sa = sp; B = Z; sb = sz; e = pe; d = pe - ze; }
+    else          { A = Z; sa = sz; B = P; sb = sp; e = ze; d = ze - pe; }
+    if (d >= 128) B = B != 0;
+    else if (d) B = (B >> d) | (ppu_fp_u128)((B & (((ppu_fp_u128)1 << d) - 1)) != 0);
+    ppu_fp_u128 R; int sr;
+    if (sa == sb)   { R = A + B; sr = sa; }
+    else if (A > B) { R = A - B; sr = sa; }
+    else if (B > A) { R = B - A; sr = sb; }
+    else return 0.0;          /* exact cancellation: +0 when rounding to nearest */
+    const int msb = 127 - ppu_fp_clz128(R);
+    const int E = msb + e;    /* the exponent of the leading bit */
+    const uint64_t sign = (uint64_t)sr << 63;
+    if (E > 1023) return ppu_fp_f64(sign | 0x7FF0000000000000ull);
+    int lsb = E - 52;
+    if (lsb < -1074) lsb = -1074;
+    const int s = lsb - e;    /* bits to drop */
+    uint64_t q;
+    if (s <= 0) q = (uint64_t)(R << -s);
+    else if (s >= 127) q = 0;  /* R < 2^126 <= half an ulp: rounds to zero */
+    else {
+        const ppu_fp_u128 one = 1, rem = R & ((one << s) - 1), half = one << (s - 1);
+        q = (uint64_t)(R >> s);
+        if (rem > half || (rem == half && (q & 1))) q++;
+    }
+    if (q >> 53) { q >>= 1; lsb++; }
+    if (q < (1ull << 52)) return ppu_fp_f64(sign | q);              /* subnormal or zero */
+    if (lsb + 1075 >= 2047) return ppu_fp_f64(sign | 0x7FF0000000000000ull);
+    return ppu_fp_f64(sign | ((uint64_t)(lsb + 1075) << 52) | (q & F));
+}
+#endif /* __SIZEOF_INT128__ */
+
+#if !defined(__FMA__) && defined(PPU_FP_X64)
+/* A build without FMA instructions on a CPU that has them: use them (same bits). */
+PPU_FP_INL int ppu_fp_cpu_fma(void)
+{
+    static int s_have = -1;
+    int h = __atomic_load_n(&s_have, __ATOMIC_RELAXED);
+    if (__builtin_expect(h < 0, 0)) {
+        int r[4];
+#if defined(_MSC_VER)
+        __cpuid(r, 1);
+#else
+        __asm__ volatile("cpuid" : "=a"(r[0]), "=b"(r[1]), "=c"(r[2]), "=d"(r[3]) : "a"(1), "c"(0));
+#endif
+        h = 0;
+        if ((r[2] & (1 << 12)) && (r[2] & (1 << 27)) && (r[2] & (1 << 28))) {   /* FMA, OSXSAVE, AVX */
+            uint32_t lo, hi;
+            __asm__ volatile("xgetbv" : "=a"(lo), "=d"(hi) : "c"(0));
+            h = (lo & 6u) == 6u;   /* the OS saves the YMM state */
+        }
+        /* PS3_FP_SOFT_FMA=1 (tests): the software fma even on a CPU with FMA3,
+         * as a CPU without it would run (tools/cross_build_test.py) */
+        { const char* e = getenv("PS3_FP_SOFT_FMA"); if (e && *e == '1') h = 0; }
+        __atomic_store_n(&s_have, h, __ATOMIC_RELAXED);
+    }
+    return h;
+}
+static inline __attribute__((target("fma"), noinline)) double ppu_fma_hw(double x, double y, double z)
+{
+    __m128d r;
+    __asm__("vfmadd213sd %3, %2, %0" : "=x"(r) : "0"(_mm_set_sd(x)), "x"(_mm_set_sd(y)), "x"(_mm_set_sd(z)));
+    return _mm_cvtsd_f64(r);
+}
+#endif
+
+PPU_FP_INL double ppu_fma_det(double x, double y, double z)
+{
+#if defined(__FMA__) && defined(PPU_FP_X64)
+    return _mm_cvtsd_f64(_mm_fmadd_sd(_mm_set_sd(x), _mm_set_sd(y), _mm_set_sd(z)));
+#elif defined(PPU_FP_X64)
+    if (__builtin_expect(ppu_fp_cpu_fma(), 1)) return ppu_fma_hw(x, y, z);
+    return ppu_fma_soft(x, y, z);
+#else
+    return __builtin_fma(x, y, z);   /* arm64: one fused instruction */
+#endif
+}
+
+/* ---- fused multiply-add, single ----
+ * The product of two singles is exact in double; the sum is rounded once in
+ * double and its exact error is known (TwoSum). Rounding that sum to odd (an
+ * inexact one gets an odd last bit) and then to single gives the correctly
+ * rounded single result -- double has more than 2 * 24 + 1 bits. */
+PPU_FP_INL float ppu_fmaf_soft(float x, float y, float z)
+{
+    PPU_FP_NOCONTRACT
+    const double p = (double)x * (double)y, dz = (double)z;
+    double s = p + dz;
+    const double bb = s - p;
+    const double err = (p - (s - bb)) + (dz - bb);    /* NaN for inf/NaN operands: s is the result then */
+    if (err != 0.0 && err == err) {
+        uint64_t u = ppu_fp_u64(s);
+        if (!(u & 1)) u = ((err > 0.0) == (s > 0.0)) ? u + 1 : u - 1;
+        s = ppu_fp_f64(u);
+    }
+    return (float)s;
+}
+
+PPU_FP_INL float ppu_fmaf_det(float x, float y, float z)
+{
+#if defined(__FMA__) && defined(PPU_FP_X64)
+    return _mm_cvtss_f32(_mm_fmadd_ss(_mm_set_ss(x), _mm_set_ss(y), _mm_set_ss(z)));
+#elif defined(PPU_FP_X64)
+    return ppu_fmaf_soft(x, y, z);
+#else
+    return __builtin_fmaf(x, y, z);
+#endif
+}
+
+/* ---- 2^x and log2(x) for the VMX estimate instructions (vexptefp, vlogefp):
+ * the ISA asks for an estimate; these are fixed double-precision formulas
+ * (only + - * /, no fused ops), so every PC gets the same bits. Accurate to
+ * well under one float ulp. ---- */
+PPU_FP_INL float ppu_exp2f_det(float f)
+{
+    PPU_FP_NOCONTRACT
+    if (f != f) return f + f;
+    if (f >= 128.0f) return ppu_fp_f32(0x7F800000u);
+    if (f < -151.0f) return 0.0f;
+    const float fl = ppu_roundf_det(f, 1);
+    const int i = (int)fl;
+    const double r = ((double)f - (double)fl) * 0.69314718055994530942;   /* in [0, ln 2) */
+    double t = 1.0 / 6227020800.0;                                       /* e^r, Taylor to r^13 */
+    static const double inv_fact[13] = { 1.0 / 479001600.0, 1.0 / 39916800.0, 1.0 / 3628800.0, 1.0 / 362880.0,
+                                         1.0 / 40320.0, 1.0 / 5040.0, 1.0 / 720.0, 1.0 / 120.0, 1.0 / 24.0,
+                                         1.0 / 6.0, 0.5, 1.0, 1.0 };
+    for (int k = 0; k < 13; k++) t = t * r + inv_fact[k];
+    return (float)(t * ppu_fp_f64((uint64_t)(1023 + i) << 52));          /* 2^i exact in double for i >= -152 */
+}
+PPU_FP_INL float ppu_log2f_det(float f)
+{
+    PPU_FP_NOCONTRACT
+    const uint32_t u = ppu_fp_u32(f);
+    if (f != f) return f + f;
+    if (u == 0x7F800000u) return f;
+    if ((u & 0x7FFFFFFFu) == 0) return ppu_fp_f32(0xFF800000u);          /* log2(+-0) = -inf */
+    if (u >> 31) return ppu_fp_f32(0x7FC00000u);                         /* negative: NaN */
+    /* x = m * 2^e with m in [sqrt(1/2), sqrt(2)) */
+    double d = (double)f;
+    uint64_t b = ppu_fp_u64(d);
+    int e = (int)(b >> 52) - 1023;
+    double m = ppu_fp_f64((b & 0x000FFFFFFFFFFFFFull) | 0x3FF0000000000000ull);
+    if (m > 1.41421356237309504880) { m *= 0.5; e += 1; }
+    const double t = (m - 1.0) / (m + 1.0), t2 = t * t;                   /* |t| < 0.1716 */
+    double s = 1.0 / 23.0;                                               /* atanh(t)/t = sum t^2k/(2k+1) */
+    for (int k = 21; k >= 1; k -= 2) s = s * t2 + 1.0 / k;
+    return (float)((double)e + (2.0 * t * s) * 1.44269504088896340736);
+}
+
+#ifdef __cplusplus
+}
+#endif
+#endif /* PPU_FP_DET_H */

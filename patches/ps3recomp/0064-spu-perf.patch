+/* The halt landing pad's longjmp without an unwind (patch 0064). MSVC's x64
+ * longjmp unwinds the frames it skips (RtlUnwindEx, ~0.8 us for ten frames)
+ * unless the jmp_buf's Frame is 0; then it restores the saved registers and
+ * jumps (~0.02 us). Nothing between the landing pad and a halt needs an
+ * unwind -- lifted SPU code and the SPU runtime have no __try/__finally and no
+ * destructors -- and every SPURS job ends in a halt: ~380 a fight frame on the
+ * skinning threads. Kept with user shadow stacks (CET) on, where a jump must
+ * unwind them, or PS3_SPU_HALT_UNWIND=1. */
+static void spu_halt_pad_no_unwind(jmp_buf* env)
+{
+#if defined(_WIN32) && defined(_M_X64)
+    static int ok = -1;
+    if (ok < 0) {
+        int v = 1;
+        const char* e = getenv("PS3_SPU_HALT_UNWIND");
+        if (e && *e == '1') v = 0;
+        /* GetProcessMitigationPolicy(ProcessUserShadowStackPolicy = 15): bit 0 of
+         * the flags is EnableUserShadowStack. Looked up at run time: the API is
+         * Windows 8+ and the policy Windows 10 2004+. */
+        typedef BOOL (WINAPI* gpmp_fn)(HANDLE, int, PVOID, SIZE_T);
+        gpmp_fn gpmp = (gpmp_fn)(void*)GetProcAddress(GetModuleHandleA("kernel32.dll"), "GetProcessMitigationPolicy");
+        DWORD flags = 0;
+        if (gpmp && gpmp(GetCurrentProcess(), 15, &flags, sizeof flags) && (flags & 1)) v = 0;
+        ok = v;
+    }
+    if (ok) ((_JUMP_BUFFER*)env)->Frame = 0;
+#else
+    (void)env;
+#endif
+}

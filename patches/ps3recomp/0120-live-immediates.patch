+def load_live_immediates(path):
+    """Exact opt-in instruction sites. A relinked or unsupported image fails closed."""
+    if not path:
+        return {}
+    with open(path, encoding="utf-8") as f:
+        meta = json.load(f)
+    if meta.get("schema") != 1 or not isinstance(meta.get("sites"), list) or not meta["sites"]:
+        raise ValueError("live immediate manifest needs schema 1 and nonempty sites")
+    result = {}
+    for site in meta["sites"]:
+        address, word = (int(str(site[k]), 0) for k in ("address", "expected_word"))
+        if address < 0 or address >= 1 << 32 or address & 3 or word < 0 or word >= 1 << 32 or address in result:
+            raise ValueError("invalid or duplicate live immediate site")
+        result[address] = word
+    return result
+
+
+def live_immediate_header(sites):
+    canonical = json.dumps([[a, w] for a, w in sorted(sites.items())], separators=(",", ":"))
+    digest = hashlib.sha256(canonical.encode("ascii")).hexdigest() if sites else ""
+    return ("#pragma once\n"
+            f"#define T5DR_LIVE_IMMEDIATE_ABI {1 if sites else 0}\n"
+            f"#define T5DR_LIVE_IMMEDIATE_COUNT {len(sites)}\n"
+            f'#define T5DR_LIVE_IMMEDIATE_MANIFEST_SHA256 "{digest}"\n')
+

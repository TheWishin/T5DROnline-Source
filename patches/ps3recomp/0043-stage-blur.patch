+/* ---------------------------------------------------------------------------
+ * Stage blur and glow at every internal resolution (patch 0043, PS3_STAGE_BLUR).
+ *
+ * Some Tekken 5 DR stages filter the picture: a soft-focus downsample of the
+ * 3D pass into the display buffer (stage 34, the misty swamp, and 24, 26 ...:
+ * a centre tap and three taps two guest texels away, then a colour curve) and
+ * a glow (stage 20's sun: the 3D pass averaged into two 128x128 buffers,
+ * blurred back and forth with four diagonal taps, added back). The offsets are
+ * guest texels. On a scaled surface a guest texel is 1.5-4 host texels, so the
+ * taps' bilinear footprints no longer meet: instead of a soft picture the
+ * kernel shows three sharp copies of every edge (4K: 3.8 output pixels apart),
+ * and the glow's blur turns blotchy.
+ *
+ * So a filter kernel -- a fragment program that samples a render-target
+ * surface two or more times on one unit (rsx_fp_texture_tap_mask) -- samples
+ * a guest-size view of a scaled surface: the surface box-filtered (area
+ * weights, exact for any factor) to its guest size, made again only after the
+ * surface was written. The taps then cover what they cover at Native.
+ * Single-tap reads (the plain downsample of the other stages, the heat haze)
+ * keep the full internal resolution; below Native nothing changes.
+ *
+ * PS3_STAGE_BLUR=0 (launcher Settings -> Stage blur / glow: Off) turns the
+ * effects off instead: every tap of a filter kernel reads the kernel's centre
+ * (get_pso, rsx_fp_apply_single_tap; the colour curve stays) and a draw that
+ * blends a glow buffer -- a surface last drawn by a filter kernel, smaller than
+ * the canvas -- onto a full-size target is skipped. Host pixels only: the
+ * game's memory and commands are the same either way, so the two players of a
+ * match may choose differently.
+ * -----------------------------------------------------------------------*/
+static struct {
+    int tried;
+    ID3D12RootSignature* rootsig;
+    ID3D12PipelineState* pso_rgba8;
+    ID3D12PipelineState* pso_rgba16f;
+    ID3D12DescriptorHeap* rtv_heap;
+    u32 rtv_step;
+} g_ld_gview;
+static u64 g_ld_gview_passes, g_ld_glow_skips;
+
+static int ld_gview_pipeline(void)
+{
+    if (g_ld_gview.tried) return g_ld_gview.pso_rgba8 != NULL;
+    g_ld_gview.tried = 1;
+    static const char vs_src[] =
+        "float4 main(uint id : SV_VertexID) : SV_Position {\n"
+        "    float2 uv = float2((id << 1) & 2, id & 2);\n"
+        "    return float4(uv * float2(2, -2) + float2(-1, 1), 0, 1);\n"
+        "}\n";
+    /* Guest texel (x, y) = the area-weighted mean of the host texels under
+     * [x, x+1) * ratio: exact for 1.5x and 3x as well as 2x and 4x. */
+    static const char ps_src[] =
+        "Texture2D src : register(t0);\n"
+        "cbuffer C : register(b0) { float2 ratio; float2 host; };\n"
+        "float4 main(float4 pos : SV_Position) : SV_Target {\n"
+        "    float2 lo = floor(pos.xy) * ratio, hi = lo + ratio;\n"
+        "    int2 a = (int2)floor(lo), b = min((int2)ceil(hi) - 1, (int2)host - 1);\n"
+        "    float4 acc = 0; float ws = 0;\n"
+        "    [loop] for (int y = a.y; y <= b.y; y++) {\n"
+        "        float wy = min(hi.y, y + 1.0) - max(lo.y, (float)y);\n"
+        "        [loop] for (int x = a.x; x <= b.x; x++) {\n"
+        "            float w = wy * (min(hi.x, x + 1.0) - max(lo.x, (float)x));\n"
+        "            acc += src.Load(int3(x, y, 0)) * w; ws += w;\n"
+        "        }\n"
+        "    }\n"
+        "    return ws > 0 ? acc / ws : (float4)0;\n"
+        "}\n";
+    ID3DBlob *vs = NULL, *ps = NULL, *err = NULL, *sig = NULL;
+    HRESULT hr = D3DCompile(vs_src, sizeof(vs_src) - 1, "gview_vs", NULL, NULL, "main",
+                            "vs_5_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &vs, &err);
+    if (SUCCEEDED(hr))
+        hr = D3DCompile(ps_src, sizeof(ps_src) - 1, "gview_ps", NULL, NULL, "main",
+                        "ps_5_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &ps, &err);
+    if (SUCCEEDED(hr)) {
+        D3D12_DESCRIPTOR_RANGE range = {0};
+        range.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+        range.NumDescriptors = 1;
+        D3D12_ROOT_PARAMETER param[2] = {0};
+        param[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+        param[0].DescriptorTable.NumDescriptorRanges = 1;
+        param[0].DescriptorTable.pDescriptorRanges = &range;
+        param[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+        param[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+        param[1].Constants.Num32BitValues = 4;
+        param[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+        D3D12_ROOT_SIGNATURE_DESC rsd = {0};
+        rsd.NumParameters = 2; rsd.pParameters = param;
+        hr = D3D12SerializeRootSignature(&rsd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err);
+        if (SUCCEEDED(hr))
+            hr = g.dev->lpVtbl->CreateRootSignature(g.dev, 0, sig->lpVtbl->GetBufferPointer(sig),
+                                                    sig->lpVtbl->GetBufferSize(sig),
+                                                    &IID_ID3D12RootSignature, (void**)&g_ld_gview.rootsig);
+    }
+    for (int f = 0; f < 2 && SUCCEEDED(hr); f++) {
+        D3D12_GRAPHICS_PIPELINE_STATE_DESC pd = {0};
+        pd.pRootSignature = g_ld_gview.rootsig;
+        pd.VS.pShaderBytecode = vs->lpVtbl->GetBufferPointer(vs);
+        pd.VS.BytecodeLength = vs->lpVtbl->GetBufferSize(vs);
+        pd.PS.pShaderBytecode = ps->lpVtbl->GetBufferPointer(ps);
+        pd.PS.BytecodeLength = ps->lpVtbl->GetBufferSize(ps);
+        pd.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+        pd.SampleMask = 0xFFFFFFFFu;
+        pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+        pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+        pd.RasterizerState.DepthClipEnable = TRUE;
+        pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+        pd.NumRenderTargets = 1;
+        pd.RTVFormats[0] = f ? DXGI_FORMAT_R16G16B16A16_FLOAT : DXGI_FORMAT_R8G8B8A8_UNORM;
+        pd.SampleDesc.Count = 1;
+        hr = g.dev->lpVtbl->CreateGraphicsPipelineState(
+            g.dev, &pd, &IID_ID3D12PipelineState,
+            (void**)(f ? &g_ld_gview.pso_rgba16f : &g_ld_gview.pso_rgba8));
+    }
+    if (SUCCEEDED(hr)) {
+        D3D12_DESCRIPTOR_HEAP_DESC hd = {0};
+        hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV;
+        hd.NumDescriptors = MAX_SURFACES;
+        hr = g.dev->lpVtbl->CreateDescriptorHeap(g.dev, &hd, &IID_ID3D12DescriptorHeap,
+                                                 (void**)&g_ld_gview.rtv_heap);
+        if (SUCCEEDED(hr))
+            g_ld_gview.rtv_step = g.dev->lpVtbl->GetDescriptorHandleIncrementSize(
+                g.dev, D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+    }
+    if (FAILED(hr))
+        fprintf(stderr, "[stage-blur] guest-view pipeline failed hr=0x%08lX %s -- filters sample the "
+                        "scaled targets directly\n", (unsigned long)hr,
+                err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "");
+    if (vs) vs->lpVtbl->Release(vs);
+    if (ps) ps->lpVtbl->Release(ps);
+    if (sig) sig->lpVtbl->Release(sig);
+    if (err) err->lpVtbl->Release(err);
+    if (FAILED(hr) && g_ld_gview.pso_rgba8) {
+        g_ld_gview.pso_rgba8->lpVtbl->Release(g_ld_gview.pso_rgba8);
+        g_ld_gview.pso_rgba8 = NULL;
+    }
+    return g_ld_gview.pso_rgba8 != NULL;
+}
+
+static void ld_gview_release(void)
+{
+    if (g_ld_gview.pso_rgba8) g_ld_gview.pso_rgba8->lpVtbl->Release(g_ld_gview.pso_rgba8);
+    if (g_ld_gview.pso_rgba16f) g_ld_gview.pso_rgba16f->lpVtbl->Release(g_ld_gview.pso_rgba16f);
+    if (g_ld_gview.rootsig) g_ld_gview.rootsig->lpVtbl->Release(g_ld_gview.rootsig);
+    if (g_ld_gview.rtv_heap) g_ld_gview.rtv_heap->lpVtbl->Release(g_ld_gview.rtv_heap);
+    memset(&g_ld_gview, 0, sizeof(g_ld_gview));
+}
+
+/* The guest-size view of surface `slot` (scaled above native), made again
+ * when the surface was written since. Records a draw -- call it only before a
+ * draw records its own state (the binding loop of sink_end_impl), like
+ * ld_surface_copy. The view stays in PIXEL_SHADER_RESOURCE state, the
+ * surface in RENDER_TARGET. Returns its SRV slot, SRV_WHITE when there is
+ * none (the caller samples the surface itself). */
+static u32 ld_guest_view_srv(u32 slot)
+{
+    surface_t* s = &g.surfaces[slot];
+    if (!s->tex || s->scale <= 1.0f || !s->w || !s->h || !s->pw || !s->ph) return SRV_WHITE;
+    if (s->fmt != DXGI_FORMAT_R8G8B8A8_UNORM && s->fmt != DXGI_FORMAT_R16G16B16A16_FLOAT) return SRV_WHITE;
+    if (!ld_gview_pipeline()) return SRV_WHITE;
+    if (s->gv_tex && s->gv_src != s->tex) {
+        retire_texture(s->gv_tex);
+        s->gv_tex = NULL;
+    }
+    D3D12_CPU_DESCRIPTOR_HANDLE rtv;
+    g_ld_gview.rtv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(g_ld_gview.rtv_heap, &rtv);
+    rtv.ptr += (size_t)slot * g_ld_gview.rtv_step;
+    int fresh = 0;
+    if (!s->gv_tex) {
+        D3D12_HEAP_PROPERTIES hp = {0};
+        hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+        D3D12_RESOURCE_DESC rd = {0};
+        rd.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+        rd.Width = s->w; rd.Height = s->h;
+        rd.DepthOrArraySize = 1; rd.MipLevels = 1;
+        rd.Format = s->fmt; rd.SampleDesc.Count = 1;
+        rd.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+        D3D12_CLEAR_VALUE cv = {0};
+        cv.Format = s->fmt;
+        if (FAILED(g.dev->lpVtbl->CreateCommittedResource(
+                g.dev, &hp, D3D12_HEAP_FLAG_NONE, &rd, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE,
+                &cv, &IID_ID3D12Resource, (void**)&s->gv_tex))) {
+            s->gv_tex = NULL;
+            static u32 fails = 0;
+            if (fails++ < 4)
+                fprintf(stderr, "[stage-blur] guest view %ux%u of surface %u could not be created\n",
+                        s->w, s->h, slot);
+            return SRV_WHITE;
+        }
+        g.dev->lpVtbl->CreateRenderTargetView(g.dev, s->gv_tex, NULL, rtv);
+        srv_write(SRV_GUESTVIEW_BASE + slot, s->gv_tex);
+        s->gv_src = s->tex;
+        fresh = 1;
+    }
+#if !defined(YZ_PERF_CLEAN)
+    if (!fresh && s->gv_gen == s->last_write_generation)
+        return SRV_GUESTVIEW_BASE + slot;
+#endif
+    if (g.srv_ring_used + 1u > SRV_RING_TABLES) {
+        ld_flush(LD_FLUSH_DESCRIPTOR_RING);
+        if (!g.ready) return SRV_WHITE;
+        g.srv_ring_used = 0;
+        g.smp_ring_used = 0;
+    }
+    const u32 base = g.srv_ring_used++ * SRV_TABLE_SIZE;
+    D3D12_CPU_DESCRIPTOR_HANDLE cpu;
+    D3D12_GPU_DESCRIPTOR_HANDLE gpu;
+    g.srv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(g.srv_heap, &cpu);
+    g.srv_heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(g.srv_heap, &gpu);
+    cpu.ptr += (size_t)base * g.srv_step;
+    gpu.ptr += (u64)base * g.srv_step;
+    g.dev->lpVtbl->CopyDescriptorsSimple(g.dev, 1, cpu, srv_cpu(SRV_SURFACE_BASE + slot),
+                                         D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    D3D12_RESOURCE_BARRIER b[2] = {0};
+    for (int k = 0; k < 2; k++) {
+        b[k].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        b[k].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    }
+    b[0].Transition.pResource = s->tex;
+    b[0].Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    b[0].Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    b[1].Transition.pResource = s->gv_tex;
+    b[1].Transition.StateBefore = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    b[1].Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    g.list->lpVtbl->ResourceBarrier(g.list, 2, b);
+    const float k[4] = { (float)s->pw / (float)s->w, (float)s->ph / (float)s->h, (float)s->pw, (float)s->ph };
+    const D3D12_VIEWPORT vp = { 0.0f, 0.0f, (float)s->w, (float)s->h, 0.0f, 1.0f };
+    const D3D12_RECT sc = { 0, 0, (LONG)s->w, (LONG)s->h };
+    ID3D12DescriptorHeap* heaps[] = {g.srv_heap, g.smp_heap};
+    g.list->lpVtbl->SetDescriptorHeaps(g.list, 2, heaps);
+    g.list->lpVtbl->OMSetRenderTargets(g.list, 1, &rtv, FALSE, NULL);
+    g.list->lpVtbl->SetGraphicsRootSignature(g.list, g_ld_gview.rootsig);
+    g.list->lpVtbl->SetGraphicsRootDescriptorTable(g.list, 0, gpu);
+    g.list->lpVtbl->SetGraphicsRoot32BitConstants(g.list, 1, 4, k, 0);
+    g.list->lpVtbl->SetPipelineState(g.list, s->fmt == DXGI_FORMAT_R16G16B16A16_FLOAT
+                                                 ? g_ld_gview.pso_rgba16f : g_ld_gview.pso_rgba8);
+    g.list->lpVtbl->RSSetViewports(g.list, 1, &vp);
+    g.list->lpVtbl->RSSetScissorRects(g.list, 1, &sc);
+    g.list->lpVtbl->IASetPrimitiveTopology(g.list, D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    g.list->lpVtbl->DrawInstanced(g.list, 3, 1, 0, 0);
+    for (int i = 0; i < 2; i++) {
+        const D3D12_RESOURCE_STATES before = b[i].Transition.StateBefore;
+        b[i].Transition.StateBefore = b[i].Transition.StateAfter;
+        b[i].Transition.StateAfter = before;
+    }
+    g.list->lpVtbl->ResourceBarrier(g.list, 2, b);
+#if !defined(YZ_PERF_CLEAN)
+    s->gv_gen = s->last_write_generation;
+#endif
+    g_ld_gview_passes++;
+    return SRV_GUESTVIEW_BASE + slot;
+}
+
+/* Which surface a texture unit reads: the one whose size matches what the
+ * descriptor declares, else the most recently drawn at that address (never
+ * the draw's own target). -1: none. */
+static int ld_sampled_surface(const rsx_dsp_texture* t, u32 target)
+{
+    int sampled = -1;
+    u32 best_gen = 0;
+    for (u32 i = 0; i < g.n_surfaces; i++) {
+        const surface_t* sf_i = &g.surfaces[i];
+        if (sf_i->location != t->location || sf_i->offset != t->offset ||
+            i == target)
+            continue;
+        if (sf_i->w == t->width && sf_i->h == t->height) return (int)i;
+        if (sampled < 0 || sf_i->last_draw_generation > best_gen) {
+            sampled = (int)i;
+            best_gen = sf_i->last_draw_generation;
+        }
+    }
+    return sampled;
+}
+
+/* The current fragment program's units read two or more times / at all. */
+static u32 ld_fp_unit_masks(u32* any)
+{
+    *any = 0;
+    if (!g_ld_current_pso.valid || !g_ld_current_pso.fp_size) return 0;
+    const u8* fp = guest_ptr(g_ld_current_pso.fp_location, g_ld_current_pso.fp_offset,
+                             g_ld_current_pso.fp_size);
+    if (!fp) return 0;
+    *any = rsx_fp_texture_mask(fp, g_ld_current_pso.fp_size);
+    return rsx_fp_texture_tap_mask(fp, g_ld_current_pso.fp_size);
+}
+
+/* One log line per filter kernel seen (program, source, target). */
+static void ld_post_note(u32 unit, u32 src, u32 target, const char* how)
+{
+    static struct { u64 key; u32 src, dst; } seen[32];
+    static u32 n_seen;
+    const u64 key = g_ld_current_pso.key;
+    const u32 so = g.surfaces[src].offset, d = g.surfaces[target].offset;
+    for (u32 i = 0; i < n_seen; i++)
+        if (seen[i].key == key && seen[i].src == so && seen[i].dst == d) return;
+    if (n_seen >= 32) return;
+    seen[n_seen].key = key; seen[n_seen].src = so; seen[n_seen].dst = d; n_seen++;
+    fprintf(stderr, "[stage-blur] filter pso %016llx: unit %u reads 0x%X %ux%u (x%.3g) into 0x%X %ux%u: %s\n",
+            (unsigned long long)key, unit, so, g.surfaces[src].w, g.surfaces[src].h,
+            (double)g.surfaces[src].scale, d, g.surfaces[target].w, g.surfaces[target].h, how);
+}

diff --git a/libs/codec/mf_h264.cpp b/libs/codec/mf_h264.cpp
new file mode 100644
index 0000000..c62d5b2
--- /dev/null
+++ b/libs/codec/mf_h264.cpp
@@ -0,0 +1,317 @@
+/*
+ * ps3recomp - H.264 decoding through the Media Foundation H.264 decoder MFT.
+ * See mf_h264.h.
+ *
+ * The decoder is created directly by CLSID (CMSH264DecoderMFT, a synchronous
+ * software MFT) rather than enumerated, so no hardware or async MFT is ever
+ * picked: there is no D3D device manager here, and the output has to land in
+ * system memory anyway (cellVdecGetPicture copies it into guest memory).
+ */
+#include "mf_h264.h"
+
+#ifdef _WIN32
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <mfapi.h>
+#include <mfidl.h>
+#include <mftransform.h>
+#include <mferror.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#pragma comment(lib, "mfplat.lib")
+#pragma comment(lib, "mfuuid.lib")
+#pragma comment(lib, "ole32.lib")
+
+/* CLSID_CMSH264DecoderMFT (wmcodecdsp.h), spelled out to avoid needing
+ * wmcodecdspuuid.lib. */
+static const GUID kClsidH264Dec =
+    { 0x62CE7E72, 0x4C71, 0x4d20, { 0xB1, 0x5D, 0x45, 0x28, 0x31, 0xA8, 0x7D, 0x9D } };
+
+/* MF_LOW_LATENCY / CODECAPI_AVLowLatencyMode: output each picture as soon as
+ * the stream's reorder depth allows. Without it the decoder held ~40 AUs
+ * before the first picture, and a movie player that starts its clock on the
+ * first picture had to sit on all the audio decoded meanwhile. */
+static const GUID kLowLatency =
+    { 0x9C27891A, 0xED7A, 0x40E1, { 0x88, 0xE8, 0xB2, 0x27, 0x27, 0xA0, 0x24, 0xEE } };
+
+struct MfH264 {
+    IMFTransform* mft;
+    DWORD out_size;          /* cbSize from GetOutputStreamInfo */
+    bool  provides_samples;  /* MFT allocates its own output samples */
+    UINT32 frame_w, frame_h; /* coded (buffer) size */
+    UINT32 disp_w, disp_h;   /* display aperture */
+    LONG   stride;           /* default stride, 0 = unknown */
+    bool   streaming;
+};
+
+static LONG s_mf_started = 0;
+
+static bool mf_startup(void)
+{
+    /* Each thread that uses COM needs its own CoInitializeEx; MFStartup once. */
+    HRESULT hr = CoInitializeEx(NULL, COINIT_MULTITHREADED);
+    (void)hr;   /* S_FALSE / RPC_E_CHANGED_MODE: COM already up on this thread */
+    if (InterlockedCompareExchange(&s_mf_started, 1, 0) == 0) {
+        if (FAILED(MFStartup(MF_VERSION, MFSTARTUP_NOSOCKET))) {
+            InterlockedExchange(&s_mf_started, 0);
+            return false;
+        }
+    }
+    return true;
+}
+
+/* Pick NV12 among the decoder's output types and read the frame geometry. */
+static HRESULT set_output_type(MfH264* d)
+{
+    for (DWORD i = 0;; i++) {
+        IMFMediaType* t = NULL;
+        HRESULT hr = d->mft->GetOutputAvailableType(0, i, &t);
+        if (FAILED(hr)) return hr;
+        GUID sub = GUID_NULL;
+        t->GetGUID(MF_MT_SUBTYPE, &sub);
+        if (sub == MFVideoFormat_NV12) {
+            hr = d->mft->SetOutputType(0, t, 0);
+            if (SUCCEEDED(hr)) {
+                UINT64 fs = 0;
+                if (SUCCEEDED(t->GetUINT64(MF_MT_FRAME_SIZE, &fs))) {
+                    d->frame_w = (UINT32)(fs >> 32);
+                    d->frame_h = (UINT32)fs;
+                }
+                d->disp_w = d->frame_w; d->disp_h = d->frame_h;
+                MFVideoArea area;
+                if (SUCCEEDED(t->GetBlob(MF_MT_MINIMUM_DISPLAY_APERTURE, (UINT8*)&area,
+                                         sizeof(area), NULL))) {
+                    if (area.Area.cx > 0 && area.Area.cy > 0) {
+                        d->disp_w = (UINT32)area.Area.cx;
+                        d->disp_h = (UINT32)area.Area.cy;
+                    }
+                }
+                UINT32 stride = 0;
+                d->stride = SUCCEEDED(t->GetUINT32(MF_MT_DEFAULT_STRIDE, &stride)) ? (LONG)stride : 0;
+                MFT_OUTPUT_STREAM_INFO si;
+                memset(&si, 0, sizeof si);
+                if (SUCCEEDED(d->mft->GetOutputStreamInfo(0, &si))) {
+                    d->out_size = si.cbSize;
+                    d->provides_samples = (si.dwFlags & (MFT_OUTPUT_STREAM_PROVIDES_SAMPLES |
+                                                         MFT_OUTPUT_STREAM_CAN_PROVIDE_SAMPLES)) != 0;
+                }
+                fprintf(stderr, "[mf_h264] output NV12 %ux%u (display %ux%u, stride %ld, %lu B/frame)\n",
+                        d->frame_w, d->frame_h, d->disp_w, d->disp_h, (long)d->stride,
+                        (unsigned long)d->out_size);
+            }
+            t->Release();
+            return hr;
+        }
+        t->Release();
+    }
+}
+
+extern "C" MfH264* mfh264_create(void)
+{
+    if (!mf_startup()) return NULL;
+    MfH264* d = (MfH264*)calloc(1, sizeof(MfH264));
+    if (!d) return NULL;
+    HRESULT hr = CoCreateInstance(kClsidH264Dec, NULL, CLSCTX_INPROC_SERVER,
+                                  IID_PPV_ARGS(&d->mft));
+    if (FAILED(hr)) {
+        fprintf(stderr, "[mf_h264] CoCreateInstance(H.264 decoder) failed: 0x%08lX\n", (unsigned long)hr);
+        free(d);
+        return NULL;
+    }
+
+    IMFAttributes* attrs = NULL;
+    if (SUCCEEDED(d->mft->GetAttributes(&attrs)) && attrs) {
+        attrs->SetUINT32(kLowLatency, TRUE);
+        attrs->Release();
+    }
+
+    IMFMediaType* in = NULL;
+    MFCreateMediaType(&in);
+    in->SetGUID(MF_MT_MAJOR_TYPE, MFMediaType_Video);
+    in->SetGUID(MF_MT_SUBTYPE, MFVideoFormat_H264);
+    in->SetUINT32(MF_MT_INTERLACE_MODE, MFVideoInterlace_MixedInterlaceOrProgressive);
+    hr = d->mft->SetInputType(0, in, 0);
+    in->Release();
+    if (FAILED(hr)) {
+        fprintf(stderr, "[mf_h264] SetInputType failed: 0x%08lX\n", (unsigned long)hr);
+        d->mft->Release(); free(d);
+        return NULL;
+    }
+    hr = set_output_type(d);
+    if (FAILED(hr)) {
+        fprintf(stderr, "[mf_h264] no NV12 output type: 0x%08lX\n", (unsigned long)hr);
+        d->mft->Release(); free(d);
+        return NULL;
+    }
+    d->mft->ProcessMessage(MFT_MESSAGE_NOTIFY_BEGIN_STREAMING, 0);
+    d->mft->ProcessMessage(MFT_MESSAGE_NOTIFY_START_OF_STREAM, 0);
+    d->streaming = true;
+    return d;
+}
+
+extern "C" void mfh264_destroy(MfH264* d)
+{
+    if (!d) return;
+    if (d->mft) {
+        d->mft->ProcessMessage(MFT_MESSAGE_NOTIFY_END_OF_STREAM, 0);
+        d->mft->ProcessMessage(MFT_MESSAGE_NOTIFY_END_STREAMING, 0);
+        d->mft->Release();
+    }
+    free(d);
+}
+
+/* Hand one decoded sample to the callback as NV12 planes. */
+static void emit_sample(MfH264* d, IMFSample* s, MfH264FrameCb cb, void* user)
+{
+    LONGLONG ts = 0;
+    s->GetSampleTime(&ts);
+    IMFMediaBuffer* buf = NULL;
+    if (FAILED(s->ConvertToContiguousBuffer(&buf)) || !buf) return;
+
+    IMF2DBuffer* b2 = NULL;
+    BYTE* base = NULL;
+    LONG pitch = 0;
+    bool locked2d = false;
+    DWORD cur = 0;
+    if (SUCCEEDED(buf->QueryInterface(IID_PPV_ARGS(&b2))) && b2 &&
+        SUCCEEDED(b2->Lock2D(&base, &pitch))) {
+        locked2d = true;
+    } else {
+        if (b2) { b2->Release(); b2 = NULL; }
+        DWORD max = 0;
+        if (FAILED(buf->Lock(&base, &max, &cur))) { buf->Release(); return; }
+        pitch = d->stride > 0 ? d->stride : (LONG)d->frame_w;
+    }
+
+    if (base && pitch > 0) {
+        MfH264Frame f;
+        f.y = base;
+        f.uv = base + (size_t)pitch * d->frame_h;   /* chroma follows the full coded height */
+        f.pitch = (uint32_t)pitch;
+        f.width = d->disp_w;
+        f.height = d->disp_h;
+        f.ts = ts;
+        if (cb) cb(user, &f);
+    }
+
+    if (locked2d) { b2->Unlock2D(); b2->Release(); }
+    else buf->Unlock();
+    buf->Release();
+}
+
+/* Pull every picture the decoder has ready. Returns S_OK when it wants more
+ * input, a failure HRESULT otherwise. */
+static HRESULT pull_output(MfH264* d, MfH264FrameCb cb, void* user)
+{
+    for (;;) {
+        MFT_OUTPUT_DATA_BUFFER ob;
+        memset(&ob, 0, sizeof ob);
+        IMFSample* own = NULL;
+        if (!d->provides_samples) {
+            IMFMediaBuffer* mb = NULL;
+            DWORD sz = d->out_size ? d->out_size : d->frame_w * d->frame_h * 3 / 2;
+            if (FAILED(MFCreateSample(&own)) || FAILED(MFCreateMemoryBuffer(sz, &mb))) {
+                if (own) own->Release();
+                return E_OUTOFMEMORY;
+            }
+            own->AddBuffer(mb);
+            mb->Release();
+            ob.pSample = own;
+        }
+        DWORD status = 0;
+        HRESULT hr = d->mft->ProcessOutput(0, 1, &ob, &status);
+        if (ob.pEvents) ob.pEvents->Release();
+        if (hr == MF_E_TRANSFORM_NEED_MORE_INPUT) {
+            if (own) own->Release();
+            return S_OK;
+        }
+        if (hr == MF_E_TRANSFORM_STREAM_CHANGE) {
+            if (own) own->Release();
+            if (ob.pSample && ob.pSample != own) ob.pSample->Release();
+            HRESULT h2 = set_output_type(d);
+            if (FAILED(h2)) return h2;
+            continue;
+        }
+        if (FAILED(hr)) {
+            if (own) own->Release();
+            return hr;
+        }
+        if (ob.pSample) emit_sample(d, ob.pSample, cb, user);
+        if (ob.pSample && ob.pSample != own) ob.pSample->Release();
+        if (own) own->Release();
+    }
+}
+
+extern "C" int mfh264_decode(MfH264* d, const uint8_t* au, uint32_t size, int64_t ts,
+                             MfH264FrameCb cb, void* user)
+{
+    if (!d || !au || !size) return -1;
+    IMFSample* s = NULL;
+    IMFMediaBuffer* mb = NULL;
+    if (FAILED(MFCreateSample(&s))) return -2;
+    if (FAILED(MFCreateMemoryBuffer(size, &mb))) { s->Release(); return -2; }
+    BYTE* p = NULL;
+    if (SUCCEEDED(mb->Lock(&p, NULL, NULL))) {
+        memcpy(p, au, size);
+        mb->Unlock();
+    }
+    mb->SetCurrentLength(size);
+    s->AddBuffer(mb);
+    mb->Release();
+    s->SetSampleTime(ts);
+    s->SetSampleDuration(333667);   /* informational; the decoder keeps our times */
+
+    HRESULT hr = d->mft->ProcessInput(0, s, 0);
+    if (hr == MF_E_NOTACCEPTING) {
+        /* Output is pending: drain it, then the input goes in. */
+        HRESULT h2 = pull_output(d, cb, user);
+        if (FAILED(h2)) { s->Release(); return -3; }
+        hr = d->mft->ProcessInput(0, s, 0);
+    }
+    s->Release();
+    if (FAILED(hr)) {
+        static int n = 0;
+        if (n++ < 8) fprintf(stderr, "[mf_h264] ProcessInput failed: 0x%08lX\n", (unsigned long)hr);
+        return -4;
+    }
+    hr = pull_output(d, cb, user);
+    if (FAILED(hr)) {
+        static int n = 0;
+        if (n++ < 8) fprintf(stderr, "[mf_h264] ProcessOutput failed: 0x%08lX\n", (unsigned long)hr);
+        return -5;
+    }
+    return 0;
+}
+
+extern "C" int mfh264_drain(MfH264* d, MfH264FrameCb cb, void* user)
+{
+    if (!d) return -1;
+    d->mft->ProcessMessage(MFT_MESSAGE_COMMAND_DRAIN, 0);
+    HRESULT hr = pull_output(d, cb, user);
+    /* After a drain the MFT accepts input again for a following sequence. */
+    return FAILED(hr) ? -1 : 0;
+}
+
+extern "C" void mfh264_flush(MfH264* d)
+{
+    if (!d) return;
+    d->mft->ProcessMessage(MFT_MESSAGE_COMMAND_FLUSH, 0);
+}
+
+#else  /* !_WIN32: no Media Foundation */
+

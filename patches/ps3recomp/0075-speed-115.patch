+/* Patch 0075 test hook: RSX_TEST_SLOW_GPU=<loops>[,<groups>] -- a slower graphics card on a fast one.
+ * Every frame gets one compute dispatch before its present: <groups> x 64 threads (default 256) each
+ * running <loops> dependent multiply-adds, i.e. a fixed amount of GPU time that the frame's own work
+ * waits behind (the GPU busy line shows how much; the RTX 3090 here: ~1 ms per 100,000 loops at
+ * 256 groups). Nothing is ever written (the store is behind a condition that is never true), the
+ * frame's pictures stay the same. Test only (docs/RENDER_PERF.md "2-core mode and slow graphics
+ * cards": one or two frames in flight with a GPU slower than the game). */
+static int g_ld_sg_cfg = -1;
+static u32 g_ld_sg_groups;
+static ID3D12RootSignature* g_ld_sg_rs;
+static ID3D12PipelineState* g_ld_sg_pso;
+static ID3D12Resource* g_ld_sg_buf;
+static ID3D12DescriptorHeap* g_ld_sg_heap;   /* one UAV, CPU side; copied into the frame's SRV ring */
+static void ld_slow_gpu_init(void)
+{
+    g_ld_sg_cfg = 0;
+    const char* e = getenv("RSX_TEST_SLOW_GPU");
+    if (!e || !*e || atoi(e) <= 0) return;
+    char loops[16];
+    snprintf(loops, sizeof loops, "%d", atoi(e));
+    const char* c = strchr(e, ',');
+    g_ld_sg_groups = c && atoi(c + 1) > 0 ? (u32)atoi(c + 1) : 256u;
+    static const char src[] =
+        "RWByteAddressBuffer o : register(u0);\n"
+        "[numthreads(64, 1, 1)]\n"
+        "void main(uint3 id : SV_DispatchThreadID) {\n"
+        "    float x = (float)id.x * 1e-7f;\n"
+        "    [loop] for (uint i = 0; i < LOOPS; i++) x = mad(x, 0.9999999f, 1e-7f);\n"
+        "    if (x == 12345.678f) o.Store(0, asuint(x));\n"
+        "}\n";
+    const D3D_SHADER_MACRO defs[] = { { "LOOPS", loops }, { NULL, NULL } };
+    ID3DBlob* cs = NULL; ID3DBlob* err = NULL;
+    if (FAILED(D3DCompile(src, sizeof src - 1, "slow_gpu", defs, NULL, "main", "cs_5_0", 0, 0, &cs, &err))) {
+        fprintf(stderr, "[test] RSX_TEST_SLOW_GPU: shader failed: %s\n",
+                err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "?");
+        if (err) err->lpVtbl->Release(err);
+        return;
+    }
+    if (err) err->lpVtbl->Release(err);
+    D3D12_DESCRIPTOR_RANGE range = {0};
+    range.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+    range.NumDescriptors = 1;
+    D3D12_ROOT_PARAMETER rp = {0};
+    rp.ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    rp.DescriptorTable.NumDescriptorRanges = 1;
+    rp.DescriptorTable.pDescriptorRanges = &range;
+    rp.ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    D3D12_ROOT_SIGNATURE_DESC rsd = {0};
+    rsd.NumParameters = 1; rsd.pParameters = &rp;
+    ID3DBlob* sig = NULL;
+    int ok = SUCCEEDED(D3D12SerializeRootSignature(&rsd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, NULL)) &&
+             SUCCEEDED(g.dev->lpVtbl->CreateRootSignature(g.dev, 0, sig->lpVtbl->GetBufferPointer(sig),
+                           sig->lpVtbl->GetBufferSize(sig), &IID_ID3D12RootSignature, (void**)&g_ld_sg_rs));
+    if (sig) sig->lpVtbl->Release(sig);
+    if (ok) {
+        D3D12_COMPUTE_PIPELINE_STATE_DESC pd = {0};
+        pd.pRootSignature = g_ld_sg_rs;
+        pd.CS.pShaderBytecode = cs->lpVtbl->GetBufferPointer(cs);
+        pd.CS.BytecodeLength = cs->lpVtbl->GetBufferSize(cs);
+        ok = SUCCEEDED(g.dev->lpVtbl->CreateComputePipelineState(g.dev, &pd, &IID_ID3D12PipelineState,
+                                                                 (void**)&g_ld_sg_pso));
+    }
+    cs->lpVtbl->Release(cs);
+    if (ok) {
+        D3D12_HEAP_PROPERTIES hp = {0};
+        hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+        D3D12_RESOURCE_DESC bd = {0};
+        bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+        bd.Width = 256; bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+        bd.SampleDesc.Count = 1; bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        bd.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+        ok = SUCCEEDED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+                           D3D12_RESOURCE_STATE_UNORDERED_ACCESS, NULL, &IID_ID3D12Resource, (void**)&g_ld_sg_buf));
+    }
+    if (ok) {
+        D3D12_DESCRIPTOR_HEAP_DESC hd = {0};
+        hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV; hd.NumDescriptors = 1;
+        ok = SUCCEEDED(g.dev->lpVtbl->CreateDescriptorHeap(g.dev, &hd, &IID_ID3D12DescriptorHeap,
+                                                           (void**)&g_ld_sg_heap));
+    }
+    if (ok) {
+        D3D12_UNORDERED_ACCESS_VIEW_DESC ud = {0};
+        ud.Format = DXGI_FORMAT_R32_TYPELESS;
+        ud.ViewDimension = D3D12_UAV_DIMENSION_BUFFER;
+        ud.Buffer.NumElements = 64;
+        ud.Buffer.Flags = D3D12_BUFFER_UAV_FLAG_RAW;
+        D3D12_CPU_DESCRIPTOR_HANDLE h;
+        g_ld_sg_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(g_ld_sg_heap, &h);
+        g.dev->lpVtbl->CreateUnorderedAccessView(g.dev, g_ld_sg_buf, NULL, &ud, h);
+    }
+    if (!ok) { fprintf(stderr, "[test] RSX_TEST_SLOW_GPU: setup failed\n"); return; }
+    g_ld_sg_cfg = 1;
+    fprintf(stderr, "[test] RSX_TEST_SLOW_GPU: %s loops x %u groups of 64 threads of GPU work every frame "
+                    "(a slower graphics card)\n", loops, g_ld_sg_groups);
+}
+static void ld_slow_gpu_frame(void)
+{
+    if (g_ld_sg_cfg < 0) ld_slow_gpu_init();
+    if (g_ld_sg_cfg <= 0 || g.srv_ring_used >= SRV_RING_TABLES) return;
+    const u32 base = g.srv_ring_used++ * SRV_TABLE_SIZE;
+    D3D12_CPU_DESCRIPTOR_HANDLE dst = ld_heap_cpu(g.srv_heap, &g_hs_srv), src;
+    dst.ptr += (size_t)base * g.srv_step;
+    g_ld_sg_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(g_ld_sg_heap, &src);
+    g.dev->lpVtbl->CopyDescriptorsSimple(g.dev, 1, dst, src, D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    D3D12_GPU_DESCRIPTOR_HANDLE gpu = ld_heap_gpu(g.srv_heap, &g_hs_srv);
+    gpu.ptr += (u64)base * g.srv_step;
+    ld_bound_invalidate();   /* the dispatch records its own state */
+    ID3D12DescriptorHeap* heaps[] = {g.srv_heap, g.smp_heap};
+    LDL->lpVtbl->SetDescriptorHeaps(LDL, 2, heaps);
+    LDL->lpVtbl->SetPipelineState(LDL, g_ld_sg_pso);
+    LDL->lpVtbl->SetComputeRootSignature(LDL, g_ld_sg_rs);
+    LDL->lpVtbl->SetComputeRootDescriptorTable(LDL, 0, gpu);
+    LDL->lpVtbl->Dispatch(LDL, g_ld_sg_groups, 1, 1);
+}
+
 static void sink_flip(void* user, const rsx_dispatch* r, u32 arg)
 {
     ld_begin_recording();
     (void)user; (void)r;
+    if (g_ld_sg_cfg) ld_slow_gpu_frame();   /* patch 0075: RSX_TEST_SLOW_GPU (test hook) */
+    if (g_gp.on > 0) {   /* patch 0075: what the GPU reads from the upload heaps this frame ([gpu-pass] line) */
+        g_ld_up[0] += g.vb_used; g_ld_up[1] += g.ib_used; g_ld_up[2] += g.cb_used; g_ld_up[3] += g.ps_cb_used;
+        g_ld_up[4] += g.upload_used; g_ld_up_frames++;
+    }
     const u32 buffer_id = arg & 7u;
     g_ld_flip_requested++;
     g_ld_last_requested_buffer = buffer_id;

+/* Depth-format units whose TEX_ADDRESS carries a compare function are shadow samplers: RSX returns
+ * `texel ZFUNC reference` (2x2 PCF when the unit filters linearly), not the depth. Without this a
+ * plain sample of the depth snapshot is (d, 0, 0): the lighting terms that multiply by (1 - sample)
+ * shadow only the red channel, so everything inside the light's frustum gets a cyan cast.
+ * Same selection as rsx_live_draw.c, whose pipeline identity also includes it. */
+static u32 eng_shadow_units(u32 func[16], u32* linear_out, u32 cube_mask)
+{
+    u32 mask = 0, linear = 0;
+    for (u32 u = 0; u < RSX_DSP_NUM_TEXTURES && u < 16; u++) {
+        func[u] = 0;
+        rsx_dsp_texture t;
+        rsx_dsp_get_texture(&g.rsx, u, &t);
+        if (!t.enabled || t.cubemap || ((cube_mask >> u) & 1u)) continue;
+        const u32 bf = t.format & RSX_TEX_FMT_BASE_MASK;
+        const u32 zf = (t.wrap >> 28) & 0xFu;
+        if (bf >= 0x90u && bf <= 0x93u && zf != 0u && zf < 7u && !(t.control0 & 0x4u)) {

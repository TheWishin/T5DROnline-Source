+int     host_sched_sleep_us(uint64_t usec) { (void)usec; return 0; }
+int     host_sched_sleep_subms(uint64_t usec) { (void)usec; return 0; }
+int64_t host_sched_spin_ticks(void) { return 0; }
+void    host_sched_trace_(int kind, uint32_t arg) { (void)kind; (void)arg; }
+void    host_sched_trace_tid(int kind, uint32_t arg, uint32_t tid) { (void)kind; (void)arg; (void)tid; }
+void host_sched_trace_tag(uint32_t tid) { (void)tid; }
+void host_sched_trace_at(int kind, uint32_t arg, int64_t qpc) { (void)kind; (void)arg; (void)qpc; }
+void host_sched_trace_tid_at(int kind, uint32_t arg, uint32_t tid, int64_t qpc) { (void)kind; (void)arg; (void)tid; (void)qpc; }
+int64_t host_sched_qpc(void) { return 0; }

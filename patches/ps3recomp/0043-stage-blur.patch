diff --git a/libs/video/rsx_fp_decompiler.c b/libs/video/rsx_fp_decompiler.c
index 5e47a49..ade876d 100644
--- a/libs/video/rsx_fp_decompiler.c
+++ b/libs/video/rsx_fp_decompiler.c
@@ -130,6 +130,33 @@ u32 rsx_fp_texture_mask(const u8* ucode, u32 max_bytes)
     return mask;
 }
 
+u32 rsx_fp_texture_tap_mask(const u8* ucode, u32 max_bytes)
+{
+    if (!ucode) return 0;
+    u32 off = 0, once = 0, twice = 0;
+    while (off + 16 <= max_bytes) {
+        u32 w0 = rsx_fp_read_word(ucode + off + 0);
+        u32 w1 = rsx_fp_read_word(ucode + off + 4);
+        u32 w2 = rsx_fp_read_word(ucode + off + 8);
+        u32 w3 = rsx_fp_read_word(ucode + off + 12);
+        off += 16;
+        const u32 op = (w0 & FP_OPCODE_MASK) >> FP_OPCODE_SHIFT;
+        if (!(w2 & FP_BRANCH) &&
+            (op == OP_TEX || op == OP_TXP || op == OP_TXD || op == OP_TXL || op == OP_TXB)) {
+            const u32 bit = 1u << ((w0 & FP_TEX_UNIT_MASK) >> FP_TEX_UNIT_SHIFT);
+            twice |= once & bit;
+            once |= bit;
+        }
+        if (((w1 & FP_REG_TYPE_MASK) >> FP_REG_TYPE_SHIFT) == FP_REG_TYPE_CONST ||
+            ((w2 & FP_REG_TYPE_MASK) >> FP_REG_TYPE_SHIFT) == FP_REG_TYPE_CONST ||
+            ((w3 & FP_REG_TYPE_MASK) >> FP_REG_TYPE_SHIFT) == FP_REG_TYPE_CONST) {
+            if (off + 16 <= max_bytes) off += 16;
+        }
+        if (w0 & FP_END) break;
+    }
+    return twice;
+}
+
 u32 rsx_fp_program_size(const u8* ucode, u32 max_bytes)
 {
     if (!ucode) return 0;
@@ -1427,3 +1454,129 @@ int rsx_fp_apply_shadow_compare(char* hlsl, u32 hlsl_size, u32 shadow_mask,
     memcpy(main_at, helper, hl);
     return patched;
 }
+
+/* Single-tap sampling for filter kernels (PS3_STAGE_BLUR=0, rsx_live_draw.c).
+ *
+ * Tekken 5 DR's stage post effects are fragment programs that read one render
+ * target several times at offsets: the soft-focus downsample of the 3D pass
+ * (a centre tap and three taps two texels away, then a colour curve) and the
+ * glow's blur passes (four diagonal taps). Pointing every tap of such a unit at
+ * one coordinate leaves the rest of the program as it is (the colour curve,
+ * the weights, which sum to one): the picture without the blur.
+ *
+ * Which coordinate: the centre tap when the kernel has one -- the tap nearest
+ * the mean of all taps and less than half the kernel's radius from it (the
+ * soft-focus kernel's mean is 0.37 texel from its centre tap, its radius 2.4)
+ * -- else the mean itself (a symmetric kernel without a centre: the mean is
+ * the pixel's own position). Taps that are not plain interpolated inputs
+ * (a coordinate computed in the program, a dependent read) leave the unit
+ * unchanged: the coordinate is evaluated once at the top of main. */
+static int fp_tap_arg_is_input(const char* a, u32 n)
+{
+    /* "((input.tcN).xyzw).xy" and other swizzles of interpolants, or a
+     * projective "(A).xy / (A).w" of one: input.* names only, no temporaries,
+     * condition registers or constants */
+    int input = 0;
+    for (u32 i = 0; i < n; i++) {
+        if (i + 1 < n && (a[i] == 'r' || a[i] == 'h') && a[i + 1] == '[') return 0;
+        if (i + 2 < n && a[i] == 'c' && a[i + 1] == 'c' && (a[i + 2] == '0' || a[i + 2] == '1')) return 0;
+        if (i + 3 <= n && !strncmp(a + i, "fp_", 3)) return 0;
+        if (i + 6 <= n && !strncmp(a + i, "input.", 6)) input = 1;
+    }
+    return input;
+}
+
+int rsx_fp_apply_single_tap(char* hlsl, u32 hlsl_size, u32 unit_mask, u32 cube_mask)
+{
+    if (!hlsl || !unit_mask) return 0;
+    int units = 0;
+    for (u32 u = 0; u < 16; u++) {
+        if (!((unit_mask >> u) & 1u) || ((cube_mask >> u) & 1u)) continue;
+        char needle[48];
+        snprintf(needle, sizeof needle, "rsx_tex[%u].Sample(rsx_samp[%u], ", u, u);
+        const u32 nlen = (u32)strlen(needle);
+        /* pass 1: the distinct coordinate texts; all must be interpolants */
+        enum { MAX_TAPS = 16 };
+        const char* arg[MAX_TAPS];
+        u32 alen[MAX_TAPS];
+        u32 n = 0, sites = 0;
+        int ok = 1;
+        for (const char* at = strstr(hlsl, needle); at; at = strstr(at + nlen, needle)) {
+            const char* a = at + nlen;
+            int depth = 1;
+            const char* e = a;
+            for (; *e; e++) {
+                if (*e == '(') depth++;
+                else if (*e == ')' && !--depth) break;
+            }
+            if (*e != ')') return -1;
+            const u32 len = (u32)(e - a);
+            sites++;
+            if (!fp_tap_arg_is_input(a, len)) { ok = 0; break; }
+            u32 k = 0;
+            while (k < n && !(alen[k] == len && !strncmp(arg[k], a, len))) k++;
+            if (k == n) {
+                if (n == MAX_TAPS) { ok = 0; break; }
+                arg[n] = a; alen[n] = len; n++;
+            }
+        }
+        if (!ok || n < 2) continue;
+        /* the coordinate, computed at the top of main */
+        u32 cap = 512;
+        for (u32 k = 0; k < n; k++) cap += 4 * alen[k] + 192;
+        char* code = (char*)malloc(cap);
+        if (!code) return -1;
+        u32 m = 0;
+#define FP_EMIT(...) do { const int w_ = snprintf(code + m, cap - m, __VA_ARGS__);              \
+                          if (w_ < 0 || (u32)w_ >= cap - m) { free(code); return -1; }          \
+                          m += (u32)w_; } while (0)
+        FP_EMIT("\n    float2 rsx_tap%u = (", u);
+        for (u32 k = 0; k < n; k++) FP_EMIT("%s(%.*s)", k ? " + " : "", (int)alen[k], arg[k]);
+        FP_EMIT(") / %u.0;\n    { float2 _b = rsx_tap%u; float _dmin = 3.4e38, _dmax = 0.0, _d;\n", n, u);
+        for (u32 k = 0; k < n; k++)
+            FP_EMIT("      _d = dot((%.*s) - rsx_tap%u, (%.*s) - rsx_tap%u);"
+                    " if (_d < _dmin) { _dmin = _d; _b = (%.*s); } _dmax = max(_dmax, _d);\n",
+                    (int)alen[k], arg[k], u, (int)alen[k], arg[k], u, (int)alen[k], arg[k]);
+        FP_EMIT("      if (_dmin < 0.25 * _dmax) rsx_tap%u = _b; }\n", u);
+#undef FP_EMIT
+        /* pass 2: every call site of the unit reads rsx_tapU (the texts were
+         * copied into `code` above, so rewriting them is safe now) */
+        char repl[16];
+        snprintf(repl, sizeof repl, "rsx_tap%u", u);
+        const u32 rlen = (u32)strlen(repl);
+        if ((u32)strlen(hlsl) + m + sites * rlen + 1 > hlsl_size) {   /* room for all of it, before any change */
+            free(code);
+            return -1;
+        }
+        for (;;) {
+            char* at = strstr(hlsl, needle);
+            if (!at) break;
+            char* a = at + nlen;
+            int depth = 1;
+            char* e = a;
+            for (; *e; e++) {
+                if (*e == '(') depth++;
+                else if (*e == ')' && !--depth) break;
+            }
+            const u32 used = (u32)strlen(hlsl);
+            const u32 old_len = (u32)(e - a);
+            if (used - old_len + rlen + 1 > hlsl_size) { free(code); return -1; }
+            memmove(a + rlen, e, used - (u32)(e - hlsl) + 1);
+            memcpy(a, repl, rlen);
+            memcpy(at, "rsx_TEX", 7);        /* done; restored below */
+        }
+        for (char* q = hlsl; (q = strstr(q, "rsx_TEX")) != NULL; ) memcpy(q, "rsx_tex", 7);
+        /* insert after the opening brace of main */
+        char* mb = strstr(hlsl, " main(PSInput input)");
+        mb = mb ? strchr(mb, '{') : NULL;
+        if (!mb) { free(code); return -1; }
+        mb++;
+        const u32 used = (u32)strlen(hlsl);
+        if (used + m + 1 > hlsl_size) { free(code); return -1; }
+        memmove(mb + m, mb, used - (u32)(mb - hlsl) + 1);
+        memcpy(mb, code, m);
+        free(code);
+        units++;
+    }
+    return units;
+}

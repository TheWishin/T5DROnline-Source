+        return CELL_HTTP_ERROR_NOT_FOUND;
+    s_clients[clientId].recv_timeout = (u32)usec;
+    printf("[cellHttp] ClientSetRecvTimeout(id=%u, %lld us)\n", clientId, (long long)usec);
+    return CELL_OK;
+}

+/* ---------------------------------------------------------------------------
+ * The waiting PPU thread runs jobs too (patch 0064)
+ *
+ * Tekken 5 DR kicks its skinning chain once a frame, does 3-4 ms of other work,
+ * then blocks in sys_event_queue_receive on the chain's queue until the job list
+ * is done. On a 4-processor PC (the walker and one worker run the list) it
+ * blocked on ~60 % of fight frames, 1.3 ms at the median, 2.8 ms at p90 -- with
+ * its own processor idle. Now a PPU thread about to block on a queue SPURS
+ * attached first takes jobs from the open list, like one more worker, and blocks
+ * only when none are left (then just for the jobs still running elsewhere).
+ * Nothing in a job depends on the thread that runs it: the jobs of a list are
+ * independent, each one works in its own local store from its own descriptor,
+ * and the list's completion is still signalled by the chain's own job after the
+ * SYNC, on the walker. SPURS_JOB_HELP=0: the old wait.
+ * -----------------------------------------------------------------------*/
+static int jl_help_on(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("SPURS_JOB_HELP"); v = !(e && *e == '0'); }
+    return v;
+}

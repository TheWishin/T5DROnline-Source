+/* spu_selfcheck.h -- in-game check of patch 0064's helpers (test builds only:
+ * compile the lifted SPU code with /DSPU_SELFCHECK). Every call of a helper that
+ * 0064 rewrote also runs the code it replaced (the scalar _ref loops, the 0041
+ * near-float ops) on the same operands and counts any difference; a line every
+ * 2^24 checks and at the first mismatches. Included at the end of spu_helpers.h
+ * with SPU_SELFCHECK (CMake: -DT5DR_SPU_COPTS=/DSPU_SELFCHECK).  */
+#ifndef SPU_SELFCHECK_H
+#define SPU_SELFCHECK_H
+#include <stdio.h>
+
+SPU_GATE volatile long long g_spu_sc_checks = 0;
+SPU_GATE volatile long long g_spu_sc_bad = 0;
+SPU_GATE volatile long long g_spu_sc_per[32];
+static const char* const spu_sc_names[32] = {
+    "rotqby", "shlqby", "rotqbybi", "shlqbybi", "rotqmby", "rotqmbybi", "rotqbyi", "shlqbyi", "rotqmbyi",
+    "cbd", "chd", "cwd", "cdd", "cbx", "chx", "cwx", "cdx", "fsm", "fsmh", "fsmb", "shufb",
+    "fa", "fs", "fm", "fma", "fms", "fnms", "", "", "", "", "" };
+static __attribute__((noinline, cold)) void spu_sc_report(int op, u128 got, u128 want)
+{
+    const long long b = __atomic_add_fetch(&g_spu_sc_bad, 1, __ATOMIC_RELAXED);
+    if (b <= 20)
+        fprintf(stderr, "[spu-selfcheck] MISMATCH %s: new %08X %08X %08X %08X old %08X %08X %08X %08X\n",
+                spu_sc_names[op], got._u32[0], got._u32[1], got._u32[2], got._u32[3],
+                want._u32[0], want._u32[1], want._u32[2], want._u32[3]);
+}
+static __attribute__((noinline, cold)) void spu_sc_line(long long n)
+{
+    char buf[700]; int o = 0;
+    o += snprintf(buf + o, sizeof buf - o, "[spu-selfcheck] %lld checks, %lld mismatches;", n, g_spu_sc_bad);
+    for (int i = 0; i < 27; i++)
+        if (g_spu_sc_per[i]) o += snprintf(buf + o, sizeof buf - o, " %s %lld", spu_sc_names[i], g_spu_sc_per[i]);
+    fprintf(stderr, "%s\n", buf);
+}
+static inline u128 spu_sc(int op, u128 got, u128 want)
+{
+    if (memcmp(&got, &want, 16)) spu_sc_report(op, got, want);
+    __atomic_fetch_add(&g_spu_sc_per[op], 1, __ATOMIC_RELAXED);
+    const long long n = __atomic_add_fetch(&g_spu_sc_checks, 1, __ATOMIC_RELAXED);
+    if ((n & ((1ll << 24) - 1)) == 0) spu_sc_line(n);
+    return got;
+}

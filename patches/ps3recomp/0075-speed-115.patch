+/* ---- 2-core mode (t5dr patch 0075) ------------------------------------------------
+ * Players with 2 physical cores (i3-3240, i5-4210M: 2 cores / 4 threads) stayed under
+ * ~20 fps where a 4-core i5-2500 of the same per-core speed reached 55-60. The plan
+ * was: the game thread on a core of its own (no busy helper on its Hyper-Threading
+ * sibling), fewer workers, no spinning. Measured on a 2-core / 4-thread stand-in
+ * (2 cores of the 7950X by affinity, tools/slow_core.py taking 70-78 % of them;
+ * docs/RENDER_PERF.md "2-core mode and slow graphics cards"): the game thread's
+ * own core cost 21-33 % fps (everything else -- translation, renderer, sound core,
+ * skinning, the game's helper threads -- on one core: the translation 2.3 -> 7.3
+ * ms), the translation decoding its own vertices (no vertex worker) 12 %, with one
+ * SPURS job thread too 18 %; no spinning alone changed nothing measurable (20-30 %
+ * more context switches instead). So
+ * with 2 cores or fewer (mode < 0 = auto) or when asked (mode 1) the pools stay as
+ * hsp_pools sizes them and, with SMT, only the ideal processors change: the game
+ * thread on the best-ranked core (not processor 0's), the translation and the
+ * sound core on the two logical processors of the other one (hsp_make's three
+ * cores wrapped round with 2 and put the sound core on the game thread's
+ * processor). own_sets (PS3_TWO_CORE_OWN=1, for a player to try on a real 2-core
+ * PC) adds the CPU sets: the game thread's core for it alone -- both logical
+ * processors -- and the other core for every other thread of the frame; host_sched.c
+ * then makes that core the process's default CPU set too (the driver's, the audio
+ * device's and the loaders' threads). game_own: where the game's helper threads
+ * (guest PPU threads below lv2 priority 1002: the draw request managers the game
+ * thread hands the frame to and waits for) go then -- 0 the other core, 1 the game
+ * thread's core, 2 anywhere. */
+static inline void hsp_two_core(const hsp_cpu* c, int n, int mode, int budget, int budget_cores, int laptop,
+                                int own_sets, int game_own, hsp_plan* p)
+{
+    p->two_core = p->own_core = 0;
+    p->own = p->rest = 0;
+    const int cores = budget > 0 ? (budget_cores > 0 ? budget_cores : budget) : p->cores;
+    if (mode == 0 || (mode < 0 && cores > 2)) { hsp_pools(p, budget, budget_cores, laptop); return; }
+    p->two_core = 1;
+    /* the cores need a real 2-core table with SMT in the mask (PS3_CPUS alone sizes the pools only) */
+    if (c && n > 0 && p->cores == 2 && p->smt && !p->hybrid) {
+        int r[2];
+        const int nr = hsp_rank(c, n, p->all, r, 2);
+        uint64_t own = 0;
+        if (nr == 2)
+            for (int i = 0; i < n; i++)
+                if (hsp_allowed(&c[i], p->all) && c[i].core == c[r[0]].core) own |= 1ull << c[i].lp;
+        const uint64_t rest = p->all & ~own;
+        if (own && rest) {
+            p->own = own; p->rest = rest;
+            /* ideal processors: the game thread on its core, the translation and the sound core on the
+             * two logical processors of the other one -- never the sound core on the game thread's
+             * processor (hsp_make's third core wraps round to the first with 2 cores) */
+            p->ideal[HSP_MAIN] = c[r[0]].lp;
+            int a = -1, b = -1;
+            for (int i = 0; i < n; i++) {
+                if (!hsp_allowed(&c[i], rest)) continue;
+                if (a < 0) a = c[i].lp; else if (b < 0) b = c[i].lp;
+            }
+            p->ideal[HSP_TICKER] = a;
+            p->ideal[HSP_SPU] = b >= 0 ? b : a;
+            if (own_sets) {
+                p->own_core = 1;
+                p->set[HSP_MAIN] = own;
+                p->set[HSP_TICKER] = p->set[HSP_SPU] = p->set[HSP_SPURS] = p->set[HSP_VERTEX] = rest;
+                p->set[HSP_GAME] = game_own == 1 ? own : game_own == 2 ? 0 : rest;
+            }
+        }
+    }
+    hsp_pools(p, budget, budget_cores, laptop);
+}

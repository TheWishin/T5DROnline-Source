+static DWORD WINAPI ld_prewarm_thread(LPVOID unused)
+{
+    (void)unused;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    FILE* f = fopen(g_prewarm_path, "rb");
+    u64 stamp = 0;
+    u32 n = 0, failed = 0;
+    if (f && fread(&stamp, sizeof(stamp), 1, f) == 1 && stamp == g_prewarm_stamp) {
+        ld_prewarm_rec r;
+        u8* buf = NULL; u32 cap = 0;
+        while (fread(&r, sizeof(r), 1, f) == 1) {
+            if (r.magic != LD_PREWARM_MAGIC || r.total_bytes != sizeof(r) + r.vs_len + r.ps_len ||
+                r.vs_len > (4u << 20) || r.ps_len > (4u << 20) || r.n_il > 16 || r.num_rt > 8)
+                break;
+            const u32 need = r.vs_len + r.ps_len;
+            if (need > cap) { u8* nb = (u8*)realloc(buf, need); if (!nb) break; buf = nb; cap = need; }
+            if (fread(buf, 1, need, f) != need) break;
+            ld_prewarm_slot* s = ld_prewarm_slot_for(r.key, 1);
+            if (!s || s->pso) continue;            /* full, or a duplicate record */

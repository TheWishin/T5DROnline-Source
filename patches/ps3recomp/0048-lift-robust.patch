+def _test_hook(name, k):
+    """Test only: T5DR_LIFT_TEST_KILL / T5DR_LIFT_TEST_HANG = chunk numbers (0-based,
+    comma-separated) at which a worker process dies (os._exit) / stops working."""
+    v = os.environ.get(name, "")
+    return bool(v) and str(k) in {s.strip() for s in v.split(",")}
+

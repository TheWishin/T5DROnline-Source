+constexpr long long SECOND=10000000, FRAME=SECOND/FPS;
+constexpr size_t SEGMENT_CAP=8*1024*1024, RING_CAP=64*1024*1024;
+struct Failure { HRESULT hr; };
+void check(HRESULT hr) { if (FAILED(hr)) throw Failure{hr}; }
+
+/* IStream instead of an unbounded HGLOBAL: even a broken encoder cannot grow
+ * the current segment past 8 MiB. Capacity and seek overflow checked before IO. */
+class MemoryStream final : public IStream {
+    std::atomic<ULONG> refs{1};
+    ULONGLONG pos=0;
+public:
+    std::vector<unsigned char> data;
+    MemoryStream() { data.reserve(SEGMENT_CAP); }
+    HRESULT STDMETHODCALLTYPE QueryInterface(REFIID id, void** out) override {
+        if (!out) return E_POINTER;
+        *out=nullptr;
+        if (id==IID_IUnknown || id==IID_ISequentialStream || id==IID_IStream) {
+            *out=static_cast<IStream*>(this); AddRef(); return S_OK;
+        }
+        return E_NOINTERFACE;
+    }
+    ULONG STDMETHODCALLTYPE AddRef() override { return ++refs; }
+    ULONG STDMETHODCALLTYPE Release() override { ULONG r=--refs; if(!r) delete this; return r; }
+    HRESULT STDMETHODCALLTYPE Read(void* dst, ULONG n, ULONG* got) override {
+        ULONG count=pos<data.size()?static_cast<ULONG>(std::min<ULONGLONG>(n,data.size()-pos)):0;
+        if(count) memcpy(dst,data.data()+pos,count);
+        pos+=count; if(got)*got=count; return count==n?S_OK:S_FALSE;
+    }
+    HRESULT STDMETHODCALLTYPE Write(const void* src, ULONG n, ULONG* put) override {
+        if(put)*put=0;
+        if(pos>SEGMENT_CAP || n>SEGMENT_CAP-pos) return STG_E_MEDIUMFULL;
+        try { if(pos+n>data.size()) data.resize(static_cast<size_t>(pos+n)); }
+        catch(...) { return E_OUTOFMEMORY; }
+        if(n) memcpy(data.data()+pos,src,n);
+        pos+=n; if(put)*put=n; return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE Seek(LARGE_INTEGER d, DWORD origin, ULARGE_INTEGER* result) override {
+        LONGLONG base=origin==STREAM_SEEK_SET?0:origin==STREAM_SEEK_CUR?pos:origin==STREAM_SEEK_END?data.size():-1;
+        if(base<0 || d.QuadPart < -base || d.QuadPart > static_cast<LONGLONG>(SEGMENT_CAP)-base) return STG_E_INVALIDFUNCTION;
+        pos=base+d.QuadPart; if(result) result->QuadPart=pos; return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE SetSize(ULARGE_INTEGER n) override {
+        if(n.QuadPart>SEGMENT_CAP)return STG_E_MEDIUMFULL;
+        try {data.resize(static_cast<size_t>(n.QuadPart));} catch(...) {return E_OUTOFMEMORY;} return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE CopyTo(IStream* dst, ULARGE_INTEGER n, ULARGE_INTEGER* rd, ULARGE_INTEGER* wr) override {
+        ULONG count=pos<data.size()?static_cast<ULONG>(std::min<ULONGLONG>(n.QuadPart,data.size()-pos)):0, put=0;
+        HRESULT hr=dst->Write(count?data.data()+pos:nullptr,count,&put); pos+=put;
+        if(rd)rd->QuadPart=put; if(wr)wr->QuadPart=put; return hr;
+    }
+    HRESULT STDMETHODCALLTYPE Commit(DWORD) override {return S_OK;}
+    HRESULT STDMETHODCALLTYPE Revert() override {return E_NOTIMPL;}
+    HRESULT STDMETHODCALLTYPE LockRegion(ULARGE_INTEGER,ULARGE_INTEGER,DWORD) override {return STG_E_INVALIDFUNCTION;}
+    HRESULT STDMETHODCALLTYPE UnlockRegion(ULARGE_INTEGER,ULARGE_INTEGER,DWORD) override {return STG_E_INVALIDFUNCTION;}
+    HRESULT STDMETHODCALLTYPE Stat(STATSTG* s,DWORD) override {
+        if(!s)return E_POINTER; memset(s,0,sizeof(*s));s->type=STGTY_STREAM;s->cbSize.QuadPart=data.size();s->grfMode=STGM_READWRITE;return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE Clone(IStream**) override {return E_NOTIMPL;}
+};

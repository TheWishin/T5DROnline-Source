+/* ---- a decoder made ahead of time (patch 0053) ------------------------------
+ * One background thread makes one decoder; the first movie takes it. States:
+ * 0 none, 1 being made, 2 ready (s_pw_dec), 3 failed. Taking a ready one sets
+ * the state back to 0, so mfh264_prewarm can make the next one. */
+static SRWLOCK s_pw_lock = SRWLOCK_INIT;
+static CONDITION_VARIABLE s_pw_cv = CONDITION_VARIABLE_INIT;
+static int s_pw_state = 0;
+static MfH264* s_pw_dec = NULL;
+
+static DWORD WINAPI prewarm_thread(LPVOID)
+{
+    /* normal priority: below normal it took up to 10 s on a busy PC */
+    LARGE_INTEGER f, t0, t1;
+    QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&t0);
+    MfH264* d = mfh264_create();
+    QueryPerformanceCounter(&t1);
+    AcquireSRWLockExclusive(&s_pw_lock);
+    s_pw_dec = d;
+    s_pw_state = d ? 2 : 3;
+    WakeAllConditionVariable(&s_pw_cv);
+    ReleaseSRWLockExclusive(&s_pw_lock);
+    if (d)
+        fprintf(stderr, "[mf_h264] decoder ready ahead of the movie (%.0f ms, %d decoding thread(s))\n",
+                (double)(t1.QuadPart - t0.QuadPart) * 1000.0 / (double)f.QuadPart, worker_threads());
+    return 0;
+}
+
+extern "C" void mfh264_prewarm(void)
+{
+    const char* e = getenv("PS3_VDEC_PREWARM");
+    if (e && *e == '0') return;
+    if (!mf_present()) return;
+    AcquireSRWLockExclusive(&s_pw_lock);
+    const int start = s_pw_state == 0;
+    if (start) s_pw_state = 1;
+    ReleaseSRWLockExclusive(&s_pw_lock);
+    if (!start) return;
+    HANDLE th = CreateThread(NULL, 1u << 20, prewarm_thread, NULL, 0, NULL);
+    if (th) { CloseHandle(th); return; }
+    AcquireSRWLockExclusive(&s_pw_lock);
+    s_pw_state = 3;
+    WakeAllConditionVariable(&s_pw_cv);
+    ReleaseSRWLockExclusive(&s_pw_lock);
+}
+
+extern "C" MfH264* mfh264_take_prewarmed(uint32_t wait_ms)
+{
+    if (!mf_startup()) return NULL;   /* this thread joins the MTA the decoder lives in */
+    const ULONGLONG end = GetTickCount64() + wait_ms;
+    MfH264* d = NULL;
+    AcquireSRWLockExclusive(&s_pw_lock);
+    while (s_pw_state == 1) {
+        const ULONGLONG now = GetTickCount64();
+        if (now >= end) break;
+        SleepConditionVariableSRW(&s_pw_cv, &s_pw_lock, (DWORD)(end - now), 0);
+    }
+    if (s_pw_state == 2) {
+        d = s_pw_dec;
+        s_pw_dec = NULL;
+        s_pw_state = 0;
+    }
+    ReleaseSRWLockExclusive(&s_pw_lock);
+    return d;
+}

+/* Patch 0059: the CPU use around the game since the previous call -- what a
+ * [slow-frames] line needs to tell "this PC is too slow" from "other programs
+ * took the processors" (a browser, a recorder, an update, a virus scan):
+ *   other programs 5.2 of 8 logical processors busy, the game 2.1 (of 4 it may use)
+ * GetSystemTimes counts every processor of the machine; the game's share is
+ * GetProcessTimes; "may use" is the affinity budget (PS3_CPUS). */
+int host_sched_load_text(char* buf, int len)
+{
+    static ULONGLONG s_idle, s_busy, s_proc, s_wall;
+    if (!buf || len <= 0) return 0;
+    buf[0] = 0;
+    FILETIME fi, fk, fu, c, e, pk, pu;
+    if (!GetSystemTimes(&fi, &fk, &fu) || !GetProcessTimes(GetCurrentProcess(), &c, &e, &pk, &pu)) return 0;
+#define HS_FT(t) (((ULONGLONG)(t).dwHighDateTime << 32) | (t).dwLowDateTime)
+    const ULONGLONG idle = HS_FT(fi), busy = HS_FT(fk) + HS_FT(fu) - HS_FT(fi);   /* kernel time includes idle */
+    const ULONGLONG proc = HS_FT(pk) + HS_FT(pu);
+#undef HS_FT
+    LARGE_INTEGER q, f;
+    QueryPerformanceCounter(&q);
+    QueryPerformanceFrequency(&f);
+    const ULONGLONG wall = (ULONGLONG)((double)q.QuadPart * 1e7 / (double)f.QuadPart);   /* 100 ns units */
+    int ok = 0;
+    if (s_wall && wall > s_wall + 10000000ull && busy >= s_busy && proc >= s_proc) {
+        const double span = (double)(wall - s_wall);
+        const double all = (double)(busy - s_busy) / span, game = (double)(proc - s_proc) / span;
+        const double other = all > game ? all - game : 0.0;
+        SYSTEM_INFO si;
+        GetSystemInfo(&si);
+        snprintf(buf, (size_t)len, "other programs %.1f of %lu logical processors busy, the game %.1f (of %d it may use)",
+                 other, (unsigned long)si.dwNumberOfProcessors, game, host_sched_cpus());
+        ok = 1;
+    }
+    (void)idle;
+    s_idle = idle; s_busy = busy; s_proc = proc; s_wall = wall;
+    return ok;
+}

+/* Copy the guest rect (sx, sy, w, h) of surface si to (dx, dy) of surface di.
+ * Both are in RENDER_TARGET state before and after. Returns 1 when copied. */
+static int ld_surface_copy(u32 si, u32 sx, u32 sy, u32 di, u32 dx, u32 dy, u32 w, u32 h)
+{
+    surface_t* S = &g.surfaces[si];
+    surface_t* D = &g.surfaces[di];
+    u32 sl = ld_pxs(sx, S->scale), st = ld_pxs(sy, S->scale);
+    u32 sr = ld_pxs(sx + w, S->scale), sb = ld_pxs(sy + h, S->scale);
+    u32 dl = ld_pxs(dx, D->scale), dt = ld_pxs(dy, D->scale);
+    u32 dr = ld_pxs(dx + w, D->scale), db = ld_pxs(dy + h, D->scale);
+    if (sr > S->pw) sr = S->pw;
+    if (sb > S->ph) sb = S->ph;
+    if (dr > D->pw) dr = D->pw;
+    if (db > D->ph) db = D->ph;
+    if (sl >= sr || st >= sb || dl >= dr || dt >= db) return 0;
+    D3D12_RESOURCE_BARRIER b[2] = {0};
+    for (int k = 0; k < 2; k++) {
+        b[k].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        b[k].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        b[k].Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    }
+    if (S->scale == D->scale || !ld_copy_pipeline() ||
+        (D->fmt != DXGI_FORMAT_R8G8B8A8_UNORM && D->fmt != DXGI_FORMAT_R16G16B16A16_FLOAT)) {
+        /* 1:1 in host pixels: the clipped source rect lands at the destination */
+        D3D12_BOX box = { sl, st, 0, sr, sb, 1 };
+        if (dl + (box.right - box.left) > D->pw) box.right = box.left + D->pw - dl;
+        if (dt + (box.bottom - box.top) > D->ph) box.bottom = box.top + D->ph - dt;
+        b[0].Transition.pResource = S->tex; b[0].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+        b[1].Transition.pResource = D->tex; b[1].Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_DEST;
+        g.list->lpVtbl->ResourceBarrier(g.list, 2, b);
+        D3D12_TEXTURE_COPY_LOCATION s = {0}, d = {0};
+        s.pResource = S->tex; s.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        d.pResource = D->tex; d.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        g.list->lpVtbl->CopyTextureRegion(g.list, &d, dl, dt, 0, &s, &box);
+        for (int k = 0; k < 2; k++) {
+            b[k].Transition.StateBefore = b[k].Transition.StateAfter;
+            b[k].Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+        }
+        g.list->lpVtbl->ResourceBarrier(g.list, 2, b);
+        return 1;
+    }
+    if (g.srv_ring_used + 1u > SRV_RING_TABLES) {
+        ld_flush(LD_FLUSH_DESCRIPTOR_RING);
+        if (!g.ready) return 0;
+        g.srv_ring_used = 0;
+        g.smp_ring_used = 0;
+    }
+    const u32 base = g.srv_ring_used++ * SRV_TABLE_SIZE;
+    D3D12_CPU_DESCRIPTOR_HANDLE cpu;
+    D3D12_GPU_DESCRIPTOR_HANDLE gpu;
+    g.srv_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(g.srv_heap, &cpu);
+    g.srv_heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(g.srv_heap, &gpu);
+    cpu.ptr += (size_t)base * g.srv_step;
+    gpu.ptr += (u64)base * g.srv_step;
+    g.dev->lpVtbl->CopyDescriptorsSimple(g.dev, 1, cpu, srv_cpu(SRV_SURFACE_BASE + si),
+                                         D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    b[0].Transition.pResource = S->tex;
+    b[0].Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, b);
+    /* Viewport over the whole source texture in destination pixels: uv is then
+     * the source coordinate of every destination pixel; the scissor keeps the
+     * destination rect. */
+    const float kx = (float)(sr - sl) / (float)(dr - dl), ky = (float)(sb - st) / (float)(db - dt);
+    D3D12_VIEWPORT vp = { (float)dl - (float)sl / kx, (float)dt - (float)st / ky,
+                          (float)S->pw / kx, (float)S->ph / ky, 0.0f, 1.0f };
+    const D3D12_RECT sc = { (LONG)dl, (LONG)dt, (LONG)dr, (LONG)db };
+    const D3D12_CPU_DESCRIPTOR_HANDLE rtv = rtv_handle(LD_SWAP_BUFFERS + di);
+    ID3D12DescriptorHeap* heaps[] = {g.srv_heap, g.smp_heap};
+    g.list->lpVtbl->SetDescriptorHeaps(g.list, 2, heaps);
+    g.list->lpVtbl->OMSetRenderTargets(g.list, 1, &rtv, FALSE, NULL);
+    g.list->lpVtbl->SetGraphicsRootSignature(g.list, g_ld_copy.rootsig);
+    g.list->lpVtbl->SetGraphicsRootDescriptorTable(g.list, 0, gpu);
+    g.list->lpVtbl->SetPipelineState(g.list, D->fmt == DXGI_FORMAT_R16G16B16A16_FLOAT
+                                                 ? g_ld_copy.pso_rgba16f : g_ld_copy.pso_rgba8);
+    g.list->lpVtbl->RSSetViewports(g.list, 1, &vp);
+    g.list->lpVtbl->RSSetScissorRects(g.list, 1, &sc);
+    g.list->lpVtbl->IASetPrimitiveTopology(g.list, D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    g.list->lpVtbl->DrawInstanced(g.list, 3, 1, 0, 0);
+    b[0].Transition.StateBefore = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    b[0].Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, b);
+    { static u32 n = 0;
+      if (n++ < 8)
+          fprintf(stderr, "[res] scaled copy surface %u (x%.3g) -> %u (x%.3g), guest %ux%u\n",
+                  si, (double)S->scale, di, (double)D->scale, w, h); }
+    return 1;
+}

+/* Patch 0035: the game window was closed (Alt+F4, the X button, Esc). The
+ * ticker used to drop its RSX work and carry on: no FIFO walk, no present, the
+ * flips completed only by cellGcmTickFlip's 1-second safety valve ("queued
+ * flip never reached by the FIFO walker" x8) -- a windowless game at ~1 frame
+ * a second that kept its netplay session (the opponent stalled, then went out
+ * of sync) and that its launcher still saw running (T5DR 1.0.0 / 0.1.9 online
+ * reports; 0.1.8: an offline game left running an hour after its window was
+ * closed). A closed window now ends the process: the title's handler (if one
+ * is registered) first -- netplay tells the peer and writes "quit" into its
+ * result file, and picks the exit code -- otherwise exit code 0. */
+static void (*s_window_closed_handler)(void) = nullptr;
+extern "C" void ps3_set_window_closed_handler(void (*fn)(void)) { s_window_closed_handler = fn; }
+static void on_window_closed(void)
+{
+    fprintf(stderr, "[rsx] the game window was closed: the game ends\n");
+    fflush(stdout); fflush(stderr);
+    if (s_window_closed_handler) s_window_closed_handler();   /* may end the process itself */
+    fflush(stdout); fflush(stderr);
+#ifdef _WIN32
+    TerminateProcess(GetCurrentProcess(), 0);
+#else
+    _exit(0);
+#endif
+}

+/* "0xAAAA/0xBBBB,0xCCCC/0xDDDD" (SDL's format; "@file" = read the list from that file). */
+static void parse_vidpid_list(VidPidList* l, const char* v)
+{
+    memset(l, 0, sizeof *l);
+    if (!v || !*v) return;
+    char buf[4096]; size_t n = 0;
+    if (v[0] == '@') {
+        FILE* f = fopen(v + 1, "rb");
+        if (f) { n = fread(buf, 1, sizeof buf - 1, f); fclose(f); }
+    } else {
+        n = strlen(v); if (n > sizeof buf - 1) n = sizeof buf - 1;
+        memcpy(buf, v, n);
+    }
+    buf[n] = 0;
+    l->set = 1;
+    char* save = NULL;
+    for (char* tok = strtok_s(buf, ", \t\r\n", &save); tok; tok = strtok_s(NULL, ", \t\r\n", &save)) {
+        char* slash = strchr(tok, '/');
+        if (!slash) continue;
+        *slash = 0;
+        char* e1; char* e2;
+        unsigned long vid = strtoul(tok, &e1, 16), pid = strtoul(slash + 1, &e2, 16);
+        if (e1 == tok || e2 == slash + 1 || vid > 0xFFFF || pid > 0xFFFF) continue;
+        if (l->n < VIDPID_MAX) l->id[l->n++] = (u32)vid << 16 | (u32)pid;
+    }
+}

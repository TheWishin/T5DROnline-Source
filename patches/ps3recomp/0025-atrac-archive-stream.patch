+/* ---- the stream's own file ------------------------------------------------
+ *
+ * A rollback (src/rollback) rewinds the title's memory a few frames and
+ * re-simulates. The title's music stream reader is only half rewound with
+ * it: its chunk bookkeeping goes back, its staging buffer and this library
+ * do not -- so after a rollback it feeds this library a block's tail from
+ * the wrong buffer, a block's head a second time, or simply the chunks it
+ * had already fed, and the byte count it passes cannot tell these apart
+ * (docs/ROLLBACK.md section 18). What the library can rely on is the file
+ * itself: the title reads the stream in blocks from its archive (ppu_fs.cpp
+ * tells us each read: buffer, archive offset, host path), the first chunks
+ * it feeds are found in those blocks, which gives the stream's offset in
+ * the archive, and from then on the library reads the stream from the
+ * archive on its own. The title's feeds then only pace the stream (its
+ * ring accounting is kept as before); what it copies is not used. Without
+ * such a read (a stream fed from memory) the title's bytes are used as
+ * before. */
+typedef struct { u32 ea, len; u64 pos; char host[512]; } FsRead;
+static FsRead s_reads[8];
+static u32 s_reads_n;
+
+void cellAtrac_fs_read(u32 ea, u64 pos, u32 len, const char* host)
+{
+    if (!host || !*host || len < 64) return;
+    ATRAC_LOCK();
+    FsRead* r = &s_reads[s_reads_n++ % 8];
+    r->ea = ea; r->len = len; r->pos = pos;
+    strncpy(r->host, host, sizeof r->host - 1); r->host[sizeof r->host - 1] = 0;
+    ATRAC_UNLOCK();
+}
+
+/* Where bytes the title has for file offset rpos are in a recent read:
+ * the archive offset of the stream's byte 0, or 0 if nowhere. */
+static int arc_locate(const u8* src, u32 n, u32 rpos, u64* base, const FsRead** from)
+{
+    const u32 k = n < 256 ? n : 256;
+    if (k < 64) return 0;
+    const u32 m = s_reads_n < 8 ? s_reads_n : 8;
+    for (u32 i = 0; i < m; i++) {
+        const FsRead* r = &s_reads[(s_reads_n - 1 - i) % 8];
+        if (r->len < k) continue;
+        const u8* buf = vm_base + r->ea;
+        for (u32 off = 0; off + k <= r->len; off++) {
+            if (buf[off] != src[0] || memcmp(buf + off, src, k)) continue;
+            if (r->pos + off < rpos) continue;
+            *base = r->pos + off - rpos;
+            *from = r;
+            return 1;
+        }
+    }
+    return 0;
+}
+
+/* Bytes the title holds for file offset rpos: learn the stream's place in
+ * the archive from them, if not known yet. Two sightings must agree and the
+ * archive must hold those very bytes there. */
+static void arc_learn(AtracSlot* s, const u8* src, u32 n, u32 rpos)
+{
+    if (s->arc || s->arc_fail >= 4) return;
+    u64 base = 0; const FsRead* r = NULL;
+    if (!arc_locate(src, n, rpos, &base, &r)) return;
+    if (!s->arc_seen || s->arc_cand != base || strcmp(s->arc_host, r->host)) {
+        s->arc_cand = base; s->arc_seen = 1;
+        strncpy(s->arc_host, r->host, sizeof s->arc_host - 1); s->arc_host[sizeof s->arc_host - 1] = 0;
+        return;
+    }
+    FILE* f = fopen(r->host, "rb");
+    if (!f) { s->arc_fail++; return; }
+    u8 probe[256];
+    const u32 k = n < sizeof probe ? n : (u32)sizeof probe;
+    int ok = ATRAC_FSEEK64(f, base + rpos) == 0 && fread(probe, 1, k, f) == k && !memcmp(probe, src, k);
+    if (!ok) { fclose(f); s->arc_fail++; s->arc_seen = 0; return; }
+    s->arc = f;
+    s->arc_base = base;
+    fprintf(stderr, "[cellAtrac] handle=0x%08X: the stream is %s at offset 0x%llX: read from there from now on\n",
+            s->handle_ea, r->host, (unsigned long long)base);
+}
+
+/* The image up to file offset need, from the archive. */
+static void arc_fill(AtracSlot* s, u32 need)
+{
+    if (!s->arc || !s->img) return;
+    if (need > s->file_bytes) need = s->file_bytes;
+    if (need <= s->have) return;
+    if (ATRAC_FSEEK64(s->arc, s->arc_base + s->have) != 0) return;
+    const u32 want = need - s->have;
+    const size_t got = fread(s->img + s->have, 1, want, s->arc);
+    s->have += (u32)got;
+    if (got != want) {
+        static int said = 0;
+        if (said++ < 2) fprintf(stderr, "[cellAtrac] handle=0x%08X: short read of the stream's archive at 0x%llX\n",
+                                s->handle_ea, (unsigned long long)(s->arc_base + s->have));
+    }
+}

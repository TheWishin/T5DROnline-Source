+    int stale;                 /* rollback: the title's pending add was decided before the rollback */
 } AtracSlot;
 
 static AtracSlot s_slots[ATRAC_MAX_SLOTS];
 
+/* Rollback support (src/rollback): the title's streaming buffers are written
+ * by its feeder thread, which a rollback must not rewind, so the rollback
+ * excludes those pages from its snapshots. Lists the live streaming rings
+ * (guest address + size); returns how many. */
+/* The rollback just rewound the title: whatever it is about to add was
+ * decided with a buffer position it got before the rollback (the question
+ * and the answer are on the title's side, rewound; the write pointer here is
+ * not), so the next adds are dropped until it asks again. */
+void cellAtrac_rb_rolled_back(void)
+{
+    ATRAC_LOCK();
+    for (int i = 0; i < ATRAC_MAX_SLOTS; i++) if (s_slots[i].handle_ea && s_slots[i].img) s_slots[i].stale = 1;
+    ATRAC_UNLOCK();
+}
+int cellAtrac_rb_live_rings(u32* ea, u32* size, int cap)
+{
+    int n = 0;
+    ATRAC_LOCK();
+    for (int i = 0; i < ATRAC_MAX_SLOTS && n < cap; i++)
+        if (s_slots[i].handle_ea && s_slots[i].img && s_slots[i].ring_ea) { ea[n] = s_slots[i].ring_ea; size[n] = s_slots[i].ring_size; n++; }
+    ATRAC_UNLOCK();
+    return n;
+}

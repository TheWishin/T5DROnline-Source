+/* Patch 0087: a DirectInput device's first read on a port is its baseline, never a press: whatever is down
+ * in it (a button, a hat or axis direction -- a phantom's zeroed state reads as the hat up and both stick
+ * axes at their end) is ignored until it has been seen released, an axis held so reads centred, and the
+ * taps of that read are dropped. A player holding a button while plugging in presses it again. Port lock. */
+static void di_hold(PadDev* d, RawState* r)
+{
+    if (!d->hold_set) {
+        d->hold_set = 1;
+        memcpy(d->hold, r->bits, sizeof d->hold);
+        memset(r->tap, 0, sizeof r->tap);
+        int any = 0;
+        for (int w = 0; w < (CID_COUNT + 31) / 32; w++) any |= d->hold[w] != 0;
+        if (any) {
+            char sn[24] = "";
+            for (unsigned id = 0; id < CID_COUNT && !sn[0]; id++)
+                if ((d->hold[id >> 5] >> (id & 31)) & 1) source_name(CLS_DINPUT, (int)id, sn, sizeof sn);
+            printf("[pad] port %d %s: %s (and maybe more) down at its first read -- ignored until released\n",
+                   d->port + 1, d->name, sn);
+            fflush(stdout);
+        }
+    }
+    for (int w = 0; w < (CID_COUNT + 31) / 32; w++) {
+        d->hold[w] &= r->bits[w];
+        r->bits[w] &= ~d->hold[w];
+        r->tap[w] &= ~d->hold[w];
+    }
+    for (int a = 0; a < NAXES; a++) {               /* both directions of an axis sit in one word */
+        const unsigned id = CID_AXIS + (unsigned)a * 2;
+        if ((d->hold[id >> 5] >> (id & 31)) & 3) r->axis[a] = 0;
+    }
+}

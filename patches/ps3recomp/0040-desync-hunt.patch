 #include "../platform/win32_backtrace.h"   /* RtlCaptureStackBackTrace / GetModuleHandleA on POSIX */
 
+/* PS3_TEST_FS_DELAY=<ms per call>[:<ms per MB>] (tests, desync hunt): every
+ * cellFsOpen/Read/AioRead waits that long first -- a slow or cold disk on one
+ * PC of a netplay pair, whose file thread then finishes its requests frames
+ * later than the other PC's. Off unless set. */
+static void fs_test_delay(uint64_t bytes)
+{
+    static int s_ms = -1, s_ms_mb = 0;
+    if (s_ms < 0) {
+        const char* e = getenv("PS3_TEST_FS_DELAY");
+        int a = 0, b = 0;
+        if (e) sscanf(e, "%d:%d", &a, &b);
+        s_ms_mb = b > 0 ? b : 0;
+        s_ms = a > 0 ? a : 0;
+        if (s_ms || s_ms_mb) fprintf(stderr, "[fs] TEST: every open/read waits %d ms + %d ms per MB (PS3_TEST_FS_DELAY)\n", s_ms, s_ms_mb);
+    }
+    const uint64_t ms = (uint64_t)s_ms + (bytes * (uint64_t)s_ms_mb >> 20);
+    if (!ms) return;
+#ifdef _WIN32
+    Sleep((DWORD)ms);
+#else
+    usleep((useconds_t)(ms * 1000));
+#endif
+}
+
 /* Host root that the PS3 mount points map into (dir containing PS3_GAME). */

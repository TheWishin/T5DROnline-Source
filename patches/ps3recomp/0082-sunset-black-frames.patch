+/* LD_FRAME_DUMP_ASYNC=1 (patch 0082): LD_FRAME_DUMP without the wait. The
+ * synchronous dump above ends the command list and waits for the GPU at every
+ * dumped frame, so with LD_FRAME_DUMP_EVERY=1 no two frames ever overlap: a
+ * picture that goes wrong only while the next frame is recorded during this
+ * one's GPU work (two frames in flight) cannot show in it. Here the copy of
+ * the presented surface goes into the frame's own command list, into one of
+ * LD_ASYNC_SLOTS readback buffers, and is written out by a writer thread once
+ * the list's fence has passed -- nothing waits; a frame whose slot is still
+ * busy is not dumped (counted in "[frame-dump] async: ... skipped"). */
+#define LD_ASYNC_SLOTS 8
+static struct {
+    ID3D12Resource* rb;
+    UINT64 size;
+    u64 fence;                /* 0 = free */
+    u32 w, h, pitch, texel;
+    int fp16;
+    char path[MAX_PATH * 2];
+} g_ld_async[LD_ASYNC_SLOTS];
+static u64 g_ld_async_done, g_ld_async_skipped;
+typedef struct ld_async_job { struct ld_async_job* next; u8* px; u32 w, h, pitch, texel; int fp16;
+                              char path[MAX_PATH * 2]; } ld_async_job;
+static ld_async_job* volatile g_ld_async_head;
+static CRITICAL_SECTION g_ld_async_cs;
+static HANDLE g_ld_async_ev;
+static DWORD WINAPI ld_async_writer(LPVOID arg)
+{
+    (void)arg;
+    for (;;) {
+        WaitForSingleObject(g_ld_async_ev, INFINITE);
+        for (;;) {
+            EnterCriticalSection(&g_ld_async_cs);
+            ld_async_job* j = g_ld_async_head;
+            if (j) g_ld_async_head = j->next;
+            LeaveCriticalSection(&g_ld_async_cs);
+            if (!j) break;
+            FILE* f = fopen(j->path, "wb");
+            if (f) {
+                fprintf(f, "P6\n%u %u\n255\n", j->w, j->h);
+                u8* line = (u8*)malloc((size_t)j->w * 3);
+                for (u32 y = 0; line && y < j->h; y++) {
+                    const u8* row = j->px + (size_t)y * j->pitch;
+                    for (u32 x = 0; x < j->w; x++) ld_dump_texel_rgb(row + x * j->texel, j->fp16, line + x * 3);
+                    fwrite(line, 1, (size_t)j->w * 3, f);
+                }
+                free(line);
+                fclose(f);
+            }
+            free(j->px);
+            free(j);
+        }
+    }
+    return 0;
+}
+/* Finished copies to the writer thread (every present). */
+static void ld_dump_async_poll(void)
+{
+    if (!g.fence) return;
+    const u64 done = g.fence->lpVtbl->GetCompletedValue(g.fence);
+    for (u32 i = 0; i < LD_ASYNC_SLOTS; i++) {
+        if (!g_ld_async[i].fence || g_ld_async[i].fence > done) continue;
+        u8* px = NULL; D3D12_RANGE rr = {0, (SIZE_T)g_ld_async[i].size};
+        if (SUCCEEDED(g_ld_async[i].rb->lpVtbl->Map(g_ld_async[i].rb, 0, &rr, (void**)&px))) {
+            ld_async_job* j = (ld_async_job*)calloc(1, sizeof *j);
+            if (j) j->px = (u8*)malloc((size_t)g_ld_async[i].size);
+            if (j && j->px) {
+                memcpy(j->px, px, (size_t)g_ld_async[i].size);
+                j->w = g_ld_async[i].w; j->h = g_ld_async[i].h; j->pitch = g_ld_async[i].pitch;
+                j->texel = g_ld_async[i].texel; j->fp16 = g_ld_async[i].fp16;
+                memcpy(j->path, g_ld_async[i].path, sizeof j->path);
+                EnterCriticalSection(&g_ld_async_cs);
+                ld_async_job** t = (ld_async_job**)&g_ld_async_head;   /* keep the order */
+                while (*t) t = &(*t)->next;
+                *t = j;
+                LeaveCriticalSection(&g_ld_async_cs);
+                SetEvent(g_ld_async_ev);
+                g_ld_async_done++;
+            } else if (j) free(j);
+            D3D12_RANGE wr = {0, 0};
+            g_ld_async[i].rb->lpVtbl->Unmap(g_ld_async[i].rb, 0, &wr);
+        }
+        g_ld_async[i].fence = 0;
+    }
+}
+/* The copy of `surface` into a free slot, recorded into the open list. */
+static void ld_dump_async_record(const char* path, const surface_t* surface)
+{
+    static int inited;
+    if (!inited) {
+        inited = 1;
+        InitializeCriticalSection(&g_ld_async_cs);
+        g_ld_async_ev = CreateEventA(NULL, FALSE, FALSE, NULL);
+        HANDLE th = CreateThread(NULL, 0, ld_async_writer, NULL, 0, NULL);
+        if (th) { SetThreadPriority(th, THREAD_PRIORITY_BELOW_NORMAL); CloseHandle(th); }
+        fprintf(stderr, "[frame-dump] async (LD_FRAME_DUMP_ASYNC): copies in the frame's own list, %u readback "
+                        "slots, written once the GPU is past them; nothing waits\n", LD_ASYNC_SLOTS);
+    }
+    ID3D12Resource* rt = surface ? surface->tex : NULL;
+    if (!rt || !g.ready) return;
+    ld_begin_recording();
+    const u32 width = surface->pw ? surface->pw : surface->w;
+    const u32 height = surface->ph ? surface->ph : surface->h;
+    if (!width || !height) return;
+    const int fp16 = surface->fmt == DXGI_FORMAT_R16G16B16A16_FLOAT;
+    const u32 texel = fp16 ? 8u : 4u;
+    const u32 pitch = (width * texel + 255) & ~255u;
+    const UINT64 size = (UINT64)pitch * height;
+    int slot = -1;
+    for (u32 i = 0; i < LD_ASYNC_SLOTS && slot < 0; i++) if (!g_ld_async[i].fence) slot = (int)i;
+    if (slot < 0) {
+        if (g_ld_async_skipped++ % 60 == 0)
+            fprintf(stderr, "[frame-dump] async: %llu written, %llu skipped (every slot busy)\n",
+                    (unsigned long long)g_ld_async_done, (unsigned long long)g_ld_async_skipped);
+        return;
+    }
+    if (g_ld_async[slot].rb && g_ld_async[slot].size < size) {
+        g_ld_async[slot].rb->lpVtbl->Release(g_ld_async[slot].rb);
+        g_ld_async[slot].rb = NULL;
+    }
+    if (!g_ld_async[slot].rb) {
+        D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+        D3D12_RESOURCE_DESC bd = {0};
+        bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = size;
+        bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+        bd.Format = DXGI_FORMAT_UNKNOWN; bd.SampleDesc.Count = 1;
+        bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+                D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&g_ld_async[slot].rb)))
+            return;
+        g_ld_async[slot].size = size;
+    }
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    b.Transition.pResource = rt;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    LDL->lpVtbl->ResourceBarrier(LDL, 1, &b);
+    D3D12_TEXTURE_COPY_LOCATION src = {0}, dst = {0};
+    src.pResource = rt; src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX; src.SubresourceIndex = 0;
+    dst.pResource = g_ld_async[slot].rb; dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+    dst.PlacedFootprint.Footprint.Format = surface->fmt;
+    dst.PlacedFootprint.Footprint.Width = width;
+    dst.PlacedFootprint.Footprint.Height = height;
+    dst.PlacedFootprint.Footprint.Depth = 1;
+    dst.PlacedFootprint.Footprint.RowPitch = pitch;
+    LDL->lpVtbl->CopyTextureRegion(LDL, &dst, 0, 0, 0, &src, NULL);
+    b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    b.Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    LDL->lpVtbl->ResourceBarrier(LDL, 1, &b);
+    g_ld_async[slot].w = width; g_ld_async[slot].h = height; g_ld_async[slot].pitch = pitch;
+    g_ld_async[slot].texel = texel; g_ld_async[slot].fp16 = fp16;
+    snprintf(g_ld_async[slot].path, sizeof g_ld_async[slot].path, "%s", path);
+    g_ld_async[slot].fence = g.fence_value + 1;   /* what the list being recorded will signal */
+}

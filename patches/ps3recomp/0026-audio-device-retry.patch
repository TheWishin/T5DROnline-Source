+    for (LONG i = 0; i < s_ev_n; i++) {
+        const double t = (double)(s_ev_qpc[i] - t0.QuadPart) / (double)qf.QuadPart;
+        if (t < a || t >= b) continue;
+        n++;
+        if (prev >= 0.0 && (t - prev) * 1000.0 > maxgap) maxgap = (t - prev) * 1000.0;
+        prev = t;
+    }
+    *rate = n / (b - a);
+    *gap_ms = maxgap;
+}
+
+int main(void)
+{
+    const double RUN_S = 16.0;
+    _putenv_s("PS3_AUDIO_FAKE_NODEVICE", "3");
+    _putenv_s("PS3_AUDIO_FAKE_LOSS", "7,11");
+    _putenv_s("PS3_AUDIO_FAKE_CHANGE", "9");
+    _putenv_s("PS3_AUDIO_FAKE_STALL", "13");
+    QueryPerformanceFrequency(&qf);
+
+    QueryPerformanceCounter(&t0);
+    assert(cellAudioInit() == CELL_OK);
+    s_notify_queues[0].in_use = 1;      /* after Init: it clears the table */
+    s_notify_queues[0].key = 1;
+
+    /* Follow the stream: when it is there, and every time a different one was installed. */
+    double open_at[8]; int nopen = 0; double gone_at[8]; int ngone = 0; double inst_at[8]; int ninst = 0;
+    int was_open = 0; LONG last_gen = 0;
+    while (now_s() < RUN_S) {
+        const int is_open = s_wasapi_client != NULL;
+        const double t = now_s();
+        if (is_open && !was_open && nopen < 8) open_at[nopen++] = t;
+        if (!is_open && was_open && ngone < 8) gone_at[ngone++] = t;
+        if (s_dev_gen != last_gen && ninst < 8) inst_at[ninst++] = t;
+        was_open = is_open;
+        last_gen = s_dev_gen;
+        Sleep(2);
+    }
+    const int notify_registered = s_dev_notify;
+    const double t_quit = now_s();
+    assert(cellAudioQuit() == CELL_OK);
+    const double quit_ms = (now_s() - t_quit) * 1000.0;
+
+    int fails = 0;
+#define CHECK(cond, ...) do { if (!(cond)) { fails++; printf("FAIL: "); printf(__VA_ARGS__); printf("\n"); } } while (0)
+
+    printf("streams installed: %ld, opened at:", (long)last_gen);
+    for (int i = 0; i < nopen; i++) printf(" %.2f", open_at[i]);
+    printf(" s; lost at:");
+    for (int i = 0; i < ngone; i++) printf(" %.2f", gone_at[i]);
+    printf(" s; installed at:");
+    for (int i = 0; i < ninst; i++) printf(" %.2f", inst_at[i]);
+    printf(" s; quit %.0f ms\n", quit_ms);
+
+    /* Pace: no device (0.5-3.0), first device (5.5-6.9), around the losses (6.9-8.5, 10.9-12.5) and the
+     * change, the run up to the stall, and after it. The stall itself (13.0-13.6) may pause the events. */
+    static const struct { const char* name; double a, b; } win[] = {
+        { "no device     0.5-3.0 s", 0.5, 3.0 }, { "device        5.5-6.9 s", 5.5, 6.9 },
+        { "1st loss      6.9-8.5 s", 6.9, 8.5 }, { "change       8.9-10.0 s", 8.9, 10.0 },
+        { "2nd loss     10.9-12.5 s", 10.9, 12.5 }, { "up to stall   0.5-12.9 s", 0.5, 12.9 },
+        { "after stall  13.8-15.5 s", 13.8, 15.5 } };
+    for (unsigned w = 0; w < sizeof(win) / sizeof(win[0]); w++) {
+        double rate, gap;
+        pace(win[w].a, win[w].b, &rate, &gap);
+        printf("  %-24s %6.1f events/s, longest gap %5.1f ms\n", win[w].name, rate, gap);
+        CHECK(rate > 187.5 * 0.98 && rate < 187.5 * 1.02, "%s: %.1f events/s is off the 187.5 pace", win[w].name, rate);
+        CHECK(gap < 100.0, "%s: a %.1f ms gap between audio events", win[w].name, gap);
+    }
+
+    if (nopen == 0) {
+        printf("no audio endpoint on this machine: device checks skipped\n");
+    } else {
+        CHECK(notify_registered,"the default-device notification client was not registered with the enumerator");
+        CHECK(open_at[0] >= 3.0,"device opened at %.2f s, inside the 3 s fake no-device window", open_at[0]);
+        CHECK(open_at[0] < 3.0 + 2.5, "device opened only at %.2f s (window ended at 3.0, retry every 2 s)", open_at[0]);
+        CHECK(ngone == 3, "expected 3 streams given up (2 simulated losses, 1 stall), saw %d", ngone);
+        CHECK(nopen == 4, "expected 4 stream openings from nothing (start + 3 reopens), saw %d", nopen);
+        CHECK(ninst == 5, "expected 5 streams installed (start, 3 reopens, 1 default change), saw %d", ninst);
+        if (ninst == 5)
+            CHECK(inst_at[2] >= 9.0 && inst_at[2] < 10.0, "default change at 9.0 s installed a new stream at %.2f s", inst_at[2]);
+        for (int i = 0; i < 2 && i < ngone && i + 1 < nopen; i++) {
+            CHECK(gone_at[i] > 6.9 + 4.0 * i && gone_at[i] < 7.5 + 4.0 * i, "loss %d seen at %.2f s", i + 1, gone_at[i]);
+            CHECK(open_at[i + 1] - gone_at[i] < 1.0, "reopen %d took %.2f s", i + 1, open_at[i + 1] - gone_at[i]);
+        }
+        if (ngone == 3 && nopen == 4) {
+            CHECK(gone_at[2] > 13.1 && gone_at[2] < 13.6, "stall from 13.0 s given up at %.2f s (200 ms rule)", gone_at[2]);
+            CHECK(open_at[3] - gone_at[2] < 1.0, "reopen after the stall took %.2f s", open_at[3] - gone_at[2]);
+            double rate, gap;
+            pace(12.9, 13.8, &rate, &gap);
+            printf("  stall        12.9-13.8 s  %6.1f events/s, longest gap %5.1f ms (200 ms rule)\n", rate, gap);
+            CHECK(gap < 400.0, "the stall paused the audio events for %.1f ms", gap);
+        }
+    }
+    CHECK(quit_ms < 1000.0, "cellAudioQuit took %.0f ms", quit_ms);
+
+    if (fails) { printf("audio device: %d check(s) FAILED\n", fails); return 1; }
+    puts("audio device: pace, retry, reopen and quit passed");
+    return 0;
+}

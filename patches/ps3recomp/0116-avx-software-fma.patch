     const __m128d hi = vmx_fmaf_soft_pd(_mm_cvtps_pd(_mm_movehl_ps(x, x)), _mm_cvtps_pd(_mm_movehl_ps(y, y)),
diff --git a/runtime/ppu/ppu_loader.cpp b/runtime/ppu/ppu_loader.cpp
--- a/runtime/ppu/ppu_loader.cpp
+++ b/runtime/ppu/ppu_loader.cpp
@@ -2229,6 +2229,21 @@
 
 #ifdef _WIN32
 #include <intrin.h>
+/* The AVX1 DLL level uses -mavx, including clang's enabled predecessor features.
+ * Check OSXSAVE before XGETBV: CPUs/Windows without AVX state support must never
+ * execute it. This runs before ppu_game_init and the lifted DLL constructors. */
+__attribute__((target("xsave"))) static int ppu_host_has_avx(void)
+{
+    int r[4];
+    __cpuid(r, 0);
+    if (r[0] < 1) return 0;
+    __cpuid(r, 1);
+    const unsigned need = (1u << 0) | (1u << 9) | (1u << 19) | (1u << 20) |
+                          (1u << 23) | (1u << 26) | (1u << 27) | (1u << 28);
+    if (((unsigned)r[2] & need) != need) return 0;
+    return (_xgetbv(0) & 6) == 6;
+}
+
 /* x86-64-v3 as -march=x86-64-v3 uses it: AVX2, FMA, BMI1/2, F16C, LZCNT, MOVBE,
  * and Windows saving the YMM registers (XGETBV). */
 __attribute__((target("xsave"))) static int ppu_host_has_x86_64_v3(void)
@@ -2301,6 +2316,21 @@

+    s_stop = 1;
+    if (s_dump) { fflush(s_dump); fclose(s_dump); s_dump = NULL; }
+    if (s_sync) {
+        report_dropped(); fflush(s_file); fclose(s_file); s_file = NULL;
+        ReleaseSRWLockExclusive(&s_lock);
+        return;
+    }

+static void ld_check_display_adapter(HWND hwnd)
+{
+    IDXGIFactory1* f = NULL;
+    if (FAILED(CreateDXGIFactory1(&IID_IDXGIFactory1, (void**)&f)) || !f) return;
+    const HMONITOR mon = MonitorFromWindow(hwnd, MONITOR_DEFAULTTONEAREST);

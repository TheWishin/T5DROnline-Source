index 451d4bd..dba0afe 100644
--- a/runtime/syscalls/lv2_register.c
+++ b/runtime/syscalls/lv2_register.c
@@ -1785,6 +1785,86 @@ static int64_t sys_spu_thread_group_connect_event_all_threads_handler(ppu_contex
     return (int64_t)(int32_t)result;
 }
 
+/* t5dr offline soak (0041): SPU_TICK_STATS=1 (or AUDIO_RATE=1) times every
+ * request an lv2 SPU thread answers -- from its receive_event returning an
+ * event to its next send_event -- and prints one line per SPU thread every
+ * 5 s:
+ *   [spu-tick] tid 0x2000: 937 answers, mean 3.62 ms, p95 4.25, p99 4.75, max 5.10, over 5.33 ms: 0
+ * Tekken 5 DR's sound core ("bnusCore") gets 'STAT' once per 5.33 ms audio
+ * tick and answers when the tick's mix is done, so this is its work per tick
+ * against the budget: a core slower than the tick drops audio blocks ("not
+ * written" in [audio-rate], "sound glitches" in the log) however the rest of
+ * the game runs. */
+#define SPU_TICK_SLOTS 4
+static struct {
+    uint32_t  spu_id;
+    long long t0, last_print;
+    unsigned long long c0;                /* the thread's cycle count at the event */
+    int       pending;
+    unsigned  n, over, bins[80];          /* 0.25 ms bins, the last one open-ended */
+    double    sum, max, cyc;
+} s_tick[SPU_TICK_SLOTS];
+
+static int spu_tick_on(void)
+{
+    static int v = -1;
+    if (v < 0) v = (getenv("SPU_TICK_STATS") || getenv("AUDIO_RATE")) ? 1 : 0;
+    return v;
+}
+
+static int spu_tick_slot(uint32_t spu_id)
+{
+    for (int i = 0; i < SPU_TICK_SLOTS; i++) {
+        if (s_tick[i].spu_id == spu_id) return i;
+        if (!s_tick[i].spu_id) { s_tick[i].spu_id = spu_id; return i; }
+    }
+    return -1;
+}
+
+static void spu_tick_begin(uint32_t spu_id)      /* on the SPU's own host thread */
+{
+    if (!spu_tick_on()) return;
+    const int i = spu_tick_slot(spu_id);
+    if (i < 0) return;
+    LARGE_INTEGER q; QueryPerformanceCounter(&q);
+    s_tick[i].t0 = q.QuadPart; s_tick[i].pending = 1;
+    ULONG64 cy = 0; QueryThreadCycleTime(GetCurrentThread(), &cy); s_tick[i].c0 = cy;
+}
+
+static void spu_tick_end(uint32_t spu_id)        /* the same SPU thread, its send_event */
+{
+    if (!spu_tick_on()) return;
+    const int i = spu_tick_slot(spu_id);
+    if (i < 0 || !s_tick[i].pending) return;
+    LARGE_INTEGER q, f; QueryPerformanceCounter(&q); QueryPerformanceFrequency(&f);
+    const double ms = (double)(q.QuadPart - s_tick[i].t0) * 1000.0 / (double)f.QuadPart;
+    s_tick[i].pending = 0;
+    { ULONG64 cy = 0; QueryThreadCycleTime(GetCurrentThread(), &cy); s_tick[i].cyc += (double)(cy - s_tick[i].c0); }
+    int b = (int)(ms / 0.25); if (b > 79) b = 79;
+    s_tick[i].bins[b]++; s_tick[i].n++; s_tick[i].sum += ms;
+    if (ms > s_tick[i].max) s_tick[i].max = ms;
+    if (ms > 5.333) s_tick[i].over++;
+    if (!s_tick[i].last_print) s_tick[i].last_print = q.QuadPart;
+    if (q.QuadPart - s_tick[i].last_print >= 5 * f.QuadPart) {
+        unsigned acc = 0, p95 = 0, p99 = 0;
+        for (int k = 0; k < 80; k++) {
+            acc += s_tick[i].bins[k];
+            if (!p95 && acc * 100u >= s_tick[i].n * 95u) p95 = (unsigned)k + 1;
+            if (!p99 && acc * 100u >= s_tick[i].n * 99u) p99 = (unsigned)k + 1;
+        }
+        /* "on the CPU": the thread's own cycles (QueryThreadCycleTime), which a busy
+         * PC's preemption does not inflate -- the work per tick, comparable
+         * between runs; the ms figures are wall time, what the audio sees. */
+        fprintf(stderr, "[spu-tick] tid 0x%X: %u answers, mean %.2f ms, p95 %.2f, p99 %.2f, max %.2f, over 5.33 ms: %u; "
+                        "on the CPU %.2f M cycles per answer\n",
+                spu_id, s_tick[i].n, s_tick[i].sum / s_tick[i].n, p95 * 0.25, p99 * 0.25, s_tick[i].max, s_tick[i].over,
+                s_tick[i].cyc / s_tick[i].n / 1e6);
+        memset(s_tick[i].bins, 0, sizeof s_tick[i].bins);
+        s_tick[i].n = s_tick[i].over = 0; s_tick[i].sum = s_tick[i].max = s_tick[i].cyc = 0.0;
+        s_tick[i].last_print = q.QuadPart;
+    }
+}
+
 /* The interrupt mailbox encodes send_event (0..63) or throw_event (64..127).
  * The preceding ordinary mailbox word is data, not a separate PPU event. */
 static int spu_deliver_user_event(spu_context* spu, uint32_t value)
@@ -1838,6 +1918,7 @@ static int spu_deliver_user_event(spu_context* spu, uint32_t value)
             }
         }
         result = CELL_ENOTCONN;
+        if (spu->spu_group_id && code < 64) spu_tick_end(spu->spu_id);
         if (queue) {
             int rc = sys_event_queue_push_by_id(queue, 0xFFFFFFFF53505501ull,
                 spu->spu_id, ((uint64_t)port << 32) | (value & 0xFFFFFFu), data);
@@ -1965,6 +2046,7 @@ static int spu_lv2_stop_service(spu_context* spu)
                        : (int32_t)0x80010002;         /* EINVAL: nothing bound */
     spu->rcv_evt[0] = (uint32_t)rc;
     if (rc == CELL_OK) {
+        spu_tick_begin(spu->spu_id);
         spu->rcv_evt[1] = (uint32_t)ev.data1;
         spu->rcv_evt[2] = (uint32_t)ev.data2;
         spu->rcv_evt[3] = (uint32_t)ev.data3;
diff --git a/runtime/syscalls/sys_ppu_thread.c b/runtime/syscalls/sys_ppu_thread.c
index 9eb022a..7ee789a 100644
--- a/runtime/syscalls/sys_ppu_thread.c
+++ b/runtime/syscalls/sys_ppu_thread.c
@@ -81,6 +81,20 @@ static void table_unlock(void)
 #endif
 }
 
+#ifdef _WIN32
+/* t5dr offline soak (patch 0041): a detached thread frees its own slot when it
+ * ends, and its host thread handle and join event go with it. They were left
+ * open -- the POSIX half detaches, this half did nothing -- so every detached
+ * guest thread leaked a Thread and an Event handle (Tekken 5 DR: about 45
+ * handles an hour of play, for good once the slot is reused). Call with the
+ * table lock held; nobody joins a detached thread. */
+static void ppu_thread_close_host_handles(ppu_thread_info* t)
+{
+    if (t->host_thread)  { CloseHandle(t->host_thread);  t->host_thread = NULL; }
+    if (t->finish_event) { CloseHandle(t->finish_event); t->finish_event = NULL; }
+}
+#endif
+
 /* A guest stack for a host thread that runs guest code outside any guest

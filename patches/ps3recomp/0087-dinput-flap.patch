+/* Patch 0087: DirectInput devices that are lost again soon after they were found. A Razer Panthera PS4 in
+ * PS4 mode (1532:0401) showed two DirectInput devices of the same name: the stick, and one that failed its
+ * reads at once and was found again every ~0.5 s -- port 2 flipped disconnected / connected ~200 times
+ * and its first reads reached the menus as presses (the Practice menu's TRAINING DUMMY option changed on
+ * its own, focused or not). A loss within DI_FLAP_LIFE_MS of being found is a flap; DI_FLAP_N flaps within
+ * DI_FLAP_WINDOW_MS put the device (its instance GUID, or its HID path) in quarantine: never created
+ * again, one log line. Forgotten when it has been gone from the device list for DI_FLAP_FORGET_MS
+ * (unplugged), like g_hid_fail for the HID path. Hot-plug thread / init only. */
+#ifndef DI_PROBATION_MS
+  #define DI_PROBATION_MS    1000
+#endif
+#ifndef DI_FLAP_LIFE_MS
+  #define DI_FLAP_LIFE_MS    10000
+#endif
+#ifndef DI_FLAP_WINDOW_MS
+  #define DI_FLAP_WINDOW_MS  30000
+#endif
+#ifndef DI_FLAP_FORGET_MS
+  #define DI_FLAP_FORGET_MS  5000
+#endif
+#define DI_FLAP_N   3
+#define DI_FLAP_MAX 8
+typedef struct {
+    int used, n, quarantined, seen;
+    GUID inst;
+    WCHAR path[MAX_PATH];
+    LONGLONG t[DI_FLAP_N];     /* the last flaps, newest last */
+    LONGLONG absent_t;         /* first scan that did not list it (0 = listed) */
+} DiFlap;
+static DiFlap g_di_flap[DI_FLAP_MAX];
+
+static DiFlap* di_flap_find(const GUID* inst, const WCHAR* path)
+{
+    for (int i = 0; i < DI_FLAP_MAX; i++) {
+        DiFlap* e = &g_di_flap[i];
+        if (!e->used) continue;
+        if ((inst && IsEqualGUID(inst, &e->inst)) || (path && path[0] && !_wcsicmp(path, e->path))) return e;
+    }
+    return NULL;
+}
+
+/* d (DEV_DINPUT) is being dropped as lost: a flap if it was found a short while ago. Lock held. */
+static void di_flap_note(const PadDev* d, LONGLONG now)
+{
+    if (now - d->found_t >= qpc_from_us((u64)DI_FLAP_LIFE_MS * 1000u)) return;
+    DiFlap* e = di_flap_find(&d->inst, d->path);
+    if (!e) {
+        int o = 0;
+        for (int i = 0; i < DI_FLAP_MAX; i++) {
+            if (!g_di_flap[i].used) { o = i; break; }
+            if (!g_di_flap[i].quarantined && g_di_flap[i].t[DI_FLAP_N - 1] < g_di_flap[o].t[DI_FLAP_N - 1]) o = i;
+        }
+        e = &g_di_flap[o];
+        memset(e, 0, sizeof *e);
+        e->used = 1;
+    }
+    e->inst = d->inst;                        /* the newest instance GUID, should it change */
+    if (d->path[0]) wcscpy_s(e->path, MAX_PATH, d->path);
+    e->seen = 1; e->absent_t = 0;
+    memmove(e->t, e->t + 1, sizeof e->t[0] * (DI_FLAP_N - 1));
+    e->t[DI_FLAP_N - 1] = now;
+    if (e->n < DI_FLAP_N) e->n++;
+    const int burst = e->n >= DI_FLAP_N && now - e->t[0] < qpc_from_us((u64)DI_FLAP_WINDOW_MS * 1000u);
+    if (burst && !e->quarantined) {
+        e->quarantined = 1;
+        printf("[pad] DInput '%s' %04X:%04X lost %d times within %d s of being found -- ignored from now on"
+               " (a phantom or broken device; unplug it for %d s to try it again)\n", d->name, d->vid, d->pid,
+               DI_FLAP_N, DI_FLAP_WINDOW_MS / 1000, (DI_FLAP_FORGET_MS + 999) / 1000);
+    } else if (!e->quarantined && d->port < 0) {
+        printf("[pad] DInput '%s' %04X:%04X lost again %.1f s after it was found (%d of %d)\n", d->name, d->vid,
+               d->pid, qpc_to_us(now - d->found_t) / 1e6, e->n, DI_FLAP_N);
+    }
+}

+++ b/runtime/platform/host_pacer.h
@@ -0,0 +1,105 @@
+/* Host-only 60000/1001 deadline policy. No guest clock, input or memory access. */
+#ifndef PS3RECOMP_HOST_PACER_H
+#define PS3RECOMP_HOST_PACER_H
+#include <stdint.h>
+#include <string.h>
+
+typedef struct hp_target {
+    uint64_t generation, slot, flip_sequence;
+    int64_t release_target_qpc, present_target_qpc, release_qpc;
+    uint32_t intentional_skip_ticks, mode, external_hold_serial;
+    int64_t renderer_sync_ticks, ring_wait_ticks, ticker_wake_error;
+    uint64_t release_after_flip;
+    uint32_t timer_fallback;
+} hp_target;
+
+typedef struct hp_policy {
+    int64_t qpf, whole, next_present, budget, guard, fixed_budget;
+    uint32_t fraction, remainder, ncost, since, pending_skips;
+    uint64_t generation, slot;
+    int64_t costs[240];
+    hp_target current;
+} hp_policy;
+
+static void hp_advance(hp_policy* p)
+{
+    p->next_present += p->whole;
+    p->remainder += p->fraction;
+    if (p->remainder >= 60000u) { p->next_present++; p->remainder -= 60000u; }
+    p->slot++;
+}
+static int64_t hp_period_ceil(const hp_policy* p) { return p->whole + (p->fraction != 0); }
+static int64_t hp_release_due(const hp_policy* p) { return p->next_present - p->budget; }
+static int64_t hp_clamp_budget(const hp_policy* p, int64_t v)
+{
+    const int64_t lo = p->qpf / 2000; /* 0.5 ms */
+    const int64_t hi = p->whole - p->qpf / 5000; /* strictly below one period */
+    return v < lo ? lo : v > hi ? hi : v;
+}
+static void hp_reset(hp_policy* p, int64_t qpf, int64_t now, uint64_t generation,
+                     int64_t fixed_budget)
+{
+    memset(p, 0, sizeof *p);
+    p->qpf = qpf;
+    /* Quotient/remainder first: no hours*n*QPF intermediate overflow. */
+    p->whole = (qpf / 60000) * 1001 + ((qpf % 60000) * 1001) / 60000;
+    p->fraction = (uint32_t)(((qpf % 60000) * 1001) % 60000);
+    p->generation = generation;
+    p->guard = qpf / 5000; /* 0.2 ms; calibrate against visible latency */
+    p->fixed_budget = fixed_budget > 0 ? hp_clamp_budget(p, fixed_budget) : 0;
+    p->budget = p->fixed_budget ? p->fixed_budget : hp_clamp_budget(p, qpf / 250); /* 4 ms bootstrap */
+    p->next_present = now + p->budget;
+    p->slot = 1;
+}
+static void hp_release(hp_policy* p, int64_t now, unsigned mode)
+{
+    hp_target* t = &p->current;
+    memset(t, 0, sizeof *t);
+    t->generation = p->generation; t->slot = p->slot; t->mode = mode;
+    t->present_target_qpc = p->next_present;
+    t->release_target_qpc = hp_release_due(p); t->release_qpc = now;
+    t->intentional_skip_ticks = p->pending_skips; p->pending_skips = 0;
+    hp_advance(p);
+}
+static void hp_skip(hp_policy* p)
+{
+    /* Exactly one host slot for exactly one consumed cellGcm_skip_ticks tick. */
+    hp_advance(p);
+    p->pending_skips++;
+}
+static void hp_presented(hp_policy* p, const hp_target* t, int64_t ready, int64_t entry)
+{
+    if (t->generation != p->generation || !t->present_target_qpc) return;
+    /* A late picture presents once now. Reserve a whole period after actual
+     * entry: no short catch-up interval, no extra simulated frame. Rebase the
+     * host phase explicitly; keep the rational remainder and slot identity. */
+    if (ready > t->present_target_qpc || entry - t->present_target_qpc > p->guard) {
+        const int64_t minimum = entry + hp_period_ceil(p);
+        if (p->next_present < minimum) p->next_present = minimum;
+    }
+}
+static void hp_observe_ready(hp_policy* p, const hp_target* t, int64_t ready,
+                             int local_cost_known)
+{
+    /* Unknown/network waits are never silently trained as render cost.
+     * The integration freezes automatic adaptation unless the caller can
+     * classify a sample as local. Fixed-budget A/B runs always stay fixed. */
+    if (!local_cost_known || p->fixed_budget || t->generation != p->generation ||
+        t->intentional_skip_ticks || !t->release_qpc) return;
+    const int64_t cost = ready - t->release_qpc;
+    if (cost <= 0) return;
+    if (cost >= p->whole) { p->budget = hp_clamp_budget(p, cost + p->guard); return; }
+    p->costs[p->ncost++ % 240u] = cost;
+    if (cost > p->budget) p->budget = hp_clamp_budget(p, cost + p->guard);
+    if (++p->since >= 30u && p->ncost >= 60u) {
+        int64_t sorted[240]; const unsigned n = p->ncost < 240u ? p->ncost : 240u;
+        unsigned i, j; memcpy(sorted, p->costs, n * sizeof sorted[0]);
+        for (i = 1; i < n; i++) { const int64_t v = sorted[i]; j = i;
+            while (j && sorted[j - 1] > v) { sorted[j] = sorted[j - 1]; j--; } sorted[j] = v; }
+        const int64_t want = hp_clamp_budget(p, sorted[(99u * (n - 1u)) / 100u] + p->guard);
+        const int64_t step = p->qpf / 2000; /* reduce at most 0.5 ms / 30 frames */
+        p->budget = want > p->budget ? want : p->budget - want > step ? p->budget - step : want;
+        p->since = 0;
+    }
+}
+#endif

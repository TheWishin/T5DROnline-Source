+        for (int i = 0; i < n && i < 24; i++) snprintf(hex + 3 * i, 4, "%02x ", b[i]);
+        printf("[sys_net] recvfrom(%d) %d B <- %s:%u  %s\n", s, n, ip_str(&a.sin_addr, ip), ntohs(a.sin_port), hex);
+    }
     write_sockaddr(EA(from), EA(fromlen), &a);
+    if (from && s_sockets[s].p2p) vm_write16(EA(from) + 8, s_sockets[s].vport);
     return n;
 }
 

+/* Does Steam give the game a virtual pad for this device and ask games to
+ * leave the device itself alone? SDL's two variables, which Steam sets for a
+ * game it starts with Steam Input on, and its virtual pad list. */
+static int steam_lists(u16 vid, u16 pid)
+{
+    if (vidpid_listed(&g_cfg.steam_ignore, vid, pid)) return 1;
+    if (g_cfg.steam_except.set && g_cfg.steam_except.n && !vidpid_listed(&g_cfg.steam_except, vid, pid)) return 1;
+    return steam_virtual_for(vid, pid);
+}

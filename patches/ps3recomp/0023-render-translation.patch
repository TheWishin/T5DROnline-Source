+/* Release a texture; a pooled one returns its block once the GPU is done
+ * with it -- callers only release retired textures behind a fence. */
+static void ld_tex_release(ID3D12Resource* r)
+{
+    if (!r) return;
+    if (g_tpool_on > 0) {
+        u32 s = ld_tpool_slot(r);
+        for (u32 probes = 0; probes < LD_TPOOL_MAP && g_tpool_map[s].res; probes++) {
+            if (g_tpool_map[s].res == r) {
+                ld_tpool_block b = g_tpool_map[s];
+                /* delete with backward shift so probe chains stay intact */
+                u32 hole = s, j = s;
+                for (;;) {
+                    j = (j + 1) & (LD_TPOOL_MAP - 1);
+                    if (!g_tpool_map[j].res) break;
+                    const u32 home = ld_tpool_slot(g_tpool_map[j].res);
+                    const int movable = (hole <= j) ? (home <= hole || home > j)
+                                                    : (home <= hole && home > j);
+                    if (movable) { g_tpool_map[hole] = g_tpool_map[j]; hole = j; }
+                }
+                g_tpool_map[hole].res = NULL;
+                if (g_tpool_n_free < LD_TPOOL_FREE) {
+                    b.res = NULL;
+                    g_tpool_free[g_tpool_n_free++] = b;
+                }

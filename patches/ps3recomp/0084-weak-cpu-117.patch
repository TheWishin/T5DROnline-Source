index 2d88ba1..41ddc98 100644
--- a/runtime/ppu/ppu_fp_det.h
+++ b/runtime/ppu/ppu_fp_det.h
@@ -205,6 +205,38 @@ static inline __attribute__((noinline)) double ppu_fma_soft(double x, double y,
     if (bz) mz |= 1ull << 52;
     if (!mx || !my) { const double p = x * y; return p + z; }   /* exact zero product */
     if (!mz) return x * y;    /* z = +-0 never changes a nonzero exact product: one rounding */
+    /* Patch 0084: the common case in double arithmetic only (a PC without FMA3 runs this
+     * for every fused multiply-add of the game: ~8 % of the main thread's time on a
+     * 2-core stand-in with the integer path below). Boldo & Melquiond's emulated FMA
+     * ("Emulation of FMA and correctly rounded sums: proved algorithms using rounding to
+     * odd", IEEE TC 57(4), 2008, algorithm 5.2): the exact product uh + ul (Dekker, with
+     * Veltkamp's split), the exact sum th + tl = z + uh (TwoSum), v = tl + ul rounded to
+     * odd, the result th + v rounded to nearest -- the correctly rounded x*y + z when
+     * nothing underflows or overflows. With |x|, |y| in [2^-450, 2^451) and |z| in
+     * [2^-900, 2^901) every intermediate value and every nonzero result is a normal double
+     * (the exact result's lowest bit is >= 2^-1004) far below the overflow threshold; all
+     * else takes the integer path. Checked against vfmadd: runtime/ppu/tests/test_fp_det.c.
+     * PPU_FMA_SOFT_INT_ONLY (tests) compiles the integer path alone. */
+#ifndef PPU_FMA_SOFT_INT_ONLY
+    if ((unsigned)(bx - (1023 - 450)) <= 900u && (unsigned)(by - (1023 - 450)) <= 900u &&
+        (unsigned)(bz - (1023 - 900)) <= 1800u) {
+        const double C = 134217729.0;                               /* 2^27 + 1 */
+        const double cx = C * x, xh = cx - (cx - x), xl = x - xh;
+        const double cy = C * y, yh = cy - (cy - y), yl = y - yh;
+        const double uh = x * y;
+        const double ul = (((xh * yh - uh) + xh * yl) + xl * yh) + xl * yl;   /* x*y = uh + ul exactly */
+        const double th = z + uh, tb = th - z;
+        const double tl = (z - (th - tb)) + (uh - tb);                     /* z + uh = th + tl exactly */
+        double v = tl + ul;
+        const double vb = v - tl, ve = (tl - (v - vb)) + (ul - vb);       /* tl + ul = v + ve exactly */
+        if (ve != 0.0) {                                                   /* round to odd */
+            uint64_t uv = ppu_fp_u64(v);
+            if (!(uv & 1)) uv = ((ve > 0.0) == (v > 0.0)) ? uv + 1 : uv - 1;
+            v = ppu_fp_f64(uv);
+        }
+        return th + v;
+    }
+#endif
     const int sp = (int)((ux ^ uy) >> 63), sz = (int)(uz >> 63);
     /* value = m * 2^(b - 1075), a subnormal's b counted as 1 */
     ppu_fp_u128 P = (ppu_fp_u128)mx * my, Z = mz;

+/* Strict UTF-8, bounded by a terminating NUL in the already bounded list. */
+static unsigned ovl_utf8(const unsigned char** text)
+{
+    const unsigned char* p = *text;
+    unsigned cp = *p++, n = 0, low = 0;
+    if (!cp) return 0;
+    if (cp < 128) { *text = p; return cp; }
+    if (cp >= 0xC2 && cp <= 0xDF) { cp &= 31; n = 1; low = 0x80; }
+    else if (cp >= 0xE0 && cp <= 0xEF) { cp &= 15; n = 2; low = 0x800; }
+    else if (cp >= 0xF0 && cp <= 0xF4) { cp &= 7; n = 3; low = 0x10000; }
+    else return 0xFFFFFFFFu;
+    for (unsigned i = 0; i < n; i++) {
+        if ((*p & 0xC0) != 0x80) return 0xFFFFFFFFu;
+        cp = (cp << 6) | (*p++ & 63);
+    }
+    if (cp < low || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF)) return 0xFFFFFFFFu;
+    *text = p;
+    return cp;
+}
+
+static unsigned ovl_bitmap_code(unsigned cp)
+{
+    switch (cp) {
+    case 0xC4: return 0x0B; case 0xD6: return 0x0C; case 0xDC: return 0x0E;
+    case 0xE4: return 0x10; case 0xF6: return 0x11; case 0xFC: return 0x12;
+    case 0xDF: return 0x0F; default: return cp;
+    }
+}
+
+static int ovl_native_needed(const char* text)
+{
+    ovl_font_init();
+    const unsigned char* p = (const unsigned char*)text;
+    unsigned n = 0;
+    while (*p && n++ < 16384) {
+        const unsigned cp = ovl_bitmap_code(ovl_utf8(&p));
+        if (cp >= 128 || !g_have_glyph[cp]) return 1;
+    }
+    return n >= 16384;
+}
+
+static int ovl_text_coverage(const char* utf8, int prepare)
+{
+    if (!utf8) return 0;
+    const int native = ovl_native_needed(utf8);
+    const unsigned char* p = (const unsigned char*)utf8;
+    unsigned bytes = 0;
+    while (*p && bytes < 16384) {
+        const unsigned char* prev = p;
+        const unsigned cp = ovl_utf8(&p);
+        if (cp == 0xFFFFFFFFu) return 0;
+        if (native) { ovl_native_glyph glyph; if (!ovl_native_get(cp, &glyph, prepare)) return 0; }
+        bytes += (unsigned)(p - prev);
+    }
+    return bytes < 16384;
+}
+
+int rsx_overlay_text_supported(const char* utf8)
+{ return ovl_text_coverage(utf8, 0); }
+int rsx_overlay_text_prepare(const char* utf8)
+{ return ovl_text_coverage(utf8, 1); }

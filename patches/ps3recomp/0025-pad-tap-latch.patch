+/* ---------------------------------------------------------------------------
+ * Tap latch: the sampler thread
+ *
+ * Every PAD_TAP_PERIOD_US (1 ms) it samples each port that has a source
+ * (device, keyboard, script file). It sleeps on a high-resolution waitable
+ * timer, which keeps its period whatever the process timer resolution is
+ * (Windows 11 ignores timeBeginPeriod for a minimized window unless the
+ * process opts out -- host_sched does; this timer does not depend on it).
+ * -----------------------------------------------------------------------*/
+
+#ifndef CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
+  #define CREATE_WAITABLE_TIMER_HIGH_RESOLUTION 0x00000002
+#endif
+
+static HANDLE g_sampler;
+
+static u32 sampler_ports(void)
+{
+    u32 mask = 0;
+    if (g_cfg.devices) {
+        AcquireSRWLockShared(&g_dev_lock);
+        for (int i = 0; i < MAX_DEVS; i++)
+            if (g_dev[i].kind && g_dev[i].port >= 0 && g_dev[i].port < PADH_MAX_PORTS && !g_dev[i].lost)
+                mask |= 1u << g_dev[i].port;
+        ReleaseSRWLockShared(&g_dev_lock);
+    }
+    if (g_cfg.kb_port >= 0) mask |= 1u << g_cfg.kb_port;
+    if (g_cfg.kb2_port >= 0) mask |= 1u << g_cfg.kb2_port;
+    for (int p = 0; p < 2; p++) if (g_cfg.file[p][0]) mask |= 1u << p;
+    return mask;
+}
+
+static u64 ft_100ns(FILETIME f) { return ((u64)f.dwHighDateTime << 32) | f.dwLowDateTime; }
+
+static DWORD WINAPI sampler_main(LPVOID arg)
+{
+    (void)arg;
+    HANDLE tmr = CreateWaitableTimerExW(NULL, NULL, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+    if (!tmr) tmr = CreateWaitableTimerExW(NULL, NULL, 0, TIMER_ALL_ACCESS);
+    const LONGLONG period = qpc_from_us(g_cfg.tap_period_us);
+    LONGLONG next = qpc_now() + period;
+    /* statistics (latency_log / PS3_PAD_LATENCY=1) */
+    LONGLONG st_t0 = qpc_now(), prev_tick = 0;
+    u64 st_n = 0, st_late = 0;
+    double st_ival_max = 0, st_cost_sum = 0, st_cost_max = 0;
+    FILETIME fc, fe, fk, fu;
+    GetThreadTimes(GetCurrentThread(), &fc, &fe, &fk, &fu);
+    u64 cpu0 = ft_100ns(fk) + ft_100ns(fu);
+    for (;;) {
+        LONGLONG now = qpc_now();
+        if (next > now) {
+            LARGE_INTEGER due;
+            due.QuadPart = -(LONGLONG)((double)(next - now) * 1e7 / (double)g_qpf);   /* relative, 100 ns */
+            if (due.QuadPart == 0) due.QuadPart = -1;
+            if (tmr && SetWaitableTimer(tmr, &due, 0, NULL, NULL, FALSE)) WaitForSingleObject(tmr, INFINITE);
+            else Sleep(1);
+        }
+        const LONGLONG t = qpc_now();
+        const u32 mask = sampler_ports();
+        for (u32 p = 0; p < PADH_MAX_PORTS; p++) {
+            if (!(mask & (1u << p))) continue;
+            PortState* ps = &g_port[p];
+            AcquireSRWLockExclusive(&ps->lock);
+            sample_locked(p, ps, qpc_now());
+            ReleaseSRWLockExclusive(&ps->lock);
+        }
+        next += period;
+        if (t - next > 8 * period) next = t + period;    /* stalled (debugger, sleep): no burst */
+        if (!g_cfg.latency) continue;
+        const LONGLONG t1 = qpc_now();
+        st_n++;
+        { double c = qpc_to_us(t1 - t); st_cost_sum += c; if (c > st_cost_max) st_cost_max = c; }
+        if (prev_tick) {
+            double iv = qpc_to_us(t - prev_tick);
+            if (iv > st_ival_max) st_ival_max = iv;
+            if (iv > 2.0 * g_cfg.tap_period_us) st_late++;
+        }
+        prev_tick = t;
+        const double wall = qpc_to_us(t1 - st_t0);
+        if (wall >= 5e6) {
+            GetThreadTimes(GetCurrentThread(), &fc, &fe, &fk, &fu);
+            const u64 cpu1 = ft_100ns(fk) + ft_100ns(fu);
+            u64 held[PADH_READERS] = { 0 }, stale[PADH_READERS] = { 0 };
+            for (u32 p = 0; p < PADH_MAX_PORTS; p++)
+                for (int r = 0; r < PADH_READERS; r++) { held[r] += g_port[p].tap_held[r]; stale[r] += g_port[p].tap_stale[r]; }
+            printf("[pad-tap] sampler: %.1f Hz (ports 0x%02X), interval max %.2f ms, %llu over %.1f ms"
+                   " | sample cost avg %.1f us max %.1f us | thread CPU %.2f%% of one core"
+                   " | reads that held a tap: game %llu, local %llu; stale dropped %llu/%llu\n",
+                   (double)st_n * 1e6 / wall, mask, st_ival_max / 1000.0, (unsigned long long)st_late,
+                   2.0 * g_cfg.tap_period_us / 1000.0, st_n ? st_cost_sum / (double)st_n : 0.0, st_cost_max,
+                   (double)(cpu1 - cpu0) / 10.0 / wall * 100.0,
+                   (unsigned long long)held[PADH_READER_GAME], (unsigned long long)held[PADH_READER_LOCAL],
+                   (unsigned long long)stale[PADH_READER_GAME], (unsigned long long)stale[PADH_READER_LOCAL]);
+            fflush(stdout);
+            cpu0 = cpu1; st_t0 = t1; st_n = st_late = 0;
+            st_ival_max = st_cost_sum = st_cost_max = 0;
+        }
+    }
+}
+
+static void sampler_start(void)
+{
+    g_sampler = CreateThread(NULL, 0, sampler_main, NULL, 0, NULL);
+    if (!g_sampler) {
+        printf("[pad] tap latch: cannot start the sampler thread (error %lu); pads are read at the game's poll only\n",
+               (unsigned long)GetLastError());
+        g_cfg.tap_latch = 0;
+        return;
+    }
+    /* Above the game's threads so the 1 ms cadence holds under load; a
+     * sample takes microseconds. */
+    SetThreadPriority(g_sampler, THREAD_PRIORITY_HIGHEST);
+    typedef HRESULT (WINAPI *SetThreadDescription_t)(HANDLE, PCWSTR);
+    SetThreadDescription_t sd = (SetThreadDescription_t)(void*)GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "SetThreadDescription");
+    if (sd) sd(g_sampler, L"pad sampler");
+    printf("[pad] tap latch on: pads sampled every %u us; a press between two game reads is reported at the next read"
+           " (PAD_TAP_LATCH=0 turns it off)\n", g_cfg.tap_period_us);
+}

+/* Host-only UI input: padh_sample returns current mapped buttons, unlike
+ * padh_read it never consumes PADH_READER_GAME or PADH_READER_LOCAL's tap
+ * latch. The menu's release-to-arm/edge state is owned by its caller. */
+s32 cellPad_peek_local(u32 port_no, CellPadData* out)
+{
+    if (!out || port_no >= CELL_PAD_MAX_PORT_NUM)
+        return CELL_PAD_ERROR_INVALID_PARAMETER;
+    memset(out, 0, sizeof *out);
+#if PAD_BACKEND_XINPUT
+    PadHostPort st;
+    padh_sample(port_no, &st, padh_min_interval_us());
+    if (!st.connected) return CELL_OK;
+    const u16 b = st.buttons;
+    out->len = CELL_PAD_LEN_CHANGE_DEFAULT;
+    out->button[1] = (u16)(0x70 | (CELL_PAD_LEN_CHANGE_DEFAULT / 2));
+    out->button[CELL_PAD_BTN_OFFSET_DIGITAL1] = (u16)(b & 0xFF);
+    out->button[CELL_PAD_BTN_OFFSET_DIGITAL2] = (u16)(b >> 8);
+    out->button[CELL_PAD_BTN_OFFSET_ANALOG_RIGHT_X] = st.rx;
+    out->button[CELL_PAD_BTN_OFFSET_ANALOG_RIGHT_Y] = st.ry;
+    out->button[CELL_PAD_BTN_OFFSET_ANALOG_LEFT_X] = st.lx;
+    out->button[CELL_PAD_BTN_OFFSET_ANALOG_LEFT_Y] = st.ly;
+    return CELL_OK;
+#else
+    /* A portable focus + non-consuming device snapshot is required before
+     * claiming this capability. Keep the launcher usable in the meantime. */
+    return CELL_PAD_ERROR_NO_DEVICE;
+#endif
+}
+
+int cellPad_ui_focused(void)
+{
+#if PAD_BACKEND_XINPUT
+    HWND fg = GetForegroundWindow();
+    DWORD pid = 0;
+    if (!fg) return 0;
+    GetWindowThreadProcessId(fg, &pid);
+    return pid == GetCurrentProcessId();
+#else
+    return 0;
+#endif
+}
+
 /* Is anything (device, keyboard, script) assigned to this port? */

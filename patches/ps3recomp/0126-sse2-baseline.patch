+/* Without pshufb (patch 0126): one pass of 16 table reads over {a, b} as they lie in
+ * memory. A selector s picks SPU byte s & 15 of a or (bit 4) b = byte ((s & 0x1F) ^ 3) of
+ * the 32 (xor 3 leaves bit 4), and the control byte for a result byte sits at that
+ * result byte's own position, so no byte order is converted anywhere. The indexes come
+ * out of the vector as two 64-bit words and the result goes back the same way (no
+ * store the following load would have to wait for). Special selectors as in the SSE4.1
+ * form: bit 7 clears the looked-up byte, 110 gives 0xFF, 111 gives 0x80. */
+static inline u128 spu_shufb(u128 a, u128 b, u128 c) {
+    __m128i C; memcpy(&C, &c, 16);
+    /* Whole words first: a control whose every word reads 4k, 4k+1, 4k+2, 4k+3 (k = 0..7) moves word k of {a, b}
+     * there -- what cwd/cdd controls and float-vector shuffles are -- as four 32-bit moves. In host order such a
+     * control word is 0x(4k)(4k+1)(4k+2)(4k+3): xor 0x00010203 leaves 4k in all four bytes. */
+    {
+        const __m128i x = _mm_xor_si128(C, _mm_set1_epi32(0x00010203));
+        const __m128i t = _mm_and_si128(x, _mm_set1_epi32(0x1C));
+        __m128i rep = _mm_or_si128(t, _mm_slli_epi32(t, 8));
+        rep = _mm_or_si128(rep, _mm_slli_epi32(rep, 16));
+        if (_mm_movemask_epi8(_mm_cmpeq_epi32(rep, x)) == 0xFFFF) {
+            uint32_t W[8], k[4]; memcpy(W, &a, 16); memcpy(W + 4, &b, 16);
+            _mm_storeu_si128((__m128i*)k, _mm_srli_epi32(t, 2));
+            u128 out;
+            out._u32[0] = W[k[0]]; out._u32[1] = W[k[1]]; out._u32[2] = W[k[2]]; out._u32[3] = W[k[3]];
+            return out;
+        }

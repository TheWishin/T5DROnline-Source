+static void ld_prewarm_start(void)
+{
+    if (g_prewarm_on >= 0) return;
+    g_prewarm_on = 0;
+    const char* e = getenv("RSX_PSO_PREWARM");
+    if ((e && *e == '0') || !shader_disk_cache_prepare()) return;

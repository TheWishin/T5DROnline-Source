+/* PS3_SHADOWS=0 (patch 0079). A shadow sampler: a 2D depth-format unit with a
+ * compare zfunc (NEVER/ALWAYS and alpha kill excluded) -- the same rule as the
+ * PSO's shadow_mask, so the binding and the HLSL agree. */
+static int ld_shadow_sampler(const rsx_dsp_texture* t)
+{
+    const u32 bf = t->format & TEX_FMT_BASE_MASK;
+    const u32 zf = (t->wrap >> 28) & 0xFu;
+    return !t->cubemap && bf >= 0x90u && bf <= 0x93u && zf != 0u && zf < 7u && !(t->control0 & 0x4u);
+}
+static void ld_shadow_note(const rsx_dsp_texture* t)
+{
+    u32 i = 0;
+    for (; i < g_ld_shadow_n; i++)
+        if (g_ld_shadow_maps[i].location == t->location && g_ld_shadow_maps[i].offset == t->offset) break;
+    if (i == g_ld_shadow_n) {
+        if (g_ld_shadow_n < 4) g_ld_shadow_n++;
+        else i = 3;
+        g_ld_shadow_maps[i].location = t->location;
+        g_ld_shadow_maps[i].offset = t->offset;
+        fprintf(stderr, "[shadows] off: shadow map %u:0x%X (%ux%u) is not read, its draws are skipped\n",
+                t->location, t->offset, t->width, t->height);
+    }
+    g_ld_shadow_maps[i].frame = g_ld_frames;
+}
+/* A draw into a shadow map: its zeta is a map a shadow sampler read in the
+ * last 2 s, the pass is smaller than the canvas, and it writes depth (a pass
+ * that only leaves the zeta register there -- depth off -- is drawn). */
+static int ld_shadow_caster(void)
+{
+    if (!g_ld_shadow_n) return 0;
+    rsx_dsp_surface sf;
+    rsx_dsp_get_surface(&g.rsx, &sf);
+    if (sf.clip_w >= g.width && sf.clip_h >= g.height) return 0;
+    for (u32 i = 0; i < g_ld_shadow_n; i++)
+        if (g_ld_shadow_maps[i].location == sf.zeta_location && g_ld_shadow_maps[i].offset == sf.zeta_offset &&
+            g_ld_frames - g_ld_shadow_maps[i].frame <= 120u)
+            return (rsx_dsp_reg(&g.rsx, M_DEPTH_WRITE) & 1u) != 0;
+    return 0;
+}
+/* PS3_EFFECTS=0 (patch 0079): a blended draw that tests depth and does not
+ * write it, into a pass at least as large as the canvas that is not a display
+ * buffer (the 3D scene; the HUD, menus and movies are drawn into the display
+ * buffers and stay). */
+static int ld_effect_draw(void)
+{

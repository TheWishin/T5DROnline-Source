+    const IMAGE_NT_HEADERS* nt = (const IMAGE_NT_HEADERS*)((const u8*)dos + dos->e_lfanew);
+    g_prewarm_stamp = ((u64)nt->FileHeader.TimeDateStamp << 32) ^
+                      nt->OptionalHeader.SizeOfImage ^ ((u64)sizeof(ld_prewarm_rec) << 48);

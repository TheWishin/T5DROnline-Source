+/* Patch 0119: bounded independently decodable MP4 segments. */
+#ifndef PS3RECOMP_RSX_CLIPS_RING_H
+#define PS3RECOMP_RSX_CLIPS_RING_H
+#include <cstddef>
+#include <deque>
+#include <utility>
+#include <vector>
+namespace clips {
+struct Segment {
+    std::vector<unsigned char> bytes;
+    long long start = 0;
+    long long end = 0;
+};
+class Ring {
+public:
+    Ring(std::size_t byte_limit, long long duration100ns)
+        : limit_(byte_limit), duration_(duration100ns) {}
+    bool push(Segment&& segment) {
+        // Validate before mutation. Nonnegative timestamps make subtraction
+        // overflow-free, including near the signed clock limit.
+        if (!limit_ || duration_ <= 0 || segment.bytes.empty() ||
+            segment.bytes.capacity() > limit_ || segment.start < 0 ||
+            segment.end <= segment.start || segment.end - segment.start > duration_)
+            return false;
+        if (!segments_.empty() && (segment.start < segments_.back().start ||
+                                   segment.end < segments_.back().end)) return false;
+        const long long oldest = segment.end > duration_ ? segment.end - duration_ : 0;
+        while (!segments_.empty() && (segments_.size() >= 512 ||
+                                     segments_.front().start < oldest ||
+                                     bytes_ > limit_ - segment.bytes.capacity())) {
+            bytes_ -= segments_.front().bytes.capacity();
+            segments_.pop_front();
+        }
+        segments_.push_back(std::move(segment));
+        bytes_ += segments_.back().bytes.capacity();
+        return true;
+    }
+    // Age out footage even while the GPU is stalled or capture has stopped.
+    void expire(long long now) {
+        if (now < 0 || duration_ <= 0) return;
+        const long long oldest = now > duration_ ? now - duration_ : 0;
+        while (!segments_.empty() && segments_.front().start < oldest) {
+            bytes_ -= segments_.front().bytes.capacity();
+            segments_.pop_front();
+        }
+    }
+    const std::deque<Segment>& segments() const { return segments_; }
+    // Charge allocated vector capacity, not just compressed payload length.
+    std::size_t bytes() const { return bytes_; }
+    void clear() { segments_.clear(); bytes_ = 0; }
+private:
+    std::size_t limit_;
+    long long duration_;
+    std::size_t bytes_ = 0;
+    std::deque<Segment> segments_;
+};
+} // namespace clips
+#endif

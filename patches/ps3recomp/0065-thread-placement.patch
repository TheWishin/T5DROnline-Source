+/* ---- thread placement (patch 0065) -------------------------------------------
+ * host_sched_plan.h decides from the processor table (hs_topology) and the
+ * affinity mask; this part fills it in, keeps the plan and applies it to each
+ * thread in host_sched_thread_start. */
+static INIT_ONCE s_plan_once = INIT_ONCE_STATIC_INIT;
+static hsp_plan  s_plan;
+static int       s_plan_budget = 0;        /* PS3_CPUS, 0 = from the plan */
+
+/* An LP mask for a PS3_SCHED_CPUS spec ("all"/empty = 0 = no limit). */
+static uint64_t hs_spec_mask(const char* spec)
+{
+    if (!spec || !*spec || !strcmp(spec, "all") || s_ncpu == 0) return 0;
+    uint64_t m = 0;
+    if (!strcmp(spec, "fast") || !strcmp(spec, "slow")) {
+        const int want_fast = spec[0] == 'f';
+        for (int i = 0; i < s_ncpu; i++)
+            if ((s_cpu[i].llc == s_fast_llc) == want_fast && s_cpu[i].lp < 64) m |= 1ull << s_cpu[i].lp;
+        return m;
+    }
+    return (uint64_t)strtoull(spec, NULL, 0);
+}
+
+static BOOL CALLBACK hs_plan_once(PINIT_ONCE once, PVOID param, PVOID* ctx)
+{
+    (void)once; (void)param; (void)ctx;
+    hs_topology();
+    DWORD_PTR pm = 0, sm = 0;
+    if (!GetProcessAffinityMask(GetCurrentProcess(), &pm, &sm) || !pm) {
+        SYSTEM_INFO si; GetSystemInfo(&si);
+        pm = si.dwActiveProcessorMask;
+    }
+    uint64_t allowed = (uint64_t)pm;
+    const uint64_t spec = hs_spec_mask(getenv("PS3_SCHED_CPUS"));
+    if (spec && (allowed & spec)) allowed &= spec;
+    const char* e = getenv("PS3_CPUS");
+    s_plan_budget = e && atoi(e) > 0 ? atoi(e) : 0;
+    hsp_make(s_tab, s_ncpu, allowed, s_plan_budget, host_sched_laptop(), &s_plan);
+    if (s_plan_budget) s_plan.small = host_sched_cores() <= HSP_SMALL_CORES;
+    return TRUE;
+}
+static const hsp_plan* hs_plan(void)
+{
+    InitOnceExecuteOnce(&s_plan_once, hs_plan_once, NULL, NULL);
+    return &s_plan;
+}
+
+/* The pools' defaults. Power saving may switch on after the plan was made
+ * (integrated graphics are found by the renderer), so the pool part is
+ * worked out again at each call. PS3_SCHED_PLACE=0: patch 0047's sizes from
+ * the whole budget. */
+static hsp_plan hs_pools_now(void)
+{
+    hsp_plan p = *hs_plan();
+    const char* e = getenv("PS3_SCHED_PLACE");
+    if (e && *e == '0') {                       /* no CCD, no reserved cores */
+        p.hot = -1;
+        p.set[HSP_SPURS] = p.set[HSP_VERTEX] = 0;
+        hsp_pools(&p, host_sched_cpus(), host_sched_cores(), host_sched_laptop());
+        const int cpus = host_sched_cpus();
+        int s = cpus / 2;                       /* patch 0047: half the budget */
+        if (host_sched_laptop() && s > 6) s = 6;
+        if (s > cpus - 1) s = cpus - 1;
+        if (s > 12) s = 12;
+        p.spurs_threads = s < 1 ? 1 : s;
+        p.vertex_spin = host_sched_laptop() ? 300 : cpus >= 24 ? 2000 : 300;
+        return p;
+    }
+    hsp_pools(&p, s_plan_budget, s_plan_budget ? host_sched_cores() : 0, host_sched_laptop());
+    return p;
+}
+int host_sched_default_threads(int role)
+{
+    const hsp_plan p = hs_pools_now();
+    return role == HS_ROLE_VERTEX ? p.vertex_threads : role == HS_ROLE_SPURS ? p.spurs_threads : 1;
+}
+int host_sched_vertex_spin(void) { return hs_pools_now().vertex_spin; }
+int host_sched_small(void)
+{

+#include <time.h>
+/* Patch 0101: the same stamps off Windows, on the clock the compat QueryPerformanceCounter uses
+ * (CLOCK_MONOTONIC in ns, win32_compat.h), so [slow-frames] (boot_main.cpp) sees the flip request:
+ * the game part (release -> flip request) and the translation (flip request -> present) were 0. */
+void rsx_pf_stamp(int slot)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    __atomic_store_n(&g_rsx_pf[slot], (long long)ts.tv_sec * 1000000000LL + ts.tv_nsec, __ATOMIC_RELAXED);
+}
+void rsx_pf_guest_flip(void)
+{
+    rsx_pf_stamp(RSX_PF_GUEST_FLIP_QPC);
+    host_sched_main_flip_requested();   /* the game part ends (host_sched.c) */
+}

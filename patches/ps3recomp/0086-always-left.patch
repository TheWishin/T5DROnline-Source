     const u32 f = t0.format & 0x9Fu;
     if (t0.enabled && t0.width == 64 && t0.height == 64 && f >= 0x86u && f <= 0x88u) g_ld_fx64_n++;
 }
+/* ---------------------------------------------------------------------------
+ * Patch 0086 (T5DR "Always left", a 1.1.8 test): the player the game made P2 sees the fight as P1 would --
+ * the 3D picture mirrored, the HUD's two halves swapped with every element readable (rsx_always_left.h has
+ * the rules). The game asks for it per frame (rsx_live_draw_set_always_left, T5DR src/netplay/
+ * always_left.cpp: only in a fight, only for the P2 side); the walker takes it at each flip. Host pixels
+ * only: the draws are moved or mirrored through their viewport transform (xf) and scissor, nothing
+ * guest-visible changes, so the two PCs of a match may show it differently.
+ *
+ *   the 3D picture   the draw into the display buffer that samples a render target larger than it (the
+ *                    game's filtered copy of its 2048 x 1440 3D target, one full-screen quad): mirrored.
+ *   the HUD          every later draw into the display buffer in that frame: its vertices run through its
+ *                    vertex program on the CPU (al_vp_eval), and the quad is moved to its element's mirrored
+ *                    place, or mirrored when it is one half of a flipped pair (the bars' frames).
+ * -----------------------------------------------------------------------*/
+#include "rsx_always_left.h"
+static volatile LONG g_al_req;               /* the game's request (any thread) */
+static struct {
+    int active, copy_seen;
+    al_hud hud;
+    u64 frames, copies, moved, mirrored, left_alone;
+} g_al;
+
+void rsx_live_draw_set_always_left(int on) { InterlockedExchange(&g_al_req, on ? 1 : 0); }
+
+/* At each guest flip (walker thread): the frame's HUD becomes the next frame's layout; the request is taken. */
+static void ld_al_flip(void)
+{
+    if (g_al.active) {
+        g_al.frames++;
+        al_hud_frame_end(&g_al.hud);
+    } else {
+        g_al.hud.n_cur = g_al.hud.n_el = 0;
+    }
+    const int want = InterlockedCompareExchange(&g_al_req, 0, 0) != 0;
+    if (want != g_al.active) {
+        fprintf(stderr, "[always-left] %s at frame %u (so far: %llu frames, %llu pictures mirrored, HUD quads "
+                        "%llu moved / %llu mirrored / %llu left as they were)\n", want ? "on" : "off", g_ld_frames,
+                (unsigned long long)g_al.frames, (unsigned long long)g_al.copies, (unsigned long long)g_al.moved,
+                (unsigned long long)g_al.mirrored, (unsigned long long)g_al.left_alone);
+        g_al.hud.n_cur = g_al.hud.n_el = 0;
+    }
+    g_al.active = want;
+    g_al.copy_seen = 0;
+}
+
+static int ld_al_is_display(u32 target)
+{
+    for (u32 b = 0; b < 8; b++) {
+        const display_buffer_t* d = &g.display_buffers[b];

+#!/usr/bin/env python3
+"""Differential test of the lifted stores' reservation check (ppu_recomp.h PPU_COH_LOCAL, patch 0069).
+
+    python tools/storepath_diff.py --lift LIFT_DIR (--funcs FILE | --addr A,B,... | --sample N | --all)
+                                   [--iters N] [--unarmed] [--march x86-64-v3|none] [--work DIR]
+
+Takes functions of one lift and compiles every one of them twice into one
+harness, from the same text: once with the store check of 1.1.4 (the bitmap
+pointer vm_coh_bitmap, its NULL test, the line's own bit) and once with
+PPU_COH_LOCAL (vm_coh_bm_k, the line's 1 KB block byte, a block hit out of
+line). Unlike regpromo_diff.py the inline guest loads and stores stay ON
+(folded into the 64 KB sandbox like every other access; the windows cover
+0x10000..0xE0000000, so the low and high addresses still go out of line), and
+the trace records
+
+  * every guest store, inline or out of line, with its address, width and value;
+  * every store that reached the runtime's exact protocol on a reserved line
+    (the out-of-line vm_write* of a line whose own bit is set: a locked store
+    and a notify in the runtime);
+  * every post-store notify (vm_store_coh_notify; none is expected here: one
+    thread, the bitmap does not change during a run);
+
+besides everything regpromo_diff.py compares (the context after the run,
+guest memory, every load, call, store-conditional, with the context hash at
+each call). The reserved-line bitmap is the runtime's layout (a bit per
+128-byte line), a quarter of the 1 KB blocks with one reserved line and some
+with all eight; --unarmed runs with no line reserved (the 1.1.4 check's NULL
+pointer against an all-zero bitmap).
+
+So the two builds must agree on what each store does to memory and on which
+stores are coherent (go through the lock and the notify), while they differ in
+which stores take the call: the neighbours of a reserved line. Exit status 0 =
+no difference. Game-derived code stays in --work (never commit it).
+"""
+import argparse
+import os
+import random
+import re
+import sys
+import time
+
+TOOLS = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(TOOLS)
+sys.path.insert(0, TOOLS)
+
+import regpromo_diff as rd  # noqa: E402
+
+STORE_BEGIN = "static inline int vm_st_reserved(uint32_t ea)"
+STORE_END = "#define vm_write64(a, v) vm_write64_inl((a), (v))"
+
+
+def harness_header(text):
+    """The generated header for this harness: rd.harness_header (no function declarations, raw accesses folded),
+    inline loads and stores folded into the sandbox too, and the store block twice: _o (1.1.4) and _n (0069)."""
+    h = rd.harness_header(text)
+    n_ld = h.count("VM_BASE + ea")
+    n_st = h.count("VM_BASE + _ea")
+    if n_ld < 7 or n_st != 2 or STORE_BEGIN not in h or STORE_END not in h or "PPU_COH_LOCAL" not in h:
+        sys.exit("ppu_recomp.h: the inline access code is not where this tool expects it (a lift with patch 0069?)")
+    h = h.replace("VM_BASE + ea", "VM_BASE + HARN_EA(ea)").replace("VM_BASE + _ea", "VM_BASE + HARN_EA(_ea)")
+    i = h.index(STORE_BEGIN)
+    j = h.index(STORE_END) + len(STORE_END)
+    block = h[i:j]
+    block = "\n".join(ln for ln in block.split("\n") if not re.match(r"#define vm_write(8|16|32|64)\(a, v\)", ln))
+    # the event before the store, as the out-of-line vm_write* record theirs: a run stopped at its event limit
+    # (longjmp from ev) then has the same memory whichever path the stopping store took
+    st = "const T _bv = BSWAP((T)(v)); \\"
+    if block.count(st) != 1:
+        sys.exit("ppu_recomp.h: VM_ST_INL has another shape")
+    block = block.replace(st, st + "\n        harn_st_ev(_ea, (uint64_t)(v), (unsigned)sizeof(T)); \\")
+
+    def variant(sfx):
+        b = block
+        for name in ("vm_st_reserved", "VM_ST_INL", "vm_write8_inl", "vm_write16_inl", "vm_write32_inl", "vm_write64_inl"):
+            b = re.sub(r"\b%s\b" % name, name + "_" + sfx, b)
+        return b
+    pair = ("/* ---- the 1.1.4 store check ---- */\n#undef PPU_COH_LOCAL\n" + variant("o") +
+            "\n/* ---- patch 0069: the block byte through vm_coh_bm_k ---- */\n#define PPU_COH_LOCAL 1\n" + variant("n") + "\n")
+    return h[:i] + pair + h[j:]
+
+
+RUNTIME_EXTRA = r"""
+/* ---- storepath_diff: the gates, the bitmap, the store and coherence events ---- */
+static unsigned char g_coh[1u << 22];                /* a bit per 128-byte line of the 4 GB guest space */
+extern "C" {
+uint8_t* const vm_base_k = g_mem;
+const uint32_t vm_ld_lim_k = 0xDFFF0000u, vm_st_lim_k = 0xDFFF0000u, vm_refpoll_k = 0x0001A008u;
+const unsigned char* const vm_coh_bm_k = g_coh;
+}
+static int harn_xbit(uint32_t ea) { return (g_coh[ea >> 10] >> ((ea >> 7) & 7)) & 1; }
+/* per variant (0 = 1.1.4, 1 = 0069): stores inline, out of line, coherent (own line reserved), out of line on a
+ * block hit whose own line is free (0069's extra calls), post-store notifies */
+static int g_var;
+static unsigned long long g_n[2][5];
+static void harn_st_ev(uint32_t ea, uint64_t v, unsigned n) {
+    g_n[g_var][0]++;
+    ev((n == 1 ? 0x200000000ull : n == 2 ? 0x210000000ull : n == 4 ? 0x220000000ull : 0x230000000ull) | ea, v); }
+static struct HarnStats { ~HarnStats() {
+    for (int k = 0; k < 2; k++)
+        printf("STATS %s inline %llu out_of_line %llu coherent %llu block_only %llu notify %llu\n", k ? "new" : "old",
+               g_n[k][0], g_n[k][1], g_n[k][2], g_n[k][3], g_n[k][4]);
+    fflush(stdout); } } g_harn_stats;
+static struct HarnCohInit { HarnCohInit() {
+#ifndef HARN_UNARMED
+    for (uint32_t b = 0; b < (1u << 22); b++) {
+        uint64_t h = mix(0xC0FFEEull, b);
+        if (h % 4 == 0) g_coh[b] = (unsigned char)(1u << ((h >> 8) & 7));
+        else if (h % 61 == 1) g_coh[b] = 0xFF;
+    }
+#endif
+} } g_harn_coh_init;
+"""
+
+
+def runtime_text():
+    r = rd.RUNTIME
+    old_decl = "unsigned char* vm_coh_bitmap = 0;"
+    old_note = "void vm_store_coh_notify(uint32_t ea) { (void)ea; } }"
+    if old_decl not in r or old_note not in r:
+        sys.exit("regpromo_diff.RUNTIME has another shape")
+    r = r.replace(old_decl, "unsigned char* vm_coh_bitmap;")
+    r = r.replace(old_note, "void vm_store_coh_notify(uint32_t ea); }")
+    # the out-of-line stores: the runtime's exact protocol on a reserved line is a coherent store (locked + notify)
+    for w, t in ((8, "uint8_t"), (16, "uint16_t"), (32, "uint32_t"), (64, "uint64_t")):
+        head = 'extern "C" void vm_write%d(uint64_t a, %s v) { ' % (w, t)
+        if head not in r:
+            sys.exit("regpromo_diff.RUNTIME: vm_write%d has another shape" % w)
+        r = r.replace(head, head + "harn_coh_ev((uint32_t)a, %d); " % w)
+    stub = "if ((h >> 40) % 4 == 0) vm_write64(h2 & ~7ull, qs64(h));"   # a callee's own store: not counted
+    if stub not in r:
+        sys.exit("regpromo_diff.RUNTIME: harn_effect has another shape")
+    r = r.replace(stub, "if ((h >> 40) % 4 == 0) { g_stub = 1; vm_write64(h2 & ~7ull, qs64(h)); g_stub = 0; }")
+    pre = r"""
+static void ev(uint64_t a, uint64_t b);
+static int harn_xbit(uint32_t ea);
+static void harn_coh_ev(uint32_t ea, int w);
+static int g_stub;
+"""
+    post = RUNTIME_EXTRA + r"""
+static void harn_coh_ev(uint32_t ea, int w) {
+    /* an out-of-line store inside the window is one the inline check sent here; below 0x10000 or from
+     * 0xE0000000 both builds call anyway */
+    const int in_window = (uint32_t)(ea - 0x10000u) < vm_st_lim_k;
+    if (in_window && !g_stub) { g_n[g_var][1]++; if (!harn_xbit(ea)) g_n[g_var][3]++; }
+    if (harn_xbit(ea)) { if (!g_stub) g_n[g_var][2]++; ev(0x600000000ull | ea, 1); }
+    (void)w; }
+extern "C" void vm_store_coh_notify(uint32_t ea) { g_n[g_var][4]++; ev(0x610000000ull | ea, 0); }
+static struct HarnArm { HarnArm() {
+#ifndef HARN_UNARMED
+    vm_coh_bitmap = g_coh;
+#else
+    vm_coh_bitmap = 0;
+#endif
+} } g_harn_arm;
+"""
+    # ev() is defined inside RUNTIME; harn_xbit/harn_st_ev need g_coh from RUNTIME_EXTRA: put the forward
+    # declarations first, the extras right after RUNTIME's own definitions
+    return pre + r + post
+
+
+def harness_source(header, preamble, funcs):
+    """C++ for one harness: funcs = [(addr, text)], each compiled as harn_old_X (1.1.4 check) and harn_new_X (0069)."""
+    pre = preamble.replace("#define PPU_INLINE_STORES 1", "/* (PPU_INLINE_STORES: above the header) */")
+    if '#include "ppu_recomp.h"' not in pre:
+        sys.exit("chunk preamble: no #include \"ppu_recomp.h\"")
+    pre = pre.replace('#include "ppu_recomp.h"', "/* ppu_recomp.h (harness copy) above */")
+    out = ["/* storepath_diff harness -- generated; holds lifted game code: do not commit */",
+           "#define PPU_INLINE_STORES 1", "#define HARN_EA(ea) ((uint32_t)(ea) & 0xFFFFu)", "#include <stddef.h>",
+           "#include <stdint.h>", "static void harn_st_ev(uint32_t ea, uint64_t v, unsigned n);",
+           header,
+           "\n".join("#undef vm_read%d" % w for w in (8, 16, 32, 64)) + "   /* the runtime's out-of-line ones below */",
+           pre, runtime_text(),
+           "\n".join("#define vm_read%d(a) vm_read%d_inl(a)" % (w, w) for w in (8, 16, 32, 64)) +
+           "   /* the lifted code's inline loads */"]
+    callees = set()
+    for addr, txt in funcs:
+        callees |= set(re.findall(r"\b((?:[A-Za-z_]\w*?)?func_[0-9A-F]{8})\b", txt))
+    for c in sorted(callees):
+        a = re.search(r"func_([0-9A-F]{8})$", c).group(1)
+        out.append(f"static __attribute__((noinline)) void {c}(ppu_context* ctx) {{ harn_call(ctx, 0x{a}u); }}")
+    tbl = []
+    for addr, txt in funcs:
+        first, rest = txt.split("\n", 1)
+        rest = rest.replace("vm_base + (uint32_t)ea", "vm_base + HARN_EA(ea)")     # dcbz, as regpromo_diff
+        body = "\n".join(ln + (" harn_tick();" if rd.LABEL_RE.match(ln) else "") for ln in rest.split("\n"))
+        for tag, sfx in (("old", "o"), ("new", "n")):
+            for w in (8, 16, 32, 64):
+                out.append(f"#undef vm_write{w}\n#define vm_write{w}(a, v) vm_write{w}_inl_{sfx}((a), (v))")
+            out.append(f"__attribute__((noinline)) void harn_{tag}_{addr:08X}(ppu_context* ctx) {{")
+            out.append(body)
+        tbl.append(f"    {{ 0x{addr:08X}u, harn_old_{addr:08X}, harn_new_{addr:08X} }},")
+    out.append("struct HarnFn { uint32_t addr; void (*o)(ppu_context*); void (*n)(ppu_context*); };")
+    out.append("static const HarnFn g_fns[] = {")
+    out += tbl
+    out.append("};")
+    out.append(f"#define NFN {len(funcs)}")
+    drv = rd.DRIVER
+    for old, new in (("if (setjmp(g_jb) == 0) g_fns[fi].o(&g_a); else ab_a = 1;",
+                      "g_var = 0; if (setjmp(g_jb) == 0) g_fns[fi].o(&g_a); else ab_a = 1;"),
+                     ("if (setjmp(g_jb) == 0) g_fns[fi].n(&g_b); else ab_b = 1;",
+                      "g_var = 1; if (setjmp(g_jb) == 0) g_fns[fi].n(&g_b); else ab_b = 1;")):
+        if old not in drv:
+            sys.exit("regpromo_diff.DRIVER has another shape")
+        drv = drv.replace(old, new)
+    out.append(drv)
+    return "\n".join(out)
+
+
+def broken(header):
+    """--self-check: the new check made blind (never reserved), which the harness must catch."""
+    probe = "return __atomic_load_n(&vm_coh_bm_k[ea >> 10], __ATOMIC_RELAXED) != 0;"
+    if header.count(probe) != 2:
+        sys.exit("--self-check: the new check is not where expected")
+    i = header.index("/* ---- patch 0069: the block byte through vm_coh_bm_k ---- */")   # the _n copy only
+    return header[:i] + header[i:].replace(probe, "return 0 && vm_coh_bm_k;", 1)
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--lift", required=True, help="a lift made with patch 0069's lifter (its ppu_recomp.h has both checks)")
+    sel = ap.add_mutually_exclusive_group(required=True)
+    sel.add_argument("--funcs", help="file of guest addresses (hex, first token per line, # comments)")
+    sel.add_argument("--addr", help="comma-separated guest addresses")
+    sel.add_argument("--sample", type=int, help="this many functions at random (--seed)")
+    sel.add_argument("--all", action="store_true", help="every function of the lift")
+    ap.add_argument("--seed", type=int, default=1)
+    ap.add_argument("--iters", type=int, default=10000, help="random inputs per function")
+    ap.add_argument("--events", type=int, default=20000, help="events before a run is stopped")
+    ap.add_argument("--batch", type=int, default=400, help="functions per harness executable")
+    ap.add_argument("--march", default="x86-64-v3", help="x86-64-v3 (as most players) or none (baseline)")
+    ap.add_argument("--unarmed", action="store_true", help="no line reserved (before the first GETLLAR)")
+    ap.add_argument("--self-check", action="store_true",
+                    help="make the new check blind on purpose: the run must FAIL (shows the harness sees it)")
+    ap.add_argument("--work", default=os.path.join(ROOT, "scratch", "storepath_diff"))
+    a = ap.parse_args()
+
+    funcs, pre = rd.read_lift(a.lift)
+    allf = sorted(funcs)
+    if a.funcs:
+        with open(a.funcs) as f:
+            want = [int(t.split()[0], 16) for t in (ln.split("#", 1)[0].strip() for ln in f) if t]
+    elif a.addr:
+        want = [int(t, 16) for t in a.addr.split(",") if t.strip()]
+    elif a.sample:
+        want = random.Random(a.seed).sample(allf, min(a.sample, len(allf)))
+    else:
+        want = allf
+    missing = [w for w in want if w not in funcs]
+    if missing:
+        print(f"not in the lift (skipped): {', '.join(f'{m:08X}' for m in missing[:20])}")
+    sel_f = [(w, funcs[w][1]) for w in want if w in funcs]
+    with open(os.path.join(a.lift, "ppu_recomp.h"), encoding="latin-1") as f:
+        header = harness_header(f.read())
+    if a.self_check:
+        header = broken(header)
+    print(f"{len(sel_f)} functions, {a.iters} inputs each, -march={a.march}, "
+          f"bitmap {'empty (unarmed)' if a.unarmed else 'armed'}{', SELF-CHECK (new check blind)' if a.self_check else ''}",
+          flush=True)
+    os.makedirs(a.work, exist_ok=True)
+    log = os.path.join(a.work, "storepath_diff.log")
+    t0 = time.time()
+    n_done = n_diff = 0
+    stuck_all = []
+    stats = {"old": [0] * 5, "new": [0] * 5}
+    for b in range(0, len(sel_f), a.batch):
+        chunk = sel_f[b:b + a.batch]
+        tag = f"{b // a.batch:03d}{'u' if a.unarmed else ''}{'x' if a.self_check else ''}"
+        src = os.path.join(a.work, f"harness_{tag}.cpp")
+        exe = os.path.join(a.work, f"harness_{tag}.exe")
+        with open(src, "w", encoding="latin-1") as f:
+            f.write(("#define HARN_UNARMED 1\n" if a.unarmed else "") + harness_source(header, pre, chunk))
+        ct = rd.compile_harness(src, exe, a.march)
+        at = os.path.getsize(log) if os.path.exists(log) else 0
+        d, x, st = rd.run_harness(exe, len(chunk), a.iters, a.events, log)
+        with open(log, encoding="utf-8", errors="replace") as lf:
+            lf.seek(at)
+            for ln in lf:
+                if ln.startswith("STATS "):
+                    p = ln.split()
+                    stats[p[1]] = [s + int(v) for s, v in zip(stats[p[1]], p[3::2])]
+        n_done += d
+        n_diff += x
+        stuck_all += [chunk[s][0] for s in st]
+        print(f"  batch {b // a.batch}: {d} functions, {x} differing runs (compile {ct:.0f} s, "
+              f"{time.time() - t0:.0f} s so far)", flush=True)
+    for k in ("old", "new"):
+        s = stats[k]
+        print(f"  {k}: guest stores inline {s[0]}, out of line inside the window {s[1]} (of which on a free line of a "
+              f"reserved block {s[3]}), coherent (own line reserved) {s[2]}, post-store notifies {s[4]}")
+    print(f"RESULT: {n_done} functions x {a.iters} inputs = {n_done * a.iters} runs, {n_diff} differing; "
+          f"stuck/crashed: {', '.join(f'{s:08X}' for s in stuck_all) or 'none'}")
+    sys.exit(1 if n_diff or stuck_all else 0)
+
+
+if __name__ == "__main__":
+    main()

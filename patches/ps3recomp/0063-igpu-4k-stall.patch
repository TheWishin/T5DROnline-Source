+/* PDH, loaded on first use (no link dependency): the processors' real clock.
+ * The query's set-up (PdhAddEnglishCounter loads the counter providers) takes
+ * ~0.3-0.4 s once per process; the caller is the vblank ticker (the
+ * [slow-frames] line), so the set-up and the first sample run on a thread of
+ * their own -- on the ticker they held the game's clock and froze the picture
+ * that long once per run, 30 s or 5 minutes in (review-113). Later samples
+ * (one collect, ~1 ms every 30 s or more) stay on the caller's thread. */
+typedef LONG (WINAPI *pfn_PdhOpenQueryW)(LPCWSTR, DWORD_PTR, HANDLE*);
+typedef LONG (WINAPI *pfn_PdhAddEnglishCounterW)(HANDLE, LPCWSTR, DWORD_PTR, HANDLE*);
+typedef LONG (WINAPI *pfn_PdhCollectQueryData)(HANDLE);
+typedef struct { DWORD CStatus; DWORD pad; double doubleValue; } hs_pdh_value;
+typedef LONG (WINAPI *pfn_PdhGetFormattedCounterValue)(HANDLE, DWORD, LPDWORD, hs_pdh_value*);
+static volatile LONG s_clk_state = -1;  /* -1 untried, 0 unavailable or being set up, 1 ready */
+static HANDLE s_clk_q, s_clk_perf, s_clk_freq;
+static pfn_PdhCollectQueryData s_clk_collect;
+static pfn_PdhGetFormattedCounterValue s_clk_value;
+static DWORD WINAPI hs_clock_setup(LPVOID arg)
+{
+    (void)arg;
+    HMODULE m = LoadLibraryA("pdh.dll");
+    if (!m) return 0;
+    pfn_PdhOpenQueryW open = (pfn_PdhOpenQueryW)(void*)GetProcAddress(m, "PdhOpenQueryW");
+    pfn_PdhAddEnglishCounterW add = (pfn_PdhAddEnglishCounterW)(void*)GetProcAddress(m, "PdhAddEnglishCounterW");
+    s_clk_collect = (pfn_PdhCollectQueryData)(void*)GetProcAddress(m, "PdhCollectQueryData");
+    s_clk_value = (pfn_PdhGetFormattedCounterValue)(void*)GetProcAddress(m, "PdhGetFormattedCounterValue");
+    if (!open || !add || !s_clk_collect || !s_clk_value || open(NULL, 0, &s_clk_q) != 0) return 0;
+    if (add(s_clk_q, L"\\Processor Information(_Total)\\% Processor Performance", 0, &s_clk_perf) != 0 ||
+        add(s_clk_q, L"\\Processor Information(_Total)\\Processor Frequency", 0, &s_clk_freq) != 0)
+        return 0;
+    s_clk_collect(s_clk_q);                       /* the first sample: the next collect has a rate */
+    InterlockedExchange(&s_clk_state, 1);         /* (a full barrier: the handles above are visible first) */
+    return 0;
+}
+int host_sched_clock_text(char* buf, int len)
+{
+    if (!buf || len <= 0) return 0;
+    buf[0] = 0;
+    if (s_clk_state < 0) {                        /* (one caller: the vblank ticker) */
+        s_clk_state = 0;
+        const char* e = getenv("PS3_CLOCK_SAMPLE");

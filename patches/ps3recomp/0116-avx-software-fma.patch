+                            L"(your saves are kept).",
+                            L"T5DR Online - build the game again", MB_OK | MB_ICONWARNING | MB_SETFOREGROUND);
+            ExitProcess(14);
+        }
+        if (strcmp(march, "avx") == 0 &&
+            (!ppu_host_has_avx() || (t && strcmp(t, "noavx") == 0))) {

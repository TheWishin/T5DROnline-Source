+
+static const Preset* find_preset(int cls, const char* name)
+{
+    for (unsigned i = 0; i < sizeof k_presets / sizeof k_presets[0]; i++)
+        if (k_presets[i].cls == cls && name_eq(k_presets[i].name, name)) return &k_presets[i];
+    return NULL;
+}
+
+static void bind_add(BindTable* t, u16 src, u16 mask)
+{
+    for (int i = 0; i < t->n; i++)
+        if (t->b[i].src == src) { t->b[i].mask |= mask; return; }
+    if (t->n < BIND_MAX) { t->b[t->n].src = src; t->b[t->n].mask = mask; t->n++; }
+}
+
+/* Apply one "TARGET = SOURCES" line. replace: drop what the target had and
+ * take the sources away from whatever they did before (an explicit binding
+ * means "this key now does that", not "this key ALSO does that"). */
+static void bind_line(BindTable* t, int cls, const char* target, const char* sources,
+                      int replace, const char* where)
+{
+    char tgt[40]; snprintf(tgt, sizeof tgt, "%s", target);
+    char* tg = trim(tgt);
+    if (name_eq(tg, "preset") || name_eq(tg, "macros")) return;
+    for (int a = 0; a < 4; a++) {
+        if (!name_eq(tg, k_axis_targets[a])) continue;
+        if (cls == CLS_KEYS) return;
+        char v[64]; snprintf(v, sizeof v, "%s", sources);
+        char* s = trim(v);
+        if (!*s || name_eq(s, "none")) { t->axis[a] = -1; return; }
+        int inv, ax = parse_axis(cls, s, &inv);
+        if (ax < 0) { printf("[pad] %s: unknown axis '%s' for %s\n", where, s, tg); return; }
+        t->axis[a] = (s8)ax; t->inv[a] = (u8)inv;
+        return;
+    }
+    u16 mask = parse_target_mask(tg);
+    if (!mask) { printf("[pad] %s: unknown PS3 button '%s'\n", where, tg); return; }
+    int srcs[16], ns = 0;
+    char buf[200]; snprintf(buf, sizeof buf, "%s", sources);
+    char* save = NULL;
+    for (char* tok = strtok_s(buf, " ,\t", &save); tok; tok = strtok_s(NULL, " ,\t", &save)) {
+        if (name_eq(tok, "none")) continue;
+        int id = parse_source(cls, tok);
+        if (id < 0) { printf("[pad] %s: unknown %s input '%s' (for %s)\n", where, k_cls_name[cls], tok, tg); continue; }
+        if (ns < 16) srcs[ns++] = id;
+    }
+    if (replace) {
+        /* The target's old sources lose it (combos that merely include it,
+         * like a 1+2 macro when 1 is re-bound, stay); the new sources lose
+         * whatever they did before. */
+        for (int i = 0; i < t->n; i++) {
+            int stolen = 0;
+            for (int k = 0; k < ns; k++) if (t->b[i].src == srcs[k]) stolen = 1;
+            if (stolen || t->b[i].mask == mask) t->b[i].mask = 0;
+        }
+        int o = 0;
+        for (int i = 0; i < t->n; i++) if (t->b[i].mask) t->b[o++] = t->b[i];
+        t->n = o;
+    }
+    for (int k = 0; k < ns; k++) bind_add(t, (u16)srcs[k], mask);
+}
+
+static void apply_lines(BindTable* t, int cls, const char* const* lines, int replace, const char* where)
+{
+    for (; lines && *lines; lines++) {
+        char l[128]; snprintf(l, sizeof l, "%s", *lines);
+        char* eq = strchr(l, '=');
+        if (!eq) continue;
+        *eq = 0;
+        bind_line(t, cls, l, eq + 1, replace, where);
+    }
+}
+
+static void apply_section(BindTable* t, int cls, const IniSec* s)
+{
+    for (int i = s->first; i < s->first + s->count; i++)
+        bind_line(t, cls, g_kv[i].key, g_kv[i].val, 1, s->name);
+}
+
+static void desc_add(BindTable* t, const char* what)
+{
+    size_t n = strlen(t->desc);
+    snprintf(t->desc + n, sizeof t->desc - n, "%s%s", n ? " + " : "", what);
+}
+
+/* Effective table for one device: preset, then the macro overlay, then the
+ * user's lines, least specific first:
+ *   [<cls>]  ->  [<cls>.VVVV:PPPP]  ->  [port<N>.<cls>]
+ * (keyboard players: [keys1] / [keys2]). */
+static void build_table(BindTable* t, int cls, int port, u16 vid, u16 pid, const char* keys_sec)
+{
+    memset(t, 0, sizeof *t);
+    for (int a = 0; a < 4; a++) t->axis[a] = -1;
+    const IniSec* layer[3] = { NULL, NULL, NULL };
+    char name[48];
+    if (cls == CLS_KEYS) {
+        layer[0] = ini_section(keys_sec);
+    } else {
+        layer[0] = ini_section(k_cls_name[cls]);
+        if (cls == CLS_DINPUT) {
+            snprintf(name, sizeof name, "dinput.%04X:%04X", vid, pid);
+            layer[1] = ini_section(name);
+        }
+        if (port >= 0) {
+            snprintf(name, sizeof name, "port%d.%s", port + 1, k_cls_name[cls]);
+            layer[2] = ini_section(name);
+        }
+    }
+    /* Preset: the most specific layer that names one, else the default. */
+    const char* pname = NULL;
+    for (int l = 2; l >= 0 && !pname; l--)
+        if (layer[l]) {
+            for (int i = layer[l]->first + layer[l]->count - 1; i >= layer[l]->first; i--)
+                if (name_eq(g_kv[i].key, "preset")) { pname = g_kv[i].val; break; }
+        }
+    if (!pname) {
+        if (cls == CLS_KEYS) pname = name_eq(keys_sec, "keys1") ? "classic" : "none";
+        else if (cls == CLS_XINPUT) pname = "standard";
+        else if (vid == 0x057E) pname = "switch";      /* Nintendo */
+        else if (vid == 0x045E) pname = "xbox";        /* Microsoft, non-XInput */
+        else pname = "ps";
+    }
+    const Preset* p = find_preset(cls, pname);
+    if (p) { apply_lines(t, cls, p->lines, 0, p->name); desc_add(t, p->name); }
+    else if (!name_eq(pname, "none")) printf("[pad] unknown %s preset '%s'\n", k_cls_name[cls], pname);
+    /* Macro overlay: [portN] macros = tekken, or macros = tekken in a layer. */
+    const char* macros = NULL;
+    for (int l = 2; l >= 0 && !macros; l--)
+        if (layer[l]) {
+            for (int i = layer[l]->first + layer[l]->count - 1; i >= layer[l]->first; i--)
+                if (name_eq(g_kv[i].key, "macros")) { macros = g_kv[i].val; break; }
+        }
+    if (!macros && port >= 0) { snprintf(name, sizeof name, "port%d", port + 1); macros = ini_get(name, "macros"); }
+    if (macros && name_eq(macros, "tekken") && cls != CLS_KEYS) {
+        apply_lines(t, cls, cls == CLS_XINPUT ? k_macros_tekken_xinput : k_macros_tekken_dinput, 1, "macros");
+        desc_add(t, "tekken macros");
+    }
+    for (int l = 0; l < 3; l++)
+        if (layer[l] && layer[l]->count) { apply_section(t, cls, layer[l]); desc_add(t, layer[l]->name); }
+}
+
+/* ---------------------------------------------------------------------------
+ * Configuration
+ * -----------------------------------------------------------------------*/
+
+enum { SOCD_OFF = 0, SOCD_NEUTRAL, SOCD_UP, SOCD_LAST };
+enum { SPEC_AUTO = 0, SPEC_NONE, SPEC_XINPUT, SPEC_DINPUT };
+enum { MIRROR_OFF = 0, MIRROR_KEYBOARD, MIRROR_ALL };
+
+typedef struct {
+    int  spec;              /* SPEC_* */
+    int  xi_slot;           /* SPEC_XINPUT: slot or -1 = any */
+    u16  vid, pid;          /* SPEC_DINPUT by id (vid != 0) */
+    char match[48];         /* SPEC_DINPUT by product-name substring */
+    int  stick_dpad;        /* device left stick drives the d-pad */
+    int  socd;
+} PortCfg;
+
+static struct {
+    int  xinput, dinput, dinput_all, background;
+    int  kb_port, kb2_port;          /* 0-based, -1 = off */
+    int  min_ports;                  /* ports reported connected at least */
+    int  mirror;
+    int  log;                        /* 1 = reads, 2 = + raw device presses */
+    int  latency;
+    int  devices;                    /* physical devices enabled */
+    u32  min_interval_us;
+    char file[2][MAX_PATH * 2];      /* PS3_PAD_FILE / PS3_PAD_FILE2 */
+    PortCfg port[PADH_MAX_PORTS];
+    BindTable keys[2];
+} g_cfg;
+
+static int parse_socd(const char* v, int def)
+{
+    if (!v || !*v) return def;
+    if (name_eq(v, "off") || name_eq(v, "0")) return SOCD_OFF;
+    if (name_eq(v, "neutral")) return SOCD_NEUTRAL;
+    if (name_eq(v, "up")) return SOCD_UP;
+    if (name_eq(v, "last")) return SOCD_LAST;
+    printf("[pad] unknown socd mode '%s'\n", v);
+    return def;
+}
+
+static int parse_port_number(const char* v, int def)
+{
+    if (!v || !*v) return def;
+    if (name_eq(v, "off") || name_eq(v, "none")) return -1;
+    int n = atoi(v);
+    return (n >= 1 && n <= PADH_MAX_PORTS) ? n - 1 : (n == 0 ? -1 : def);
+}
+
+static void parse_device_spec(PortCfg* pc, const char* v)
+{
+    pc->spec = SPEC_AUTO; pc->xi_slot = -1; pc->vid = pc->pid = 0; pc->match[0] = 0;
+    if (!v || !*v || name_eq(v, "auto")) return;
+    if (name_eq(v, "none")) { pc->spec = SPEC_NONE; return; }
+    if (!_strnicmp(v, "xinput", 6)) {
+        pc->spec = SPEC_XINPUT;
+        if (v[6] == ':') pc->xi_slot = atoi(v + 7);
+        return;
+    }
+    if (!_strnicmp(v, "dinput", 6)) {
+        pc->spec = SPEC_DINPUT;
+        if (v[6] != ':') return;
+        const char* s = v + 7;
+        unsigned a, b;
+        if (strlen(s) == 9 && s[4] == ':' && sscanf(s, "%4x:%4x", &a, &b) == 2) { pc->vid = (u16)a; pc->pid = (u16)b; return; }
+        snprintf(pc->match, sizeof pc->match, "%s", s);
+        return;
+    }
+    printf("[pad] unknown device '%s' (auto | none | xinput[:N] | dinput[:VVVV:PPPP | :name])\n", v);
+}
+
+static int env_int(const char* name, int def)
+{
+    const char* v = getenv(name);
+    return (v && *v) ? atoi(v) : def;
+}
+
+static void load_config(void)
+{
+    /* Where: PS3_CONTROLS, else controls.ini next to the executable, else in
+     * the working directory. No file = the defaults documented in
+     * docs/controls.ini. */
+    const char* env = getenv("PS3_CONTROLS");
+    int ok = 0;
+    if (env && *env) {
+        snprintf(g_cfg_path, sizeof g_cfg_path, "%s", env);
+        ok = ini_load(g_cfg_path);
+        if (!ok) printf("[pad] PS3_CONTROLS=%s: cannot open, using defaults\n", env);
+    } else {
+        char exe[MAX_PATH * 2];
+        DWORD n = GetModuleFileNameA(NULL, exe, (DWORD)sizeof exe);
+        if (n && n < sizeof exe) {
+            char* slash = strrchr(exe, '\\');
+            if (slash) { slash[1] = 0; snprintf(g_cfg_path, sizeof g_cfg_path, "%scontrols.ini", exe); ok = ini_load(g_cfg_path); }
+        }
+        if (!ok) { snprintf(g_cfg_path, sizeof g_cfg_path, "controls.ini"); ok = ini_load(g_cfg_path); }
+    }
+    if (!ok) g_cfg_path[0] = 0;
+
+    g_cfg.xinput      = ini_int("general", "xinput", 1);
+    g_cfg.dinput      = ini_int("general", "dinput", 1);
+    g_cfg.dinput_all  = env_int("PS3_PAD_DINPUT_ALL", ini_int("general", "dinput_all", 0));
+    g_cfg.background  = ini_int("general", "background", 1);
+    g_cfg.kb_port     = parse_port_number(ini_get("general", "keyboard"), 0);
+    g_cfg.kb2_port    = parse_port_number(ini_get("general", "keyboard2"), 1);
+    if (getenv("PAD_NO_KEYBOARD")) g_cfg.kb_port = g_cfg.kb2_port = -1;
+    g_cfg.min_ports   = ini_int("general", "min_ports", 1);
+    { const char* m = ini_get("general", "mirror_stick");
+      g_cfg.mirror = !m ? MIRROR_KEYBOARD : name_eq(m, "all") ? MIRROR_ALL :
+                     (name_eq(m, "off") || name_eq(m, "0")) ? MIRROR_OFF : MIRROR_KEYBOARD; }
+    g_cfg.log         = env_int("PS3_PAD_LOG", ini_int("general", "log", 0));
+    g_cfg.latency     = env_int("PS3_PAD_LATENCY", ini_int("general", "latency_log", 0));
+    g_cfg.min_interval_us = (u32)env_int("PS3_PAD_MIN_INTERVAL_US", ini_int("general", "min_interval_us", 1000));
+    int socd = parse_socd(ini_get("general", "socd"), SOCD_NEUTRAL);
+
+    const char* f0 = getenv("PS3_PAD_FILE");
+    const char* f1 = getenv("PS3_PAD_FILE2");
+    snprintf(g_cfg.file[0], sizeof g_cfg.file[0], "%s", f0 ? f0 : "");
+    snprintf(g_cfg.file[1], sizeof g_cfg.file[1], "%s", f1 ? f1 : "");
+    /* A scripted run must not be disturbed by whatever pad is plugged in:
+     * with PS3_PAD_FILE/FILE2 set, physical devices are off unless
+     * PS3_PAD_DEVICES=1. The keyboard stays (focus-gated). */
+    g_cfg.devices = (g_cfg.file[0][0] || g_cfg.file[1][0]) ? env_int("PS3_PAD_DEVICES", 0) : 1;
+
+    for (int p = 0; p < PADH_MAX_PORTS; p++) {
+        char sec[16]; snprintf(sec, sizeof sec, "port%d", p + 1);
+        PortCfg* pc = &g_cfg.port[p];
+        parse_device_spec(pc, ini_get(sec, "device"));
+        const char* st = ini_get(sec, "stick");
+        pc->stick_dpad = st && name_eq(st, "dpad");
+        pc->socd = parse_socd(ini_get(sec, "socd"), socd);
+        if (p < 2 && g_cfg.file[p][0]) pc->spec = SPEC_NONE;   /* the file owns that port */
+    }
+    build_table(&g_cfg.keys[0], CLS_KEYS, g_cfg.kb_port, 0, 0, "keys1");
+    build_table(&g_cfg.keys[1], CLS_KEYS, g_cfg.kb2_port, 0, 0, "keys2");
+    if (!g_cfg.keys[0].n) g_cfg.kb_port = -1;
+    if (!g_cfg.keys[1].n) g_cfg.kb2_port = -1;
+}
+
+/* ---------------------------------------------------------------------------
+ * Devices
+ * -----------------------------------------------------------------------*/
+
+enum { DEV_XINPUT = 1, DEV_DINPUT = 2 };
+#define MAX_DEVS 16
+
+typedef struct {
+    int  kind;                 /* 0 = free slot */
+    volatile LONG lost;        /* a read failed: the hot-plug thread drops it */
+    int  port;                 /* -1 = not assigned */
+    u32  order;
+    DWORD xi;
+    IDirectInputDevice8W* di;
+    GUID inst;
+    u16  vid, pid;
+    char name[80];
+    BindTable bind;
+    u32  last_bits[(CID_COUNT + 31) / 32];
+    u8   rumble[2];
+} PadDev;
+
+static PadDev   g_dev[MAX_DEVS];
+static SRWLOCK  g_dev_lock = SRWLOCK_INIT;
+static u32      g_dev_order;
+static IDirectInput8W* g_di;
+static HANDLE   g_hotplug_thread, g_hotplug_stop;
+
+typedef struct {
+    SRWLOCK lock;
+    int have;
+    PadHostPort last;
+    LONGLONG t_begin, t_end;      /* last sample */
+    u16 socd_prev;                /* raw directions of the previous sample */
+    u16 socd_h, socd_v;           /* last-input-wins winners */
+    u64 file_t[1];                /* last T= stamp seen in the port's file */
+    LONGLONG file_t_seen;         /* when we first sampled it */
+    int file_t_pending;           /* not yet handed to the title */
+    u16 file_btns;                /* buttons the file held last time */
+    /* latency statistics */
+    u64 n_reads, n_fresh, n_samples;
+    double cost_sum, cost_max, age_sum, age_max;
+    LONGLONG last_read, stat_t0;
+    double ival_sum; u64 ival_n;
+} PortState;
+
+static PortState g_port[PADH_MAX_PORTS];
+
+static int window_focused(void)
+{
+    HWND fg = GetForegroundWindow();
+    if (!fg) return 0;
+    DWORD pid = 0;
+    GetWindowThreadProcessId(fg, &pid);
+    return pid == GetCurrentProcessId();
+}
+
+static s32 xi_stick(short raw)
+{
+    /* XINPUT_GAMEPAD_LEFT_THUMB_DEADZONE, rescaled so travel stays full. */
+    const int dz = 7849;
+    int v = raw;
+    if (v > dz) return (s32)((v - dz) * 32767LL / (32767 - dz));
+    if (v < -dz) return (s32)((v + dz) * 32768LL / (32768 - dz));
+    return 0;
+}
+
+static void axis_dirs(RawState* r)
+{
+    for (int a = 0; a < NAXES; a++) {
+        if (r->axis[a] > 16384) raw_set(r, CID_AXIS + a * 2);
+        if (r->axis[a] < -16384) raw_set(r, CID_AXIS + a * 2 + 1);
+    }
+}
+
+/* Read one device now. 0 = gone. */
+static int dev_read(PadDev* d, RawState* r)
+{
+    memset(r, 0, sizeof *r);
+    if (d->lost) return 0;
+    if (d->kind == DEV_XINPUT) {
+        XINPUT_STATE xs;
+        if (XInputGetState(d->xi, &xs) != ERROR_SUCCESS) { InterlockedExchange(&d->lost, 1); return 0; }
+        const XINPUT_GAMEPAD* g = &xs.Gamepad;
+        r->bits[0] = g->wButtons;
+        if (g->bLeftTrigger > XINPUT_GAMEPAD_TRIGGER_THRESHOLD) raw_set(r, 16);
+        if (g->bRightTrigger > XINPUT_GAMEPAD_TRIGGER_THRESHOLD) raw_set(r, 17);
+        r->axis[0] = xi_stick(g->sThumbLX);
+        r->axis[1] = -xi_stick(g->sThumbLY);           /* PS3: up = negative */
+        r->axis[2] = xi_stick(g->sThumbRX);
+        r->axis[3] = -xi_stick(g->sThumbRY);
+        if (r->axis[1] > 32767) r->axis[1] = 32767;
+        if (r->axis[3] > 32767) r->axis[3] = 32767;
+        r->axis[4] = g->bLeftTrigger * 128;
+        r->axis[5] = g->bRightTrigger * 128;
+        r->lt = g->bLeftTrigger; r->rt = g->bRightTrigger;
+        axis_dirs(r);
+        return 1;
+    }
+    IDirectInputDevice8W* di = d->di;
+    DIJOYSTATE2 js;
+    HRESULT hr = di->lpVtbl->Poll(di);
+    if (FAILED(hr)) { di->lpVtbl->Acquire(di); di->lpVtbl->Poll(di); }
+    hr = di->lpVtbl->GetDeviceState(di, sizeof js, &js);
+    if (hr == DIERR_INPUTLOST || hr == DIERR_NOTACQUIRED) {
+        if (SUCCEEDED(di->lpVtbl->Acquire(di)))
+            hr = di->lpVtbl->GetDeviceState(di, sizeof js, &js);
+    }
+    if (FAILED(hr)) { InterlockedExchange(&d->lost, 1); return 0; }
+    for (int i = 0; i < 128; i++) if (js.rgbButtons[i] & 0x80) raw_set(r, (unsigned)i);
+    for (int h = 0; h < 4; h++) {
+        DWORD pov = js.rgdwPOV[h];
+        if (LOWORD(pov) == 0xFFFF) continue;          /* centred */
+        pov %= 36000;
+        if (pov >= 31500 || pov <= 4500)  raw_set(r, CID_HAT + h * 4 + 0);
+        if (pov >= 4500  && pov <= 13500) raw_set(r, CID_HAT + h * 4 + 1);
+        if (pov >= 13500 && pov <= 22500) raw_set(r, CID_HAT + h * 4 + 2);
+        if (pov >= 22500 && pov <= 31500) raw_set(r, CID_HAT + h * 4 + 3);
+    }
+    r->axis[0] = js.lX;  r->axis[1] = js.lY;  r->axis[2] = js.lZ;
+    r->axis[3] = js.lRx; r->axis[4] = js.lRy; r->axis[5] = js.lRz;
+    r->axis[6] = js.rglSlider[0]; r->axis[7] = js.rglSlider[1];
+    axis_dirs(r);
+    return 1;
+}
+
+static void dev_release(PadDev* d)
+{
+    if (d->kind == DEV_XINPUT && (d->rumble[0] || d->rumble[1])) {
+        XINPUT_VIBRATION v = {0, 0};
+        XInputSetState(d->xi, &v);
+    }
+    if (d->di) { d->di->lpVtbl->Unacquire(d->di); d->di->lpVtbl->Release(d->di); }
+    memset(d, 0, sizeof *d);
+}
+
+static const char* xi_subtype(BYTE s)
+{
+    switch (s) {
+    case XINPUT_DEVSUBTYPE_GAMEPAD: return "gamepad";
+    case XINPUT_DEVSUBTYPE_ARCADE_STICK: return "arcade stick";
+    case 0x13: return "arcade pad";
+    case XINPUT_DEVSUBTYPE_FLIGHT_STICK: return "flight stick";
+    case XINPUT_DEVSUBTYPE_WHEEL: return "wheel";
+    default: return "controller";
+    }
+}
+
+static PadDev* dev_alloc(void)
+{
+    for (int i = 0; i < MAX_DEVS; i++)
+        if (!g_dev[i].kind) { memset(&g_dev[i], 0, sizeof g_dev[i]); g_dev[i].port = -1; return &g_dev[i]; }
+    return NULL;
+}
+
+static void dev_describe(const PadDev* d, char* out, size_t cap)
+{
+    if (d->kind == DEV_XINPUT) snprintf(out, cap, "XInput #%lu (%s)", (unsigned long)d->xi, d->name);
+    else snprintf(out, cap, "DInput '%s' %04X:%04X", d->name, d->vid, d->pid);
+}
+
+/* --- DirectInput enumeration (hot-plug thread / init only) --- */
+
+typedef struct { DIDEVICEINSTANCEW inst[32]; int n; } EnumList;
+
+static BOOL CALLBACK di_enum_cb(LPCDIDEVICEINSTANCEW inst, LPVOID ctx)
+{
+    EnumList* l = (EnumList*)ctx;
+    if (l->n < 32) l->inst[l->n++] = *inst;
+    return DIENUM_CONTINUE;
+}
+
+static int di_is_xinput(IDirectInputDevice8W* di)
+{
+    DIPROPGUIDANDPATH gp;
+    memset(&gp, 0, sizeof gp);
+    gp.diph.dwSize = sizeof gp; gp.diph.dwHeaderSize = sizeof(DIPROPHEADER);
+    gp.diph.dwHow = DIPH_DEVICE;
+    if (FAILED(di->lpVtbl->GetProperty(di, DIPROP_GUIDANDPATH, &gp.diph))) return 0;
+    for (WCHAR* p = gp.wszPath; *p; p++)
+        if ((p[0] == L'I' || p[0] == L'i') && (p[1] == L'G' || p[1] == L'g') && p[2] == L'_') return 1;
+    return 0;
+}
+
+static BOOL CALLBACK di_axis_cb(LPCDIDEVICEOBJECTINSTANCEW obj, LPVOID ctx)
+{
+    IDirectInputDevice8W* di = (IDirectInputDevice8W*)ctx;
+    DIPROPRANGE rg;
+    rg.diph.dwSize = sizeof rg; rg.diph.dwHeaderSize = sizeof(DIPROPHEADER);
+    rg.diph.dwObj = obj->dwType; rg.diph.dwHow = DIPH_BYID;
+    rg.lMin = -32768; rg.lMax = 32767;
+    di->lpVtbl->SetProperty(di, DIPROP_RANGE, &rg.diph);
+    return DIENUM_CONTINUE;
+}
+
+static void di_scan(void)
+{
+    if (!g_di) return;
+    EnumList list; list.n = 0;
+    g_di->lpVtbl->EnumDevices(g_di, DI8DEVCLASS_GAMECTRL, di_enum_cb, &list, DIEDFL_ATTACHEDONLY);
+    /* Drop devices that are no longer attached. */
+    AcquireSRWLockExclusive(&g_dev_lock);
+    for (int i = 0; i < MAX_DEVS; i++) {
+        if (g_dev[i].kind != DEV_DINPUT) continue;
+        int present = 0;
+        for (int k = 0; k < list.n; k++) if (IsEqualGUID(&list.inst[k].guidInstance, &g_dev[i].inst)) present = 1;
+        if (!present) InterlockedExchange(&g_dev[i].lost, 1);
+    }
+    ReleaseSRWLockExclusive(&g_dev_lock);
+    for (int k = 0; k < list.n; k++) {
+        const DIDEVICEINSTANCEW* in = &list.inst[k];
+        int known = 0;
+        AcquireSRWLockShared(&g_dev_lock);
+        for (int i = 0; i < MAX_DEVS; i++)
+            if (g_dev[i].kind == DEV_DINPUT && !g_dev[i].lost && IsEqualGUID(&in->guidInstance, &g_dev[i].inst)) known = 1;
+        ReleaseSRWLockShared(&g_dev_lock);
+        if (known) continue;
+        IDirectInputDevice8W* di = NULL;
+        if (FAILED(g_di->lpVtbl->CreateDevice(g_di, &in->guidInstance, &di, NULL)) || !di) continue;
+        char name[80];
+        WideCharToMultiByte(CP_UTF8, 0, in->tszProductName, -1, name, sizeof name, NULL, NULL);
+        u16 vid = LOWORD(in->guidProduct.Data1), pid = HIWORD(in->guidProduct.Data1);
+        if (!g_cfg.dinput_all && di_is_xinput(di)) {
+            static int said;
+            if (said++ < 8) printf("[pad] DInput '%s' %04X:%04X is an XInput device -- read through XInput\n", name, vid, pid);
+            di->lpVtbl->Release(di);
+            continue;
+        }
+        if (FAILED(di->lpVtbl->SetDataFormat(di, &c_dfDIJoystick2))) { di->lpVtbl->Release(di); continue; }
+        /* No SetCooperativeLevel: the default is non-exclusive background,
+         * which is what we want (read whether or not we have the focus). */
+        DIPROPRANGE rg;
+        rg.diph.dwSize = sizeof rg; rg.diph.dwHeaderSize = sizeof(DIPROPHEADER);
+        rg.diph.dwObj = 0; rg.diph.dwHow = DIPH_DEVICE;
+        rg.lMin = -32768; rg.lMax = 32767;
+        if (FAILED(di->lpVtbl->SetProperty(di, DIPROP_RANGE, &rg.diph)))
+            di->lpVtbl->EnumObjects(di, di_axis_cb, di, DIDFT_AXIS);
+        DIPROPDWORD dz;
+        dz.diph.dwSize = sizeof dz; dz.diph.dwHeaderSize = sizeof(DIPROPHEADER);
+        dz.diph.dwObj = 0; dz.diph.dwHow = DIPH_DEVICE; dz.dwData = 0;
+        di->lpVtbl->SetProperty(di, DIPROP_DEADZONE, &dz.diph);
+        HRESULT ahr = di->lpVtbl->Acquire(di);
+        AcquireSRWLockExclusive(&g_dev_lock);
+        PadDev* d = dev_alloc();
+        if (!d) { ReleaseSRWLockExclusive(&g_dev_lock); di->lpVtbl->Release(di); continue; }
+        d->kind = DEV_DINPUT; d->di = di; d->inst = in->guidInstance;
+        d->vid = vid; d->pid = pid; d->order = ++g_dev_order;
+        snprintf(d->name, sizeof d->name, "%s", name);
+        ReleaseSRWLockExclusive(&g_dev_lock);
+        printf("[pad] found DInput '%s' %04X:%04X%s\n", name, vid, pid,
+               SUCCEEDED(ahr) ? "" : " (acquire failed, will retry)");
+    }
+}
+
+static void xi_scan(void)
+{
+    if (!g_cfg.xinput) return;
+    for (DWORD s = 0; s < XUSER_MAX_COUNT; s++) {
+        int have = 0;
+        AcquireSRWLockShared(&g_dev_lock);
+        for (int i = 0; i < MAX_DEVS; i++)
+            if (g_dev[i].kind == DEV_XINPUT && g_dev[i].xi == s && !g_dev[i].lost) have = 1;
+        ReleaseSRWLockShared(&g_dev_lock);
+        if (have) continue;
+        /* An empty slot costs ~25 us here; that is why this runs on the
+         * hot-plug thread and never on the read path. */
+        XINPUT_STATE xs;
+        if (XInputGetState(s, &xs) != ERROR_SUCCESS) continue;
+        XINPUT_CAPABILITIES caps;
+        memset(&caps, 0, sizeof caps);
+        XInputGetCapabilities(s, 0, &caps);
+        AcquireSRWLockExclusive(&g_dev_lock);
+        PadDev* d = dev_alloc();
+        if (d) {
+            d->kind = DEV_XINPUT; d->xi = s; d->order = ++g_dev_order;
+            snprintf(d->name, sizeof d->name, "%s", xi_subtype(caps.SubType));
+        }
+        ReleaseSRWLockExclusive(&g_dev_lock);
+        if (d) printf("[pad] found XInput #%lu (%s)\n", (unsigned long)s, xi_subtype(caps.SubType));
+    }
+}
+
+static int spec_matches(const PortCfg* pc, const PadDev* d)
+{
+    if (pc->spec == SPEC_XINPUT) return d->kind == DEV_XINPUT && (pc->xi_slot < 0 || (DWORD)pc->xi_slot == d->xi);
+    if (pc->spec == SPEC_DINPUT) {
+        if (d->kind != DEV_DINPUT) return 0;
+        if (pc->vid) return d->vid == pc->vid && d->pid == pc->pid;
+        if (pc->match[0]) {
+            char a[80], b[48];
+            size_t i;
+            for (i = 0; d->name[i] && i < sizeof a - 1; i++) a[i] = (char)tolower((unsigned char)d->name[i]);
+            a[i] = 0;
+            for (i = 0; pc->match[i] && i < sizeof b - 1; i++) b[i] = (char)tolower((unsigned char)pc->match[i]);
+            b[i] = 0;
+            return strstr(a, b) != NULL;
+        }
+        return 1;
+    }
+    return 0;
+}
+
+/* Drop lost devices, give unassigned ones a port. Called with the lock held
+ * exclusively. Pinned ports ([portN] device = ...) first, then the lowest
+ * free "auto" port, in order of arrival. */
+static void assign_ports(void)
+{
+    for (int i = 0; i < MAX_DEVS; i++) {
+        PadDev* d = &g_dev[i];
+        if (!d->kind || !d->lost) continue;
+        char desc[128]; dev_describe(d, desc, sizeof desc);
+        if (d->port >= 0) printf("[pad] port %d: %s disconnected\n", d->port + 1, desc);
+        else printf("[pad] %s disconnected\n", desc);
+        dev_release(d);
+    }
+    if (!g_cfg.devices) return;
+    for (;;) {
+        PadDev* next = NULL;
+        for (int i = 0; i < MAX_DEVS; i++)
+            if (g_dev[i].kind && g_dev[i].port < 0 && !g_dev[i].lost && (!next || g_dev[i].order < next->order))
+                next = &g_dev[i];
+        if (!next) break;
+        int port = -1;
+        for (int p = 0; p < PADH_MAX_PORTS && port < 0; p++) {
+            const PortCfg* pc = &g_cfg.port[p];
+            if (!spec_matches(pc, next)) continue;
+            int taken = 0;
+            for (int i = 0; i < MAX_DEVS; i++) if (g_dev[i].kind && g_dev[i].port == p) taken = 1;
+            if (!taken) port = p;
+        }
+        for (int p = 0; p < PADH_MAX_PORTS && port < 0; p++) {
+            if (g_cfg.port[p].spec != SPEC_AUTO) continue;
+            int taken = 0;
+            for (int i = 0; i < MAX_DEVS; i++) if (g_dev[i].kind && g_dev[i].port == p) taken = 1;
+            if (!taken) port = p;
+        }
+        if (port < 0) { next->port = -2; continue; }   /* no room: parked */
+        next->port = port;
+        build_table(&next->bind, next->kind == DEV_XINPUT ? CLS_XINPUT : CLS_DINPUT, port, next->vid, next->pid, NULL);
+        char desc[128]; dev_describe(next, desc, sizeof desc);
+        printf("[pad] port %d (player %d): %s, layout %s%s\n", port + 1, port + 1, desc, next->bind.desc,
+               g_cfg.port[port].stick_dpad ? ", stick -> d-pad" : "");
+    }
+    for (int i = 0; i < MAX_DEVS; i++) if (g_dev[i].kind && g_dev[i].port == -2) g_dev[i].port = -1;
+    fflush(stdout);
+}
+
+static UINT raw_device_count(void)
+{
+    UINT n = 0;
+    GetRawInputDeviceList(NULL, &n, sizeof(RAWINPUTDEVICELIST));
+    return n;
+}
+
+static DWORD WINAPI hotplug_main(LPVOID arg)
+{
+    (void)arg;
+    UINT last_raw = raw_device_count();
+    for (;;) {
+        if (WaitForSingleObject(g_hotplug_stop, 500) == WAIT_OBJECT_0) break;
+        xi_scan();
+        /* DInput enumeration is slow (milliseconds); only when the system's
+         * input device list changed, or when a device was lost. */
+        UINT raw = raw_device_count();
+        int lost = 0;
+        for (int i = 0; i < MAX_DEVS; i++) if (g_dev[i].kind == DEV_DINPUT && g_dev[i].lost) lost = 1;
+        if (g_cfg.dinput && (raw != last_raw || lost)) { last_raw = raw; di_scan(); }
+        AcquireSRWLockExclusive(&g_dev_lock);
+        assign_ports();
+        ReleaseSRWLockExclusive(&g_dev_lock);
+    }
+    return 0;
+}
+
+/* ---------------------------------------------------------------------------
+ * Init
+ * -----------------------------------------------------------------------*/
+
+static INIT_ONCE g_init_once = INIT_ONCE_STATIC_INIT;
+
+static BOOL CALLBACK init_cb(PINIT_ONCE once, PVOID param, PVOID* ctx)
+{
+    (void)once; (void)param; (void)ctx;
+    LARGE_INTEGER f; QueryPerformanceFrequency(&f); g_qpf = f.QuadPart ? f.QuadPart : 1;
+    for (int p = 0; p < PADH_MAX_PORTS; p++) InitializeSRWLock(&g_port[p].lock);
+    load_config();
+    printf("[pad] controls: %s\n", g_cfg_path[0] ? g_cfg_path : "built-in defaults (no controls.ini; PS3_CONTROLS=<file> to choose one)");
+    if (g_cfg.dinput && g_cfg.devices) {
+        HRESULT hr = DirectInput8Create(GetModuleHandleW(NULL), DIRECTINPUT_VERSION, &IID_IDirectInput8W, (void**)&g_di, NULL);
+        if (FAILED(hr)) { printf("[pad] DirectInput8Create failed 0x%08lX: HID sticks unavailable\n", (unsigned long)hr); g_di = NULL; }
+    }
+    if (g_cfg.devices) { xi_scan(); di_scan(); }
+    else printf("[pad] scripted input (PS3_PAD_FILE*): physical pads ignored (PS3_PAD_DEVICES=1 to use them)\n");
+    AcquireSRWLockExclusive(&g_dev_lock);
+    assign_ports();
+    ReleaseSRWLockExclusive(&g_dev_lock);
+    if (g_cfg.kb_port >= 0) printf("[pad] keyboard -> port %d, layout %s (only while the game window has focus)\n", g_cfg.kb_port + 1, g_cfg.keys[0].desc);
+    if (g_cfg.kb2_port >= 0) printf("[pad] keyboard player 2 -> port %d, layout %s\n", g_cfg.kb2_port + 1, g_cfg.keys[1].desc);
+    for (int p = 0; p < 2; p++) if (g_cfg.file[p][0]) printf("[pad] port %d: scripted from %s\n", p + 1, g_cfg.file[p]);
+    fflush(stdout);
+    if (g_cfg.devices) {
+        g_hotplug_stop = CreateEventW(NULL, TRUE, FALSE, NULL);
+        g_hotplug_thread = CreateThread(NULL, 0, hotplug_main, NULL, 0, NULL);
+        if (g_hotplug_thread) SetThreadPriority(g_hotplug_thread, THREAD_PRIORITY_BELOW_NORMAL);
+    }
+    return TRUE;
+}
+
+void padh_init(void) { InitOnceExecuteOnce(&g_init_once, init_cb, NULL, NULL); }
+
+void padh_shutdown(void)
+{
+    for (u32 p = 0; p < PADH_MAX_PORTS; p++) padh_rumble(p, 0, 0);
+}
+
+u32 padh_min_interval_us(void) { padh_init(); return g_cfg.min_interval_us; }
+int padh_log_reads(void) { padh_init(); return g_cfg.log; }
+
+int padh_port_connected(u32 port)
+{
+    padh_init();
+    if (port >= PADH_MAX_PORTS) return 0;
+    if (port == 0 || (int)port < g_cfg.min_ports) return 1;
+    if ((int)port == g_cfg.kb_port || (int)port == g_cfg.kb2_port) return 1;
+    if (port < 2 && g_cfg.file[port][0]) return 1;
+    int on = 0;
+    AcquireSRWLockShared(&g_dev_lock);
+    for (int i = 0; i < MAX_DEVS; i++) if (g_dev[i].kind && g_dev[i].port == (int)port && !g_dev[i].lost) on = 1;
+    ReleaseSRWLockShared(&g_dev_lock);
+    return on;
+}
+
+/* ---------------------------------------------------------------------------
+ * Sampling
+ * -----------------------------------------------------------------------*/
+
+typedef struct {
+    u16 btn;
+    s32 ax[4];          /* LX LY RX RY, -32768..32767 */
+    u8  l2, r2;
+    int kb_dirs;        /* directions came from the keyboard */
+} Merge;
+
+static void merge_axis(Merge* m, int t, s32 v)
+{
+    if (v < -32768) v = -32768;
+    if (v > 32767) v = 32767;
+    if (abs(v) > abs(m->ax[t])) m->ax[t] = v;
+}
+
+static void apply_table(Merge* m, const BindTable* t, const RawState* r, int cls)
+{
+    for (int i = 0; i < t->n; i++) {
+        if (!raw_get(r, t->b[i].src)) continue;
+        m->btn |= t->b[i].mask;
+        if (cls == CLS_XINPUT && (t->b[i].src == 16 || t->b[i].src == 17)) {
+            u8 v = t->b[i].src == 16 ? r->lt : r->rt;
+            if ((t->b[i].mask & CELL_PAD_CTRL_L2) && v > m->l2) m->l2 = v;
+            if ((t->b[i].mask & CELL_PAD_CTRL_R2) && v > m->r2) m->r2 = v;
+        }
+    }
+    for (int a = 0; a < 4; a++) {
+        if (t->axis[a] < 0) continue;
+        s32 v = r->axis[t->axis[a]];
+        if (t->inv[a]) v = -v - 1;
+        merge_axis(m, a, v);
+    }
+}
+
+static void log_presses(PadDev* d, const RawState* r)
+{
+    int cls = d->kind == DEV_XINPUT ? CLS_XINPUT : CLS_DINPUT;
+    for (unsigned id = 0; id < CID_COUNT; id++) {
+        int now = raw_get(r, id), was = (d->last_bits[id >> 5] >> (id & 31)) & 1;
+        if (!now || was) continue;
+        u16 mask = 0;
+        for (int i = 0; i < d->bind.n; i++) if (d->bind.b[i].src == id) mask |= d->bind.b[i].mask;
+        char sn[24], tn[96]; source_name(cls, (int)id, sn, sizeof sn); mask_names(mask, tn, sizeof tn);
+        printf("[pad] port %d %s: %s pressed -> %s\n", d->port + 1, d->name, sn, mask ? tn : "(unbound)");
+    }
+    memcpy(d->last_bits, r->bits, sizeof d->last_bits);
+}
+
+static void apply_keys(Merge* m, const BindTable* t)
+{
+    for (int i = 0; i < t->n; i++)
+        if (GetAsyncKeyState(t->b[i].src) & 0x8000) {
+            m->btn |= t->b[i].mask;
+            if (t->b[i].mask & 0x00F0) m->kb_dirs = 1;
+        }
+}
+
+/* PS3_PAD_FILE / PS3_PAD_FILE2: whitespace-separated held buttons (any
+ * target name, Tekken names and combos included), LX=n LY=n RX=n RY=n
+ * (0-255), and optionally T=<ns> -- a time.perf_counter_ns() stamp of when
+ * the script wrote the file, for the latency log. */
+static void apply_file(Merge* m, PortState* ps, u32 port, LONGLONG now)
+{
+    const char* path = g_cfg.file[port];
+    char buf[512]; size_t n = 0;
+    u16 fb = 0;
+    FILE* f = fopen(path, "rb");
+    if (f) { n = fread(buf, 1, sizeof buf - 1, f); fclose(f); }
+    buf[n] = 0;
+    char* save = NULL;
+    for (char* tok = strtok_s(buf, " \t\r\n,", &save); tok; tok = strtok_s(NULL, " \t\r\n,", &save)) {
+        if (tok[0] && tok[1] == 'X' && tok[2] == '=' && (tok[0] == 'L' || tok[0] == 'R')) {
+            s32 v = (atoi(tok + 3) - 128) * 256; merge_axis(m, tok[0] == 'L' ? TGT_LX : TGT_RX, v); continue;
+        }
+        if (tok[0] && tok[1] == 'Y' && tok[2] == '=' && (tok[0] == 'L' || tok[0] == 'R')) {
+            s32 v = (atoi(tok + 3) - 128) * 256; merge_axis(m, tok[0] == 'L' ? TGT_LY : TGT_RY, v); continue;
+        }
+        if (tok[0] == 'T' && tok[1] == '=') {
+            u64 t = _strtoui64(tok + 2, NULL, 10);
+            if (t && t != ps->file_t[0]) { ps->file_t[0] = t; ps->file_t_seen = now; ps->file_t_pending = 1; }
+            continue;
+        }
+        fb |= parse_target_mask(tok);
+    }
+    m->btn |= fb;
+    if (fb != ps->file_btns) {               /* same line as the old cellPad, tools grep it */
+        ps->file_btns = fb;
+        printf("[cellPad] file pad%s: buttons 0x%04X\n", port ? " 2" : "", fb);
+        fflush(stdout);
+    }
+}
+
+static u16 socd_clean(PortState* ps, u16 b, int mode)
+{
+    if (mode == SOCD_OFF) return b;
+    const u16 L = CELL_PAD_CTRL_LEFT, R = CELL_PAD_CTRL_RIGHT, U = CELL_PAD_CTRL_UP, D = CELL_PAD_CTRL_DOWN;
+    u16 raw = b & (L | R | U | D), out = b & (u16)~(L | R | U | D);
+    u16 prev = ps->socd_prev;
+    ps->socd_prev = raw;
+    /* horizontal */
+    if ((raw & L) && (raw & R)) {
+        if (mode == SOCD_LAST) {
+            if ((prev & L) && !(prev & R)) ps->socd_h = R;
+            else if ((prev & R) && !(prev & L)) ps->socd_h = L;
+            else if (!(prev & (L | R))) ps->socd_h = 0;
+            out |= ps->socd_h;
+        }
+    } else out |= raw & (L | R);
+    /* vertical */
+    if ((raw & U) && (raw & D)) {
+        if (mode == SOCD_UP) out |= U;
+        else if (mode == SOCD_LAST) {
+            if ((prev & U) && !(prev & D)) ps->socd_v = D;
+            else if ((prev & D) && !(prev & U)) ps->socd_v = U;
+            else if (!(prev & (U | D))) ps->socd_v = 0;
+            out |= ps->socd_v;
+        }
+    } else out |= raw & (U | D);
+    return out;
+}
+
+/* Analog stick -> 8-way d-pad, 45-degree sectors past half deflection. */
+static u16 stick_to_dirs(s32 x, s32 y)
+{
+    double fx = x, fy = y;
+    if (fx * fx + fy * fy < 16384.0 * 16384.0) return 0;
+    double a = atan2(-fy, fx) * 180.0 / 3.14159265358979;   /* 0 = right, 90 = up */
+    if (a < 0) a += 360.0;
+    int s = (int)((a + 22.5) / 45.0) % 8;
+    static const u16 dirs[8] = {
+        CELL_PAD_CTRL_RIGHT, CELL_PAD_CTRL_RIGHT | CELL_PAD_CTRL_UP, CELL_PAD_CTRL_UP,
+        CELL_PAD_CTRL_UP | CELL_PAD_CTRL_LEFT, CELL_PAD_CTRL_LEFT, CELL_PAD_CTRL_LEFT | CELL_PAD_CTRL_DOWN,
+        CELL_PAD_CTRL_DOWN, CELL_PAD_CTRL_DOWN | CELL_PAD_CTRL_RIGHT };
+    return dirs[s];
+}
+
+static u8 axis_u8(s32 v) { int u = (v + 32768) >> 8; return (u8)(u < 0 ? 0 : u > 255 ? 255 : u); }
+
+int padh_sample(u32 port, PadHostPort* out, u32 min_interval_us)
+{
+    padh_init();
+    memset(out, 0, sizeof *out);
+    out->lx = out->ly = out->rx = out->ry = 128;
+    if (port >= PADH_MAX_PORTS) return 0;
+    PortState* ps = &g_port[port];
+    AcquireSRWLockExclusive(&ps->lock);
+    LONGLONG t0 = qpc_now();
+    if (min_interval_us && ps->have && t0 - ps->t_end < qpc_from_us(min_interval_us)) {
+        *out = ps->last;
+        ReleaseSRWLockExclusive(&ps->lock);
+        return 0;
+    }
+    Merge m; memset(&m, 0, sizeof m);
+    int focus = -1, connected = 0;
+    if (g_cfg.devices) {
+        AcquireSRWLockShared(&g_dev_lock);
+        for (int i = 0; i < MAX_DEVS; i++) {
+            PadDev* d = &g_dev[i];
+            if (!d->kind || d->port != (int)port || d->lost) continue;
+            connected = 1;
+            if (!g_cfg.background) { if (focus < 0) focus = window_focused(); if (!focus) continue; }
+            RawState r;
+            if (!dev_read(d, &r)) continue;
+            apply_table(&m, &d->bind, &r, d->kind == DEV_XINPUT ? CLS_XINPUT : CLS_DINPUT);
+            if (g_cfg.log >= 2) log_presses(d, &r);
+        }
+        ReleaseSRWLockShared(&g_dev_lock);
+    }
+    if (g_cfg.port[port].stick_dpad) {
+        m.btn |= stick_to_dirs(m.ax[TGT_LX], m.ax[TGT_LY]);
+        m.ax[TGT_LX] = m.ax[TGT_LY] = 0;
+    }
+    if ((int)port == g_cfg.kb_port || (int)port == g_cfg.kb2_port) {
+        if (focus < 0) focus = window_focused();
+        if (focus) {
+            if ((int)port == g_cfg.kb_port) apply_keys(&m, &g_cfg.keys[0]);
+            if ((int)port == g_cfg.kb2_port) apply_keys(&m, &g_cfg.keys[1]);
+        }
+    }
+    if (port < 2 && g_cfg.file[port][0]) apply_file(&m, ps, port, t0);
+    m.btn = socd_clean(ps, m.btn, g_cfg.port[port].socd);
+    /* Keyboard (or, with mirror_stick = all, any) directions also drive the
+     * left stick when it is otherwise centred, for titles that only read it. */
+    if ((g_cfg.mirror == MIRROR_ALL || (g_cfg.mirror == MIRROR_KEYBOARD && m.kb_dirs)) &&
+        !m.ax[TGT_LX] && !m.ax[TGT_LY]) {
+        if (m.btn & CELL_PAD_CTRL_LEFT)  m.ax[TGT_LX] = -32768;
+        if (m.btn & CELL_PAD_CTRL_RIGHT) m.ax[TGT_LX] = 32767;
+        if (m.btn & CELL_PAD_CTRL_UP)    m.ax[TGT_LY] = -32768;
+        if (m.btn & CELL_PAD_CTRL_DOWN)  m.ax[TGT_LY] = 32767;
+    }
+    out->buttons = m.btn;
+    out->lx = axis_u8(m.ax[TGT_LX]); out->ly = axis_u8(m.ax[TGT_LY]);
+    out->rx = axis_u8(m.ax[TGT_RX]); out->ry = axis_u8(m.ax[TGT_RY]);
+    out->l2 = (m.btn & CELL_PAD_CTRL_L2) ? (m.l2 ? m.l2 : 255) : 0;
+    out->r2 = (m.btn & CELL_PAD_CTRL_R2) ? (m.r2 ? m.r2 : 255) : 0;
+    (void)connected;
+    out->connected = padh_port_connected(port);
+    out->seq = ps->last.seq + 1;
+    ps->last = *out;
+    ps->have = 1;
+    ps->t_begin = t0;
+    ps->t_end = qpc_now();
+    ps->n_samples++;
+    { double c = qpc_to_us(ps->t_end - t0); ps->cost_sum += c; if (c > ps->cost_max) ps->cost_max = c; }
+    ReleaseSRWLockExclusive(&ps->lock);
+    return 1;
+}
+
+/* ---------------------------------------------------------------------------
+ * Statistics: what the title got, and how old it was
+ * -----------------------------------------------------------------------*/
+
+void padh_note_read(u32 port, const PadHostPort* st, int fresh)
+{
+    (void)st;
+    if (port >= PADH_MAX_PORTS || !g_cfg.latency) return;
+    PortState* ps = &g_port[port];
+    LONGLONG now = qpc_now();
+    AcquireSRWLockExclusive(&ps->lock);
+    ps->n_reads++;
+    if (fresh) ps->n_fresh++;
+    double age = qpc_to_us(now - ps->t_end);
+    ps->age_sum += age; if (age > ps->age_max) ps->age_max = age;
+    if (ps->last_read) { ps->ival_sum += qpc_to_us(now - ps->last_read); ps->ival_n++; }
+    ps->last_read = now;
+    if (ps->file_t_pending) {
+        /* Scripted event: written by the test script at T, first sampled at
+         * file_t_seen, handed to the title now. */
+        ps->file_t_pending = 0;
+        u64 t_ns = ps->file_t[0], seen_ns = qpc_to_ns(ps->file_t_seen), now_ns = qpc_to_ns(now);
+        printf("[pad-lat] port %u event T=%llu: written -> sampling began %.3f ms (sample took %.3f ms)"
+               " -> read by title %.3f ms\n",
+               port + 1, (unsigned long long)t_ns,
+               seen_ns > t_ns ? (double)(seen_ns - t_ns) / 1e6 : 0.0,
+               qpc_to_us(ps->t_end - ps->t_begin) / 1000.0,
+               now_ns > t_ns ? (double)(now_ns - t_ns) / 1e6 : 0.0);
+    }
+    if (!ps->stat_t0) ps->stat_t0 = now;
+    if (qpc_to_us(now - ps->stat_t0) >= 5e6) {
+        printf("[pad-lat] port %u: %llu reads (%llu fresh) every %.2f ms | sample cost avg %.1f us max %.1f us"
+               " | sample age at read avg %.1f us max %.1f us\n",
+               port + 1, (unsigned long long)ps->n_reads, (unsigned long long)ps->n_fresh,
+               ps->ival_n ? ps->ival_sum / (double)ps->ival_n / 1000.0 : 0.0,
+               ps->n_samples ? ps->cost_sum / (double)ps->n_samples : 0.0, ps->cost_max,
+               ps->n_reads ? ps->age_sum / (double)ps->n_reads : 0.0, ps->age_max);
+        ps->n_reads = ps->n_fresh = ps->n_samples = 0;
+        ps->cost_sum = ps->cost_max = ps->age_sum = ps->age_max = ps->ival_sum = 0;
+        ps->ival_n = 0;
+        ps->stat_t0 = now;
+    }
+    ReleaseSRWLockExclusive(&ps->lock);
+    fflush(stdout);
+}
+
+void padh_rumble(u32 port, u8 small_motor, u8 large_motor)
+{
+    if (port >= PADH_MAX_PORTS) return;
+    padh_init();
+    AcquireSRWLockShared(&g_dev_lock);
+    for (int i = 0; i < MAX_DEVS; i++) {
+        PadDev* d = &g_dev[i];
+        if (d->kind != DEV_XINPUT || d->port != (int)port || d->lost) continue;
+        if (d->rumble[0] == small_motor && d->rumble[1] == large_motor) continue;   /* no driver call per frame */
+        d->rumble[0] = small_motor; d->rumble[1] = large_motor;
+        /* DUALSHOCK 3: the small motor is on/off (0/1), the large one 0..255. */
+        XINPUT_VIBRATION v;
+        v.wLeftMotorSpeed = (WORD)(large_motor * 257);
+        v.wRightMotorSpeed = small_motor ? 0xFFFF : 0;
+        XInputSetState(d->xi, &v);
+    }
+    ReleaseSRWLockShared(&g_dev_lock);
+}

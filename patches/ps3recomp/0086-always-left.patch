diff --git a/libs/video/rsx_always_left.h b/libs/video/rsx_always_left.h
new file mode 100644
index 0000000..fe31f2c
--- /dev/null
+++ b/libs/video/rsx_always_left.h
@@ -0,0 +1,359 @@
+/*
+ * ps3recomp patch 0086 (T5DR Online 1.1.8 test, "Always left"): the pure part of showing the fight to the P2
+ * player as if they were P1 -- the 3D picture mirrored, the HUD's halves swapped but every element readable.
+ * Presentation only: nothing here reads or writes guest memory or changes what the game simulates; the live
+ * renderer (rsx_live_draw.c) calls it with the draw's own vertex program, constants and vertices, and moves or
+ * mirrors that draw on the host.
+ *
+ *   al_vp_eval    runs a vertex program (NV40 microcode, the layout rsx_vp_decompiler.c documents) on the CPU
+ *                 for one vertex, with the decompiler's semantics (the legacy 0 * x = 0 multiply, the vector
+ *                 unit's store before the scalar unit reads): the HUD quad's position (o0) and texture
+ *                 coordinate (o7). Straight-line programs only: flow control, an indexed constant or a
+ *                 conditional write -> 0 (the caller leaves that draw alone).
+ *   al_hud_*      the HUD of one frame: each quad drawn after the 3D picture is recorded; at the frame's end
+ *                 the quads are grouped into elements (the glyphs of one string: same texture, same line, next
+ *                 to each other; the timer's digits, one texture each) and flipped pairs (one texture drawn
+ *                 at mirrored places with the art flipped on one side: the bars, the round marks). Layout
+ *                 history is used only to keep connected centre overlays together. Side HUD draws move by
+ *                 exactly half the target width: every glyph and every fill on that side gets the same
+ *                 translation, including the first frame. Reflecting each glyph's box reverses letter order;
+ *                 using last frame's string box changes the displacement as letters enter or leave it.
+ *                 HUD art and fill direction are retained. This deliberately does not claim exact mirrored
+ *                 anchoring, or split a draw containing independent elements on both sides (see T5DR's
+ *                 docs/ALWAYS_LEFT_FIX.md). A centre-spanning quad stays, with connected overlays from the
+ *                 preceding frame. The full batch/centre-overlay solution still needs renderer work.
+ *
+ * T5DR's tests/c/always_left_render_test.c includes this header and checks it with programs and HUDs made for
+ * the test.
+ */
+#ifndef PS3RECOMP_RSX_ALWAYS_LEFT_H
+#define PS3RECOMP_RSX_ALWAYS_LEFT_H
+
+#include <math.h>
+#include <stdint.h>
+#include <string.h>
+
+/* ---- the vertex program on the CPU ------------------------------------------------------------------- */
+
+static uint32_t al_rd_le(const uint8_t* p)
+{
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static float al_mul1(float a, float b) { return (a == 0.0f || b == 0.0f) ? 0.0f : a * b; }
+static float al_u2f(uint32_t u) { float f; memcpy(&f, &u, 4); return f; }
+
+/* one 17-bit source field, read (swizzle, abs, negate) */
+static void al_src(uint32_t src, int is_abs, uint32_t input_src, uint32_t const_src,
+                   const float r[32][4], const float in[16][4], const uint32_t (*c)[4], float out[4])
+{
+    const uint32_t type = src & 3u, tmp = (src >> 2) & 0x3Fu;
+    float base[4];
+    if (type == 2) memcpy(base, in[input_src & 15u], sizeof base);
+    else if (type == 3) for (int k = 0; k < 4; k++) base[k] = al_u2f(c[const_src & 511u][k]);
+    else memcpy(base, r[tmp & 31u], sizeof base);
+    const uint32_t sw[4] = { (src >> 14) & 3u, (src >> 12) & 3u, (src >> 10) & 3u, (src >> 8) & 3u };
+    const int neg = (int)((src >> 16) & 1u);
+    for (int k = 0; k < 4; k++) {
+        float v = base[sw[k]];
+        if (is_abs) v = fabsf(v);
+        out[k] = neg ? -v : v;
+    }
+}
+
+static float al_sat(float v) { return v < 0.0f ? 0.0f : v > 1.0f ? 1.0f : v; }
+
+/* Runs the program at `uc` for one vertex: in[16] = its attributes (float4 each, as the shader gets them),
+ * c = the 512 vec4 constants (bit patterns). out[16][4] = the output registers (o0 = position, o7 = TEX0).
+ * -> 1, or 0 for a program this does not model (the draw is left as it is). */
+static int al_vp_eval(const uint8_t* uc, uint32_t max_bytes, const float in[16][4], const uint32_t (*c)[4],
+                      float out[16][4])
+{
+    float r[32][4];
+    memset(r, 0, sizeof r);
+    for (int i = 0; i < 16; i++) { out[i][0] = out[i][1] = out[i][2] = 0.0f; out[i][3] = 1.0f; }
+    for (uint32_t off = 0, n = 0; off + 16 <= max_bytes && n < 512; off += 16, n++) {
+        const uint32_t d0 = al_rd_le(uc + off), d1 = al_rd_le(uc + off + 4);
+        const uint32_t d2 = al_rd_le(uc + off + 8), d3 = al_rd_le(uc + off + 12);
+        const uint32_t vec_op = (d1 >> 22) & 0x1Fu, sca_op = (d1 >> 27) & 0x1Fu;
+        const uint32_t input_src = (d1 >> 8) & 0xFu, const_src = (d1 >> 12) & 0x3FFu;
+        if ((d3 >> 1) & 1u) return 0;                                   /* indexed constant (ARL) */
+        if (((d0 >> 13) & 1u) && ((d0 >> 10) & 7u) != 7u) return 0;    /* conditional write */
+        if (sca_op == 0x08 || sca_op == 0x09 || sca_op == 0x0A || sca_op == 0x0B || sca_op == 0x0C ||
+            sca_op == 0x11 || sca_op == 0x12 || sca_op > 0x12)
+            return 0;                                                   /* flow control / unknown */
+        const uint32_t src0 = ((d2 >> 23) & 0x1FFu) | ((d1 & 0xFFu) << 9);
+        const uint32_t src1 = (d2 >> 6) & 0x1FFFFu;
+        const uint32_t src2 = ((d3 >> 21) & 0x7FFu) | ((d2 & 0x3Fu) << 11);
+        const int saturate = (int)((d0 >> 26) & 1u), vec_result = (int)((d0 >> 30) & 1u);
+        const uint32_t dst_tmp = (d0 >> 15) & 0x3Fu, dst_out = (d3 >> 2) & 0x1Fu, sca_tmp = (d3 >> 7) & 0x3Fu;
+        const int vm[4] = { (int)((d3 >> 16) & 1u), (int)((d3 >> 15) & 1u), (int)((d3 >> 14) & 1u),
+                            (int)((d3 >> 13) & 1u) };
+        const int sm[4] = { (int)((d3 >> 20) & 1u), (int)((d3 >> 19) & 1u), (int)((d3 >> 18) & 1u),
+                            (int)((d3 >> 17) & 1u) };
+        float A[4], B[4], C[4], v[4];
+        al_src(src0, (int)((d0 >> 21) & 1u), input_src, const_src, r, in, c, A);
+        al_src(src1, (int)((d0 >> 22) & 1u), input_src, const_src, r, in, c, B);
+        al_src(src2, (int)((d0 >> 23) & 1u), input_src, const_src, r, in, c, C);
+        if ((vm[0] | vm[1] | vm[2] | vm[3]) && vec_op) {
+            float d;
+            switch (vec_op) {
+            case 0x01: memcpy(v, A, sizeof v); break;                                          /* MOV */
+            case 0x02: for (int k = 0; k < 4; k++) v[k] = al_mul1(A[k], B[k]); break;           /* MUL */
+            case 0x03: for (int k = 0; k < 4; k++) v[k] = A[k] + C[k]; break;                   /* ADD */
+            case 0x04: for (int k = 0; k < 4; k++) v[k] = al_mul1(A[k], B[k]) + C[k]; break;    /* MAD */
+            case 0x05: d = al_mul1(A[0], B[0]) + al_mul1(A[1], B[1]) + al_mul1(A[2], B[2]);     /* DP3 */
+                       v[0] = v[1] = v[2] = v[3] = d; break;
+            case 0x06: d = al_mul1(A[0], B[0]) + al_mul1(A[1], B[1]) + al_mul1(A[2], B[2]) + B[3]; /* DPH */
+                       v[0] = v[1] = v[2] = v[3] = d; break;
+            case 0x07: d = al_mul1(A[0], B[0]) + al_mul1(A[1], B[1]) + al_mul1(A[2], B[2]) +      /* DP4 */
+                           al_mul1(A[3], B[3]);
+                       v[0] = v[1] = v[2] = v[3] = d; break;
+            case 0x08: v[0] = 1.0f; v[1] = A[1] * B[1]; v[2] = A[2]; v[3] = B[3]; break;         /* DST */
+            case 0x09: for (int k = 0; k < 4; k++) v[k] = A[k] < B[k] ? A[k] : B[k]; break;     /* MIN */
+            case 0x0A: for (int k = 0; k < 4; k++) v[k] = A[k] > B[k] ? A[k] : B[k]; break;     /* MAX */
+            case 0x0B: for (int k = 0; k < 4; k++) v[k] = A[k] < B[k] ? 1.0f : 0.0f; break;     /* SLT */
+            case 0x0C: for (int k = 0; k < 4; k++) v[k] = A[k] >= B[k] ? 1.0f : 0.0f; break;    /* SGE */
+            case 0x0E: for (int k = 0; k < 4; k++) v[k] = A[k] - floorf(A[k]); break;           /* FRC */
+            case 0x0F: for (int k = 0; k < 4; k++) v[k] = floorf(A[k]); break;                  /* FLR */
+            case 0x10: for (int k = 0; k < 4; k++) v[k] = A[k] == B[k] ? 1.0f : 0.0f; break;    /* SEQ */
+            case 0x11: v[0] = v[1] = v[2] = v[3] = 0.0f; break;                                 /* SFL */
+            case 0x12: for (int k = 0; k < 4; k++) v[k] = A[k] > B[k] ? 1.0f : 0.0f; break;     /* SGT */
+            case 0x13: for (int k = 0; k < 4; k++) v[k] = A[k] <= B[k] ? 1.0f : 0.0f; break;    /* SLE */
+            case 0x14: for (int k = 0; k < 4; k++) v[k] = A[k] != B[k] ? 1.0f : 0.0f; break;    /* SNE */
+            case 0x15: v[0] = v[1] = v[2] = v[3] = 1.0f; break;                                 /* STR */
+            case 0x16: for (int k = 0; k < 4; k++) v[k] = A[k] > 0 ? 1.0f : A[k] < 0 ? -1.0f : 0.0f; break;
+            default: return 0;                                                                  /* ARL, TXL */
+            }
+            if (saturate) for (int k = 0; k < 4; k++) v[k] = al_sat(v[k]);
+            for (int k = 0; k < 4; k++) {
+                if (!vm[k]) continue;
+                if (vec_result && dst_out != 0x1Fu) out[dst_out & 15u][k] = v[k];
+                if (dst_tmp != 0x3Fu) r[dst_tmp & 31u][k] = v[k];
+            }
+            /* the HLSL reads the scalar unit's source after this store (the decompiler's order) */
+            al_src(src2, (int)((d0 >> 23) & 1u), input_src, const_src, r, in, c, C);
+        }
+        if ((sm[0] | sm[1] | sm[2] | sm[3]) && sca_op) {
+            const float x = C[0];
+            float s;
+            switch (sca_op) {
+            case 0x01: memcpy(v, C, sizeof v); s = 0; break;                                    /* MOV */
+            case 0x02: s = 1.0f / x; break;                                                     /* RCP */
+            case 0x03: s = 1.0f / x; if (s < 5.42101e-20f) s = 5.42101e-20f;                    /* RCC */
+                       if (s > 1.884467e19f) s = 1.884467e19f; break;
+            case 0x04: s = 1.0f / sqrtf(fmaxf(fabsf(x), 1e-10f)); break;                        /* RSQ */
+            case 0x05: case 0x0E: s = exp2f(x); break;                                          /* EXP EX2 */
+            case 0x06: case 0x0D: s = log2f(fmaxf(fabsf(x), 1e-10f)); break;                    /* LOG LG2 */
+            case 0x0F: s = sinf(x); break;
+            case 0x10: s = cosf(x); break;
+            case 0x07: s = 0;                                                                   /* LIT */
+                       v[0] = 1.0f; v[1] = fmaxf(C[0], 0.0f);
+                       v[2] = C[0] > 0.0f ? exp2f(fminf(fmaxf(C[3], -127.996f), 127.996f) *
+                                                  log2f(fmaxf(C[1], 1e-10f))) : 0.0f;
+                       v[3] = 1.0f; break;
+            default: return 0;
+            }
+            if (sca_op != 0x01 && sca_op != 0x07) v[0] = v[1] = v[2] = v[3] = s;
+            if (saturate) for (int k = 0; k < 4; k++) v[k] = al_sat(v[k]);
+            for (int k = 0; k < 4; k++) {
+                if (!sm[k]) continue;
+                if (!vec_result && dst_out != 0x1Fu) out[dst_out & 15u][k] = v[k];
+                if (sca_tmp != 0x3Fu) r[sca_tmp & 31u][k] = v[k];
+            }
+        }
+        if (d3 & 1u) return 1;                                          /* end */
+    }
+    return 0;                                                           /* no end bit */
+}
+
+/* ---- the HUD of a frame -------------------------------------------------------------------------------- */
+
+/* One quad (or one HUD draw) after the 3D picture, in clip space after the viewport transform
+ * (x right, -1..1 across the target; y as the shader has it). uflip: its texture runs right to left;
+ * u0 / u1: the texture coordinate at its left / right edge. */
+typedef struct { uint64_t tex; float x0, x1, y0, y1; int uflip; float u0, u1; } al_quad;
+/* An element of the previous frame: its box, whether its quads are mirrored (one half of a pair), how many
+ * quads it has, whether they come from more than one texture (the timer: one texture per digit), and the
+ * size of its last quad. */
+typedef struct { uint64_t tex; float x0, x1, y0, y1; int uflip, mirror, n, mixed, across; float lw, lh; } al_elem;
+
+#define AL_HUD_MAX 768
+typedef struct {
+    al_quad cur[AL_HUD_MAX]; uint32_t n_cur;     /* this frame, so far */
+    al_elem el[AL_HUD_MAX];  uint32_t n_el;      /* the previous frame's elements */
+    float px_w, px_h;                            /* pixels per clip unit (target width / 2, height / 2) */
+} al_hud;
+
+static void al_hud_note(al_hud* h, const al_quad* q)
+{
+    if (h->n_cur < AL_HUD_MAX) h->cur[h->n_cur++] = *q;
+}
+
+static float al_minf(float a, float b) { return a < b ? a : b; }
+static float al_maxf(float a, float b) { return a > b ? a : b; }
+
+/* Diagnostic only: find pixels the effective guest scissor can show. Pixel coordinates are relative to
+ * the target, y down; q is in clip space, y up. Keep texture coordinates and orientation. The live draw's
+ * placement still uses the original box: this helper supplies a textual trace, not a visual correction. */
+static int al_hud_clip(const al_hud* h, al_quad* q, float left, float top, float right, float bottom)
+{
+    if (!(h->px_w > 0.0f && h->px_h > 0.0f)) return 0;
+    left = al_maxf(left, 0.0f); top = al_maxf(top, 0.0f);
+    right = al_minf(right, 2.0f * h->px_w); bottom = al_minf(bottom, 2.0f * h->px_h);
+    if (!(right > left && bottom > top)) return 0;
+    q->x0 = al_maxf(q->x0, left / h->px_w - 1.0f);
+    q->x1 = al_minf(q->x1, right / h->px_w - 1.0f);
+    q->y0 = al_maxf(q->y0, 1.0f - bottom / h->px_h);
+    q->y1 = al_minf(q->y1, 1.0f - top / h->px_h);
+    return q->x1 > q->x0 && q->y1 > q->y0;
+}
+
+static int al_hud_side_clipped_center(const al_quad* raw, const al_quad* visible)
+{
+    return raw->x0 < 0.0f && raw->x1 > 0.0f && visible->x1 > visible->x0 && visible->y1 > visible->y0 &&
+           (visible->x1 <= 0.0f || visible->x0 >= 0.0f);
+}
+
+/* q joins e: same texture, same line (centres within half the smaller height), next to it (a gap of at most
+ * one glyph height, overlapping counts). Or, from another texture, a glyph of exactly the size of e's last
+ * one on exactly its line, touching it (the timer's digits). Measured in pixels. */
+static int al_joins(const al_hud* h, const al_elem* e, const al_quad* q)
+{
+    if (e->mirror) return 0;
+    if (e->tex != q->tex) {
+        const float qw = (q->x1 - q->x0) * h->px_w, qh = (q->y1 - q->y0) * h->px_h;
+        if (fabsf(qw - e->lw) > 1.5f || fabsf(qh - e->lh) > 1.5f) return 0;
+        if (fabsf(q->y0 - e->y0) * h->px_h > 1.5f || fabsf(q->y1 - e->y1) * h->px_h > 1.5f) return 0;
+        return al_maxf(q->x0 - e->x1, e->x0 - q->x1) * h->px_w <= 2.0f;
+    }
+    const float eh = (e->y1 - e->y0) * h->px_h, qh = (q->y1 - q->y0) * h->px_h;
+    const float hmin = al_minf(eh, qh);
+    if (hmin <= 0.5f) return 0;
+    const float dy = fabsf((e->y0 + e->y1) - (q->y0 + q->y1)) * 0.5f * h->px_h;
+    if (dy > 0.5f * hmin) return 0;
+    if (fabsf(eh - qh) > 0.5f * al_maxf(eh, qh)) return 0;              /* a big title and a small line */
+    const float gap = al_maxf(q->x0 - e->x1, e->x0 - q->x1) * h->px_w;
+    return gap <= hmin;
+}
+
+/* The frame ended: its quads become the elements the next frame is placed by. */
+static void al_hud_frame_end(al_hud* h)
+{
+    uint32_t n = 0;
+    const float tol = 4.0f;                                             /* pixels (the game is off by 2) */
+    /* 1. flipped pairs: one texture on both sides at mirrored places, the art flipped on one (the bars and
+     *    their frames, the round marks, the PLAYER DATA bars): the game's own mirror image of each other.
+     *    Anything else at mirrored places -- the same picture, two different letters of the font -- is no
+     *    pair: it moves, and stays readable. */
+    static uint8_t paired[AL_HUD_MAX];
+    memset(paired, 0, h->n_cur);
+    for (uint32_t i = 0; i < h->n_cur; i++)
+        for (uint32_t j = i + 1; j < h->n_cur && !paired[i]; j++) {
+            const al_quad *a = &h->cur[i], *b = &h->cur[j];
+            if (paired[j] || a->tex != b->tex || a->uflip == b->uflip) continue;
+            if (fabsf(a->x0 + b->x1) * h->px_w > tol || fabsf(a->x1 + b->x0) * h->px_w > tol) continue;
+            if (fabsf(a->y0 - b->y0) * h->px_h > tol || fabsf(a->y1 - b->y1) * h->px_h > tol) continue;
+            if (fabsf(a->x0 + a->x1) * h->px_w <= tol) continue;        /* centred: nothing to swap */
+            paired[i] = paired[j] = 1;
+        }
+    for (uint32_t i = 0; i < h->n_cur; i++) {
+        const al_quad* q = &h->cur[i];
+        if (paired[i]) {
+            if (n >= AL_HUD_MAX) break;
+            al_elem* e = &h->el[n++];
+            e->tex = q->tex; e->x0 = q->x0; e->x1 = q->x1; e->y0 = q->y0; e->y1 = q->y1;
+            e->uflip = q->uflip; e->mirror = 1; e->n = 1; e->mixed = 0;
+            e->lw = (q->x1 - q->x0) * h->px_w; e->lh = (q->y1 - q->y0) * h->px_h;
+            continue;
+        }
+        /* 2. strings: the quad joins an element it continues (in drawing order, any earlier one) */
+        uint32_t k = n;
+        for (uint32_t e = 0; e < n; e++)
+            if (al_joins(h, &h->el[e], q)) { k = e; break; }
+        if (k < n) {
+            al_elem* e = &h->el[k];
+            e->x0 = al_minf(e->x0, q->x0); e->x1 = al_maxf(e->x1, q->x1);
+            e->y0 = al_minf(e->y0, q->y0); e->y1 = al_maxf(e->y1, q->y1);
+            e->n++;
+            if (e->tex != q->tex) e->mixed = 1;
+            e->lw = (q->x1 - q->x0) * h->px_w; e->lh = (q->y1 - q->y0) * h->px_h;
+            continue;
+        }
+        if (n >= AL_HUD_MAX) break;
+        al_elem* e = &h->el[n++];
+        e->tex = q->tex; e->x0 = q->x0; e->x1 = q->x1; e->y0 = q->y0; e->y1 = q->y1;
+        e->uflip = q->uflip; e->mirror = 0; e->n = 1; e->mixed = 0;
+        e->lw = (q->x1 - q->x0) * h->px_w; e->lh = (q->y1 - q->y0) * h->px_h;
+    }
+    /* 3. what stays: an element across the middle of the screen (the timer, ROUND, FIGHT), and everything
+     *    on its line next to it (the "1" of "ROUND 1", its own quad half a letter away) -- moved alone it would land inside */
+    for (uint32_t i = 0; i < n; i++) h->el[i].across = !h->el[i].mirror && h->el[i].x0 < 0.0f && h->el[i].x1 > 0.0f;
+    for (int pass = 0, changed = 1; changed && pass < 8; pass++) {
+        changed = 0;
+        for (uint32_t i = 0; i < n; i++) {
+            al_elem* f = &h->el[i];
+            if (f->mirror || f->across) continue;
+            for (uint32_t j = 0; j < n && !f->across; j++) {
+                const al_elem* a = &h->el[j];
+                if (!a->across) continue;
+                const float oy = (al_minf(a->y1, f->y1) - al_maxf(a->y0, f->y0)) * h->px_h;
+                const float hmin = al_minf(a->y1 - a->y0, f->y1 - f->y0) * h->px_h;
+                const float gap = al_maxf(f->x0 - a->x1, a->x0 - f->x1) * h->px_w;
+                if (oy >= 0.5f * hmin && gap <= 0.6f * hmin) { f->across = 1; changed = 1; }
+            }
+        }
+    }
+    h->n_el = n;
+    h->n_cur = 0;
+}
+
+/* Translate a side HUD draw by half the screen, preserving its art and relative glyph/fill positions.
+ * Never reflect individual glyph boxes or take a string's displacement from the preceding frame. */
+static float al_hud_place(const al_hud* h, const al_quad* q, int* mirror)
+{
+    const float cx = (q->x0 + q->x1) * 0.5f, cy = (q->y0 + q->y1) * 0.5f;
+    const float ex = 1.0f / h->px_w, ey = 1.0f / h->px_h;               /* one pixel of slack */
+    *mirror = 0;
+    int across = q->x0 < 0.0f && q->x1 > 0.0f;
+    for (uint32_t i = 0; i < h->n_el; i++) {
+        const al_elem* e = &h->el[i];
+        if ((e->tex != q->tex && !e->mixed) || cx < e->x0 - ex || cx > e->x1 + ex || cy < e->y0 - ey ||
+            cy > e->y1 + ey)
+            continue;
+        if (across || e->across) return 0.0f;
+    }
+    return across ? 0.0f : cx < 0.0f ? 1.0f : -1.0f;
+}
+
+/* The scene copy must be a full-screen quad in evaluated screen coordinates. Stale render-target
+ * bindings and camera constants are not proof: all four corners must actually be drawn. */
+static int al_picture_quad(const float xy[][2], uint32_t n, float px_w, float px_h)
+{
+    if ((n != 4 && n != 6) || px_w <= 0.0f || px_h <= 0.0f) return 0;
+    unsigned corners = 0;
+    for (uint32_t i = 0; i < n; i++) {
+        const float x = xy[i][0], y = xy[i][1];
+        if (!isfinite(x) || !isfinite(y) || fabsf(fabsf(x) - 1.0f) * px_w > 2.0f ||
+            fabsf(fabsf(y) - 1.0f) * px_h > 2.0f) return 0;
+        corners |= 1u << ((x > 0.0f ? 1u : 0u) | (y > 0.0f ? 2u : 0u));
+    }
+    return corners == 15u;
+}
+
+/* Guest-pixel horizontal scissor; clamp both ends before any unsigned host-scale conversion. */
+static void al_clip_scissor(float width, float dx, int mirror, int* left, int* right)
+{
+    const int w = (int)width;
+    int l = *left, r = *right;
+    if (mirror) { l = w - *right; r = w - *left; }
+    else { const int d = (int)floorf(dx + 0.5f); l += d; r += d; }
+    if (l < 0) l = 0;
+    if (l > w) l = w;
+    if (r < 0) r = 0;
+    if (r > w) r = w;
+    if (r < l) r = l;
+    *left = l; *right = r;
+}
+
+#endif

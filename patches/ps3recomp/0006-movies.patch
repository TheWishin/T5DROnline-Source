@@ -0,0 +1,49 @@
+/*
+ * ps3recomp - H.264 decoding for cellVdec through the Windows Media Foundation
+ * H.264 decoder MFT (msmpeg2vdec.dll, part of Windows -- nothing to ship).
+ *
+ * Plain C interface so the C HLE modules can use it. One decoder per object,
+ * used from one thread at a time. Input is Annex-B access units exactly as
+ * cellDmux cuts them (AU delimiter, SPS/PPS in band); output is NV12 in
+ * display order, delivered through a callback while decode/drain runs.
+ *
+ * On a host without Media Foundation every call fails and mfh264_create
+ * returns NULL; cellVdec then falls back to blank pictures.
+ */
+#ifndef PS3RECOMP_MF_H264_H
+#define PS3RECOMP_MF_H264_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct MfH264 MfH264;
+
+typedef struct MfH264Frame {
+    const uint8_t* y;        /* luma plane */
+    const uint8_t* uv;       /* interleaved CbCr plane, half height */
+    uint32_t pitch;          /* bytes per row, both planes */
+    uint32_t width, height;  /* display size (cropped) */
+    int64_t  ts;             /* timestamp of the AU this picture came from */
+} MfH264Frame;
+
+typedef void (*MfH264FrameCb)(void* user, const MfH264Frame* frame);
+
+MfH264* mfh264_create(void);
+void    mfh264_destroy(MfH264* d);
+/* Feed one access unit. Pictures that become available are passed to cb
+ * before this returns. Returns 0 on success, < 0 on a decoder error. */
+int     mfh264_decode(MfH264* d, const uint8_t* au, uint32_t size, int64_t ts,
+                      MfH264FrameCb cb, void* user);
+/* End of stream: emit every picture still held for reordering. */
+int     mfh264_drain(MfH264* d, MfH264FrameCb cb, void* user);
+/* Discard everything buffered (seek / new sequence). */
+void    mfh264_flush(MfH264* d);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_MF_H264_H */

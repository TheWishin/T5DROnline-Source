+    IAudioClient* dc = s_dead_client;         IAudioRenderClient* dr  = s_dead_render;
+    s_dead_client = NULL; s_dead_render = NULL;
+    s_wasapi_client = o->client; s_wasapi_render = o->render;
+    s_wasapi_buf_frames = o->frames; s_wasapi_evt_mode = o->evt;
+    s_stream_frames = 0;

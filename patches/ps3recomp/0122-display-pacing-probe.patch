+    }
+}
+static void enqueue(const char* row, unsigned bytes)
+{
+    AcquireSRWLockExclusive(&s_lock);
+    if (s_stop) {
+        InterlockedIncrement64(&s_dropped);
+        ReleaseSRWLockExclusive(&s_lock);
+        return;

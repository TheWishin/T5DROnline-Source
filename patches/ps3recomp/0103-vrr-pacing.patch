+    unsigned spin_us, int service_slice)
+{
+    hp_wait_result r = {0, 0, 0};
+    hp_wait_state* w = &hp_wait_thread;
+    const int64_t begin = hp_qpc();
+    if (spin_us > 200u) spin_us = 200u;
+    if (!w->tried) {
+        w->tried = 1;
+        w->timer = CreateWaitableTimerExW(NULL, NULL, 0x00000002u /* HIGH_RESOLUTION */, TIMER_ALL_ACCESS);
+        if (!w->timer) { w->fallback = 1; w->timer = CreateWaitableTimerW(NULL, FALSE, NULL); }
+    }
+    for (;;) {
+        const int64_t now = hp_qpc();
+        if (generation && InterlockedCompareExchange(generation, 0, 0) != expected) break;
+        if (now >= deadline) { r.wake_error = now - deadline; break; }
+        const int64_t spin = (int64_t)spin_us * qpf / 1000000;
+        if (spin && deadline - now <= spin) { _mm_pause(); continue; }
+        /* Four ms cancellation/service ceiling; after every wake recompute
+         * from the same deadline. FIFO events return to the caller to pump. */
+        int64_t left = deadline - now - spin;
+        if (left > qpf / 250) left = qpf / 250;
+        LARGE_INTEGER due;
+        due.QuadPart = -((left * 10000000 + qpf - 1) / qpf);
+        if (due.QuadPart == 0) due.QuadPart = -1;
+        if (w->timer && SetWaitableTimer(w->timer, &due, 0, NULL, NULL, FALSE)) {
+            HANDLE hs[2] = {w->timer, wake_event};
+            const DWORD result = WaitForMultipleObjects(wake_event ? 2u : 1u, hs, FALSE, 8);
+            CancelWaitableTimer(w->timer);
+            if (result == WAIT_OBJECT_0 + 1u || service_slice) break;
+            if (result == WAIT_FAILED) { w->fallback = 1; Sleep(1); }
+        } else {
+            w->fallback = 1;
+            if (wake_event) WaitForSingleObject(wake_event, 1); else Sleep(1);
+            if (service_slice) break;
+        }
+    }
+    const int64_t end = hp_qpc();
+    r.waited = end - begin; r.fallback = (unsigned)w->fallback;
+    if (end >= deadline) r.wake_error = end - deadline;
+    return r;
+}
+#undef HP_TLS
+#endif
+#endif

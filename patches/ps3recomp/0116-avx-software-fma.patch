     return _mm_castsi128_pd(_mm_add_epi64(u, _mm_and_si128(_mm_and_si128(adj, even), step)));
 }
 #endif
+#if defined(__AVX__) && !defined(__FMA__)
+VMX_INL __m128d vmx_fmaf_round_pd(__m128d s, __m128d err)
+{
+    /* err != 0.0 && err == err, and s's last bit even */
+    const __m128i adj = _mm_castpd_si128(_mm_and_pd(_mm_cmpneq_pd(err, _mm_setzero_pd()), _mm_cmpord_pd(err, err)));
+    const __m128i u = _mm_castpd_si128(s);
+    const __m128i e32 = _mm_cmpeq_epi32(_mm_and_si128(u, _mm_set_epi32(0, 1, 0, 1)), _mm_setzero_si128());
+    const __m128i even = _mm_and_si128(e32, _mm_shuffle_epi32(e32, 0xB1));
+    /* (err > 0.0) == (s > 0.0) ? u + 1 : u - 1 */
+    const __m128i diff = _mm_castpd_si128(_mm_xor_pd(_mm_cmpgt_pd(err, _mm_setzero_pd()),
+                                                     _mm_cmpgt_pd(s, _mm_setzero_pd())));
+    const __m128i one = _mm_set_epi32(0, 1, 0, 1);
+    const __m128i step = vmx_sel_v(diff, _mm_sub_epi64(_mm_setzero_si128(), one), one);
+    return _mm_castsi128_pd(_mm_add_epi64(u, _mm_and_si128(_mm_and_si128(adj, even), step)));
+}
+VMX_INL __m128 vmx_fmaf_avx(__m128 x, __m128 y, __m128 z)
+{
+    PPU_FP_NOCONTRACT
+    const __m256d dx = _mm256_cvtps_pd(x), dy = _mm256_cvtps_pd(y), dz = _mm256_cvtps_pd(z);
+    const __m256d p = _mm256_mul_pd(dx, dy);
+    const __m256d s = _mm256_add_pd(p, dz);
+    const __m256d bb = _mm256_sub_pd(s, p);
+    const __m256d err = _mm256_add_pd(_mm256_sub_pd(p, _mm256_sub_pd(s, bb)), _mm256_sub_pd(dz, bb));
+    const __m128d lo = vmx_fmaf_round_pd(_mm256_castpd256_pd128(s), _mm256_castpd256_pd128(err));
+    const __m128d hi = vmx_fmaf_round_pd(_mm256_extractf128_pd(s, 1), _mm256_extractf128_pd(err, 1));
+    return _mm_movelh_ps(_mm_cvtpd_ps(lo), _mm_cvtpd_ps(hi));
+}
+#endif
 /* the four lanes of ppu_fmaf_det(x, y, z) */
 VMX_INL __m128 vmx_fmaf_v(__m128 x, __m128 y, __m128 z)
 {
 #if defined(__FMA__)
     return _mm_fmadd_ps(x, y, z);
+#elif defined(__AVX__)
+    return vmx_fmaf_avx(x, y, z);
 #else

// Version information of t5dr.exe (CMakeLists.txt fills in the @...@ values; T5DR_VERSION comes from
// tools/package_release.py, "0.0.0-dev" in a developer build). Explorer shows it in Properties ->
// Details, virus scanners and SmartScreen read it, and SignPath's artifact configuration can check
// the product name. Numbers instead of <windows.h>, so it compiles without include paths.
1 VERSIONINFO
 FILEVERSION @T5DR_VER_MAJOR@,@T5DR_VER_MINOR@,@T5DR_VER_PATCH@,0
 PRODUCTVERSION @T5DR_VER_MAJOR@,@T5DR_VER_MINOR@,@T5DR_VER_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "T5DR Online"
      VALUE "FileDescription", "T5DR Online game runtime"
      VALUE "FileVersion", "@T5DR_VERSION@"
      VALUE "InternalName", "t5dr"
      VALUE "LegalCopyright", "MIT License - T5DR Online contributors"
      VALUE "OriginalFilename", "t5dr.exe"
      VALUE "ProductName", "T5DR Online"
      VALUE "ProductVersion", "@T5DR_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

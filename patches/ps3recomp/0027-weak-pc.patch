+/* GPU timestamps (g_gt above). */
+static void ld_gt_init(void)
+{
+    if (g_gt.on >= 0) return;
+    g_gt.on = 0;
+    const char* e = getenv("RSX_GPU_TIME");
+    const char* fl = getenv("PS3_FRAMELOG");
+    if (!((e && *e && *e != '0') || (!e && fl && *fl))) return;
+    UINT64 freq = 0;
+    if (!g.queue || FAILED(g.queue->lpVtbl->GetTimestampFrequency(g.queue, &freq)) || !freq) return;
+    D3D12_QUERY_HEAP_DESC qd = {0};
+    qd.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+    qd.Count = 2 * LD_GT_SLOTS;
+    if (FAILED(g.dev->lpVtbl->CreateQueryHeap(g.dev, &qd, &IID_ID3D12QueryHeap, (void**)&g_gt.heap)))
+        return;
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC rd = {0};
+    rd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    rd.Width = 16 * LD_GT_SLOTS; rd.Height = 1; rd.DepthOrArraySize = 1; rd.MipLevels = 1;
+    rd.SampleDesc.Count = 1; rd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    void* p = NULL;
+    if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+                   D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&g_gt.rb)) ||
+        FAILED(g_gt.rb->lpVtbl->Map(g_gt.rb, 0, NULL, &p)) || !p) {
+        g_gt.heap->lpVtbl->Release(g_gt.heap); g_gt.heap = NULL;
+        return;
+    }
+    g_gt.rbp = (const u64*)p;
+    g_gt.us_per_tick = 1e6 / (double)freq;
+    g_gt.on = 1;
+    fprintf(stderr, "[gpu-time] timestamp queries on (%llu Hz)\n", (unsigned long long)freq);
+}
+/* The list was just reset (or created): stamp its start. */
+static void ld_gt_begin(void)
+{
+    g_gt.open = 0;
+    if (g_gt.on <= 0) return;
+    if (g_gt.head - g_gt.tail >= LD_GT_SLOTS) ld_gt_harvest();
+    if (g_gt.head - g_gt.tail >= LD_GT_SLOTS) return;
+    g.list->lpVtbl->EndQuery(g.list, g_gt.heap, D3D12_QUERY_TYPE_TIMESTAMP, 2 * (g_gt.head % LD_GT_SLOTS));
+    g_gt.open = 1;
+}
+/* Before Close: stamp the end and resolve both into the readback slot.
+ * Returns the slot + 1 (0 = none); ld_gt_submitted() gives it its fence. */
+static u32 ld_gt_end(void)
+{
+    if (!g_gt.open) return 0;
+    g_gt.open = 0;
+    const u32 k = g_gt.head % LD_GT_SLOTS;
+    g.list->lpVtbl->EndQuery(g.list, g_gt.heap, D3D12_QUERY_TYPE_TIMESTAMP, 2 * k + 1);
+    g.list->lpVtbl->ResolveQueryData(g.list, g_gt.heap, D3D12_QUERY_TYPE_TIMESTAMP, 2 * k, 2,
+                                     g_gt.rb, 16ull * k);
+    g_gt.fence[k] = 0;
+    g_gt.head++;
+    return k + 1;
+}
+static void ld_gt_submitted(u32 slot1, u64 fence_value)
+{
+    if (slot1) g_gt.fence[slot1 - 1] = fence_value;
+}
+static void ld_gt_harvest(void)
+{
+    if (g_gt.on <= 0) return;
+    const u64 done = g.fence->lpVtbl->GetCompletedValue(g.fence);
+    while (g_gt.tail != g_gt.head) {
+        const u32 k = g_gt.tail % LD_GT_SLOTS;
+        if (!g_gt.fence[k] || g_gt.fence[k] > done) break;
+        const u64 b = g_gt.rbp[2 * k], e2 = g_gt.rbp[2 * k + 1];
+        if (e2 > b) { g_gt.done_ticks += e2 - b; g_gt.done_lists++; }
+        g_gt.tail++;
+    }
+}

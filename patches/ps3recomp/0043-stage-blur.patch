+ * of units changed (0: none qualified, the text is unchanged), -1 when the
+ * text does not fit. Used by PS3_STAGE_BLUR=0 (rsx_live_draw.c). */
+int rsx_fp_apply_single_tap(char* hlsl, u32 hlsl_size, u32 unit_mask, u32 cube_mask);
 
 #ifdef __cplusplus
 }

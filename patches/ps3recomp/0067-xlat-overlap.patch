+    a->n = n > 2 ? 2 : n;     /* D3D12 binds at most one CBV/SRV/UAV and one sampler heap */
+    for (UINT i = 0; i < a->n; i++) a->h[i] = h[i];
+    ld_rq_publish();
+}

+    out->button[1] = (u16)(0x70 | (CELL_PAD_LEN_CHANGE_DEFAULT / 2));
+    out->button[CELL_PAD_BTN_OFFSET_DIGITAL1] = (u16)(b & 0xFF);
+    out->button[CELL_PAD_BTN_OFFSET_DIGITAL2] = (u16)(b >> 8);
+    out->button[CELL_PAD_BTN_OFFSET_ANALOG_RIGHT_X] = st.rx;
+    out->button[CELL_PAD_BTN_OFFSET_ANALOG_RIGHT_Y] = st.ry;
+    out->button[CELL_PAD_BTN_OFFSET_ANALOG_LEFT_X]  = st.lx;
+    out->button[CELL_PAD_BTN_OFFSET_ANALOG_LEFT_Y]  = st.ly;
+    out->button[CELL_PAD_BTN_OFFSET_PRESS_RIGHT]    = (b & CELL_PAD_CTRL_RIGHT)    ? 255 : 0;
+    out->button[CELL_PAD_BTN_OFFSET_PRESS_LEFT]     = (b & CELL_PAD_CTRL_LEFT)     ? 255 : 0;
+    out->button[CELL_PAD_BTN_OFFSET_PRESS_UP]       = (b & CELL_PAD_CTRL_UP)       ? 255 : 0;
+    out->button[CELL_PAD_BTN_OFFSET_PRESS_DOWN]     = (b & CELL_PAD_CTRL_DOWN)     ? 255 : 0;
+    out->button[CELL_PAD_BTN_OFFSET_PRESS_TRIANGLE] = (b & CELL_PAD_CTRL_TRIANGLE) ? 255 : 0;
+    out->button[CELL_PAD_BTN_OFFSET_PRESS_CIRCLE]   = (b & CELL_PAD_CTRL_CIRCLE)   ? 255 : 0;
+    out->button[CELL_PAD_BTN_OFFSET_PRESS_CROSS]    = (b & CELL_PAD_CTRL_CROSS)    ? 255 : 0;
+    out->button[CELL_PAD_BTN_OFFSET_PRESS_SQUARE]   = (b & CELL_PAD_CTRL_SQUARE)   ? 255 : 0;
+    out->button[CELL_PAD_BTN_OFFSET_PRESS_L1]       = (b & CELL_PAD_CTRL_L1)       ? 255 : 0;
+    out->button[CELL_PAD_BTN_OFFSET_PRESS_R1]       = (b & CELL_PAD_CTRL_R1)       ? 255 : 0;

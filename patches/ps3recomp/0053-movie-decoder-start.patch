+/* The watchdog (patch 0053), lock held: the worker has been inside one Media
+ * Foundation call for too long. A new worker takes the slot over. */
+static void replace_worker(Vdec* v, int si, u64 waited)
+{
+    const int was_decode = v->cur.type == CMD_DECODE;
+    v->epoch++;
+    v->mf = NULL;              /* the stalled thread keeps it and frees it if it ever returns */
+    v->mf_since = 0;
+    v->stalled = 1;
+    if (v->thread) CloseHandle(v->thread);
+    v->thread = NULL;
+    v->thread_id = 0;
+    v->resume = 0;
+    v->busy = 0;
+    if (v->in_use && !v->closing) {
+        v->resume = 1;         /* finish the command it was on */
+        v->busy = 1;
+        v->thread = CreateThread(NULL, 1u << 20, vdec_worker, (LPVOID)(uintptr_t)((unsigned)si | (v->epoch << 8)),
+                                 0, &v->thread_id);
+        if (!v->thread) { v->resume = 0; v->busy = 0; }
+    }
+    wake();
+    printf("[cellVdec] handle %u: the H.264 decoder has not answered for %llu ms (%s) -- the rest of this "
+           "movie has no pictures (its sound plays, START skips it); a new decoder is made for the next one\n",
+           v->handle, (unsigned long long)waited, was_decode ? "decoding" : "flush/drain");
+    mfh264_prewarm();
+}
+
+static DWORD WINAPI vdec_watchdog(LPVOID unused)
+{
+    (void)unused;
+    host_sched_thread_start(HS_ROLE_DECODER, 0, "vdec-watchdog");   /* sleeps 250 ms at a time; must not starve */
+    for (;;) {
+        Sleep(250);
+        const unsigned lim = stall_ms();
+        if (!lim) continue;
+        lock();
+        const u64 now = now_ms();
+        for (int i = 0; i < VDEC_MAX; i++) {
+            Vdec* v = &s_vdec[i];
+            if (v->mf_since && age_ms(now, v->mf_since) >= lim) {
+                replace_worker(v, i, age_ms(now, v->mf_since));
+            } else if (v->in_use && !v->closing && v->seq == 1 && !v->stalled && !v->mf_failed &&
+                       v->codec == CELL_VDEC_CODEC_TYPE_AVC && v->t_first_dec && v->seq_aus >= 2 &&
+                       v->seq_pics == 0 && age_ms(now, v->t_first_dec) >= lim) {
+                v->stalled = 1;
+                printf("[cellVdec] handle %u: %u AUs in %llu ms and no picture from the H.264 decoder -- "
+                       "the rest of this movie has no pictures (its sound plays, START skips it)\n",
+                       v->handle, v->seq_aus, (unsigned long long)age_ms(now, v->t_first_dec));
+            }
+        }
+        unlock();
+    }
+}

+#else
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static const char* const k_role_name[HS_ROLE_COUNT] = {
+    "PPU", "MAIN", "TICKER", "SPU", "SPURS", "AUDIO", "DECODER", "TIMER", "BG"
+};
+
+/* ---- configuration --------------------------------------------------------- */
+#define HS_KEEP 99                 /* "leave the priority alone" */
+
+static INIT_ONCE s_once = INIT_ONCE_STATIC_INIT;
+static int  s_on = 1;              /* PS3_SCHED */
+static int  s_log = 0;
+static int  s_timer = 1;
+static int  s_ppu_lo = 1002;
+static int  s_ideal = 0;
+static int  s_subms = 0;           /* PS3_SCHED_SUBMS: 0 spin, 1 pause, 2 timer */
+static int64_t s_spin_ticks = 0;
+static LARGE_INTEGER s_qpf;
+
+/* Host priority per role; PPU threads use the three PPU* entries below. */
+static int  s_prio[HS_ROLE_COUNT];
+static int  s_prio_ppuhi, s_prio_ppu, s_prio_ppulo;
+static char s_mmcss[HS_ROLE_COUNT][32];
+static char s_cpus_role[HS_ROLE_COUNT][24];
+
+/* ---- topology ---------------------------------------------------------------- */
+/* Mirror of SYSTEM_CPU_SET_INFORMATION (Windows 10+); declared here so the
+ * build does not depend on the SDK's _WIN32_WINNT. */
+typedef struct {
+    DWORD Size;
+    DWORD Type;
+    DWORD Id;
+    WORD  Group;
+    BYTE  LogicalProcessorIndex;
+    BYTE  CoreIndex;
+    BYTE  LastLevelCacheIndex;
+    BYTE  NumaNodeIndex;
+    BYTE  EfficiencyClass;
+    BYTE  AllFlags;
+    BYTE  SchedulingClass;
+    BYTE  pad[3];
+    DWORD64 AllocationTag;
+} hs_cpuset_info;
+
+#define HS_MAX_CPUS 256
+typedef struct { ULONG id; BYTE lp, core, llc, sched, eff; } hs_cpu;
+static hs_cpu s_cpu[HS_MAX_CPUS];
+static int    s_ncpu = 0;
+static BYTE   s_fast_llc = 0xFF;
+static int    s_ranked_lp[HS_MAX_CPUS];   /* first LP of each core, fastest first */
+static int    s_nranked = 0;
+
+typedef BOOL (WINAPI *pfn_GetSystemCpuSetInformation)(void*, ULONG, PULONG, HANDLE, ULONG);
+typedef BOOL (WINAPI *pfn_SetThreadSelectedCpuSets)(HANDLE, const ULONG*, ULONG);
+typedef BOOL (WINAPI *pfn_SetProcessDefaultCpuSets)(HANDLE, const ULONG*, ULONG);
+typedef HRESULT (WINAPI *pfn_SetThreadDescription)(HANDLE, PCWSTR);
+typedef BOOL (WINAPI *pfn_SetProcessInformation)(HANDLE, int, LPVOID, DWORD);
+typedef HANDLE (WINAPI *pfn_AvSetMmThreadCharacteristicsA)(LPCSTR, LPDWORD);
+static pfn_SetThreadSelectedCpuSets      p_SetThreadSelectedCpuSets;
+static pfn_SetProcessDefaultCpuSets      p_SetProcessDefaultCpuSets;
+static pfn_SetThreadDescription          p_SetThreadDescription;
+static pfn_AvSetMmThreadCharacteristicsA p_AvSetMmThreadCharacteristicsA;
+
+static void hs_topology(void)
+{
+    HMODULE k32 = GetModuleHandleA("kernel32.dll");
+    pfn_GetSystemCpuSetInformation get = (pfn_GetSystemCpuSetInformation)(void*)
+        GetProcAddress(k32, "GetSystemCpuSetInformation");
+    if (!get) return;
+    ULONG len = 0;
+    get(NULL, 0, &len, GetCurrentProcess(), 0);
+    if (!len) return;
+    BYTE* buf = (BYTE*)malloc(len);
+    if (!buf) return;
+    if (get(buf, len, &len, GetCurrentProcess(), 0)) {
+        for (ULONG off = 0; off + 8 <= len && s_ncpu < HS_MAX_CPUS; ) {
+            const hs_cpuset_info* c = (const hs_cpuset_info*)(buf + off);
+            if (!c->Size) break;
+            if (c->Type == 0 && c->Group == 0) {          /* CpuSetInformation, group 0 */
+                hs_cpu* d = &s_cpu[s_ncpu++];
+                d->id = c->Id; d->lp = c->LogicalProcessorIndex; d->core = c->CoreIndex;
+                d->llc = c->LastLevelCacheIndex; d->sched = c->SchedulingClass;
+                d->eff = c->EfficiencyClass;
+            }
+            off += c->Size;
+        }
+    }
+    free(buf);
+    /* The fast cache group: the one holding the best-ranked core. Ties (a CPU
+     * that ranks nothing) fall to the group of logical processor 0. Hybrid
+     * parts rank by efficiency class first. */
+    int best = -1;
+    for (int i = 0; i < s_ncpu; i++) {
+        if (best < 0 ||
+            s_cpu[i].eff > s_cpu[best].eff ||
+            (s_cpu[i].eff == s_cpu[best].eff && s_cpu[i].sched > s_cpu[best].sched))
+            best = i;
+    }
+    if (best >= 0) s_fast_llc = s_cpu[best].llc;
+    /* One LP per core, best first (stable on LP index). */
+    for (int i = 0; i < s_ncpu; i++) {
+        int dup = 0;
+        for (int j = 0; j < s_nranked; j++)
+            if (s_cpu[s_ranked_lp[j]].core == s_cpu[i].core) { dup = 1; break; }
+        if (!dup) s_ranked_lp[s_nranked++] = i;
+    }
+    for (int i = 1; i < s_nranked; i++) {        /* insertion sort, descending */
+        int v = s_ranked_lp[i], j = i - 1;
+        while (j >= 0 && (s_cpu[s_ranked_lp[j]].eff < s_cpu[v].eff ||
+                          (s_cpu[s_ranked_lp[j]].eff == s_cpu[v].eff &&
+                           s_cpu[s_ranked_lp[j]].sched < s_cpu[v].sched))) {
+            s_ranked_lp[j + 1] = s_ranked_lp[j]; j--;
+        }
+        s_ranked_lp[j + 1] = v;
+    }
+}
+
+/* Resolve a CPU-set spec to CPU set ids. Returns the count; 0 = no constraint. */
+static ULONG hs_cpus(const char* spec, ULONG* ids)
+{
+    if (!spec || !*spec || !strcmp(spec, "all") || s_ncpu == 0) return 0;
+    ULONG n = 0;
+    if (!strcmp(spec, "fast") || !strcmp(spec, "slow")) {
+        const int want_fast = spec[0] == 'f';
+        for (int i = 0; i < s_ncpu; i++)
+            if ((s_cpu[i].llc == s_fast_llc) == want_fast) ids[n++] = s_cpu[i].id;
+        return n;
+    }
+    unsigned long long mask = strtoull(spec, NULL, 0);
+    for (int i = 0; i < s_ncpu; i++)
+        if (s_cpu[i].lp < 64 && (mask >> s_cpu[i].lp & 1)) ids[n++] = s_cpu[i].id;
+    return n;
+}
+
+/* ---- trace ----------------------------------------------------------------- */
+typedef struct { volatile LONG64 qpc; uint16_t kind, tid; uint32_t arg; } hs_rec;
+#define HS_TRACE_CAP (1u << 22)              /* 4M records, 64 MB */
+static hs_rec* s_tr;
+static volatile LONG s_tr_head;
+static FILE* s_tr_file;
+static __declspec(thread) uint16_t t_tag;    /* guest tid, or 0x100 + role */
+
+static DWORD WINAPI hs_trace_flusher(LPVOID unused)
+{
+    (void)unused;
+    ULONG done = 0;
+    host_sched_thread_start(HS_ROLE_BACKGROUND, 0, "sched-trace");
+    for (;;) {
+        Sleep(250);
+        ULONG head = (ULONG)s_tr_head;
+        if (head > HS_TRACE_CAP) head = HS_TRACE_CAP;
+        ULONG end = done;
+        while (end < head && s_tr[end].qpc != 0) end++;
+        if (end > done) {
+            fwrite(&s_tr[done], sizeof(hs_rec), end - done, s_tr_file);
+            fflush(s_tr_file);
+            done = end;
+        }
+        if (done >= HS_TRACE_CAP) {
+            fprintf(stderr, "[sched] trace full (%u records), stopped\n", HS_TRACE_CAP);
+            g_host_sched_trace_on = 0;
+            return 0;
+        }
+    }
+}
+
+static void hs_trace_put_at(int kind, uint32_t arg, uint16_t tid, LONG64 qpc)
+{
+    ULONG i = (ULONG)InterlockedIncrement(&s_tr_head) - 1;
+    if (i >= HS_TRACE_CAP) return;
+    s_tr[i].kind = (uint16_t)kind; s_tr[i].tid = tid; s_tr[i].arg = arg;
+    InterlockedExchange64(&s_tr[i].qpc, qpc ? qpc : 1);
+}
+
+static void hs_trace_put(int kind, uint32_t arg, uint16_t tid)
+{
+    LARGE_INTEGER now; QueryPerformanceCounter(&now);
+    ULONG i = (ULONG)InterlockedIncrement(&s_tr_head) - 1;
+    if (i >= HS_TRACE_CAP) return;
+    s_tr[i].kind = (uint16_t)kind; s_tr[i].tid = tid; s_tr[i].arg = arg;
+    InterlockedExchange64(&s_tr[i].qpc, now.QuadPart ? now.QuadPart : 1);
+}
+
+void host_sched_trace_(int kind, uint32_t arg) { hs_trace_put(kind, arg, t_tag); }
+void host_sched_trace_tid(int kind, uint32_t arg, uint32_t tid)
+{
+    if (g_host_sched_trace_on) hs_trace_put(kind, arg, (uint16_t)tid);
+}
+void host_sched_trace_tag(uint32_t tid) { t_tag = (uint16_t)tid; }
+void host_sched_trace_at(int kind, uint32_t arg, int64_t qpc)
+{
+    if (g_host_sched_trace_on) hs_trace_put_at(kind, arg, t_tag, (LONG64)qpc);
+}
+void host_sched_trace_tid_at(int kind, uint32_t arg, uint32_t tid, int64_t qpc)
+{
+    if (g_host_sched_trace_on) hs_trace_put_at(kind, arg, (uint16_t)tid, (LONG64)qpc);
+}
+int64_t host_sched_qpc(void) { LARGE_INTEGER t; QueryPerformanceCounter(&t); return t.QuadPart; }
+
+/* ---- init -------------------------------------------------------------------- */
+static int env_int(const char* name, int def)
+{
+    const char* e = getenv(name);
+    if (!e || !*e) return def;
+    if (*e == 'x' || *e == 'X') return HS_KEEP;
+    return (int)strtol(e, NULL, 0);
+}
+static void env_str(const char* name, char* out, size_t cap, const char* def)
+{
+    const char* e = getenv(name);
+    snprintf(out, cap, "%s", e ? e : def);
+}
+
+static BOOL CALLBACK hs_init_once(PINIT_ONCE once, PVOID param, PVOID* ctx)
+{
+    (void)once; (void)param; (void)ctx;
+    QueryPerformanceFrequency(&s_qpf);
+    s_on = env_int("PS3_SCHED", 1) != 0;
+    s_log = env_int("PS3_SCHED_LOG", 0);
+    HMODULE k32 = GetModuleHandleA("kernel32.dll");
+    p_SetThreadDescription = (pfn_SetThreadDescription)(void*)GetProcAddress(k32, "SetThreadDescription");
+
+    /* The trace works with the policy on or off: it is how the two compare. */
+    { const char* tf = getenv("PS3_SCHED_TRACE");
+      if (tf && *tf) {
+          s_tr = (hs_rec*)VirtualAlloc(NULL, (SIZE_T)HS_TRACE_CAP * sizeof(hs_rec),
+                                       MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+          s_tr_file = fopen(tf, "wb");
+          if (s_tr && s_tr_file) {
+              const uint32_t ver = 1;
+              fwrite("HSTR", 1, 4, s_tr_file);
+              fwrite(&ver, 4, 1, s_tr_file);
+              fwrite(&s_qpf.QuadPart, 8, 1, s_tr_file);
+              fflush(s_tr_file);
+              g_host_sched_trace_on = 1;
+              HANDLE th = CreateThread(NULL, 0, hs_trace_flusher, NULL, 0, NULL);
+              if (th) CloseHandle(th);
+              fprintf(stderr, "[sched] trace -> %s\n", tf);
+          }
+      } }
+    if (!s_on) {
+        fprintf(stderr, "[sched] PS3_SCHED=0: stock thread scheduling\n");
+        return TRUE;
+    }
+
+    s_timer  = env_int("PS3_SCHED_TIMER", 1) != 0;
+    s_ppu_lo = env_int("PS3_SCHED_PPU_LO", 1002);
+    s_ideal  = env_int("PS3_SCHED_IDEAL", 0);
+    { char sm[16]; env_str("PS3_SCHED_SUBMS", sm, sizeof sm, "spin");
+      s_subms = !strcmp(sm, "pause") ? 1 : !strcmp(sm, "timer") ? 2 : 0; }
+    s_spin_ticks = (int64_t)env_int("PS3_SCHED_SPIN_US", 0) * s_qpf.QuadPart / 1000000;
+    if (s_spin_ticks < 0) s_spin_ticks = 0;
+
+    /* Default host priorities (Tekken 5 DR fights, measured under load; see
+     * the table at the top). The frame is one chain -- main thread, draw
+     * request managers (lv2 prio 1000/1001), SPURS skinning, then the ticker's
+     * FIFO drain -- so every link of it goes up one step, the ticker (which
+     * drains a whole frame of commands in one go) and the SPU sound core (a
+     * 5.33 ms deadline, ~85% of a core) two, the audio mixer (a few us every
+     * 250 us) to TIME_CRITICAL. Loaders (lv2 prio >= 1002) stay NORMAL. */
+    s_prio[HS_ROLE_PPU]        = 0;
+    s_prio[HS_ROLE_MAIN]       = env_int("PS3_SCHED_PRIO_MAIN",    THREAD_PRIORITY_ABOVE_NORMAL);
+    s_prio[HS_ROLE_TICKER]     = env_int("PS3_SCHED_PRIO_TICKER",  THREAD_PRIORITY_HIGHEST);
+    s_prio[HS_ROLE_SPU]        = env_int("PS3_SCHED_PRIO_SPU",     THREAD_PRIORITY_HIGHEST);
+    s_prio[HS_ROLE_SPURS]      = env_int("PS3_SCHED_PRIO_SPURS",   THREAD_PRIORITY_ABOVE_NORMAL);
+    s_prio[HS_ROLE_AUDIO]      = env_int("PS3_SCHED_PRIO_AUDIO",   THREAD_PRIORITY_TIME_CRITICAL);
+    s_prio[HS_ROLE_DECODER]    = env_int("PS3_SCHED_PRIO_DECODER", HS_KEEP);
+    s_prio[HS_ROLE_TIMER]      = env_int("PS3_SCHED_PRIO_TIMER",   HS_KEEP);
+    s_prio[HS_ROLE_BACKGROUND] = env_int("PS3_SCHED_PRIO_BG",      THREAD_PRIORITY_BELOW_NORMAL);
+    s_prio_ppuhi = env_int("PS3_SCHED_PRIO_PPUHI", THREAD_PRIORITY_ABOVE_NORMAL);
+    s_prio_ppu   = env_int("PS3_SCHED_PRIO_PPU",   THREAD_PRIORITY_ABOVE_NORMAL);
+    s_prio_ppulo = env_int("PS3_SCHED_PRIO_PPULO", HS_KEEP);
+    for (int r = 0; r < HS_ROLE_COUNT; r++) {
+        char k[48];
+        snprintf(k, sizeof k, "PS3_SCHED_MMCSS_%s", k_role_name[r]);
+        env_str(k, s_mmcss[r], sizeof s_mmcss[r], "");
+        snprintf(k, sizeof k, "PS3_SCHED_CPUS_%s", k_role_name[r]);
+        env_str(k, s_cpus_role[r], sizeof s_cpus_role[r], "");
+    }
+
+    hs_topology();
+    p_SetThreadSelectedCpuSets = (pfn_SetThreadSelectedCpuSets)(void*)
+        GetProcAddress(k32, "SetThreadSelectedCpuSets");
+    p_SetProcessDefaultCpuSets = (pfn_SetProcessDefaultCpuSets)(void*)
+        GetProcAddress(k32, "SetProcessDefaultCpuSets");
+    for (int r = 0; r < HS_ROLE_COUNT; r++)
+        if (s_mmcss[r][0] && !p_AvSetMmThreadCharacteristicsA) {
+            HMODULE avrt = LoadLibraryA("avrt.dll");
+            if (avrt) p_AvSetMmThreadCharacteristicsA = (pfn_AvSetMmThreadCharacteristicsA)(void*)
+                          GetProcAddress(avrt, "AvSetMmThreadCharacteristicsA");
+        }
+
+    /* Power throttling. Windows may run a background process under EcoQoS
+     * (low clocks, efficiency cores) and, on Windows 11, ignores the 1 ms
+     * timeBeginPeriod of a process whose window is minimized or occluded --
+     * every 1-4 ms wait in the frame handshakes then rounds to the 15.6 ms
+     * tick. Opt out of both: ControlMask = what we decide, StateMask 0 = off. */
+    if (env_int("PS3_SCHED_THROTTLE", 1)) {
+        struct { ULONG Version, ControlMask, StateMask; } pt = { 1, 0x1u | 0x4u, 0 };
+        pfn_SetProcessInformation spi = (pfn_SetProcessInformation)(void*)
+            GetProcAddress(k32, "SetProcessInformation");
+        BOOL ok = spi && spi(GetCurrentProcess(), 4 /* ProcessPowerThrottling */, &pt, sizeof pt);
+        if (!ok) {          /* older Windows: no timer-resolution bit */
+            pt.ControlMask = 0x1u;
+            ok = spi && spi(GetCurrentProcess(), 4, &pt, sizeof pt);
+        }
+        fprintf(stderr, "[sched] power throttling off: %s\n", ok ? "yes" : "FAILED");
+    }
+
+    /* Process class: NORMAL by default. ABOVE_NORMAL on top of the per-thread
+     * map halved the late audio blocks with the machine saturated, but its
+     * frame times were not consistently better (+2.5 fps in one series, -8 in
+     * the next, inside the run-to-run noise), so it stays opt-in. */
+    { char pc[16]; env_str("PS3_PRIORITY_CLASS", pc, sizeof pc, "normal");
+      DWORD cls = !strcmp(pc, "above") ? ABOVE_NORMAL_PRIORITY_CLASS :
+                  !strcmp(pc, "high")  ? HIGH_PRIORITY_CLASS : 0;
+      if (cls) fprintf(stderr, "[sched] priority class %s: %s\n", pc,
+                       SetPriorityClass(GetCurrentProcess(), cls) ? "ok" : "FAILED"); }
+
+    { char spec[24]; ULONG ids[HS_MAX_CPUS];
+      env_str("PS3_SCHED_CPUS", spec, sizeof spec, "all");
+      ULONG n = hs_cpus(spec, ids);
+      if (n && p_SetProcessDefaultCpuSets)
+          fprintf(stderr, "[sched] process CPU set %s (%lu logical processors): %s\n", spec,
+                  (unsigned long)n, p_SetProcessDefaultCpuSets(GetCurrentProcess(), ids, n) ? "ok" : "FAILED"); }
+
+    fprintf(stderr, "[sched] %d logical processors, fast cache group %u, best cores (LP):",
+            s_ncpu, (unsigned)s_fast_llc);
+    for (int i = 0; i < s_nranked && i < 8; i++) fprintf(stderr, " %u", s_cpu[s_ranked_lp[i]].lp);
+    fprintf(stderr, "%c", 10);
+    return TRUE;
+}
+
+void host_sched_process_init(void)
+{
+    InitOnceExecuteOnce(&s_once, hs_init_once, NULL, NULL);
+}
+
+int host_sched_enabled(void)
+{
+    host_sched_process_init();
+    return s_on;
+}
+
+int64_t host_sched_spin_ticks(void)
+{
+    host_sched_process_init();
+    return s_on ? s_spin_ticks : 0;
+}
+
+/* ---- per thread ---------------------------------------------------------------- */
+static volatile LONG s_ideal_next = 0;
+
+void host_sched_thread_start(int role, int guest_prio, const char* name)
+{
+    host_sched_process_init();
+    if (role < 0 || role >= HS_ROLE_COUNT) role = HS_ROLE_BACKGROUND;
+    t_tag = (role == HS_ROLE_PPU || role == HS_ROLE_MAIN) ? 0 : (uint16_t)(0x100 + role);
+
+    if (p_SetThreadDescription && name && *name) {
+        wchar_t w[64];
+        int n = MultiByteToWideChar(CP_UTF8, 0, name, -1, w, 64);
+        if (n <= 0) { w[0] = 0; }
+        w[63] = 0;
+        p_SetThreadDescription(GetCurrentThread(), w);
+    }
+
+    if (!s_on) {           /* stock: the one boost sys_ppu_thread_create had */
+        if (role == HS_ROLE_PPU && guest_prio < 256)
+            SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_ABOVE_NORMAL);
+        return;
+    }
+
+    int prio = s_prio[role];
+    if (role == HS_ROLE_PPU)
+        prio = guest_prio < 256 ? s_prio_ppuhi : guest_prio < s_ppu_lo ? s_prio_ppu : s_prio_ppulo;
+    if (prio != HS_KEEP) SetThreadPriority(GetCurrentThread(), prio);
+
+    const char* mm = s_mmcss[role];
+    if (role == HS_ROLE_PPU) mm = "";                 /* MMCSS only for host roles + MAIN */
+    int mm_ok = 0;
+    if (mm[0] && p_AvSetMmThreadCharacteristicsA) {
+        DWORD idx = 0;
+        mm_ok = p_AvSetMmThreadCharacteristicsA(mm, &idx) != NULL;
+    }
+
+    ULONG ids[HS_MAX_CPUS];
+    ULONG n = hs_cpus(s_cpus_role[role], ids);
+    int cpus_ok = 0;
+    if (n && p_SetThreadSelectedCpuSets)
+        cpus_ok = p_SetThreadSelectedCpuSets(GetCurrentThread(), ids, n) != 0;
+
+    int ideal = -1;
+    if (s_ideal && s_nranked > 0) {
+        int slot = role == HS_ROLE_MAIN ? 0 : role == HS_ROLE_TICKER ? 1 :
+                   role == HS_ROLE_SPU ? 2 : role == HS_ROLE_AUDIO ? 3 : -1;
+        if (slot < 0 && role == HS_ROLE_SPURS)          /* workers: the rest, in rank order */
+            slot = 4 + (int)(InterlockedIncrement(&s_ideal_next) - 1) % (s_nranked > 4 ? s_nranked - 4 : 1);
+        if (slot >= 0 && slot < s_nranked) {
+            ideal = s_cpu[s_ranked_lp[slot]].lp;
+            SetThreadIdealProcessor(GetCurrentThread(), (DWORD)ideal);
+        }
+    }
+
+    if (s_log)
+        fprintf(stderr, "[sched] thread '%s' role=%s guest_prio=%d -> host prio %d%s%s%s cpus=%s%s ideal=%d\n",
+                name ? name : "?", k_role_name[role], guest_prio, GetThreadPriority(GetCurrentThread()),
+                mm[0] ? " mmcss=" : "", mm, mm[0] ? (mm_ok ? "(ok)" : "(FAILED)") : "",
+                s_cpus_role[role][0] ? s_cpus_role[role] : "-", n ? (cpus_ok ? "(ok)" : "(FAILED)") : "",
+                ideal);
+}
+
+/* ---- timers -------------------------------------------------------------------- */
+static __declspec(thread) HANDLE t_timer;
+static __declspec(thread) int    t_timer_tried;
+
+static int hs_timer_wait(uint64_t usec)
+{
+    if (!t_timer_tried) {
+        t_timer_tried = 1;
+        /* CREATE_WAITABLE_TIMER_HIGH_RESOLUTION (Windows 10 1803+): expires on
+         * its due time instead of the next timer tick, independent of
+         * timeBeginPeriod. One per thread, kept: creating and closing a timer
+         * per usleep was two extra kernel objects per guest poll. */
+        t_timer = CreateWaitableTimerExW(NULL, NULL, 0x00000002, TIMER_ALL_ACCESS);
+        if (!t_timer) t_timer = CreateWaitableTimerExW(NULL, NULL, 0, TIMER_ALL_ACCESS);
+    }
+    if (!t_timer) return 0;
+    LARGE_INTEGER due;
+    due.QuadPart = -(LONGLONG)(usec * 10);
+    if (!SetWaitableTimer(t_timer, &due, 0, NULL, NULL, FALSE)) return 0;
+    WaitForSingleObject(t_timer, INFINITE);
+    return 1;
+}
+
+int host_sched_sleep_us(uint64_t usec)
+{
+    host_sched_process_init();
+    if (!s_on || !s_timer) return 0;
+    return hs_timer_wait(usec);
+}
+
+int host_sched_sleep_subms(uint64_t usec)
+{
+    host_sched_process_init();
+    if (!s_on || s_subms == 0) return 0;
+    if (s_subms == 2) return hs_timer_wait(usec);
+    /* pause: spin on the deadline with PAUSE (leaves the core's other
+     * hardware thread its execution resources), yielding every 50 us. */
+    LARGE_INTEGER t0, t;
+    QueryPerformanceCounter(&t0);
+    const LONGLONG end = t0.QuadPart + (LONGLONG)(usec * (uint64_t)s_qpf.QuadPart / 1000000u);
+    const LONGLONG every = s_qpf.QuadPart / 20000;
+    LONGLONG next_yield = t0.QuadPart + every;
+    do {
+        for (int i = 0; i < 32; i++) YieldProcessor();
+        QueryPerformanceCounter(&t);
+        if (t.QuadPart >= next_yield) { SwitchToThread(); next_yield = t.QuadPart + every; }
+    } while (t.QuadPart < end);
+    return 1;
+}
+
+#endif /* _WIN32 */
diff --git a/runtime/platform/host_sched.h b/runtime/platform/host_sched.h
new file mode 100644
index 0000000..eca8287
--- /dev/null
+++ b/runtime/platform/host_sched.h
@@ -0,0 +1,110 @@
+/*
+ * ps3recomp - host scheduling policy for the runtime's threads (Windows).
+ *
+ * The PS3 ran the guest's threads on two PPU hardware threads and six SPUs
+ * with lv2's strict priority scheduler. Here every guest thread, SPU thread,
+ * SPURS worker, the vblank/RSX ticker and the audio mixer is a host thread
+ * that Windows schedules at NORMAL priority wherever it likes, next to
+ * everything else on the machine. This module gives each thread a role and
+ * maps the role to a host priority, an optional MMCSS class and an optional
+ * CPU set, and sets the process-wide knobs (power throttling, timer
+ * resolution, priority class). Every knob has an environment override; see
+ * host_sched.c for the list and the measurements behind the defaults.
+ *
+ * It also carries PS3_SCHED_TRACE=<file>: a lock-free per-event timeline
+ * (QPC stamps) of the frame handshakes, for offline analysis.
+ *
+ * Off Windows every function is a no-op.
+ */
+#ifndef PS3RECOMP_HOST_SCHED_H
+#define PS3RECOMP_HOST_SCHED_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum host_sched_role {
+    HS_ROLE_PPU = 0,     /* a guest PPU thread: policy from its guest priority */
+    HS_ROLE_MAIN,        /* the guest's primary PPU thread (runs the frame)    */
+    HS_ROLE_TICKER,      /* vblank clock + FIFO drain + present (boot_main)    */
+    HS_ROLE_SPU,         /* a raw/lifted SPU thread (Tekken: the sound core)   */
+    HS_ROLE_SPURS,       /* SPURS job-chain walker and job-list workers        */
+    HS_ROLE_AUDIO,       /* cellAudio mixer / WASAPI feeder                    */
+    HS_ROLE_DECODER,     /* cellAdec / cellVdec / cellDmux workers             */
+    HS_ROLE_TIMER,       /* sys_timer threads                                  */
+    HS_ROLE_BACKGROUND,  /* anything else that should never compete           */
+    HS_ROLE_COUNT
+};
+
+/* Process-wide settings. Called once from main(); later calls are no-ops. */
+void host_sched_process_init(void);
+
+/* Called by a thread on itself, first thing after it starts. guest_prio is the
+ * lv2 priority for HS_ROLE_PPU / HS_ROLE_MAIN (0 = highest .. 3071), ignored
+ * otherwise. name names the host thread (debuggers, profilers, the trace). */
+void host_sched_thread_start(int role, int guest_prio, const char* name);
+
+/* Was the stock "guest prio < 256 -> ABOVE_NORMAL" boost for PPU threads. */
+int host_sched_enabled(void);
+
+/* Sleep `usec` (>= 1000) on a cached high-resolution waitable timer. Returns 0
+ * when the policy is off or the timer is unavailable (caller falls back). */
+int host_sched_sleep_us(uint64_t usec);
+/* A sub-millisecond usleep (PS3_SCHED_SUBMS=pause|timer); 0 = caller spins. */
+int host_sched_sleep_subms(uint64_t usec);
+
+/* Spin budget (QPC ticks) a blocking lv2 wait may poll before it parks; 0 =
+ * park at once. */
+int64_t host_sched_spin_ticks(void);
+
+/* ---- event trace (PS3_SCHED_TRACE=<file>) ---------------------------------- */
+enum host_sched_ev {
+    HS_EV_SEM_WAIT0 = 1,  /* arg = sem id: about to block / poll               */
+    HS_EV_SEM_WAIT1,      /* arg = sem id: wait returned with a token          */
+    HS_EV_SEM_POST,       /* arg = sem id                                      */
+    HS_EV_USLEEP0,        /* arg = usec                                        */
+    HS_EV_USLEEP1,        /* arg = usec                                        */
+    HS_EV_VBLANK,         /* arg = vblank count (ticker)                       */
+    HS_EV_PUMP_VB0,       /* vblank handler delivery begins (any thread)       */
+    HS_EV_PUMP_VB1,       /* ... ends                                          */
+    HS_EV_FLIP_DONE,      /* flip status -> DONE (pump)                        */
+    HS_EV_USERCMD,        /* cellGcmSetUserCommand, arg = cause                */
+    HS_EV_PRESENT,        /* live-draw frame presented, arg = frame number     */
+    HS_EV_JOBLIST0,       /* SPURS job list begins, arg = job count            */
+    HS_EV_JOBLIST1,       /* ... all jobs done                                 */
+    HS_EV_JC_KICK,        /* job chain run requested, arg = chain slot         */
+    HS_EV_EQ_RECV0,       /* sys_event_queue_receive blocks, arg = queue id    */
+    HS_EV_EQ_RECV1,
+    HS_EV_LWC_WAIT0,      /* lwcond wait, arg = slot                           */
+    HS_EV_LWC_WAIT1,
+    HS_EV_PRESENT0,       /* live-draw present begins (ticker)                 */
+    HS_EV_FIFO0,          /* ticker FIFO drain begins / ends                   */
+    HS_EV_FIFO1,
+    HS_EV_MARK,           /* free-form, arg = caller's tag                     */
+    HS_EV_PUMP_USER,      /* GCM user-command handler delivered, arg = cause    */
+    HS_EV_SC0,            /* main thread enters an lv2 syscall, arg = number    */
+    HS_EV_SC1,
+    HS_EV_HLE0,           /* main thread enters an HLE import, arg = NID        */
+    HS_EV_HLE1
+};
+
+extern int g_host_sched_trace_on;
+void host_sched_trace_(int kind, uint32_t arg);
+#define host_sched_trace(kind, arg) \
+    do { if (g_host_sched_trace_on) host_sched_trace_((kind), (uint32_t)(arg)); } while (0)
+/* Same, attributed to the given guest thread id instead of the current tag. */
+void host_sched_trace_tid(int kind, uint32_t arg, uint32_t tid);
+/* The current thread's trace tag (a PPU thread's guest id). */
+void host_sched_trace_tag(uint32_t tid);
+/* An event stamped with an earlier QueryPerformanceCounter value. */
+void host_sched_trace_at(int kind, uint32_t arg, int64_t qpc);
+void host_sched_trace_tid_at(int kind, uint32_t arg, uint32_t tid, int64_t qpc);
+int64_t host_sched_qpc(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_HOST_SCHED_H */

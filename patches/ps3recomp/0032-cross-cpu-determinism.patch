index 0000000..d85f200
--- /dev/null
+++ b/runtime/ppu/tests/test_fp_det.c
@@ -0,0 +1,225 @@
+/* Checks runtime/ppu/ppu_fp_det.h against the hardware instructions it stands in for
+ * (x64 with FMA3 and SSE4.1 needed to run it). Built for the x86-64 baseline (no
+ * -mfma/-msse4.1), so the header's software paths are the ones under test; the
+ * references use target attributes:
+ *   clang-cl /O2 -I runtime/ppu /clang:-ffp-contract=off runtime/ppu/tests/test_fp_det.c
+ *   test_fp_det [N]   N random cases per test (default 200M; ~2 min plus the
+ *                     exhaustive 2^32-float loops) -- prints PASS or FAIL */
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <string.h>
+#include <math.h>
+#include <immintrin.h>
+#include "ppu_fp_det.h"
+
+void ppu_fp_thread_init(const char* w) { (void)w; }
+void ppu_fp_env_fix(uint32_t s, const char* w) { (void)s; (void)w; }
+uint32_t ppu_fp_env_violations(void) { return 0; }
+
+static uint64_t st = 0x243F6A8885A308D3ull;
+static inline uint64_t rnd(void) { st ^= st << 13; st ^= st >> 7; st ^= st << 17; return st; }
+__attribute__((target("fma"))) static double ref_fma(double a, double b, double c)
+{ return _mm_cvtsd_f64(_mm_fmadd_sd(_mm_set_sd(a), _mm_set_sd(b), _mm_set_sd(c))); }
+__attribute__((target("fma"))) static float ref_fmaf(float a, float b, float c)
+{ return _mm_cvtss_f32(_mm_fmadd_ss(_mm_set_ss(a), _mm_set_ss(b), _mm_set_ss(c))); }
+__attribute__((target("sse4.1"))) static float ref_round(float x, int mode)
+{
+    __m128 v = _mm_set_ss(x);
+    switch (mode) {
+    case 0:  return _mm_cvtss_f32(_mm_round_ss(v, v, _MM_FROUND_TO_NEAREST_INT | _MM_FROUND_NO_EXC));
+    case 1:  return _mm_cvtss_f32(_mm_round_ss(v, v, _MM_FROUND_TO_NEG_INF | _MM_FROUND_NO_EXC));
+    case 2:  return _mm_cvtss_f32(_mm_round_ss(v, v, _MM_FROUND_TO_POS_INF | _MM_FROUND_NO_EXC));
+    default: return _mm_cvtss_f32(_mm_round_ss(v, v, _MM_FROUND_TO_ZERO | _MM_FROUND_NO_EXC));
+    }
+}
+static double d_of(uint64_t u) { double d; memcpy(&d, &u, 8); return d; }
+static uint64_t u_of(double d) { uint64_t u; memcpy(&u, &d, 8); return u; }
+static int isnan64(uint64_t u) { return (u & 0x7FFFFFFFFFFFFFFFull) > 0x7FF0000000000000ull; }
+static int isnan32(uint32_t u) { return (u & 0x7FFFFFFFu) > 0x7F800000u; }
+/* random double: any bits, or exponent around e0 */
+static double gd(int kind, int e0, int spread)
+{
+    uint64_t r = rnd();
+    if (kind == 0) return d_of(r);
+    int e = e0 + (int)(rnd() % (2 * spread + 1)) - spread;
+    if (e < 0) e = 0;
+    if (e > 2046) e = 2046;
+    if ((rnd() & 15) == 0) r &= ~((1ull << (rnd() % 52)) - 1);   /* short significands: ties, exact results */
+    return d_of((r & 0x800FFFFFFFFFFFFFull) | ((uint64_t)e << 52));
+}
+static float gf(int kind, int e0, int spread)
+{
+    uint32_t r = (uint32_t)rnd();
+    if (kind == 0) { memcpy(&r, &r, 4); float f; memcpy(&f, &r, 4); return f; }
+    int e = e0 + (int)(rnd() % (2 * spread + 1)) - spread;
+    if (e < 0) e = 0;
+    if (e > 254) e = 254;
+    if ((rnd() & 15) == 0) r &= ~((1u << (rnd() % 23)) - 1);
+    r = (r & 0x807FFFFFu) | ((uint32_t)e << 23);
+    float f; memcpy(&f, &r, 4); return f;
+}
+
+/* the lifter's float->int helpers: before (C library) and after (ppu_fp_det.h) */
+static uint32_t old_f2i32(double v, int rn) { if (v != v) return 0x80000000u; double r = rn ? nearbyint(v) : trunc(v);
+    if (r >= 2147483647.0) return 0x7FFFFFFFu; if (r <= -2147483648.0) return 0x80000000u; return (uint32_t)(int32_t)r; }
+static uint64_t old_f2i64(double v, int rn) { if (v != v) return 0x8000000000000000ULL; double r = rn ? nearbyint(v) : trunc(v);
+    if (r >= 9223372036854775807.0) return 0x7FFFFFFFFFFFFFFFULL; if (r <= -9223372036854775808.0) return 0x8000000000000000ULL; return (uint64_t)(int64_t)r; }
+static uint32_t new_f2i32(double v, int rn) { if (v != v) return 0x80000000u; if (v >= 2147483647.0) return 0x7FFFFFFFu;
+    if (v <= -2147483648.0) return 0x80000000u; return (uint32_t)ppu_cvt_i32(v, rn); }
+static uint64_t new_f2i64(double v, int rn) { if (v != v) return 0x8000000000000000ULL; if (v >= 9223372036854775807.0) return 0x7FFFFFFFFFFFFFFFULL;
+    if (v <= -9223372036854775808.0) return 0x8000000000000000ULL; return (uint64_t)ppu_cvt_i64(v, rn); }
+
+int main(int argc, char** argv)
+{
+    long n = argc > 1 ? atol(argv[1]) : 200000000L;
+    int fails = 0;
+    printf("cpu has FMA3: %d\n", ppu_fp_cpu_fma());
+
+    /* 1. double fma: soft path and the dispatched hardware path against vfmadd */
+    long bad = 0, badhw = 0, nanonly = 0;
+    for (long i = 0; i < n; i++) {
+        double a, b, c;
+        switch (i % 8) {
+        case 0: a = gd(0, 0, 0); b = gd(0, 0, 0); c = gd(0, 0, 0); break;
+        case 1: a = gd(1, 1023, 40); b = gd(1, 1023, 40); c = gd(1, 1023, 80); break;
+        case 2: a = gd(1, 1023, 3); b = gd(1, 1023, 3); c = -a * b; if (rnd() & 1) c = d_of(u_of(c) + (rnd() % 5) - 2); break;
+        case 3: a = gd(1, 520, 30); b = gd(1, 520, 30); c = gd(1, 30, 60); break;            /* products near the subnormal range */
+        case 4: a = gd(1, 10, 10); b = gd(1, 1023, 60); c = gd(1, 0, 3); break;              /* subnormal operands */
+        case 5: a = gd(1, 1535, 20); b = gd(1, 1535, 20); c = gd(1, 2046, 2); break;         /* overflow region */
+        case 6: a = gd(1, 1023, 30); b = gd(1, 1023, 30); c = gd(1, 1023 - 60 + (int)(rnd() % 120), 0); break;
+        default: { int e = (int)(rnd() % 2047); a = gd(1, e, 0); b = gd(1, 2046 - e + (int)(rnd() % 60) - 30, 0); c = gd(1, (int)(rnd() % 2047), 0); }
+        }
+        const uint64_t r0 = u_of(ref_fma(a, b, c)), r1 = u_of(ppu_fma_soft(a, b, c)), r2 = u_of(ppu_fma_det(a, b, c));
+        if (r0 != r1) {
+            if (isnan64(r0) && isnan64(r1)) nanonly++;
+            else if (bad++ < 5) printf("  fma_soft(%a, %a, %a) = %a, vfmadd %a\n", a, b, c, d_of(r1), d_of(r0));
+        }
+        if (r0 != r2 && !(isnan64(r0) && isnan64(r2)) && badhw++ < 5) printf("  fma_det(%a, %a, %a) = %a, vfmadd %a\n", a, b, c, d_of(r2), d_of(r0));
+    }
+    /* special operands */
+    static const double sp[] = { 0.0, -0.0, 1.0, -1.0, INFINITY, -INFINITY, NAN, 0x1p-1074, -0x1p-1074, 0x1p-1022,
+                                 0x1.fffffffffffffp1023, -0x1.fffffffffffffp1023, 0x1p-537, 0x1p512, 0x1.8p-1074, 3.0, 0x1p-1060 };
+    const int ns = (int)(sizeof sp / sizeof sp[0]);
+    for (int i = 0; i < ns; i++) for (int j = 0; j < ns; j++) for (int k = 0; k < ns; k++) {
+        const uint64_t r0 = u_of(ref_fma(sp[i], sp[j], sp[k])), r1 = u_of(ppu_fma_soft(sp[i], sp[j], sp[k]));
+        if (r0 != r1 && !(isnan64(r0) && isnan64(r1)) && bad++ < 10) printf("  fma_soft(%a, %a, %a) = %a, vfmadd %a\n", sp[i], sp[j], sp[k], d_of(r1), d_of(r0));
+    }
+    printf("fma (double): %ld random + %d special cases: soft %ld differ (%ld NaN payload only), dispatched %ld differ\n",
+           n, ns * ns * ns, bad, nanonly, badhw);
+    fails += bad != 0 || badhw != 0;
+
+    /* 2. single fma: round-to-odd in double against vfmadd213ss */
+    bad = nanonly = 0;
+    for (long i = 0; i < n; i++) {
+        float a, b, c;
+        switch (i % 6) {
+        case 0: a = gf(0, 0, 0); b = gf(0, 0, 0); c = gf(0, 0, 0); break;
+        case 1: a = gf(1, 127, 20); b = gf(1, 127, 20); c = gf(1, 127, 50); break;
+        case 2: a = gf(1, 127, 3); b = gf(1, 127, 3); c = -(float)((double)a * b); if (rnd() & 1) { uint32_t u; memcpy(&u, &c, 4); u += (uint32_t)(rnd() % 5) - 2; memcpy(&c, &u, 4); } break;
+        case 3: a = gf(1, 50, 20); b = gf(1, 50, 20); c = gf(1, 2, 10); break;
+        case 4: a = gf(1, 190, 10); b = gf(1, 190, 10); c = gf(1, 254, 1); break;
+        default: a = gf(1, 127, 12); b = gf(1, 127, 12); c = gf(1, 127 + (int)(rnd() % 60) - 30, 0); break;
+        }
+        uint32_t r0, r1;
+        float f0 = ref_fmaf(a, b, c), f1 = ppu_fmaf_soft(a, b, c);
+        memcpy(&r0, &f0, 4); memcpy(&r1, &f1, 4);
+        if (r0 != r1) {
+            if (isnan32(r0) && isnan32(r1)) nanonly++;
+            else if (bad++ < 5) printf("  fmaf_soft(%a, %a, %a) = %a, vfmadd %a\n", a, b, c, f1, f0);
+        }
+    }
+    printf("fmaf (single): %ld random cases: soft %ld differ (%ld NaN payload only)\n", n, bad, nanonly);
+    fails += bad != 0;
+
+    /* 3. round to integral, all 2^32 floats, four modes: SSE2 path against roundss */
+    for (int mode = 0; mode < 4; mode++) {
+        bad = 0;
+        uint32_t u = 0;
+        do {
+            float x; memcpy(&x, &u, 4);
+            float a = ref_round(x, mode), b = ppu_roundf_det(x, mode);
+            uint32_t ua, ub; memcpy(&ua, &a, 4); memcpy(&ub, &b, 4);
+            if (ua != ub && bad++ < 3) printf("  round mode %d (%a) = %a, roundss %a\n", mode, x, b, a);
+        } while (++u);
+        printf("round mode %d: all 2^32 floats, %ld differ\n", mode, bad);
+        fails += bad != 0;
+    }
+
+    /* 4. power-of-two scaling against ldexpf, conversions against the C library */
+    bad = 0;
+    for (long i = 0; i < n / 10; i++) {
+        float x = gf((int)(i & 1), 127, 120);
+        int e = (int)(rnd() % 63) - 31;

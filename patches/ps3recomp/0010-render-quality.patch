+
+#define LD_SYNC_INTERVAL (g_ldp.vsync ? 1u : 0u)
+#define LD_PRESENT_FLAGS \
+    ((!g_ldp.vsync && g_ldp.tearing && !g_ldp.fs_exclusive) ? DXGI_PRESENT_ALLOW_TEARING : 0u)
+
+static void ld_display_config(void)
+{
+    const char* e = getenv("PS3_RES_SCALE");
+    float s = 1.0f;
+    if (e && e[0]) {
+        s = (float)atof(e);
+        if (s >= 240.0f) s /= 720.0f;          /* 1080 / 1440 / 2160 */
+        if (!(s >= 1.0f)) s = 1.0f;
+        if (s > 4.0f) s = 4.0f;
+    }
+    g_ld_res_scale = s;
+    e = getenv("PS3_VSYNC");
+    g_ldp.vsync = !(e && e[0] == '0');
+    e = getenv("PS3_FULLSCREEN");
+    g_ldp.exclusive_cfg = e && (_stricmp(e, "exclusive") == 0 || strcmp(e, "2") == 0);
+    if (g_ldp.exclusive_cfg && !getenv("PS3_WINDOW_BACKGROUND"))
+        g_ldp.fs_request = 1;
+    e = getenv("PS3_PRESENT_FILTER");
+    g_ldp.filter_point = e && _stricmp(e, "point") == 0;
+    /* Tearing (vsync off in a window) needs DXGI 1.5 and OS support. */
+    IDXGIFactory5* f5 = NULL;
+    if (SUCCEEDED(CreateDXGIFactory1(&IID_IDXGIFactory5, (void**)&f5)) && f5) {
+        BOOL allow = FALSE;
+        if (SUCCEEDED(f5->lpVtbl->CheckFeatureSupport(
+                f5, DXGI_FEATURE_PRESENT_ALLOW_TEARING, &allow, sizeof(allow))))
+            g_ldp.tearing = allow ? 1 : 0;
+        f5->lpVtbl->Release(f5);
+    }
+    g_ldp.swap_flags = g_ldp.tearing ? DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING : 0;
+    fprintf(stderr, "[display] res_scale=%.3g vsync=%d tearing=%d fullscreen=%s filter=%s\n",
+            (double)g_ld_res_scale, g_ldp.vsync, g_ldp.tearing,
+            g_ldp.exclusive_cfg ? "exclusive" : "borderless", g_ldp.filter_point ? "point" : "linear");
+}
+
+/* Initial swap-chain size: the window's client area (the window may already
+ * be larger than the guest output), else the guest size. */
+static void ld_display_client_size(HWND hwnd, u32 fallback_w, u32 fallback_h, u32* w, u32* h)
+{
+    RECT rc;
+    *w = fallback_w; *h = fallback_h;
+    if (hwnd && !IsIconic(hwnd) && GetClientRect(hwnd, &rc) &&
+        rc.right > rc.left && rc.bottom > rc.top) {
+        *w = (u32)(rc.right - rc.left);
+        *h = (u32)(rc.bottom - rc.top);
+    }
+}
+
+static int ld_display_pipeline(void)
+{
+    static const char vs_src[] =
+        "void main(uint id : SV_VertexID, out float4 pos : SV_Position,\n"
+        "          out float2 uv : TEXCOORD0) {\n"
+        "    uv = float2((id << 1) & 2, id & 2);\n"
+        "    pos = float4(uv * float2(2, -2) + float2(-1, 1), 0, 1);\n"
+        "}\n";
+    static const char ps_src[] =
+        "Texture2D src : register(t0);\n"
+        "SamplerState smp : register(s0);\n"
+        "float4 main(float4 pos : SV_Position, float2 uv : TEXCOORD0) : SV_Target {\n"
+        "    return float4(src.SampleLevel(smp, uv, 0).rgb, 1.0);\n"
+        "}\n";
+    ID3DBlob *vs = NULL, *ps = NULL, *err = NULL;
+    if (FAILED(D3DCompile(vs_src, sizeof(vs_src) - 1, "present_vs", NULL, NULL, "main",
+                          "vs_5_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &vs, &err)) ||
+        FAILED(D3DCompile(ps_src, sizeof(ps_src) - 1, "present_ps", NULL, NULL, "main",
+                          "ps_5_0", D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &ps, &err))) {
+        fprintf(stderr, "[display] present shader compile failed: %s\n",
+                err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "?");
+        if (err) err->lpVtbl->Release(err);
+        if (vs) vs->lpVtbl->Release(vs);
+        return -1;
+    }
+    D3D12_DESCRIPTOR_RANGE range = {0};
+    range.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+    range.NumDescriptors = 1;
+    D3D12_ROOT_PARAMETER param = {0};
+    param.ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    param.DescriptorTable.NumDescriptorRanges = 1;
+    param.DescriptorTable.pDescriptorRanges = &range;
+    param.ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    D3D12_STATIC_SAMPLER_DESC smp = {0};
+    smp.Filter = g_ldp.filter_point ? D3D12_FILTER_MIN_MAG_MIP_POINT
+                                    : D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+    smp.AddressU = smp.AddressV = smp.AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    smp.MaxLOD = D3D12_FLOAT32_MAX;
+    smp.ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    D3D12_ROOT_SIGNATURE_DESC rsd = {0};
+    rsd.NumParameters = 1; rsd.pParameters = &param;
+    rsd.NumStaticSamplers = 1; rsd.pStaticSamplers = &smp;
+    ID3DBlob* sig = NULL;
+    HRESULT hr = D3D12SerializeRootSignature(&rsd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err);
+    if (SUCCEEDED(hr)) {
+        hr = g.dev->lpVtbl->CreateRootSignature(g.dev, 0, sig->lpVtbl->GetBufferPointer(sig),
+                                                sig->lpVtbl->GetBufferSize(sig),
+                                                &IID_ID3D12RootSignature, (void**)&g_ldp.rootsig);
+        sig->lpVtbl->Release(sig);
+    }
+    if (err) err->lpVtbl->Release(err);
+    if (SUCCEEDED(hr)) {
+        D3D12_GRAPHICS_PIPELINE_STATE_DESC pd = {0};
+        pd.pRootSignature = g_ldp.rootsig;
+        pd.VS.pShaderBytecode = vs->lpVtbl->GetBufferPointer(vs);
+        pd.VS.BytecodeLength = vs->lpVtbl->GetBufferSize(vs);
+        pd.PS.pShaderBytecode = ps->lpVtbl->GetBufferPointer(ps);
+        pd.PS.BytecodeLength = ps->lpVtbl->GetBufferSize(ps);
+        pd.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+        pd.SampleMask = 0xFFFFFFFFu;
+        pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+        pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+        pd.RasterizerState.DepthClipEnable = TRUE;
+        pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+        pd.NumRenderTargets = 1;
+        pd.RTVFormats[0] = DXGI_FORMAT_R8G8B8A8_UNORM;
+        pd.SampleDesc.Count = 1;
+        hr = g.dev->lpVtbl->CreateGraphicsPipelineState(g.dev, &pd, &IID_ID3D12PipelineState,
+                                                        (void**)&g_ldp.pso);
+    }
+    vs->lpVtbl->Release(vs);
+    ps->lpVtbl->Release(ps);
+    if (SUCCEEDED(hr)) {
+        D3D12_DESCRIPTOR_HEAP_DESC hd = {0};
+        hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+        hd.NumDescriptors = LD_SWAP_BUFFERS;
+        hd.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+        hr = g.dev->lpVtbl->CreateDescriptorHeap(g.dev, &hd, &IID_ID3D12DescriptorHeap,
+                                                 (void**)&g_ldp.heap);
+        g_ldp.heap_step = g.dev->lpVtbl->GetDescriptorHandleIncrementSize(
+            g.dev, D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    }
+    if (FAILED(hr)) {
+        fprintf(stderr, "[display] present pipeline failed hr=0x%08lX; unscaled copy only\n",
+                (unsigned long)hr);
+        if (g_ldp.pso) { g_ldp.pso->lpVtbl->Release(g_ldp.pso); g_ldp.pso = NULL; }
+        return -1;
+    }
+    return 0;
+}
+
+/* Called at the end of rsx_live_draw_init. */
+static void ld_display_init(HWND hwnd, u32 bb_w, u32 bb_h)
+{
+    g_ldp.hwnd = hwnd;
+    g_ldp.bb_w = bb_w;
+    g_ldp.bb_h = bb_h;
+    /* The window handles Alt+Enter itself (borderless, or a request for
+     * exclusive mode that the present thread carries out). */
+    IDXGIFactory4* f = NULL;
+    if (SUCCEEDED(g.swap->lpVtbl->GetParent(g.swap, &IID_IDXGIFactory4, (void**)&f)) && f) {
+        f->lpVtbl->MakeWindowAssociation(f, hwnd, DXGI_MWA_NO_ALT_ENTER);
+        LUID luid;
+        IDXGIAdapter1* ad = NULL;
+        g.dev->lpVtbl->GetAdapterLuid(g.dev, &luid);
+        if (SUCCEEDED(f->lpVtbl->EnumAdapterByLuid(f, luid, &IID_IDXGIAdapter1, (void**)&ad)) && ad) {
+            DXGI_ADAPTER_DESC1 d;
+            if (SUCCEEDED(ad->lpVtbl->GetDesc1(ad, &d)))
+                fprintf(stderr, "[display] adapter: %ls (%llu MB)\n", d.Description,
+                        (unsigned long long)(d.DedicatedVideoMemory >> 20));
+            ad->lpVtbl->Release(ad);
+        }
+        f->lpVtbl->Release(f);
+    }
+    ld_display_pipeline();
+}
+
+/* Present thread, before the backbuffer is chosen: carry out a pending
+ * exclusive-fullscreen switch and follow the window's client size. */
+static void ld_display_sync(void)
+{
+    if (!g_ldp.hwnd || !g.swap) return;
+    const LONG req = InterlockedExchange(&g_ldp.fs_request, -1);
+    int force = 0;
+    if (req >= 0 && req != g_ldp.fs_exclusive) {
+        ld_flush(LD_FLUSH_READBACK);
+        const HRESULT hr = g.swap->lpVtbl->SetFullscreenState(g.swap, req ? TRUE : FALSE, NULL);
+        fprintf(stderr, "[display] exclusive fullscreen %s hr=0x%08lX\n",
+                req ? "on" : "off", (unsigned long)hr);
+        if (SUCCEEDED(hr)) { g_ldp.fs_exclusive = (int)req; force = 1; }
+    }
+    u32 cw, ch;
+    ld_display_client_size(g_ldp.hwnd, g_ldp.bb_w, g_ldp.bb_h, &cw, &ch);
+    if (!force && cw == g_ldp.bb_w && ch == g_ldp.bb_h) return;
+    ld_flush(LD_FLUSH_READBACK);              /* nothing may still use the buffers */
+    for (u32 i = 0; i < LD_SWAP_BUFFERS; i++)
+        if (g.backbuf[i]) { g.backbuf[i]->lpVtbl->Release(g.backbuf[i]); g.backbuf[i] = NULL; }
+    const HRESULT hr = g.swap->lpVtbl->ResizeBuffers(
+        g.swap, LD_SWAP_BUFFERS, cw, ch, DXGI_FORMAT_R8G8B8A8_UNORM, g_ldp.swap_flags);
+    if (SUCCEEDED(hr)) { g_ldp.bb_w = cw; g_ldp.bb_h = ch; }
+    for (u32 i = 0; i < LD_SWAP_BUFFERS; i++) {
+        g.swap->lpVtbl->GetBuffer(g.swap, i, &IID_ID3D12Resource, (void**)&g.backbuf[i]);
+        g.dev->lpVtbl->CreateRenderTargetView(g.dev, g.backbuf[i], NULL, rtv_handle(i));
+    }
+    fprintf(stderr, "[display] swap chain %ux%u (hr=0x%08lX)\n", g_ldp.bb_w, g_ldp.bb_h,
+            (unsigned long)hr);
+}
+
+/* Replaces the present's CopyResource(bb, src). Same contract: src is in
+ * COPY_SOURCE, bb in COPY_DEST, and both are left that way. When the sizes
+ * match this IS that copy; otherwise src is drawn scaled into the backbuffer,
+ * aspect kept (aw:ah, the guest's display size) with black bars. */
+static void ld_present_copy(ID3D12Resource* bb, u32 bbi, ID3D12Resource* src, u32 aw, u32 ah)
+{
+    D3D12_RESOURCE_DESC sd, bd;
+    src->lpVtbl->GetDesc(src, &sd);
+    bb->lpVtbl->GetDesc(bb, &bd);
+    if (!g_ldp.pso || !g_ldp.heap || !aw || !ah ||
+        (sd.Width == bd.Width && sd.Height == bd.Height && sd.Format == bd.Format)) {
+        g.list->lpVtbl->CopyResource(g.list, bb, src);
+        return;
+    }
+    const float bw = (float)bd.Width, bh = (float)bd.Height;
+    const float k = bw / (float)aw < bh / (float)ah ? bw / (float)aw : bh / (float)ah;
+    const float vw = (float)aw * k, vh = (float)ah * k;
+    D3D12_VIEWPORT vp = { (float)(LONG)((bw - vw) * 0.5f), (float)(LONG)((bh - vh) * 0.5f),
+                          vw, vh, 0.0f, 1.0f };
+    D3D12_RECT sc = { (LONG)vp.TopLeftX, (LONG)vp.TopLeftY,
+                      (LONG)(vp.TopLeftX + vw + 0.5f), (LONG)(vp.TopLeftY + vh + 0.5f) };
+    D3D12_RESOURCE_BARRIER b[2] = {0};
+    for (int i = 0; i < 2; i++) {
+        b[i].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        b[i].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    }
+    b[0].Transition.pResource = src;
+    b[0].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    b[0].Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    b[1].Transition.pResource = bb;
+    b[1].Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_DEST;
+    b[1].Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    g.list->lpVtbl->ResourceBarrier(g.list, 2, b);
+
+    D3D12_CPU_DESCRIPTOR_HANDLE cpu;
+    D3D12_GPU_DESCRIPTOR_HANDLE gpu;
+    g_ldp.heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(g_ldp.heap, &cpu);
+    g_ldp.heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(g_ldp.heap, &gpu);
+    cpu.ptr += (SIZE_T)bbi * g_ldp.heap_step;
+    gpu.ptr += (UINT64)bbi * g_ldp.heap_step;
+    D3D12_SHADER_RESOURCE_VIEW_DESC srv = {0};
+    srv.Format = sd.Format;
+    srv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    srv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    srv.Texture2D.MipLevels = 1;
+    g.dev->lpVtbl->CreateShaderResourceView(g.dev, src, &srv, cpu);
+
+    const D3D12_CPU_DESCRIPTOR_HANDLE rtv = rtv_handle(bbi);
+    if (vw + 0.5f < bw || vh + 0.5f < bh) {
+        static const float black[4] = { 0, 0, 0, 1 };
+        g.list->lpVtbl->ClearRenderTargetView(g.list, rtv, black, 0, NULL);
+    }
+    g.list->lpVtbl->OMSetRenderTargets(g.list, 1, &rtv, FALSE, NULL);
+    g.list->lpVtbl->SetDescriptorHeaps(g.list, 1, &g_ldp.heap);
+    g.list->lpVtbl->SetGraphicsRootSignature(g.list, g_ldp.rootsig);
+    g.list->lpVtbl->SetGraphicsRootDescriptorTable(g.list, 0, gpu);
+    g.list->lpVtbl->SetPipelineState(g.list, g_ldp.pso);
+    g.list->lpVtbl->RSSetViewports(g.list, 1, &vp);
+    g.list->lpVtbl->RSSetScissorRects(g.list, 1, &sc);
+    g.list->lpVtbl->IASetPrimitiveTopology(g.list, D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    g.list->lpVtbl->DrawInstanced(g.list, 3, 1, 0, 0);
+
+    for (int i = 0; i < 2; i++) {
+        const D3D12_RESOURCE_STATES t = b[i].Transition.StateBefore;
+        b[i].Transition.StateBefore = b[i].Transition.StateAfter;
+        b[i].Transition.StateAfter = t;
+    }
+    g.list->lpVtbl->ResourceBarrier(g.list, 2, b);
+}

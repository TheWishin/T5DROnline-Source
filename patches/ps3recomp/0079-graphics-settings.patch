+        return 0;
+    rsx_dsp_surface sf;
+    rsx_dsp_get_surface(&g.rsx, &sf);
+    if (sf.clip_w < g.width || sf.clip_h < g.height) return 0;
+    for (u32 b = 0; b < 8; b++) {
+        const display_buffer_t* d = &g.display_buffers[b];
+        if (d->valid && d->location == sf.color_location[0] && d->offset == sf.color_offset[0]) return 0;
+    }
+    return 1;
+}

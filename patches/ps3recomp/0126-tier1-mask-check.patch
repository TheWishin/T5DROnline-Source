+/* Patch 0126, RSX_FP_TEX_MASK_CHECK=1 (tests): every fragment program's texture mask
+ * (rsx_fp_texture_mask: the units patch 0081's tier-1 path binds) checked against the final HLSL of its PSO
+ * (after the alpha-test, unnormalised, shadow-compare and single-tap rewrites): a texture of a unit
+ * outside the mask named anywhere but in its declaration is a read the path would leave white.
+ * [fp-texmask] lines count the programs and name any such unit. */
+static void ld_fp_tex_mask_check(const u8* uc, u32 size, const char* hlsl)
+{
+    static int on = -1;
+    static volatile LONG64 checked, bad;
+    if (on < 0) { const char* e = getenv("RSX_FP_TEX_MASK_CHECK"); on = e && *e == '1'; }
+    if (!on || !uc || !hlsl) return;
+    const u32 mask = rsx_fp_texture_mask(uc, size);
+    u32 outside = 0;
+    for (u32 u = 0; u < 16; u++) {
+        if ((mask >> u) & 1u) continue;
+        char arr[24], one[24];
+        snprintf(arr, sizeof arr, "rsx_tex[%u]", u);
+        snprintf(one, sizeof one, "rsx_tex%u", u);
+        if (strstr(hlsl, arr)) outside |= 1u << u;
+        for (const char* p = strstr(hlsl, one); p; p = strstr(p + 1, one)) {
+            const char c = p[strlen(one)];
+            if (c >= '0' && c <= '9') continue;                  /* rsx_tex1 in rsx_tex12 */
+            if (!strncmp(p + strlen(one), " : register", 11)) continue;   /* its declaration */
+            outside |= 1u << u;
+            break;
+        }
+    }
+    const LONG64 n = InterlockedIncrement64(&checked);
+    if (outside) InterlockedIncrement64(&bad);
+    if (outside || n == 1 || (n % 10) == 0)
+        fprintf(stderr, "[fp-texmask] check: %lld program(s), %lld with a texture read outside the mask%s "
+                        "(this one: %u bytes, mask 0x%04X%s0x%04X)\n", (long long)n, (long long)bad,
+                outside ? " -- WRONG" : "", size, mask, outside ? ", read outside " : ", outside ",
+                outside);
+}

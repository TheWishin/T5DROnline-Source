+#if defined(SPU_NEAR_FLOAT) && defined(__SSE4_1__) && !defined(__ARM_NEON)
+/* the patch 0041 forms (as in tests/test_spu_near_float_sse.c) */
+SPU__SX_INLINE __m128i sc_old_be(__m128i x) { return _mm_and_si128(_mm_srli_epi32(x, 23), _mm_set1_epi32(0xFF)); }
+SPU__SX_INLINE __m128 sc_old_daz(__m128i x) {
+    return _mm_castsi128_ps(_mm_andnot_si128(_mm_cmpeq_epi32(sc_old_be(x), _mm_setzero_si128()), x));
+}
+SPU__SX_INLINE __m128i sc_old_ext(__m128i x) { return _mm_cmpeq_epi32(sc_old_be(x), _mm_set1_epi32(255)); }
+SPU__SX_INLINE __m128i sc_old_out(__m128 r, int* bad) {
+    const __m128i ri = _mm_castps_si128(r), be = sc_old_be(ri);
+    const __m128i ext = _mm_cmpeq_epi32(be, _mm_set1_epi32(255));
+    *bad = !_mm_testz_si128(ext, ext);
+    return _mm_andnot_si128(_mm_cmpeq_epi32(be, _mm_setzero_si128()), ri);
+}
+static inline u128 sc_old_fa(u128 a, u128 b, uint32_t negb) {
+    const __m128i x = spu__sx_ld(a), y = _mm_xor_si128(spu__sx_ld(b), _mm_set1_epi32((int)negb));
+    const __m128i e = _mm_or_si128(sc_old_ext(x), sc_old_ext(y));
+    if (_mm_testz_si128(e, e)) {
+        int bad;
+        const __m128i r = sc_old_out(_mm_add_ps(sc_old_daz(x), sc_old_daz(y)), &bad);
+        if (!bad) return spu__sx_st(r);
+    }
+    return spu__sx_fa(a, b, negb);
+}
+static inline u128 sc_old_fm(u128 a, u128 b) {
+    const __m128i x = spu__sx_ld(a), y = spu__sx_ld(b);
+    const __m128i e = _mm_or_si128(sc_old_ext(x), sc_old_ext(y));
+    if (_mm_testz_si128(e, e)) {
+        int bad;
+        const __m128i r = sc_old_out(_mm_mul_ps(sc_old_daz(x), sc_old_daz(y)), &bad);
+        if (!bad) return spu__sx_st(r);
+    }
+    return spu__sx_fm(a, b);
+}
+static inline u128 sc_old_fma(u128 a, u128 b, u128 c, uint32_t negp, uint32_t negc) {
+    const __m128i x = _mm_xor_si128(spu__sx_ld(a), _mm_set1_epi32((int)negp)), y = spu__sx_ld(b);
+    const __m128i z = _mm_xor_si128(spu__sx_ld(c), _mm_set1_epi32((int)negc));
+    const __m128i e = _mm_or_si128(_mm_or_si128(sc_old_ext(x), sc_old_ext(y)), sc_old_ext(z));
+    if (_mm_testz_si128(e, e)) {
+        int bad;
+        const __m128 p = _mm_mul_ps(sc_old_daz(x), sc_old_daz(y));
+        const __m128i r = sc_old_out(_mm_add_ps(p, sc_old_daz(z)), &bad);
+        if (!bad) return spu__sx_st(r);
+    }
+    return spu__sx_fma(a, b, c, negp, negc);
+}
+static inline u128 spu_sc_fa(u128 a, u128 b)  { return spu_sc(21, spu_fa(a, b), sc_old_fa(a, b, 0)); }
+static inline u128 spu_sc_fs(u128 a, u128 b)  { return spu_sc(22, spu_fs(a, b), sc_old_fa(a, b, 0x80000000u)); }
+static inline u128 spu_sc_fm(u128 a, u128 b)  { return spu_sc(23, spu_fm(a, b), sc_old_fm(a, b)); }
+static inline u128 spu_sc_fma(u128 a, u128 b, u128 c)  { return spu_sc(24, spu_fma(a, b, c), sc_old_fma(a, b, c, 0, 0)); }
+static inline u128 spu_sc_fms(u128 a, u128 b, u128 c)  { return spu_sc(25, spu_fms(a, b, c), sc_old_fma(a, b, c, 0, 0x80000000u)); }
+static inline u128 spu_sc_fnms(u128 a, u128 b, u128 c) { return spu_sc(26, spu_fnms(a, b, c), sc_old_fma(a, b, c, 0x80000000u, 0)); }
+#define spu_fa   spu_sc_fa
+#define spu_fs   spu_sc_fs
+#define spu_fm   spu_sc_fm
+#define spu_fma  spu_sc_fma
+#define spu_fms  spu_sc_fms
+#define spu_fnms spu_sc_fnms
+#endif
+#endif
diff --git a/runtime/spu/tests/test_spu_int_sse.c b/runtime/spu/tests/test_spu_int_sse.c
new file mode 100644
index 0000000..5562464
--- /dev/null
+++ b/runtime/spu/tests/test_spu_int_sse.c
@@ -0,0 +1,103 @@
+/* test_spu_int_sse.c -- the x86 (SSSE3/SSE4.1) byte-permute helpers of spu_helpers.h
+ * (patch 0064) against the scalar reference loops they replace.
+ *
+ * Integer operations, so the check is exact: every shift count / position the
+ * instruction can see (the low bits plus the high bits it must ignore), each with
+ * random register contents, and every selector value of the fsm family.
+ *
+ *   clang-cl -msse4.1 /I runtime/spu runtime/spu/tests/test_spu_int_sse.c && test_spu_int_sse
+ */
+#include "spu_helpers.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#if !defined(SPU_X86_PERM)
+int main(void) { printf("test_spu_int_sse: SPU_X86_PERM off (no SSE4.1): nothing to compare\n"); return 1; }
+#else
+
+static uint64_t s_rng = 0x9E3779B97F4A7C15ull;
+static uint32_t rnd(void)
+{
+    s_rng ^= s_rng << 13; s_rng ^= s_rng >> 7; s_rng ^= s_rng << 17;
+    return (uint32_t)(s_rng >> 16);
+}
+static u128 rnd128(void) { u128 r; for (int i = 0; i < 4; i++) r._u32[i] = rnd(); return r; }
+
+static long s_checks, s_fails;
+static void check(const char* what, long k, u128 got, u128 want)
+{
+    s_checks++;
+    if (!memcmp(&got, &want, 16)) return;
+    if (s_fails++ < 20)
+        printf("FAIL %s case %ld: got %08X %08X %08X %08X want %08X %08X %08X %08X\n", what, k,
+               got._u32[0], got._u32[1], got._u32[2], got._u32[3],
+               want._u32[0], want._u32[1], want._u32[2], want._u32[3]);
+}
+
+/* the shift / position operand: every low byte, with the high bits random or extreme */
+static uint32_t operand(long k)
+{
+    const uint32_t lo = (uint32_t)(k & 0xFF);
+    switch ((k >> 8) & 3) {
+    case 0:  return lo;
+    case 1:  return lo | 0xFFFFFF00u;
+    case 2:  return lo | 0x80000000u;
+    default: return lo | (rnd() & 0xFFFFFF00u);
+    }
+}
+
+int main(void)
+{
+    const long N = 256 * 4 * 64;      /* 64 random registers per operand value */
+    for (long k = 0; k < N; k++) {
+        const u128 a = rnd128();
+        u128 b = rnd128();
+        b._u32[0] = operand(k);
+        const int imm = (int)(int8_t)(uint8_t)k;     /* immediates: -128..127 */
+        check("rotqby",    k, spu_rotqby(a, b),    spu_rotqby_ref(a, b));
+        check("shlqby",    k, spu_shlqby(a, b),    spu_shlqby_ref(a, b));
+        check("rotqbybi",  k, spu_rotqbybi(a, b),  spu_rotqbybi_ref(a, b));
+        check("shlqbybi",  k, spu_shlqbybi(a, b),  spu_shlqbybi_ref(a, b));
+        check("rotqmby",   k, spu_rotqmby(a, b),   spu_rotqmby_ref(a, b));
+        check("rotqmbybi", k, spu_rotqmbybi(a, b), spu_rotqmbybi_ref(a, b));
+        check("rotqbyi",   k, spu_rotqbyi(a, imm),  spu_rotqbyi_ref(a, imm));
+        check("shlqbyi",   k, spu_shlqbyi(a, imm),  spu_shlqbyi_ref(a, imm));
+        check("rotqmbyi",  k, spu_rotqmbyi(a, imm), spu_rotqmbyi_ref(a, imm));
+        /* generate controls: address register + immediate, and two registers */
+        u128 ra = rnd128(); ra._u32[0] = operand(k);
+        u128 rb = rnd128(); rb._u32[0] = rnd();
+        check("cbd", k, spu_cbd(ra, imm), spu_cbd_ref(ra, imm));
+        check("chd", k, spu_chd(ra, imm), spu_chd_ref(ra, imm));
+        check("cwd", k, spu_cwd(ra, imm), spu_cwd_ref(ra, imm));
+        check("cdd", k, spu_cdd(ra, imm), spu_cdd_ref(ra, imm));
+        check("cbx", k, spu_cbx(ra, rb), spu_cbx_ref(ra, rb));
+        check("chx", k, spu_chx(ra, rb), spu_chx_ref(ra, rb));
+        check("cwx", k, spu_cwx(ra, rb), spu_cwx_ref(ra, rb));
+        check("cdx", k, spu_cdx(ra, rb), spu_cdx_ref(ra, rb));
+    }
+    /* shufb: controls without special selectors (the usual case, a branch-free path),
+     * with some, and all random; every selector byte value in every position */
+    for (long k = 0; k < 2000000; k++) {
+        const u128 a = rnd128(), b = rnd128();
+        u128 c = rnd128();
+        const int mode = (int)(k % 4);
+        for (int i = 0; i < 16; i++) {
+            if (mode == 0) c._u8[i] &= 0x1F;
+            else if (mode == 1) c._u8[i] = (uint8_t)((k + i * 17) & 0xFF);
+            else if (mode == 2 && (rnd() & 7)) c._u8[i] &= 0x7F;
+        }
+        check("shufb", k, spu_shufb(a, b, c), spu_shufb_ref(a, b, c));
+    }
+    /* the fsm family: every selector value, with random bits above it */
+    for (long v = 0; v < 65536 * 4; v++) {
+        u128 a = rnd128();
+        a._u32[0] = (uint32_t)(v & 0xFFFF) | ((v >> 16) ? (rnd() & 0xFFFF0000u) : 0);
+        check("fsmb", v, spu_fsmb(a), spu_fsmb_ref(a));
+        check("fsmh", v, spu_fsmh(a), spu_fsmh_ref(a));
+        check("fsm",  v, spu_fsm(a),  spu_fsm_ref(a));
+    }
+    printf("test_spu_int_sse: %ld checks, %ld failures\n", s_checks, s_fails);
+    return s_fails ? 1 : 0;
+}
+#endif
diff --git a/runtime/spu/tests/test_spu_near_float_sse.c b/runtime/spu/tests/test_spu_near_float_sse.c
new file mode 100644
index 0000000..f8aa5bb
--- /dev/null
+++ b/runtime/spu/tests/test_spu_near_float_sse.c
@@ -0,0 +1,150 @@
+/* test_spu_near_float_sse.c -- SPU_NEAR_FLOAT's operations as patch 0064 computes them
+ * against the patch 0041 code they replace, bit for bit.
+ *
+ * The 0041 forms are copied below (old_*). Both must give the same 32 bits in every
+ * lane for every input: the sound core's samples -- and anything the PPU reads back
+ * from it -- must not change by a single bit. The inputs are chosen to hit every
+ * branch: each operand's biased exponent is drawn from the classes that matter
+ * (0 = SPU zero / IEEE denormal, 1, 2, ordinary, 253, 254, 255 = extended range /
+ * IEEE Inf-NaN, with zero and random fractions, both signs), products and sums
+ * that overflow, underflow to denormals or cancel to zero, and whole vectors of
+ * ordinary values.
+ *
+ *   clang-cl /O2 /DSPU_NEAR_FLOAT -msse4.1 /I runtime/spu runtime/spu/tests/test_spu_near_float_sse.c
+ * (and once with -march=x86-64-v3)
+ */
+#include "spu_helpers.h"
+#include <stdio.h>
+#include <string.h>
+
+#if !defined(SPU_NEAR_FLOAT) || defined(__ARM_NEON) || !defined(__SSE4_1__)
+int main(void) { printf("test_spu_near_float_sse: needs SPU_NEAR_FLOAT on x86 with SSE4.1: nothing to compare\n"); return 1; }
+#else
+
+/* ---- the patch 0041 code, verbatim but renamed ---------------------------------- */
+SPU__SX_INLINE __m128i old_be(__m128i x) { return _mm_and_si128(_mm_srli_epi32(x, 23), _mm_set1_epi32(0xFF)); }
+SPU__SX_INLINE __m128 old_daz(__m128i x) {
+    return _mm_castsi128_ps(_mm_andnot_si128(_mm_cmpeq_epi32(old_be(x), _mm_setzero_si128()), x));
+}
+SPU__SX_INLINE __m128i old_ext(__m128i x) { return _mm_cmpeq_epi32(old_be(x), _mm_set1_epi32(255)); }
+SPU__SX_INLINE __m128i old_out(__m128 r, int* bad) {
+    const __m128i ri = _mm_castps_si128(r), be = old_be(ri);
+    const __m128i ext = _mm_cmpeq_epi32(be, _mm_set1_epi32(255));
+    *bad = !_mm_testz_si128(ext, ext);
+    return _mm_andnot_si128(_mm_cmpeq_epi32(be, _mm_setzero_si128()), ri);
+}
+static u128 old_fa_n(u128 a, u128 b, uint32_t negb) {
+    const __m128i x = spu__sx_ld(a), y = _mm_xor_si128(spu__sx_ld(b), _mm_set1_epi32((int)negb));
+    const __m128i e = _mm_or_si128(old_ext(x), old_ext(y));
+    if (_mm_testz_si128(e, e)) {
+        int bad;
+        const __m128i r = old_out(_mm_add_ps(old_daz(x), old_daz(y)), &bad);
+        if (!bad) return spu__sx_st(r);
+    }
+    return spu__sx_fa(a, b, negb);
+}
+static u128 old_fm(u128 a, u128 b) {
+    const __m128i x = spu__sx_ld(a), y = spu__sx_ld(b);
+    const __m128i e = _mm_or_si128(old_ext(x), old_ext(y));
+    if (_mm_testz_si128(e, e)) {
+        int bad;
+        const __m128i r = old_out(_mm_mul_ps(old_daz(x), old_daz(y)), &bad);
+        if (!bad) return spu__sx_st(r);
+    }
+    return spu__sx_fm(a, b);
+}
+static u128 old_fma_n(u128 a, u128 b, u128 c, uint32_t negp, uint32_t negc) {
+    const __m128i x = _mm_xor_si128(spu__sx_ld(a), _mm_set1_epi32((int)negp)), y = spu__sx_ld(b);
+    const __m128i z = _mm_xor_si128(spu__sx_ld(c), _mm_set1_epi32((int)negc));
+    const __m128i e = _mm_or_si128(_mm_or_si128(old_ext(x), old_ext(y)), old_ext(z));
+    if (_mm_testz_si128(e, e)) {
+        int bad;
+        const __m128 p = _mm_mul_ps(old_daz(x), old_daz(y));
+        const __m128i r = old_out(_mm_add_ps(p, old_daz(z)), &bad);
+        if (!bad) return spu__sx_st(r);
+    }
+    return spu__sx_fma(a, b, c, negp, negc);
+}
+/* ---------------------------------------------------------------------------------- */
+
+static uint64_t s_rng = 0x2545F4914F6CDD1Dull;
+static uint32_t rnd(void)
+{
+    s_rng ^= s_rng << 13; s_rng ^= s_rng >> 7; s_rng ^= s_rng << 17;
+    return (uint32_t)(s_rng >> 11);
+}
+/* one SPU single from an exponent class */
+static uint32_t pick(int cls)
+{
+    const uint32_t sign = rnd() & 0x80000000u, r = rnd();
+    uint32_t frac = (r & 3) == 0 ? 0 : (r & 3) == 1 ? 0x7FFFFFu : rnd() & 0x7FFFFFu;
+    uint32_t be;
+    switch (cls) {
+    case 0:  be = 0; break;                          /* SPU zero; IEEE zero or denormal */
+    case 1:  be = 1 + (rnd() & 1); break;            /* smallest normals */
+    case 2:  be = 253 + (rnd() & 1); break;          /* largest normals: products/sums overflow */
+    case 3:  be = 255; break;                        /* extended range: IEEE Inf / NaN */
+    case 4:  be = 60 + rnd() % 15; break;            /* small: products underflow */
+    case 5:  be = 180 + rnd() % 20; break;           /* large: products overflow */
+    default: be = 100 + rnd() % 56; break;           /* ordinary, near 1.0 */
+    }
+    return sign | (be << 23) | frac;
+}
+static u128 vec(int mode)
+{
+    u128 v;
+    for (int i = 0; i < 4; i++) {
+        const int cls = mode == 0 ? 6 : (int)(rnd() % 7);   /* mode 0: all-ordinary vectors */
+        v._u32[i] = pick(cls);
+    }
+    return v;
+}
+
+static long s_checks, s_fails, s_slow;
+static void same(const char* what, u128 got, u128 want, u128 a, u128 b, u128 c)
+{
+    s_checks++;
+    if (!memcmp(&got, &want, 16)) return;
+    if (s_fails++ < 20)
+        printf("FAIL %s: a %08X.. b %08X.. c %08X..: got %08X %08X %08X %08X want %08X %08X %08X %08X\n",
+               what, a._u32[0], b._u32[0], c._u32[0], got._u32[0], got._u32[1], got._u32[2], got._u32[3],
+               want._u32[0], want._u32[1], want._u32[2], want._u32[3]);
+}
+
+int main(void)
+{
+    const long N = 3000000;
+    for (long k = 0; k < N; k++) {
+        const int mode = (int)(k % 3);
+        u128 a = vec(mode), b = vec(mode), c = vec(mode);
+        if (k % 7 == 0) b = a;                                   /* x - x: exact cancellation */
+        if (k % 11 == 0) { for (int i = 0; i < 4; i++) c._u32[i] = a._u32[i] ^ 0x80000000u; }
+        same("fa",   spu_fa(a, b),      old_fa_n(a, b, 0), a, b, c);
+        same("fs",   spu_fs(a, b),      old_fa_n(a, b, 0x80000000u), a, b, c);
+        same("fm",   spu_fm(a, b),      old_fm(a, b), a, b, c);
+        same("fma",  spu_fma(a, b, c),  old_fma_n(a, b, c, 0, 0), a, b, c);
+        same("fms",  spu_fms(a, b, c),  old_fma_n(a, b, c, 0, 0x80000000u), a, b, c);
+        same("fnms", spu_fnms(a, b, c), old_fma_n(a, b, c, 0x80000000u, 0), a, b, c);
+        { int bad; old_out(_mm_add_ps(old_daz(spu__sx_ld(a)), old_daz(spu__sx_ld(b))), &bad); s_slow += bad; }
+    }
+    /* every exponent pair for add and multiply, fractions random: all branches of both */
+    for (int ea = 0; ea < 256; ea++)
+        for (int eb = 0; eb < 256; eb++)
+            for (int rep = 0; rep < 4; rep++) {
+                u128 a, b, c;
+                for (int i = 0; i < 4; i++) {
+                    a._u32[i] = (rnd() & 0x80000000u) | ((uint32_t)ea << 23) | (i == 0 ? 0 : rnd() & 0x7FFFFFu);
+                    b._u32[i] = (rnd() & 0x80000000u) | ((uint32_t)eb << 23) | (i == 1 ? 0 : rnd() & 0x7FFFFFu);
+                    c._u32[i] = pick((int)(rnd() % 7));
+                }
+                same("fa*",  spu_fa(a, b),     old_fa_n(a, b, 0), a, b, c);
+                same("fs*",  spu_fs(a, b),     old_fa_n(a, b, 0x80000000u), a, b, c);
+                same("fm*",  spu_fm(a, b),     old_fm(a, b), a, b, c);
+                same("fma*", spu_fma(a, b, c), old_fma_n(a, b, c, 0, 0), a, b, c);
+                same("fnms*", spu_fnms(a, b, c), old_fma_n(a, b, c, 0x80000000u, 0), a, b, c);
+            }
+    printf("test_spu_near_float_sse: %ld checks (%ld fa vectors on the exact path), %ld failures\n",
+           s_checks, s_slow, s_fails);
+    return s_fails || !s_slow ? 1 : 0;
+}
+#endif
diff --git a/runtime/syscalls/sys_event.c b/runtime/syscalls/sys_event.c
index bb3bb51..7ff0ebd 100644
--- a/runtime/syscalls/sys_event.c
+++ b/runtime/syscalls/sys_event.c
@@ -464,9 +464,14 @@ int64_t sys_event_queue_receive(ppu_context* ctx)
      * ponytail: one attempt per receive, then fall through to the normal wait --
      * no retry loop, so a worker that genuinely produces nothing still blocks
      * rather than spinning. */
+    long long spurs_wait = 0;
     if (q->count == 0 && timeout_us == 0) {
         extern int spu_dispatch_frame_by_queue(uint32_t, uint32_t);
         spu_dispatch_frame_by_queue(queue_id, 0);
+        /* A queue SPURS attached: run jobs of the open job list on this thread
+         * before blocking for them (libs/spurs/cellSpurs.c, patch 0064). */
+        extern long long cellSpurs_queue_wait_help(uint32_t queue_id);
+        if (q->count == 0) spurs_wait = cellSpurs_queue_wait_help(queue_id);
     }
 
 #ifdef _WIN32
@@ -518,6 +523,7 @@ int64_t sys_event_queue_receive(ppu_context* ctx)
     sys_event_t evt = q->buffer[q->head];
     q->head = (q->head + 1) % q->capacity;
     q->count--;
+    if (spurs_wait) { extern void cellSpurs_queue_wait_done(long long); cellSpurs_queue_wait_done(spurs_wait); }
 
     LeaveCriticalSection(&q->lock);
 #else

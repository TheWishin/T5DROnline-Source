+static const char* ld_flash_check_dir(void)
+{
+    static const char* dir = (const char*)-1;
+    if (dir == (const char*)-1) { const char* e = getenv("RSX_FLASH_CHECK"); dir = (e && *e) ? e : NULL; }
+    return dir;

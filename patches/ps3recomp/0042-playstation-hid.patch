+        if (steam_skips(o->vid, o->pid)) {
+            static int said;
+            if (said++ < 4)
+                printf("[pad] HID '%s' %04X:%04X: Steam Input handles this pad -- the game uses Steam's virtual Xbox"
+                       " pad for it ([general] steam_input = 0 reads it directly)\n", o->name, o->vid, o->pid);
+            continue;
+        }
+        HidDev* h = hid_new(o->model, o->vid, o->pid, o->bt, o->in_len, o->name);
+        if (!h) continue;
+        h->h = CreateFileW(o->path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING,
+                           FILE_FLAG_OVERLAPPED, NULL);
+        if (h->h == INVALID_HANDLE_VALUE) {
+            const DWORD e = GetLastError();
+            printf("[pad] HID '%s' %04X:%04X: cannot open it (error %lu%s) -- %s\n", o->name, o->vid, o->pid,
+                   (unsigned long)e,
+                   e == ERROR_ACCESS_DENIED || e == ERROR_SHARING_VIOLATION ? ", another program holds it" : "",
+                   g_cfg.dinput ? "read through DirectInput" : "not read (dinput = 0)");
+            hid_free(h);
+            hid_fail_add(o->path, 3);
+            continue;
+        }
+        HidD_SetNumInputBuffers(h->h, 64);   /* room for reports while the reader is late */
+        hid_add(h, o->path, "read directly");
+    }
+    free(found);
+    fflush(stdout);
+}

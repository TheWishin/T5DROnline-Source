+/* Around every Media Foundation call of the worker (patch 0053): the
+ * watchdog sees how long it takes. mf_leave returns 0 when the worker was
+ * replaced meanwhile -- it then owns nothing in the slot any more. */
+static void mf_enter(Vdec* v, const VdecCmd* c, int gen)
+{
+    lock();
+    v->cur = *c;
+    v->cur.data = NULL;
+    v->cur_gen = gen;
+    v->mf_since = stamp_ms();
+    unlock();
+}
+
+static int mf_leave(Vdec* v, unsigned epoch)
+{
+    lock();
+    const int mine = v->epoch == epoch;
+    if (mine) v->mf_since = 0;
+    unlock();
+    return mine;
+}
+
+/* A replaced worker came back from Media Foundation: free what it holds, end. */
+static DWORD retire(Vdec* v, MfH264* mf, VdecCmd* c, PicList* pl)
+{
+    if (mf) mfh264_destroy(mf);
+    free(c->data);
+    for (int j = 0; j < pl->n; j++) free_pic(&pl->list[j]);
+    free(pl->list);
+    printf("[cellVdec] handle %u: the stalled decoder thread came back; it ends\n", v->handle);
+    return 0;
+}
+
+/* The replacement worker finishes the command the stalled one was on. */
+static void finish_without_mf(Vdec* v, PicList* pl, const VdecCmd* c, int gen)
+{
+    if (c->type == CMD_DECODE) {
+        blank_picture(pl, v->last_w ? v->last_w : 1280, v->last_h ? v->last_h : 720, c->pts, c->dts, c->ud);
+        lock();
+        v->seq_aus++;
+        unlock();
+        notify(v, CELL_VDEC_MSG_TYPE_AUDONE, CELL_OK);
+        deliver(v, pl, gen);
+    } else if (c->type == CMD_ENDSEQ) {
+        deliver(v, pl, gen);
+        lock();
+        if (v->seq == 2) v->seq = 0;
+        unlock();
+        printf("[cellVdec] handle %u: sequence done, %u AUs -> %u pictures\n", v->handle, v->aus, v->pics_out);
+        notify(v, CELL_VDEC_MSG_TYPE_SEQDONE, CELL_OK);
+    }
+}

@@ -1123,7 +1156,7 @@ static void ps_fill(RawState* r, const u8* st, const u8* b, u8 b2mask, u8 l2, u8
     r->bits[0] = (u32)(b[0] >> 4) | (u32)b[1] << 4 | (u32)(x & 7u) << 12 | (u32)(x >> 4) << 15;
     r->axis[0] = ps_axis(st[0]); r->axis[1] = ps_axis(st[1]);     /* X Y   = left stick */
     r->axis[2] = ps_axis(st[2]); r->axis[5] = ps_axis(st[3]);     /* Z RZ  = right stick */

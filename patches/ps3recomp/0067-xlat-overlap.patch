+/* ---- Patch 0067: the renderer's own thread (RSX_XLAT_OVERLAP) -----------------
+ *
+ * The walker (the ticker thread) hands work to the renderer thread through one
+ * byte ring, in order: the frame's present (always, unless RSX_XLAT_OVERLAP=0)
+ * and, with RSX_XLAT_OVERLAP=2, every command-list call the translation
+ * records -- the walker records into a recorder object with the command
+ * list's own interface (g_rq_proxy), which copies each call into the ring, and
+ * the renderer thread makes the real call while the walker goes on with the
+ * next draw. The rest of the design is next to rsx_live_draw_present.
+ *
+ * Who owns the real command list: the renderer thread while the ring holds
+ * work; the walker otherwise. ld_xo_sync (the walker) waits until the ring is
+ * empty -- the renderer thread has made every call and finished the present --
+ * and ld_own_enter/leave keep the walker on the real list around the code that
+ * closes, submits or resets it or waits for the GPU (ld_flush,
+ * ld_begin_recording, the present when it runs on the walker): that code sees
+ * every call recorded before it executed. On the renderer thread ld_xo_sync and
+ * the ownership calls do nothing. */
+static volatile LONGLONG g_xo_wait_ticks;     /* spent in ld_xo_sync (cumulative)  */
+static volatile LONGLONG g_xo_end_qpc;        /* the last handed-off present returned */
+static volatile LONG g_xo_done;               /* handed-off presents finished      */
+static u64 g_xo_waits, g_xo_waits_long;
+static __declspec(thread) int t_ld_render;    /* this is the renderer thread */
+static __declspec(thread) int t_ld_stream;    /* this thread records through the ring */
+static __declspec(thread) int t_ld_own;       /* ... but owns the real list right now */
+
+#define LD_RQ_BYTES (4u << 20)
+static u8* g_rq_buf;
+static volatile LONGLONG g_rq_w, g_rq_r;      /* bytes written / consumed (monotonic) */
+static LONGLONG g_rq_wl;                      /* the walker's write position (published or not) */
+static volatile LONG g_rq_sleep;              /* the renderer thread waits for g_rq_w */
+static volatile LONG g_rq_waiter;             /* a thread waits for g_rq_r */
+static u64 g_rq_packets, g_rq_full_waits;
+static u64 g_xo_async, g_xo_inline;           /* presents handed off / made on the walker */
+
+static void ld_rq_wake(void);
+/* Wait until the renderer thread has consumed the ring up to `upto`. */
+static void ld_rq_wait(LONGLONG upto)
+{
+    LONGLONG r = __atomic_load_n(&g_rq_r, __ATOMIC_ACQUIRE);
+    if (r - upto >= 0) return;
+    const LONGLONG t0 = ld_pf_qpc();
+    ULONGLONG warn = GetTickCount64() + 2000;
+    while ((r = __atomic_load_n(&g_rq_r, __ATOMIC_ACQUIRE)) - upto < 0) {
+        if (__atomic_load_n(&g_rq_sleep, __ATOMIC_SEQ_CST)) ld_rq_wake();
+        InterlockedExchange(&g_rq_waiter, 1);
+        if (__atomic_load_n(&g_rq_r, __ATOMIC_SEQ_CST) == r)
+            WaitOnAddress((volatile VOID*)&g_rq_r, &r, sizeof r, 2);
+        if (GetTickCount64() > warn) {   /* a hung Present: say so, keep waiting */
+            static int n;
+            if (n++ < 4) fprintf(stderr, "[xlat-overlap] the renderer thread has not finished its work for 2 s\n");
+            warn = GetTickCount64() + 10000;
+        }
+    }
+    const LONGLONG dt = ld_pf_qpc() - t0;
+    g_xo_wait_ticks += dt;
+    g_xo_waits++;
+    if (g_ld_qpc_frequency > 0 && dt * 1000 > g_ld_qpc_frequency) g_xo_waits_long++;   /* > 1 ms */
+}
+/* Everything handed to the renderer thread done: the walker owns the list. */
+static void ld_xo_sync(void) { if (!t_ld_render) ld_rq_wait(g_rq_wl); }
+/* The last present handed off done (calls the walker recorded after it may
+ * still be queued: they keep their order behind it). */
+static LONGLONG g_xo_present_end;             /* the ring position after the last PRESENT */
+static void ld_xo_sync_present(void) { if (!t_ld_render) ld_rq_wait(g_xo_present_end); }
+void rsx_live_draw_sync(void) { ld_xo_sync_present(); }
+static void ld_own_enter(void) { if (t_ld_render) return; ld_xo_sync(); t_ld_own++; }
+static void ld_own_leave(void) { if (t_ld_render) return; t_ld_own--; }
+
+/* A packet: header, then the call's arguments (and the arrays they point at)
+ * by value; 16-byte aligned; never across the ring's end (a WRAP packet
+ * fills the tail). */
+typedef struct { u32 op, bytes; } ld_rq_hdr;
+enum { RQ_WRAP = 0, RQ_PRESENT, RQ_BARRIER, RQ_COPYTEX, RQ_COPYRES, RQ_COPYBUF, RQ_GTABLE, RQ_CTABLE, RQ_PSO,
+       RQ_HEAPS, RQ_GROOTSIG, RQ_CROOTSIG, RQ_RESOLVEQ, RQ_ENDQ, RQ_BEGINQ, RQ_VIEWPORTS, RQ_SCISSORS, RQ_RTS,
+       RQ_STENCILREF, RQ_BLENDF, RQ_TOPO, RQ_VBS, RQ_IB, RQ_DRAW, RQ_DRAWIDX, RQ_CLEARRT, RQ_CLEARDS, RQ_GCBV,
+       RQ_GSRV, RQ_G32S, RQ_G32, RQ_DISPATCH };
+
+/* A sleeping renderer thread is woken every 16 packets (a wake-up is a
+ * system call; the thread then takes the whole backlog), at a present and
+ * before the walker waits for it. */
+static u32 g_rq_unwoken;
+static void ld_rq_wake(void)
+{
+    g_rq_unwoken = 0;
+    WakeByAddressSingle((PVOID)&g_rq_w);
+}
+static void ld_rq_publish(void)
+{
+    /* a plain store and load per packet; a wake-up this misses (the renderer
+     * thread going to sleep at this moment) comes with the next ones, the
+     * present's or a wait's, which check with a full fence -- and its sleep is
+     * a WaitOnAddress on g_rq_w, which does not sleep once the store landed */
+    __atomic_store_n(&g_rq_w, g_rq_wl, __ATOMIC_RELEASE);
+    if (__atomic_load_n(&g_rq_sleep, __ATOMIC_RELAXED) && ++g_rq_unwoken >= 16) ld_rq_wake();
+}
+/* Room for one packet of `payload` bytes; returns where its arguments go.
+ * The caller fills them and publishes (ld_rq_publish). */
+static u8* ld_rq_put(u32 op, u32 payload)
+{
+    const u32 need = (u32)((sizeof(ld_rq_hdr) + payload + 15u) & ~15u);
+    u32 off = (u32)(g_rq_wl % LD_RQ_BYTES);
+    const u32 tail = off + need > LD_RQ_BYTES ? LD_RQ_BYTES - off : 0;
+    for (;;) {   /* room for the tail filler and the packet: the renderer thread is a ring behind */
+        LONGLONG r = __atomic_load_n(&g_rq_r, __ATOMIC_ACQUIRE);
+        if (g_rq_wl + tail + need - r <= (LONGLONG)LD_RQ_BYTES) break;
+        ld_rq_publish();
+        ld_rq_wake();
+        g_rq_full_waits++;
+        InterlockedExchange(&g_rq_waiter, 1);
+        if (__atomic_load_n(&g_rq_r, __ATOMIC_SEQ_CST) == r)
+            WaitOnAddress((volatile VOID*)&g_rq_r, &r, sizeof r, 2);
+    }
+    if (tail) {
+        ld_rq_hdr* t = (ld_rq_hdr*)(g_rq_buf + off);
+        t->op = RQ_WRAP; t->bytes = tail;
+        g_rq_wl += tail;
+        off = 0;
+    }
+    ld_rq_hdr* h = (ld_rq_hdr*)(g_rq_buf + off);
+    h->op = op; h->bytes = need;
+    g_rq_wl += need;
+    g_rq_packets++;
+    return (u8*)(h + 1);
+}
+
+/* The recorder: ID3D12GraphicsCommandList's methods the translation records
+ * on the walker, each one packet. Any other method stops the game with a
+ * message (a call this table does not know could not keep its order). */
+typedef struct { CONST_VTBL ID3D12GraphicsCommandListVtbl* lpVtbl; } ld_rq_proxy_t;
+static ID3D12GraphicsCommandListVtbl g_rq_vtbl;
+static ld_rq_proxy_t g_rq_proxy = { &g_rq_vtbl };
+
+typedef struct { UINT n, pad[3]; D3D12_RESOURCE_BARRIER b[1]; } rq_barrier;
+static void STDMETHODCALLTYPE rq_ResourceBarrier(ID3D12GraphicsCommandList* l, UINT n, const D3D12_RESOURCE_BARRIER* b)
+{
+    (void)l;
+    rq_barrier* a = (rq_barrier*)ld_rq_put(RQ_BARRIER, (u32)(offsetof(rq_barrier, b) + n * sizeof *b));
+    a->n = n; memcpy(a->b, b, n * sizeof *b);
+    ld_rq_publish();
+}
+typedef struct { D3D12_TEXTURE_COPY_LOCATION dst, src; D3D12_BOX box; UINT x, y, z, has_box; } rq_copytex;
+static void STDMETHODCALLTYPE rq_CopyTextureRegion(ID3D12GraphicsCommandList* l, const D3D12_TEXTURE_COPY_LOCATION* d,
+                                                   UINT x, UINT y, UINT z, const D3D12_TEXTURE_COPY_LOCATION* s,
+                                                   const D3D12_BOX* box)
+{
+    (void)l;
+    rq_copytex* a = (rq_copytex*)ld_rq_put(RQ_COPYTEX, sizeof(rq_copytex));
+    a->dst = *d; a->src = *s; a->x = x; a->y = y; a->z = z;
+    a->has_box = box != NULL;
+    if (box) a->box = *box;
+    ld_rq_publish();
+}

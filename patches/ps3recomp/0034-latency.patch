diff --git a/runtime/platform/lat_log.h b/runtime/platform/lat_log.h
new file mode 100644
index 0000000..cf82439
--- /dev/null
+++ b/runtime/platform/lat_log.h
@@ -0,0 +1,54 @@
+/*
+ * ps3recomp - input-to-display latency probe (Windows).
+ *
+ * PS3_LATENCY_LOG=<file>: one text line per event, every stamp on the
+ * QueryPerformanceCounter clock (the first line gives its frequency), so a
+ * script that writes PS3_PAD_FILE with time.perf_counter_ns() lines up with
+ * it. Events (first character):
+ *
+ *   E qpc port mask         the pad layer saw buttons go down (sampler/tap latch)
+ *   R qpc port buttons who  a read handed the title new buttons (G = cellPadGetData,
+ *                           L = cellPad_sample_local, netplay's local input)
+ *   V qpc count             vblank tick (the game's 59.94 Hz clock)
+ *   F qpc seq w0 w1 ...     the title asked for flip `seq` (in-FIFO flip): the
+ *                           frame's simulation is done; w* = PS3_LATENCY_WATCH words
+ *   X qpc seq               the FIFO walker reached flip `seq`: translated
+ *   P qpc seq frame pc      Present() of flip `seq` returned (pc = DXGI present count)
+ *   D qpc pc sync_qpc       DXGI frame statistics: present `pc` reached the display
+ *                           at the vblank stamped sync_qpc
+ *   C qpc vblank period     DWM composition clock (last display vblank, period)
+ *   N qpc frame run ...     netplay boundary (src/netplay), K.. other notes
+ *
+ * PS3_LATENCY_WATCH=addr:len[,addr:len...] (hex): guest bytes printed with
+ * every F line as big-endian 32-bit words. PS3_LATENCY_DUMP=addr:len appends
+ * those bytes per flip to <log>.dump (u32 seq, i64 qpc, bytes) for finding
+ * which words to watch.
+ *
+ * Off (no PS3_LATENCY_LOG) every call is one predictable branch.
+ */
+#ifndef PS3RECOMP_LAT_LOG_H
+#define PS3RECOMP_LAT_LOG_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+extern volatile int g_lat_log_on;   /* -1 not decided yet, 0 off, 1 on */
+int  lat_log_init(void);
+void lat_log_(char kind, const char* fmt, ...);
+/* the same with an explicit stamp (an event that happened earlier) */
+void lat_log_at_(char kind, int64_t qpc, const char* fmt, ...);
+/* the guest's flip request `seq`: stamps it and reads the watched words */
+void lat_log_flip_call(unsigned seq);
+int64_t lat_qpc(void);
+
+#define lat_log_enabled() (g_lat_log_on > 0 || (g_lat_log_on < 0 && lat_log_init()))
+#define lat_log(kind, ...) do { if (lat_log_enabled()) lat_log_((kind), __VA_ARGS__); } while (0)
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif

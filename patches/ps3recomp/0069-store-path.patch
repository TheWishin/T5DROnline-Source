diff --git a/runtime/spu/spu_coherency.h b/runtime/spu/spu_coherency.h
index 208867f..3b3fc69 100644
--- a/runtime/spu/spu_coherency.h
+++ b/runtime/spu/spu_coherency.h
@@ -55,6 +55,12 @@ void spu_coh_reserve(spu_context* ctx, uint32_t ea);
  * lookup guarded by a global that is zero until the first GETLLAR. */
 int spu_coh_is_reserved(uint32_t addr);
 
+/* The bitmap itself, for the lifted code's inline store check (ppu_recomp.h,
+ * PPU_COH_LOCAL; handed to it once with the other gates, vm_gates_publish).
+ * A fixed address, all zero until the first line is marked: bit (line & 7) of
+ * byte line >> 3, line = ea >> 7. Read-only for everyone but this file. */
+const unsigned char* spu_coh_bitmap_base(void);
+
 /* A store by the PPU landed on `ea`'s line. Raise SPU_EVENT_LR on every SPU
  * whose live reservation covers it, drop that reservation, and wake the host
  * thread in case it is parked in `rdch SPU_RdEventStat`.
diff --git a/tools/ppu_lifter.py b/tools/ppu_lifter.py
index 0ced5b0..c97ada4 100644

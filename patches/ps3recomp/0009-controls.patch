@@ -0,0 +1,153 @@
+; ps3recomp controls (Windows) -- copy next to the game executable as
+; controls.ini, or point PS3_CONTROLS=<path> at it. Every value below is the
+; built-in DEFAULT: an empty or missing file behaves exactly like this one.
+; Lines starting with ; or # are comments. Names are case-insensitive.
+;
+; Ports: [port1] is PS3 pad port 1 = player 1, [port2] = player 2, ... (7).
+;
+; Devices:
+;   - XInput: Xbox pads, XInput-mode arcade sticks / hitboxes.
+;   - DirectInput: every other game controller -- PS3/PS4-mode arcade sticks
+;     and hitboxes (Hori, Mad Catz, Qanba, Brook, GP2040-CE), DualShock 4,
+;     DualSense, Switch Pro, generic USB pads. Nothing to install.
+;     (XInput devices are skipped here so a pad is never counted twice.
+;     DS4Windows / Steam Input can add a second, virtual XInput pad for the
+;     same controller: hide one of them or pin ports below.)
+;   - the keyboard, only while the game window has the focus.
+; Pads are read whether or not the window has the focus (see background).
+; Hot-plug: a pad that disconnects frees its port; a pad that (re)connects
+; takes the lowest free "auto" port.
+;
+; What the log says (stdout):
+;   [pad] port 1 (player 1): XInput #0 (gamepad), layout standard
+;   [pad] port 2 (player 2): DInput 'Wireless Controller' 054C:09CC, layout ps
+; Set log = 2 to see every raw button you press and what it maps to -- the
+; quickest way to write a binding for an unknown stick:
+;   [pad] port 2 Wireless Controller: B6 pressed -> R1
+
+[general]
+xinput = 1            ; read XInput devices
+dinput = 1            ; read DirectInput (HID) devices
+background = 1        ; 1: pads also work while the window is unfocused
+keyboard = 1          ; port driven by the [keys1] keyboard layout; 0 = no keyboard
+keyboard2 = 2         ; port driven by [keys2] (a 2nd player on the same keyboard,
+                      ; only if [keys2] has bindings -- it has none by default)
+min_ports = 1         ; ports reported connected even with nothing on them
+socd = neutral        ; Left+Right / Up+Down at once (keyboards, hitboxes):
+                      ;   neutral = both cancel, up = L+R cancel / U+D = up,
+                      ;   last = the most recent press wins, off = pass through
+mirror_stick = keyboard ; keyboard directions also tilt the left stick (for titles
+                      ; that only read the stick): keyboard | all | off
+log = 0               ; 1: log every pad packet the game reads that changed;
+                      ; 2: also every raw device press (env PS3_PAD_LOG)
+latency_log = 0       ; 1: every 5 s, how old the samples are when the game reads
+                      ; them (env PS3_PAD_LATENCY)
+min_interval_us = 1000 ; a port is re-sampled at most this often (only matters
+                      ; for titles that spin on the pad; env PS3_PAD_MIN_INTERVAL_US)
+
+; ---------------------------------------------------------------------------
+; Ports. device = auto | none | xinput | xinput:<0-3> | dinput |
+;                 dinput:<VVVV:PPPP> | dinput:<part of the product name>
+; "auto" ports take devices in the order they are found (XInput slots first,
+; then DirectInput); pin a device to make the order explicit, e.g.
+;   [port1]  device = dinput:Hori        [port2]  device = xinput:0
+; stick = analog : the device's left stick is the PS3 left stick (the game
+;                  turns it into directions itself, as with a DUALSHOCK 3)
+; stick = dpad   : the left stick is turned into 8-way d-pad presses here
+;                  (sticks/hitboxes in "LS" mode that you want strictly digital)
+; socd           : per-port override of [general] socd
+; macros = tekken: shoulder buttons become Tekken macros (see below)
+
+[port1]
+device = auto
+stick = analog
+
+[port2]
+device = auto
+stick = analog
+
+; ---------------------------------------------------------------------------
+; Bindings: TARGET = SOURCE SOURCE ...
+;
+; TARGET: a PS3 button -- UP DOWN LEFT RIGHT CROSS CIRCLE SQUARE TRIANGLE
+;   L1 R1 L2 R2 L3 R3 START SELECT -- or a Tekken name: 1 2 3 4 (or LP RP LK RK)
+;   = SQUARE TRIANGLE CROSS CIRCLE, the game's DEFAULT button setting. Combine
+;   with +: "1+2", "3+4", "SQUARE+CROSS" press several at once (macros).
+;   Sticks: LX LY RX RY = <device axis> (prefix - to invert); pads only.
+; An explicit line replaces the preset's binding for that TARGET, and takes
+; its SOURCE keys/buttons away from whatever they did in the preset.
+; "preset = <name>" picks the starting layout; "TARGET =" (empty) unbinds.
+;
+; Sections, least to most specific (later ones win):
+;   [keys1] [keys2]                      keyboard player 1 / 2
+;   [xinput]                             all XInput pads
+;   [dinput]  [dinput.VVVV:PPPP]         all / one model of DirectInput device
+;   [port1.xinput] [port2.dinput] ...    only the device on that port
+
+[keys1]
+preset = classic
+; classic (default): arrows move, A S / Z X = 1 2 / 3 4 (SQUARE TRIANGLE /
+;   CROSS CIRCLE), Q W = L1 R1, 1 2 = L2 R2, Enter = START, Tab = SELECT
+; tekken (alias wasd): W A S D move, U I / J K = 1 2 / 3 4, O = 1+2, L = 3+4,
+;   Y P = L1 R1, H ; = L2 R2, Enter = START, Backspace = SELECT
+; numpad: arrows move, Num4 Num5 / Num1 Num2 = 1 2 / 3 4, Num6 = 1+2,
+;   Num3 = 3+4, Num7 Num8 Num9 Num0 = L1 R1 L2 R2, Num+ = START, Num- = SELECT
+;   (NumLock on)
+; Examples:
+;   1 = U          ; U is left punch
+;   1+2 = O        ; O presses 1+2
+;   START = ENTER SPACE
+; Key names: A-Z 0-9 F1-F24 UP DOWN LEFT RIGHT SPACE ENTER TAB ESC BACKSPACE
+;   LSHIFT RSHIFT LCTRL RCTRL LALT RALT CAPSLOCK INSERT DELETE HOME END PGUP
+;   PGDN NUM0-NUM9 NUMADD NUMSUB NUMMUL NUMDIV NUMDEC SEMICOLON EQUALS COMMA
+;   MINUS PERIOD SLASH GRAVE LBRACKET BACKSLASH RBRACKET APOSTROPHE VK_<hex>
+
+[keys2]
+; empty: no second keyboard player. For two players on one keyboard:
+;   [keys1] preset = tekken     [keys2] preset = numpad
+; (whether a keyboard registers many keys at once is up to the keyboard)
+
+[xinput]
+preset = standard
+; standard: A B X Y = CROSS CIRCLE SQUARE TRIANGLE (Tekken: X Y / A B =
+;   1 2 / 3 4), LB RB = L1 R1, LT RT = L2 R2, BACK = SELECT, START = START,
+;   LS RS = L3 R3, d-pad = d-pad, LX LY RX RY = sticks
+; XInput names: A B X Y LB RB LT RT BACK START LS RS DUP DDOWN DLEFT DRIGHT,
+;   stick directions LUP LDOWN LLEFT LRIGHT RUP RDOWN RLEFT RRIGHT;
+;   axes LX LY RX RY LT RT
+
+[dinput]
+preset = ps
+; ps (default): the PlayStation HID order -- B1 B2 B3 B4 = SQUARE CROSS
+;   CIRCLE TRIANGLE, B5 B6 B7 B8 = L1 R1 L2 R2, B9 B10 = SELECT START,
+;   B11 B12 = L3 R3, hat = d-pad, X Y = left stick, Z RZ = right stick.
+;   Right for DS4, DualSense, PS3/PS4-mode sticks and most generic pads; on a
+;   PS-layout 8-button stick the top row is 1 2 R1 L1, the bottom 3 4 R2 L2.
+; switch: B1 B2 B3 B4 = CROSS CIRCLE SQUARE TRIANGLE (Nintendo B A Y X);
+;   default for Nintendo devices (VID 057E)
+; xbox: B1-B4 = CROSS CIRCLE SQUARE TRIANGLE, B5 B6 = L1 R1, B7 B8 = SELECT
+;   START, Z+ / Z- = L2 / R2; default for Microsoft devices (VID 045E)
+; DirectInput names: B1-B128 (as numbered in Windows' game controller panel,
+;   joy.cpl), HAT_UP HAT_DOWN HAT_LEFT HAT_RIGHT (HAT2_UP ... for more hats),
+;   axis directions X+ X- Y+ Y- Z+ Z- RX+ RX- RY+ RY- RZ+ RZ- S0+ S0- S1+ S1-;
+;   axes X Y Z RX RY RZ S0 S1
+
+; Example: one stick model with its own layout (VID:PID from the log)
+;[dinput.0F0D:00EE]
+;1 = B1
+;2 = B4
+;3 = B2
+;4 = B3
+
+; macros = tekken (in [portN] or a binding section) maps the four shoulder
+; buttons to the usual Tekken macros:
+;   XInput:      RB = 1+2   RT = 3+4   LB = 1+3   LT = 2+4
+;   DirectInput: B6 = 1+2   B8 = 3+4   B5 = 1+3   B7 = 2+4
+;   (PS-layout 8-button stick: top row 1 2 [1+2] [1+3], bottom 3 4 [3+4] [2+4])
+
+; ---------------------------------------------------------------------------
+; Scripted input (tests): PS3_PAD_FILE=<file> drives port 1, PS3_PAD_FILE2
+; port 2. The file holds the buttons held right now (any TARGET name above,
+; e.g. "DOWN CROSS" or "1+2"), LX=n LY=n RX=n RY=n (0-255), and optionally
+; T=<time.perf_counter_ns()> to time the input in the latency log. While a
+; script is in use, physical pads are ignored unless PS3_PAD_DEVICES=1.

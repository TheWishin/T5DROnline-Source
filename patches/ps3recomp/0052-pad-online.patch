-            if ((int)port == g_cfg.kb2_port) apply_keys(&m, &g_cfg.keys[1]);
+        u8 fake[256];
+        const u8* kf = NULL;
+        if (g_cfg.keys_fake[0]) { keys_fake_read(fake); kf = fake; }
+        else if (focus < 0) focus = window_focused();

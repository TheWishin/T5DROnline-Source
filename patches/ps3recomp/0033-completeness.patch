diff --git a/runtime/ppu/ppu_sysprx.cpp b/runtime/ppu/ppu_sysprx.cpp
index c8bd9b9..402731c 100644
--- a/runtime/ppu/ppu_sysprx.cpp
+++ b/runtime/ppu/ppu_sysprx.cpp
@@ -696,6 +696,54 @@ static void hle_net_socket(ppu_context* ctx) { static uint32_t s_fd = 3; ctx->gp
 /* sendto: report the full length as sent (packets vanish into the void, matching
  * the RPCS3-offline oracle where broadcasts go out and nothing answers). */
 static void hle_net_sendto(ppu_context* ctx) { ctx->gpr[3] = (uint32_t)ctx->gpr[5]; }
+/* shutdown and the address helpers. Tekken 5 DR's online menu calls inet_ntoa
+ * on the address GetLocalNetInfo reported (0x858A930B); unregistered, it
+ * returned NULL as the string pointer. inet_* are pure functions with no
+ * network behind them, so the offline model answers them for real; shutdown
+ * on an offline socket succeeds like socketclose does. */
+static void hle_net_inet_ntoa(ppu_context* ctx)
+{
+    static uint32_t s_buf = 0;
+    if (!s_buf) s_buf = gcm_guest_alloc(16, 16);
+    const uint32_t a = (uint32_t)ctx->gpr[3];      /* struct in_addr by value, network order = BE */
+    char tmp[16];
+    snprintf(tmp, sizeof tmp, "%u.%u.%u.%u", a >> 24, (a >> 16) & 0xFF, (a >> 8) & 0xFF, a & 0xFF);
+    if (s_buf) for (uint32_t i = 0; i < 16; i++) vm_write8(s_buf + i, (uint8_t)tmp[i]);
+    ctx->gpr[3] = s_buf;
+}
+static int net_parse_ipv4(uint32_t ea, uint32_t* out)
+{
+    uint32_t parts[4] = {0}, n = 0, have = 0;
+    for (uint32_t i = 0; ea && i < 64; i++) {
+        const uint8_t ch = vm_read8(ea + i);
+        if (ch >= '0' && ch <= '9') { parts[n] = parts[n] * 10 + (ch - '0'); have = 1; if (parts[n] > 255) return 0; }
+        else if (ch == '.' && have && n < 3) { n++; have = 0; }
+        else if (ch == 0) break;
+        else return 0;
+    }
+    if (n != 3 || !have) return 0;
+    *out = (parts[0] << 24) | (parts[1] << 16) | (parts[2] << 8) | parts[3];
+    return 1;
+}
+static void hle_net_inet_addr(ppu_context* ctx)
+{
+    uint32_t a;
+    ctx->gpr[3] = net_parse_ipv4((uint32_t)ctx->gpr[3], &a) ? a : 0xFFFFFFFFu;   /* INADDR_NONE */
+}
+static void hle_net_inet_aton(ppu_context* ctx)
+{
+    uint32_t a;
+    const int ok = net_parse_ipv4((uint32_t)ctx->gpr[3], &a);
+    if (ok && (uint32_t)ctx->gpr[4]) vm_write32((uint32_t)ctx->gpr[4], a);
+    ctx->gpr[3] = ok ? 1 : 0;
+}

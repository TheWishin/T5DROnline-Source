diff --git a/runtime/platform/fp_env.c b/runtime/platform/fp_env.c
new file mode 100644
index 0000000..6de7c79
--- /dev/null
+++ b/runtime/platform/fp_env.c
@@ -0,0 +1,120 @@
+/*
+ * ps3recomp - the SSE environment of the threads that run guest code.
+ *
+ * Guest floating point is computed with the host's SSE instructions, and their
+ * results depend on MXCSR: the rounding mode, flush-to-zero (FTZ) and
+ * denormals-are-zero (DAZ). Two PCs that must compute bit-identical guest state
+ * (lockstep or rollback netplay) need the same MXCSR on every guest thread. A
+ * new Windows thread starts with 0x1F80, but code running on a guest thread
+ * (OS, driver or overlay code reached through an HLE call) may change it and
+ * not put it back, and a thread could inherit something else on another OS. So:
+ *
+ *   - every runtime thread sets PPU_MXCSR_CANON when it starts
+ *     (host_sched_thread_start -> ppu_fp_thread_init), and so does the lifted
+ *     SPU entry (spu_run_with_halt) for the threads that do not go through it;
+ *   - ps3_hle_call, lv2_syscall and ppu_guest_call check it (ppu_fp_env_check,
+ *     ppu_fp_det.h: one stmxcsr and a compare) and restore it when it changed,
+ *     with a log line ("[fp] MXCSR changed ...") for the first few.
+ *
+ * Test switches (both PCs of a netplay test would normally leave them unset):
+ *   PS3_FP_TEST_MXCSR=0x....   guest threads run with this MXCSR instead (a
+ *                              deliberately different FP environment: the
+ *                              desync check must catch it)
+ *   PS3_CRT_FMA3=0             ucrtbase.dll's math takes its non-FMA3 paths
+ *                              (_set_FMA3_enable(0)), as on a CPU without FMA3
+ */
+#include "../ppu/ppu_fp_det.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+#if defined(_WIN32) && defined(PPU_FP_X64)
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+int __cdecl _set_FMA3_enable(int flag);
+#endif
+
+static volatile long s_fp_init = 0;            /* 0 not yet, 1 in progress, 2 done */
+static unsigned s_fp_mxcsr = PPU_MXCSR_CANON;  /* the control bits every guest thread gets */
+static volatile long s_fp_violations = 0;
+static volatile long s_fp_odd_start = 0;
+
+static void fp_process_init(void)
+{
+    const char* e = getenv("PS3_FP_TEST_MXCSR");
+    if (e && *e) {
+        s_fp_mxcsr = (unsigned)strtoul(e, NULL, 0) & PPU_MXCSR_CTRL;
+        fprintf(stderr, "[fp] TEST: guest threads run with MXCSR 0x%04X instead of 0x%04X (PS3_FP_TEST_MXCSR)\n",
+                s_fp_mxcsr, PPU_MXCSR_CANON);
+    }
+#if defined(_WIN32) && defined(PPU_FP_X64)
+    e = getenv("PS3_CRT_FMA3");
+    if (e && *e == '0') {
+        _set_FMA3_enable(0);
+        fprintf(stderr, "[fp] TEST: the C runtime's math takes its non-FMA3 paths (PS3_CRT_FMA3=0)\n");
+    }
+#endif
+#if defined(PPU_FP_X64) && !defined(__FMA__)
+    const char* soft = getenv("PS3_FP_SOFT_FMA");
+    const char* fma = ppu_fp_cpu_fma() ? "FMA3 instructions"
+                    : (soft && *soft == '1') ? "exact software (PS3_FP_SOFT_FMA=1)" : "exact software (this CPU has no FMA3)";
+#elif defined(PPU_FP_X64)
+    const char* fma = "FMA3 instructions";
+#else
+    const char* fma = "host fma";
+#endif
+    fprintf(stderr, "[fp] guest threads: MXCSR 0x%04X (round to nearest, no FTZ/DAZ, exceptions masked); "
+                    "fused multiply-add in runtime code: %s\n", s_fp_mxcsr, fma);
+}
+
+void ppu_fp_thread_init(const char* who)
+{
+#ifdef PPU_FP_X64
+#ifdef _WIN32
+    if (InterlockedCompareExchange(&s_fp_init, 1, 0) == 0) {
+        fp_process_init();
+        InterlockedExchange(&s_fp_init, 2);
+    }
+    while (s_fp_init != 2) Sleep(0);
+#else
+    if (__sync_bool_compare_and_swap(&s_fp_init, 0, 1)) { fp_process_init(); __sync_lock_test_and_set(&s_fp_init, 2); }
+    while (s_fp_init != 2) { }
+#endif
+    const unsigned m = _mm_getcsr();
+    if ((m & PPU_MXCSR_CTRL) != s_fp_mxcsr && (m & PPU_MXCSR_CTRL) != PPU_MXCSR_CANON) {
+#ifdef _WIN32
+        const long n = InterlockedIncrement(&s_fp_odd_start);
+#else
+        const long n = __sync_add_and_fetch(&s_fp_odd_start, 1);
+#endif
+        if (n <= 8)
+            fprintf(stderr, "[fp] thread '%s' started with MXCSR 0x%04X; set to 0x%04X\n",
+                    who ? who : "?", m & PPU_MXCSR_CTRL, s_fp_mxcsr);
+    }
+    _mm_setcsr(s_fp_mxcsr);   /* also clears the sticky status flags */
+#else
+    (void)who;
+#endif
+}
+
+void ppu_fp_env_fix(uint32_t seen, const char* where)
+{
+#ifdef PPU_FP_X64
+    if (s_fp_init != 2) { ppu_fp_thread_init(where); return; }
+    if ((seen & PPU_MXCSR_CTRL) == s_fp_mxcsr) return;          /* PS3_FP_TEST_MXCSR in force */
+#ifdef _WIN32
+    const long n = InterlockedIncrement(&s_fp_violations);
+#else
+    const long n = __sync_add_and_fetch(&s_fp_violations, 1);
+#endif
+    if (n <= 8 || (n & (n - 1)) == 0)
+        fprintf(stderr, "[fp] MXCSR changed to 0x%04X on a guest thread (found after: %s); restored to 0x%04X (%ld time(s))\n",
+                seen & PPU_MXCSR_CTRL, where ? where : "?", s_fp_mxcsr, n);
+    _mm_setcsr((seen & ~PPU_MXCSR_CTRL) | s_fp_mxcsr);
+#else
+    (void)seen; (void)where;
+#endif
+}
+
+uint32_t ppu_fp_env_violations(void) { return (uint32_t)s_fp_violations; }

+#ifdef PPU_FP_ARM64
+/* arm64 (Apple silicon): the same contract with FPCR (ppu_fp_det.h PPU_FPCR_*). No test
+ * override: a Mac test compares against a PC, which has none either. */
+void ppu_fp_thread_init(const char* who)
+{
+    (void)fp_process_init;   /* (the MXCSR half's) */
+    if (__sync_bool_compare_and_swap(&s_fp_init, 0, 1)) {
+        fprintf(stderr, "[fp] guest threads: FPCR 0x%08X (round to nearest, no flush to zero, no default NaN)\n",
+                PPU_FPCR_CANON);
+        __sync_lock_test_and_set(&s_fp_init, 2);
+    }
+    while (s_fp_init != 2) { }
+    const uint32_t m = ppu_fpcr_get();
+    if ((m & PPU_FPCR_CTRL) != PPU_FPCR_CANON) {
+        const long n = __sync_add_and_fetch(&s_fp_odd_start, 1);
+        if (n <= 8)
+            fprintf(stderr, "[fp] thread '%s' started with FPCR 0x%08X; set to 0x%08X\n", who ? who : "?", m, PPU_FPCR_CANON);
+    }
+    ppu_fpcr_set((m & ~PPU_FPCR_CTRL) | PPU_FPCR_CANON);
+}
+
+void ppu_fp_env_fix(uint32_t seen, const char* where)
+{
+    if (s_fp_init != 2) { ppu_fp_thread_init(where); return; }
+    const long n = __sync_add_and_fetch(&s_fp_violations, 1);
+    if (n <= 8 || (n & (n - 1)) == 0)
+        fprintf(stderr, "[fp] FPCR changed to 0x%08X on a guest thread (found after: %s); restored to 0x%08X (%ld time(s))\n",
+                seen, where ? where : "?", PPU_FPCR_CANON, n);
+    ppu_fpcr_set((seen & ~PPU_FPCR_CTRL) | PPU_FPCR_CANON);
+}
+#else

+            LARGE_INTEGER now; QueryPerformanceCounter(&now);
+            if (now.QuadPart < due) {
+                const LONG64 ms = (due - now.QuadPart) * 1000 / (g_ld_qpc_frequency > 0 ? g_ld_qpc_frequency : 1);
+                Sleep(ms > 0 ? (DWORD)ms : 0);

-/* Store user command value */
-void cellGcmSetUserCommand(u32 cmd)
-{
-    GCM_USER_STORE(cmd);
+/* cellGcmSetUserCommand(CellGcmContextData* ctx, u32 cause): append
+ * GCM_SET_USER_COMMAND (method 0xEB00) to the title's command buffer. The RSX
+ * raises the user interrupt when it reaches it, in order with the draws before
+ * it -- titles wait on that (Tekken 5 DR blocks its main loop on a semaphore
+ * its user handler posts). When ctx is not a command buffer we can write,
+ * deliver the cause straight away rather than dropping it. */
+void cellGcmSetUserCommand(void* ctx, u32 cause)
+{
+    const u32 c = (u32)(uintptr_t)ctx;
+    { static int n, dbg = -1; if (dbg < 0) dbg = getenv("GCM_USERCMD_DBG") ? 1 : 0;
+      if (dbg && n++ < 8) fprintf(stderr, "[gcm] SetUserCommand ctx=0x%08X cause=0x%X begin=0x%08X end=0x%08X cur=0x%08X io=0x%08X getoff=0x%X put=0x%X\n",
+        c, cause, c ? vm_read32(c) : 0, c ? vm_read32(c + 4) : 0, c ? vm_read32(c + 8) : 0,
+        c ? gcm_ea2io(vm_read32(c + 8)) : 0, s_fifo_getoff, vm_read32(GCM_CONTROL_GUEST_ADDR)); }
+    if (c) {
+        const u32 end = vm_read32(c + 4), cur = vm_read32(c + 8);
+        if (cur && cur + 8 + GCM_RECYCLE_SLACK <= end && gcm_ea2io(cur) != 0xFFFFFFFFu) {
+            vm_write32(cur, 0x0004EB00u);   /* 1 word, subchannel 7, method 0xB00 */
+            vm_write32(cur + 4, cause);
+            vm_write32(c + 8, cur + 8);
+            /* Kick the ring up to and including the command when the context is
+             * the one the RSX walks. Tekken 5 DR flushes only AFTER its handler
+             * has posted the semaphore it waits on, so without this the walker
+             * never reaches the command. Everything before it is complete --
+             * the title wrote it before calling us. */
+            if (c == s_gcm_context_ea) {
+                const u32 io = gcm_ea2io(cur + 8);
+                if (io != 0xFFFFFFFFu && io > vm_read32(GCM_CONTROL_GUEST_ADDR)) {
+                    atomic_thread_fence(memory_order_release);
+                    vm_write32(GCM_CONTROL_GUEST_ADDR, io);
+                }
+            }
+            return;
+        }
+    }
+    cellGcmQueueUserCommand(cause);
 }
 

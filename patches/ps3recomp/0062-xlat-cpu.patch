+static ld_srv_table_memo g_ld_srv_memo[LD_SRV_MEMO_N];
+static u64 g_ld_srv_tables_reused, g_ld_srv_tables_copied;
+static D3D12_GPU_DESCRIPTOR_HANDLE srv_table_memo(const u32 slots[SRV_TABLE_SIZE])
+{
+    u32 a = 0x9E3779B9u, b = 0x85EBCA6Bu, c = 0xC2B2AE35u, d = 0x27D4EB2Fu;
+    for (u32 i = 0; i < SRV_TABLE_SIZE; i += 4) {
+        a = (a ^ slots[i]) * 0x01000193u; b = (b ^ slots[i + 1]) * 0x01000193u;
+        c = (c ^ slots[i + 2]) * 0x01000193u; d = (d ^ slots[i + 3]) * 0x01000193u;
+    }
+    const u32 hx = a ^ (b << 7 | b >> 25) ^ (c << 13 | c >> 19) ^ (d << 21 | d >> 11);
+    ld_srv_table_memo* m = &g_ld_srv_memo[(hx ^ (hx >> 16)) % LD_SRV_MEMO_N];
+    if (ld_state_cache_on() && m->valid && m->epoch == g_ld_ring_epoch &&
+        m->gen == g_ld_srv_gen && memcmp(m->slots, slots, sizeof(m->slots)) == 0) {
+        g_ld_srv_tables_reused++;
+        return m->h;
+    }
+    const D3D12_GPU_DESCRIPTOR_HANDLE h = srv_table(slots);
+    g_ld_srv_tables_copied++;
+    m->valid = h.ptr != 0;
+    m->epoch = g_ld_ring_epoch;
+    m->gen = g_ld_srv_gen;
+    memcpy(m->slots, slots, sizeof(m->slots));
+    m->h = h;
+    return h;

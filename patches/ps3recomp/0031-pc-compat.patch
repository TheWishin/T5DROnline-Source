+/* Present pacing. The game's clock is the vblank ticker (QPC, 59.94 Hz); a
+ * flip completes on a tick, and the next frame starts only then. A vsync'd
+ * Present on a display slower than that (50 Hz TVs, 30 Hz 4K-over-HDMI-1.4)
+ * blocks the ticker and slows the whole game to the display's rate. On such
+ * a display the present runs without vsync (flip model: the newest frame is
+ * shown at the next refresh, nothing tears, nothing blocks). A faster display
+ * (75/120/144/165/240 Hz, VRR) changes nothing: a frame is shown at the next
+ * refresh after its tick and the game keeps 59.94.
+ *   RSX_PRESENT_INTERVAL=0..4   fixed sync interval (no automatic choice)
+ *   RSX_TEST_DISPLAY_HZ=<hz>    tests: treat the display as running at <hz>,
+ *                               and let a vsync'd Present wait for its refresh */
+static UINT   g_ld_interval_cfg = 1;     /* from PS3_VSYNC / RSX_PRESENT_MODE */
+static int    g_ld_interval_forced = 0;  /* RSX_PRESENT_INTERVAL */
+static u32    g_ld_refresh_hz = 0;
+static double g_ld_test_hz = 0.0;
+
+static u32 ld_display_refresh(HMONITOR mon)
+{
+    if (g_ld_test_hz > 0.0) return (u32)g_ld_test_hz;
+    MONITORINFOEXW mi;
+    DEVMODEW dm;
+    memset(&mi, 0, sizeof mi);
+    memset(&dm, 0, sizeof dm);
+    mi.cbSize = sizeof mi;
+    dm.dmSize = sizeof dm;
+    if (mon && GetMonitorInfoW(mon, (MONITORINFO*)&mi) &&
+        EnumDisplaySettingsW(mi.szDevice, ENUM_CURRENT_SETTINGS, &dm))
+        return (u32)dm.dmDisplayFrequency;
+    return 0;
+}
+
+static void ld_pacing_check(void)
+{
+    static HMONITOR last_mon = NULL;
+    static ULONGLONG last_t = 0;
+    if (!g_ld_main_hwnd || g_ld_interval_forced || g_ld_interval_cfg == 0) return;
+    const HMONITOR mon = MonitorFromWindow(g_ld_main_hwnd, MONITOR_DEFAULTTONEAREST);
+    const ULONGLONG now = GetTickCount64();
+    if (mon == last_mon && now - last_t < 5000) return;
+    last_mon = mon;
+    last_t = now;
+    const u32 hz = ld_display_refresh(mon);
+    if (hz == g_ld_refresh_hz) return;
+    g_ld_refresh_hz = hz;
+    const int slow = hz > 1 && hz < 59 && !getenv("RSX_SLOW_DISPLAY_VSYNC");   /* 59 = 59.94 Hz; 0/1 = unknown */
+    g_ld_present_interval = slow ? 0 : g_ld_interval_cfg;
+    fprintf(stderr, "[pacing] display %u Hz: %s\n", hz,
+            slow ? "slower than the game's 59.94 Hz -- presenting without vsync so the game keeps its speed"
+                 : "vsync on");
+}
+
+static void ld_test_display_wait(void)
+{
+    if (g_ld_test_hz <= 0.0 || g_ld_present_interval == 0) return;
+    static LARGE_INTEGER f, t0;
+    if (!f.QuadPart) { QueryPerformanceFrequency(&f); QueryPerformanceCounter(&t0); }
+    LARGE_INTEGER now;
+    QueryPerformanceCounter(&now);
+    const double period = (double)f.QuadPart / g_ld_test_hz * (double)g_ld_present_interval;
+    const double el = (double)(now.QuadPart - t0.QuadPart);
+    const double next = ((double)(long long)(el / period) + 1.0) * period;
+    const DWORD ms = (DWORD)((next - el) * 1000.0 / (double)f.QuadPart + 0.5);
+    if (ms) Sleep(ms);
+}

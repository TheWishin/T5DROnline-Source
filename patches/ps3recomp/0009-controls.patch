diff --git a/libs/input/pad_host.h b/libs/input/pad_host.h
new file mode 100644
index 0000000..78476f2
--- /dev/null
+++ b/libs/input/pad_host.h
@@ -0,0 +1,74 @@
+/*
+ * ps3recomp - host input layer behind cellPad (Windows)
+ *
+ * Owns every host input device and decides which PS3 pad port each one
+ * drives:
+ *   - XInput pads (Xbox controllers, XInput-mode arcade sticks/hitboxes)
+ *   - DirectInput 8 game controllers: every HID joystick/gamepad that is not
+ *     XInput -- PS3/PS4-mode arcade sticks and hitboxes, DualShock 4,
+ *     DualSense, Switch Pro, generic USB pads. dinput8.dll ships with Windows.
+ *   - the keyboard (only while a window of this process has the focus)
+ *   - PS3_PAD_FILE / PS3_PAD_FILE2 scripted input (ports 1 / 2)
+ *
+ * Mapping, port assignment and options come from controls.ini; see
+ * docs/controls.ini in this tree for the format and every default.
+ *
+ * Devices are sampled when the title reads the pad (cellPadGetData), not on a
+ * timer: what the title gets is at most PS3_PAD_MIN_INTERVAL_US old (default
+ * 1000 us, only to stop spin-polling titles from hammering the drivers).
+ * Enumeration and hot-plug run on a background thread, never on the read path.
+ *
+ * Ports here are 0-based (PS3 port 0 = "port1" in controls.ini = player 1).
+ */
+#ifndef PS3RECOMP_PAD_HOST_H
+#define PS3RECOMP_PAD_HOST_H
+
+#include "ps3emu/ps3types.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define PADH_MAX_PORTS 7
+
+/* One port's merged input, CELL_PAD_CTRL_* packed as cellPad does
+ * (DIGITAL1 in the low byte, DIGITAL2 in the high byte), sticks 0..255 with
+ * 128 = centre and up/left = 0. */
+typedef struct PadHostPort {
+    int connected;          /* a device/keyboard/file/virtual pad is on this port */
+    u16 buttons;
+    u8  lx, ly, rx, ry;
+    u8  l2, r2;             /* trigger pressure 0..255 */
+    u32 seq;                /* increments with every new host sample of the port */
+} PadHostPort;
+
+/* Load controls.ini, enumerate devices, start the hot-plug thread.
+ * Idempotent; safe to call from any thread. */
+void padh_init(void);
+void padh_shutdown(void);
+
+/* Is anything assigned to this port right now? (No device I/O.) */
+int  padh_port_connected(u32 port);
+
+/* Sample the devices on `port` now and merge them into *out.
+ * min_interval_us > 0: reuse the previous sample if it is younger than that
+ * (returns 0 then); returns 1 when a new sample was taken. */
+int  padh_sample(u32 port, PadHostPort* out, u32 min_interval_us);
+
+/* The rate limit cellPadGetData uses (PS3_PAD_MIN_INTERVAL_US, default 1000). */
+u32  padh_min_interval_us(void);
+
+/* Record that the title consumed the sample of `port` (latency statistics). */
+void padh_note_read(u32 port, const PadHostPort* st, int fresh);
+
+/* Rumble: motor values 0..255 (XInput devices only). */
+void padh_rumble(u32 port, u8 small_motor, u8 large_motor);
+
+/* Logging of what the title reads: PS3_PAD_LOG=1 or [general] log = 1. */
+int  padh_log_reads(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_PAD_HOST_H */
diff --git a/libs/input/pad_host_win32.c b/libs/input/pad_host_win32.c
new file mode 100644
index 0000000..639dacb
--- /dev/null
+++ b/libs/input/pad_host_win32.c
@@ -0,0 +1,1405 @@
+/*
+ * ps3recomp - host input layer behind cellPad, Windows implementation.
+ * See pad_host.h for the overview and docs/controls.ini for the user-facing
+ * configuration.
+ *
+ * Why DirectInput 8 for the non-XInput devices
+ * --------------------------------------------
+ * Fighting-game sticks and hitboxes in PS3/PS4 mode, DualShock 4/DualSense
+ * pads and most "PC" pads are plain HID game controllers. The options were:
+ *   - DirectInput 8: dinput8.dll + headers ship with Windows and the SDK, no
+ *     extra dependency, sees every HID joystick/gamepad, and GetDeviceState
+ *     returns the latest report synchronously -- so a device can be sampled
+ *     at the exact moment the title reads the pad. Background (unfocused)
+ *     reads are allowed.
+ *   - Windows.Gaming.Input: WinRT, painful from C, and only delivers input
+ *     while the app has focus (two instances side by side would starve).
+ *   - Raw Input + HID parsing: same latency as DirectInput (DInput reads the
+ *     same HID reports), but needs a message window and our own HID report
+ *     parser for every device class.
+ *   - SDL3 vendored: best device database, but ~300 source files to build
+ *     in-tree and a download to vendor, for what DInput already gives us.
+ * So: XInput for XInput devices (unchanged), DirectInput 8 for everything
+ * else, with XInput devices filtered out of the DInput list (their HID path
+ * contains "IG_") so a pad is never counted twice.
+ */
+#ifdef _WIN32
+
+#ifndef WIN32_LEAN_AND_MEAN
+  #define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <xinput.h>
+#define DIRECTINPUT_VERSION 0x0800
+#include <dinput.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+#include <math.h>
+
+#include "pad_host.h"
+#include "cellPad.h"
+
+#pragma comment(lib, "xinput.lib")
+#pragma comment(lib, "dinput8.lib")
+#pragma comment(lib, "dxguid.lib")
+
+/* ---------------------------------------------------------------------------
+ * Time
+ * -----------------------------------------------------------------------*/
+
+static LONGLONG g_qpf = 1;
+static LONGLONG qpc_now(void) { LARGE_INTEGER t; QueryPerformanceCounter(&t); return t.QuadPart; }
+static LONGLONG qpc_from_us(u64 us) { return (LONGLONG)((us * (u64)g_qpf) / 1000000ull); }
+static double   qpc_to_us(LONGLONG d) { return (double)d * 1e6 / (double)g_qpf; }
+/* QPC as nanoseconds -- the same clock as Python's time.perf_counter_ns(),
+ * so a test script can stamp an input event and we can time it. */
+static u64 qpc_to_ns(LONGLONG t)
+{
+    u64 q = (u64)t, f = (u64)g_qpf;
+    return (q / f) * 1000000000ull + ((q % f) * 1000000000ull) / f;
+}
+
+/* ---------------------------------------------------------------------------
+ * Control ids. One id space per device class (keyboard uses VK codes):
+ *   0..127   buttons. DInput: B1..B128. XInput: the XINPUT_GAMEPAD_* bit
+ *            index (DUP=0 .. Y=15), LT=16, RT=17 (pressed past 30/255).
+ *   128..143 hat directions: 128 + hat*4 + {0 up, 1 right, 2 down, 3 left}
+ *   144..159 axis directions: 144 + axis*2 + {0 positive, 1 negative}, past
+ *            half deflection. Axes: DInput X Y Z RX RY RZ S0 S1;
+ *            XInput LX LY RX RY LT RT. Y axes are PS3-oriented: up < 0.
+ * -----------------------------------------------------------------------*/
+
+#define CID_HAT   128
+#define CID_AXIS  144
+#define CID_COUNT 160
+#define NAXES     8
+
+enum { CLS_KEYS = 0, CLS_XINPUT = 1, CLS_DINPUT = 2 };
+static const char* const k_cls_name[] = { "keys", "xinput", "dinput" };
+
+typedef struct {
+    u32 bits[(CID_COUNT + 31) / 32];
+    s32 axis[NAXES];                 /* -32768..32767, centre 0 */
+    u8  lt, rt;                      /* XInput trigger values (pressure) */
+} RawState;
+
+static int  raw_get(const RawState* r, unsigned id) { return (r->bits[id >> 5] >> (id & 31)) & 1; }
+static void raw_set(RawState* r, unsigned id) { r->bits[id >> 5] |= 1u << (id & 31); }
+
+/* ---------------------------------------------------------------------------
+ * Names
+ * -----------------------------------------------------------------------*/
+
+typedef struct { const char* name; u16 v; } NameVal;
+
+static const NameVal k_ps3_buttons[] = {
+    {"SELECT", CELL_PAD_CTRL_SELECT}, {"L3", CELL_PAD_CTRL_L3}, {"R3", CELL_PAD_CTRL_R3},
+    {"START", CELL_PAD_CTRL_START}, {"UP", CELL_PAD_CTRL_UP}, {"RIGHT", CELL_PAD_CTRL_RIGHT},
+    {"DOWN", CELL_PAD_CTRL_DOWN}, {"LEFT", CELL_PAD_CTRL_LEFT}, {"L2", CELL_PAD_CTRL_L2},
+    {"R2", CELL_PAD_CTRL_R2}, {"L1", CELL_PAD_CTRL_L1}, {"R1", CELL_PAD_CTRL_R1},
+    {"TRIANGLE", CELL_PAD_CTRL_TRIANGLE}, {"CIRCLE", CELL_PAD_CTRL_CIRCLE},
+    {"CROSS", CELL_PAD_CTRL_CROSS}, {"SQUARE", CELL_PAD_CTRL_SQUARE},
+    /* Tekken names for the face buttons, as the game's DEFAULT button setting
+     * has them: 1 = left punch = SQUARE, 2 = right punch = TRIANGLE,
+     * 3 = left kick = CROSS, 4 = right kick = CIRCLE. */
+    {"1", CELL_PAD_CTRL_SQUARE}, {"2", CELL_PAD_CTRL_TRIANGLE},
+    {"3", CELL_PAD_CTRL_CROSS},  {"4", CELL_PAD_CTRL_CIRCLE},
+    {"LP", CELL_PAD_CTRL_SQUARE}, {"RP", CELL_PAD_CTRL_TRIANGLE},
+    {"LK", CELL_PAD_CTRL_CROSS},  {"RK", CELL_PAD_CTRL_CIRCLE},
+    {"TRI", CELL_PAD_CTRL_TRIANGLE}, {"SQR", CELL_PAD_CTRL_SQUARE},
+};
+
+/* Analog targets: the PS3 sticks. */
+enum { TGT_LX = 0, TGT_LY, TGT_RX, TGT_RY };
+static const char* const k_axis_targets[] = { "LX", "LY", "RX", "RY" };
+
+static const NameVal k_keys[] = {
+    {"UP", VK_UP}, {"DOWN", VK_DOWN}, {"LEFT", VK_LEFT}, {"RIGHT", VK_RIGHT},
+    {"SPACE", VK_SPACE}, {"ENTER", VK_RETURN}, {"RETURN", VK_RETURN}, {"TAB", VK_TAB},
+    {"ESC", VK_ESCAPE}, {"ESCAPE", VK_ESCAPE}, {"BACKSPACE", VK_BACK},
+    {"LSHIFT", VK_LSHIFT}, {"RSHIFT", VK_RSHIFT}, {"SHIFT", VK_SHIFT},
+    {"LCTRL", VK_LCONTROL}, {"RCTRL", VK_RCONTROL}, {"CTRL", VK_CONTROL},
+    {"LALT", VK_LMENU}, {"RALT", VK_RMENU}, {"ALT", VK_MENU},
+    {"CAPSLOCK", VK_CAPITAL}, {"INSERT", VK_INSERT}, {"DELETE", VK_DELETE},
+    {"HOME", VK_HOME}, {"END", VK_END}, {"PGUP", VK_PRIOR}, {"PGDN", VK_NEXT},
+    {"NUM0", VK_NUMPAD0}, {"NUM1", VK_NUMPAD1}, {"NUM2", VK_NUMPAD2}, {"NUM3", VK_NUMPAD3},
+    {"NUM4", VK_NUMPAD4}, {"NUM5", VK_NUMPAD5}, {"NUM6", VK_NUMPAD6}, {"NUM7", VK_NUMPAD7},
+    {"NUM8", VK_NUMPAD8}, {"NUM9", VK_NUMPAD9}, {"NUMADD", VK_ADD}, {"NUMSUB", VK_SUBTRACT},
+    {"NUMMUL", VK_MULTIPLY}, {"NUMDIV", VK_DIVIDE}, {"NUMDEC", VK_DECIMAL},
+    {"SEMICOLON", VK_OEM_1}, {"EQUALS", VK_OEM_PLUS}, {"COMMA", VK_OEM_COMMA},
+    {"MINUS", VK_OEM_MINUS}, {"PERIOD", VK_OEM_PERIOD}, {"SLASH", VK_OEM_2},
+    {"GRAVE", VK_OEM_3}, {"LBRACKET", VK_OEM_4}, {"BACKSLASH", VK_OEM_5},
+    {"RBRACKET", VK_OEM_6}, {"APOSTROPHE", VK_OEM_7},
+};
+
+static const NameVal k_xinput_src[] = {
+    {"DUP", 0}, {"DDOWN", 1}, {"DLEFT", 2}, {"DRIGHT", 3}, {"START", 4}, {"BACK", 5},
+    {"LS", 6}, {"RS", 7}, {"LB", 8}, {"RB", 9}, {"A", 12}, {"B", 13}, {"X", 14}, {"Y", 15},
+    {"LT", 16}, {"RT", 17},
+    {"LRIGHT", CID_AXIS + 0}, {"LLEFT", CID_AXIS + 1}, {"LDOWN", CID_AXIS + 2}, {"LUP", CID_AXIS + 3},
+    {"RRIGHT", CID_AXIS + 4}, {"RLEFT", CID_AXIS + 5}, {"RDOWN", CID_AXIS + 6}, {"RUP", CID_AXIS + 7},
+};
+static const char* const k_xinput_axes[NAXES] = { "LX", "LY", "RX", "RY", "LT", "RT", NULL, NULL };
+static const char* const k_dinput_axes[NAXES] = { "X", "Y", "Z", "RX", "RY", "RZ", "S0", "S1" };
+static const char* const k_hat_dirs[4] = { "UP", "RIGHT", "DOWN", "LEFT" };
+
+static int name_eq(const char* a, const char* b) { return _stricmp(a, b) == 0; }
+
+/* Keyboard source name -> VK (0 = unknown). */
+static int parse_key(const char* s)
+{
+    if (!s[1] && isalnum((unsigned char)s[0])) return toupper((unsigned char)s[0]);
+    if ((s[0] == 'F' || s[0] == 'f') && isdigit((unsigned char)s[1])) {
+        int n = atoi(s + 1);
+        if (n >= 1 && n <= 24) return VK_F1 + n - 1;
+    }
+    for (unsigned i = 0; i < sizeof k_keys / sizeof k_keys[0]; i++)
+        if (name_eq(s, k_keys[i].name)) return k_keys[i].v;
+    if (!_strnicmp(s, "VK_", 3) || !_strnicmp(s, "0x", 2)) {
+        int v = (int)strtol(s + (s[0] == 'V' || s[0] == 'v' ? 3 : 0), NULL, 16);
+        if (v > 0 && v < 255) return v;
+    }
+    return 0;
+}
+
+/* Device source name -> control id (-1 = unknown). */
+static int parse_source(int cls, const char* s)
+{
+    if (cls == CLS_KEYS) { int vk = parse_key(s); return vk ? vk : -1; }
+    if (cls == CLS_XINPUT) {
+        for (unsigned i = 0; i < sizeof k_xinput_src / sizeof k_xinput_src[0]; i++)
+            if (name_eq(s, k_xinput_src[i].name)) return k_xinput_src[i].v;
+        return -1;
+    }
+    /* DInput: B<n>, HAT[n]_<dir>, <axis>+ / <axis>- */
+    if ((s[0] == 'B' || s[0] == 'b') && isdigit((unsigned char)s[1])) {
+        int n = atoi(s + 1);
+        return (n >= 1 && n <= 128) ? n - 1 : -1;
+    }
+    if (!_strnicmp(s, "HAT", 3)) {
+        const char* p = s + 3; int hat = 0;
+        if (isdigit((unsigned char)*p)) { hat = *p - '1'; p++; }
+        if (*p == '_') p++;
+        if (hat < 0 || hat > 3) return -1;
+        for (int d = 0; d < 4; d++) if (name_eq(p, k_hat_dirs[d])) return CID_HAT + hat * 4 + d;
+        return -1;
+    }
+    size_t n = strlen(s);
+    if (n >= 2 && (s[n - 1] == '+' || s[n - 1] == '-')) {
+        char ax[8]; if (n - 1 >= sizeof ax) return -1;
+        memcpy(ax, s, n - 1); ax[n - 1] = 0;
+        for (int a = 0; a < NAXES; a++)
+            if (name_eq(ax, k_dinput_axes[a])) return CID_AXIS + a * 2 + (s[n - 1] == '-');
+    }
+    return -1;
+}
+
+/* Analog source "X", "-Y", "~RZ" -> axis index, inversion. */
+static int parse_axis(int cls, const char* s, int* inv)
+{
+    *inv = 0;
+    if (*s == '-' || *s == '~') { *inv = 1; s++; }
+    const char* const* names = cls == CLS_XINPUT ? k_xinput_axes : k_dinput_axes;
+    for (int a = 0; a < NAXES; a++) if (names[a] && name_eq(s, names[a])) return a;
+    return -1;
+}
+
+/* Target "CROSS", "1", "1+2", "SQUARE+CROSS" -> mask; 0 = unknown. */
+static u16 parse_target_mask(const char* s)
+{
+    u16 mask = 0; char tok[32];
+    while (*s) {
+        size_t n = strcspn(s, "+");
+        if (n == 0 || n >= sizeof tok) return 0;
+        memcpy(tok, s, n); tok[n] = 0;
+        u16 m = 0;
+        for (unsigned i = 0; i < sizeof k_ps3_buttons / sizeof k_ps3_buttons[0]; i++)
+            if (name_eq(tok, k_ps3_buttons[i].name)) { m = k_ps3_buttons[i].v; break; }
+        if (!m) return 0;
+        mask |= m;
+        s += n; if (*s == '+') s++;
+    }
+    return mask;
+}
+
+static void source_name(int cls, int id, char* out, size_t cap)
+{
+    if (cls == CLS_KEYS) {
+        for (unsigned i = 0; i < sizeof k_keys / sizeof k_keys[0]; i++)
+            if (k_keys[i].v == id) { snprintf(out, cap, "%s", k_keys[i].name); return; }
+        if (isalnum(id)) snprintf(out, cap, "%c", id);
+        else if (id >= VK_F1 && id <= VK_F24) snprintf(out, cap, "F%d", id - VK_F1 + 1);
+        else snprintf(out, cap, "VK_%02X", id);
+        return;
+    }
+    if (cls == CLS_XINPUT) {
+        for (unsigned i = 0; i < sizeof k_xinput_src / sizeof k_xinput_src[0]; i++)
+            if (k_xinput_src[i].v == id) { snprintf(out, cap, "%s", k_xinput_src[i].name); return; }
+        snprintf(out, cap, "xi%d", id); return;
+    }
+    if (id < CID_HAT) snprintf(out, cap, "B%d", id + 1);
+    else if (id < CID_AXIS) snprintf(out, cap, "HAT%d_%s", (id - CID_HAT) / 4 + 1, k_hat_dirs[(id - CID_HAT) & 3]);
+    else snprintf(out, cap, "%s%c", k_dinput_axes[(id - CID_AXIS) / 2], ((id - CID_AXIS) & 1) ? '-' : '+');
+}
+
+static void mask_names(u16 m, char* out, size_t cap)
+{
+    static const char* const n[16] = { "SELECT", "L3", "R3", "START", "UP", "RIGHT", "DOWN", "LEFT",
+                                       "L2", "R2", "L1", "R1", "TRIANGLE", "CIRCLE", "CROSS", "SQUARE" };
+    size_t o = 0; out[0] = 0;
+    for (int i = 0; i < 16; i++)
+        if (m & (1u << i)) {
+            int w = snprintf(out + o, cap - o, "%s%s", o ? "+" : "", n[i]);
+            if (w < 0 || (size_t)w >= cap - o) break;
+            o += (size_t)w;
+        }
+    if (!o) snprintf(out, cap, "-");
+}
+
+/* ---------------------------------------------------------------------------
+ * controls.ini
+ * -----------------------------------------------------------------------*/
+
+#define INI_MAX_KV  768
+#define INI_MAX_SEC 96
+typedef struct { char key[40]; char val[200]; } IniKV;
+typedef struct { char name[48]; int first, count; } IniSec;
+static IniKV  g_kv[INI_MAX_KV];
+static IniSec g_sec[INI_MAX_SEC];
+static int    g_nkv, g_nsec;
+static char   g_cfg_path[MAX_PATH * 2];
+
+static char* trim(char* s)
+{
+    while (*s && isspace((unsigned char)*s)) s++;
+    char* e = s + strlen(s);
+    while (e > s && isspace((unsigned char)e[-1])) *--e = 0;
+    return s;
+}
+
+static int ini_load(const char* path)
+{
+    FILE* f = fopen(path, "rb");
+    if (!f) return 0;
+    char line[512];
+    IniSec* cur = NULL;
+    while (fgets(line, sizeof line, f)) {
+        char* s = trim(line);
+        if (!*s || *s == ';' || *s == '#') continue;
+        if (*s == '[') {
+            char* e = strchr(s, ']');
+            if (!e || g_nsec >= INI_MAX_SEC) { cur = NULL; continue; }
+            *e = 0;
+            cur = &g_sec[g_nsec++];
+            snprintf(cur->name, sizeof cur->name, "%s", trim(s + 1));
+            cur->first = g_nkv; cur->count = 0;
+            continue;
+        }
+        char* eq = strchr(s, '=');
+        if (!eq || !cur || g_nkv >= INI_MAX_KV) continue;
+        *eq = 0;
+        char* v = eq + 1;
+        /* Inline comment: whitespace followed by ; or # */
+        for (char* p = v; *p; p++)
+            if ((*p == ';' || *p == '#') && p > v && isspace((unsigned char)p[-1])) { *p = 0; break; }
+        if (cur->first + cur->count != g_nkv) continue;   /* section split: ignore */
+        IniKV* kv = &g_kv[g_nkv++];
+        snprintf(kv->key, sizeof kv->key, "%s", trim(s));
+        snprintf(kv->val, sizeof kv->val, "%s", trim(v));
+        cur->count++;
+    }
+    fclose(f);
+    return 1;
+}
+
+static const IniSec* ini_section(const char* name)
+{
+    for (int i = 0; i < g_nsec; i++) if (name_eq(g_sec[i].name, name)) return &g_sec[i];
+    return NULL;
+}
+
+static const char* ini_get(const char* sec, const char* key)
+{
+    const IniSec* s = ini_section(sec);
+    if (!s) return NULL;
+    for (int i = s->first + s->count - 1; i >= s->first; i--)   /* last one wins */
+        if (name_eq(g_kv[i].key, key)) return g_kv[i].val;
+    return NULL;
+}
+
+static int ini_int(const char* sec, const char* key, int def)
+{
+    const char* v = ini_get(sec, key);
+    if (!v || !*v) return def;
+    if (name_eq(v, "on") || name_eq(v, "yes") || name_eq(v, "true")) return 1;
+    if (name_eq(v, "off") || name_eq(v, "no") || name_eq(v, "false")) return 0;
+    return atoi(v);
+}

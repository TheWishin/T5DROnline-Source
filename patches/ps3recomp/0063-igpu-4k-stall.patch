+int64_t host_sched_main_wait_begin(void)
+{
+    if (!t_is_main) return 0;
+    LARGE_INTEGER q;
+    QueryPerformanceCounter(&q);
+    return q.QuadPart;
+}
+void host_sched_main_wait_end(int kind, int64_t t0)
+{
+    if (!t0 || kind < 0 || kind >= HS_WAIT_KINDS) return;
+    LARGE_INTEGER q;
+    QueryPerformanceCounter(&q);
+    if (kind != HS_WAIT_FLIP) {           /* only inside the game part (release -> flip request) */
+        const int64_t r = InterlockedCompareExchange64(&s_release_qpc, 0, 0);
+        if (!r) return;
+        if (t0 < r) t0 = r;
+    }
+    if (q.QuadPart > t0) InterlockedExchangeAdd64(&s_main_wait[kind], q.QuadPart - t0);
+}
+void host_sched_main_released(void)
+{
+    LARGE_INTEGER q;
+    QueryPerformanceCounter(&q);
+    InterlockedExchange64(&s_release_qpc, q.QuadPart);
+}
+void host_sched_main_flip_requested(void) { InterlockedExchange64(&s_release_qpc, 0); }
+void host_sched_main_waits(int64_t out[HS_WAIT_KINDS])
+{

 /* ---- power saving / laptop mode (patch 0047) ------------------------------------
  * The same game at the same 60 fps with less CPU around it, so a laptop's or
  * a handheld's processor stays below its thermal and power limit. PS3_LAPTOP=1
diff --git a/runtime/platform/host_sched_plan.h b/runtime/platform/host_sched_plan.h
new file mode 100644
index 0000000..fb547de
--- /dev/null
+++ b/runtime/platform/host_sched_plan.h
@@ -0,0 +1,333 @@
+/*
+ * ps3recomp - where the runtime's threads run (t5dr patch 0065, thread placement).
+ *
+ * Pure functions over a table of the logical processors Windows reports
+ * (GetSystemCpuSetInformation: CPU set id, logical processor, core, last-level
+ * cache, EfficiencyClass, SchedulingClass; the L3 size from
+ * GetLogicalProcessorInformationEx), so the rules can be unit-tested with
+ * made-up tables of processors this PC does not have -- hybrid Intel parts,
+ * two-CCD and X3D Ryzens, SMT -- (tests/c/sched_plan_test.c in the T5DR
+ * repository). host_sched.c fills the table, makes the plan once and applies it
+ * to each thread as it starts. Header-only: everything is static.
+ *
+ * The frame is one chain: the game thread (the guest's main PPU thread and the
+ * guest threads it hands work to), then the render translation (the ticker),
+ * with the SPU sound core beside it on a 5.33 ms deadline. Workers (the SPURS
+ * job threads that skin the fighters, the vertex-fetch workers of the
+ * translation) only shorten parts of it. So:
+ *
+ *  - Hybrid CPUs (Intel 12th gen and later, Core Ultra): Windows marks the
+ *    performance cores with a higher EfficiencyClass. The game thread, the
+ *    guest threads of the frame, the translation and the sound core get a CPU
+ *    set of the performance cores -- never an efficiency core, 2-3x slower.
+ *    Workers may run on any core.
+ *  - Several last-level caches (Ryzen CCDs/CCXs, Core Ultra's low-power
+ *    island): when one cache group has at least HSP_HOT_MIN_CORES cores, the
+ *    frame's threads and the workers stay in it -- the one with the larger L3
+ *    when the sizes differ (X3D), else the one holding the best-ranked core.
+ *    Smaller groups (Ryzen 3000's 4-core CCXs) are not enough for the frame's
+ *    threads; nothing is restricted then.
+ *  - The game thread and the translation get ideal processors on two
+ *    different physical cores, the best-ranked first, and the sound core a
+ *    third. With SMT and at least HSP_RESERVE_MIN_CORES cores the workers are
+ *    kept off those two cores, so neither shares its core with a busy sibling.
+ *
+ * Pool sizes: SPURS job threads (the chain walker included) half the logical
+ * processors of their group or one per core but the game thread's, whichever
+ * is more (4 cores without SMT: 3, was 2 -- the main thread waits for the
+ * skinning, docs/RENDER_PERF.md "Thread placement"), at most 12 (6 with power
+ * saving) and at most one fewer than the processors; vertex-fetch workers 3
+ * from 24 logical processors, else 1 (as patches 0027/0047 measured).
+ */
+#ifndef PS3RECOMP_HOST_SCHED_PLAN_H
+#define PS3RECOMP_HOST_SCHED_PLAN_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#define HSP_MAX                256
+#define HSP_HOT_MIN_CORES      6   /* a cache group this big holds the frame's threads + workers */
+#define HSP_RESERVE_MIN_CORES  6   /* SMT: keep workers off the game's two cores from this many cores */
+#define HSP_SMALL_CORES        4   /* this many physical cores or fewer: a small CPU */
+
+typedef struct {
+    uint32_t id;      /* CPU set id (SetThreadSelectedCpuSets) */
+    uint8_t  lp;      /* logical processor number (group 0) */
+    uint8_t  core;    /* CoreIndex: SMT siblings share it */
+    uint8_t  llc;     /* LastLevelCacheIndex */
+    uint8_t  eff;     /* EfficiencyClass: higher = faster core; all equal on a CPU of one kind */
+    uint8_t  sched;   /* SchedulingClass: the firmware's core ranking, higher = preferred */
+    uint32_t l3_kb;   /* its last-level cache's size, 0 = not known */
+} hsp_cpu;
+
+/* Thread kinds the plan places. */
+enum {
+    HSP_MAIN = 0,     /* the guest's main PPU thread                            */
+    HSP_TICKER,       /* vblank clock + render translation + present            */
+    HSP_SPU,          /* the SPU sound core                                     */
+    HSP_GAME,         /* other guest PPU threads of the frame (lv2 prio < 1002) */
+    HSP_SPURS,        /* SPURS chain walker + job workers (skinning)            */
+    HSP_VERTEX,       /* vertex-fetch workers of the translation                */
+    HSP_KINDS
+};
+
+typedef struct {
+    /* what the processors in the affinity mask are */
+    int lps, cores, smt;           /* logical processors, physical cores, any core with 2+ of them */
+    int hybrid;                    /* more than one EfficiencyClass */
+    int top_eff;                   /* the performance cores' class */
+    int p_cores, p_lps, e_cores;   /* performance cores (all cores when not hybrid), the others */
+    int groups;                    /* last-level cache groups */
+    int hot;                       /* cache group the frame stays in, -1 = no restriction */
+    int hot_cores, hot_lps;
+    int hot_by_l3;                 /* 1: chosen for its larger L3 (X3D), 0: holds the best-ranked core */
+    uint32_t hot_l3_kb;
+    uint64_t all, group;           /* the logical processors in the mask; those of the hot group (= all) */
+    int small;                     /* HSP_SMALL_CORES cores or fewer */
+    /* placement */
+    uint64_t set[HSP_KINDS];       /* logical processors allowed per kind; 0 = no CPU set */
+    int ideal[HSP_KINDS];          /* ideal logical processor, -1 = none */
+    uint64_t reserved;             /* logical processors kept free of workers (SMT) */
+    /* pools */
+    int pool_lps, pool_cores;      /* logical processors / cores the pools size from */
+    int spurs_threads;             /* jobs of a list at once, the chain walker included */
+    int vertex_threads, vertex_spin;
+} hsp_plan;
+
+static inline int hsp_popcount64(uint64_t m)
+{
+    int n = 0;
+    while (m) { m &= m - 1; n++; }
+    return n;
+}
+
+static inline int hsp_allowed(const hsp_cpu* c, uint64_t allowed)
+{
+    return c->lp < 64 && ((allowed >> c->lp) & 1u);
+}
+
+/* Is a better than b as a core for the game thread: faster class, then the
+ * firmware's ranking, then the lower processor number. */
+static inline int hsp_better(const hsp_cpu* a, const hsp_cpu* b)
+{
+    if (a->eff != b->eff) return a->eff > b->eff;
+    if (a->sched != b->sched) return a->sched > b->sched;
+    return a->lp < b->lp;
+}
+
+/* Logical processors of the cores (CoreIndex) that hold any processor of `lps`. */
+static inline uint64_t hsp_core_lps(const hsp_cpu* c, int n, uint64_t allowed, uint64_t lps)
+{
+    uint64_t out = 0;
+    for (int i = 0; i < n; i++) {
+        if (!hsp_allowed(&c[i], allowed) || !((lps >> c[i].lp) & 1u)) continue;
+        for (int j = 0; j < n; j++)
+            if (hsp_allowed(&c[j], allowed) && c[j].core == c[i].core) out |= 1ull << c[j].lp;
+    }
+    return out;
+}
+
+static inline int hsp_cores_in(const hsp_cpu* c, int n, uint64_t lps)
+{
+    int cores = 0;
+    for (int i = 0; i < n; i++) {
+        if (c[i].lp >= 64 || !((lps >> c[i].lp) & 1u)) continue;
+        int dup = 0;
+        for (int j = 0; j < i; j++)
+            if (c[j].lp < 64 && ((lps >> c[j].lp) & 1u) && c[j].core == c[i].core) { dup = 1; break; }
+        if (!dup) cores++;
+    }
+    return cores;
+}
+
+/* Up to `max` logical processors, one per physical core, best core first, from `lps`. */
+static inline int hsp_rank(const hsp_cpu* c, int n, uint64_t lps, int* out, int max)
+{
+    int k = 0;
+    for (int i = 0; i < n && k < max; i++) {
+        if (c[i].lp >= 64 || !((lps >> c[i].lp) & 1u)) continue;
+        int slot = -1;
+        for (int j = 0; j < k; j++)
+            if (c[out[j]].core == c[i].core) { slot = j; break; }
+        if (slot >= 0) {                          /* the core's best processor stands for it */
+            if (hsp_better(&c[i], &c[out[slot]])) out[slot] = i;
+            continue;
+        }
+        out[k++] = i;
+    }
+    for (int i = 1; i < k; i++) {                 /* insertion sort, best first */
+        int v = out[i], j = i - 1;
+        while (j >= 0 && hsp_better(&c[v], &c[out[j]])) { out[j + 1] = out[j]; j--; }
+        out[j + 1] = v;
+    }
+    return k;
+}
+
+static inline void hsp_pools(hsp_plan* p, int budget, int budget_cores, int laptop);
+
+/* Make the plan. allowed: the process's affinity mask (group 0). budget: the
+ * logical processors the pools size from when > 0 (PS3_CPUS), else the plan's
+ * own count. laptop: power saving (patch 0047). */
+static inline void hsp_make(const hsp_cpu* c, int n, uint64_t allowed, int budget, int laptop, hsp_plan* p)
+{
+    memset(p, 0, sizeof *p);
+    for (int k = 0; k < HSP_KINDS; k++) p->ideal[k] = -1;
+    p->hot = -1;
+    if (n > HSP_MAX) n = HSP_MAX;
+
+    uint64_t all = 0;
+    int top = -1;
+    for (int i = 0; i < n; i++) {
+        if (!hsp_allowed(&c[i], allowed)) continue;
+        all |= 1ull << c[i].lp;
+        if ((int)c[i].eff > top) top = c[i].eff;
+    }
+    p->lps = hsp_popcount64(all);
+    p->all = p->group = all;
+    if (!p->lps) {                                /* no table: size from the budget alone */
+        p->lps = budget > 0 ? budget : 1;
+        p->cores = p->lps;
+        p->p_cores = p->cores; p->p_lps = p->lps;
+        p->groups = 1;
+        p->small = p->cores <= HSP_SMALL_CORES;
+        hsp_pools(p, budget, 0, laptop);
+        return;
+    }
+    p->cores = hsp_cores_in(c, n, all);
+    p->smt = p->cores < p->lps;
+    p->small = p->cores <= HSP_SMALL_CORES;
+    p->top_eff = top;
+    uint64_t pl = 0;
+    for (int i = 0; i < n; i++)
+        if (hsp_allowed(&c[i], allowed) && c[i].eff == top) pl |= 1ull << c[i].lp;
+    p->hybrid = pl != all;
+    p->p_lps = hsp_popcount64(pl);
+    p->p_cores = hsp_cores_in(c, n, pl);
+    p->e_cores = p->cores - p->p_cores;
+
+    /* cache groups */
+    {
+        int llcs[HSP_MAX], ng = 0;
+        for (int i = 0; i < n; i++) {
+            if (!hsp_allowed(&c[i], allowed)) continue;
+            int seen = 0;
+            for (int g = 0; g < ng; g++) if (llcs[g] == c[i].llc) { seen = 1; break; }
+            if (!seen && ng < HSP_MAX) llcs[ng++] = c[i].llc;
+        }
+        p->groups = ng;
+        if (ng > 1) {
+            /* the group with the larger L3 when the sizes are known and differ (X3D) ... */
+            uint32_t lo = 0xFFFFFFFFu, hi = 0;
+            int known = 1, best_l3 = -1;
+            for (int g = 0; g < ng; g++) {
+                uint32_t kb = 0;
+                int has_p = 0;
+                for (int i = 0; i < n; i++)
+                    if (hsp_allowed(&c[i], allowed) && c[i].llc == llcs[g]) {
+                        if (c[i].l3_kb > kb) kb = c[i].l3_kb;
+                        if (c[i].eff == top) has_p = 1;
+                    }
+                if (!has_p) continue;                 /* an island of slow cores only */
+                if (!kb) known = 0;
+                if (kb < lo) lo = kb;
+                if (kb > hi) { hi = kb; best_l3 = llcs[g]; }
+            }
+            /* ... else the group holding the best-ranked core */
+            int best = -1;
+            for (int i = 0; i < n; i++)
+                if (hsp_allowed(&c[i], allowed) && (best < 0 || hsp_better(&c[i], &c[best]))) best = i;
+            int hot = (known && best_l3 >= 0 && hi > lo) ? best_l3 : c[best].llc;
+            uint64_t g = 0;
+            for (int i = 0; i < n; i++)
+                if (hsp_allowed(&c[i], allowed) && c[i].llc == hot) g |= 1ull << c[i].lp;
+            const int gc = hsp_cores_in(c, n, g);
+            if (gc >= HSP_HOT_MIN_CORES) {
+                p->hot = hot;
+                p->hot_cores = gc;
+                p->hot_lps = hsp_popcount64(g);
+                p->hot_by_l3 = known && best_l3 >= 0 && hi > lo;
+                p->hot_l3_kb = 0;
+                for (int i = 0; i < n; i++)
+                    if (hsp_allowed(&c[i], allowed) && c[i].llc == hot && c[i].l3_kb > p->hot_l3_kb)
+                        p->hot_l3_kb = c[i].l3_kb;
+            }
+        }
+    }
+
+    uint64_t grp = all;
+    if (p->hot >= 0) {
+        grp = 0;
+        for (int i = 0; i < n; i++)
+            if (hsp_allowed(&c[i], allowed) && c[i].llc == p->hot) grp |= 1ull << c[i].lp;
+    }
+    p->group = grp;
+    /* the frame's threads: performance cores (hybrid) of the hot group */
+    uint64_t crit = p->hybrid ? (grp & pl) : grp;
+    if (!crit) crit = grp;
+    for (int k = HSP_MAIN; k <= HSP_GAME; k++) p->set[k] = crit == all ? 0 : crit;
+    /* ideal processors: main, translation, sound core on three different cores, best first */
+    {
+        int r[HSP_MAX];
+        const int nr = hsp_rank(c, n, crit, r, HSP_MAX);
+        if (nr > 0) {
+            p->ideal[HSP_MAIN]   = c[r[0]].lp;
+            p->ideal[HSP_TICKER] = c[r[1 % nr]].lp;
+            p->ideal[HSP_SPU]    = c[r[2 % nr]].lp;
+        }
+    }
+    /* workers: the hot group, any kind of core; with SMT and enough cores not
+     * on the game thread's and the translation's cores */
+    uint64_t wk = grp;
+    if (p->smt && hsp_cores_in(c, n, wk) >= HSP_RESERVE_MIN_CORES && p->ideal[HSP_MAIN] >= 0) {
+        uint64_t two = (1ull << p->ideal[HSP_MAIN]) | (1ull << p->ideal[HSP_TICKER]);
+        p->reserved = hsp_core_lps(c, n, allowed, two);
+        wk &= ~p->reserved;
+    }
+    p->set[HSP_SPURS] = p->set[HSP_VERTEX] = wk == all ? 0 : wk;
+    hsp_pools(p, budget, 0, laptop);
+}
+
+/* Pools: from the budget (PS3_CPUS: budget logical processors, budget_cores
+ * cores, 0 = budget), else the group the frame stays in. */
+static inline void hsp_pools(hsp_plan* p, int budget, int budget_cores, int laptop)
+{
+    p->pool_lps = budget > 0 ? budget : (p->hot >= 0 ? p->hot_lps : p->lps);
+    p->pool_cores = budget > 0 ? (budget_cores > 0 ? budget_cores : budget) : (p->hot >= 0 ? p->hot_cores : p->cores);
+    {
+        const int wl = p->set[HSP_SPURS] ? hsp_popcount64(p->set[HSP_SPURS]) : p->pool_lps;
+        int s = p->pool_lps / 2;
+        if (p->pool_cores - 1 > s) s = p->pool_cores - 1;   /* a core each but the game thread's */
+        if (laptop && s > 6) s = 6;
+        if (s > 12) s = 12;
+        if (s > p->pool_lps - 1) s = p->pool_lps - 1;   /* leave the game thread a processor */
+        if (budget <= 0 && s > wl - 1 && wl > 1) s = wl - 1;
+        if (s < 1) s = 1;
+        p->spurs_threads = s;
+    }
+    p->vertex_threads = p->pool_lps >= 24 ? 3 : 1;
+    p->vertex_spin = p->pool_lps >= 24 ? 2000 : 300;
+    if (laptop) { p->vertex_threads = 1; p->vertex_spin = 300; }
+}
+
+/* "0-3,8,10-11" for a processor mask. */
+static inline const char* hsp_mask_text(uint64_t m, char* out, unsigned n)
+{
+    unsigned len = 0;
+    if (!n) return out;
+    out[0] = 0;
+    for (int i = 0; i < 64; ) {
+        if (!((m >> i) & 1u)) { i++; continue; }
+        int j = i;
+        while (j + 1 < 64 && ((m >> (j + 1)) & 1u)) j++;
+        char part[24];
+        int k = j > i ? snprintf(part, sizeof part, "%s%d-%d", len ? "," : "", i, j)
+                      : snprintf(part, sizeof part, "%s%d", len ? "," : "", i);
+        if (k > 0 && len + (unsigned)k < n) { memcpy(out + len, part, (size_t)k + 1); len += (unsigned)k; }
+        i = j + 1;
+    }
+    if (!len && n > 3) memcpy(out, "all", 4);
+    return out;
+}

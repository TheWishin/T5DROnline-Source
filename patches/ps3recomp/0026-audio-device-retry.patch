+/* Windows: the WASAPI device thread against the test hooks, without a title.
+ *
+ *   PS3_AUDIO_FAKE_NODEVICE=3   no device for the first 3 s
+ *   PS3_AUDIO_FAKE_LOSS=7,11    two simulated AUDCLNT_E_DEVICE_INVALIDATED
+ *   PS3_AUDIO_FAKE_CHANGE=9     one default-device notification (make before break)
+ *   PS3_AUDIO_FAKE_STALL=13     the device stops consuming (its queue reads full)
+ *
+ * It starts the real mixer thread and device thread (cellAudioInit), counts the
+ * audio-period events the mixer pushes to the title's queue and checks that
+ *   - they keep their pace (187.5 per second) with no device, with one, and
+ *     across a loss and the reopen: no gap over 100 ms, rate within 2 %;
+ *   - the first device opens when the fake window ends (within ~2.5 s);
+ *   - each loss is followed by a new stream within 1 s;
+ *   - a default-device change installs a new stream within 1 s; the old one
+ *     stays open until then (there is no moment without a stream);
+ *   - a stalled device is given up after ~200 ms (the only place the audio
+ *     events may pause) and replaced;
+ *   - cellAudioQuit returns promptly.
+ * A machine without any audio endpoint passes the pace checks and skips the
+ * device ones. About 16 s.
+ *
+ *   clang-cl /nologo /O1 /D_CRT_SECURE_NO_WARNINGS /Iinclude libs/audio/tests/test_audio_device.c ^
+ *       /link ole32.lib winmm.lib && test_audio_device.exe
+ */
+#include "../cellAudio.c"
+#include <assert.h>
+

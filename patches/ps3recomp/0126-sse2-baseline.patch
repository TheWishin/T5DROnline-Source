+static inline u128 spu__x_rotby(u128 a, uint32_t sh) {
+    uint64_t hi = SPU__X_HI(a), lo = SPU__X_LO(a);
+    if (sh & 8) { const uint64_t t = hi; hi = lo; lo = t; }
+    const unsigned n = (sh & 7) * 8;                    /* 0..56: (x >> 1) >> (63 - n) is x >> (64 - n), 0 for n = 0 */
+    return spu__x_q((hi << n) | ((lo >> 1) >> (63 - n)), (lo << n) | ((hi >> 1) >> (63 - n)));

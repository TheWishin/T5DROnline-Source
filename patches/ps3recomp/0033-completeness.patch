@@ -1384,9 +1387,121 @@ static int savedata_trash_dir(const char* dirName)
     return 0;
 }
 
+/* Bytes in a save directory, every file counted (the system list shows the
+ * size including icons). */
+static u64 savedata_dir_bytes(const char* save_path)
+{
+    u64 total = 0;
+#ifdef _WIN32
+    char search[1100];
+    snprintf(search, sizeof(search), "%s\\*", save_path);
+    WIN32_FIND_DATAA fd;
+    HANDLE h = FindFirstFileA(search, &fd);
+    if (h == INVALID_HANDLE_VALUE) return 0;
+    do {
+        if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
+        total += ((u64)fd.nFileSizeHigh << 32) | fd.nFileSizeLow;
+    } while (FindNextFileA(h, &fd));
+    FindClose(h);
+#else
+    CellSaveDataFileStat st[64];
+    const u32 n = enumerate_save_files(save_path, st, 64);
+    for (u32 i = 0; i < n && i < 64; i++) total += st[i].st_size;
+#endif
+    return total;
+}
+
+/* The system's save data delete list (ps3_sysui): the title's saves with
+ * their PARAM.SFO title, subtitle and detail, the date and the size; CROSS
+ * on one asks "Delete this saved data?", yes moves it to .deleted/ (as the
+ * policy path does) and the list comes back; CIRCLE leaves. Returns CELL_OK
+ * when something was deleted, CANCEL when the player backed out. */
+static s32 savedata_delete_dialog(void)
+{
+    extern const char* cellGame_get_title_id(void);
+    const char* prefix = cellGame_get_title_id();
+    static const char* kHeading = "Delete Saved Data";
+    u32 deleted = 0;
+    int cursor = 0;
+    for (;;) {
+        u32 count = enumerate_save_dirs(prefix, NULL, 0);
+        CellSaveDataDirList* dirs = count ? (CellSaveDataDirList*)calloc(count, sizeof(*dirs)) : NULL;
+        ps3_sysui_item* items = count ? (ps3_sysui_item*)calloc(count, sizeof(*items)) : NULL;
+        s64* mtimes = count ? (s64*)calloc(count, sizeof(*mtimes)) : NULL;
+        if (count && (!dirs || !items || !mtimes)) {
+            free(dirs); free(items); free(mtimes);
+            return CELL_SAVEDATA_ERROR_INTERNAL;
+        }
+        count = enumerate_save_dirs(prefix, dirs, count);
+        if (count == 0) {
+            free(dirs); free(items); free(mtimes);
+            if (!deleted)
+                ps3_sysui_notice(kHeading, "There is no saved data.", 0);
+            printf("[cellSaveData] Delete2: %u save(s) deleted, none left\n", deleted);
+            return deleted ? CELL_OK : SAVEDATA_RET_CANCEL;
+        }
+        for (u32 i = 0; i < count; i++) {
+            char path[1024], sfo[1100];
+            build_save_path(path, sizeof(path), dirs[i].dirName);
+            CellSaveDataSystemFileParam sp;
+            read_param_sfo(path, &sp);
+            snprintf(items[i].title, sizeof(items[i].title), "%s", sp.title[0] ? sp.title : dirs[i].dirName);
+            snprintf(items[i].subtitle, sizeof(items[i].subtitle), "%s", sp.subTitle);
+            snprintf(items[i].icon, sizeof(items[i].icon), "%s/ICON0.PNG", path);
+            snprintf(sfo, sizeof(sfo), "%s/PARAM.SFO", path);
+            HOST_STAT_T st;
+            char when[40] = "";
+            if (HOST_STAT(sfo, &st) == 0 || HOST_STAT(path, &st) == 0) {
+                time_t t = (time_t)st.st_mtime;
+                struct tm lt;
+#ifdef _WIN32
+                localtime_s(&lt, &t);
+#else
+                localtime_r(&t, &lt);
+#endif
+                strftime(when, sizeof(when), "%Y/%m/%d %H:%M", &lt);
+                mtimes[i] = (s64)st.st_mtime;
+            }
+            const double kb = (double)savedata_dir_bytes(path) / 1024.0;
+            if (kb >= 1024.0)
+                snprintf(items[i].detail, sizeof(items[i].detail), "%s    %s    %.1f MB", sp.detail, when, kb / 1024.0);
+            else
+                snprintf(items[i].detail, sizeof(items[i].detail), "%s    %s    %.0f KB", sp.detail, when, kb);
+        }
+        /* newest first, as the system list orders them */
+        for (u32 i = 1; i < count; i++)
+            for (u32 j = i; j > 0 && mtimes[j] > mtimes[j - 1]; j--) {
+                CellSaveDataDirList td = dirs[j]; dirs[j] = dirs[j - 1]; dirs[j - 1] = td;
+                ps3_sysui_item ti = items[j]; items[j] = items[j - 1]; items[j - 1] = ti;
+                s64 tm = mtimes[j]; mtimes[j] = mtimes[j - 1]; mtimes[j - 1] = tm;
+            }
+        if (cursor >= (int)count) cursor = (int)count - 1;
+        const int pick = ps3_sysui_list(kHeading, "Delete", items, (int)count, cursor);
+        if (pick < 0) {
+            free(dirs); free(items); free(mtimes);
+            printf("[cellSaveData] Delete2: %u save(s) deleted, the player went back\n", deleted);
+            return deleted ? CELL_OK : SAVEDATA_RET_CANCEL;
+        }
+        cursor = pick;
+        if (ps3_sysui_yesno(kHeading, "Delete this saved data?", &items[pick], 0)) {
+            if (savedata_trash_dir(dirs[pick].dirName)) {
+                deleted++;
+                ps3_sysui_notice(kHeading, "Deleted.", 1500);
+            } else {
+                ps3_sysui_notice(kHeading, "The saved data could not be deleted.", 0);
+            }
+        }
+        free(dirs); free(items); free(mtimes);
+    }
+}
+
 s32 cellSaveDataDelete2(u32 container)
 {
     const char* policy = getenv("PS3_SAVEDATA_DELETE");
+    if ((!policy || !policy[0]) && ps3_sysui_available()) {
+        printf("[cellSaveData] Delete2(container=0x%08X): system list\n", container);
+        return savedata_delete_dialog();
+    }
     if (!policy || !policy[0]) policy = "all";
     printf("[cellSaveData] Delete2(container=0x%08X) policy=%s\n", container, policy);
 
diff --git a/libs/system/cellWebBrowser.c b/libs/system/cellWebBrowser.c

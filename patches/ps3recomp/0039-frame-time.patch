+/* ---- pages SPURS jobs fill (patch 0039, the rollback layer's state) ------
+ * A rollback layer saves and restores the title's main memory every frame.
+ * Tekken 5 DR's SPURS jobs are its vertex skinning: they DMA-PUT the skinned
+ * vertices into three ~0.7 MB buffers in the heap that only the RSX reads --
+ * ~480 pages a frame, 40 % of what a rollback restored. Pages a job has
+ * filled completely are render output, not game state; the layer leaves them
+ * out (src/rollback, docs/ROLLBACK.md section 32).
+ *   spurs_job_put_track(1)   start recording (off by default: no cost)
+ *   spurs_job_put_lines()    per heap page, the 64-byte lines job PUTs have
+ *                            covered (bit i = line i); ~0 = the whole page
+ *   spurs_job_put_reset()    forget them (the heap's use may change: a load)
+ * Only PUTs made while a SPURS job runs on this thread count (not the sound
+ * core's raw SPU thread, not taskset policies). */
+#define SJP_BASE  0x40000000u
+#define SJP_PAGES (0x06000000u >> 12)        /* the title heap, 96 MB */
+static uint64_t s_sjp_lines[SJP_PAGES];
+volatile int g_spurs_put_track = 0;
+static _Thread_local int s_sjp_in_job = 0;
+void spurs_job_put_track(int on) { g_spurs_put_track = on ? 1 : 0; }
+const uint64_t* spurs_job_put_lines(uint32_t* base, uint32_t* pages)
+{
+    if (base) *base = SJP_BASE;
+    if (pages) *pages = SJP_PAGES;
+    return s_sjp_lines;
+}
+void spurs_job_put_reset(void) { memset(s_sjp_lines, 0, sizeof s_sjp_lines); }
+void spurs_job_put_note(uint32_t ea, uint32_t size)
+{
+    if (!s_sjp_in_job || ea < SJP_BASE) return;
+    uint32_t a = (ea + 63u) & ~63u;              /* whole 64-byte lines only */
+    const uint64_t end = (uint64_t)ea + size;
+    const uint64_t lim = (uint64_t)SJP_BASE + ((uint64_t)SJP_PAGES << 12);
+    const uint32_t e = (uint32_t)((end < lim ? end : lim) & ~63ull);
+    while (a < e) {
+        const uint32_t pg = (a - SJP_BASE) >> 12;
+        const uint32_t pend = ((a >> 12) + 1u) << 12;
+        const uint32_t stop = e < pend ? e : pend;
+        const uint32_t l0 = (a >> 6) & 63u, n = (stop - a) >> 6;
+        const uint64_t m = n >= 64 ? ~0ull : (((1ull << n) - 1ull) << l0);
+        if ((s_sjp_lines[pg] & m) != m) __atomic_fetch_or(&s_sjp_lines[pg], m, __ATOMIC_RELAXED);
+        a = stop;
+    }
+}

diff --git a/libs/network/np_psnr.c b/libs/network/np_psnr.c
new file mode 100644
index 0000000..95e0789
--- /dev/null
+++ b/libs/network/np_psnr.c
@@ -0,0 +1,545 @@
+/*
+ * ps3recomp - psnr client: connection, request/reply pump, NAT probes and
+ * punches, RTT pings. See np_psnr.h.
+ */
+#include "np_psnr.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+
+#ifdef _WIN32
+#  define WIN32_LEAN_AND_MEAN
+#  include <winsock2.h>
+#  include <ws2tcpip.h>
+#  include <windows.h>
+   typedef SOCKET sock_t;
+#  define BAD_SOCK INVALID_SOCKET
+#  define sock_close closesocket
+#  define WOULD_BLOCK() (WSAGetLastError() == WSAEWOULDBLOCK)
+static SRWLOCK s_lock = SRWLOCK_INIT;
+#  define LOCK()   AcquireSRWLockExclusive(&s_lock)
+#  define UNLOCK() ReleaseSRWLockExclusive(&s_lock)
+static uint64_t now_ms(void) { return GetTickCount64(); }
+#else
+#  include <sys/socket.h>
+#  include <netdb.h>
+#  include <netinet/in.h>
+#  include <netinet/tcp.h>
+#  include <fcntl.h>
+#  include <unistd.h>
+#  include <errno.h>
+#  include <poll.h>
+#  include <pthread.h>
+#  include <time.h>
+   typedef int sock_t;
+#  define BAD_SOCK (-1)
+#  define sock_close close
+#  define WOULD_BLOCK() (errno == EAGAIN || errno == EWOULDBLOCK)
+static pthread_mutex_t s_lock = PTHREAD_MUTEX_INITIALIZER;
+#  define LOCK()   pthread_mutex_lock(&s_lock)
+#  define UNLOCK() pthread_mutex_unlock(&s_lock)
+static uint64_t now_ms(void)
+{
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000u + (uint64_t)ts.tv_nsec / 1000000u;
+}
+#endif
+
+#define HEARTBEAT_MS   20000
+#define PENDING_MAX    64
+#define RXBUF          (1 << 16)
+#define PUNCHES        5
+#define PUNCH_MS       200
+#define PROBE_MS       500
+#define REPROBE_MS     20000
+#define PING_MS        1000
+#define MAX_PEERS      16
+
+/* ---- configuration ---- */
+
+static char s_id[17];
+
+static int clean_online_id(const char* in, char out[17])
+{
+    int n = 0;
+    for (; in && *in && n < 16; in++)
+        if (isalnum((unsigned char)*in) || *in == '-' || *in == '_') out[n++] = *in;
+    out[n] = 0;
+    return n >= 3 && isalpha((unsigned char)out[0]);
+}
+
+int np_psnr_enabled(void)
+{
+    return getenv("PS3_NET_ONLINE") && getenv("PSNR_SERVER");
+}
+
+int np_psnr_trace(void)
+{
+    static int v = -1;
+    if (v < 0) v = getenv("PS3_NP_TRACE") ? 1 : 0;
+    return v;
+}
+
+const char* np_psnr_online_id(void)
+{
+    if (!s_id[0]) {
+        const char* e = getenv("PS3_NP_ONLINE_ID");
+        if (!clean_online_id(e, s_id)) {
+#ifdef _WIN32
+            const char* os = getenv("USERNAME");
+#else
+            const char* os = getenv("USER");
+#endif
+            if (e && *e) printf("[psnr] \"%s\" is not a valid online ID (3-16 letters, digits, - or _)\n", e);
+            if (!clean_online_id(os, s_id)) strcpy(s_id, "PS3Player");
+        }
+    }
+    return s_id;
+}
+
+uint16_t np_psnr_p2p_port(void)
+{
+    const char* p = getenv("PS3_NET_P2P_PORT");
+    return (uint16_t)(p ? atoi(p) : 3658);
+}
+
+/* ---- connection ---- */
+
+static sock_t   s_sock = BAD_SOCK;
+static int      s_connected, s_tried;
+static uint32_t s_user_id, s_token, s_next_req = 1;
+static uint8_t  s_server_flags;
+static uint8_t  s_public_ip[4];
+
+uint8_t np_psnr_server_flags(void) { return s_server_flags; }
+static uint8_t  s_server_ip[4];
+static uint16_t s_server_port;
+static uint64_t s_last_send;
+static uint8_t  s_rx[RXBUF];
+static uint32_t s_rxn;
+static struct { uint32_t req; np_psnr_reply_fn fn; void* user; } s_pending[PENDING_MAX];
+static void (*s_push_fn)(const np_psnr_msg*);
+static void (*s_tick_fn)(void);
+
+uint32_t np_psnr_user_id(void) { return s_user_id; }
+void np_psnr_public_ip(uint8_t ip[4]) { memcpy(ip, s_public_ip, 4); }
+int np_psnr_connected(void) { return s_connected; }
+void np_psnr_on_push(void (*fn)(const np_psnr_msg*)) { s_push_fn = fn; }
+void np_psnr_on_tick(void (*fn)(void)) { s_tick_fn = fn; }
+
+static int send_all(const uint8_t* p, uint32_t n)
+{
+    while (n) {
+        int r = send(s_sock, (const char*)p, (int)n, 0);
+        if (r <= 0) {
+            if (r < 0 && WOULD_BLOCK()) {
+#ifdef _WIN32
+                Sleep(1);
+#else
+                usleep(1000);
+#endif
+                continue;
+            }
+            return -1;
+        }
+        p += r; n -= (uint32_t)r;
+    }
+    s_last_send = now_ms();
+    return 0;
+}
+
+static int send_frame(uint8_t type, uint32_t req, const void* body, uint32_t len)
+{
+    uint8_t hdr[7];
+    uint32_t plen = len + (req ? 4 : 0);
+    hdr[0] = type; hdr[1] = (uint8_t)(plen >> 8); hdr[2] = (uint8_t)plen;
+    hdr[3] = (uint8_t)(req >> 24); hdr[4] = (uint8_t)(req >> 16); hdr[5] = (uint8_t)(req >> 8); hdr[6] = (uint8_t)req;
+    if (plen > 0xFFFF) return -1;
+    if (send_all(hdr, req ? 7 : 3)) return -1;
+    return len ? send_all((const uint8_t*)body, len) : 0;
+}
+
+static void set_nonblocking(sock_t s)
+{
+#ifdef _WIN32
+    u_long on = 1; ioctlsocket(s, FIONBIO, &on);
+#else
+    fcntl(s, F_SETFL, fcntl(s, F_GETFL, 0) | O_NONBLOCK);
+#endif
+}
+
+/* Read one whole frame, blocking up to timeout_ms. Returns payload length or -1. */
+static int recv_frame_blocking(uint8_t* type, uint8_t* buf, uint32_t cap, int timeout_ms)
+{
+    uint8_t hdr[3];
+    uint32_t got = 0, need;
+    uint64_t end = now_ms() + (uint64_t)timeout_ms;
+    while (got < 3) {
+        int r = recv(s_sock, (char*)hdr + got, (int)(3 - got), 0);
+        if (r > 0) { got += (uint32_t)r; continue; }
+        if (r < 0 && WOULD_BLOCK() && now_ms() < end) {
+#ifdef _WIN32
+            Sleep(5);
+#else
+            usleep(5000);
+#endif
+            continue;
+        }
+        return -1;
+    }
+    *type = hdr[0];
+    need = ((uint32_t)hdr[1] << 8) | hdr[2];
+    if (need > cap) return -1;
+    got = 0;
+    while (got < need) {
+        int r = recv(s_sock, (char*)buf + got, (int)(need - got), 0);
+        if (r > 0) { got += (uint32_t)r; continue; }
+        if (r < 0 && WOULD_BLOCK() && now_ms() < end) {
+#ifdef _WIN32
+            Sleep(5);
+#else
+            usleep(5000);
+#endif
+            continue;
+        }
+        return -1;
+    }
+    return (int)need;
+}
+
+int np_psnr_connect(const char* comm_id)
+{
+    char host[256];
+    uint16_t port = 36100;
+    if (!np_psnr_enabled()) return -1;
+    if (s_connected) return 0;
+    if (s_tried) return -1;
+    s_tried = 1;
+
+    snprintf(host, sizeof(host), "%s", getenv("PSNR_SERVER"));
+    char* colon = strrchr(host, ':');
+    if (colon) { *colon = 0; port = (uint16_t)atoi(colon + 1); }
+
+#ifdef _WIN32
+    { WSADATA w; WSAStartup(MAKEWORD(2, 2), &w); }
+#endif
+    struct addrinfo hints, *res = NULL;
+    memset(&hints, 0, sizeof(hints));
+    hints.ai_family = AF_INET; hints.ai_socktype = SOCK_STREAM;
+    char portstr[8]; snprintf(portstr, sizeof(portstr), "%u", port);
+    if (getaddrinfo(host, portstr, &hints, &res) || !res) {
+        printf("[psnr] cannot resolve %s -- NP stays offline\n", host);
+        return -1;
+    }
+    sock_t s = socket(AF_INET, SOCK_STREAM, 0);
+    if (s == BAD_SOCK) { freeaddrinfo(res); return -1; }
+    {
+        struct sockaddr_in* a = (struct sockaddr_in*)res->ai_addr;
+        memcpy(s_server_ip, &a->sin_addr, 4);
+        s_server_port = port;
+    }
+    if (connect(s, res->ai_addr, (int)res->ai_addrlen) != 0) {
+        printf("[psnr] could not reach %s:%u -- NP stays offline\n", host, port);
+        sock_close(s); freeaddrinfo(res);
+        return -1;
+    }
+    freeaddrinfo(res);
+    { int one = 1; setsockopt(s, IPPROTO_TCP, TCP_NODELAY, (const char*)&one, sizeof(one)); }
+    set_nonblocking(s);
+    s_sock = s;
+
+    /* HELLO: comm_id [12] online_id [16] p2p_port u16 */
+    uint8_t body[30];
+    memset(body, 0, sizeof(body));
+    strncpy((char*)body, comm_id ? comm_id : "", 12);
+    strncpy((char*)body + 12, np_psnr_online_id(), 16);
+    body[28] = (uint8_t)(np_psnr_p2p_port() >> 8); body[29] = (uint8_t)np_psnr_p2p_port();
+    uint32_t req = s_next_req++;
+    if (send_frame(PSNR_HELLO, req, body, sizeof(body))) { sock_close(s); s_sock = BAD_SOCK; return -1; }
+
+    uint8_t type, rb[64];
+    int n = recv_frame_blocking(&type, rb, sizeof(rb), 5000);
+    if (n < 17 || type != PSNR_HELLO_ACK) {
+        if (n >= 8 && type == PSNR_ERROR && np_get32(rb + 4) == PSNR_E_NAME_TAKEN)
+            printf("[psnr] %s:%u: another player there is already \"%s\" -- set PS3_NP_ONLINE_ID. NP stays offline\n",
+                   host, port, np_psnr_online_id());
+        else
+            printf("[psnr] no HELLO_ACK from %s:%u -- NP stays offline\n", host, port);
+        sock_close(s); s_sock = BAD_SOCK;
+        return -1;
+    }
+    s_user_id = np_get32(rb + 4);
+    memcpy(s_public_ip, rb + 8, 4);
+    s_token = np_get32(rb + 12);
+    s_server_flags = rb[16];
+    s_connected = 1;
+    printf("[psnr] connected to %s:%u as \"%s\" (%s), user %u, seen from %u.%u.%u.%u, p2p port %u\n",
+           host, port, np_psnr_online_id(), comm_id ? comm_id : "", s_user_id,
+           s_public_ip[0], s_public_ip[1], s_public_ip[2], s_public_ip[3], np_psnr_p2p_port());
+    return 0;
+}
+
+uint32_t np_psnr_request(uint8_t type, const void* body, uint32_t len, np_psnr_reply_fn fn, void* user)
+{
+    uint32_t req = 0;
+    LOCK();
+    if (s_connected) {
+        int slot = -1;
+        for (int i = 0; i < PENDING_MAX; i++) if (!s_pending[i].req) { slot = i; break; }
+        if (slot >= 0) {
+            req = s_next_req++;
+            if (send_frame(type, req, body, len) == 0) {
+                s_pending[slot].req = req; s_pending[slot].fn = fn; s_pending[slot].user = user;
+            } else req = 0;
+        }
+    }
+    UNLOCK();
+    if (np_psnr_trace()) printf("[psnr] -> %02X req %u (%u B)%s\n", type, req, len, req ? "" : " NOT SENT");
+    return req;
+}
+
+/* ---- the P2P socket: probes, punches, pings ---- */
+
+static np_psnr_p2p_send_fn s_p2p_send;
+static int      s_probed;
+static uint64_t s_next_probe;
+static struct peer {
+    uint32_t user;
+    uint8_t  ip[4];
+    uint16_t port;
+    int      punches_left;
+    uint64_t next_punch, next_ping, heard_at;
+    int      rtt_ms;
+} s_peers[MAX_PEERS];
+
+void np_psnr_set_p2p_sender(np_psnr_p2p_send_fn fn)
+{
+    s_p2p_send = fn;
+    s_probed = 0;
+    s_next_probe = 0;
+}
+
+static struct peer* peer_by_user(uint32_t user)
+{
+    for (int i = 0; i < MAX_PEERS; i++) if (s_peers[i].user == user) return &s_peers[i];
+    return NULL;
+}
+
+static struct peer* peer_at(const uint8_t ip[4], uint16_t port)
+{
+    for (int i = 0; i < MAX_PEERS; i++)
+        if (s_peers[i].user && s_peers[i].port == port && !memcmp(s_peers[i].ip, ip, 4)) return &s_peers[i];
+    return NULL;
+}
+
+void np_psnr_peer_add(uint32_t user, const uint8_t ip[4], uint16_t port)
+{
+    if (!user || user == s_user_id || !port) return;
+    LOCK();
+    struct peer* p = peer_by_user(user);
+    if (!p) p = peer_by_user(0);
+    if (p) {
+        int known = p->user == user && p->port == port && !memcmp(p->ip, ip, 4);
+        if (!known) {
+            memset(p, 0, sizeof(*p));
+            p->user = user; memcpy(p->ip, ip, 4); p->port = port; p->rtt_ms = -1;
+        }
+        if (!p->punches_left) { p->punches_left = PUNCHES; p->next_punch = 0; }
+        p->next_ping = 0;
+    }
+    UNLOCK();
+}
+
+void np_psnr_peer_remove(uint32_t user)
+{
+    LOCK();
+    struct peer* p = peer_by_user(user);
+    if (p) memset(p, 0, sizeof(*p));
+    UNLOCK();
+}
+
+int np_psnr_peer_rtt_ms(uint32_t user)
+{
+    int r = -1;
+    LOCK();
+    struct peer* p = peer_by_user(user);
+    if (p) r = p->rtt_ms;
+    UNLOCK();
+    return r;
+}
+
+/* Control packets on the P2P socket all start with "PSNR" and a type byte:
+ *   0x01 PROBE (to psnr), 0x81 PROBE_REPLY, 0x02 PUNCH (peer), and ours:
+ *   0x7E PING user u32 | t u64, 0x7F PONG user u32 | t u64 (echoed). */
+int np_psnr_p2p_filter(const void* buf, uint32_t len, const uint8_t from_ip[4], uint16_t from_port)
+{
+    const uint8_t* b = (const uint8_t*)buf;
+    if (len < 5 || memcmp(b, "PSNR", 4) != 0) {
+        LOCK();
+        struct peer* p = peer_at(from_ip, from_port);
+        if (p) p->heard_at = now_ms();
+        UNLOCK();
+        return 0;
+    }
+    switch (b[4]) {
+    case 0x81:
+        if (len >= 11 && !s_probed) {
+            s_probed = 1;
+            s_next_probe = now_ms() + REPROBE_MS;
+            printf("[psnr] P2P socket seen at %u.%u.%u.%u:%u\n", b[5], b[6], b[7], b[8], np_get16(b + 9));
+        }
+        break;
+    case 0x7E:
+        if (len >= 17 && s_p2p_send) {
+            uint8_t pong[17];
+            memcpy(pong, b, 17);
+            pong[4] = 0x7F;
+            s_p2p_send(pong, 17, from_ip, from_port);
+        }
+        break;
+    case 0x7F:
+        if (len >= 17) {
+            uint64_t t = np_get64(b + 9);
+            uint64_t now = now_ms();
+            LOCK();
+            struct peer* p = peer_at(from_ip, from_port);
+            if (p && now >= t) {
+                int rtt = (int)(now - t);
+                p->rtt_ms = p->rtt_ms < 0 ? rtt : (p->rtt_ms * 3 + rtt) / 4;
+                p->heard_at = now;
+            }
+            UNLOCK();
+        }
+        break;
+    default: {   /* a punch */
+        LOCK();
+        struct peer* p = peer_at(from_ip, from_port);
+        if (p) p->heard_at = now_ms();
+        UNLOCK();
+        break;
+    }
+    }
+    return 1;
+}
+
+static void nat_tick(void)
+{
+    uint8_t pkt[17];
+    uint64_t now = now_ms();
+    if (!s_connected || !s_p2p_send) return;
+    if (now >= s_next_probe) {
+        memcpy(pkt, "PSNR\x01", 5);
+        pkt[5] = (uint8_t)(s_user_id >> 24); pkt[6] = (uint8_t)(s_user_id >> 16);
+        pkt[7] = (uint8_t)(s_user_id >> 8);  pkt[8] = (uint8_t)s_user_id;
+        pkt[9] = (uint8_t)(s_token >> 24); pkt[10] = (uint8_t)(s_token >> 16);
+        pkt[11] = (uint8_t)(s_token >> 8); pkt[12] = (uint8_t)s_token;
+        memset(pkt + 13, 0, 4);   /* local ip: unknown here; psnr falls back to the TCP source */
+        s_p2p_send(pkt, 17, s_server_ip, s_server_port);
+        s_next_probe = now + (s_probed ? REPROBE_MS : PROBE_MS);
+    }
+    LOCK();
+    for (int i = 0; i < MAX_PEERS; i++) {
+        struct peer* p = &s_peers[i];
+        if (!p->user) continue;
+        if (p->punches_left && now >= p->next_punch) {
+            memcpy(pkt, "PSNR\x02", 5);
+            pkt[5] = (uint8_t)(s_user_id >> 24); pkt[6] = (uint8_t)(s_user_id >> 16);
+            pkt[7] = (uint8_t)(s_user_id >> 8);  pkt[8] = (uint8_t)s_user_id;
+            s_p2p_send(pkt, 9, p->ip, p->port);
+            p->punches_left--;
+            p->next_punch = now + PUNCH_MS;
+        }
+        if (now >= p->next_ping) {
+            memcpy(pkt, "PSNR\x7E", 5);
+            pkt[5] = (uint8_t)(s_user_id >> 24); pkt[6] = (uint8_t)(s_user_id >> 16);
+            pkt[7] = (uint8_t)(s_user_id >> 8);  pkt[8] = (uint8_t)s_user_id;
+            for (int k = 0; k < 8; k++) pkt[9 + k] = (uint8_t)(now >> (56 - 8 * k));
+            s_p2p_send(pkt, 17, p->ip, p->port);
+            p->next_ping = now + PING_MS;
+        }
+    }
+    UNLOCK();
+}
+
+/* ---- the pump ---- */
+
+static void drop_connection(void)
+{
+    printf("[psnr] connection lost\n");
+    sock_close(s_sock);
+    s_sock = BAD_SOCK;
+    s_connected = 0;
+    np_psnr_msg dead;
+    memset(&dead, 0, sizeof(dead));
+    for (int i = 0; i < PENDING_MAX; i++)
+        if (s_pending[i].req) {
+            np_psnr_reply_fn f = s_pending[i].fn;
+            void* u = s_pending[i].user;
+            s_pending[i].req = 0;
+            UNLOCK();
+            if (f) f(u, &dead);
+            LOCK();
+        }
+}
+
+void np_psnr_pump(void)
+{
+    static int in_pump;
+    static uint64_t last_flush;
+    if (in_pump) return;
+    in_pump = 1;
+    if (s_tick_fn) s_tick_fn();
+    nat_tick();
+    /* Logs go to a file and are block-buffered; a killed instance would lose
+     * the last few seconds of NP activity, which is what a test reads. */
+    if (np_psnr_enabled() && now_ms() - last_flush > 1000) { last_flush = now_ms(); fflush(stdout); }
+    if (!s_connected) { in_pump = 0; return; }
+
+    LOCK();
+    if (now_ms() - s_last_send > HEARTBEAT_MS) send_frame(PSNR_HEARTBEAT, 0, NULL, 0);
+    for (;;) {
+        int r = recv(s_sock, (char*)s_rx + s_rxn, (int)(RXBUF - s_rxn), 0);
+        if (r > 0) { s_rxn += (uint32_t)r; if (s_rxn < RXBUF) continue; }
+        else if (r == 0 || !WOULD_BLOCK()) { drop_connection(); break; }
+        /* cut complete frames */
+        uint32_t off = 0;
+        while (s_rxn - off >= 3) {
+            uint8_t type = s_rx[off];
+            uint32_t plen = ((uint32_t)s_rx[off + 1] << 8) | s_rx[off + 2];
+            if (s_rxn - off - 3 < plen) break;
+            const uint8_t* payload = s_rx + off + 3;
+            off += 3 + plen;
+            np_psnr_msg m;
+            m.type = type;
+            if (type >= 0xA0 && type <= 0xAF) { m.req = 0; m.data = payload; m.len = plen; }
+            else {
+                if (plen < 4) continue;
+                m.req = np_get32(payload); m.data = payload + 4; m.len = plen - 4;
+            }
+            np_psnr_reply_fn fn = NULL; void* user = NULL;
+            if (m.req)
+                for (int i = 0; i < PENDING_MAX; i++)
+                    if (s_pending[i].req == m.req) { fn = s_pending[i].fn; user = s_pending[i].user; s_pending[i].req = 0; break; }
+            if (np_psnr_trace()) printf("[psnr] <- %02X req %u (%u B)\n", m.type, m.req, m.len);
+            /* Handlers run unlocked: they send follow-up requests. Copy the
+             * payload out first, since they may also pump recursively. */
+            uint8_t* copy = (uint8_t*)malloc(m.len ? m.len : 1);
+            if (copy) {
+                memcpy(copy, m.data, m.len);
+                m.data = copy;
+                UNLOCK();
+                if (m.req) { if (fn) fn(user, &m); }
+                else if (s_push_fn) s_push_fn(&m);
+                LOCK();
+                free(copy);
+            }
+            if (!s_connected) break;
+        }
+        if (off) { memmove(s_rx, s_rx + off, s_rxn - off); s_rxn -= off; }
+        break;
+    }
+    UNLOCK();
+    in_pump = 0;
+}
diff --git a/libs/network/np_psnr.h b/libs/network/np_psnr.h
new file mode 100644
index 0000000..af0247a
--- /dev/null
+++ b/libs/network/np_psnr.h
@@ -0,0 +1,116 @@
+/*
+ * ps3recomp - the connection to a psnr matchmaking server (np_psnr.c)
+ *
+ * psnr (github.com/sp00nznet/psnr) stands in for PSN's rooms: it hands out
+ * rooms and each member's P2P address; game traffic never goes through it.
+ * This client speaks its wire protocol (docs/api.md there) with no threads:
+ * requests are queued, replies and pushes are read by np_psnr_pump(), which
+ * cellSysutilCheckCallback calls on the title's own polling thread -- so the
+ * guest callbacks the NP modules queue from reply handlers are delivered by
+ * the very same CheckCallback.
+ *
+ * Environment:
+ *   PS3_NET_ONLINE=1         real sockets and a connected cellNetCtl
+ *   PSNR_SERVER=host[:port]  the psnr server (port 36100 by default)
+ *   PS3_NP_ONLINE_ID=name    this player's online ID (3-16 chars; default
+ *                            the OS user name)
+ *   PS3_NET_P2P_PORT=n       the UDP port this instance's P2P socket binds
+ *                            (default 3658); psnr hands it to peers, so two
+ *                            instances on one machine need two values
+ *   PS3_NET_BIND=ip          the interface the P2P socket binds (default
+ *                            127.0.0.1, which also keeps Windows Firewall
+ *                            quiet; 0.0.0.0 for play across machines)
+ *   PS3_NP_PEER_OVERRIDE=ip:port  every peer's P2P address is reported as
+ *                            this instead (for a latency/loss proxy on
+ *                            localhost; see tools/udp_proxy.py)
+ *   PS3_NP_TRACE=1           log every NP request, reply and push
+ */
+#ifndef PS3RECOMP_NP_PSNR_H
+#define PS3RECOMP_NP_PSNR_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Message types (psnr docs/api.md) */
+enum {
+    PSNR_HELLO = 0x01, PSNR_HEARTBEAT = 0x02,
+    PSNR_CREATE_ROOM = 0x10, PSNR_SEARCH_ROOMS = 0x11, PSNR_JOIN_ROOM = 0x12,
+    PSNR_LEAVE_ROOM = 0x13, PSNR_SET_ROOM_DATA = 0x14, PSNR_ROOM_MESSAGE = 0x15,
+    PSNR_KICK_MEMBER = 0x16,
+    PSNR_RECORD_SCORE = 0x20, PSNR_GET_RANKING = 0x21, PSNR_GET_RANKING_BY_ID = 0x22,
+    PSNR_HELLO_ACK = 0x81, PSNR_ERROR = 0x8F, PSNR_ROOM_JOINED = 0x90, PSNR_ROOM_LIST = 0x91,
+    PSNR_OK = 0x93, PSNR_SCORE_RECORDED = 0xB0, PSNR_RANKING = 0xB1,
+    PSNR_MEMBER_JOINED = 0xA1, PSNR_MEMBER_LEFT = 0xA2, PSNR_ROOM_DATA = 0xA3,
+    PSNR_ROOM_MSG = 0xA4, PSNR_KICKED = 0xA5
+};
+enum {
+    PSNR_E_BAD_REQUEST = 1, PSNR_E_NOT_FOUND = 2, PSNR_E_ROOM_FULL = 3, PSNR_E_NOT_OWNER = 4,
+    PSNR_E_NOT_IN_ROOM = 5, PSNR_E_LIMIT = 6, PSNR_E_NO_HELLO = 7, PSNR_E_NAME_TAKEN = 8
+};
+
+/* One reply or push. type 0 = the connection dropped before the reply came. */
+typedef struct {
+    uint8_t   type;
+    uint32_t  req;        /* 0 for a push */
+    const uint8_t* data;  /* payload after the request id */
+    uint32_t  len;
+} np_psnr_msg;
+
+/* Big-endian readers for payloads. */
+static inline uint16_t np_get16(const uint8_t* p) { return (uint16_t)((p[0] << 8) | p[1]); }
+static inline uint32_t np_get32(const uint8_t* p) { return ((uint32_t)np_get16(p) << 16) | np_get16(p + 2); }
+static inline uint64_t np_get64(const uint8_t* p) { return ((uint64_t)np_get32(p) << 32) | np_get32(p + 4); }
+
+/* Configuration */
+int         np_psnr_enabled(void);        /* PS3_NET_ONLINE and PSNR_SERVER set */
+const char* np_psnr_online_id(void);      /* the player's name */
+uint16_t    np_psnr_p2p_port(void);
+uint32_t    np_psnr_user_id(void);        /* 0 until connected */
+/* HELLO_ACK flags: bit 0 the server relays; bit 1 (this project's psnr_server.py)
+ * room-list entries end with the owner's user id and P2P address. */
+#define NP_PSNR_FLAG_RELAY        0x01
+#define NP_PSNR_FLAG_LIST_ADDRESS 0x02
+uint8_t     np_psnr_server_flags(void);
+void        np_psnr_public_ip(uint8_t ip[4]);   /* as psnr sees us (0.0.0.0 until connected) */
+int         np_psnr_trace(void);
+
+/* Connect (once per process) as this title. 0 connected, -1 not. */
+int  np_psnr_connect(const char* comm_id);
+int  np_psnr_connected(void);
+
+/* Send a request; fn(user, reply) runs from np_psnr_pump(). 0 if not sent. */
+typedef void (*np_psnr_reply_fn)(void* user, const np_psnr_msg* reply);
+uint32_t np_psnr_request(uint8_t type, const void* body, uint32_t len,
+                         np_psnr_reply_fn fn, void* user);
+
+/* Where pushes go (room events). */
+void np_psnr_on_push(void (*fn)(const np_psnr_msg* push));
+/* Called at the start of every pump, for time-based work (quick match timeouts). */
+void np_psnr_on_tick(void (*fn)(void));
+
+/* Read replies and pushes, run their handlers, send heartbeats/probes/punches.
+ * Called from cellSysutilCheckCallback. */
+void np_psnr_pump(void);
+
+/* ---- The title's P2P datagram socket (sysNet.c owns it) ----
+ * sysNet registers how to send from it once the title binds it; np_psnr sends
+ * NAT probes to psnr, punches to peers and RTT pings from there. Every
+ * datagram that arrives on it goes through np_psnr_p2p_filter first, which
+ * consumes psnr's control packets (all start with "PSNR"): 1 = drop it. */
+typedef int (*np_psnr_p2p_send_fn)(const void* buf, uint32_t len, const uint8_t ip[4], uint16_t port);
+void np_psnr_set_p2p_sender(np_psnr_p2p_send_fn fn);
+int  np_psnr_p2p_filter(const void* buf, uint32_t len, const uint8_t from_ip[4], uint16_t from_port);
+
+/* A peer became known (room member): punch toward it and start RTT pings. */
+void np_psnr_peer_add(uint32_t user, const uint8_t ip[4], uint16_t port);
+void np_psnr_peer_remove(uint32_t user);
+/* Last measured round trip to that peer in ms, or -1 if none yet. */
+int  np_psnr_peer_rtt_ms(uint32_t user);
+
+#ifdef __cplusplus
+}
+#endif
+#endif

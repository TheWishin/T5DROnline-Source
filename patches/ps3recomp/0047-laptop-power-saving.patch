 {
+    if (gcm_flip_wait_on()) {
+        if (!g_host_sched_usleep_hook) g_host_sched_usleep_hook = gcm_usleep_flip_wait;
+        t_flip_polled = s_flip_status == CELL_GCM_FLIP_STATUS_WAITING;
+    }
     /* Avoid host-calling the guest OPDs directly (they're not valid host
      * function pointers). Use cellGcmTickVBlank() / TickFlip() instead,
      * which dispatch via g_ps3_guest_caller — see below. */
@@ -789,6 +843,7 @@ void ppu_gcm_pump(void)
     }
     if (p & 2) {
         s_flip_status = CELL_GCM_FLIP_STATUS_DONE;
+        gcm_flip_wake();
         rsx_pf_stamp(RSX_PF_FLIPDONE_QPC);
         lat_log('K', "%u %ld", s_vblank_count, (long)s_lat_walk_seq);   /* the guest's next frame is released */
         SetEvent((HANDLE)gcm_flip_event());        /* cellGcmSetWaitFlip */
@@ -1626,6 +1681,39 @@ void cellGcm_fifo_kick_wait(unsigned ms)
     else    Sleep(ms);
 }
 
+/* The same wait to the microsecond (patch 0047): a high-resolution waitable
+ * timer (Windows 10 1803+) next to the kick event. The ticker used to wait
+ * whole milliseconds (WaitForSingleObject, 1-2 ms with timeBeginPeriod(1))
+ * and then spin -- cellGcm_fifo_kick_wait(0) in a loop, each round a FIFO
+ * walk, a GCM pump and a message pump -- through the last millisecond before
+ * every vblank tick. Returns at once for 0. Called by the ticker only. */
+void cellGcm_fifo_kick_wait_us(unsigned us)
+{
+    static HANDLE tmr = NULL;
+    static int tried = 0;
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("GCM_FIFO_KICK"); on = (e && *e == '0') ? 0 : 1; }
+    HANDLE ev = on ? (HANDLE)cellGcm_fifo_kick_event() : NULL;
+    if (!us) { if (ev) WaitForSingleObject(ev, 0); return; }
+    if (!tried) {
+        tried = 1;
+#ifdef _WIN32
+        tmr = CreateWaitableTimerExW(NULL, NULL, 0x00000002 /* HIGH_RESOLUTION */, TIMER_ALL_ACCESS);
+#else
+        tmr = CreateWaitableTimerW(NULL, FALSE, NULL);
+#endif
+    }
+    LARGE_INTEGER due;
+    due.QuadPart = -(LONGLONG)us * 10;
+    if (tmr && SetWaitableTimer(tmr, &due, 0, NULL, NULL, FALSE)) {
+        HANDLE hs[2] = { tmr, ev };
+        WaitForMultipleObjects(ev ? 2 : 1, hs, FALSE, us / 1000 + 20);
+        if (ev) CancelWaitableTimer(tmr);
+        return;
+    }
+    cellGcm_fifo_kick_wait(us >= 1000 ? us / 1000 : 0);   /* no high-resolution timer: the old wait */
+}

+/* A PlayStation pad's L2 / R2 travel (RX / RY) is a half axis: 0 = released .. 32767 = fully pressed.
+ * DirectInput gives it -32768..32767 with the released trigger at -32768, and every axis direction is
+ * "past half deflection" from the centre -- so a released trigger read as RX- / RY- held, for good, and
+ * anything bound there (a capture of the trigger's resting end, 1.1.4 and older) was held all the time.
+ * As a half axis its centre is the released trigger: RX+ / RY+ = pressed past half way, and RX- / RY- never
+ * come on. ps_trig: travel 0..255; ps_trig_di: DirectInput's -32768..32767 for the same travel. */
+static s32 ps_trig(u8 v) { return (s32)v * 32767 / 255; }
+static s32 ps_trig_di(LONG v) { return v < -32768 ? 0 : v > 32767 ? 32767 : (s32)((v + 32768) >> 1); }
+
 static void axis_dirs(RawState* r)
 {
     for (int a = 0; a < NAXES; a++) {

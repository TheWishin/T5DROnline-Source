 {
 #ifdef PPU_FP_X64
@@ -116,5 +147,6 @@ void ppu_fp_env_fix(uint32_t seen, const char* where)
     (void)seen; (void)where;
 #endif
 }
+#endif /* PPU_FP_ARM64 */
 

+    case HS_ROLE_TICKER: return HSP_TICKER;
+    case HS_ROLE_SPU:    return HSP_SPU;
+    case HS_ROLE_SPURS:  return HSP_SPURS;
+    case HS_ROLE_VERTEX: return HSP_VERTEX;
+    case HS_ROLE_PPU:    return guest_prio < s_ppu_lo ? HSP_GAME : -1;
+    default:             return -1;
+    }

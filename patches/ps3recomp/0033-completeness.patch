@@ -1332,10 +1333,12 @@ s32 cellSaveDataAutoLoad2(u32 version, const char* dirName,
 
 /* cellSaveDataDelete2(container): on hardware the system shows this title's
  * save data list, the user picks one to delete (or backs out), and the call
- * returns CELL_OK after a deletion or CELL_SAVEDATA_RET_CANCEL (1). There is
- * no system UI here, so the choice comes from PS3_SAVEDATA_DELETE:
+ * returns CELL_OK after a deletion or CELL_SAVEDATA_RET_CANCEL (1). The
+ * runtime shows that list itself (ps3_sysui, savedata_delete_dialog below).
+ * PS3_SAVEDATA_DELETE skips the list for scripted runs and tests, and is the
+ * fallback when the dialog is off (PS3_SYSUI=0):
  *
- *   all (default)  every save of this title (dirName starting with the title

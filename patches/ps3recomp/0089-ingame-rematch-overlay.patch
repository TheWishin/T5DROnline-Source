+ * Windows font linking is not assumed: each selected face must supply the
+ * glyph according to GetGlyphIndicesW. BMP covers our JP/KR catalogs. */
+typedef struct { unsigned cp; int valid, advance; uint16_t rows[16]; } ovl_native_glyph;
+#if defined(_WIN32)
+static SRWLOCK g_native_lock = SRWLOCK_INIT;
+static ovl_native_glyph g_native_cache[512];
+static unsigned g_native_next;

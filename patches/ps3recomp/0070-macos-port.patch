+            const u32 minf = (t.filter >> 16) & 7u, magf = (t.filter >> 24) & 7u;
+            if (magf == 2u || minf == 2u || minf == 4u || minf == 6u) linear |= 1u << u;
+        }
+    }
+    *linear_out = linear;
+    return mask;

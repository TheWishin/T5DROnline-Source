+/* A capture shortcut must not poll a device or take a lock the game can
+ * wait behind. Return no input if the sampler/guest has not read this port
+ * in the last 100 ms (for example while loading), or a sample is in flight. */
+int padh_peek_cached(u32 port, PadHostPort* out)
+{
+    memset(out, 0, sizeof *out);
+    if (port >= PADH_MAX_PORTS || !InterlockedCompareExchange(&g_cached_ready, 0, 0)) return 0;
+    PortState* ps = &g_port[port];
+    if (!TryAcquireSRWLockShared(&ps->lock)) return -1;
+    int recent = ps->have && qpc_now() - ps->t_end < qpc_from_us(100000);
+    if (recent) *out = ps->last;
+    ReleaseSRWLockShared(&ps->lock);
+    return recent;
+}

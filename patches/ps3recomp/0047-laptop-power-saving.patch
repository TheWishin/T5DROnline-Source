+            return 1;
+        }
+        if (ps.SystemStatusFlag & 1) { snprintf(why, n, "battery saver is on"); return 1; }
+    }
+    {   /* the "Power saver" plan */
+        static const GUID power_saver = { 0xa1841308, 0x3541, 0x4fab, { 0xbc, 0x81, 0xf7, 0x15, 0x56, 0xf2, 0x0b, 0x4a } };
+        typedef DWORD (WINAPI *gas_fn)(HKEY, GUID**);
+        HMODULE pp = LoadLibraryA("powrprof.dll");
+        gas_fn gas = pp ? (gas_fn)(void*)GetProcAddress(pp, "PowerGetActiveScheme") : NULL;
+        GUID* g = NULL;
+        if (gas && gas(NULL, &g) == ERROR_SUCCESS && g) {
+            const int saver = !memcmp(g, &power_saver, sizeof(GUID));
+            LocalFree(g);
+            if (saver) { snprintf(why, n, "the \"Power saver\" power plan is active"); return 1; }
+        }
+    }

+++ b/libs/video/rsx_picture_rect.h
@@ -119,4 +119,13 @@ static inline void rsx_picture_rect(int mode, unsigned bw, unsigned bh, unsigned
     }
 }
 
+/* 1 when r draws the source 1:1 over the whole bw x bh window with nothing cut (no bars, no crop): only
+ * then may the present replace its draw by a plain copy of a source of the window's size (patch 0109: the
+ * viewport alone said yes for 4:3 at Native in a 1280x720 window -- the scissor keeps only 160..1120). */
+static inline int rsx_picture_rect_whole(const rsx_pic_rect* r, unsigned bw, unsigned bh)
+{
+    return r->vx == 0.0f && r->vy == 0.0f && r->vw == (float)bw && r->vh == (float)bh &&
+           r->cl == 0 && r->ct == 0 && r->cr == (long)bw && r->cb == (long)bh;
+}

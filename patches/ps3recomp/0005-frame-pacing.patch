+/* PS3_GCM_VSYNC_FLIP (default on; "0" = old behaviour). cellGcmSetFlip and
+ * cellGcmSetWaitFlip are command-buffer commands on hardware: the flip runs
+ * when the RSX reaches it, at the next vblank, and the wait stalls the RSX --
+ * not the PPU -- until then. The HLE used to flip at call time and block the
+ * calling PPU thread in cellGcmSetWaitFlip until the next tick, which put a
+ * vblank wait and the whole FIFO drain in series with the guest's frame
+ * (Tekken 5 DR fights: 32 fps). With this on:
+ *   - cellGcmSetFlip queues the flip marker in the FIFO (gcm_flip_into_fifo);
+ *   - the walker parks on that marker (s_flip_hold) until the ticker's next
+ *     vblank tick presents it, then resumes -- the RSX-side wait;
+ *   - cellGcmSetWaitFlip returns at once while such a flip is queued;
+ *   - the flip completes (status DONE + handler) on the tick that shows it,
+ *     not on whatever tick happens to follow the request. */
+static int gcm_vsync_flip(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("PS3_GCM_VSYNC_FLIP"); v = (e && *e == '0') ? 0 : 1; }
+    return v;

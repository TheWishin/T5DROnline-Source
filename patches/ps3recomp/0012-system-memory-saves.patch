+/* ---------------------------------------------------------------------------
+ * Wall clock: nanoseconds since 1970-01-01 00:00:00 UTC.
+ *
+ * sys_time_get_current_time used to return QueryPerformanceCounter / its
+ * frequency -- time since the HOST booted -- so a title saw 1970-01-02 and
+ * Tekken 5 DR named its save folders NPUB30009-CN19700102... (a new name per
+ * session). lv2 returns UTC seconds since the Unix epoch here; cellRtc adds
+ * the 0001-01-01 offset itself (PS3_UNIX_EPOCH_DIFF in cellRtc.c), and the
+ * timezone stays UTC (sys_time_get_timezone / the TIMEZONE system param).
+ *
+ * PS3_FIXED_TIME=<unix seconds> pins the clock for deterministic netplay and
+ * replays: every read returns exactly that instant. PS3_FIXED_TIME=<secs>+
+ * starts the clock there instead and lets it run (seeded, not frozen).
+ * Anything that feeds the clock into game state (save names, RNG seeds)
+ * differs between peers unless both use the same value, so netplay should
+ * hand both sides the same PS3_FIXED_TIME.
+ * -----------------------------------------------------------------------*/
+static uint64_t host_unix_nsec(void)
+{
+#ifdef _WIN32
+    FILETIME ft;
+    GetSystemTimePreciseAsFileTime(&ft);
+    uint64_t t = ((uint64_t)ft.dwHighDateTime << 32) | ft.dwLowDateTime;
+    return (t - 116444736000000000ULL) * 100ULL;   /* 100 ns since 1601 -> ns since 1970 */
+#else
+    struct timespec ts;
+    clock_gettime(CLOCK_REALTIME, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ULL + (uint64_t)ts.tv_nsec;
+#endif
+}
+
+uint64_t ps3_wallclock_unix_nsec(void)
+{
+    /* 0 = real clock, 1 = frozen, 2 = seeded and running */
+    static int mode = -1;
+    static uint64_t base_ns, anchor_tb;
+    if (mode < 0) {
+        const char* e = getenv("PS3_FIXED_TIME");
+        char* end = NULL;
+        unsigned long long secs = e ? strtoull(e, &end, 10) : 0;
+        if (e && end != e) {
+            base_ns = (uint64_t)secs * 1000000000ULL;
+            anchor_tb = ppu_timebase_now();
+            mode = (*end == '+') ? 2 : 1;
+            fprintf(stderr, "[sys_time] PS3_FIXED_TIME=%llu: clock %s at that instant\n",
+                    secs, mode == 2 ? "starts" : "frozen");
+        } else {
+            mode = 0;
+        }
+    }
+    if (mode == 0) return host_unix_nsec();
+    if (mode == 1) return base_ns;
+    uint64_t d = ppu_timebase_now() - anchor_tb;
+    return base_ns + (d / PS3_TIMEBASE_FREQ) * 1000000000ULL +
+           (d % PS3_TIMEBASE_FREQ) * 1000000000ULL / PS3_TIMEBASE_FREQ;
+}

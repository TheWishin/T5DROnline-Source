+/*
+ * ps3_sysui -- modal system dialogs over the game window (see ps3_sysui.h).
+ *
+ * Why it exists: cellSaveDataDelete2 opens the PS3's own save data list, the
+ * player picks a save, confirms, and the call returns. With no UI at all the
+ * runtime had to guess (PS3_SAVEDATA_DELETE, default "all"), so Tekken 5 DR's
+ * Options -> DELETE SAVE DATA silently removed every save on one press.
+ *
+ * How: a small panel is rendered with GDI into a memory bitmap and shown in a
+ * layered, non-activating, topmost popup centred on the game window (the D3D12
+ * swap chain underneath is not touched). The calling guest thread runs the
+ * dialog loop itself -- the PS3 call blocks it too -- and reads the pads with
+ * cellPad_sample_local (every port, keyboard and PS3_PAD_FILE scripts
+ * included). While a dialog is up, and until the buttons that closed it are
+ * released, cellPadGetData hands the title neutral pads (ps3_sysui_pad_swallow),
+ * as the PS3 does while a system utility holds the controller.
+ */
+#include "ps3_sysui.h"
+#include "../input/cellPad.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static long s_active = 0;          /* a dialog is open                         */
+static long s_swallow_mask = 0;    /* ports whose closing press is still held   */
+
+int ps3_sysui_active(void)
+{
+    return __atomic_load_n(&s_active, __ATOMIC_ACQUIRE) != 0;
+}
+
+int ps3_sysui_pad_swallow(unsigned port, unsigned buttons)
+{
+    if (port >= 31) return 0;
+    if (__atomic_load_n(&s_active, __ATOMIC_ACQUIRE)) return 1;
+    const long bit = 1L << port;
+    if (!(__atomic_load_n(&s_swallow_mask, __ATOMIC_ACQUIRE) & bit)) return 0;
+    if (buttons == 0)
+        __atomic_and_fetch(&s_swallow_mask, ~bit, __ATOMIC_ACQ_REL);   /* released: the title gets this port back */
+    return 1;
+}
+
+#ifndef _WIN32
+int ps3_sysui_available(void) { return 0; }
+int ps3_sysui_list(const char* h, const char* t, const ps3_sysui_item* i, int n, int s)
+{ (void)h; (void)t; (void)i; (void)n; (void)s; return -1; }
+int ps3_sysui_yesno(const char* h, const char* t, const ps3_sysui_item* i, int d)
+{ (void)h; (void)t; (void)i; return d; }
+void ps3_sysui_notice(const char* h, const char* t, unsigned ms) { (void)h; (void)t; (void)ms; }
+#else
+
+#define COBJMACROS
+#include <windows.h>
+#include <wincodec.h>
+
+extern void* rsx_null_backend_get_hwnd(void);
+
+int ps3_sysui_available(void)
+{
+    static int v = -1;
+    if (v < 0) {
+        const char* e = getenv("PS3_SYSUI");
+        v = (e && e[0] == '0') ? 0 : 1;
+    }
+    return v;
+}
+
+/* ---------------------------------------------------------------- state */
+enum { MODE_LIST, MODE_YESNO, MODE_NOTICE };
+
+typedef struct {
+    int mode;
+    const char* heading;
+    const char* text;                 /* yes/no question, notice text */
+    const char* hint;
+    const ps3_sysui_item* items;      /* list items, or the yes/no item */
+    int n;
+    int cursor;                       /* list row, or 0 = yes / 1 = no */
+} ui_state;
+
+/* ---------------------------------------------------------------- icons
+ * A save's ICON0.PNG, decoded with WIC (COM only -- no import library) and
+ * flattened onto the panel colour, cached for the dialog's lifetime. */
+static const GUID kClsidWicFactory = {0xcacaf262, 0x9370, 0x4615, {0xa1, 0x3b, 0x9f, 0x55, 0x39, 0xda, 0x4c, 0x0a}};
+static const GUID kIidWicFactory   = {0xec5ec8a9, 0xc395, 0x4314, {0x9c, 0x77, 0x54, 0xd7, 0xa9, 0x35, 0xff, 0x70}};
+static const GUID kWicPbgra32      = {0x6fddc324, 0x4e03, 0x4bfe, {0xb1, 0x85, 0x3d, 0x77, 0x76, 0x8d, 0xc9, 0x10}};
+
+typedef struct { char path[260]; COLORREF bg; HBITMAP bmp; HDC dc; int w, h; } icon_t;
+static icon_t s_icons[16];
+static int    s_n_icons;
+static int    s_com;             /* 1 = we initialised COM on this thread */
+
+static const icon_t* icon_get(const char* path, COLORREF bg)
+{
+    if (!path || !path[0]) return NULL;
+    for (int i = 0; i < s_n_icons; i++)
+        if (s_icons[i].bg == bg && !strcmp(s_icons[i].path, path))
+            return s_icons[i].bmp ? &s_icons[i] : NULL;
+    if (s_n_icons >= 16) return NULL;
+    icon_t* ic = &s_icons[s_n_icons++];
+    memset(ic, 0, sizeof *ic);
+    snprintf(ic->path, sizeof ic->path, "%s", path);
+    ic->bg = bg;
+    if (!s_com) { HRESULT hr = CoInitializeEx(NULL, COINIT_MULTITHREADED); s_com = (hr == S_OK || hr == S_FALSE) ? 1 : -1; }
+    IWICImagingFactory* f = NULL;
+    IWICBitmapDecoder* dec = NULL;
+    IWICBitmapFrameDecode* fr = NULL;
+    IWICFormatConverter* cv = NULL;
+    wchar_t wp[260];
+    MultiByteToWideChar(CP_UTF8, 0, path, -1, wp, 260);
+    wp[259] = 0;
+    UINT w = 0, h = 0;
+    if (FAILED(CoCreateInstance(&kClsidWicFactory, NULL, CLSCTX_INPROC_SERVER, &kIidWicFactory, (void**)&f))) goto done;
+    if (FAILED(IWICImagingFactory_CreateDecoderFromFilename(f, wp, NULL, GENERIC_READ, WICDecodeMetadataCacheOnDemand, &dec))) goto done;
+    if (FAILED(IWICBitmapDecoder_GetFrame(dec, 0, &fr))) goto done;
+    if (FAILED(IWICImagingFactory_CreateFormatConverter(f, &cv))) goto done;
+    if (FAILED(IWICFormatConverter_Initialize(cv, (IWICBitmapSource*)fr, &kWicPbgra32, WICBitmapDitherTypeNone, NULL, 0.0, WICBitmapPaletteTypeCustom))) goto done;
+    IWICFormatConverter_GetSize(cv, &w, &h);
+    if (!w || !h || w > 2048 || h > 2048) goto done;
+    {
+        BITMAPINFO bi;
+        memset(&bi, 0, sizeof bi);
+        bi.bmiHeader.biSize = sizeof bi.bmiHeader;
+        bi.bmiHeader.biWidth = (LONG)w;
+        bi.bmiHeader.biHeight = -(LONG)h;
+        bi.bmiHeader.biPlanes = 1;
+        bi.bmiHeader.biBitCount = 32;
+        void* bits = NULL;
+        HDC screen = GetDC(NULL);
+        ic->bmp = CreateDIBSection(screen, &bi, DIB_RGB_COLORS, &bits, NULL, 0);
+        ReleaseDC(NULL, screen);
+        if (!ic->bmp || FAILED(IWICFormatConverter_CopyPixels(cv, NULL, w * 4, w * h * 4, (BYTE*)bits))) {
+            if (ic->bmp) DeleteObject(ic->bmp);
+            ic->bmp = NULL;
+            goto done;
+        }
+        /* premultiplied BGRA over the background colour */
+        BYTE* px = (BYTE*)bits;
+        for (UINT i = 0; i < w * h; i++, px += 4) {
+            const unsigned a = px[3];
+            px[0] = (BYTE)(px[0] + GetBValue(bg) * (255u - a) / 255u);
+            px[1] = (BYTE)(px[1] + GetGValue(bg) * (255u - a) / 255u);
+            px[2] = (BYTE)(px[2] + GetRValue(bg) * (255u - a) / 255u);
+            px[3] = 255;
+        }
+        ic->dc = CreateCompatibleDC(NULL);
+        SelectObject(ic->dc, ic->bmp);
+        ic->w = (int)w;
+        ic->h = (int)h;
+    }
+done:
+    if (cv) IWICFormatConverter_Release(cv);
+    if (fr) IWICBitmapFrameDecode_Release(fr);
+    if (dec) IWICBitmapDecoder_Release(dec);
+    if (f) IWICImagingFactory_Release(f);
+    return ic->bmp ? ic : NULL;
+}
+
+static void icons_free(void)
+{
+    for (int i = 0; i < s_n_icons; i++) {
+        if (s_icons[i].dc) DeleteDC(s_icons[i].dc);
+        if (s_icons[i].bmp) DeleteObject(s_icons[i].bmp);
+    }
+    s_n_icons = 0;
+    if (s_com == 1) CoUninitialize();
+    s_com = 0;
+}
+
+/* Draws the icon into the box, keeping its aspect; returns the width used. */
+static int icon_draw(HDC dc, const char* path, COLORREF bg, int x, int y, int box_h)
+{
+    const icon_t* ic = icon_get(path, bg);
+    if (!ic) return 0;
+    const int bw = box_h * ic->w / ic->h;
+    SetStretchBltMode(dc, HALFTONE);
+    SetBrushOrgEx(dc, 0, 0, NULL);
+    StretchBlt(dc, x, y, bw, box_h, ic->dc, 0, 0, ic->w, ic->h, SRCCOPY);
+    return bw;
+}
+
+static HWND    s_wnd;
+static int     s_placed_reset;     /* window_place: a new window, place it again */
+static HBITMAP s_bmp;
+static HDC     s_bmp_dc;
+static int     s_w, s_h;
+
+static wchar_t* widen(const char* s, wchar_t* buf, int cap)
+{
+    buf[0] = 0;
+    if (s) MultiByteToWideChar(CP_UTF8, 0, s, -1, buf, cap);
+    buf[cap - 1] = 0;
+    return buf;
+}
+
+static LRESULT CALLBACK ui_wndproc(HWND h, UINT m, WPARAM w, LPARAM l)
+{
+    if (m == WM_PAINT) {
+        PAINTSTRUCT ps;
+        HDC dc = BeginPaint(h, &ps);
+        if (s_bmp_dc) BitBlt(dc, 0, 0, s_w, s_h, s_bmp_dc, 0, 0, SRCCOPY);
+        EndPaint(h, &ps);
+        return 0;
+    }
+    if (m == WM_MOUSEACTIVATE) return MA_NOACTIVATE;
+    return DefWindowProcW(h, m, w, l);
+}
+
+/* Panel size from the game window's client area (the game draws 1280x720
+ * and scales up; the panel keeps the same proportion of it). */
+static void panel_rect(RECT* screen, HWND game)
+{
+    RECT c = {0, 0, 1280, 720};
+    POINT o = {0, 0};
+    if (game && GetClientRect(game, &c)) ClientToScreen(game, &o);
+    int cw = c.right - c.left, ch = c.bottom - c.top;
+    if (cw < 320 || ch < 180) { cw = 1280; ch = 720; }
+    int w = cw * 62 / 100, h = ch * 66 / 100;
+    screen->left = o.x + (cw - w) / 2;
+    screen->top = o.y + (ch - h) / 2;
+    screen->right = screen->left + w;
+    screen->bottom = screen->top + h;
+}
+
+static HFONT make_font(int px, int bold)
+{
+    return CreateFontW(-px, 0, 0, 0, bold ? FW_SEMIBOLD : FW_NORMAL, 0, 0, 0, DEFAULT_CHARSET,
+                       OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS, CLEARTYPE_QUALITY,
+                       DEFAULT_PITCH | FF_SWISS, L"Segoe UI");
+}
+
+/* The PS3 button glyphs: blue cross, red circle. */
+static void draw_glyph(HDC dc, int x, int y, int sz, int circle)
+{
+    HPEN pen = CreatePen(PS_SOLID, sz / 7 + 1, circle ? RGB(235, 80, 80) : RGB(110, 160, 255));
+    HGDIOBJ op = SelectObject(dc, pen);
+    HGDIOBJ ob = SelectObject(dc, GetStockObject(NULL_BRUSH));
+    if (circle) Ellipse(dc, x, y, x + sz, y + sz);
+    else {
+        MoveToEx(dc, x + 1, y + 1, NULL); LineTo(dc, x + sz - 1, y + sz - 1);
+        MoveToEx(dc, x + sz - 1, y + 1, NULL); LineTo(dc, x + 1, y + sz - 1);
+    }
+    SelectObject(dc, ob);
+    SelectObject(dc, op);
+    DeleteObject(pen);
+}
+
+static void text_at(HDC dc, int x, int y, int w, int h, const char* s, COLORREF col, UINT fmt)
+{
+    wchar_t wb[512];
+    RECT r = {x, y, x + w, y + h};
+    SetTextColor(dc, col);
+    DrawTextW(dc, widen(s, wb, 512), -1, &r, fmt | DT_NOPREFIX | DT_END_ELLIPSIS);
+}
+
+static void ensure_bitmap(int w, int h)
+{
+    if (s_bmp && s_w == w && s_h == h) return;
+    if (s_bmp) { DeleteDC(s_bmp_dc); DeleteObject(s_bmp); s_bmp = NULL; s_bmp_dc = NULL; }
+    BITMAPINFO bi;
+    memset(&bi, 0, sizeof bi);
+    bi.bmiHeader.biSize = sizeof bi.bmiHeader;
+    bi.bmiHeader.biWidth = w;
+    bi.bmiHeader.biHeight = -h;
+    bi.bmiHeader.biPlanes = 1;
+    bi.bmiHeader.biBitCount = 32;
+    void* bits = NULL;
+    HDC screen = GetDC(NULL);
+    s_bmp = CreateDIBSection(screen, &bi, DIB_RGB_COLORS, &bits, NULL, 0);
+    s_bmp_dc = CreateCompatibleDC(screen);
+    ReleaseDC(NULL, screen);
+    SelectObject(s_bmp_dc, s_bmp);
+    s_w = w; s_h = h;
+}
+
+static void render(const ui_state* st, int w, int h)
+{
+    ensure_bitmap(w, h);
+    HDC dc = s_bmp_dc;
+    const int u = h / 24 > 8 ? h / 24 : 8;              /* text unit */
+    RECT all = {0, 0, w, h};
+    HBRUSH bg = CreateSolidBrush(RGB(14, 16, 24));
+    FillRect(dc, &all, bg);
+    DeleteObject(bg);
+    HBRUSH frame = CreateSolidBrush(RGB(96, 104, 128));
+    FrameRect(dc, &all, frame);
+    DeleteObject(frame);
+    SetBkMode(dc, TRANSPARENT);
+
+    HFONT fh = make_font(u * 3 / 2, 1), fb = make_font(u, 0), fs = make_font(u * 4 / 5, 0);
+    HGDIOBJ of = SelectObject(dc, fh);
+    const int pad = u;
+    text_at(dc, pad, pad / 2, w - 2 * pad, u * 2, st->heading, RGB(240, 240, 245), DT_LEFT | DT_VCENTER | DT_SINGLELINE);
+    HPEN line = CreatePen(PS_SOLID, 1, RGB(70, 76, 96));
+    HGDIOBJ op = SelectObject(dc, line);
+    MoveToEx(dc, pad, pad / 2 + u * 2, NULL);
+    LineTo(dc, w - pad, pad / 2 + u * 2);
+    int top = pad / 2 + u * 2 + u / 2;
+    const int foot = h - u * 2;
+    MoveToEx(dc, pad, foot - u / 3, NULL);
+    LineTo(dc, w - pad, foot - u / 3);
+    SelectObject(dc, op);
+    DeleteObject(line);
+
+    if (st->mode == MODE_LIST) {
+        const int row = u * 4;
+        const int rows = (foot - top - u / 2) / row > 0 ? (foot - top - u / 2) / row : 1;
+        int first = st->cursor - rows + 1 > 0 ? st->cursor - rows + 1 : 0;
+        for (int i = first; i < st->n && i < first + rows; i++) {
+            const int y = top + (i - first) * row;
+            const COLORREF rowbg = i == st->cursor ? RGB(36, 78, 150) : RGB(14, 16, 24);
+            if (i == st->cursor) {
+                RECT sel = {pad / 2, y, w - pad / 2, y + row - u / 4};
+                HBRUSH b = CreateSolidBrush(rowbg);
+                FillRect(dc, &sel, b);
+                DeleteObject(b);
+            }
+            const int iw = icon_draw(dc, st->items[i].icon, rowbg, pad, y + u / 4, row - u * 3 / 4);
+            const int tx = pad + (iw ? iw + u * 2 / 3 : 0);
+            SelectObject(dc, fb);
+            text_at(dc, tx, y + u / 4, w - tx - pad, u + u / 3, st->items[i].title, RGB(245, 245, 250), DT_LEFT | DT_SINGLELINE);
+            text_at(dc, tx, y + u + u / 2, w - tx - pad, u + u / 3, st->items[i].subtitle, RGB(205, 210, 220), DT_LEFT | DT_SINGLELINE);
+            SelectObject(dc, fs);
+            text_at(dc, tx, y + 2 * u + u * 2 / 3, w - tx - pad, u, st->items[i].detail, RGB(150, 156, 170), DT_LEFT | DT_SINGLELINE);
+        }
+        if (st->n > rows) {
+            char pos[32];
+            snprintf(pos, sizeof pos, "%d / %d", st->cursor + 1, st->n);
+            SelectObject(dc, fs);
+            text_at(dc, pad, foot - u * 3 / 2, w - 2 * pad, u, pos, RGB(150, 156, 170), DT_RIGHT | DT_SINGLELINE);
+        }
+    } else {
+        SelectObject(dc, fb);
+        int y = top + u;
+        if (st->items) {
+            const int ih = u * 4;
+            const icon_t* ic = icon_get(st->items->icon, RGB(14, 16, 24));
+            if (ic) {
+                icon_draw(dc, st->items->icon, RGB(14, 16, 24), (w - ih * ic->w / ic->h) / 2, y - u / 2, ih);
+                y += ih;
+            }
+            text_at(dc, pad, y, w - 2 * pad, u + u / 3, st->items->title, RGB(245, 245, 250), DT_CENTER | DT_SINGLELINE);
+            text_at(dc, pad, y + u + u / 3, w - 2 * pad, u + u / 3, st->items->subtitle, RGB(205, 210, 220), DT_CENTER | DT_SINGLELINE);
+            SelectObject(dc, fs);
+            text_at(dc, pad, y + 2 * u + u / 2, w - 2 * pad, u, st->items->detail, RGB(150, 156, 170), DT_CENTER | DT_SINGLELINE);
+            SelectObject(dc, fb);
+            y += u * 4;
+        }
+        text_at(dc, pad, y, w - 2 * pad, foot - y - u * 3, st->text, RGB(240, 240, 245), DT_CENTER | DT_WORDBREAK);
+        if (st->mode == MODE_YESNO) {
+            const int bw = u * 6, bh = u * 3 / 2, by = foot - u * 3;
+            for (int b = 0; b < 2; b++) {
+                const int bx = w / 2 + (b ? u : -u - bw);
+                RECT br = {bx, by, bx + bw, by + bh};
+                HBRUSH fill = CreateSolidBrush(b == st->cursor ? RGB(36, 78, 150) : RGB(34, 38, 52));
+                FillRect(dc, &br, fill);
+                DeleteObject(fill);
+                text_at(dc, bx, by, bw, bh, b ? "No" : "Yes", RGB(245, 245, 250), DT_CENTER | DT_VCENTER | DT_SINGLELINE);
+            }
+        }
+    }
+
+    /* footer: button hints */
+    SelectObject(dc, fs);
+    const int gy = foot + (h - foot - u) / 2, gs = u;
+    int x = w - pad;
+    const char* back = st->mode == MODE_NOTICE ? NULL : "Back";
+    const char* ok = st->mode == MODE_LIST ? (st->hint ? st->hint : "Select") : "OK";
+    char buf[64];
+    SIZE sz;
+    wchar_t wb[64];
+    if (back) {
+        snprintf(buf, sizeof buf, "%s", back);
+        widen(buf, wb, 64);
+        GetTextExtentPoint32W(dc, wb, (int)wcslen(wb), &sz);
+        x -= sz.cx;
+        text_at(dc, x, gy, sz.cx + u / 2, u + u / 2, buf, RGB(220, 222, 230), DT_LEFT | DT_SINGLELINE);
+        x -= gs + u / 3;
+        draw_glyph(dc, x, gy + 1, gs - 2, 1);
+        x -= u * 3 / 2;
+    }
+    snprintf(buf, sizeof buf, "%s", ok);
+    widen(buf, wb, 64);
+    GetTextExtentPoint32W(dc, wb, (int)wcslen(wb), &sz);
+    x -= sz.cx;
+    text_at(dc, x, gy, sz.cx + u / 2, u + u / 2, buf, RGB(220, 222, 230), DT_LEFT | DT_SINGLELINE);
+    x -= gs + u / 3;
+    draw_glyph(dc, x, gy + 1, gs - 2, 0);
+
+    SelectObject(dc, of);
+    DeleteObject(fh); DeleteObject(fb); DeleteObject(fs);
+    GdiFlush();
+}
+
+static void dump_bitmap(void)
+{
+    static const char* dir = (const char*)-1;
+    static unsigned n = 0;
+    if (dir == (const char*)-1) dir = getenv("PS3_SYSUI_DUMP");
+    if (!dir || !s_bmp) return;
+    BITMAPINFO bi;
+    memset(&bi, 0, sizeof bi);
+    bi.bmiHeader.biSize = sizeof bi.bmiHeader;
+    bi.bmiHeader.biWidth = s_w;
+    bi.bmiHeader.biHeight = -s_h;
+    bi.bmiHeader.biPlanes = 1;
+    bi.bmiHeader.biBitCount = 32;
+    const DWORD bytes = (DWORD)s_w * (DWORD)s_h * 4u;
+    void* px = malloc(bytes);
+    if (!px) return;
+    GetDIBits(s_bmp_dc, s_bmp, 0, (UINT)s_h, px, &bi, DIB_RGB_COLORS);
+    char path[MAX_PATH];
+    snprintf(path, sizeof path, "%s\\sysui_%03u.bmp", dir, n++);
+    FILE* f = fopen(path, "wb");
+    if (f) {
+        BITMAPFILEHEADER fh;
+        memset(&fh, 0, sizeof fh);
+        fh.bfType = 0x4D42;
+        fh.bfOffBits = sizeof fh + sizeof bi.bmiHeader;
+        fh.bfSize = fh.bfOffBits + bytes;
+        fwrite(&fh, sizeof fh, 1, f);
+        fwrite(&bi.bmiHeader, sizeof bi.bmiHeader, 1, f);
+        fwrite(px, 1, bytes, f);
+        fclose(f);
+        fprintf(stderr, "[sysui] panel -> %s\n", path);
+    }
+    free(px);
+}
+
+static void window_open(void)
+{
+    static int registered = 0;
+    HINSTANCE inst = GetModuleHandleW(NULL);
+    if (!registered) {
+        WNDCLASSW wc;
+        memset(&wc, 0, sizeof wc);
+        wc.lpfnWndProc = ui_wndproc;
+        wc.hInstance = inst;
+        wc.lpszClassName = L"PS3SysUiPanel";
+        wc.hCursor = LoadCursor(NULL, IDC_ARROW);
+        registered = RegisterClassW(&wc) != 0;
+    }
+    s_wnd = CreateWindowExW(WS_EX_LAYERED | WS_EX_TOPMOST | WS_EX_TOOLWINDOW | WS_EX_NOACTIVATE,
+                            L"PS3SysUiPanel", L"System", WS_POPUP, 0, 0, 16, 16,
+                            NULL, NULL, inst, NULL);
+    if (s_wnd) SetLayeredWindowAttributes(s_wnd, 0, 246, LWA_ALPHA);
+    s_placed_reset = 1;
+}
+
+static void window_close(void)
+{
+    if (s_wnd) { DestroyWindow(s_wnd); s_wnd = NULL; }
+    MSG msg;
+    while (PeekMessageW(&msg, NULL, 0, 0, PM_REMOVE)) { TranslateMessage(&msg); DispatchMessageW(&msg); }
+}
+
+/* Place the panel over the game window; hidden while the game window is
+ * minimised or hidden (PS3_WINDOW_BACKGROUND runs) -- the dialog still runs. */
+static void window_place(int* w, int* h)
+{
+    HWND game = (HWND)rsx_null_backend_get_hwnd();
+    RECT r;
+    panel_rect(&r, game);
+    *w = r.right - r.left;
+    *h = r.bottom - r.top;
+    if (!s_wnd) return;
+    static RECT last;
+    static int last_visible = -1;
+    if (s_placed_reset) { s_placed_reset = 0; last_visible = -1; }
+    const int visible = game && IsWindowVisible(game) && !IsIconic(game);
+    if (visible == last_visible && (!visible || EqualRect(&r, &last))) return;
+    last_visible = visible;
+    last = r;
+    if (visible)
+        SetWindowPos(s_wnd, HWND_TOPMOST, r.left, r.top, *w, *h, SWP_NOACTIVATE | SWP_SHOWWINDOW);
+    else
+        ShowWindow(s_wnd, SW_HIDE);
+}
+
+/* ---------------------------------------------------------------- input */
+static u16 sample_buttons(void)
+{
+    u16 b = 0;
+    for (u32 p = 0; p < 4; p++) {
+        CellPadData d;
+        if (cellPad_sample_local(p, &d) == 0 && d.len > 0)
+            b |= (u16)(d.button[CELL_PAD_BTN_OFFSET_DIGITAL1] | (d.button[CELL_PAD_BTN_OFFSET_DIGITAL2] << 8));
+    }
+    /* the keyboard on its own, focused or not on the game window */
+    HWND fg = GetForegroundWindow();
+    if (fg && fg == (HWND)rsx_null_backend_get_hwnd()) {
+        if (GetAsyncKeyState(VK_UP) & 0x8000)     b |= CELL_PAD_CTRL_UP;
+        if (GetAsyncKeyState(VK_DOWN) & 0x8000)   b |= CELL_PAD_CTRL_DOWN;
+        if (GetAsyncKeyState(VK_LEFT) & 0x8000)   b |= CELL_PAD_CTRL_LEFT;
+        if (GetAsyncKeyState(VK_RIGHT) & 0x8000)  b |= CELL_PAD_CTRL_RIGHT;
+        if (GetAsyncKeyState(VK_RETURN) & 0x8000) b |= CELL_PAD_CTRL_CROSS;
+        if ((GetAsyncKeyState(VK_ESCAPE) & 0x8000) || (GetAsyncKeyState(VK_BACK) & 0x8000))
+            b |= CELL_PAD_CTRL_CIRCLE;
+    }
+    return b;
+}
+
+/* The dialog loop. Returns 1 for CROSS, 0 for CIRCLE (and the timeout). */
+static int run(ui_state* st, unsigned timeout_ms)
+{
+    __atomic_store_n(&s_swallow_mask, 0x7FFFFFFFL, __ATOMIC_RELEASE);
+    __atomic_store_n(&s_active, 1L, __ATOMIC_RELEASE);
+    window_open();
+    const ULONGLONG t0 = GetTickCount64();
+    u16 prev = 0xFFFF;                /* every button counts as held until first released */
+    ULONGLONG rep_at = 0;
+    int w = 0, h = 0, last_cursor = -2, result = 0;
+    for (;;) {
+        window_place(&w, &h);
+        if (st->cursor != last_cursor || w != s_w || h != s_h) {
+            render(st, w, h);
+            if (s_wnd) InvalidateRect(s_wnd, NULL, FALSE);
+            dump_bitmap();
+            last_cursor = st->cursor;
+        }
+        MSG msg;
+        while (PeekMessageW(&msg, NULL, 0, 0, PM_REMOVE)) { TranslateMessage(&msg); DispatchMessageW(&msg); }
+        Sleep(15);
+
+        const u16 b = sample_buttons();
+        if (prev == 0xFFFF) { if (b == 0) prev = 0; continue; }
+        const u16 down = (u16)(b & ~prev);
+        const ULONGLONG now = GetTickCount64();
+        int step = 0;
+        if (down & (CELL_PAD_CTRL_UP | CELL_PAD_CTRL_LEFT))   { step = -1; rep_at = now + 400; }
+        if (down & (CELL_PAD_CTRL_DOWN | CELL_PAD_CTRL_RIGHT)) { step = 1;  rep_at = now + 400; }
+        if (!step && (b & (CELL_PAD_CTRL_UP | CELL_PAD_CTRL_DOWN | CELL_PAD_CTRL_LEFT | CELL_PAD_CTRL_RIGHT)) && now >= rep_at && rep_at) {
+            step = (b & (CELL_PAD_CTRL_UP | CELL_PAD_CTRL_LEFT)) ? -1 : 1;
+            rep_at = now + 110;
+        }
+        prev = b;
+        if (step && st->mode == MODE_LIST && st->n > 0)
+            st->cursor = (st->cursor + step + st->n) % st->n;
+        if (step && st->mode == MODE_YESNO)
+            st->cursor = step < 0 ? 0 : 1;
+        if (down & CELL_PAD_CTRL_CROSS)  { result = 1; break; }
+        if (down & CELL_PAD_CTRL_CIRCLE) { result = 0; break; }
+        if (timeout_ms && now - t0 >= timeout_ms) { result = 0; break; }
+    }
+    window_close();
+    icons_free();
+    __atomic_store_n(&s_active, 0L, __ATOMIC_RELEASE);
+    /* the title gets each port back once the closing press is released */
+    return result;
+}
+
+int ps3_sysui_list(const char* heading, const char* hint, const ps3_sysui_item* items, int n, int start)
+{
+    ui_state st = {MODE_LIST, heading, NULL, hint, items, n, start >= 0 && start < n ? start : 0};
+    fprintf(stderr, "[sysui] list '%s': %d item(s)\n", heading, n);
+    const int ok = run(&st, 0);
+    fprintf(stderr, "[sysui] list '%s' -> %s %d\n", heading, ok ? "picked" : "back", ok ? st.cursor : -1);
+    return ok ? st.cursor : -1;
+}
+
+int ps3_sysui_yesno(const char* heading, const char* text, const ps3_sysui_item* item, int default_yes)
+{
+    ui_state st = {MODE_YESNO, heading, text, NULL, item, 0, default_yes ? 0 : 1};
+    fprintf(stderr, "[sysui] question '%s'\n", text);
+    const int ok = run(&st, 0);
+    const int yes = ok && st.cursor == 0;
+    fprintf(stderr, "[sysui] question '%s' -> %s\n", text, yes ? "yes" : "no");
+    return yes;
+}
+
+void ps3_sysui_notice(const char* heading, const char* text, unsigned timeout_ms)
+{
+    ui_state st = {MODE_NOTICE, heading, text, NULL, NULL, 0, 0};
+    fprintf(stderr, "[sysui] notice '%s'\n", text);
+    run(&st, timeout_ms);
+}
+#endif
diff --git a/libs/system/ps3_sysui.h b/libs/system/ps3_sysui.h
new file mode 100644
index 0000000..b4f536f
--- /dev/null
+++ b/libs/system/ps3_sysui.h
@@ -0,0 +1,55 @@
+/*
+ * ps3_sysui -- the few system dialogs a title can open that must be ANSWERED
+ * by the player (the save data delete list), drawn as a small panel over the
+ * game window and driven by the pads (cellPad_sample_local) and the keyboard.
+ *
+ * Every call is modal and blocks the calling (guest) thread, as the PS3's
+ * system utilities block theirs. Windows only; elsewhere, and when
+ * PS3_SYSUI=0, ps3_sysui_available() is 0 and callers keep their headless
+ * behaviour.
+ *
+ *   PS3_SYSUI=0            no dialogs (callers fall back)
+ *   PS3_SYSUI_DUMP=<dir>   every rendered panel as sysui_NNN.bmp (tests)
+ */
+#ifndef PS3RECOMP_PS3_SYSUI_H
+#define PS3RECOMP_PS3_SYSUI_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct ps3_sysui_item {
+    char title[128];      /* first line (UTF-8)              */
+    char subtitle[128];   /* second line                     */
+    char detail[160];     /* third line, dimmer (date, size) */
+    char icon[260];       /* host path of a PNG shown with it (optional) */
+} ps3_sysui_item;
+
+int ps3_sysui_available(void);
+
+/* A list to pick from: returns the chosen index, -1 when the player backed
+ * out. `start` is the initial cursor. */
+int ps3_sysui_list(const char* heading, const char* hint,
+                   const ps3_sysui_item* items, int n, int start);
+
+/* A yes/no question about `item` (may be NULL): 1 = yes, 0 = no. */
+int ps3_sysui_yesno(const char* heading, const char* text,
+                    const ps3_sysui_item* item, int default_yes);
+
+/* A notice the player closes with CROSS/CIRCLE (or after `timeout_ms`, 0 = never). */
+void ps3_sysui_notice(const char* heading, const char* text, unsigned timeout_ms);
+
+/* cellPadGetData asks for every title read: 1 = hand the title a neutral pad
+ * on `port` (a dialog is open, or the press that closed it is still held;
+ * `buttons` is what the port holds now). */
+int ps3_sysui_pad_swallow(unsigned port, unsigned buttons);
+
+/* 1 while a dialog is open: the game window ignores Esc (it would close the
+ * game; in a dialog Esc means "back"). */
+int ps3_sysui_active(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif

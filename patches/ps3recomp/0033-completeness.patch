index 0000000..38d2cfe
--- /dev/null
+++ b/libs/system/cellWebBrowser.c
@@ -0,0 +1,53 @@
+/*
+ * ps3recomp - cellWebBrowser (sysutil web browser), "not available" model
+ *
+ * The PS3's system web browser is not part of the runtime. Before this file
+ * every cellWebBrowser import was unregistered, so the unresolved-NID default
+ * answered CELL_OK with untouched out-params: Tekken 5 DR's Options -> ONLINE
+ * MANUAL (0x20A288) went on with an uninitialised configuration and asked
+ * lv2 for a memory container sized by whatever cellWebBrowserEstimate
+ * "returned" (0 -- the container call then failed by luck).
+ *
+ * Every call here reports the utility as unavailable, so a title takes its
+ * own "the browser could not start" path before it reserves memory for it.
+ * Tekken 5 DR checks cellWebBrowserConfigSetDisableTabs first, prints its
+ * error and leaves the menu as it was; the manual's server is gone anyway
+ * (f218manual.tekken.bng.jp).
+ */
+#include "cellWebBrowser.h"
+#include "ps3emu/error_codes.h"
+#include <stdio.h>
+
+/* The web browser utility could not be loaded: CELL_ENOSYS, "not implemented
+ * on this system". Titles only test for non-zero. */
+#define CELL_WEBBROWSER_ERROR_UNAVAILABLE ((s32)0x80010003)
+
+static s32 webbrowser_unavailable(const char* fn)
+{
+    static int logged = 0;
+    if (!logged) {
+        logged = 1;
+        printf("[cellWebBrowser] %s: the PS3 web browser is not available in the native port "
+               "(the title's online manual / web pages cannot open)\n", fn);
+    }
+    return CELL_WEBBROWSER_ERROR_UNAVAILABLE;
+}
+
+s32 cellWebBrowserConfig(u32 config, u32 version)            { (void)config; (void)version; return webbrowser_unavailable("Config"); }
+s32 cellWebBrowserConfig2(u32 config, u32 version)           { (void)config; (void)version; return webbrowser_unavailable("Config2"); }
+s32 cellWebBrowserConfigWithVer(u32 config, u32 version)     { (void)config; (void)version; return webbrowser_unavailable("ConfigWithVer"); }
+s32 cellWebBrowserConfigSetDisableTabs(u32 config, u32 v)    { (void)config; (void)v; return webbrowser_unavailable("ConfigSetDisableTabs"); }
+s32 cellWebBrowserConfigSetFunction(u32 config, u32 funcset) { (void)config; (void)funcset; return webbrowser_unavailable("ConfigSetFunction"); }
+s32 cellWebBrowserConfigSetFunction2(u32 config, u32 funcset){ (void)config; (void)funcset; return webbrowser_unavailable("ConfigSetFunction2"); }
+s32 cellWebBrowserConfigSetHeapSize(u32 config, u32 size)    { (void)config; (void)size; return webbrowser_unavailable("ConfigSetHeapSize"); }
+s32 cellWebBrowserConfigSetHeapSize2(u32 config, u32 size)   { (void)config; (void)size; return webbrowser_unavailable("ConfigSetHeapSize2"); }
+s32 cellWebBrowserEstimate(u32 config)                       { (void)config; return webbrowser_unavailable("Estimate"); }
+s32 cellWebBrowserEstimate2(u32 config, u32 memSize)         { (void)config; (void)memSize; return webbrowser_unavailable("Estimate2"); }
+s32 cellWebBrowserInitialize(u32 systemCb, u32 container)    { (void)systemCb; (void)container; return webbrowser_unavailable("Initialize"); }
+s32 cellWebBrowserCreate(u32 config)                         { (void)config; return webbrowser_unavailable("Create"); }
+s32 cellWebBrowserCreate2(u32 config, u32 userData)          { (void)config; (void)userData; return webbrowser_unavailable("Create2"); }
+s32 cellWebBrowserCreateWithConfig(u32 url, u32 config)      { (void)url; (void)config; return webbrowser_unavailable("CreateWithConfig"); }
+s32 cellWebBrowserCreateWithConfigFull(u32 url, u32 config)  { (void)url; (void)config; return webbrowser_unavailable("CreateWithConfigFull"); }
+s32 cellWebBrowserDestroy(void)                              { return CELL_OK; }
+s32 cellWebBrowserDestroy2(void)                             { return CELL_OK; }
+s32 cellWebBrowserShutdown(void)                             { return CELL_OK; }

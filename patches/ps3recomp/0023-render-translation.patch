+            rsx_restart_segment_bounds(s->cuts, s->n_cuts, n_source, seg, &begin, &count);
+            if (count < 3) continue;
+            for (u32 i = 1; i + 1 < count; i++) {
+                VJ_PUT(VJ_IDX(begin));
+                VJ_PUT(VJ_IDX(begin + i));
+                VJ_PUT(VJ_IDX(begin + i + 1u));
+            }
+        }
+        break;
+    case PRIM_QUADS:
+        for (u32 q = 0; q < n_source / 4; q++) {
+            const u32 b = q * 4;
+            VJ_PUT(VJ_IDX(b)); VJ_PUT(VJ_IDX(b + 1u)); VJ_PUT(VJ_IDX(b + 2u));
+            VJ_PUT(VJ_IDX(b + 2u)); VJ_PUT(VJ_IDX(b + 3u)); VJ_PUT(VJ_IDX(b));

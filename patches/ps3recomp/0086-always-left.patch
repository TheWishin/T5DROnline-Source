+        const float y = (o[0][1] * xf[1] + o[0][3] * xf[5]) / o[0][3];
+        if (x < q.x0) { q.x0 = x; ul = o[7][0]; }
+        if (x > q.x1) { q.x1 = x; ur = o[7][0]; }

+/* SteamVirtualGamepadInfo: a file Steam writes for a game it starts with Steam
+ * Input on -- one "[slot N]" section per virtual pad it gives the game, with
+ * the VID= and PID= of the real controller behind it. Read when asked (only
+ * on a device scan): Steam rewrites it as pads come and go. */
+static int steam_virtual_for(u16 vid, u16 pid)
+{
+    const char* path = getenv("SteamVirtualGamepadInfo");
+    if (!path || !*path) return 0;
+    FILE* f = fopen(path, "rb");
+    if (!f) return 0;
+    char line[256];
+    unsigned long v = 0, p = 0;
+    int hit = 0;
+    while (!hit && fgets(line, sizeof line, f)) {
+        const char* s = line;
+        while (*s == ' ' || *s == '\t') s++;
+        if (*s == '[') { v = p = 0; continue; }             /* next slot */
+        if (!_strnicmp(s, "VID=", 4)) v = strtoul(s + 4, NULL, 0);
+        else if (!_strnicmp(s, "PID=", 4)) p = strtoul(s + 4, NULL, 0);
+        else continue;
+        hit = v == vid && p == pid;
+    }
+    fclose(f);
+    return hit;
+}

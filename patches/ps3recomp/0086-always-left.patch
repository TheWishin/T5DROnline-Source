+        xf[0] = -xf[0]; xf[4] = -xf[4];
+        *mirror = 1;
+        g_al.mirrored++;
+    } else {
+        xf[4] += dx;
+        *dx_px = dx * W * 0.5f;
+        g_al.moved++;
+    }
+}

+ *     like a PS3 on that TV. Other displays (30/50 Hz, 120/144 Hz, VRR with
+ *     RSX_PRESENT_MODE=tearing) keep the 59.94 Hz clock of patch 0031.
+ *   PS3_DISPLAY_LEAD_MS=<ms> fixes the lead (tests). */
+struct DisplayLock {
+    int cfg = -1, on = 0;
+    double qpf = 1, margin = 0, lead = 0, lead_fixed = 0;
+    long long vb = 0, per = 0;
+    double t_release = 0, lead_at_release = 0;
+    double costs[240] = {}; int ncost = 0, since = 0, recent_miss = 0;
+    double recent_max = 0;
+    unsigned misses = 0, frames = 0;
+    ULONGLONG last_check = 0, last_note = 0;
+    void init(double f)

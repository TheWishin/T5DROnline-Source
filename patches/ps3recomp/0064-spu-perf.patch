+/* ---- SPURS_JOB_HASH=1 (patch 0064): a hash of what the jobs write ----------
+ * Every PUT a SPURS job makes (address, size, bytes, in the job's own order)
+ * goes into that job's FNV-1a-64 hash; the chain walker adds its jobs' hashes
+ * up per walk -- an order-free sum, the jobs of a list run on several threads
+ * -- and prints one "[spu-hash]" line per walk (cellSpurs.c). Two builds whose
+ * jobs compute the same bytes print the same hashes for the same game frames
+ * (a lockstep pair, a replay). Off: one load and a branch per DMA. */
+volatile int g_spurs_put_hash = 0;
+static _Thread_local uint64_t s_job_hash;
+static int spurs_job_hash_env(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("SPURS_JOB_HASH"); v = e && *e == '1';
+                 if (v) g_spurs_put_hash = 1; }
+    return v;
+}
+void spurs_job_put_hash(uint32_t ea, const uint8_t* data, uint32_t size)
+{
+    if (!s_sjp_in_job) return;
+    uint64_t h = s_job_hash;
+    const uint32_t hdr[2] = { ea, size };
+    const uint8_t* p = (const uint8_t*)hdr;
+    for (int i = 0; i < 8; i++) h = (h ^ p[i]) * 1099511628211ull;
+    for (uint32_t i = 0; i < size; i++) h = (h ^ data[i]) * 1099511628211ull;
+    s_job_hash = h;
+}

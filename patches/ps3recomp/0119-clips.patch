+    check(b->Lock(&p,nullptr,nullptr));memcpy(p,bytes,size);check(b->Unlock());check(b->SetCurrentLength(size));
+    check(s->AddBuffer(b.Get()));check(s->SetSampleTime(time));check(s->SetSampleDuration(duration));
+    check(writer->WriteSample(stream,s.Get()));
+}
+class Encoder {
+public:
+    ComPtr<MemoryStream> mem;
+    ComPtr<IMFByteStream> bs;
+    ComPtr<IMFSinkWriter> writer;
+    DWORD video=0,audio=0;
+    long long start=0,end=0,audio_frames=0;
+    explicit Encoder(long long now,bool hardware):start(now) {
+        mem.Attach(new MemoryStream);
+        check(MFCreateMFByteStreamOnStream(mem.Get(),&bs));
+        auto attr=writer_attributes(hardware);
+        check(MFCreateSinkWriterFromURL(nullptr,bs.Get(),attr.Get(),&writer));
+        auto v=video_type(MFVideoFormat_H264);check(v->SetUINT32(MF_MT_AVG_BITRATE,4000000));
+        check(v->SetUINT32(MF_MT_MPEG2_PROFILE,77));check(writer->AddStream(v.Get(),&video));
+        auto a=audio_type(true);check(writer->AddStream(a.Get(),&audio));
+        auto vi=video_type(MFVideoFormat_NV12);auto ai=audio_type(false);
+        check(writer->SetInputMediaType(video,vi.Get(),nullptr));check(writer->SetInputMediaType(audio,ai.Get(),nullptr));
+        /* No B pictures avoids reorder latency; a fresh encoder starts every
+         * segment with an IDR. Optional codec controls vary by hardware. */
+        ComPtr<ICodecAPI> codec;
+        if(SUCCEEDED(writer->GetServiceForStream(video,GUID_NULL,IID_PPV_ARGS(&codec)))) {
+            VARIANT value;VariantInit(&value);value.vt=VT_UI4;value.ulVal=0;
+            codec->SetValue(&CODECAPI_AVEncMPVDefaultBPictureCount,&value);
+        }
+        check(writer->BeginWriting());
+        static bool logged=false;
+        if(!logged) {
+            ComPtr<IMFTransform> transform;ComPtr<IMFAttributes> attrs;UINT32 async=0,hw_url=0;
+            if(SUCCEEDED(writer->GetServiceForStream(video,GUID_NULL,IID_PPV_ARGS(&transform))) && SUCCEEDED(transform->GetAttributes(&attrs))) {
+                attrs->GetUINT32(MF_TRANSFORM_ASYNC,&async);
+                attrs->GetStringLength(MFT_ENUM_HARDWARE_URL_Attribute,&hw_url);
+            }
+            fprintf(stderr,"[clips] H.264 720p30 encoder ready (hardware transforms %s, asynchronous MFT %u, hardware identity %s)\n",hardware?"enabled":"disabled",async,hw_url?"reported":"unreported");
+            logged=true;
+        }
+    }
+    clips::Segment finish() {
+        check(writer->Finalize());writer.Reset();bs.Reset();
+        mem->data.shrink_to_fit();
+        clips::Segment s;s.start=start;s.end=end;s.bytes=std::move(mem->data);mem.Reset();return s;
+    }
+};
+
+/* Nearest-neighbour resize on the encoding worker, preserving aspect in a
+ * 720p letterbox. RGBA swapchain -> limited-range BT.709 NV12; no CPU conversion
+ * or MF work on the producer. NV12 also works with hardware H.264 MFTs. */
+void to_nv12(const unsigned char* rgba,unsigned sw,unsigned sh,std::vector<unsigned char>& out,unsigned pitch=0) {
+    if(!pitch)pitch=sw*4;
+    out.resize(W*H*3/2);memset(out.data(),16,W*H);memset(out.data()+W*H,128,W*H/2);
+    unsigned dw=W,dh=static_cast<unsigned>((static_cast<uint64_t>(sh)*W)/sw)&~1u;
+    if(dh>H){dh=H;dw=static_cast<unsigned>((static_cast<uint64_t>(sw)*H)/sh)&~1u;}
+    dw=std::max(dw,2u);dh=std::max(dh,2u);unsigned ox=((W-dw)/2)&~1u,oy=((H-dh)/2)&~1u;
+    for(unsigned y=0;y<dh;y+=2)for(unsigned x=0;x<dw;x+=2) {
+        int rsum=0,gsum=0,bsum=0;
+        for(unsigned j=0;j<2;j++)for(unsigned i=0;i<2;i++) {
+            unsigned sy=static_cast<uint64_t>(y+j)*sh/dh,sx=static_cast<uint64_t>(x+i)*sw/dw;
+            const auto* p=rgba+static_cast<size_t>(sy)*pitch+sx*4;int r=p[0],g=p[1],b=p[2];
+            out[(oy+y+j)*W+ox+x+i]=static_cast<unsigned char>(16+((47*r+157*g+16*b+128)>>8));
+            rsum+=r;gsum+=g;bsum+=b;
+        }
+        int r=rsum/4,g=gsum/4,b=bsum/4;size_t uv=W*H+(oy+y)/2*W+ox+x;
+        out[uv]=static_cast<unsigned char>(128+((-26*r-87*g+112*b+128)>>8));
+        out[uv+1]=static_cast<unsigned char>(128+((112*r-102*g-10*b+128)>>8));
+    }
+}
+
+/* Compressed remux: never decode/re-encode on save. Each MP4 supplies its own
+ * sequence header and starts on a keyframe. MF retains AAC decoder configuration. */
+void remux(const clips::Ring& ring,const wchar_t* path) {
+    ComPtr<IMFSinkWriter> out;auto attrs=writer_attributes(false);
+    check(MFCreateSinkWriterFromURL(path,nullptr,attrs.Get(),&out));
+    bool begun=false;DWORD dest[2]={0,0};long long origin=ring.segments().front().start;
+    for(const auto& seg:ring.segments()) {
+        ComPtr<MemoryStream> mem;mem.Attach(new MemoryStream);mem->data=seg.bytes;
+        ComPtr<IMFByteStream> bs;check(MFCreateMFByteStreamOnStream(mem.Get(),&bs));
+        ComPtr<IMFSourceReader> reader;check(MFCreateSourceReaderFromByteStream(bs.Get(),nullptr,&reader));
+        ComPtr<IMFMediaType> types[2];DWORD source[2]={static_cast<DWORD>(MF_SOURCE_READER_FIRST_VIDEO_STREAM),static_cast<DWORD>(MF_SOURCE_READER_FIRST_AUDIO_STREAM)};
+        for(unsigned i=0;i<2;i++) check(reader->GetNativeMediaType(source[i],0,&types[i]));
+        if(!begun) {
+            for(unsigned i=0;i<2;i++){check(out->AddStream(types[i].Get(),&dest[i]));check(out->SetInputMediaType(dest[i],types[i].Get(),nullptr));}
+            check(out->BeginWriting());begun=true;
+        }
+        for(unsigned i=0;i<2;i++) {
+            check(reader->SetCurrentMediaType(source[i],nullptr,types[i].Get()));
+            for(;;) {
+                DWORD actual=0,flags=0;LONGLONG t=0;ComPtr<IMFSample>s;
+                check(reader->ReadSample(source[i],0,&actual,&flags,&t,&s));
+                if(flags&MF_SOURCE_READERF_ERROR)throw Failure{E_FAIL};
+                if(s) {
+                    const LONGLONG offset=seg.start-origin;
+                    check(s->SetSampleTime(std::max<LONGLONG>(0,t)+offset));
+                    UINT64 dts=0;
+                    if(SUCCEEDED(s->GetUINT64(MFSampleExtension_DecodeTimestamp,&dts)))
+                        check(s->SetUINT64(MFSampleExtension_DecodeTimestamp,dts+offset));
+                    check(out->WriteSample(dest[i],s.Get()));
+                }
+                if(flags&MF_SOURCE_READERF_ENDOFSTREAM)break;
+            }
+        }
+    }
+    check(out->Finalize());
+}
+
+struct AudioPacket {long long time=0;unsigned frames=0;std::array<float,4096> pcm;};
+/* A borrowed mapped readback, never a full-frame CPU copy. The renderer will
+ * not recycle the resource until the worker invokes release. Move-only RAII
+ * returns a view even if conversion/encoding throws. */
+struct FrameData {
+    const unsigned char* pixels=nullptr;
+    unsigned w=0,h=0,pitch=0;
+    long long time=0;
+    void (*release)(void*)=nullptr;
+    void* context=nullptr;
+    FrameData()=default;
+    FrameData(const FrameData&)=delete;
+    FrameData& operator=(const FrameData&)=delete;
+    FrameData(FrameData&& other) noexcept {swap(other);}
+    FrameData& operator=(FrameData&& other) noexcept {
+        if(this!=&other){reset();swap(other);}return *this;
+    }
+    ~FrameData(){reset();}
+    void swap(FrameData& other) noexcept {
+        std::swap(pixels,other.pixels);std::swap(w,other.w);std::swap(h,other.h);
+        std::swap(pitch,other.pitch);std::swap(time,other.time);
+        std::swap(release,other.release);std::swap(context,other.context);
+    }
+    void reset() noexcept {
+        auto callback=release;release=nullptr;pixels=nullptr;
+        if(callback)callback(context);
+        context=nullptr;
+    }
+};
+std::atomic<bool> active{false},ready{false},stop{false},save{false};
+std::once_flag init_once;
+std::thread worker;
+HANDLE wake=nullptr;
+SRWLOCK video_lock=SRWLOCK_INIT,audio_lock=SRWLOCK_INIT;
+FrameData pending;
+bool have_frame=false;
+std::array<AudioPacket,64> audio_packets;
+unsigned audio_head=0,audio_count=0;
+
+void audio_until(Encoder& enc,long long until) {
+    long long target=(until-enc.start)*48000/SECOND;
+    if(target<=enc.audio_frames)return;
+    /* A long capture stall starts a fresh segment rather than allocating an
+     * unbounded silence block. Caller limits every segment to two seconds. */
+    target=std::min(target,static_cast<long long>(48000*3));
+    std::vector<short> pcm(static_cast<size_t>(target-enc.audio_frames)*2,0);
+    AcquireSRWLockExclusive(&audio_lock);
+    for(unsigned n=0;n<audio_count;n++) {
+        const auto& a=audio_packets[(audio_head+n)%audio_packets.size()];
+        long long at=(a.time-enc.start)*48000/SECOND;
+        long long lo=std::max(enc.audio_frames,at),hi=std::min(target,at+a.frames);
+        for(long long f=lo;f<hi;f++)for(unsigned c=0;c<2;c++) {
+            float v=a.pcm[static_cast<size_t>(f-at)*2+c];
+            if(!std::isfinite(v))v=0;
+            pcm[static_cast<size_t>(f-enc.audio_frames)*2+c]=static_cast<short>(std::max(-1.f,std::min(1.f,v))*32767.f);
+        }
+    }
+    while(audio_count) {
+        const auto& a=audio_packets[audio_head];
+        if(a.time+static_cast<long long>(a.frames)*SECOND/48000>until)break;
+        audio_head=(audio_head+1)%audio_packets.size();--audio_count;
+    }
+    ReleaseSRWLockExclusive(&audio_lock);
+    long long duration=(target-enc.audio_frames)*SECOND/48000;
+    sample(enc.writer.Get(),enc.audio,pcm.data(),static_cast<DWORD>(pcm.size()*sizeof(short)),enc.audio_frames*SECOND/48000,duration);
+    enc.audio_frames=target;
+}
+std::wstring clip_path() {
+    PWSTR folder=nullptr;check(SHGetKnownFolderPath(FOLDERID_Videos,KF_FLAG_CREATE,nullptr,&folder));
+    std::wstring dir(folder);CoTaskMemFree(folder);dir+=L"\\T5DR Online";
+    if(!CreateDirectoryW(dir.c_str(),nullptr)&&GetLastError()!=ERROR_ALREADY_EXISTS)throw Failure{HRESULT_FROM_WIN32(GetLastError())};
+    SYSTEMTIME now;GetLocalTime(&now);static unsigned counter=0;wchar_t name[128];
+    swprintf_s(name,L"\\T5DR-%04u%02u%02u-%02u%02u%02u-%03u-%lu-%u",now.wYear,now.wMonth,now.wDay,now.wHour,now.wMinute,now.wSecond,now.wMilliseconds,GetCurrentProcessId(),++counter);
+    return dir+name;
+}
+void save_ring(const clips::Ring& ring) {
+    if(ring.segments().empty()){fprintf(stderr,"[clips] no frames buffered yet\n");return;}
+    if(rsx_clips_clock()-ring.segments().back().end>2*SECOND) {
+        fprintf(stderr,"[clips] capture stalled; no recent frames to save\n");return;
+    }
+    auto base=clip_path(),temp=base+L".partial.mp4",final=base+L".mp4";
+    try {
+        remux(ring,temp.c_str());
+        if(!MoveFileW(temp.c_str(),final.c_str()))throw Failure{HRESULT_FROM_WIN32(GetLastError())};
+        fprintf(stderr,"[clips] saved %.2f s MP4 in Videos\\T5DR Online\n",(ring.segments().back().end-ring.segments().front().start)/double(SECOND));
+    } catch(...) {DeleteFileW(temp.c_str());throw;}
+}
+void run() {
+    SetThreadPriority(GetCurrentThread(),THREAD_PRIORITY_BELOW_NORMAL);
+    HRESULT co=CoInitializeEx(nullptr,COINIT_MULTITHREADED);bool mf=false;
+    try {
+        check(co);check(MFStartup(MF_VERSION,MFSTARTUP_LITE));mf=true;
+        FrameData frame;
+        auto seconds=getenv("PS3_CLIPS_SECONDS");int horizon=seconds?atoi(seconds):30;horizon=std::max(5,std::min(120,horizon));
+        bool hardware=!(getenv("PS3_CLIPS_SOFTWARE")&&atoi(getenv("PS3_CLIPS_SOFTWARE")));
+        clips::Ring ring(RING_CAP,horizon*SECOND);std::unique_ptr<Encoder> enc;
+        std::vector<unsigned char> nv12;ready=true;
+        while(!stop) {
+            if(host_sched_laptop())break; /* Auto can discover an iGPU after startup. */
+            WaitForSingleObject(wake,100);
+            if(stop)break;
+            AcquireSRWLockExclusive(&video_lock);
+            bool got=have_frame;
+            if(got){std::swap(frame,pending);have_frame=false;}
+            ReleaseSRWLockExclusive(&video_lock);
+            if(got) {
+                to_nv12(frame.pixels,frame.w,frame.h,nv12,frame.pitch);
+                frame.reset(); // release the readback before any blocking MF work
+                if(enc && (frame.time-enc->start>=2*SECOND || frame.time<enc->end-FRAME)) {
+                    // The next capture can precede the prior nominal frame end
+                    // under 60 Hz jitter. Never encode duplicate audio at the cut.
+                    if(frame.time>=enc->start)enc->end=std::min(enc->end,frame.time);
+                    audio_until(*enc,enc->end);ring.push(enc->finish());enc.reset();
+                }
+                if(!enc) {
+                    try {enc=std::make_unique<Encoder>(frame.time,hardware);}
+                    catch(const Failure&) {
+                        if(!hardware)throw;
+                        hardware=false;fprintf(stderr,"[clips] hardware path unavailable; retry software H.264\n");
+                        enc=std::make_unique<Encoder>(frame.time,false);
+                    }
+                }
+                sample(enc->writer.Get(),enc->video,nv12.data(),static_cast<DWORD>(nv12.size()),frame.time-enc->start,FRAME);
+                enc->end=frame.time+FRAME;audio_until(*enc,frame.time);
+            }
+            if(save.exchange(false)) {
+                if(enc){audio_until(*enc,enc->end);ring.push(enc->finish());enc.reset();}
+                ring.expire(rsx_clips_clock());
+                try {save_ring(ring);}catch(const Failure& f){fprintf(stderr,"[clips] save failed 0x%08lx\n",static_cast<unsigned long>(f.hr));}
+            }
+        }
+        ready=false;
+    }catch(const Failure& f){fprintf(stderr,"[clips] disabled: Media Foundation/capture error 0x%08lx\n",static_cast<unsigned long>(f.hr));}
+    catch(...){fprintf(stderr,"[clips] disabled: capture allocation/worker error\n");}
+    ready=false;active=false;
+    AcquireSRWLockExclusive(&video_lock);
+    pending.reset();have_frame=false;
+    ReleaseSRWLockExclusive(&video_lock);
+    if(mf)MFShutdown();if(SUCCEEDED(co))CoUninitialize();
+}
+void initialize() {
+    const char* enabled=getenv("PS3_CLIPS");
+    if(!enabled || strcmp(enabled,"1") || host_sched_laptop())return;
+    /* Delay-loaded MF imports: Windows N and Wine without MF must still boot. */
+    if(getenv("PS3_TEST_NO_MEDIA_FOUNDATION"))return;
+    for(const wchar_t* dll:{L"mfplat.dll",L"mfreadwrite.dll"}) {
+        HMODULE mod=LoadLibraryExW(dll,nullptr,LOAD_LIBRARY_SEARCH_SYSTEM32);if(!mod)return;
+    }
+    wake=CreateEventW(nullptr,FALSE,FALSE,nullptr);if(!wake)return;
+    try {atexit(rsx_clips_shutdown);active=true;worker=std::thread(run);}
+    catch(...){active=false;CloseHandle(wake);wake=nullptr;}
+}
+} // namespace
+extern "C" int rsx_clips_enabled(void) { std::call_once(init_once,initialize);return active.load() && !host_sched_laptop(); }
+extern "C" long long rsx_clips_clock(void) {
+    LARGE_INTEGER t,f;QueryPerformanceCounter(&t);QueryPerformanceFrequency(&f);
+    return t.QuadPart/f.QuadPart*SECOND+(t.QuadPart%f.QuadPart)*SECOND/f.QuadPart;
+}
+extern "C" int rsx_clips_video(const void* rgba,unsigned w,unsigned h,unsigned pitch,long long time,
+                                void (*release)(void*),void* context) {
+    if(!ready || !rgba || !release || !w || !h || w>MAX_W || h>MAX_H || pitch<w*4)return 0;
+    if(!TryAcquireSRWLockExclusive(&video_lock))return 0;
+    // Recheck under lock so a producer cannot publish after worker teardown.
+    if(!ready || have_frame){ReleaseSRWLockExclusive(&video_lock);return 0;}
+    pending.pixels=static_cast<const unsigned char*>(rgba);pending.w=w;pending.h=h;
+    pending.pitch=pitch;pending.time=time;pending.release=release;pending.context=context;
+    have_frame=true;
+    ReleaseSRWLockExclusive(&video_lock);SetEvent(wake);return 1;
+}
+extern "C" void rsx_clips_audio(const float* stereo,unsigned frames,long long time) {
+    if(!ready || !stereo || !frames || frames>2048)return;
+    if(!TryAcquireSRWLockExclusive(&audio_lock))return;
+    if(audio_count==audio_packets.size()){audio_head=(audio_head+1)%audio_packets.size();--audio_count;}
+    auto& a=audio_packets[(audio_head+audio_count)%audio_packets.size()];a.time=time;a.frames=frames;
+    memcpy(a.pcm.data(),stereo,frames*2*sizeof(float));++audio_count;
+    ReleaseSRWLockExclusive(&audio_lock);
+}
+extern "C" void rsx_clips_request_save(void) {if(active){save=true;SetEvent(wake);}}
+extern "C" void rsx_clips_shutdown(void) {
+    stop=true;ready=false;active=false;
+    if(wake)SetEvent(wake);
+    if(worker.joinable())worker.join();
+    if(wake){CloseHandle(wake);wake=nullptr;}
+}
+#else
+extern "C" int rsx_clips_enabled(void){return 0;}
+extern "C" long long rsx_clips_clock(void){return 0;}
+extern "C" int rsx_clips_video(const void*,unsigned,unsigned,unsigned,long long,void (*)(void*),void*){return 0;}
+extern "C" void rsx_clips_audio(const float*,unsigned,long long){}
+extern "C" void rsx_clips_request_save(void){}
+extern "C" void rsx_clips_shutdown(void){}
+#endif

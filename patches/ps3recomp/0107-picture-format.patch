+/* PS3_VIDEO_ASPECT=4:3|16:9 and PS3_VIDEO_RESOLUTION=480|576|720|1080
+ * (patch 0107, picture format): the display mode cellVideoOutGetState reports,
+ * read once. Default = what a 720p 16:9 TV reports (unchanged). Tekken 5 DR
+ * reads the aspect byte at 0x25A34C and keeps "wide = aspect != 4:3" in its
+ * display object (+0x69); docs/PICTURE_FORMAT.md says what that changes.
+ * A 4:3 TV is an SD TV on the PS3: the game's 4:3 HUD is laid out for 480
+ * lines (at 720p it lands off-centre), so PS3_VIDEO_ASPECT=4:3 alone reports
+ * 480; the present shows the picture as 4:3 and Internal resolution counts
+ * from 720 lines (cellVideoOut_report_4_3 / cellVideoOut_res_boost). */
+static int s_report_init;
+static u8  s_report_aspect = CELL_VIDEO_OUT_ASPECT_16_9;
+static void report_init(void)
+{
+    if (s_report_init) return;
+    s_report_init = 1;
+    const char* a = getenv("PS3_VIDEO_ASPECT");
+    if (a && (!strcmp(a, "4:3") || !strcmp(a, "4_3") || !strcmp(a, "43")))
+        s_report_aspect = CELL_VIDEO_OUT_ASPECT_4_3;
+    const char* r = getenv("PS3_VIDEO_RESOLUTION");
+    if (s_report_aspect == CELL_VIDEO_OUT_ASPECT_4_3 && !(r && *r))
+        r = "480";
+    if (r && *r) {
+        const int v = atoi(r);
+        const u8 id = v == 480 ? CELL_VIDEO_OUT_RESOLUTION_480 : v == 576 ? CELL_VIDEO_OUT_RESOLUTION_576 :
+                      v == 1080 ? CELL_VIDEO_OUT_RESOLUTION_1080 : CELL_VIDEO_OUT_RESOLUTION_720;
+        cellVideoOut_set_resolution(id);
+    }
+    if (s_report_aspect != CELL_VIDEO_OUT_ASPECT_16_9 || (r && *r))
+        fprintf(stderr, "[cellVideoOut] reported display mode: resolution id %u, aspect %s "
+                "(PS3_VIDEO_ASPECT / PS3_VIDEO_RESOLUTION)\n", (unsigned)s_resolution_id,
+                s_report_aspect == CELL_VIDEO_OUT_ASPECT_4_3 ? "4:3" : "16:9");
+}
+
+/* 1 when the game was told it has a 4:3 TV (PS3_VIDEO_ASPECT=4:3): the present
+ * shows its display buffers as 4:3, whatever their pixel size. */
+int cellVideoOut_report_4_3(void)
+{
+    report_init();
+    return s_report_aspect == CELL_VIDEO_OUT_ASPECT_4_3;
+}
+
+/* Internal resolution's factor counts from 720 lines: with a reported SD mode
+ * (480 / 576 lines) the display buffers are smaller, so the factor is raised by
+ * 720 / their height (Native = 720 lines again). 1 for every HD mode. */
+float cellVideoOut_res_boost(void)
+{
+    report_init();
+    if (s_resolution_id == CELL_VIDEO_OUT_RESOLUTION_480) return 1.5f;
+    if (s_resolution_id == CELL_VIDEO_OUT_RESOLUTION_576) return 1.25f;
+    return 1.0f;
+}

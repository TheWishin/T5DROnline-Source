+    const __m128i den = _mm_andnot_si128(_mm_cmpeq_epi32(x2, z), _mm_cmpeq_epi32(be, z));
+    return _mm_andnot_si128(_mm_or_si128(ext, den), _mm_set1_epi32(-1));

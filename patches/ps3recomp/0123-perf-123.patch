+/* Patch 0123: the transform constants a program can read -- what emit_src makes of a source field
+ * of register type 3 (vp_c[const_src & 511], or vp_c[(const_src + aN.c) & 511] with the instruction's
+ * index bit). Every source field of every instruction up to the end bit counts, whatever its opcode
+ * uses (a superset). mask: bit c of mask[c / 64] = constant c. */
+int rsx_vp_const_mask(const u8* ucode, u32 max_bytes, u64 mask[8])
+{

diff --git a/libs/video/rsx_picture_rect.h b/libs/video/rsx_picture_rect.h
new file mode 100644
index 0000000..2ae64d9
--- /dev/null
+++ b/libs/video/rsx_picture_rect.h
@@ -0,0 +1,122 @@
+/*
+ * Picture format (patch 0107, T5DR 1.2.0; docs/PICTURE_FORMAT.md): where the present puts the game's
+ * picture in the window. Host pixels only -- nothing the game sees changes, so two PCs of a match may
+ * choose differently.
+ *
+ *   PS3_PICTURE = fit      the whole picture, its own shape (16:9), black bars where the window has
+ *                          another shape (default, the present before 0107)
+ *               | fill     the picture enlarged until the window has no bars, its shape kept: on a 16:10
+ *                          screen 5 % of the width is cut on each side, on 3:2 7.8 %, on 4:3 12.5 %
+ *               | stretch  the whole picture pulled to the window's shape (wider or taller people)
+ *               | 4:3      the middle 4:3 of the picture, bars left and right on a wide screen (what a 4:3
+ *                          TV showed of a 16:9 game in "zoom"; the game itself has no 4:3 layout, see
+ *                          docs/PICTURE_FORMAT.md "True 4:3")
+ *
+ * One function decides the rectangles, used by the present (rsx_live_draw.c ld_present_copy) and the
+ * overlay (rsx_overlay.c): the training overlay is laid out in the 16:9 rectangle that fits the visible
+ * part, so it is never cut or stretched. Header only and pure, so tests/c/picture_rect_test.c runs it.
+ */
+#ifndef RSX_PICTURE_RECT_H
+#define RSX_PICTURE_RECT_H
+
+#include <string.h>
+
+enum { RSX_PIC_FIT = 0, RSX_PIC_FILL = 1, RSX_PIC_STRETCH = 2, RSX_PIC_43 = 3 };
+
+typedef struct {
+    /* the viewport the whole source picture is drawn into, host pixels; may reach past the window (fill)
+     * or past the visible rectangle (4:3) -- the scissor cuts it */
+    float vx, vy, vw, vh;
+    /* the visible rectangle (scissor), inside the window: left, top, right, bottom */
+    long cl, ct, cr, cb;
+    /* the overlay's canvas: the aw:ah rectangle that fits inside the visible one */
+    float ox, oy, ow, oh;
+} rsx_pic_rect;
+
+/* PS3_PICTURE's text -> mode (unknown/empty -> fit). */
+static inline int rsx_picture_mode_parse(const char* s)
+{
+    if (!s || !*s) return RSX_PIC_FIT;
+    char b[16];
+    size_t n = 0;
+    for (; s[n] && n < sizeof b - 1; n++) b[n] = (char)((s[n] >= 'A' && s[n] <= 'Z') ? s[n] + 32 : s[n]);
+    b[n] = 0;
+    if (!strcmp(b, "fill") || !strcmp(b, "zoom") || !strcmp(b, "1")) return RSX_PIC_FILL;
+    if (!strcmp(b, "stretch") || !strcmp(b, "2")) return RSX_PIC_STRETCH;
+    if (!strcmp(b, "4:3") || !strcmp(b, "43") || !strcmp(b, "4x3") || !strcmp(b, "3")) return RSX_PIC_43;
+    return RSX_PIC_FIT;
+}
+
+/* PS3_PICTURE, read once per file that asks (the present and the overlay agree: same variable) */
+#include <stdlib.h>
+static inline int rsx_picture_mode_env(void)
+{
+    static int m = -1;
+    if (m < 0) m = rsx_picture_mode_parse(getenv("PS3_PICTURE"));
+    return m;
+}
+
+static inline const char* rsx_picture_mode_name(int mode)
+{
+    return mode == RSX_PIC_FILL ? "fill" : mode == RSX_PIC_STRETCH ? "stretch" : mode == RSX_PIC_43 ? "4:3" : "fit";
+}
+
+/* the largest aw:ah rectangle inside w x h, centred at (x, y) + half the rest (the present's rounding: the
+ * origin truncated to whole pixels) */
+static inline void rsx_pic_fit(float x, float y, float w, float h, unsigned aw, unsigned ah,
+                               float* ox, float* oy, float* ow, float* oh)
+{
+    const float k = w / (float)aw < h / (float)ah ? w / (float)aw : h / (float)ah;
+    *ow = (float)aw * k;
+    *oh = (float)ah * k;
+    *ox = x + (float)(long)((w - *ow) * 0.5f);
+    *oy = y + (float)(long)((h - *oh) * 0.5f);
+}
+
+/* bw x bh = the window's backbuffer, aw x ah = the guest's display size (its shape). */
+static inline void rsx_picture_rect(int mode, unsigned bw, unsigned bh, unsigned aw, unsigned ah,
+                                    rsx_pic_rect* r)
+{
+    if (!aw || !ah) { aw = bw ? bw : 1; ah = bh ? bh : 1; }
+    const float fw = (float)bw, fh = (float)bh;
+    if (mode == RSX_PIC_STRETCH) {
+        r->vx = 0; r->vy = 0; r->vw = fw; r->vh = fh;
+        r->cl = 0; r->ct = 0; r->cr = (long)bw; r->cb = (long)bh;
+    } else if (mode == RSX_PIC_FILL) {
+        const float k = fw / (float)aw > fh / (float)ah ? fw / (float)aw : fh / (float)ah;
+        r->vw = (float)aw * k;
+        r->vh = (float)ah * k;
+        /* <= 0: the cut part is off the window; rounded to the nearest pixel, so both sides lose the same */
+        r->vx = -(float)(long)((r->vw - fw) * 0.5f + 0.5f);
+        r->vy = -(float)(long)((r->vh - fh) * 0.5f + 0.5f);
+        r->cl = 0; r->ct = 0; r->cr = (long)bw; r->cb = (long)bh;
+    } else if (mode == RSX_PIC_43 && (float)aw * 3.0f > (float)ah * 4.0f + 0.5f) {
+        /* the middle 4:3 of a wider picture, as large as the window allows */
+        const unsigned cw = (ah * 4u + 1u) / 3u;              /* 720 -> 960 */
+        float cx, cy, cwf, chf;
+        rsx_pic_fit(0, 0, fw, fh, cw, ah, &cx, &cy, &cwf, &chf);
+        const float k = chf / (float)ah;
+        r->vw = (float)aw * k;
+        r->vh = chf;
+        r->vx = cx - (float)(long)(((float)aw * k - cwf) * 0.5f);
+        r->vy = cy;
+        r->cl = (long)cx; r->ct = (long)cy;
+        r->cr = (long)(cx + cwf + 0.5f); r->cb = (long)(cy + chf + 0.5f);
+    } else {   /* fit: exactly the present before 0107 */
+        rsx_pic_fit(0, 0, fw, fh, aw, ah, &r->vx, &r->vy, &r->vw, &r->vh);
+        r->cl = (long)r->vx; r->ct = (long)r->vy;
+        r->cr = (long)(r->vx + r->vw + 0.5f); r->cb = (long)(r->vy + r->vh + 0.5f);
+    }
+    if (r->cl < 0) r->cl = 0;
+    if (r->ct < 0) r->ct = 0;
+    if (r->cr > (long)bw) r->cr = (long)bw;
+    if (r->cb > (long)bh) r->cb = (long)bh;
+    if (mode == RSX_PIC_FIT) {
+        r->ox = r->vx; r->oy = r->vy; r->ow = r->vw; r->oh = r->vh;
+    } else {
+        rsx_pic_fit((float)r->cl, (float)r->ct, (float)(r->cr - r->cl), (float)(r->cb - r->ct), aw, ah,
+                    &r->ox, &r->oy, &r->ow, &r->oh);
+    }
+}
+
+#endif

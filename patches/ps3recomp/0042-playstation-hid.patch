+/* --- PlayStation pads: HID enumeration (hot-plug thread / init only) --- */
+
+/* Does a live HID reader hold this device? Without a path (DirectInput did not
+ * name one), any reader of the same model counts. */
+static int hid_claims(const WCHAR* path, u16 vid, u16 pid)
+{
+    int held = 0;
+    AcquireSRWLockShared(&g_dev_lock);
+    for (int i = 0; i < MAX_DEVS && !held; i++) {
+        const PadDev* d = &g_dev[i];
+        if (d->kind != DEV_HID || d->lost || d->hid->fake[0]) continue;
+        held = path[0] ? !_wcsicmp(d->path, path) : (d->vid == vid && d->pid == pid);
+    }
+    ReleaseSRWLockShared(&g_dev_lock);
+    return held;
+}
+
+/* Leave a PlayStation pad to Steam Input? When Steam starts the game (or the
+ * launcher) with Steam Input on, the game gets a virtual Xbox pad for it and
+ * Steam lists the real pad in SDL_GAMECONTROLLER_IGNORE_DEVICES: reading the
+ * real one as well would make one pad two players. Only while an XInput pad is
+ * there to take its place ([general] steam_input = 0: always read it). */
+static int steam_skips(u16 vid, u16 pid)
+{
+    if (!g_cfg.steam_input || !ps_model(vid, pid) || !steam_lists(vid, pid)) return 0;
+    int xi = 0;
+    AcquireSRWLockShared(&g_dev_lock);
+    for (int i = 0; i < MAX_DEVS; i++) if (g_dev[i].kind == DEV_XINPUT && !g_dev[i].lost) xi = 1;
+    ReleaseSRWLockShared(&g_dev_lock);
+    return xi;
+}
+
+/* Paths the HID path gave up on: an open that failed counts 3 (DirectInput
+ * takes the pad at once), a reader that died while the pad is still there 1
+ * (reopened, at most twice). Forgotten when the pad is unplugged. */
+#define HID_FAIL_MAX 8
+static struct { WCHAR path[MAX_PATH]; int n; } g_hid_fail[HID_FAIL_MAX];
+
+static int hid_fails(const WCHAR* path)
+{
+    for (int i = 0; i < HID_FAIL_MAX; i++) if (g_hid_fail[i].n && !_wcsicmp(g_hid_fail[i].path, path)) return g_hid_fail[i].n;
+    return 0;
+}
+
+static void hid_fail_add(const WCHAR* path, int k)
+{
+    int free_slot = -1;
+    for (int i = 0; i < HID_FAIL_MAX; i++) {
+        if (g_hid_fail[i].n && !_wcsicmp(g_hid_fail[i].path, path)) { g_hid_fail[i].n += k; return; }
+        if (!g_hid_fail[i].n && free_slot < 0) free_slot = i;
+    }
+    if (free_slot < 0) free_slot = 0;
+    wcscpy_s(g_hid_fail[free_slot].path, MAX_PATH, path);
+    g_hid_fail[free_slot].n = k;
+}
+
+/* Add a reader for h as a new device (it is started here). */
+static void hid_add(HidDev* h, const WCHAR* path, const char* how)
+{
+    AcquireSRWLockExclusive(&g_dev_lock);
+    PadDev* d = dev_alloc();
+    if (d) {
+        d->kind = DEV_HID; d->hid = h; d->vid = h->vid; d->pid = h->pid; d->order = ++g_dev_order;
+        snprintf(d->name, sizeof d->name, "%s", h->name);
+        wcscpy_s(d->path, MAX_PATH, path);
+    }
+    ReleaseSRWLockExclusive(&g_dev_lock);
+    if (!d || !hid_start(h)) {
+        if (d) { AcquireSRWLockExclusive(&g_dev_lock); memset(d, 0, sizeof *d); ReleaseSRWLockExclusive(&g_dev_lock); }
+        hid_free(h);
+        printf("[pad] HID '%s': no room or no reader thread -- not used\n", h->name);
+        return;
+    }
+    printf("[pad] found HID '%s' %04X:%04X (%s, %s), %s\n", h->name, h->vid, h->pid, k_psm_name[h->model],
+           hid_link(h), how);
+}

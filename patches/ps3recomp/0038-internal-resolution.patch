+ * blit (letterbox, scaling, downscale filter: what the window shows) and
+ * writes it there as PPM, then deletes <file>. bb is in COPY_DEST. */
+static void ld_test_backbuffer_shot(ID3D12Resource* bb)
+{
+    static const char* req = (const char*)-1;
+    if (req == (const char*)-1) req = getenv("RSX_TEST_BB_SHOT");
+    if (!req || !req[0] || GetFileAttributesA(req) == INVALID_FILE_ATTRIBUTES) return;
+    char outp[MAX_PATH] = {0};
+    FILE* f = fopen(req, "rb");
+    if (!f) return;
+    size_t n = fread(outp, 1, sizeof outp - 1, f);
+    fclose(f);
+    while (n && (outp[n - 1] == '\n' || outp[n - 1] == '\r' || outp[n - 1] == ' ')) n--;
+    outp[n] = '\0';
+    DeleteFileA(req);
+    if (!outp[0]) return;
+    D3D12_RESOURCE_DESC bd;
+    bb->lpVtbl->GetDesc(bb, &bd);
+    const u32 width = (u32)bd.Width, height = bd.Height;
+    const u32 pitch = (width * 4u + 255u) & ~255u;
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC rd = {0};

+/* Claim key's slot (inserting it if absent). Returns the slot, NULL when full.
+ * Only the prewarm thread inserts until g_prewarm_done; after that only the
+ * walker does, so there is one writer at a time. */
+static ld_prewarm_slot* ld_prewarm_slot_for(u64 key, int insert)
+{
+    u32 s = ld_prewarm_home(key);

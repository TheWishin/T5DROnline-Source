+extern "C" uint32_t sys_ppu_thread_alloc_stack(uint32_t size) __attribute__((weak));
+
+/* A new block's address, or 0. Called with s_tls_pool_mtx held. */
+static uint32_t ppu_tls_carve(uint32_t total, const char** where)
+{
+    uint32_t lim = 0x11000000u;                 /* same bound the main block uses */
+    if (ppu_vm_size && ppu_vm_size < lim) lim = ppu_vm_size;
+    uint32_t base = PPU_TLS_IMG + total + s_tls_window_bump;  /* main block is the first */
+    if (base + total <= lim) { s_tls_window_bump += total; *where = "TLS window"; return base; }
+    /* The window is full: one block from the stack region, kept for reuse. */
+    uint32_t top = sys_ppu_thread_alloc_stack ? sys_ppu_thread_alloc_stack(total) : 0;
+    *where = "stack region";
+    return top ? top - total : 0;

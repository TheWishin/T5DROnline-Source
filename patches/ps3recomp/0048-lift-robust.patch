+# Measured on the real lift of Tekken 5 DR (22,550 functions, Windows, 2026-10-19):
+# a worker's working set peaks at 33-67 MB (bigger chunks, i.e. fewer workers,
+# need more: 8 workers 43 MB, 2 workers 67 MB) and this process at ~585 MB (it
+# ends up holding every lifted body, then writes the C++). The plan keeps a wide
+# margin over both.
+LIFT_WORKER_MB = 128
+LIFT_MAIN_MB = 1024
+# More workers start slower than they save: the whole lift took 20 s with 32
+# workers, 11-13 s with 2-16 and 17 s serial (32 processors).
+LIFT_MAX_AUTO_JOBS = 8
+LIFT_HEARTBEAT_S = 30.0         # a line at least this often while no chunk finishes
+LIFT_STALL_FACTOR = 10.0        # no chunk finished for 10x the slowest chunk so far,
+LIFT_STALL_MIN_S = 120.0        # but at least 2 and at most 10 minutes (10 before the
+LIFT_STALL_MAX_S = 600.0        # first chunk): the rest is lifted in this process
+LIFT_JOIN_S = 30.0              # a worker told to exit gets this long, then it is killed
+# The launcher reads "<n>/<m> functions" as progress: the heartbeat and the
+# notices must never contain that pattern.
+LIFT_HEARTBEAT = "  ... still lifting: {left} chunks left, elapsed {minutes:.1f}m"
+

; The C runtime functions the generated code calls, from ucrtbase.dll (part of
; Windows 10 and 11). Our own list; `llvm-lib /def:ucrt_min.def /machine:x64`
; turns it into the import library -- no Microsoft SDK file is involved.
LIBRARY ucrtbase.dll
EXPORTS
    __acrt_iob_func
    __stdio_common_vfprintf
    __stdio_common_vsprintf
    fflush
    fputc
    fputs
    puts
    fwrite
    atoi
    strtol
    strtoul
    strtoull
    getenv
    malloc
    calloc
    realloc
    free
    abort
    exit
    _aligned_malloc
    _aligned_free
    sqrt
    sqrtf
    floor
    floorf
    ceil
    ceilf
    trunc
    truncf
    round
    roundf
    rint
    rintf
    nearbyint
    nearbyintf
    fma
    fmaf
    fmod
    fmodf
    fmin
    fminf
    fmax
    fmaxf
    copysign
    copysignf
    ldexp
    frexp
    frexpf
    modf
    modff
    lrint
    lrintf
    llrint
    llrintf
    lround
    lroundf
    exp
    expf

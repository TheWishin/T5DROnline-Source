+ * Bindings and presets
+ * -----------------------------------------------------------------------*/
+
+#define BIND_MAX 160
+typedef struct { u16 src; u16 mask; } Bind;
+typedef struct {
+    Bind b[BIND_MAX]; int n;
+    s8   axis[4];            /* LX LY RX RY <- device axis, -1 = none */
+    u8   inv[4];
+    char desc[96];           /* for the log: preset + layers */
+} BindTable;
+
+/* Presets are lists of "TARGET=SOURCE SOURCE ..." lines in the config syntax. */
+typedef struct { const char* name; int cls; const char* const* lines; } Preset;

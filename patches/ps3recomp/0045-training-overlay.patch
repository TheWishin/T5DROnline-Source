+/*
+ * rsx_overlay -- text and boxes over the finished picture (patch 0045).
+ * See rsx_overlay.h for the interface.
+ *
+ * Drawing: one draw call of instanced-free quads. Every quad is 48 bytes in an
+ * upload buffer (a ring of 8 slots, so a frame the GPU may still be reading is
+ * never overwritten), read by the vertex shader as a structured buffer through
+ * a root SRV; the font is 128 glyphs x 64 bits in a constant buffer (root CBV)
+ * that the pixel shader tests bit by bit. No texture, no sampler, no
+ * shader-visible descriptor heap: the present's own heaps and root signature
+ * are left alone, and the backbuffer gets one RTV in a heap of our own.
+ * Glyph quads are placed on whole window pixels and are a whole number of
+ * window pixels per font pixel, so the text is exactly as sharp as the window.
+ *
+ * Built with -DRSX_OVERLAY_NO_D3D (tests) it is only the list, the font and
+ * the layout.
+ */
+#include "rsx_overlay.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#if defined(_WIN32)
+#  define WIN32_LEAN_AND_MEAN
+#  include <windows.h>
+#  if !defined(RSX_OVERLAY_NO_D3D)
+#    include <d3d12.h>
+#    include <d3dcompiler.h>
+#  endif
+#else
+#  include <pthread.h>
+#  include <time.h>
+#  define RSX_OVERLAY_NO_D3D 1
+#endif
+

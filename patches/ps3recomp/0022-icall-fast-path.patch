+/* Per-thread direct-mapped cache in front of ppu_lookup for the indirect-call
+ * fast path. The hash table is 3 MB of two parallel arrays, so a vtable call
+ * used to pay one or two cache misses in the lookup alone; a fight frame makes
+ * ~1000 of them on the main thread over a few hundred distinct targets, which
+ * this keeps in 16 KB. Per thread, so an entry is never read torn. */
+struct ppu_icache_ent { uint32_t addr, gen; ppu_fn fn; };
+#define PPU_ICACHE_N 1024
+static PPU_THREAD_LOCAL ppu_icache_ent g_icache[PPU_ICACHE_N];
+static inline ppu_fn ppu_lookup_cached(uint32_t a)
+{
+    const uint32_t gen = g_fn_gen.load(std::memory_order_relaxed);
+    ppu_icache_ent& e = g_icache[(a >> 2) & (PPU_ICACHE_N - 1)];
+    if (e.addr == a && e.gen == gen) return e.fn;
+    ppu_fn f = ppu_lookup(a);
+    if (f) { e.addr = a; e.gen = gen; e.fn = f; }
+    return f;
+}
+

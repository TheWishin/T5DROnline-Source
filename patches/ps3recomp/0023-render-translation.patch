+/* ---------------------------------------------------------------------------
+ * PSO disk cache (RSX_PSO_LIBRARY, default on; "0" = always create)
+ *
+ * The shader disk cache saves the HLSL compile, but every new pipeline was
+ * still a CreateGraphicsPipelineState -- the driver's own compile, 0.1-1.4 ms
+ * each, ~50 of them when a fight loads. An ID3D12PipelineLibrary keeps the
+ * driver-compiled pipelines in <shader cache dir>\pso_library.bin: a known
+ * pipeline is loaded by name (its shaders + state hashed), a new one is
+ * created and stored. The library is written back once no pipeline has been
+ * added for ~5 s (serialized on this thread, written by a short-lived one),
+ * so a killed process keeps all but its last few seconds. A library from
+ * another driver or GPU fails to open and is replaced.
+ * ------------------------------------------------------------------------- */
+static ID3D12PipelineLibrary* g_pso_lib;
+static SRWLOCK g_pso_lib_lock = SRWLOCK_INIT;   /* walker + prewarm thread */
+static int ld_pso_lib_open_locked(void);
+static int g_pso_lib_state = -1;          /* -1 unopened, 0 off, 1 on */
+static void* g_pso_lib_file_data;         /* must outlive the library */
+static u32 g_pso_lib_dirty;               /* pipelines stored since the last save */
+static u32 g_pso_lib_dirty_frame;
+static u64 g_pso_lib_hits, g_pso_lib_stores;
+static char g_pso_lib_path[MAX_PATH];
+
+static int ld_pso_lib_open(void)
+{
+    if (g_pso_lib_state >= 0) return g_pso_lib_state;
+    static SRWLOCK open_lock = SRWLOCK_INIT;   /* walker and prewarm thread */
+    AcquireSRWLockExclusive(&open_lock);
+    if (g_pso_lib_state >= 0) { ReleaseSRWLockExclusive(&open_lock); return g_pso_lib_state; }
+    const int r = ld_pso_lib_open_locked();
+    ReleaseSRWLockExclusive(&open_lock);
+    return r;
+}
+static int ld_pso_lib_open_locked(void)
+{
+    g_pso_lib_state = 0;
+    const char* e = getenv("RSX_PSO_LIBRARY");
+    if ((e && *e == '0') || !shader_disk_cache_prepare()) return 0;
+    ID3D12Device1* d1 = NULL;
+    if (FAILED(g.dev->lpVtbl->QueryInterface(g.dev, &IID_ID3D12Device1, (void**)&d1)) || !d1)
+        return 0;
+    snprintf(g_pso_lib_path, sizeof(g_pso_lib_path), "%s\\pso_library.bin", g_ld_shader_disk_dir);
+    size_t n = 0;
+    FILE* f = fopen(g_pso_lib_path, "rb");
+    if (f) {
+        fseek(f, 0, SEEK_END);
+        const long sz = ftell(f);
+        fseek(f, 0, SEEK_SET);
+        if (sz > 0 && (g_pso_lib_file_data = malloc((size_t)sz)) != NULL)
+            n = fread(g_pso_lib_file_data, 1, (size_t)sz, f);
+        fclose(f);
+    }
+    HRESULT hr = E_FAIL;
+    if (n)
+        hr = d1->lpVtbl->CreatePipelineLibrary(d1, g_pso_lib_file_data, n,
+                                               &IID_ID3D12PipelineLibrary, (void**)&g_pso_lib);
+    if (FAILED(hr)) {   /* none, or written by another driver/GPU: start over */
+        if (n) fprintf(stderr, "[pso-library] %s unusable (hr=0x%08lX), starting a new one\n",
+                       g_pso_lib_path, (unsigned long)hr);
+        free(g_pso_lib_file_data); g_pso_lib_file_data = NULL; n = 0;
+        hr = d1->lpVtbl->CreatePipelineLibrary(d1, NULL, 0, &IID_ID3D12PipelineLibrary,
+                                               (void**)&g_pso_lib);
+    }
+    d1->lpVtbl->Release(d1);
+    if (FAILED(hr) || !g_pso_lib) { g_pso_lib = NULL; return 0; }
+    fprintf(stderr, "[pso-library] %s: %zu bytes loaded\n", g_pso_lib_path, n);
+    g_pso_lib_state = 1;
+    return 1;
+}
+
+typedef struct { void* data; size_t n; char path[MAX_PATH]; } ld_pso_lib_write;
+static DWORD WINAPI ld_pso_lib_writer(LPVOID p)
+{
+    ld_pso_lib_write* w = (ld_pso_lib_write*)p;
+    char tmp[MAX_PATH + 8];
+    snprintf(tmp, sizeof(tmp), "%s.tmp", w->path);
+    FILE* f = fopen(tmp, "wb");
+    int ok = f && fwrite(w->data, 1, w->n, f) == w->n;
+    if (f) ok = (fclose(f) == 0) && ok;
+    if (ok) MoveFileExA(tmp, w->path, MOVEFILE_REPLACE_EXISTING);
+    else DeleteFileA(tmp);
+    free(w->data); free(w);
+    return 0;
+}
+
+/* Called once per presented frame. */
+static void ld_pso_lib_maybe_save(int force)
+{
+    if (g_pso_lib_state != 1 || !g_pso_lib_dirty) return;
+    if (!force && g_ld_frames - g_pso_lib_dirty_frame < 300) return;
+    if (!TryAcquireSRWLockExclusive(&g_pso_lib_lock)) return;   /* prewarm busy */
+    const SIZE_T n = g_pso_lib->lpVtbl->GetSerializedSize(g_pso_lib);
+    ld_pso_lib_write* w = (ld_pso_lib_write*)calloc(1, sizeof(*w));
+    void* data = n ? malloc(n) : NULL;
+    const int ok = w && data && SUCCEEDED(g_pso_lib->lpVtbl->Serialize(g_pso_lib, data, n));
+    ReleaseSRWLockExclusive(&g_pso_lib_lock);
+    if (!ok) { free(w); free(data); g_pso_lib_dirty = 0; return; }
+    w->data = data; w->n = n;
+    snprintf(w->path, sizeof(w->path), "%s", g_pso_lib_path);
+    fprintf(stderr, "[pso-library] saving %u new pipeline(s), %zu bytes\n",
+            g_pso_lib_dirty, (size_t)n);
+    g_pso_lib_dirty = 0;
+    if (force) { ld_pso_lib_writer(w); return; }
+    HANDLE h = CreateThread(NULL, 64 * 1024, ld_pso_lib_writer, w, 0, NULL);
+    if (h) CloseHandle(h); else ld_pso_lib_writer(w);
+}
+
+/* Create through the library: load by name, else create and store. */
+static HRESULT ld_pso_create(const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd, u64 name_hi,
+                             u64 name_lo, ID3D12PipelineState** out)
+{
+    *out = NULL;
+    if (ld_pso_lib_open()) {
+        WCHAR name[40];
+        swprintf(name, 40, L"%016llx%016llx", (unsigned long long)name_hi,
+                 (unsigned long long)name_lo);
+        AcquireSRWLockExclusive(&g_pso_lib_lock);
+        const HRESULT lr = g_pso_lib->lpVtbl->LoadGraphicsPipeline(
+            g_pso_lib, name, pd, &IID_ID3D12PipelineState, (void**)out);
+        ReleaseSRWLockExclusive(&g_pso_lib_lock);
+        if (SUCCEEDED(lr)) {
+            InterlockedIncrement64((volatile LONG64*)&g_pso_lib_hits);
+            return S_OK;
+        }
+        const HRESULT hr = g.dev->lpVtbl->CreateGraphicsPipelineState(
+            g.dev, pd, &IID_ID3D12PipelineState, (void**)out);
+        if (SUCCEEDED(hr)) {
+            AcquireSRWLockExclusive(&g_pso_lib_lock);
+            if (SUCCEEDED(g_pso_lib->lpVtbl->StorePipeline(g_pso_lib, name, *out))) {
+                g_pso_lib_stores++;
+                g_pso_lib_dirty++;
+                g_pso_lib_dirty_frame = g_ld_frames;
+            }
+            ReleaseSRWLockExclusive(&g_pso_lib_lock);
+        }
+        return hr;
+    }
+    return g.dev->lpVtbl->CreateGraphicsPipelineState(
+        g.dev, pd, &IID_ID3D12PipelineState, (void**)out);
+}
+
+/* ---------------------------------------------------------------------------
+ * PSO prewarm (RSX_PSO_PREWARM, default on; "0" = off)
+ *
+ * Even from the pipeline library a pipeline costs the driver 0.1-1 ms to
+ * create, and the first frames of a fight need ~50 new ones (~25 ms in two

+    ID3D12CommandAllocator* alloc;
+    ID3D12Resource *upload, *vb, *ib, *cb, *ps_cb;
+    u8 *upload_mapped, *vb_mapped, *cb_mapped, *ps_cb_mapped;
+    u32* ib_mapped;
+    ID3D12DescriptorHeap *srv_heap, *smp_heap;

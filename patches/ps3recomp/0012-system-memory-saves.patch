+    ensure_dirs(trash);
+    time_t now = time(NULL);
+    struct tm lt;
+#ifdef _WIN32
+    localtime_s(&lt, &now);
+#else
+    localtime_r(&now, &lt);
+#endif
+    strftime(stamp, sizeof(stamp), "%Y%m%d-%H%M%S", &lt);
+    for (int n = 0; n < 100; n++) {
+        if (n) snprintf(dst, sizeof(dst), "%s/%s.%s-%d", trash, dirName, stamp, n);
+        else   snprintf(dst, sizeof(dst), "%s/%s.%s", trash, dirName, stamp);
+#ifdef _WIN32
+        for (char* p = dst; *p; p++) if (*p == '/') *p = '\\';
+#endif
+        if (dir_exists(dst)) continue;
+        if (rename(src, dst) == 0) {
+            printf("[cellSaveData] Delete2: '%s' moved to '%s'\n", dirName, dst);
+            return 1;
+        }
+        printf("[cellSaveData] Delete2: cannot move '%s' (errno %d)\n", src, errno);
+        return 0;
+    }
+    return 0;

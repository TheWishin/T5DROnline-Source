+/* shift right by sh bytes (0..31): SPU byte i = SPU byte i - sh, zero below sh */
+static inline u128 spu__x_shrby(u128 a, uint32_t sh) {
+    uint64_t hi = SPU__X_HI(a), lo = SPU__X_LO(a);
+    sh &= 31;
+    if (sh & 16) return spu__x_q(0, 0);
+    if (sh & 8) { lo = hi; hi = 0; }
+    const unsigned n = (sh & 7) * 8;
+    return spu__x_q(hi >> n, (lo >> n) | ((hi << 1) << (63 - n)));
+}

+    const char* path = paths[which];
     *out_btns = 0; *out_lx = *out_ly = *out_rx = *out_ry = 128;
     if (!path) return;
-    static u16 s_last_file_btns;
+    static u16 s_last_btns[2];
+    u16 s_last_file_btns = s_last_btns[which];
     char buf[512]; size_t n = 0;
     FILE* f = fopen(path, "r");
     if (f) { n = fread(buf, 1, sizeof buf - 1, f); fclose(f); }
@@ -443,11 +447,17 @@ static void pad_poll_file(u16* out_btns, int* out_lx, int* out_ly, int* out_rx,
             if (!strcmp(tok, map[i].name)) btns |= map[i].btn;
     }

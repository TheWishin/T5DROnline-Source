+/* Bytes of the stream the title has put in its ring that the decoder has
+ * not consumed yet: what the title reads next, less what the decoder decodes
+ * next, a lap apart when a looping stream's reader is ahead of the decoder.
+ * Derived rather than counted, so that it follows the title's position when
+ * a rollback rewinds the title (its adds come again; counting them twice
+ * filled the ring on paper until the title had no room left and its stream
+ * reader gave up). */
+static u32 ring_fill_of(const AtracSlot* s)
+{
+    const u32 dec = s->t.data_off + (u32)s->next_frame * s->t.block_align;
+    if (s->read_pos >= dec) return s->read_pos - dec;
+    /* The title reads behind the decoder (its position followed its reader
+     * back after a rollback, docs/ROLLBACK.md 18): nothing in the ring, let
+     * it catch up -- unless it is a whole lap ahead of a looping stream's
+     * decoder, which is a long way off, not a few rings. */
+    if (dec - s->read_pos <= 16 * s->ring_size) return 0;
+    if (s->t.loop_start >= 0) {
+        const u32 lap = loop_reread_pos(s);
+        if (s->read_pos >= lap && dec <= s->file_bytes) return (s->file_bytes - dec) + (s->read_pos - lap);
+    }
+    return 0;
+}

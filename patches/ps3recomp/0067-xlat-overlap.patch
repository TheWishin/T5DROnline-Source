+/* ---- Patch 0067: the present overlaps the game's next frame -----------------
+ *
+ * A frame's critical path was: the game's commands (one flush per frame) ->
+ * the walker translates them (ticker thread) -> rsx_live_draw_present on the
+ * same thread: vertex-job drain, present copy, command-list Close +
+ * ExecuteCommandLists, DXGI Present -> the vblank tick completes the flip and
+ * releases the game. For a frame that missed its vblank (PS3_LATE_FLIP fires
+ * the tick as soon as the frame is translated) the present -- 0.5 ms at the
+ * median, 1.4-1.9 ms at p90-p99 on 4 slowed processors -- sat between the end
+ * of the translation and the game's next frame.
+ *
+ * Now (RSX_XLAT_OVERLAP=1 or 2, default 2) the walker does the part that reads
+ * guest memory -- every queued vertex fetch is drained, as the present's flush
+ * did before -- and the display's size/fullscreen sync (DXGI may need the
+ * window's own thread for those), then puts the present into the renderer
+ * thread's ring and returns: the flip completes and the game runs its next
+ * frame while the frame is submitted and presented. With 2 the walker also
+ * records every command-list call through the ring (the recorder above), so
+ * the display driver's time per call (~2,000-2,700 calls a fight frame) is
+ * spent on the renderer thread, beside the walk, not in it.
+ *
+ * Nothing the guest sees changes: the walker writes every label, report,
+ * reference and `get` of the frame when it walks them, before the flip, as
+ * before; no guest memory is read after the hand-off (the present copies host
+ * surfaces; packets carry host values); the command list gets the same calls in
+ * the same order. The renderer thread owns the renderer while the ring holds
+ * work: the walker's next walk (cellGcmSys), a mid-frame flush, a display
+ * buffer registration, shutdown -- every entry that touches the renderer --
+ * waits in ld_xo_sync first. Exclusive fullscreen presents on the walker as
+ * before (DXGI sends that window messages). RSX_XLAT_OVERLAP=0: everything on
+ * the walker, as before. */
+static int g_xo_on = -1;          /* 0 off, 1 present only, 2 present + recorded calls */
+static unsigned g_xo_last_async;  /* the last present's hand-off number, 0 = on the caller */
+
+static DWORD WINAPI ld_xo_main(LPVOID unused)
+{
+    (void)unused;
+    /* the renderer's placement (hybrid: performance cores) and never EcoQoS;
+     * the priority the present had on the ticker */
+    host_sched_thread_start(HS_ROLE_VERTEX, 0, "rsx-render");
+    if (host_sched_enabled()) SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_HIGHEST);
+    t_ld_render = 1;
+    LONGLONG r = 0;
+    for (;;) {
+        LONGLONG w = __atomic_load_n(&g_rq_w, __ATOMIC_ACQUIRE);
+        if (r == w) {
+            /* the walk records a call every few microseconds: wait a little
+             * before sleeping (WaitOnAddress wake-ups cost more than that) */
+            for (int k = 0; k < 300 && r == w; k++) {
+                _mm_pause();
+                w = __atomic_load_n(&g_rq_w, __ATOMIC_ACQUIRE);
+            }
+            if (r == w) {
+                __atomic_store_n(&g_rq_sleep, 1, __ATOMIC_SEQ_CST);
+                w = __atomic_load_n(&g_rq_w, __ATOMIC_SEQ_CST);
+                if (r == w) WaitOnAddress((volatile VOID*)&g_rq_w, &r, sizeof r, 100);
+                __atomic_store_n(&g_rq_sleep, 0, __ATOMIC_SEQ_CST);
+                continue;
+            }
+        }
+        while (r != w) {
+            const ld_rq_hdr* h = (const ld_rq_hdr*)(g_rq_buf + (u32)(r % LD_RQ_BYTES));
+            ld_rq_replay(h);
+            r += h->bytes;
+            /* consumed: room for the walker, and the end of a sync wait */
+            __atomic_store_n(&g_rq_r, r, __ATOMIC_SEQ_CST);
+            if (h->op == RQ_PRESENT && __atomic_load_n(&g_rq_waiter, __ATOMIC_SEQ_CST)) {
+                InterlockedExchange(&g_rq_waiter, 0);
+                WakeByAddressAll((PVOID)&g_rq_r);
+            }
+        }
+        if (__atomic_load_n(&g_rq_waiter, __ATOMIC_SEQ_CST)) {   /* caught up: a sync or a full ring */
+            InterlockedExchange(&g_rq_waiter, 0);
+            WakeByAddressAll((PVOID)&g_rq_r);
+        }
+    }
+    return 0;
+}
+
+int rsx_live_draw_xlat_overlap(void)
+{
+    if (g_xo_on < 0) {
+        /* 2 by default; 1 with power saving (host_sched_laptop): the recorded
+         * calls cost the renderer thread ~2 ms of processor time and hundreds
+         * of wake-ups a second for ~0.2-0.4 ms off the translation */
+        const char* e = getenv("RSX_XLAT_OVERLAP");
+        g_xo_on = e && *e == '0' ? 0 : e && *e == '1' ? 1 : e && *e == '2' ? 2 : host_sched_laptop() ? 1 : 2;
+        if (g_xo_on) {
+            g_rq_buf = (u8*)VirtualAlloc(NULL, LD_RQ_BYTES, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+            HANDLE t = g_rq_buf ? CreateThread(NULL, 512 * 1024, ld_xo_main, NULL, 0, NULL) : NULL;
+            if (t) CloseHandle(t);
+            else {
+                fprintf(stderr, "[xlat-overlap] no renderer thread (error %lu): everything stays on the "
+                                "translation thread\n", (unsigned long)GetLastError());
+                g_xo_on = 0;
+            }
+        }
+        if (g_xo_on == 2) { ld_rq_init_vtbl(); t_ld_stream = 1; }   /* this thread is the walker */
+        fprintf(stderr, g_xo_on == 2 ? "[xlat-overlap] the D3D12 calls and the present on the renderer thread, the "
+                                       "game's next frame overlaps them (RSX_XLAT_OVERLAP=1: the present only, 0: off)\n"
+                      : g_xo_on == 1 ? "[xlat-overlap] the present on the renderer thread, the game's next frame "
+                                       "overlaps it (RSX_XLAT_OVERLAP=1; 2: also the D3D12 calls, 0: off)\n"
+                                     : "[xlat-overlap] off (RSX_XLAT_OVERLAP=0): frames are recorded and presented "
+                                       "on the translation thread\n");
+    }
+    return g_xo_on;
+}
+
+/* RSX_XLAT_OVERLAP_AB=N (measurement): the frames switch every N frames
+ * between this mode and the one before it -- with 1, the present on the walker
+ * (as RSX_XLAT_OVERLAP=0) or handed off; with 2, the command-list calls
+ * recorded on the list (as 1) or through the renderer thread -- and every
+ * 1,000 frames of each kind one line compares them: the walker's processor
+ * time, the translation (flush -> flip reached) and the frame time (release
+ * -> next release), medians, and the frames over 17.5 ms. The same game under
+ * the same load, frames interleaved: differences of a tenth of a millisecond
+ * show, which paired runs on a busy PC cannot resolve. Switching is safe here:
+ * the ring holds nothing after this present, and the next walk waits for it. */
+static int g_xo_ab = -1, g_xo_ab_alt;
+static void ld_xo_ab(void)
+{
+    static long long cyc0, xl0, rel0, q0; static unsigned long long tsc0;
+    static float c[2][1000], x[2][1000], f[2][1000]; static u32 n[2], nf[2], nlate[2], nfr; static int alt0 = -1;
+    if (g_xo_ab < 0) { const char* e = getenv("RSX_XLAT_OVERLAP_AB"); g_xo_ab = e && g_xo_on ? atoi(e) : 0; }
+    if (g_xo_ab <= 0) return;
+    const long long cyc = g_rsx_pf[RSX_PF_FIFO_CYC], xl = g_rsx_pf[RSX_PF_XLAT_TICKS];
+    const long long rel = g_rsx_pf[RSX_PF_FLIPDONE_QPC], q = ld_pf_qpc();
+    const unsigned long long tsc = __rdtsc();
+    const int m = g_xo_ab_alt;
+    if (q0 && n[m] < 1000) { c[m][n[m]] = (float)(cyc - cyc0); x[m][n[m]] = (float)(xl - xl0); n[m]++; }
+    /* the frame before this one ended at this frame's release; its present was alt0's */
+    if (q0 && alt0 >= 0 && rel0 && rel > rel0 && nf[alt0] < 1000) {
+        f[alt0][nf[alt0]] = (float)(rel - rel0);
+        if ((double)(rel - rel0) * 1000.0 > 17.5 * (double)g_ld_qpc_frequency) nlate[alt0]++;
+        nf[alt0]++;
+    }
+    if (!q0) { q0 = q; tsc0 = tsc; }
+    cyc0 = cyc; xl0 = xl; rel0 = rel; alt0 = m;
+    if (++nfr % (u32)g_xo_ab == 0) g_xo_ab_alt = !g_xo_ab_alt;
+    if (g_xo_on == 2) t_ld_stream = !g_xo_ab_alt;
+    if (n[0] >= 1000 && n[1] >= 1000 && nf[0] >= 1000 && nf[1] >= 1000) {
+        const double us_per_tsc = (double)(q - q0) * 1e6 / (double)g_ld_qpc_frequency / (double)(tsc - tsc0);
+        const double us_per_qpc = 1e6 / (double)g_ld_qpc_frequency;
+        double med[2][3], mean[2];
+        for (int k = 0; k < 2; k++) {
+            double sum = 0;
+            for (u32 i = 0; i < 1000; i++) sum += f[k][i];
+            mean[k] = sum / 1000.0 * us_per_qpc / 1000.0;
+            for (int j = 0; j < 3; j++) {
+                float* a = j == 0 ? c[k] : j == 1 ? x[k] : f[k];
+                for (u32 i = 1; i < 1000; i++) {   /* insertion sort: 1,000 values a line */
+                    const float v = a[i]; u32 p = i;
+                    while (p && a[p - 1] > v) { a[p] = a[p - 1]; p--; }
+                    a[p] = v;
+                }
+                med[k][j] = (double)a[500] * (j ? us_per_qpc : us_per_tsc) / 1000.0;
+            }
+        }
+        fprintf(stderr, "[xlat-overlap] A/B every %d frames, 1000 frames each, %s / %s: walker processor time %.3f / %.3f ms, "
+                        "translation %.3f / %.3f ms, frame %.3f / %.3f ms (mean %.3f / %.3f), over 17.5 ms %u / %u\n",
+                g_xo_ab, g_xo_on == 2 ? "recorded on the list" : "present on the walker",
+                g_xo_on == 2 ? "through the renderer thread" : "present handed off",
+                med[1][0], med[0][0], med[1][1], med[0][1], med[1][2], med[0][2], mean[1], mean[0], nlate[1], nlate[0]);
+        n[0] = n[1] = nf[0] = nf[1] = nlate[0] = nlate[1] = 0;
+    }
+}
+
+void rsx_live_draw_present(u32 buffer_id)
+{
+    if (!g.ready) return;
+    g_xo_last_async = 0;
+    if (!g_xo_on) { ld_present_body(buffer_id, 0); return; }
+    ld_vjob_drain();                  /* the frame's last guest-memory reads: before its flip completes */
+    ld_display_sync();                /* resize / fullscreen switch: here, on the window's thread (it
+                                         takes the list over from the renderer thread when it flushes) */
+    if (g_ldp.fs_exclusive || (g_xo_on == 1 && g_xo_ab > 0 && g_xo_ab_alt)) {
+        g_xo_inline++;
+        ld_own_enter();
+        ld_present_body(buffer_id, 1);
+        ld_own_leave();
+        ld_xo_ab();
+        return;
+    }
+    ((rq_u32*)ld_rq_put(RQ_PRESENT, sizeof(rq_u32)))->v = buffer_id;
+    g_xo_present_end = g_rq_wl;
+    g_xo_async++;
+    g_xo_last_async = (unsigned)g_xo_async;
+    ld_rq_publish();
+    if (__atomic_load_n(&g_rq_sleep, __ATOMIC_SEQ_CST)) ld_rq_wake();
+    ld_xo_ab();
+    { static int hl = -1; if (hl < 0) hl = getenv("RSX_HITCH_LOG") ? 1 : 0;
+      if (hl && (g_xo_async % 600u) == 0)
+          fprintf(stderr, "[xlat-overlap] presents handed off %llu, on this thread %llu; packets %.0f a frame, "
+                          "ring full %llu times; waits for the renderer thread %llu (%llu over 1 ms, %.1f ms in all)\n",
+                  (unsigned long long)g_xo_async, (unsigned long long)g_xo_inline,
+                  (double)g_rq_packets / (double)(g_xo_async + g_xo_inline), (unsigned long long)g_rq_full_waits,
+                  (unsigned long long)g_xo_waits, (unsigned long long)g_xo_waits_long,
+                  g_ld_qpc_frequency > 0 ? (double)g_xo_wait_ticks * 1000.0 / (double)g_ld_qpc_frequency : 0.0); }
+}
+
+unsigned rsx_live_draw_present_async(void) { return g_xo_last_async; }
+
+void rsx_live_draw_xo_info(long long* end_qpc, unsigned* done, long long* wait_ticks)
+{
+    *end_qpc = g_xo_end_qpc;
+    *done = (unsigned)g_xo_done;
+    *wait_ticks = g_xo_wait_ticks;
+}

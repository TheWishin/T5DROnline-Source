+/* Patch 0076: what the GPU was doing when it stopped (docs/RENDER_PERF.md "A GPU
+ * hang on the integrated Radeon"). Each command list is named after its frame and
+ * fence value before it is submitted (DRED prints the name of every list the GPU
+ * had not finished), and a wait of a second for the GPU, and the loss itself, log
+ * which list the GPU finished last, how long ago the last list was submitted and
+ * the last Present returned, and the video memory in use. Logging only. */
+static struct {
+    u64 sub_fence[8]; u32 sub_frame[8]; LONGLONG sub_qpc[8];   /* the last submissions */
+    u64 done; LONGLONG done_qpc;          /* the highest completed fence value seen, when */
+    LONGLONG present_qpc0, present_qpc1;  /* the last Present call */
+    u32 present_frame, waits_logged;
+    u64 wait_logged;                      /* fence value the one-second note named */
+    IDXGIAdapter3* adapter;
+} g_ld_gs;
+
+static double ld_gs_ms(LONGLONG from, LONGLONG to)
+{
+    static LONGLONG f;
+    if (!f) { LARGE_INTEGER q; QueryPerformanceFrequency(&q); f = q.QuadPart ? q.QuadPart : 1; }
+    return from && to >= from ? (double)(to - from) * 1000.0 / (double)f : -1.0;
+}
+
+static u32 ld_gs_frame_of(u64 v)
+{
+    for (u32 i = 0; i < 8; i++) if (g_ld_gs.sub_fence[i] == v && v) return g_ld_gs.sub_frame[i];
+    return 0;
+}
+
+static void ld_gs_frame_text(char* out, size_t n, u64 v)
+{
+    const u32 f = ld_gs_frame_of(v);
+    if (f) snprintf(out, n, "frame %u", f);
+    else snprintf(out, n, "an older frame");
+}
+
+static void ld_gs_completed(u64 done)
+{
+    if (done != UINT64_MAX && done > g_ld_gs.done) { g_ld_gs.done = done; g_ld_gs.done_qpc = ld_pf_qpc(); }
+}
+
+/* The fence's completed value, noted for the reports below (begin-recording's check). */
+static u64 ld_gs_fence_done(void)
+{
+    const u64 done = g.fence->lpVtbl->GetCompletedValue(g.fence);
+    ld_gs_completed(done);
+    return done;
+}
+
+/* Called with the list closed, right before ExecuteCommandLists. */
+static void ld_gs_submit(u64 v)
+{
+    wchar_t name[64];
+    swprintf(name, 64, L"rsx frame %u fence %llu", g_ld_frames, (unsigned long long)v);
+    g.list->lpVtbl->SetName(g.list, name);
+    const u32 i = (u32)(v & 7u);
+    g_ld_gs.sub_fence[i] = v; g_ld_gs.sub_frame[i] = g_ld_frames; g_ld_gs.sub_qpc[i] = ld_pf_qpc();
+}
+
+static void ld_gs_report(const char* where, const char* what, u64 waiting_for)
+{
+    const LONGLONG now = ld_pf_qpc();
+    const u64 last = g.fence_value;
+    if (g.fence) (void)ld_gs_fence_done();   /* UINT64_MAX once removed: the last value seen stays */
+    char mem[160] = "unknown";
+    if (g_ld_gs.adapter) {
+        DXGI_QUERY_VIDEO_MEMORY_INFO l = {0}, s = {0};
+        if (SUCCEEDED(g_ld_gs.adapter->lpVtbl->QueryVideoMemoryInfo(g_ld_gs.adapter, 0, DXGI_MEMORY_SEGMENT_GROUP_LOCAL, &l)) &&
+            SUCCEEDED(g_ld_gs.adapter->lpVtbl->QueryVideoMemoryInfo(g_ld_gs.adapter, 0, DXGI_MEMORY_SEGMENT_GROUP_NON_LOCAL, &s)))
+            snprintf(mem, sizeof mem, "local %llu MB of a %llu MB budget, shared %llu MB of %llu MB",
+                     (unsigned long long)(l.CurrentUsage >> 20), (unsigned long long)(l.Budget >> 20),
+                     (unsigned long long)(s.CurrentUsage >> 20), (unsigned long long)(s.Budget >> 20));
+    }
+    char fw[24], fl[24], fd[24];
+    ld_gs_frame_text(fw, sizeof fw, waiting_for);
+    ld_gs_frame_text(fl, sizeof fl, last);
+    ld_gs_frame_text(fd, sizeof fd, g_ld_gs.done);
+    fprintf(stderr,
+            "[gpu] %s at %s: waiting for the list of %s (fence %llu); the last list submitted: %s (fence %llu) "
+            "%.0f ms ago; the GPU had finished fence %llu (%s) when checked %.0f ms ago; the last Present "
+            "(frame %u) returned %.0f ms ago after %.1f ms; video memory: %s\n",
+            what, where, fw, (unsigned long long)waiting_for, fl, (unsigned long long)last,
+            ld_gs_ms(g_ld_gs.sub_qpc[last & 7u], now), (unsigned long long)g_ld_gs.done, fd,
+            ld_gs_ms(g_ld_gs.done_qpc, now), g_ld_gs.present_frame, ld_gs_ms(g_ld_gs.present_qpc1, now),
+            ld_gs_ms(g_ld_gs.present_qpc0, g_ld_gs.present_qpc1), mem);
+    fflush(stderr);
+}

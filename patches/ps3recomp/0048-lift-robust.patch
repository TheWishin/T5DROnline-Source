+def _worker_main(conn, initargs, tasks):
+    """A lift worker: a chunk number in, ("ok", chunk, result, seconds, peak
+    memory) out; None = exit. An exception goes back as ("error", chunk, text)."""
+    k = None
+    try:
+        _worker_init(*initargs)
+        while True:
+            k = conn.recv()
+            if k is None:
+                break
+            if _test_hook("T5DR_LIFT_TEST_KILL", k):
+                os._exit(1)                   # as if killed (memory, antivirus, crash)
+            if _test_hook("T5DR_LIFT_TEST_HANG", k):
+                while True:
+                    time.sleep(60)
+            t = time.time()
+            res = _worker_lift(tasks[k])
+            conn.send(("ok", k, res, time.time() - t, _peak_memory_bytes()))
+    except (EOFError, OSError, KeyboardInterrupt):
+        pass                                  # the parent is gone or stops us
+    except BaseException:                     # noqa: B036 -- report anything, the parent decides
+        import traceback
+        try:
+            conn.send(("error", k, traceback.format_exc()))
+        except Exception:
+            pass
+    finally:
+        try:
+            conn.close()
+        except OSError:
+            pass
+
+
+class _LiftWorker:
+    def __init__(self, num, proc, conn):
+        self.num, self.proc, self.conn = num, proc, conn
+        self.k = None           # the chunk it is lifting
+        self.gone = False       # dead, failed or stopped: never sent anything again
+
+
+def _stop_workers(workers):
+    """Every worker exits, within LIFT_JOIN_S: a busy one is killed at once (its
+    chunk is lifted elsewhere), an idle one gets None and is killed only if it
+    has not exited in time. Never Pool.terminate() (see above)."""
+    for w in workers:
+        if w.k is not None or w.gone:
+            if w.proc.is_alive():
+                w.proc.kill()
+            w.k = None
+        else:
+            try:
+                w.conn.send(None)
+            except (OSError, ValueError):
+                pass
+    deadline = time.time() + LIFT_JOIN_S
+    for w in workers:
+        w.proc.join(max(0.0, deadline - time.time()))
+        if w.proc.is_alive():
+            print(f"  parallel lift: worker process {w.num} did not exit, stopping it", flush=True)
+            w.proc.kill()
+            w.proc.join(10)
+        try:
+            w.conn.close()
+        except OSError:
+            pass

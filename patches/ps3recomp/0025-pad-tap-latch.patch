+/* Directions in a read = held ones + latched ones; the port's SOCD rule
+ * decides an opposing pair (held left + a left-over tap of right). */
+static u16 socd_merge(u16 cur, u16 extra, int mode)
+{
+    u16 out = cur | extra;
+    if (mode == SOCD_OFF) return out;
+    const u16 pair[2] = { DIRS_LR, DIRS_UD };
+    for (int k = 0; k < 2; k++) {
+        if ((out & pair[k]) != pair[k]) continue;
+        if (mode == SOCD_UP && k == 1) { out &= (u16)~CELL_PAD_CTRL_DOWN; continue; }
+        if (mode == SOCD_LAST && (extra & pair[k]) && (extra & pair[k]) != pair[k]) {
+            out = (u16)((out & ~pair[k]) | (extra & pair[k]));   /* the tap is the newer press */
+            continue;
+        }
+        out &= (u16)~pair[k];                                     /* neutral */
+    }
+    return out;
+}
+
+/* Hand reader `r` the newest sample plus its latched presses, then clear its
+ * latch. Port lock held. */
+static void deliver_locked(u32 port, PortState* ps, int r, LONGLONG now, PadHostPort* out)
+{
+    PadHostPort o = ps->last;
+    o.tapped = 0;
+    u16 lat = ps->latch[r];
+    if (lat) {
+        /* A press the reader did not pick up in time (it stopped reading:
+         * loading, netplay not started yet) is history, not input. */
+        const LONGLONG max_age = qpc_from_us((u64)g_cfg.tap_max_age_ms * 1000u);
+        for (int b = 0; b < 16; b++)
+            if (((lat >> b) & 1) && now - ps->edge_t[r][b] > max_age) {
+                lat &= (u16)~(1u << b);
+                if (!(o.buttons & (1u << b))) ps->tap_stale[r]++;
+            }
+        const u16 extra = (u16)(lat & ~o.buttons);
+        if (extra) {
+            const u16 b = socd_merge(o.buttons, extra, g_cfg.port[port].socd);
+            o.tapped = (u16)(b & ~o.buttons);
+            o.buttons = b;
+            if ((o.tapped & CELL_PAD_CTRL_L2) && !o.l2) o.l2 = 255;
+            if ((o.tapped & CELL_PAD_CTRL_R2) && !o.r2) o.r2 = 255;
+            const u16 md = o.tapped & ps->latch_mirror[r];
+            if (md && o.lx == 128 && o.ly == 128) {
+                if (md & CELL_PAD_CTRL_LEFT)  o.lx = 0;
+                if (md & CELL_PAD_CTRL_RIGHT) o.lx = 255;
+                if (md & CELL_PAD_CTRL_UP)    o.ly = 0;
+                if (md & CELL_PAD_CTRL_DOWN)  o.ly = 255;
+            }
+            if (o.tapped) ps->tap_held[r]++;
+        }
+    }
+    ps->latch[r] = 0;
+    ps->latch_mirror[r] = 0;
+    ps->rout[r] = o;
+    ps->rhave[r] = 1;
+    *out = o;
+}

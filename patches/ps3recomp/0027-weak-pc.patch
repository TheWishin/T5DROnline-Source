+ * every processor even under an affinity mask, so a pool sized from it
+ * oversubscribes a limited process (32 threads' worth of workers on 4). */
+static INIT_ONCE s_budget_once = INIT_ONCE_STATIC_INIT;
+static int s_bud_cpus = 1, s_bud_cores = 1;
+
+static BOOL CALLBACK hs_budget_once(PINIT_ONCE once, PVOID param, PVOID* ctx)
+{
+    (void)once; (void)param; (void)ctx;
+    DWORD_PTR pm = 0, sm = 0;
+    if (!GetProcessAffinityMask(GetCurrentProcess(), &pm, &sm) || !pm) {
+        SYSTEM_INFO si; GetSystemInfo(&si);
+        pm = si.dwActiveProcessorMask;
+    }
+    int n = 0;
+    for (DWORD_PTR m = pm; m; m &= m - 1) n++;
+    int cores = 0, smt = 0;
+    DWORD len = 0;
+    GetLogicalProcessorInformation(NULL, &len);
+    SYSTEM_LOGICAL_PROCESSOR_INFORMATION* li = len ? (SYSTEM_LOGICAL_PROCESSOR_INFORMATION*)malloc(len) : NULL;
+    if (li && GetLogicalProcessorInformation(li, &len)) {
+        for (DWORD i = 0; i < len / sizeof *li; i++)
+            if (li[i].Relationship == RelationProcessorCore) {
+                if (li[i].ProcessorMask & pm) cores++;
+                if (li[i].ProcessorCore.Flags) smt = 1;      /* SMT siblings */
+            }
+    }
+    free(li);
+    if (cores <= 0 || cores > n) cores = n;
+    const char* e = getenv("PS3_CPUS");
+    if (e && atoi(e) > 0) {
+        n = atoi(e);
+        cores = smt && n > 1 ? (n + 1) / 2 : n;
+    }
+    s_bud_cpus = n > 0 ? n : 1;
+    s_bud_cores = cores > 0 ? cores : 1;
+    return TRUE;
+}
+int host_sched_cpus(void)
+{
+    InitOnceExecuteOnce(&s_budget_once, hs_budget_once, NULL, NULL);
+    return s_bud_cpus;
+}
+int host_sched_cores(void)
+{
+    InitOnceExecuteOnce(&s_budget_once, hs_budget_once, NULL, NULL);
+    return s_bud_cores;
+}

+}
+SPU__SX_INLINE int spu__sx_all4(__m128i m) { return _mm_movemask_ps(_mm_castsi128_ps(m)) == 0xF; }
+#define SPU__SX_LANES(v, m) uint32_t m[4]; _mm_storeu_si128((__m128i*)m, v)
+SPU__SX_SLOW __m128i spu__sx_fa_fix(__m128i r, __m128i ok, __m128i a, __m128i b, uint32_t negb) {
+    SPU__SX_LANES(r, o); SPU__SX_LANES(ok, m); SPU__SX_LANES(a, x); SPU__SX_LANES(b, y);
+    for (int i = 0; i < 4; i++) if (!m[i]) o[i] = spu__fa_any(x[i], y[i] ^ negb);
+    return _mm_loadu_si128((const __m128i*)o);
+}
+SPU__SX_SLOW __m128i spu__sx_fm_fix(__m128i r, __m128i ok, __m128i a, __m128i b) {
+    SPU__SX_LANES(r, o); SPU__SX_LANES(ok, m); SPU__SX_LANES(a, x); SPU__SX_LANES(b, y);
+    for (int i = 0; i < 4; i++) if (!m[i]) o[i] = spu__fm_any(x[i], y[i]);
+    return _mm_loadu_si128((const __m128i*)o);
+}
+SPU__SX_SLOW __m128i spu__sx_fma_fix(__m128i r, __m128i ok, __m128i a, __m128i b, __m128i c,
+                                     uint32_t negp, uint32_t negc) {
+    SPU__SX_LANES(r, o); SPU__SX_LANES(ok, m); SPU__SX_LANES(a, x); SPU__SX_LANES(b, y); SPU__SX_LANES(c, z);
+    for (int i = 0; i < 4; i++) if (!m[i]) o[i] = spu__fma_any(x[i], y[i], z[i], negp, negc);
+    return _mm_loadu_si128((const __m128i*)o);
+}
+SPU__SX_INLINE u128 spu__sx_fa(u128 a, u128 b, uint32_t negb) {
+    const __m128i xa = spu__sx_ld(a), yb = spu__sx_ld(b);
+    const __m128i x = xa, y = _mm_xor_si128(yb, _mm_set1_epi32((int)negb));
+    /* the exponent-gap limit applies only between two nonzero terms */
+    const __m128i gap = _mm_cmplt_epi32(_mm_abs_epi32(_mm_sub_epi32(spu__sx_bexp(x), spu__sx_bexp(y))), _mm_set1_epi32(30));
+    const __m128i pre = _mm_and_si128(_mm_and_si128(spu__sx_plain0(x), spu__sx_plain0(y)),
+                                      _mm_or_si128(gap, _mm_or_si128(spu__sx_iszero(x), spu__sx_iszero(y))));
+    __m128i ok;
+    __m128i r = spu__sx_trunc0(_mm_add_pd(spu__sx_lo(x), spu__sx_lo(y)), _mm_add_pd(spu__sx_hi(x), spu__sx_hi(y)),
+                               &ok, NULL, NULL);
+    ok = _mm_and_si128(ok, pre);
+    if (!spu__sx_all4(ok)) r = spu__sx_fa_fix(r, ok, xa, yb, negb);
+    return spu__sx_st(r);
+}
+SPU__SX_INLINE u128 spu_fa(u128 a, u128 b) { return spu__sx_fa(a, b, 0); }
+SPU__SX_INLINE u128 spu_fs(u128 a, u128 b) { return spu__sx_fa(a, b, 0x80000000u); }
+SPU__SX_INLINE u128 spu_fm(u128 a, u128 b) {
+    const __m128i x = spu__sx_ld(a), y = spu__sx_ld(b);
+    __m128i ok;
+    __m128i r = spu__sx_trunc0(_mm_mul_pd(spu__sx_lo(x), spu__sx_lo(y)), _mm_mul_pd(spu__sx_hi(x), spu__sx_hi(y)),
+                               &ok, NULL, NULL);
+    ok = _mm_and_si128(ok, _mm_and_si128(spu__sx_plain0(x), spu__sx_plain0(y)));
+    if (!spu__sx_all4(ok)) r = spu__sx_fm_fix(r, ok, x, y);
+    return spu__sx_st(r);
+}
+/* (+-a*b) + (+-c): the product is exact in double; TwoSum gives the add's exact error. */
+SPU__SX_INLINE __m128d spu__sx_twosum(__m128d p, __m128d z, __m128d* err) {
+    const __m128d s = _mm_add_pd(p, z), bb = _mm_sub_pd(s, p);
+    *err = _mm_add_pd(_mm_sub_pd(p, _mm_sub_pd(s, bb)), _mm_sub_pd(z, bb));
+    return s;
+}
+SPU__SX_INLINE u128 spu__sx_fma(u128 a, u128 b, u128 c, uint32_t negp, uint32_t negc) {
+    const __m128i xa = spu__sx_ld(a), y = spu__sx_ld(b), zc = spu__sx_ld(c);
+    const __m128i x = _mm_xor_si128(xa, _mm_set1_epi32((int)negp)), z = _mm_xor_si128(zc, _mm_set1_epi32((int)negc));
+    __m128d elo, ehi;
+    const __m128d slo = spu__sx_twosum(_mm_mul_pd(spu__sx_lo(x), spu__sx_lo(y)), spu__sx_lo(z), &elo);
+    const __m128d shi = spu__sx_twosum(_mm_mul_pd(spu__sx_hi(x), spu__sx_hi(y)), spu__sx_hi(z), &ehi);
+    __m128i ok;
+    __m128i r = spu__sx_trunc0(slo, shi, &ok, &elo, &ehi);
+    ok = _mm_and_si128(ok, _mm_and_si128(_mm_and_si128(spu__sx_plain0(x), spu__sx_plain0(y)), spu__sx_plain0(z)));
+    if (!spu__sx_all4(ok)) r = spu__sx_fma_fix(r, ok, xa, y, zc, negp, negc);
+    return spu__sx_st(r);
+}
+SPU__SX_INLINE u128 spu_fma(u128 a, u128 b, u128 c)  { return spu__sx_fma(a, b, c, 0, 0); }            /* a*b + c */
+SPU__SX_INLINE u128 spu_fms(u128 a, u128 b, u128 c)  { return spu__sx_fma(a, b, c, 0, 0x80000000u); }  /* a*b - c */
+SPU__SX_INLINE u128 spu_fnms(u128 a, u128 b, u128 c) { return spu__sx_fma(a, b, c, 0x80000000u, 0); }  /* c - a*b */
 #else
 static inline u128 spu_fa(u128 a, u128 b) { return spu__fa_s(a, b); }
 static inline u128 spu_fs(u128 a, u128 b) { return spu__fs_s(a, b); }

+/* ---------------------------------------------------------------------------
+ * PlayStation pads read directly: DualShock 4 (054C:05C4, 054C:09CC),
+ * DualSense (054C:0CE6), DualSense Edge (054C:0DF2)
+ *
+ * DirectInput reads these through their HID report descriptor, which
+ * describes report 0x01 only. Over Bluetooth a pad starts out sending a short
+ * "simple" report 0x01. Once a program asks it for more (Steam with
+ * "PlayStation Controller Support", DS4Windows, anything that reads motion or
+ * sets the light bar), it sends the extended report instead -- 0x11 on a
+ * DualShock 4, 0x31 on a DualSense -- until it is switched off or
+ * reconnected. The descriptor calls that report vendor-defined, so DirectInput
+ * (and joy.cpl, WinMM and every DirectInput game) gets no input at all: the
+ * pad "only works through Steam". Over USB the full report 0x01 is the only
+ * one, and DirectInput reads it.
+ *
+ * So these pads are opened as HID devices (setupapi + hid.dll) and their input
+ * reports parsed here, in every mode ([0] = report ID):
+ *
+ *   ID       pad, link       bytes   layout
+ *   0x01     DS4 USB         64      [1..4] LX LY RX RY  [5..7] buttons  [8] L2  [9] R2  (then motion...)
+ *   0x01     DS4 BT simple   10      the same first 10 bytes
+ *   0x11     DS4 BT extended 78      [1] flags (0x80: input data present)  [2] -  then the USB layout
+ *                                    from [3]: [3..6] sticks [7..9] buttons [10] L2 [11] R2
+ *   0x12-19  DS4 BT + audio  142-547 as 0x11 (only while audio is streamed to the pad)
+ *   0x01     DS USB          64      [1..4] sticks  [5] L2  [6] R2  [7] counter  [8..10] buttons
+ *   0x01     DS BT simple    10      the DS4 layout: [1..4] sticks [5..7] buttons [8] L2 [9] R2
+ *   0x31     DS BT extended  78      [1] sequence  then the USB layout from [2]: [2..5] sticks
+ *                                    [6] L2 [7] R2 [8] counter [9..11] buttons
+ *
+ * The three button bytes are the same in all of them: byte 0 = hat in the low
+ * nibble (0 = up, clockwise in eighths to 7 = up-left, 8 = centred) + square
+ * cross circle triangle in bits 4-7; byte 1 = L1 R1 L2 R2 share/create options
+ * L3 R3; byte 2 = PS, touchpad click, mute (DualSense full reports only; the
+ * other bits of the DS4's and of the simple reports are a counter), and on a
+ * DualSense Edge bits 4-7 = left Fn, right Fn, left paddle, right paddle.
+ * Sticks and triggers are 0..255; sticks centre at 128, up/left = 0.
+ * Windows hands every report over padded to the device's longest one
+ * (InputReportByteLength: 64 over USB, 78 for a DualSense and 547 for a DS4 on
+ * Bluetooth), which is how a DualSense's simple 0x01 is told from its USB 0x01.
+ *
+ * Bluetooth extended reports end in a CRC-32 (the zlib / IEEE 802.3 one) of
+ * the byte 0xA1 (Bluetooth HID "input" header) followed by the report up to
+ * the CRC, little-endian. Output reports would use 0xA2 -- but nothing is
+ * ever sent to the pad: no output report, and no feature report read either
+ * (reading the calibration or pairing feature report is what switches a
+ * Bluetooth pad to the extended report), so it stays in the mode it is in and
+ * other programs see it as before. No rumble or light bar (there was none
+ * through DirectInput either).
+ *
+ * The parsed state is what DirectInput reports for the same pad: B1-B14 in the
+ * order above (square cross circle triangle L1 R1 L2 R2 share options L3 R3 PS
+ * touchpad), B15 mute, B16-B19 the Edge buttons, hat 1 = d-pad, X Y = left
+ * stick, Z RZ = right stick, RX RY = L2 R2 travel. So the "ps" layout,
+ * [dinput.054C:0CE6] sections, dinput:... port pins and joy.cpl's button
+ * numbers apply unchanged: the pad is a DirectInput-class device, read another
+ * way. A reader thread per pad waits on an overlapped ReadFile and keeps the
+ * newest state plus every button, hat and axis direction that was down in any
+ * report since the last sample (what the DirectInput event buffer gives), so
+ * the 1 ms sampler and the tap latch treat it exactly as a DirectInput device.
+ * Reading does not depend on the window focus.
+ *
+ * Never twice: DirectInput skips a device whose HID path a reader holds, and
+ * the HID scan skips one DirectInput holds. If the HID open fails (another
+ * program opened the pad exclusively), the pad stays with DirectInput.
+ * [general] hid = 0 (env PS3_PAD_HID=0) turns this off: DirectInput as before.
+ * -----------------------------------------------------------------------*/
+
+/* report modes, for the log */
+enum { PSR_NONE = 0, PSR_DS4_USB, PSR_DS4_SIMPLE, PSR_DS4_EXT, PSR_DS_USB, PSR_DS_SIMPLE, PSR_DS_EXT };
+static const char* const k_psr_name[] = {
+    "-", "USB reports", "Bluetooth simple reports", "Bluetooth extended reports",
+    "USB reports", "Bluetooth simple reports", "Bluetooth extended reports" };
+
+/* CRC-32, reflected polynomial 0xEDB88320 (zlib's crc32(): ps_crc32(ps_crc32(0, a), b) = crc of a then b). */
+static u32 ps_crc32(u32 crc, const u8* p, size_t n)
+{
+    static const u32 t[16] = {
+        0x00000000u, 0x1DB71064u, 0x3B6E20C8u, 0x26D930ACu, 0x76DC4190u, 0x6B6B51F4u, 0x4DB26158u, 0x5005713Cu,
+        0xEDB88320u, 0xF00F9344u, 0xD6D6A3E8u, 0xCB61B38Cu, 0x9B64C2B0u, 0x86D3D2D4u, 0xA00AE278u, 0xBDBDF21Cu };
+    crc = ~crc;
+    while (n--) {
+        crc ^= *p++;
+        crc = (crc >> 4) ^ t[crc & 15];
+        crc = (crc >> 4) ^ t[crc & 15];
+    }
+    return ~crc;
+}
+
+/* Length of a Bluetooth extended report, whose last 4 bytes are its CRC; 0 = a report without one.
+ * DS4 0x11 = 78 bytes, 0x12..0x18 64 more each, 0x19 = 547; DualSense 0x31 = 78. */
+static size_t ps_crc_len(int model, u8 id)
+{
+    if (model == PSM_DS4 && id >= 0x11 && id <= 0x19) return id == 0x19 ? 547u : 78u + 64u * (u32)(id - 0x11);
+    if ((model == PSM_DS || model == PSM_EDGE) && id == 0x31) return 78u;
+    return 0;
+}
+
+/* 1 = the report's CRC is right, 0 = wrong, -1 = nothing to check (no CRC, or the report is cut short). */
+static int ps_crc_check(int model, const u8* p, size_t n)
+{
+    if (!n) return -1;
+    const size_t len = ps_crc_len(model, p[0]);
+    if (!len || n < len) return -1;
+    static const u8 hdr = 0xA1;
+    const u32 crc = ps_crc32(ps_crc32(0, &hdr, 1), p, len - 4);
+    const u8* c = p + len - 4;
+    return crc == ((u32)c[0] | (u32)c[1] << 8 | (u32)c[2] << 16 | (u32)c[3] << 24);
+}
+
+/* Which reports with a wrong CRC are dropped. A pad that has sent a good one
+ * gets bad ones dropped (a damaged report would be input nobody gave) -- unless
+ * 200 come in a row; a pad that sent 25 bad ones and never a good one does not
+ * fill the CRC in (some third-party pads): its reports are used. A good report
+ * ends that. */
+#define PS_CRC_RUN_NEVER_GOOD 25
+#define PS_CRC_RUN_WAS_GOOD   200
+typedef struct { u32 good, bad, run; int lenient; } PsCrcGate;
+
+static int ps_crc_gate(PsCrcGate* g, int ok)
+{
+    if (ok < 0) return 1;
+    if (ok) { g->good++; g->run = 0; g->lenient = 0; return 1; }
+    g->bad++; g->run++;
+    if (g->run >= (g->good ? PS_CRC_RUN_WAS_GOOD : PS_CRC_RUN_NEVER_GOOD)) g->lenient = 1;
+    return g->lenient;
+}
+
+/* 0..255 -> -32768..32767, what DirectInput gives for a logical 0..255 axis with DIPROP_RANGE -32768..32767. */
+static s32 ps_axis(u8 v) { return (s32)v * 257 - 32768; }
+
+/* st: LX LY RX RY; b: the three button bytes; b2mask: the bits of b[2] that are buttons. */
+static void ps_fill(RawState* r, const u8* st, const u8* b, u8 b2mask, u8 l2, u8 r2)
+{
+    /* hat value -> up(1) right(2) down(4) left(8) */
+    static const u8 hat[8] = { 1, 1 | 2, 2, 2 | 4, 4, 4 | 8, 8, 8 | 1 };
+    memset(r, 0, sizeof *r);
+    const unsigned h = b[0] & 15u;
+    if (h < 8)
+        for (unsigned d = 0; d < 4; d++) if ((hat[h] >> d) & 1) raw_set(r, CID_HAT + d);
+    const unsigned x = b[2] & b2mask;
+    r->bits[0] = (u32)(b[0] >> 4) | (u32)b[1] << 4 | (u32)(x & 7u) << 12 | (u32)(x >> 4) << 15;
+    r->axis[0] = ps_axis(st[0]); r->axis[1] = ps_axis(st[1]);     /* X Y   = left stick */
+    r->axis[2] = ps_axis(st[2]); r->axis[5] = ps_axis(st[3]);     /* Z RZ  = right stick */
+    r->axis[3] = ps_axis(l2);    r->axis[4] = ps_axis(r2);        /* RX RY = L2 R2 */
+    r->lt = l2; r->rt = r2;
+    axis_dirs(r);
+}
+
+/* One input report of a pad of `model` -> *r. n = the bytes ReadFile returned. bt: 1 = the pad is on
+ * Bluetooth, 0 = on USB, -1 = not known (then the length decides: 64 = USB). It matters only for a
+ * DualSense's report 0x01: the full one over USB, the simple one over Bluetooth. Returns the PSR_*
+ * mode, or PSR_NONE (r untouched) for a report that holds no input state. */
+static int ps_parse(int model, int bt, const u8* p, size_t n, RawState* r)
+{
+    if (!p || n < 10) return PSR_NONE;
+    const u8 id = p[0];
+    if (model == PSM_DS4) {
+        if (id == 0x01) {
+            ps_fill(r, p + 1, p + 5, 0x03, p[8], p[9]);
+            return (bt > 0 || (bt < 0 && n != 64)) ? PSR_DS4_SIMPLE : PSR_DS4_USB;
+        }
+        if (id >= 0x11 && id <= 0x19 && n >= 12 && (p[1] & 0x80)) {
+            ps_fill(r, p + 3, p + 7, 0x03, p[10], p[11]);
+            return PSR_DS4_EXT;
+        }
+        return PSR_NONE;
+    }
+    if (model == PSM_DS || model == PSM_EDGE) {
+        const u8 full = model == PSM_EDGE ? 0xF7 : 0x07;
+        if (id == 0x01) {
+            if (bt > 0 || (bt < 0 && n != 64)) { ps_fill(r, p + 1, p + 5, 0x03, p[8], p[9]); return PSR_DS_SIMPLE; }
+            ps_fill(r, p + 1, p + 8, full, p[5], p[6]);
+            return PSR_DS_USB;
+        }
+        if (id == 0x31 && n >= 12) { ps_fill(r, p + 2, p + 9, full, p[6], p[7]); return PSR_DS_EXT; }
+    }
+    return PSR_NONE;
+}
+
+/* The state of a pad at rest (before its first report). */
+static void ps_neutral(RawState* r)
+{
+    static const u8 st[4] = { 128, 128, 128, 128 }, b[3] = { 8, 0, 0 };
+    ps_fill(r, st, b, 0, 0, 0);
+}
+
+typedef struct HidDev {
+    HANDLE h, thread, stop;
+    OVERLAPPED ov;
+    SRWLOCK lock;                     /* cur, tap */
+    RawState cur;                     /* the newest report */
+    u32  tap[(CID_COUNT + 31) / 32];  /* down in any report since the last take */
+    volatile LONG dead;               /* reading failed: the pad is gone */
+    volatile LONG leak;               /* the reader did not stop: keep the memory */
+    int  model, bt;                   /* bt: 1 Bluetooth, 0 USB, -1 not known (see ps_parse) */
+    u16  vid, pid;
+    DWORD in_len;                     /* bytes per read (InputReportByteLength) */
+    /* reader thread only */
+    int  mode; u8 mode_id; int mode_logs;
+    u32  n_reports, n_dropped;
+    PsCrcGate crc;
+    char name[80];
+    char fake[MAX_PATH * 2];          /* PS3_PAD_HID_FAKE: the reports come from this file */
+    u8   buf[1024];
+} HidDev;
+
+static const char* hid_link(const HidDev* h)
+{
+    return h->bt > 0 ? "Bluetooth" : h->bt == 0 ? "USB" : h->in_len > 64 ? "Bluetooth?" : "USB?";
+}
+
+/* A parsed report: the newest state, and its presses kept for the next take. */
+static void hid_store(HidDev* h, const RawState* r)
+{
+    AcquireSRWLockExclusive(&h->lock);
+    h->cur = *r;
+    for (int i = 0; i < (CID_COUNT + 31) / 32; i++) h->tap[i] |= r->bits[i];
+    ReleaseSRWLockExclusive(&h->lock);
+}
+
+/* The newest state into *r; with taps also everything that was down in a report since the previous take
+ * (r->tap, as di_drain marks it). */
+static void hid_take(HidDev* h, RawState* r, int taps)
+{
+    AcquireSRWLockExclusive(&h->lock);
+    *r = h->cur;
+    if (taps) memcpy(r->tap, h->tap, sizeof r->tap);
+    else memset(r->tap, 0, sizeof r->tap);
+    memset(h->tap, 0, sizeof h->tap);
+    ReleaseSRWLockExclusive(&h->lock);
+}
+
+/* One report as read from the pad. Reader thread. */
+static void hid_feed(HidDev* h, const u8* p, size_t n)
+{
+    if (!n) return;
+    const int was_lenient = h->crc.lenient;
+    if (!ps_crc_gate(&h->crc, ps_crc_check(h->model, p, n))) {
+        if (h->n_dropped++ < 3) {
+            printf("[pad] HID '%s': report 0x%02X with a wrong CRC dropped\n", h->name, p[0]);
+            fflush(stdout);
+        }
+        return;
+    }
+    if (h->crc.lenient && !was_lenient) {
+        printf("[pad] HID '%s': %u reports in a row with a wrong CRC -- using them anyway\n", h->name, h->crc.run);
+        fflush(stdout);
+    }
+    RawState r;
+    const int mode = ps_parse(h->model, h->bt, p, n, &r);
+    if (!mode) return;
+    h->n_reports++;
+    if (mode != h->mode || p[0] != h->mode_id) {
+        /* first report, and every change (Steam switching the pad while we run) */
+        if (h->mode_logs++ < 16) {
+            printf("[pad] HID '%s': %s (0x%02X)\n", h->name, k_psr_name[mode], p[0]);
+            fflush(stdout);
+        }
+        h->mode = mode; h->mode_id = p[0];
+    }
+    hid_store(h, &r);
+}
+
+static DWORD WINAPI hid_reader_main(LPVOID arg)
+{
+    HidDev* h = (HidDev*)arg;
+    HANDLE w[2] = { h->stop, h->ov.hEvent };
+    DWORD err = 0;
+    int empty = 0;
+    for (;;) {
+        DWORD n = 0;
+        ResetEvent(h->ov.hEvent);
+        if (!ReadFile(h->h, h->buf, h->in_len, &n, &h->ov)) {
+            err = GetLastError();
+            if (err != ERROR_IO_PENDING) break;
+            err = 0;
+            DWORD r;
+            do r = WaitForMultipleObjects(2, w, FALSE, 1000); while (r == WAIT_TIMEOUT);
+            if (r != WAIT_OBJECT_0 + 1) {
+                /* stop: cancel the read, and wait for it to let go of buf and ov */
+                CancelIoEx(h->h, &h->ov);
+                if (WaitForSingleObject(h->ov.hEvent, 2000) != WAIT_OBJECT_0) InterlockedExchange(&h->leak, 1);
+                return 0;
+            }
+            if (!GetOverlappedResult(h->h, &h->ov, &n, FALSE)) { err = GetLastError(); break; }
+        }
+        if (!n && ++empty > 1000) { err = ERROR_HANDLE_EOF; break; }   /* never a spin on empty reads */
+        if (n) empty = 0;
+        hid_feed(h, h->buf, n);
+    }
+    if (WaitForSingleObject(h->stop, 0) != WAIT_OBJECT_0) {
+        printf("[pad] HID '%s': reading stopped (error %lu)\n", h->name, (unsigned long)err);
+        fflush(stdout);
+    }
+    InterlockedExchange(&h->dead, 1);
+    return 0;
+}
+
+/* Hex bytes of one line ("01 80 80 ..." or "018080..."), up to '#' or the end. */
+static size_t hex_bytes(const char* s, const char* end, u8* out, size_t cap)
+{
+    size_t n = 0; int hi = -1;
+    for (; s < end && *s != '#'; s++) {
+        int v = isdigit((unsigned char)*s) ? *s - '0' : (*s >= 'a' && *s <= 'f') ? *s - 'a' + 10 :
+                (*s >= 'A' && *s <= 'F') ? *s - 'A' + 10 : -1;
+        if (v < 0) continue;
+        if (hi < 0) hi = v;
+        else { if (n < cap) out[n++] = (u8)(hi << 4 | v); hi = -1; }
+    }
+    return n;
+}
+
+/* PS3_PAD_HID_FAKE (tests): the file is a log of input reports in hex, one per line ('#' starts a
+ * comment), that a test appends to. Read every millisecond; every line added since the last read is fed
+ * in order, padded as Windows pads them -- as a real pad's reports wait in the HID driver's queue, none
+ * is lost, and lines appended in one write are reports that came between two samples. A file that got
+ * shorter is read again from its start; the file gone = the pad unplugged. */
+static DWORD WINAPI hid_fake_main(LPVOID arg)
+{
+    HidDev* h = (HidDev*)arg;
+    HANDLE tmr = CreateWaitableTimerExW(NULL, NULL, 0x00000002 /* HIGH_RESOLUTION */, TIMER_ALL_ACCESS);
+    if (!tmr) tmr = CreateWaitableTimerExW(NULL, NULL, 0, TIMER_ALL_ACCESS);
+    char* text = (char*)malloc(65536);
+    LONGLONG off = 0;
+    for (; text;) {
+        if (tmr) {
+            LARGE_INTEGER due; due.QuadPart = -10000;   /* 1 ms */
+            SetWaitableTimer(tmr, &due, 0, NULL, NULL, FALSE);
+            HANDLE w[2] = { h->stop, tmr };
+            if (WaitForMultipleObjects(2, w, FALSE, 1000) == WAIT_OBJECT_0) break;
+        } else if (WaitForSingleObject(h->stop, 1) == WAIT_OBJECT_0) break;
+        HANDLE f = CreateFileA(h->fake, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                               NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+        if (f == INVALID_HANDLE_VALUE) {
+            if (GetLastError() == ERROR_FILE_NOT_FOUND || GetLastError() == ERROR_PATH_NOT_FOUND) {
+                printf("[pad] HID '%s': %s is gone -- unplugged\n", h->name, h->fake);
+                fflush(stdout);
+                break;
+            }
+            continue;
+        }
+        LARGE_INTEGER size, pos;
+        DWORD n = 0;
+        if (GetFileSizeEx(f, &size)) {
+            if (size.QuadPart < off) off = 0;                  /* written anew */
+            pos.QuadPart = off;
+            if (size.QuadPart > off && SetFilePointerEx(f, pos, NULL, FILE_BEGIN) && !ReadFile(f, text, 65535, &n, NULL))
+                n = 0;
+        }
+        CloseHandle(f);
+        const char* s = text;
+        for (;;) {                                             /* complete lines only */
+            const char* e = n ? (const char*)memchr(s, '\n', (size_t)(text + n - s)) : NULL;
+            if (!e) break;
+            u8 rep[sizeof h->buf];
+            const size_t k = hex_bytes(s, e, rep, h->in_len);
+            if (k) {
+                memset(rep + k, 0, h->in_len - k);
+                hid_feed(h, rep, h->in_len);
+            }
+            s = e + 1;
+        }
+        off += s - text;
+    }
+    if (tmr) CloseHandle(tmr);
+    free(text);
+    InterlockedExchange(&h->dead, 1);
+    return 0;
+}
+
+static HidDev* hid_new(int model, u16 vid, u16 pid, int bt, DWORD in_len, const char* name)
+{
+    HidDev* h = (HidDev*)calloc(1, sizeof *h);
+    if (!h) return NULL;
+    InitializeSRWLock(&h->lock);
+    h->h = INVALID_HANDLE_VALUE;
+    h->model = model; h->vid = vid; h->pid = pid; h->bt = bt;
+    h->in_len = in_len < 10 ? 64 : in_len > sizeof h->buf ? (DWORD)sizeof h->buf : in_len;
+    snprintf(h->name, sizeof h->name, "%s", name);
+    ps_neutral(&h->cur);
+    h->stop = CreateEventW(NULL, TRUE, FALSE, NULL);
+    h->ov.hEvent = CreateEventW(NULL, TRUE, FALSE, NULL);
+    if (!h->stop || !h->ov.hEvent) {
+        if (h->stop) CloseHandle(h->stop);
+        if (h->ov.hEvent) CloseHandle(h->ov.hEvent);
+        free(h);
+        return NULL;
+    }
+    return h;
+}
+
+static void hid_free(HidDev* h)
+{
+    if (!h) return;
+    if (h->thread) {
+        SetEvent(h->stop);
+        if (WaitForSingleObject(h->thread, 3000) != WAIT_OBJECT_0) InterlockedExchange(&h->leak, 1);
+        else CloseHandle(h->thread);
+    }
+    if (h->leak) return;            /* a read may still write into it: keep it all */
+    if (h->h != INVALID_HANDLE_VALUE) CloseHandle(h->h);
+    CloseHandle(h->ov.hEvent);
+    CloseHandle(h->stop);
+    free(h);
+}
+
+static int hid_start(HidDev* h)
+{
+    h->thread = CreateThread(NULL, 0, h->fake[0] ? hid_fake_main : hid_reader_main, h, 0, NULL);
+    if (!h->thread) return 0;
+    /* like the sampler: a report is timed when it arrives, not when the game's threads let us run */
+    SetThreadPriority(h->thread, THREAD_PRIORITY_HIGHEST);
+    typedef HRESULT (WINAPI *SetThreadDescription_t)(HANDLE, PCWSTR);
+    SetThreadDescription_t sd = (SetThreadDescription_t)(void*)GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "SetThreadDescription");
+    if (sd) sd(h->thread, L"pad HID reader");
+    return 1;
+}

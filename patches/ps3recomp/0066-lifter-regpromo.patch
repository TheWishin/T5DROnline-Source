@@ -0,0 +1,359 @@
+#!/usr/bin/env python3
+"""Tests of the lifter's register promotion (ppu_lifter.py --regpromo, _regpromo).
+
+    python tools/test_ppu_regpromo.py [--funcs N] [--iters N] [--seed S] [--keep DIR]
+
+1. The shape of the output: what is written back where (returns, trampolines,
+   calls, conditional exits, switch dispatch, the end of the body, merges at
+   labels), and which bodies the pass refuses (kept unpromoted).
+2. Random lifted-style functions -- every line shape the lifter emits for
+   Tekken 5 DR (integer, carry, compare, record forms, rotates, loads/stores,
+   FP loads/stores/arithmetic, vector moves, store-conditional, calls direct /
+   indirect / syscall / conditional, mtfsf, labels, gotos forward and back,
+   conditional returns and trampolines, CTR loops, jump-table switches,
+   callee-save snapshots) -- compiled twice in one harness, without and with
+   the pass, and run on random inputs (tools/regpromo_diff.py): the context,
+   guest memory and the trace of every guest access and call must be equal.
+
+No game code is involved; exit status 0 = all checks passed. Needs clang-cl and
+the MSVC environment (msvc_env.py) for part 2 on Windows; elsewhere part 2 is
+skipped.
+"""
+import argparse
+import os
+import random
+import re
+import sys
+
+TOOLS = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, TOOLS)
+
+import ppu_lifter                                 # noqa: E402
+from ppu_lifter import _regpromo, _RP_STATS, PPULifter, HEADER_PREAMBLE   # noqa: E402
+
+FAILS = []
+
+
+def check(cond, what):
+    if cond:
+        print(f"ok   {what}")
+    else:
+        print(f"FAIL {what}")
+        FAILS.append(what)
+
+
+def norm(lines):
+    return [ln.strip() for ln in lines]
+
+
+# ---------------------------------------------------------------------------
+# 1. shapes
+# ---------------------------------------------------------------------------
+
+def shapes():
+    # a counted copy loop: everything in locals, written back once at the return
+    body = ["    ctx->gpr[3] = ctx->gpr[3] + (int64_t)(0x20);",
+            "    ctx->ctr = ctx->gpr[0];",
+            "loc_00001000:",
+            "    ctx->gpr[11] = vm_read8(ctx->gpr[4] + 0x0);",
+            "    vm_write8(ctx->gpr[3] + 0x0, ctx->gpr[11]);",
+            "    ctx->gpr[3] = ctx->gpr[3] + (int64_t)(1);",
+            "    if ((--ctx->ctr != 0)) goto loc_00001000;",
+            "    return;"]
+    out = norm(_regpromo(body))
+    check(out[0] == "uint64_t _pr_g0 = ctx->gpr[0], _pr_g3 = ctx->gpr[3], _pr_g4 = ctx->gpr[4], "
+                    "_pr_g11 = ctx->gpr[11];" and out[1] == "uint64_t _pr_ctr = ctx->ctr;",
+          "locals declared and loaded at entry, in register order")
+    check("if ((--_pr_ctr != 0)) goto loc_00001000;" in out, "loop condition uses the local CTR")
+    check(not any("ctx->gpr" in ln for ln in out[2:-1]), "no context access inside the loop")
+    check(out[-1] == "{ ctx->gpr[3] = _pr_g3; ctx->gpr[11] = _pr_g11; ctx->ctr = _pr_ctr; return; }",
+          "return writes back exactly the registers written (r3, r11, CTR), not r0/r4")
+
+    # a call: dirty registers before it, every promoted register reloaded after it
+    body = ["    ctx->gpr[3] = ctx->gpr[31] | ctx->gpr[31];",
+            "    ctx->lr = 0x00002004; func_00003000(ctx); DRAIN_TRAMPOLINE(ctx);",
+            "    ctx->gpr[30] = ctx->gpr[3] + (int64_t)(1);",
+            "    return;"]
+    out = norm(_regpromo(body))
+    i = out.index("ctx->lr = 0x00002004; func_00003000(ctx); DRAIN_TRAMPOLINE(ctx);")
+    check(out[i - 1] == "ctx->gpr[3] = _pr_g3;", "only the written r3 is stored before the call")
+    check(out[i + 1] == "_pr_g3 = ctx->gpr[3]; _pr_g30 = ctx->gpr[30]; _pr_g31 = ctx->gpr[31];",
+          "every promoted register is reloaded after the call")
+    check(out[-1] == "{ ctx->gpr[30] = _pr_g30; return; }", "after the call only r30 is dirty at the return")
+
+    # conditional exits write back inside the branch; the fall-through keeps the locals
+    body = ["    ctx->gpr[5] = ctx->gpr[6] + (int64_t)(2);",
+            "    { int64_t a = (int64_t)ctx->gpr[5]; int64_t b = (int64_t)0; uint32_t cr_val = ((a < b) ? 8 : (a > b) ? 4 : 2) | ((ctx->xer >> 31) & 1u); ctx->cr = (ctx->cr & ~(0xFu << 28)) | (cr_val << 28); }",
+            "    if (((ctx->cr >> 29) & 1)) return;",
+            "    if ((!((ctx->cr >> 30) & 1))) { g_trampoline_fn = (void(*)(void*))func_00004000; return; }",
+            "    ctx->gpr[7] = ctx->gpr[5];",
+            "    { g_trampoline_fn = (void(*)(void*))func_00005000; return; }"]
+    out = norm(_regpromo(body))
+    check("if (((_pr_cr >> 29) & 1)) { ctx->gpr[5] = _pr_g5; ctx->cr = _pr_cr; return; }" in out,
+          "conditional return writes back in its branch")
+    check("if ((!((_pr_cr >> 30) & 1))) { ctx->gpr[5] = _pr_g5; ctx->cr = _pr_cr; g_trampoline_fn = "
+          "(void(*)(void*))func_00004000; return; }" in out, "conditional trampoline writes back before the hand-off")
+    check(out[-1] == "{ ctx->gpr[5] = _pr_g5; ctx->gpr[7] = _pr_g7; ctx->cr = _pr_cr; g_trampoline_fn = "
+                     "(void(*)(void*))func_00005000; return; }", "trampoline at the end writes back r5, r7, CR")
+
+    # a merge: a register written on one path only is written back after the label
+    body = ["    if (((ctx->cr >> 2) & 1)) goto loc_00006010;",
+            "    ctx->gpr[9] = vm_read32(ctx->gpr[3] + 0x4);",
+            "loc_00006010:",
+            "    ctx->gpr[3] = vm_read32(ctx->gpr[3] + 0x8);",
+            "    return;"]
+    out = norm(_regpromo(body))
+    check(out[-1] == "{ ctx->gpr[3] = _pr_g3; ctx->gpr[9] = _pr_g9; return; }",
+          "a register dirty on one incoming path is written back after the merge")
+
+    # a loop back edge carries dirtiness to the loop head
+    body = ["loc_00007000:",
+            "    ctx->lr = 0x00007004; func_00008000(ctx); DRAIN_TRAMPOLINE(ctx);",
+            "    ctx->gpr[14] = ctx->gpr[14] + (int64_t)(1);",
+            "    ctx->gpr[15] = vm_read32(ctx->gpr[14] + 0x0);",
+            "    { uint64_t a = (uint64_t)ctx->gpr[15]; uint64_t b = (uint64_t)0x0; uint32_t cr_val = ((a < b) ? 8 : (a > b) ? 4 : 2) | ((ctx->xer >> 31) & 1u); ctx->cr = (ctx->cr & ~(0xFu << 28)) | (cr_val << 28); }",
+            "    if ((!((ctx->cr >> 29) & 1))) goto loc_00007000;",
+            "    return;"]
+    out = norm(_regpromo(body))
+    i = out.index("ctx->lr = 0x00007004; func_00008000(ctx); DRAIN_TRAMPOLINE(ctx);")
+    check(out[i - 1] == "ctx->gpr[14] = _pr_g14; ctx->gpr[15] = _pr_g15; ctx->cr = _pr_cr;",
+          "the call at the loop head writes back what the previous iteration changed")
+
+    # the jump-table switch reads ctx->ctr itself: written back before it, kept verbatim
+    sw = ("switch ((uint32_t)ctx->ctr) { case 0x00009010u: goto loc_00009010;case 0x00009018u: goto "
+          "loc_00009018; default: ps3_indirect_call(ctx); return; } return;")
+    body = ["    ctx->ctr = ctx->gpr[0] + ctx->gpr[11];", "    " + sw,
+            "loc_00009010:", "    ctx->gpr[3] = (int64_t)(int32_t)(1);", "    return;",
+            "loc_00009018:", "    ctx->gpr[3] = (int64_t)(int32_t)(2);", "    return;"]
+    out = norm(_regpromo(body))
+    i = out.index(sw)
+    check(out[i - 1] == "ctx->ctr = _pr_ctr;", "switch: CTR written back before the dispatch reads it")
+    check(out[i + 2] == "_pr_g3 = (int64_t)(int32_t)(1);" and "{ ctx->gpr[3] = _pr_g3; return; }" in out,
+          "switch cases start clean")
+
+    # falling off the end of the body is a return
+    out = norm(_regpromo(["    ctx->gpr[3] = ctx->gpr[4];", "loc_0000A004: ; /* branch into undecoded region */"]))
+    check(out[-1] == "ctx->gpr[3] = _pr_g3;", "the end of the body writes back")
+
+    # a line that ends in an unconditional return gets no reload after it
+    out = norm(_regpromo(["    ctx->gpr[3] = ctx->gpr[4];", "    ps3_indirect_call(ctx); return;"]))
+    check(out[-1] == "ps3_indirect_call(ctx); return;" and out[-2] == "ctx->gpr[3] = _pr_g3;",
+          "call-and-return: write-back before, nothing after")
+
+    # address-taken fields count as written
+    out = norm(_regpromo(["    ctx->gpr[3] = ppc_sraw(&ctx->xer, (int32_t)ctx->gpr[4], 2);",
+                          "    { uint64_t tmp = vm_read64(ctx->gpr[1] + 0x8); memcpy(&ctx->fpr[1], &tmp, 8); }",
+                          "    return;"]))
+    check(out[-1] == "{ ctx->gpr[3] = _pr_g3; ctx->fpr[1] = _pr_f1; ctx->xer = _pr_xer; return; }",
+          "&ctx->xer and memcpy(&ctx->fpr[n]) write back XER and the FPR")
+
+    # refusals: the function keeps its unpromoted body
+    for what, bad in (
+            ("unknown context field", ["    ctx->gpr[3] = ctx->msr;", "    return;"]),
+            ("computed register index", ["    ctx->gpr[3] = ctx->gpr[ctx->gpr[4] & 31];", "    return;"]),
+            ("call to an unknown function", ["    ctx->gpr[3] = mystery(ctx->gpr[4]);", "    return;"]),
+            ("goto inside a call line", ["    ctx->gpr[3] = 1;", "    if (x) { func_00001000(ctx); goto loc_00001000; }",
+                                         "loc_00001000:", "    return;"]),
+            ("goto to a missing label", ["    ctx->gpr[3] = 1;", "    goto loc_0000FFFF;"]),
+            ("a while loop", ["    while (ctx->gpr[3]) ctx->gpr[3]--;", "    return;"]),
+            ("a // comment", ["    ctx->gpr[3] = 1; // x", "    return;"]),
+            ("a name that collides", ["    uint64_t _pr_g3 = 0;", "    ctx->gpr[3] = 1;", "    return;"]),
+            ("an unknown switch", ["    switch (ctx->gpr[3]) { case 1: break; }", "    return;"]),
+            ("register in a goto line", ["    ctx->gpr[3] = 1;", "loc_00001000:", "    goto loc_00001000; ctx->gpr[3] = 2;"])):
+        check(_regpromo(bad) is None, f"refused: {what}")
+    check(_regpromo(["    ps3_hle_call(0x12345678u, ctx); return;  /* import stub */"]) is None,
+          "nothing to promote in an import stub")
+
+
+# ---------------------------------------------------------------------------
+# 2. random lifted-style functions, both forms run against each other
+# ---------------------------------------------------------------------------
+
+GPRS = [0, 1, 2, 3, 4, 5, 6, 9, 10, 11, 12, 13, 14, 28, 29, 30, 31]
+FPRS = [0, 1, 2, 3, 13, 31]
+
+
+def stmt(r, pc):
+    g = lambda: r.choice([x for x in GPRS if x != 1])   # noqa: E731 -- r1 is the stack pointer
+    a = lambda: r.choice(GPRS)                          # noqa: E731
+    f = lambda: r.choice(FPRS)                          # noqa: E731
+    s = r.choice([28, 24, 20, 16, 12, 8, 4, 0])
+    off = r.choice(["0x0", "0x4", "0x8", "-0x10", "0x1C", "0x80"])
+    pool = [
+        lambda: f"ctx->gpr[{g()}] = ctx->gpr[{a()}] + (int64_t)({r.randint(-40, 40)});",
+        lambda: f"ctx->gpr[{g()}] = ctx->gpr[{a()}] | ctx->gpr[{a()}];",
+        lambda: f"ctx->gpr[{g()}] = ctx->gpr[{a()}] - ctx->gpr[{a()}];",
+        lambda: f"ctx->gpr[{g()}] = ppc_rldicl(ctx->gpr[{a()}], {r.randint(0, 63)}, {r.randint(0, 63)});",
+        lambda: f"ctx->gpr[{g()}] = ppc_rlw64(ctx->gpr[{a()}], {r.randint(0, 31)}, {r.randint(0, 31)}, {r.randint(0, 31)}, ctx->gpr[{a()}], 1);",
+        lambda: f"ctx->gpr[{g()}] = (int64_t)(int32_t)(0x{r.randint(0, 0xFFFF):X});",
+        lambda: f"ctx->gpr[{g()}] = vm_read32(ctx->gpr[{a()}] + {off});",
+        lambda: f"ctx->gpr[{g()}] = vm_read64(ctx->gpr[1] + {off});",
+        lambda: f"ctx->gpr[{g()}] = vm_read8(ctx->gpr[{a()}] + {off});",
+        lambda: f"vm_write32(ctx->gpr[{a()}] + {off}, ctx->gpr[{a()}]);",
+        lambda: f"vm_write64(ctx->gpr[1] + {off}, ctx->gpr[{a()}]);",
+        lambda: f"vm_write16(ctx->gpr[{a()}] + {off}, ctx->gpr[{a()}]);",
+        lambda: (f"{{ int64_t a = (int64_t)ctx->gpr[{a()}]; int64_t b = (int64_t)ctx->gpr[{a()}]; uint32_t cr_val = "
+                 f"((a < b) ? 8 : (a > b) ? 4 : 2) | ((ctx->xer >> 31) & 1u); ctx->cr = (ctx->cr & ~(0xFu << {s})) | (cr_val << {s}); }}"),
+        lambda: (f"{{ uint64_t a = (uint32_t)ctx->gpr[{a()}]; uint64_t b = (uint64_t)0x{r.randint(0, 9)}; uint32_t cr_val = "
+                 f"((a < b) ? 8 : (a > b) ? 4 : 2) | ((ctx->xer >> 31) & 1u); ctx->cr = (ctx->cr & ~(0xFu << {s})) | (cr_val << {s}); }}"),
+        lambda: (f"{{ uint64_t _a = ctx->gpr[{a()}]; uint64_t _r = _a + (uint64_t)(int64_t)({r.randint(-9, 9)}); ctx->gpr[{g()}] = _r; "
+                 f"ctx->xer = (ctx->xer & ~(1u << 29)) | ((_r < _a) ? (1u << 29) : 0u); }}"),
+        lambda: (lambda d, x, y: f"{{ uint64_t ca = (ctx->xer >> 29) & 1; uint64_t result = ctx->gpr[{x}] + ctx->gpr[{y}] + ca; "
+                 f"ctx->xer = (ctx->xer & ~(1u << 29)) | ((result < ctx->gpr[{x}] || (ca && result == ctx->gpr[{x}])) ? (1u << 29) : 0); "
+                 f"ctx->gpr[{d}] = result; }}")(g(), a(), a()),
+        lambda: f"ctx->gpr[{g()}] = ppc_sraw(&ctx->xer, (int32_t)ctx->gpr[{a()}], {r.randint(0, 31)});",
+        lambda: f"ctx->gpr[{g()}] = (uint64_t)ppc_srad(&ctx->xer, (int64_t)ctx->gpr[{a()}], {r.randint(0, 63)});",
+        lambda: (lambda d: f"ctx->gpr[{d}] = ctx->gpr[{a()}] & ctx->gpr[{a()}]; {{ int64_t _r = (int64_t)ctx->gpr[{d}]; uint32_t _c = "
+                 f"(_r < 0) ? 8u : (_r > 0) ? 4u : 2u; _c |= (uint32_t)((ctx->xer >> 31) & 1u); ctx->cr = (ctx->cr & 0x0FFFFFFFu) | (_c << 28); }}")(g()),
+        lambda: (lambda d, x, y: f"{{ const uint64_t _a = ctx->gpr[{x}], _b = ctx->gpr[{y}]; (void)_b; ctx->gpr[{d}] = ctx->gpr[{x}] + ctx->gpr[{y}]; "
+                 f"{{ const uint64_t _r = ctx->gpr[{d}]; (void)_r; const uint32_t _ov = (uint32_t)((((_a ^ _r) & (_b ^ _r)) >> 63)); "
+                 f"ctx->xer = (ctx->xer & ~0x40000000u) | (_ov << 30) | (_ov << 31); }} }}")(g(), a(), a()),
+        lambda: f"ctx->ctr = ctx->gpr[{a()}];",
+        lambda: f"ctx->ctr = (int64_t)(int32_t)({r.randint(1, 6)});",
+        lambda: f"ctx->gpr[{g()}] = ctx->ctr;",
+        lambda: f"ctx->gpr[{g()}] = ctx->cr;",
+        lambda: f"ctx->cr = (uint32_t)ctx->gpr[{a()}];",
+        lambda: f"ctx->gpr[{g()}] = ctx->lr;",
+        lambda: f"ctx->lr = ctx->gpr[{a()}];",
+        lambda: f"ctx->xer = (uint32_t)ctx->gpr[{a()}] & 0xE000007Fu;",
+        lambda: f"ctx->gpr[{g()}] = ctx->xer;",
+        lambda: f"{{ uint32_t tmp = vm_read32(ctx->gpr[{a()}] + {off}); float ftmp; memcpy(&ftmp, &tmp, 4); ctx->fpr[{f()}] = ftmp; }}",
+        lambda: f"{{ float ftmp = (float)ctx->fpr[{f()}]; uint32_t tmp; memcpy(&tmp, &ftmp, 4); vm_write32(ctx->gpr[{a()}] + {off}, tmp); }}",
+        lambda: f"{{ uint64_t tmp = vm_read64(ctx->gpr[{a()}] + {off}); memcpy(&ctx->fpr[{f()}], &tmp, 8); }}",
+        lambda: f"{{ uint64_t tmp; memcpy(&tmp, &ctx->fpr[{f()}], 8); vm_write64(ctx->gpr[{a()}] + {off}, tmp); }}",
+        lambda: f"ctx->fpr[{f()}] = ppu_fadd(ctx->fpr[{f()}], ctx->fpr[{f()}]);",
+        lambda: f"ctx->fpr[{f()}] = ppu_fp_single(ppu_fmul(ctx->fpr[{f()}], ctx->fpr[{f()}]));",
+        lambda: f"ctx->fpr[{f()}] = ppu_fmadd_core(ctx->fpr[{f()}], ctx->fpr[{f()}], ctx->fpr[{f()}], 0, 1);",
+        lambda: f"ctx->fpr[{f()}] = ppu_frsp(ctx->fpr[{f()}]);",
+        lambda: f"ctx->fpr[{f()}] = ctx->fpr[{f()}];",
+        lambda: f"{{ int64_t iv = (int32_t)ppu_f2i32(ctx->fpr[{f()}], 0); memcpy(&ctx->fpr[{f()}], &iv, 8); }}",
+        lambda: (f"{{ double a = ctx->fpr[{f()}]; double b = ctx->fpr[{f()}]; uint32_t cr_val = (a != a || b != b) ? 1 : "
+                 f"(a < b) ? 8 : (a > b) ? 4 : 2; ctx->cr = (ctx->cr & ~(0xFu << {s})) | (cr_val << {s}); }}"),
+        lambda: f"{{ uint64_t ea = (ctx->gpr[{a()}]) & ~0xFULL; vm_raw_ld16(&ctx->vr[{r.randint(0, 3)}], ea); }}",
+        lambda: f"{{ uint64_t ea = (ctx->gpr[{a()}]) & ~0xFULL; vm_raw_st16(ea, &ctx->vr[{r.randint(0, 3)}]); }}",
+        lambda: f"vmx_vaddfp(&ctx->vr[{r.randint(0, 3)}], &ctx->vr[{r.randint(0, 3)}], &ctx->vr[{r.randint(0, 3)}], ctx->vscr);",
+        lambda: (f"{{ uint64_t ea = ctx->gpr[{a()}]; int _sc = (ctx->reserve_addr == (uint32_t)ea) && ppu_stwcx32(ea, "
+                 f"(uint32_t)ctx->reserve_value, (uint32_t)ctx->gpr[{a()}]); ctx->cr = (ctx->cr & ~0xF0000000u) | "
+                 f"(_sc ? (2u << 28) : 0u) | ((ctx->xer >> 31) << 28); ctx->reserve_addr = 0; }}"),
+        lambda: "/* nop */;",
+        (lambda: (lambda d, x: f"ctx->gpr[{d}] = (uint32_t)ctx->gpr[{x}] ? __builtin_clz((uint32_t)ctx->gpr[{x}]) : 32;")(g(), a())),
+        # lines that hand ctx on
+        lambda: f"ctx->lr = 0x{pc + 4:08X}; func_{r.choice([0x10000, 0x20000, 0x30000]):08X}(ctx); DRAIN_TRAMPOLINE(ctx);",
+        lambda: f"ctx->lr = 0x{pc + 4:08X}; ps3_indirect_call(ctx); DRAIN_TRAMPOLINE(ctx);",
+        lambda: "lv2_syscall(ctx);",
+        lambda: "ctx->ctr = (uint32_t)ctx->lr; ps3_indirect_call(ctx); DRAIN_TRAMPOLINE(ctx);",
+        lambda: f"ctx->lr = 0x{pc + 4:08X}; if (((ctx->cr >> {r.randint(0, 31)}) & 1)) {{ ps3_indirect_call(ctx); DRAIN_TRAMPOLINE(ctx); }}",
+        lambda: f"if (((ctx->cr >> {r.randint(0, 31)}) & 1)) {{ ps3_indirect_call(ctx); DRAIN_TRAMPOLINE(ctx); return; }}",
+        lambda: f"{{ uint64_t _v; memcpy(&_v, &ctx->fpr[{f()}], 8); ppu_mtfsf(ctx, 0xFFu, (uint32_t)_v); }}",
+    ]
+    return r.choice(pool)()
+
+
+def random_function(r, base):
+    nblk = r.randint(1, 7)
+    labels = [base + 0x100 * i for i in range(nblk)]
+    body = []
+    cs = r.sample([14, 28, 29, 30, 31], r.randint(0, 2))
+    for n in cs:
+        body.append(f"    uint64_t _cs_{n} = ctx->gpr[{n}];")
+    pc = base
+    for i, lab in enumerate(labels):
+        if i or r.random() < 0.3:
+            body.append(f"loc_{lab:08X}:")
+        reg = r.choice([x for x in GPRS if x != 1])
+        body.append(f"    ctx->gpr[{reg}] = vm_read32(ctx->gpr[{r.choice(GPRS)}] + 0x10);")  # an event per block: loops end
+        for _ in range(r.randint(1, 9)):
+            body.append("    " + stmt(r, pc))
+            pc += 4
+        for n in cs:
+            if r.random() < 0.2:
+                body.append(f"    ctx->gpr[{n}] = _cs_{n};")
+        t = r.random()
+        tgt = r.choice(labels)
+        bit = r.randint(0, 31)
+        if t < 0.15:
+            body.append(f"    goto loc_{tgt:08X};")
+        elif t < 0.35:
+            body.append(f"    if ({'!' if r.random() < 0.5 else ''}((ctx->cr >> {bit}) & 1)) goto loc_{tgt:08X};")
+        elif t < 0.45:
+            body.append(f"    if ((--ctx->ctr != 0)) goto loc_{tgt:08X};")
+        elif t < 0.52:
+            body.append("    return;")
+        elif t < 0.6:
+            body.append(f"    if (((ctx->cr >> {bit}) & 1)) return;")
+        elif t < 0.65:
+            body.append(f"    {{ g_trampoline_fn = (void(*)(void*))func_{0x40000 + i:08X}; return; }}")
+        elif t < 0.72:
+            body.append(f"    if ((!((ctx->cr >> {bit}) & 1))) {{ g_trampoline_fn = (void(*)(void*))func_{0x50000 + i:08X}; return; }}")
+        elif t < 0.77:
+            cases = r.sample(labels, min(len(labels), r.randint(1, 3)))
+            arms = "".join(f"case 0x{c:08X}u: goto loc_{c:08X};" for c in cases)
+            body.append(f"    switch ((uint32_t)ctx->ctr) {{ {arms} default: ps3_indirect_call(ctx); return; }} return;")
+        # else: fall through into the next block (or off the end)
+    for i, lab in enumerate(labels):
+        if f"loc_{lab:08X}:" not in body and any(f"loc_{lab:08X};" in ln for ln in body):
+            body.append(f"    loc_{lab:08X}: ; /* branch into undecoded region */")
+    return body
+
+
+def fuzz(nfuncs, iters, seed, keep):
+    import regpromo_diff as rd
+    try:
+        from msvc_env import find_vcvars
+    except ImportError:
+        find_vcvars = None
+    if os.name == "nt" and not (find_vcvars and find_vcvars()):
+        print("SKIPPED part 2: no MSVC environment for clang-cl")
+        return
+    r = random.Random(seed)
+    lifter = PPULifter()
+    preamble = "\n".join(lifter._preamble_lines())
+    header = rd.harness_header(HEADER_PREAMBLE)
+    pairs = []
+    refused = 0
+    for k in range(nfuncs):
+        base = 0x100000 + k * 0x1000
+        body = random_function(r, base)
+        new = _regpromo(body)
+        if new is None:
+            refused += 1
+            print("refused:\n" + "\n".join(body))
+            continue
+        old_txt = f"void func_{base:08X}(ppu_context* ctx) {{\n" + "\n".join(body) + "\n}"
+        new_txt = f"void func_{base:08X}(ppu_context* ctx) {{\n" + "\n".join(new) + "\n}"
+        pairs.append((base, old_txt, new_txt, f"func_{base:08X}"))
+    check(refused == 0, f"the pass accepts every random lifted-style function ({nfuncs - refused}/{nfuncs})")
+    work = keep or os.path.join(os.path.dirname(TOOLS), "scratch", "regpromo_fuzz")
+    os.makedirs(work, exist_ok=True)
+    src, exe = os.path.join(work, "fuzz.cpp"), os.path.join(work, "fuzz.exe")
+    with open(src, "w", encoding="utf-8") as f:
+        f.write(rd.harness_source(header, preamble, pairs))
+    for march in ("x86-64-v3", "none"):
+        rd.compile_harness(src, exe, march)
+        for snan in ("quiet",):
+            log = os.path.join(work, f"fuzz_{march}.log")
+            if os.path.exists(log):
+                os.remove(log)
+            done, diff, stuck = rd.run_harness(exe, len(pairs), iters, 4000, log, snan)
+            check(done == len(pairs) and diff == 0 and not stuck,
+                  f"random functions, -march={march}: {done} functions x {iters} inputs, "
+                  f"{diff} differing runs, {len(stuck)} stuck (log {log})")
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--funcs", type=int, default=150)
+    ap.add_argument("--iters", type=int, default=1500)
+    ap.add_argument("--seed", type=int, default=20261020)
+    ap.add_argument("--keep", default="", help="work directory for the harness")
+    ap.add_argument("--shapes-only", action="store_true")
+    a = ap.parse_args()
+    shapes()
+    if not a.shapes_only:
+        fuzz(a.funcs, a.iters, a.seed, a.keep)
+    print(f"\n{'all checks passed' if not FAILS else str(len(FAILS)) + ' FAILED'}")
+    sys.exit(1 if FAILS else 0)
+
+
+if __name__ == "__main__":
+    main()

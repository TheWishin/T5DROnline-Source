+/* CPU set ids of the logical processors in m. */
+static ULONG hs_mask_ids(uint64_t m, ULONG* ids)
+{
+    ULONG n = 0;
+    for (int i = 0; i < s_ncpu; i++)
+        if (s_cpu[i].lp < 64 && ((m >> s_cpu[i].lp) & 1u)) ids[n++] = s_cpu[i].id;
+    return n;
+}

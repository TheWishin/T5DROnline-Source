+/* ---- the flip wait without the poll (patch 0047) ---------------------------
+ * Tekken 5 DR's main thread waits for its flip in a loop
+ *     while (cellGcmGetFlipStatus() != DONE) usleep(100);
+ * (0x34BA30) for the rest of every frame: 50-100 wake-ups a frame on the
+ * high-resolution timer, or one processor busy all frame with sub-ms sleeps
+ * on the SwitchToThread spin (12+ logical processors before patch 0047). The
+ * flip completes only on a vblank tick (ppu_gcm_pump), so a usleep that
+ * follows a WAITING answer on the same thread now waits for the status to
+ * change (WaitOnAddress, woken by gcm_flip_wake) -- one wake-up, and it comes
+ * a few microseconds after the flip instead of up to one poll period later.
+ * Bounded by 20 ms per usleep (the title polls again and comes back), and only
+ * for a usleep under 1 ms right after the WAITING answer. PS3_FLIP_WAIT=0: the
+ * plain usleep. The rollback netcode keeps the plain poll on the main thread
+ * (cellGcm_flip_poll_plain): its early rollback looks at the network between
+ * two polls. */
+static volatile LONG s_flip_waiters = 0;
+static _Thread_local int t_flip_polled = 0;     /* this thread's last GetFlipStatus said WAITING */
+static void gcm_flip_wake(void)
+{
+    /* the status store must be visible before the waiter count is read (a
+     * waiter counts itself, then reads the status): a full fence, or x86 may
+     * read the count ahead of the store and leave a waiter to its timeout */
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    if (s_flip_waiters) WakeByAddressAll((PVOID)&s_flip_status);
+}
+void cellGcm_flip_poll_plain(void) { t_flip_polled = 0; }
+static int gcm_usleep_flip_wait(uint64_t usec)
+{
+    if (!t_flip_polled) return 0;
+    t_flip_polled = 0;
+    if (usec >= 1000) return 0;
+    u32 waiting = CELL_GCM_FLIP_STATUS_WAITING;
+    if (s_flip_status != waiting) return 1;            /* done meanwhile: the poll sees it now */
+    const ULONGLONG t_end = GetTickCount64() + 20;
+    InterlockedIncrement(&s_flip_waiters);
+    while (s_flip_status == waiting) {
+        const ULONGLONG now = GetTickCount64();
+        if (now >= t_end) break;
+        WaitOnAddress((volatile VOID*)&s_flip_status, &waiting, sizeof waiting, (DWORD)(t_end - now));
+    }
+    InterlockedDecrement(&s_flip_waiters);
+    return 1;
+}
+static int gcm_flip_wait_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("PS3_FLIP_WAIT"); on = !(e && *e == '0'); }
+    return on;
+}

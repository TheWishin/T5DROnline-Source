diff --git a/runtime/platform/lat_log.c b/runtime/platform/lat_log.c
new file mode 100644
index 0000000..13227ca
--- /dev/null
+++ b/runtime/platform/lat_log.c
@@ -0,0 +1,147 @@
+/* ps3recomp - input-to-display latency probe; see lat_log.h. */
+#include "lat_log.h"
+
+volatile int g_lat_log_on = -1;
+
+#ifndef _WIN32
+int  lat_log_init(void) { g_lat_log_on = 0; return 0; }
+void lat_log_(char kind, const char* fmt, ...) { (void)kind; (void)fmt; }
+void lat_log_at_(char kind, int64_t qpc, const char* fmt, ...) { (void)kind; (void)qpc; (void)fmt; }
+void lat_log_flip_call(unsigned seq) { (void)seq; }
+int64_t lat_qpc(void) { return 0; }
+#else
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+extern unsigned char* vm_base;
+
+static SRWLOCK s_lock = SRWLOCK_INIT;
+static INIT_ONCE s_once = INIT_ONCE_STATIC_INIT;
+static FILE* s_file;
+static FILE* s_dump;
+static LONGLONG s_qpf = 1, s_last_flush;
+static struct { uint32_t addr, len; } s_watch[8], s_dumpr;
+static int s_nwatch;
+
+int64_t lat_qpc(void) { LARGE_INTEGER t; QueryPerformanceCounter(&t); return t.QuadPart; }
+
+static void parse_ranges(const char* spec, int max, int* n, uint32_t* addr, uint32_t* len)
+{
+    *n = 0;
+    const char* p = spec;
+    while (p && *p && *n < max) {
+        char* e;
+        const unsigned long a = strtoul(p, &e, 16);
+        if (e == p || *e != ':') break;
+        p = e + 1;
+        const unsigned long l = strtoul(p, &e, 16);
+        if (e == p) break;
+        p = e;
+        addr[*n] = (uint32_t)a; len[*n] = (uint32_t)l; (*n)++;
+        while (*p == ',' || *p == ' ') p++;
+    }
+}
+
+static BOOL CALLBACK init_once(PINIT_ONCE o, PVOID a, PVOID* c)
+{
+    (void)o; (void)a; (void)c;
+    const char* path = getenv("PS3_LATENCY_LOG");
+    if (!path || !*path || !(s_file = fopen(path, "w"))) { g_lat_log_on = 0; return TRUE; }
+    static char buf[1 << 16];
+    setvbuf(s_file, buf, _IOFBF, sizeof buf);
+    LARGE_INTEGER f; QueryPerformanceFrequency(&f); s_qpf = f.QuadPart;
+    fprintf(s_file, "# qpc_frequency=%lld\n", (long long)s_qpf);
+    {   uint32_t a[8], l[8]; int n = 0;
+        parse_ranges(getenv("PS3_LATENCY_WATCH"), 8, &n, a, l);
+        for (int i = 0; i < n; i++) { s_watch[i].addr = a[i]; s_watch[i].len = (l[i] + 3) & ~3u; }
+        s_nwatch = n;
+        fprintf(s_file, "# watch");
+        for (int i = 0; i < n; i++) fprintf(s_file, " %08X:%X", s_watch[i].addr, s_watch[i].len);
+        fprintf(s_file, "\n"); }
+    {   uint32_t a[1], l[1]; int n = 0;
+        parse_ranges(getenv("PS3_LATENCY_DUMP"), 1, &n, a, l);
+        if (n && l[0]) {
+            char dp[MAX_PATH * 2];
+            snprintf(dp, sizeof dp, "%s.dump", path);
+            if ((s_dump = fopen(dp, "wb"))) { s_dumpr.addr = a[0]; s_dumpr.len = l[0]; }
+        } }
+    g_lat_log_on = 1;
+    return TRUE;
+}
+
+int lat_log_init(void)
+{
+    InitOnceExecuteOnce(&s_once, init_once, NULL, NULL);
+    return g_lat_log_on > 0;
+}
+
+/* caller holds the lock: flush every ~50 ms of events (a killed game keeps them) */
+static void maybe_flush(LONGLONG now)
+{
+    if (now - s_last_flush > s_qpf / 20) {
+        fflush(s_file);
+        if (s_dump) fflush(s_dump);
+        s_last_flush = now;
+    }
+}
+
+static void vput(char kind, LONGLONG q, const char* fmt, va_list ap)
+{
+    AcquireSRWLockExclusive(&s_lock);
+    fprintf(s_file, "%c %lld ", kind, (long long)q);
+    vfprintf(s_file, fmt, ap);
+    fputc('\n', s_file);
+    maybe_flush(q);
+    ReleaseSRWLockExclusive(&s_lock);
+}
+
+void lat_log_(char kind, const char* fmt, ...)
+{
+    if (!lat_log_init()) return;
+    const LONGLONG q = lat_qpc();
+    va_list ap; va_start(ap, fmt);
+    vput(kind, q, fmt, ap);
+    va_end(ap);
+}
+
+void lat_log_at_(char kind, int64_t qpc, const char* fmt, ...)
+{
+    if (!lat_log_init()) return;
+    va_list ap; va_start(ap, fmt);
+    vput(kind, (LONGLONG)qpc, fmt, ap);
+    va_end(ap);
+}
+
+static uint32_t rd_be32(uint32_t ea)
+{
+    const unsigned char* p = vm_base + ea;
+    return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
+}
+
+void lat_log_flip_call(unsigned seq)
+{
+    if (!lat_log_enabled()) return;
+    const LONGLONG q = lat_qpc();
+    char line[512];
+    int n = snprintf(line, sizeof line, "F %lld %u", (long long)q, seq);
+    for (int i = 0; i < s_nwatch && vm_base; i++)
+        for (uint32_t o = 0; o < s_watch[i].len && n < (int)sizeof line - 12; o += 4)
+            n += snprintf(line + n, sizeof line - n, " %08X", rd_be32(s_watch[i].addr + o));
+    AcquireSRWLockExclusive(&s_lock);
+    fputs(line, s_file);
+    fputc('\n', s_file);
+    if (s_dump && vm_base) {
+        const uint32_t s32 = seq;
+        const long long q64 = (long long)q;
+        fwrite(&s32, 4, 1, s_dump);
+        fwrite(&q64, 8, 1, s_dump);
+        fwrite(vm_base + s_dumpr.addr, 1, s_dumpr.len, s_dump);
+    }
+    maybe_flush(q);
+    ReleaseSRWLockExclusive(&s_lock);
+}

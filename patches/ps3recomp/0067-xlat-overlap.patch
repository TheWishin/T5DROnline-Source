+typedef struct { UINT n, range, has_ds; D3D12_CPU_DESCRIPTOR_HANDLE ds; D3D12_CPU_DESCRIPTOR_HANDLE rt[8]; } rq_rts;
+static void STDMETHODCALLTYPE rq_OMSetRenderTargets(ID3D12GraphicsCommandList* l, UINT n, const D3D12_CPU_DESCRIPTOR_HANDLE* rt,
+                                                    BOOL range, const D3D12_CPU_DESCRIPTOR_HANDLE* ds)
+{

+/* ---------------------------------------------------------------------------
+ * PC display: a swap chain that follows the window's client size, a scaled and
+ * letterboxed present blit, vsync on/off and exclusive fullscreen.
+ *   PS3_RES_SCALE=<f>         internal resolution (see ld_px)
+ *   PS3_VSYNC=0               present without waiting for vblank (tearing
+ *                             allowed when the OS supports it)
+ *   PS3_FULLSCREEN=exclusive  Alt+Enter/F11 (and startup) use DXGI exclusive
+ *                             fullscreen; otherwise borderless (window side,
+ *                             rsx_null_backend.c)
+ *   PS3_PRESENT_FILTER=point  nearest-neighbour present scaling
+ * -----------------------------------------------------------------------*/
+#ifndef DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING
+#define DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING 2048
+#endif
+#ifndef DXGI_PRESENT_ALLOW_TEARING
+#define DXGI_PRESENT_ALLOW_TEARING 0x00000200UL
+#endif
+static struct {
+    HWND hwnd;
+    u32 bb_w, bb_h;               /* current swap-chain buffer size */
+    UINT swap_flags;              /* creation flags, reused by ResizeBuffers */
+    int vsync, tearing, filter_point, exclusive_cfg, fs_exclusive;
+    volatile LONG fs_request;     /* -1 none, 0 leave / 1 enter exclusive */
+    ID3D12RootSignature* rootsig;
+    ID3D12PipelineState* pso;
+    ID3D12DescriptorHeap* heap;   /* shader-visible, one SRV per backbuffer */
+    u32 heap_step;

+    if (ftell(f) == 0) fwrite(&g_prewarm_stamp, sizeof(g_prewarm_stamp), 1, f);
+    fwrite(&r, sizeof(r), 1, f);
+    fwrite(pd->VS.pShaderBytecode, 1, r.vs_len, f);
+    fwrite(pd->PS.pShaderBytecode, 1, r.ps_len, f);
+    fclose(f);
+    s->pso = (ID3D12PipelineState*)(uintptr_t)1;   /* recorded; never taken (see below) */
+}

+        r1 |= (uint64_t)T[(i1 >> (8 * j)) & 0xFF] << (8 * j);
+    }
+    __m128i r = _mm_set_epi64x((long long)r1, (long long)r0);
+    if (__builtin_expect(_mm_movemask_epi8(C) != 0, 0)) {
+        const __m128i neg = _mm_cmpgt_epi8(_mm_setzero_si128(), C);
+        const __m128i mC0 = _mm_cmpeq_epi8(_mm_and_si128(C, _mm_set1_epi8((char)0xC0)), _mm_set1_epi8((char)0xC0));
+        const __m128i mE0 = _mm_cmpeq_epi8(_mm_and_si128(C, _mm_set1_epi8((char)0xE0)), _mm_set1_epi8((char)0xE0));
+        const __m128i special = _mm_or_si128(_mm_andnot_si128(mE0, mC0), _mm_and_si128(mE0, _mm_set1_epi8((char)0x80)));
+        r = _mm_or_si128(_mm_andnot_si128(neg, r), special);
+    }
+    u128 out; memcpy(&out, &r, 16); return out;

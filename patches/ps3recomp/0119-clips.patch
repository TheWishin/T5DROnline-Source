+/* Patch 0119: present-only capture. These readbacks have their OWN monotonic
+ * fence; their lifetime must not depend on the renderer's recycled frame fence.
+ * Nothing here waits for the capture GPU copy or touches guest memory/input.
+ * Original RGBA is passed to the worker; resizing/colour conversion/encoding
+ * and disk access are all outside the renderer. At 4K three slots total 95 MiB.
+ */
+#define CLIP_READBACKS 3
+typedef struct ClipReadback {
+    ID3D12Resource* resource;
+    UINT64 pending;
+    long long time;
+    volatile LONG held; /* mapped view owned by the encoder worker */
+} ClipReadback;
+static ClipReadback s_clip_readbacks[CLIP_READBACKS];
+static ID3D12Fence* s_clip_fence;
+static UINT64 s_clip_sequence;
+static long long s_clip_last;
+static u32 s_clip_pitch, s_clip_width, s_clip_height;
+static int s_clip_failed;
+
+static void clips_controls(long long now)
+{
+    static int key_was_down;
+    static long long held[CELL_PAD_MAX_PORT_NUM];
+    static int fired[CELL_PAD_MAX_PORT_NUM];
+    int down = GetForegroundWindow() == s_d3d.hwnd &&
+               (GetAsyncKeyState(VK_CONTROL) & 0x8000) &&
+               (GetAsyncKeyState(VK_F10) & 0x8000);
+    if (down && !key_was_down) rsx_clips_request_save();
+    key_was_down = down;
+    for (u32 p = 0; p < CELL_PAD_MAX_PORT_NUM; ++p) {
+        PadHostPort pad;
+        const u16 chord = CELL_PAD_CTRL_SELECT | CELL_PAD_CTRL_R3;
+        /* Cached peek performs no device I/O and never waits for input locks. */
+        int sampled = padh_peek_cached(p, &pad);
+        if (sampled < 0) continue; /* skip a contended sample without resetting a held chord */
+        int pressed = sampled && pad.connected && (pad.buttons & chord) == chord;
+        if (!pressed) { held[p] = 0; fired[p] = 0; }
+        else if (!held[p]) held[p] = now;
+        else if (!fired[p] && now - held[p] >= 10000000LL) {
+            fired[p] = 1;
+            rsx_clips_request_save();
+        }
+    }
+}
+
+/* Executed by the worker after conversion, or immediately by the renderer
+ * when the bounded worker queue rejects a frame. Resource release at shutdown
+ * happens only after rsx_clips_shutdown has joined and returned every view. */
+static void clips_unmap(void* context)
+{
+    ClipReadback* slot = (ClipReadback*)context;
+    D3D12_RANGE written = {0, 0};
+    slot->resource->lpVtbl->Unmap(slot->resource, 0, &written);
+    InterlockedExchange(&slot->held, 0);
+}
+
+static void clips_collect(void)
+{
+    if (!s_clip_fence) return;
+    UINT64 done = s_clip_fence->lpVtbl->GetCompletedValue(s_clip_fence);
+    if (done == UINT64_MAX) {
+        if (!s_clip_failed) fprintf(stderr, "[clips] GPU readback disabled: device removed\n");
+        s_clip_failed = 1;
+        return;
+    }
+    /* Process in capture order when a slow encoder causes more than one slot
+     * to become ready. Never Map an unfinished copy (Map itself does not wait). */
+    for (int n = 0; n < CLIP_READBACKS; ++n) {
+        int oldest = -1;
+        for (int i = 0; i < CLIP_READBACKS; ++i)
+            if (s_clip_readbacks[i].pending &&
+                (oldest < 0 || s_clip_readbacks[i].pending < s_clip_readbacks[oldest].pending))
+                oldest = i;
+        if (oldest < 0 || s_clip_readbacks[oldest].pending > done) break;
+        void* mapped = NULL;
+        D3D12_RANGE range = {0, (SIZE_T)s_clip_pitch * s_clip_height};
+        ID3D12Resource* r = s_clip_readbacks[oldest].resource;
+        if (SUCCEEDED(r->lpVtbl->Map(r, 0, &range, &mapped)) && mapped) {
+            ClipReadback* slot = &s_clip_readbacks[oldest];
+            InterlockedExchange(&slot->held, 1);
+            slot->pending = 0;
+            /* Transfer the mapped GPU readback view; no CPU pixel copy on the
+             * render thread. A rejected transfer remains ours to unmap. */
+            if (!rsx_clips_video(mapped, s_clip_width, s_clip_height, s_clip_pitch,
+                                 slot->time, clips_unmap, slot))
+                clips_unmap(slot);
+        } else {
+            s_clip_readbacks[oldest].pending = 0;
+        }
+    }
+}
+
+/* Records the copy with the source in PRESENT, restores PRESENT, and returns
+ * the slot whose fence is signalled after this command list executes. */
+static int clips_record(u32 fi)
+{
+    if (!s_present_this_frame || !rsx_clips_enabled()) return -1;
+    long long now = rsx_clips_clock();
+    clips_controls(now);
+    clips_collect();
+    if (s_clip_failed || !s_d3d.width || !s_d3d.height ||
+        s_d3d.width > 3840 || s_d3d.height > 2160 || now - s_clip_last < 333333LL) return -1;
+    /* The backend currently fixes swapchain dimensions for its lifetime. Fail
+     * closed if that changes, rather than mapping/copying an undersized slot. */
+    if (s_clip_fence && (s_clip_width != s_d3d.width || s_clip_height != s_d3d.height)) {
+        s_clip_failed = 1;
+        fprintf(stderr, "[clips] GPU readback disabled: swapchain size changed\n");
+        return -1;
+    }
+    if (!s_clip_fence) {
+        HRESULT hr = s_d3d.device->lpVtbl->CreateFence(s_d3d.device, 0, D3D12_FENCE_FLAG_NONE,
+                        &IID_ID3D12Fence, (void**)&s_clip_fence);
+        if (FAILED(hr)) {
+            fprintf(stderr, "[clips] GPU fence failed 0x%08lX\n", (unsigned long)hr);
+            s_clip_failed = 1; return -1;
+        }
+        s_clip_width = s_d3d.width; s_clip_height = s_d3d.height;
+        s_clip_pitch = (s_d3d.width * 4 + 255) & ~255u;
+    }
+    for (int i = 0; i < CLIP_READBACKS; ++i) {
+        if (s_clip_readbacks[i].pending ||
+            InterlockedCompareExchange(&s_clip_readbacks[i].held, 0, 0)) continue;
+        if (!s_clip_readbacks[i].resource) {
+            D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_READBACK;
+            D3D12_RESOURCE_DESC desc = {0};
+            desc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+            desc.Width = (UINT64)s_clip_pitch * s_d3d.height;
+            desc.Height = 1; desc.DepthOrArraySize = 1; desc.MipLevels = 1;
+            desc.SampleDesc.Count = 1; desc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+            HRESULT hr = s_d3d.device->lpVtbl->CreateCommittedResource(s_d3d.device,
+                &hp, D3D12_HEAP_FLAG_NONE, &desc, D3D12_RESOURCE_STATE_COPY_DEST,
+                NULL, &IID_ID3D12Resource, (void**)&s_clip_readbacks[i].resource);
+            if (FAILED(hr)) {
+                fprintf(stderr, "[clips] GPU readback allocation failed 0x%08lX\n", (unsigned long)hr);
+                s_clip_failed = 1; return -1;
+            }
+        }
+        D3D12_RESOURCE_BARRIER b = {0};
+        b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        b.Transition.pResource = s_d3d.render_targets[fi];
+        b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        b.Transition.StateBefore = D3D12_RESOURCE_STATE_PRESENT;
+        b.Transition.StateAfter = D3D12_RESOURCE_STATE_COPY_SOURCE;
+        s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &b);
+        D3D12_TEXTURE_COPY_LOCATION dst = {0}, src = {0};
+        dst.pResource = s_clip_readbacks[i].resource;
+        dst.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+        dst.PlacedFootprint.Footprint.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+        dst.PlacedFootprint.Footprint.Width = s_d3d.width;
+        dst.PlacedFootprint.Footprint.Height = s_d3d.height;
+        dst.PlacedFootprint.Footprint.Depth = 1;
+        dst.PlacedFootprint.Footprint.RowPitch = s_clip_pitch;
+        src.pResource = s_d3d.render_targets[fi];
+        src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        s_d3d.cmd_list->lpVtbl->CopyTextureRegion(s_d3d.cmd_list, &dst, 0, 0, 0, &src, NULL);
+        b.Transition.StateBefore = D3D12_RESOURCE_STATE_COPY_SOURCE;
+        b.Transition.StateAfter = D3D12_RESOURCE_STATE_PRESENT;
+        s_d3d.cmd_list->lpVtbl->ResourceBarrier(s_d3d.cmd_list, 1, &b);
+        s_clip_readbacks[i].pending = ++s_clip_sequence;
+        s_clip_readbacks[i].time = now;
+        /* Advance a stable 30 Hz deadline: anchoring each deadline at now
+         * would turn tiny 60 Hz jitter into systematic 20 Hz capture. */
+        s_clip_last = s_clip_last ? s_clip_last + 333333LL : now;
+        if (now - s_clip_last > 333333LL) s_clip_last = now;
+        return i;
+    }
+    return -1; /* GPU or worker busy: drop rather than stall the game. */
+}
+
+static void clips_release(void)
+{
+    /* Called only after the renderer's normal shutdown GPU drain. */
+    rsx_clips_shutdown();
+    for (int i = 0; i < CLIP_READBACKS; ++i) {
+        if (s_clip_readbacks[i].resource)
+            s_clip_readbacks[i].resource->lpVtbl->Release(s_clip_readbacks[i].resource);
+        memset(&s_clip_readbacks[i], 0, sizeof s_clip_readbacks[i]);
+    }
+    if (s_clip_fence) s_clip_fence->lpVtbl->Release(s_clip_fence);
+    s_clip_fence = NULL;
+    s_clip_sequence = 0; s_clip_last = 0; s_clip_failed = 0;
+    s_clip_pitch = s_clip_width = s_clip_height = 0;
+}

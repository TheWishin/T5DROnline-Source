+ * Now a block goes back on a free list when its thread ends
+ * (ppu_tls_thread_end, called from the thread procedure), and when the window
+ * is full a new block comes from the guest stack region instead. Blocks are
+ * reused, so the most ever made is the most threads alive at once, and the
+ * shared fallback is only left for a full table -- logged, with a running
+ * count, so a soak can check it never happens. */
+#include <mutex>
+enum { PPU_TLS_POOL_MAX = 128 };                /* > PPU_THREAD_MAX (64) */
+static struct { uint32_t base; uint8_t used; } s_tls_pool[PPU_TLS_POOL_MAX];

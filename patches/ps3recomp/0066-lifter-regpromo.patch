+#!/usr/bin/env python3
+"""Differential test of the lifter's register promotion (--regpromo).
+
+    python tools/regpromo_diff.py --old LIFT_DIR --new LIFT_DIR (--funcs FILE | --addr A,B,... |
+                                  --sample N | --all) [--iters N] [--march x86-64-v3|none] [--work DIR]
+
+Takes the same functions from two lifts of the same image -- one made without
+register promotion, one with -- and runs both versions of every function on
+the same random inputs in one harness, comparing everything they leave
+behind:
+
+  * the whole ppu_context after the function returns (every register, LR,
+    CTR, XER, FPSCR, VSCR, the vector registers, the reservation);
+  * guest memory (a 64 KB sandbox every guest address is folded into);
+  * the event trace: every vm_read*/vm_write* with its address and value, every
+    store-conditional, every call out of the function (direct, indirect, HLE,
+    syscall, trampoline) together with a hash of the WHOLE context at that
+    moment -- so a register that was not written back before a call, or not
+    reloaded after it, shows up at the call it went wrong at.
+
+Calls out of the function go to stubs that act like a callee: they change the
+volatile registers, a non-volatile one now and then, CR/XER/CTR/LR, a vector
+register, a memory word, and sometimes leave a trampoline to drain -- as a
+function of the context hash, so a difference anywhere before the call changes
+what comes after it. A run stops after --events events (loops on random
+counters); a stopped run is compared by its trace and memory (the promoted
+version's registers live in locals until the next call, so its context is not
+expected to be current then).
+
+Inputs: per function and iteration a seed; registers drawn from a mix of
+zero, -1, small, sign/zero-extended 32-bit, sandbox pointers and random
+64-bit values; FPRs from normal, denormal, zero, infinite and NaN encodings;
+random CR, XER (SO/OV/CA and the byte count), CTR mostly small; random memory.
+
+The harness is compiled with clang-cl and the lifted code's own options
+(/O2 /Ob2, -ffp-contract=off, -march). Exit status 0 = no difference.
+Game-derived code stays in --work (never commit it).
+"""
+import argparse
+import os
+import random
+import re
+import subprocess
+import sys
+import time
+
+TOOLS = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.dirname(TOOLS)
+sys.path.insert(0, TOOLS)
+
+LABEL_RE = re.compile(r"^\s*loc_[0-9A-F]{8}:(?:\s*;)?(?:\s*/\*.*\*/)?$")
+FUNC_DEF_RE = re.compile(r"^(?:__attribute__\(\(weak\)\) )?void (?:__attribute__\(\(weak\)\) )?"
+                         r"(?P<name>(?:[A-Za-z_]\w*?)?func_(?P<addr>[0-9A-F]{8}))\(ppu_context\* ctx\) \{$")
+
+
+def read_lift(d):
+    """{addr: function text} and the preamble of the first chunk, from a lift directory."""
+    funcs, preamble = {}, None
+    names = sorted(n for n in os.listdir(d) if re.match(r".*_\d{3}\.cpp$", n) or n.endswith(".c"))
+    for n in names:
+        with open(os.path.join(d, n), encoding="latin-1") as f:
+            lines = f.read().split("\n")
+        i = 0
+        while i < len(lines):
+            m = FUNC_DEF_RE.match(lines[i])
+            if not m:
+                i += 1
+                continue
+            if preamble is None:
+                k = i
+                while k > 0 and lines[k - 1].startswith("/* ") and lines[k - 1].endswith(" */"):
+                    k -= 1          # a recovered-name comment above the first function
+                preamble = "\n".join(lines[:k])
+            j = i + 1
+            while lines[j] != "}":
+                j += 1
+            funcs[int(m.group("addr"), 16)] = (m.group("name"), "\n".join(lines[i:j + 1]))
+            i = j + 1
+    return funcs, preamble
+
+
+def header_text(d):
+    """The lift's ppu_recomp.h without its function declarations, raw guest accesses
+    folded into the sandbox."""
+    with open(os.path.join(d, "ppu_recomp.h"), encoding="latin-1") as f:
+        return harness_header(f.read())
+
+
+def harness_header(text):
+    """A generated header's text for the harness: no function declarations (the
+    harness defines its own callee stubs), raw guest accesses folded into the sandbox."""
+    out = []
+    for ln in text.splitlines():
+        if re.match(r"^void (?:[A-Za-z_]\w*?)?func_[0-9A-F]{8}\(ppu_context\* ctx\);(?: /\* external \*/)?$", ln):
+            continue
+        out.append(ln)
+    txt = "\n".join(out)
+    n = txt.count("VM_BASE + (uint32_t)(ea)")
+    if n < 2:
+        sys.exit("ppu_recomp.h: the raw access macros are not where this tool expects them")
+    return txt.replace("VM_BASE + (uint32_t)(ea)", "VM_BASE + HARN_EA(ea)")
+
+
+RUNTIME = r"""
+/* ---- harness runtime ---------------------------------------------------- */
+#include <setjmp.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <windows.h>
+#define HMEM 0x10000u
+static uint8_t g_mem[HMEM + 64];
+static uint8_t g_mem_a[HMEM + 64];
+extern "C" { uint8_t* vm_base = g_mem; int vm_inline_ok = 0; uint32_t ppu_vm_size = 0;
+             uint32_t ppu_hle_inject_base = 0; int vm_store_inline_ok = 0; unsigned char* vm_coh_bitmap = 0;
+             void vm_store_coh_notify(uint32_t ea) { (void)ea; } }
+static uint64_t g_tr, g_ev, g_ev_limit = 20000, g_tb;
+static jmp_buf g_jb;
+static inline uint64_t mix(uint64_t h, uint64_t v) {
+    h ^= v + 0x9E3779B97F4A7C15ull + (h << 6) + (h >> 2);
+    h *= 0xFF51AFD7ED558CCDull; return h ^ (h >> 33); }
+static int g_verbose;
+/* Single-precision signalling NaNs (exponent all ones, quiet bit clear) in the data are
+ * quieted unless HARN_SNAN=keep: C's float<->double conversions leave an sNaN's quiet bit to
+ * the optimizer (LLVM folds fptrunc(fpext(x)) to x), so lfs -> stfs of one can differ between
+ * two compilations of the SAME source; that class is measured on its own (--snan keep). */
+static int g_quiet_snan = 1;
+static inline uint32_t qs32(uint32_t w) { return (g_quiet_snan && (w & 0x7FC00000u) == 0x7F800000u && (w & 0x003FFFFFu)) ? (w | 0x00400000u) : w; }
+static inline uint64_t qs64(uint64_t v) { return ((uint64_t)qs32((uint32_t)(v >> 32)) << 32) | qs32((uint32_t)v); }
+static void ev(uint64_t a, uint64_t b) { g_tr = mix(mix(g_tr, a), b);
+    if (g_verbose) printf("  ev %llu %09llX %016llX\n", (unsigned long long)g_ev, (unsigned long long)a, (unsigned long long)b);
+    if (++g_ev > g_ev_limit) longjmp(g_jb, 1); }
+#define HEA(a) ((uint32_t)(a) & (HMEM - 1))
+extern "C" uint8_t vm_read8(uint64_t a) { uint8_t v = g_mem[HEA(a)]; ev(0x100000000ull | (uint32_t)a, v); return v; }
+extern "C" uint16_t vm_read16(uint64_t a) { uint16_t v; memcpy(&v, g_mem + HEA(a), 2); v = __builtin_bswap16(v); ev(0x110000000ull | (uint32_t)a, v); return v; }
+extern "C" uint32_t vm_read32(uint64_t a) { uint32_t v; memcpy(&v, g_mem + HEA(a), 4); v = qs32(__builtin_bswap32(v)); ev(0x120000000ull | (uint32_t)a, v); return v; }
+extern "C" uint64_t vm_read64(uint64_t a) { uint64_t v; memcpy(&v, g_mem + HEA(a), 8); v = __builtin_bswap64(v); ev(0x130000000ull | (uint32_t)a, v); return v; }
+extern "C" void vm_write8(uint64_t a, uint8_t v) { ev(0x200000000ull | (uint32_t)a, v); g_mem[HEA(a)] = v; }
+extern "C" void vm_write16(uint64_t a, uint16_t v) { ev(0x210000000ull | (uint32_t)a, v); v = __builtin_bswap16(v); memcpy(g_mem + HEA(a), &v, 2); }
+extern "C" void vm_write32(uint64_t a, uint32_t v) { ev(0x220000000ull | (uint32_t)a, v); v = __builtin_bswap32(v); memcpy(g_mem + HEA(a), &v, 4); }
+extern "C" void vm_write64(uint64_t a, uint64_t v) { ev(0x230000000ull | (uint32_t)a, v); v = __builtin_bswap64(v); memcpy(g_mem + HEA(a), &v, 8); }
+extern "C" int ppu_stwcx32(uint64_t a, uint32_t expected, uint32_t val) {
+    uint32_t cur; memcpy(&cur, g_mem + HEA(a), 4); cur = __builtin_bswap32(cur);
+    int ok = cur == expected; ev(0x300000000ull | (uint32_t)a, ((uint64_t)val << 1) | (uint64_t)ok);
+    if (ok) { val = __builtin_bswap32(val); memcpy(g_mem + HEA(a), &val, 4); } return ok; }
+extern "C" int ppu_stdcx64(uint64_t a, uint64_t expected, uint64_t val) {
+    uint64_t cur; memcpy(&cur, g_mem + HEA(a), 8); cur = __builtin_bswap64(cur);
+    int ok = cur == expected; ev(0x310000000ull | (uint32_t)a, mix(val, (uint64_t)ok));
+    if (ok) { val = __builtin_bswap64(val); memcpy(g_mem + HEA(a), &val, 8); } return ok; }
+extern "C" void ppu_resv_line_note(uint64_t a) { ev(0x400000000ull | (uint32_t)a, 0); }
+extern "C" uint64_t ppu_timebase_now(void) { g_tb += 0x1235; ev(0x500000000ull, g_tb); return g_tb; }
+extern "C" PPU_THREAD_LOCAL void (*g_trampoline_fn)(void*) = 0;
+
+static uint64_t ctx_hash(const ppu_context* c) {
+    const uint8_t* p = (const uint8_t*)c; uint64_t h = 0x12345;
+    for (size_t i = 0; i + 8 <= sizeof(*c); i += 8) { uint64_t w; memcpy(&w, p + i, 8); h = mix(h, w); }
+    return h; }
+static void harn_tramp(void* c);
+/* A callee: changes registers, memory and maybe leaves a trampoline, as a function of
+ * everything seen so far (the trace includes the whole context right now). */
+static __attribute__((noinline)) void harn_effect(ppu_context* ctx, uint64_t tag) {
+    ev(tag, ctx_hash(ctx));
+    uint64_t h = g_tr, h2 = mix(h, 7);
+    ctx->gpr[3] = qs64(h); ctx->gpr[4] = qs64(h >> 7); ctx->gpr[0] = qs64(~h); ctx->gpr[11] = qs64(h * 3); ctx->gpr[12] = qs64(h ^ 0x55);
+    ctx->gpr[5 + (h2 & 3)] = qs64(h2);
+    if (h & 1) ctx->gpr[14 + (h >> 8) % 18] = qs64(ctx->gpr[14 + (h >> 8) % 18] ^ h2);
+    if ((h >> 3) & 1) ctx->gpr[1] += 0;     /* the stack pointer stays */
+    uint64_t fb = (h2 & 0x800FFFFFFFFFFFFFull) | (((h2 >> 52) % 3 == 0) ? 0x7FF0000000000000ull : 0x3FF0000000000000ull);
+    fb = qs64(fb); memcpy(&ctx->fpr[1], &fb, 8);
+    if ((h2 >> 9) & 1) { uint64_t fb2 = qs64(mix(h2, 9)); memcpy(&ctx->fpr[(h2 >> 20) % 32], &fb2, 8); }
+    ctx->cr ^= (uint32_t)(h >> 32); ctx->xer ^= (uint32_t)(h2 & 0xE000007Fu); ctx->ctr = h >> 3;
+    ctx->lr = (uint32_t)h2;
+    ctx->vr[(h >> 12) % 32].d[0] ^= h2;
+    if ((h >> 40) % 4 == 0) vm_write64(h2 & ~7ull, qs64(h));
+    if ((h >> 44) % 8 == 0) g_trampoline_fn = harn_tramp;
+}
+static void harn_tramp(void* c) { harn_effect((ppu_context*)c, 0x800000000ull); }
+static __attribute__((noinline)) void harn_call(ppu_context* ctx, uint32_t addr) { harn_effect(ctx, 0x700000000ull | addr); }
+/* At every label of the functions under test (both forms alike): a loop that touches no guest memory
+ * (a spin on a register, the title's `b .` hang) still counts events and ends at the limit. */
+static __attribute__((noinline)) void harn_tick(void) { ev(0xD00000000ull, 0); }
+extern "C" void ps3_indirect_call(ppu_context* ctx) { harn_effect(ctx, 0x900000000ull | (uint32_t)ctx->ctr); }
+extern "C" void ps3_indirect_call_to(ppu_context* ctx, uint32_t t) { harn_effect(ctx, 0xA00000000ull | t); }
+extern "C" void ps3_hle_call(unsigned int nid, ppu_context* ctx) { harn_effect(ctx, 0xB00000000ull | nid); }
+extern "C" void lv2_syscall(ppu_context* ctx) { harn_effect(ctx, 0xC00000000ull | (uint32_t)ctx->gpr[11]); }
+"""
+
+DRIVER = r"""
+/* ---- driver -------------------------------------------------------------- */
+static uint64_t g_rs;
+static uint64_t rnd(void) { g_rs ^= g_rs << 13; g_rs ^= g_rs >> 7; g_rs ^= g_rs << 17; return g_rs * 0x2545F4914F6CDD1Dull; }
+static uint64_t pick64(void) {
+    switch (rnd() % 12) {
+    case 0: return 0; case 1: return ~0ull; case 2: return rnd() % 64; case 3: return (uint64_t)(int64_t)(int32_t)rnd();
+    case 4: return (uint32_t)rnd(); case 5: return 0x10000 + (rnd() & 0xFFF0); case 6: return 0x80000000ull;
+    case 7: return (uint64_t)(int64_t)(int8_t)rnd(); case 8: return 0x7FFFFFFFull; case 9: return 1ull << (rnd() % 64);
+    default: return rnd(); } }
+static uint64_t pickf(void) {
+    switch (rnd() % 10) {
+    case 0: return 0; case 1: return 0x8000000000000000ull; case 2: return 0x7FF0000000000000ull;
+    case 3: return 0xFFF0000000000000ull; case 4: return 0x7FF8000000000000ull | (rnd() & 0xFFFF);
+    case 5: return 0x7FF0000000000001ull | (rnd() & 0x7FFFF); case 6: return rnd() & 0x000FFFFFFFFFFFFFull;
+    case 7: { double d = (double)(int32_t)rnd(); uint64_t u; memcpy(&u, &d, 8); return u; }
+    case 8: { double d = (double)(int32_t)rnd() / 65536.0; uint64_t u; memcpy(&u, &d, 8); return u; }
+    default: return rnd(); } }
+static void gen_input(uint64_t seed, ppu_context* c) {
+    g_rs = seed | 1; for (int i = 0; i < 4; i++) rnd();
+    memset(c, 0, sizeof(*c));
+    for (int i = 0; i < 32; i++) c->gpr[i] = qs64(pick64());
+    c->gpr[1] = 0x8000 + (rnd() & 0x7FF0);
+    for (int i = 0; i < 32; i++) { uint64_t u = qs64(pickf()); memcpy(&c->fpr[i], &u, 8); }
+    for (int i = 0; i < 32; i++) { c->vr[i].d[0] = rnd(); c->vr[i].d[1] = rnd();
+        for (int j = 0; j < 4; j++) c->vr[i].w[j] = __builtin_bswap32(qs32(__builtin_bswap32(c->vr[i].w[j]))); }
+    c->cr = (uint32_t)rnd(); c->xer = (uint32_t)rnd() & 0xE000007Fu;
+    c->ctr = (rnd() % 4) ? rnd() % 40 : pick64(); c->lr = (uint32_t)rnd();
+    c->fpscr = (uint32_t)rnd() & 0xFFFFF0FFu; c->vscr = (rnd() & 1) ? 0x10000u : 0;
+    c->cia = (uint32_t)rnd(); c->thread_id = 1;
+    c->reserve_addr = (rnd() & 1) ? (uint32_t)c->gpr[3 + rnd() % 8] : (uint32_t)rnd();
+    c->reserve_value = (uint32_t)rnd(); c->reserve_valid = (int)(rnd() & 1); c->vrsave = (uint32_t)rnd();
+}
+static void fill_mem(uint64_t seed) {
+    uint64_t s = seed ^ 0xA5A5A5A5DEADBEEFull;
+    for (size_t i = 0; i < sizeof(g_mem); i += 8) { s ^= s << 13; s ^= s >> 7; s ^= s << 17;
+        uint64_t be = __builtin_bswap64(qs64(s)); memcpy(g_mem + i, &be, 8); }
+}
+static ppu_context g_init, g_a, g_b;
+static volatile LONG64 g_beat;
+static DWORD WINAPI watchdog(LPVOID) {
+    LONG64 last = -1; int still = 0;
+    for (;;) { Sleep(1000); LONG64 b = g_beat; if (b == last) { if (++still >= 20) { printf("STUCK\n"); fflush(stdout); ExitProcess(3); } } else { still = 0; last = b; } } }
+static const char* field_of(size_t off) {
+    static char buf[64];
+    if (off < 256) { snprintf(buf, sizeof buf, "gpr[%zu]", off / 8); return buf; }
+    if (off < 512) { snprintf(buf, sizeof buf, "fpr[%zu]", (off - 256) / 8); return buf; }
+    if (off < 1024) { snprintf(buf, sizeof buf, "vr[%zu]", (off - 512) / 16); return buf; }
+    if (off == offsetof(ppu_context, cr)) return "cr";
+    if (off >= offsetof(ppu_context, lr) && off < offsetof(ppu_context, lr) + 8) return "lr";
+    if (off >= offsetof(ppu_context, ctr) && off < offsetof(ppu_context, ctr) + 8) return "ctr";
+    if (off == offsetof(ppu_context, xer)) return "xer";
+    if (off == offsetof(ppu_context, fpscr)) return "fpscr";
+    if (off == offsetof(ppu_context, vscr)) return "vscr";
+    snprintf(buf, sizeof buf, "+0x%zX", off); return buf; }
+int main(int argc, char** argv) {
+    int start = argc > 1 ? atoi(argv[1]) : 0;
+    long iters = argc > 2 ? atol(argv[2]) : 10000;
+    if (argc > 3) g_ev_limit = strtoull(argv[3], 0, 10);
+    long only = argc > 4 ? atol(argv[4]) : -1;    /* replay one input of function `start` with every event printed */
+    if (only < 0) CreateThread(0, 0, watchdog, 0, 0, 0);
+    { const char* e = getenv("HARN_SNAN"); g_quiet_snan = !(e && !strcmp(e, "keep")); }
+    long total_bad = 0;
+    for (int fi = start; fi < (only >= 0 ? start + 1 : NFN); fi++) {
+        printf("F %d %08X\n", fi, g_fns[fi].addr); fflush(stdout);
+        long bad = 0, aborted = 0, calls = 0;
+        for (long k = (only >= 0 ? only : 0); k < (only >= 0 ? only + 1 : iters); k++) {
+            g_beat++;
+            uint64_t seed = mix(g_fns[fi].addr, (uint64_t)k);
+            gen_input(seed, &g_init);
+            /* the unpromoted function */
+            memcpy(&g_a, &g_init, sizeof g_a); fill_mem(seed); g_tr = 0; g_ev = 0; g_tb = 0; g_trampoline_fn = 0;
+            volatile int ab_a = 0;
+            g_verbose = only >= 0; if (g_verbose) printf("old:\n");
+            if (setjmp(g_jb) == 0) g_fns[fi].o(&g_a); else ab_a = 1;
+            uint64_t tr_a = g_tr, ev_a = g_ev; void (*tf_a)(void*) = g_trampoline_fn;
+            memcpy(g_mem_a, g_mem, sizeof g_mem);
+            /* the promoted function */
+            memcpy(&g_b, &g_init, sizeof g_b); fill_mem(seed); g_tr = 0; g_ev = 0; g_tb = 0; g_trampoline_fn = 0;
+            volatile int ab_b = 0;
+            if (g_verbose) printf("new:\n");
+            if (setjmp(g_jb) == 0) g_fns[fi].n(&g_b); else ab_b = 1;
+            g_verbose = 0;
+            uint64_t tr_b = g_tr, ev_b = g_ev; void (*tf_b)(void*) = g_trampoline_fn;
+            g_trampoline_fn = 0;
+            aborted += ab_a;
+            int diff = ab_a != ab_b || tr_a != tr_b || ev_a != ev_b || tf_a != tf_b ||
+                       memcmp(g_mem_a, g_mem, sizeof g_mem) != 0 ||
+                       (!ab_a && memcmp(&g_a, &g_b, sizeof g_a) != 0);
+            if (diff) {
+                if (bad < 5) {
+                    printf("DIFF %08X input %ld: aborted %d/%d events %llu/%llu trace %s tramp %s mem %s",
+                           g_fns[fi].addr, k, ab_a, ab_b, (unsigned long long)ev_a, (unsigned long long)ev_b,
+                           tr_a == tr_b ? "same" : "DIFFERENT", tf_a == tf_b ? "same" : "DIFFERENT",
+                           memcmp(g_mem_a, g_mem, sizeof g_mem) ? "DIFFERENT" : "same");
+                    if (!ab_a && !ab_b) {
+                        const uint8_t* pa = (const uint8_t*)&g_a; const uint8_t* pb = (const uint8_t*)&g_b;
+                        const char* last = "";
+                        for (size_t o = 0; o < sizeof g_a; o++) if (pa[o] != pb[o]) {
+                            const char* f = field_of(o); if (strcmp(f, last)) { printf(" ctx.%s", f); last = f; } }
+                    }
+                    printf("\n");
+                }
+                bad++;
+            }
+        }
+        printf("R %08X iters %ld aborted %ld diff %ld\n", g_fns[fi].addr, iters, aborted, bad); fflush(stdout);
+        total_bad += bad;
+    }
+    printf("DONE %ld\n", total_bad);
+    return total_bad ? 1 : 0;
+}
+"""
+
+
+def harness_source(header, preamble, pairs):
+    """C++ for one harness: pairs = [(addr, old_text, new_text, old_name)]."""
+    pre = preamble.replace("#define PPU_INLINE_STORES 1", "/* (harness: out-of-line guest stores) */")
+    if '#include "ppu_recomp.h"' not in pre:
+        sys.exit("chunk preamble: no #include \"ppu_recomp.h\"")
+    pre = pre.replace('#include "ppu_recomp.h"', "/* ppu_recomp.h (harness copy) above */")
+    out = ["/* regpromo_diff harness -- generated; holds lifted game code: do not commit */",
+           "#define PPU_NO_INLINE_LOADS 1", "#define HARN_EA(ea) ((uint32_t)(ea) & 0xFFFFu)", "#include <stddef.h>",
+           header, pre, RUNTIME]
+    callees = set()
+    for addr, o, n, name in pairs:
+        callees |= set(re.findall(r"\b((?:[A-Za-z_]\w*?)?func_[0-9A-F]{8})\b", o + "\n" + n))
+    for c in sorted(callees):
+        a = re.search(r"func_([0-9A-F]{8})$", c).group(1)
+        out.append(f"static __attribute__((noinline)) void {c}(ppu_context* ctx) {{ harn_call(ctx, 0x{a}u); }}")
+    tbl = []
+    for addr, o, n, name in pairs:
+        for tag, txt in (("old", o), ("new", n)):
+            first, rest = txt.split("\n", 1)
+            # dcbz clears its line through vm_base directly: fold it into the sandbox like every access
+            rest = rest.replace("vm_base + (uint32_t)ea", "vm_base + HARN_EA(ea)")
+            out.append(f"__attribute__((noinline)) void harn_{tag}_{addr:08X}(ppu_context* ctx) {{")
+            out.append("\n".join(ln + (" harn_tick();" if LABEL_RE.match(ln) else "") for ln in rest.split("\n")))
+        tbl.append(f"    {{ 0x{addr:08X}u, harn_old_{addr:08X}, harn_new_{addr:08X} }},")
+    out.append("struct HarnFn { uint32_t addr; void (*o)(ppu_context*); void (*n)(ppu_context*); };")
+    out.append("static const HarnFn g_fns[] = {")
+    out += tbl
+    out.append("};")
+    out.append(f"#define NFN {len(pairs)}")
+    out.append(DRIVER)
+    return "\n".join(out)
+
+
+def find_clang():
+    for d in (os.environ.get("T5DR_LLVM_BIN"), r"C:\Program Files\LLVM\bin"):
+        if d and os.path.exists(os.path.join(d, "clang-cl.exe")):
+            return os.path.join(d, "clang-cl.exe")
+    return "clang-cl"
+
+
+def compile_harness(src, exe, march):
+    from msvc_env import environ
+    cmd = [find_clang(), "/nologo", "/O2", "/Ob2", "/DNDEBUG", "-std:c++20", "-TP", "/EHs-c-", "/Zc:tlsGuards-",
+           "/GS-", "/clang:-ffp-contract=off", "-Wno-unused-value", "-Wno-parentheses-equality",
+           "-Wno-unused-function", "-Wno-unused-label", "-Wno-unknown-pragmas",
+           "-I" + os.path.join(ROOT, "runtime", "ppu"), src, "/Fe:" + exe]
+    if march != "none":
+        cmd.insert(5, f"/clang:-march={march}")
+    t0 = time.time()
+    r = subprocess.run(cmd, env=environ(), capture_output=True, text=True, encoding="utf-8", errors="replace")
+    if r.returncode:
+        print(r.stdout[-6000:], r.stderr[-6000:])
+        sys.exit(f"harness compile failed ({src})")
+    return time.time() - t0
+
+
+def run_harness(exe, n, iters, events, log, snan="quiet"):
+    """Run every function; a stuck one is skipped. Returns (functions, diffs, stuck list)."""
+    start, total_diff, stuck, done = 0, 0, [], 0
+    with open(log, "a", encoding="utf-8") as lf:
+        while start < n:
+            env = dict(os.environ, HARN_SNAN=snan)
+            p = subprocess.run([exe, str(start), str(iters), str(events)], capture_output=True, text=True,
+                               encoding="utf-8", errors="replace", timeout=None, env=env)
+            cur = None
+            for ln in p.stdout.splitlines():
+                lf.write(ln + "\n")
+                if ln.startswith("F "):
+                    cur = int(ln.split()[1])
+                elif ln.startswith("R "):
+                    done += 1
+                    total_diff += int(ln.split()[-1])
+                elif ln.startswith("DIFF"):
+                    print(ln, flush=True)
+            if p.returncode in (0, 1) and "DONE" in p.stdout:
+                break
+            if cur is None:
+                sys.exit(f"harness failed to start: {p.returncode} {p.stderr[-2000:]}")
+            stuck.append(cur)
+            print(f"  function #{cur} stuck or crashed (exit {p.returncode}); going on with the next", flush=True)
+            start = cur + 1
+    return done, total_diff, stuck
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--old", required=True, help="lift without register promotion")
+    ap.add_argument("--new", required=True, help="lift with register promotion")
+    sel = ap.add_mutually_exclusive_group(required=True)
+    sel.add_argument("--funcs", help="file of guest addresses (hex, first token per line, # comments)")
+    sel.add_argument("--addr", help="comma-separated guest addresses")
+    sel.add_argument("--sample", type=int, help="this many functions at random (--seed)")
+    sel.add_argument("--all", action="store_true", help="every function both lifts have")
+    ap.add_argument("--seed", type=int, default=1)
+    ap.add_argument("--iters", type=int, default=10000, help="random inputs per function")
+    ap.add_argument("--events", type=int, default=20000, help="events before a run is stopped")
+    ap.add_argument("--batch", type=int, default=400, help="functions per harness executable")
+    ap.add_argument("--march", default="x86-64-v3", help="x86-64-v3 (as most players) or none (baseline)")
+    ap.add_argument("--work", default=os.path.join(ROOT, "scratch", "regpromo_diff"))
+    ap.add_argument("--snan", choices=("quiet", "keep"), default="quiet",
+                    help="quiet: no single-precision signalling NaN in the data (default); keep: measure that class")
+    a = ap.parse_args()
+
+    old, old_pre = read_lift(a.old)
+    new, _ = read_lift(a.new)
+    common = sorted(set(old) & set(new))
+    if a.funcs:
+        with open(a.funcs) as f:
+            want = [int(t.split()[0], 16) for t in (ln.split("#", 1)[0].strip() for ln in f) if t]
+    elif a.addr:
+        want = [int(t, 16) for t in a.addr.split(",") if t.strip()]
+    elif a.sample:
+        want = random.Random(a.seed).sample(common, min(a.sample, len(common)))
+    else:
+        want = common
+    missing = [w for w in want if w not in old or w not in new]
+    if missing:
+        print(f"not in both lifts (skipped): {', '.join(f'{m:08X}' for m in missing[:20])}")
+    pairs = [(w, old[w][1], new[w][1], old[w][0]) for w in want if w in old and w in new]
+    same = sum(1 for p in pairs if p[1] == p[2])
+    print(f"{len(pairs)} functions ({same} identical in both lifts), {a.iters} inputs each, -march={a.march}",
+          flush=True)
+    os.makedirs(a.work, exist_ok=True)
+    header = header_text(a.old)
+    log = os.path.join(a.work, "regpromo_diff.log")
+    t0 = time.time()
+    n_done = n_diff = 0
+    stuck_all = []
+    for b in range(0, len(pairs), a.batch):
+        chunk = pairs[b:b + a.batch]
+        src = os.path.join(a.work, f"harness_{b // a.batch:03d}.cpp")
+        exe = os.path.join(a.work, f"harness_{b // a.batch:03d}.exe")
+        with open(src, "w", encoding="latin-1") as f:
+            f.write(harness_source(header, old_pre, chunk))
+        ct = compile_harness(src, exe, a.march)
+        d, x, st = run_harness(exe, len(chunk), a.iters, a.events, log, a.snan)
+        n_done += d
+        n_diff += x
+        stuck_all += [chunk[s][0] for s in st]
+        print(f"  batch {b // a.batch}: {d} functions, {x} differing runs (compile {ct:.0f} s, "
+              f"{time.time() - t0:.0f} s so far)", flush=True)
+    print(f"RESULT: {n_done} functions x {a.iters} inputs = {n_done * a.iters} runs, {n_diff} differing; "
+          f"stuck/crashed: {', '.join(f'{s:08X}' for s in stuck_all) or 'none'}")
+    sys.exit(1 if n_diff or stuck_all else 0)
+
+
+if __name__ == "__main__":
+    main()

index 933abcb..4012dce 100644
--- a/libs/video/rsx_fp_decompiler.c
+++ b/libs/video/rsx_fp_decompiler.c
@@ -1294,3 +1294,129 @@ int rsx_fp_apply_unnorm_scale(char* hlsl, u32 hlsl_size, u32 unnorm_mask,

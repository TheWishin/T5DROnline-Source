+    for (u32 k = 0; k < n; k++) {
+        regs[k] = __builtin_bswap32(be_words[k]);
+        seen[k]++;
+    }
+    if (kind == 1) {
+        u32* load = &rsx->regs[M_VP_UPLOAD_FROM_ID >> 2];
+        const u32 lane0 = (idx - (M_VP_UPLOAD_INST >> 2)) & 3;
+        const u32 pos0 = *load * 4 + lane0;
+        u32 changed = 0;
+        if (pos0 < RSX_DSP_VP_WORDS && n <= RSX_DSP_VP_WORDS - pos0 && pos0 >= lane0) {
+            u32* vp = &rsx->vp[pos0];
+            for (u32 k = 0; k < n; k++) {
+                changed += vp[k] != regs[k];
+                vp[k] = regs[k];
+            }
+        } else {
+            /* near the end of vp[] (or a wrapped load pointer): per word */
+            u32 ld = *load;
+            for (u32 k = 0; k < n; k++) {
+                const u32 lane = (lane0 + k) & 3;
+                const u32 pos = ld * 4 + lane;
+                if (pos < RSX_DSP_VP_WORDS && rsx->vp[pos] != regs[k]) {
+                    rsx->vp[pos] = regs[k];
+                    changed++;
+                }
+                if (lane == 3) ld++;
+            }

+# Each file is decrypted and written in pieces of this size. In one piece, a ~600 MB file (Tekken 5 DR's
+# T55DATA1.BIN) needed several GB at once -- the counters, the keystream, the raw bytes, two big integers and the
+# result -- and stopped with MemoryError on a PC with little free memory. A multiple of the 16-byte AES block.
+PIECE = 16 << 20
+# A file this big says how far it is every PROGRESS bytes, so a long unpack is never silent.
+PROGRESS = 64 << 20
+
+
+def write_item(decrypt_range, k, fo, fs, op, nm=""):
+    """Decrypt the `fs` bytes at `fo` piece by piece into `op`: the same bytes as decrypt_range(k, fo, fs) in one
+    call. -> (the first bytes, how many bytes were written; fewer than fs when the package is cut short)."""
+    head, done = b"", 0
+    with open(op, "wb") as out:
+        while done < fs:
+            n = min(PIECE, fs - done)
+            piece = decrypt_range(k, fo + done, n)
+            if not done:
+                head = piece[:16]
+            out.write(piece)
+            done += len(piece)
+            if len(piece) < n:
+                break
+            if fs > PROGRESS and done < fs and done % PROGRESS == 0:
+                print(f"    ... {nm}: {done >> 20} of {fs >> 20} MB", flush=True)
+    return head, done
+
+
 def main():

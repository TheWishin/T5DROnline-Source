+/* Patch 0076: a draw the renderer has no topology for (points, lines, quad
+ * strips, polygons) only counted as drop{prim}; name the first ones of each
+ * kind, so a missing effect can be told from one the game never drew. */
+static void ld_note_prim_drop(u32 prim)
+{
+    static u32 seen[16];
+    static const char* names[16] = { "?", "points", "lines", "line loop", "line strip", "triangles",
+                                     "triangle strip", "triangle fan", "quads", "quad strip", "polygon" };
+    const u32 k = prim < 16 ? prim : 0;
+    if (seen[k]++ >= 3) return;
+    rsx_dsp_texture t0;
+    rsx_dsp_get_texture(&g.rsx, 0, &t0);
+    fprintf(stderr, "[live-draw] primitive %u (%s) not drawn (no topology for it here): frame %u, %u vertices, "
+                    "fragment program 0x%08X, texture 0 %s0x%X fmt 0x%02X %ux%u\n",
+            prim, names[k] ? names[k] : "?", g_ld_frames, dc.n_source_refs ? dc.n_source_refs : dc.n_verts,
+            rsx_dsp_reg(&g.rsx, 0x08E4u), t0.enabled ? "" : "(off) ", t0.offset, t0.format & 0xFFu,
+            t0.width, t0.height);
+}

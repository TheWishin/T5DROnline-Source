--- a/libs/codec/cellAtrac.c
+++ b/libs/codec/cellAtrac.c
@@ -90,6 +90,53 @@ typedef struct {
 
 static AtracSlot s_slots[ATRAC_MAX_SLOTS];
 
+/* Rollback support (src/rollback): the title's streaming bookkeeping (ring
+ * positions, read offsets) lives in guest memory and is rewound by a
+ * rollback, while the decoder's view of it here is not -- the title then
+ * re-adds data the decoder already consumed, the next frame decodes from
+ * the wrong bytes ("Invalid start bit"), and the title's stream reader
+ * aborts the process (phase 6 of docs/ROLLBACK.md). So the positional state
+ * of every slot is saved at each frame boundary and put back with the
+ * rollback; the decoder context and the host file copy stay (re-added bytes
+ * overwrite the same bytes). A restored slot forgets its held PCM frame. */
+typedef struct {
+    u32 handle_ea;
+    s32 pos, loop_num, next_frame;
+    u32 have, ring_wr, ring_fill, read_pos;
+} AtracRbSlot;
+
+size_t cellAtrac_rb_state_size(void) { return sizeof(AtracRbSlot) * ATRAC_MAX_SLOTS; }
+
+void cellAtrac_rb_save(void* out)
+{
+    AtracRbSlot* o = (AtracRbSlot*)out;
+    ATRAC_LOCK();
+    for (int i = 0; i < ATRAC_MAX_SLOTS; i++) {
+        const AtracSlot* s = &s_slots[i];
+        o[i].handle_ea = s->handle_ea;
+        o[i].pos = s->pos; o[i].loop_num = s->loop_num; o[i].next_frame = s->next_frame;
+        o[i].have = s->have; o[i].ring_wr = s->ring_wr; o[i].ring_fill = s->ring_fill; o[i].read_pos = s->read_pos;
+    }
+    ATRAC_UNLOCK();
+}
+
+int cellAtrac_rb_restore(const void* in)
+{
+    const AtracRbSlot* o = (const AtracRbSlot*)in;
+    int n = 0;
+    ATRAC_LOCK();
+    for (int i = 0; i < ATRAC_MAX_SLOTS; i++) {
+        AtracSlot* s = &s_slots[i];
+        if (!s->handle_ea || s->handle_ea != o[i].handle_ea) continue;   /* created or freed since: leave it */
+        s->pos = o[i].pos; s->loop_num = o[i].loop_num; s->next_frame = o[i].next_frame;
+        if (s->img) { s->have = o[i].have; s->ring_wr = o[i].ring_wr; s->ring_fill = o[i].ring_fill; s->read_pos = o[i].read_pos; }
+        s->pcm_frame = -1;
+        n++;
+    }
+    ATRAC_UNLOCK();
+    return n;
+}
+
 static int atrac_trace(void)
 {
     static int on = -1;

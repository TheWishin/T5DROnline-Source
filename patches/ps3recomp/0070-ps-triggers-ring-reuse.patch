+                    if (d->ps_trig && (a == 3 || a == 4)) v = ps_trig_di(v);   /* L2 R2: half axes */
                     if (v > 16384) raw_set_tap(r, CID_AXIS + a * 2);
                     if (v < -16384) raw_set_tap(r, CID_AXIS + a * 2 + 1);
                 }

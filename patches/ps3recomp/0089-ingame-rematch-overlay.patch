+static int ovl_native_get(unsigned cp, ovl_native_glyph* out, int prepare)
+{
+    if (!cp || cp > 0xFFFF || (cp >= 0xD800 && cp <= 0xDFFF)) return 0;
+    AcquireSRWLockShared(&g_native_lock);
+    for (unsigned i = 0; i < 512; i++) if (g_native_cache[i].cp == cp) {
+        *out = g_native_cache[i];
+        ReleaseSRWLockShared(&g_native_lock);
+        return out->valid;
+    }
+    ReleaseSRWLockShared(&g_native_lock);
+    if (!prepare) return 0;  /* live host tick: cache-only, never GDI */
+    ovl_native_glyph glyph = {0};
+    glyph.cp = cp;
+    HDC dc = CreateCompatibleDC(NULL);
+    BITMAPINFO bi = {0};
+    bi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+    bi.bmiHeader.biWidth = 16; bi.bmiHeader.biHeight = -16;
+    bi.bmiHeader.biPlanes = 1; bi.bmiHeader.biBitCount = 32;
+    bi.bmiHeader.biCompression = BI_RGB;
+    uint32_t* pixels = NULL;
+    HBITMAP bitmap = dc ? CreateDIBSection(dc, &bi, DIB_RGB_COLORS, (void**)&pixels, NULL, 0) : NULL;
+    if (dc && bitmap && pixels) {
+        HGDIOBJ old_bitmap = SelectObject(dc, bitmap);
+        static const wchar_t* faces[] = { L"Segoe UI", L"Yu Gothic UI", L"Malgun Gothic",
+            L"Microsoft YaHei UI", L"Noto Sans CJK JP", L"Noto Sans CJK KR", L"Arial Unicode MS" };
+        const wchar_t ch = (wchar_t)cp;
+        for (unsigned f = 0; f < sizeof faces / sizeof faces[0]; f++) {
+            HFONT font = CreateFontW(-14, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE,
+                DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS, NONANTIALIASED_QUALITY,
+                DEFAULT_PITCH, faces[f]);
+            if (!font) continue;
+            HGDIOBJ old_font = SelectObject(dc, font);
+            WORD index = 0xFFFF;
+            SIZE size = {0};
+            if (GetGlyphIndicesW(dc, &ch, 1, &index, GGI_MARK_NONEXISTING_GLYPHS) != GDI_ERROR &&
+                index != 0xFFFF && GetTextExtentPoint32W(dc, &ch, 1, &size) &&
+                size.cx > 0 && size.cx <= 16) {
+                memset(pixels, 0, 16 * 16 * sizeof(uint32_t));
+                SetTextColor(dc, RGB(255,255,255)); SetBkColor(dc, RGB(0,0,0));
+                SetBkMode(dc, OPAQUE);
+                if (TextOutW(dc, 0, 0, &ch, 1)) {
+                    GdiFlush();
+                    glyph.advance = size.cx; glyph.valid = 1;
+                    for (unsigned y = 0; y < 16; y++) for (unsigned x = 0; x < 16; x++)
+                        if (pixels[y * 16 + x] & 0x00FFFFFFu) glyph.rows[y] |= (uint16_t)(1u << x);
+                }
+            }
+            SelectObject(dc, old_font); DeleteObject(font);
+            if (glyph.valid) break;
+        }
+        SelectObject(dc, old_bitmap);
+    }
+    if (bitmap) DeleteObject(bitmap);
+    if (dc) DeleteDC(dc);
+    AcquireSRWLockExclusive(&g_native_lock);
+    g_native_cache[g_native_next++ % 512] = glyph;
+    *out = glyph;
+    ReleaseSRWLockExclusive(&g_native_lock);
+    return glyph.valid;
+}
+#else
+static int ovl_native_get(unsigned cp, ovl_native_glyph* out, int prepare)
+{ (void)cp; (void)out; (void)prepare; return 0; }

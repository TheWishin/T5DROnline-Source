index 0000000..904a292
--- /dev/null
+++ b/runtime/platform/host_sched.c
@@ -0,0 +1,577 @@
+/*
+ * ps3recomp - host scheduling policy for the runtime's threads (Windows).
+ * See host_sched.h for the model.
+ *
+ * Environment (all optional; defaults in brackets):
+ *   PS3_SCHED=0               stock behaviour everywhere this file decides
+ *                             (thread names stay): only the old "guest prio
+ *                             < 256 -> ABOVE_NORMAL" boost, the per-call
+ *                             usleep timer, the Sleep(1) flip wait, no FIFO
+ *                             kick on the user command, a thread per SPURS
+ *                             chain kick
+ *   PS3_SCHED_LOG=1           one line per thread with what it was given
+ *   PS3_SCHED_PRIO_<ROLE>=n   host priority level for a role: -2..2, 15 =
+ *                             TIME_CRITICAL, x = leave alone. Roles: MAIN [1]
+ *                             TICKER [2] SPU [2] SPURS [1] AUDIO [15]
+ *                             DECODER [x] TIMER [x] BG [-1], and PPUHI [1] /
+ *                             PPU [1] / PPULO [x] for guest threads by lv2
+ *                             priority (< 256 / < PS3_SCHED_PPU_LO / rest)
+ *   PS3_SCHED_PPU_LO=n        first lv2 priority that counts as background
+ *                             [1002: Tekken's loaders, decoder, http]
+ *   PS3_PRIORITY_CLASS=c      normal | above | high [normal]
+ *   PS3_SCHED_MMCSS_<ROLE>=t  join MMCSS task t ("Games", "Pro Audio", ...)
+ *                             [none]
+ *   PS3_SCHED_CPUS=g          CPU set for the whole process: all | fast |
+ *                             slow | 0x<mask of logical processors> [all]
+ *                             (fast = the last-level-cache group holding the
+ *                             cores the firmware ranks fastest, i.e. CCD0 on a
+ *                             Ryzen 7950X; slow = every other group)
+ *   PS3_SCHED_CPUS_<ROLE>=g   same, for one role's threads [all]
+ *   PS3_SCHED_IDEAL=1         ideal processor hints: MAIN, TICKER, SPU, AUDIO
+ *                             each on their own of the fastest-ranked cores,
+ *                             SPURS workers on the rest [off]
+ *   PS3_SCHED_THROTTLE=0      leave Windows power throttling (EcoQoS, and the
+ *                             Windows 11 rule that drops the 1 ms timer of a
+ *                             minimized or occluded window) in charge [opted out]
+ *   PS3_SCHED_TIMER=0         usleep >= 1 ms on a fresh standard waitable
+ *                             timer, as before, instead of a cached
+ *                             high-resolution one [high-resolution]
+ *   PS3_SCHED_SPIN_US=n       lv2 semaphore waits poll n us before parking [0]
+ *   PS3_SCHED_SUBMS=m         usleep < 1 ms: spin (SwitchToThread, as before) |
+ *                             pause (PAUSE, yield every 50 us) | timer [spin]
+ *   PS3_SCHED_KICK=0          (cellGcmSys.c) do not wake the present thread
+ *                             when cellGcmSetUserCommand advances put [wake]
+ *   PS3_SCHED_FLIPWAIT=0      (cellGcmSys.c) cellGcmSetWaitFlip polls with
+ *                             Sleep(1) again [woken by the flip]
+ *   PS3_SCHED_JCPOOL=0        (cellSpurs.c) a new thread per job-chain kick
+ *                             [one parked walker per chain]
+ *   PS3_SCHED_TRACE=<file>    binary event trace (16-byte records:
+ *                             u64 qpc, u16 kind, u16 tid, u32 arg; the file
+ *                             starts with "HSTR", u32 version, u64 qpc freq)
+ *
+ * Measured: Tekken 5 DR, scripted 2-pad VS fight, 40 s windows, Ryzen 9
+ * 7950X (2 CCDs, SMT), minimized window, fps from the presents, mean of 2-3
+ * runs. Other agents' builds and game instances kept 13-29 of the 32 logical
+ * processors busy in almost every run (run-to-run noise ~ +-8 fps); the one
+ * quiet run (4 busy) of the default policy reached 58.9 fps.
+ *
+ *   Before patch 0005 (flip completed at call time, SetWaitFlip blocking),
+ *   machine saturated (25-29 cores busy elsewhere):
+ *     stock (PS3_SCHED=0)                   27.0 fps, 97% of frames > 20 ms
+ *     handshake fixes only                  34.9-37.4 (user command -> FIFO
+ *                                           drain 4.9 -> 1.5 ms, flip -> main
+ *                                           0.8 -> 0.04 ms, kick -> first
+ *                                           skinning job 3.9 -> 1.4 ms)
+ *     + per-thread priority map             48.3
+ *     map + class ABOVE_NORMAL              50.8
+ *     class ABOVE_NORMAL / HIGH alone       38.0 / 41.6
+ *     MMCSS Games (main, ticker) + Pro
+ *       Audio (SPU, mixer)                  47.4 (54 and 40: unstable)
+ *     SPURS_JOB_THREADS 2/4/6/8/12          43/41/35/44/49 (job list 13/5.3/
+ *                                           3.6/3.3/2.4 ms)
+ *     CPU sets: all on CCD0 / CCD0 + SPURS
+ *       workers on CCD1 / ideal hints       49.1 / 49.4 / 48.5 (= the map)
+ *   With 0005 (vsync'd in-FIFO flips: a fight frame is 16.7 or 33.3 ms):
+ *     saturated: stock 28.8 (38% of frames > 34 ms), handshake only 34.5
+ *     (4.6%), map 37.1 (1.6%), map + ABOVE_NORMAL 29.0 (12%)
+ *     13-18 cores busy: stock 35.9 fps, 103 late audio blocks per 5 s;
+ *     default 40.9 fps, 33 late blocks
+ *   usleep < 1 ms (the main thread polls the flip status with usleep(100)
+ *   for most of a 30 fps frame): PAUSE spin or a high-resolution timer
+ *   instead of the SwitchToThread spin -- no gain, the timer adds 0.2 ms to
+ *   flip -> main (PS3_SCHED_SUBMS=pause|timer to try).
+ *   Spinning before parking on an lv2 semaphore: no use -- the main thread
+ *   never parks on one in a fight (its frame semaphore always has a token)
+ *   and post -> wake is 8-9 us at the median.
+ */
+#include "host_sched.h"
+
+int g_host_sched_trace_on = 0;
+
+#ifndef _WIN32
+
